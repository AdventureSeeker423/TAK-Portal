#WEB SERVER UI
WEB_UI_PORT=3000

# Portal Postgres. Leave empty to use the compose default (takportal). Override to set your own.
# Host tools (DBeaver/psql): 127.0.0.1, port 5433 (or POSTGRES_HOST_PORT),
# database and user takportal, password from this value or the compose default
# (also shown in Settings → Portal database).
POSTGRES_PASSWORD=

# Optional. Host port for Postgres, bound to 127.0.0.1 only.
#POSTGRES_HOST_PORT=5433
