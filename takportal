#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

COMPOSE_CMD="docker compose"
SERVICE_NAME="tak-portal"

usage() {
  cat <<EOF
Usage: $0 {setup|config|start|stop|restart|update|logs|status|remove|data|db}

Commands:
  setup      Open .env in nano for editing
  config     Alias for 'setup'
  start      Build (if needed) and start the stack in the background
  stop       Stop the stack and keep data volumes (does not delete Postgres)
  restart    Rebuild and recreate all compose services
  update     Fetch code (GitHub Release, or main if Beta Mode is on), rebuild, prune old images
  logs       Follow logs from web, worker, and Postgres
  status     Show container status
  remove     Completely remove containers, volumes, network, and images
             WARNING: -v deletes both tak_portal_data and tak_portal_pg
  data       Open a shell in the web container's /usr/src/app/data directory
  db         Open psql in the portal Postgres database (password is never printed)
EOF
}

read_dotenv_postgres_password() {
  local current=""
  current="$(grep -E '^POSTGRES_PASSWORD=' .env 2>/dev/null | tail -1 | sed 's/^POSTGRES_PASSWORD=//' | tr -d '\r' || true)"
  current="${current#\"}"
  current="${current%\"}"
  current="${current#\'}"
  current="${current%\'}"
  printf '%s' "$current"
}

# Compose interpolates ${POSTGRES_PASSWORD} from the process environment first,
# then the project .env. An empty exported value would ignore .env and crash-loop
# official Postgres (no superuser password). Always export the file value.
export_compose_secrets() {
  local current=""
  current="$(read_dotenv_postgres_password)"
  if [[ -z "$current" ]]; then
    echo "ERROR: POSTGRES_PASSWORD is empty in .env"
    return 1
  fi
  export POSTGRES_PASSWORD="$current"
  return 0
}

ensure_postgres_password() {
  if [[ ! -f .env ]]; then
    return 0
  fi
  local current=""
  current="$(read_dotenv_postgres_password)"
  if [[ -n "$current" ]]; then
    return 0
  fi
  local pw=""
  pw="$(tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | head -c 32 || true)"
  if [[ ${#pw} -lt 24 ]]; then
    pw="$(openssl rand -hex 16 2>/dev/null || date +%s%N | sha256sum | awk '{print $1}')"
  fi
  if grep -qE '^POSTGRES_PASSWORD=' .env 2>/dev/null; then
    awk -v pw="$pw" '
      BEGIN { done=0 }
      /^POSTGRES_PASSWORD=/ && !done { print "POSTGRES_PASSWORD=" pw; done=1; next }
      { print }
      END { if (!done) print "POSTGRES_PASSWORD=" pw }
    ' .env > .env.takportal-pw && mv -f .env.takportal-pw .env
  else
    printf '\nPOSTGRES_PASSWORD=%s\n' "$pw" >> .env
  fi
  TAKPORTAL_PW_GENERATED=1
  echo "Generated POSTGRES_PASSWORD in .env (also shown in Settings → Portal database)."
}

# Blank-password Postgres is created by an older updater (or compose up without
# ./takportal) and then left Restarting. `up --build` will not recreate it just
# because .env changed later — operators had to stop then start. Recreate here.
postgres_needs_recreate() {
  local name="tak-portal-postgres"
  if ! docker inspect "$name" >/dev/null 2>&1; then
    return 1
  fi
  local pw=""
  pw="$(docker inspect "$name" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | sed -n 's/^POSTGRES_PASSWORD=//p' | head -1 | tr -d '\r' || true)"
  if [[ -z "$pw" ]]; then
    return 0
  fi
  local status="" health=""
  status="$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || true)"
  health="$(docker inspect "$name" --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' 2>/dev/null || true)"
  if [[ "$status" == "restarting" || "$status" == "exited" || "$status" == "dead" ]]; then
    return 0
  fi
  if [[ "$health" == "unhealthy" ]]; then
    return 0
  fi
  return 1
}

compose_up_stack() {
  local mode="${1:-auto}"
  if ! export_compose_secrets; then
    return 1
  fi
  local extra=()
  if [[ "$mode" == "always" || "${TAKPORTAL_PW_GENERATED:-}" == "1" ]] || postgres_needs_recreate; then
    extra=(--force-recreate)
    if [[ "${TAKPORTAL_PW_GENERATED:-}" == "1" ]] || postgres_needs_recreate; then
      echo "Recreating containers so Postgres uses POSTGRES_PASSWORD from .env..."
    fi
  fi
  $COMPOSE_CMD up -d --build "${extra[@]}"
}

ensure_env() {
  if [[ ! -f .env ]]; then
    if [[ -f .env.example ]]; then
      cp -a .env.example .env
      echo "Created .env from .env.example"
    else
      echo "ERROR: .env not found in $(pwd) and no .env.example to copy."
      return 1
    fi
  fi
  ensure_postgres_password
  return 0
}

edit_env() {
  if ! ensure_env; then
    exit 1
  fi
  echo "Opening .env in nano..."
  nano .env
}

# Keep local .env across git checkout --force (it is no longer tracked).
# Also recovers WEB_UI_PORT from a running container when an older updater
# already removed a previously-tracked .env during this upgrade.
preserve_dotenv() {
  local bak=".env.takportal-preserve"
  rm -f "$bak"
  if [[ -f .env ]]; then
    cp -a .env "$bak"
    return 0
  fi
  local port=""
  port="$(docker inspect tak-portal --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null \
    | sed -n 's/^WEB_UI_PORT=//p' | head -1 || true)"
  if [[ -n "$port" ]]; then
    printf '#WEB SERVER UI\nWEB_UI_PORT=%s\n' "$port" > "$bak"
    echo "Preserved WEB_UI_PORT=${port} from running container (no local .env)."
    return 0
  fi
  if [[ -f .env.example ]]; then
    cp -a .env.example "$bak"
  fi
}

restore_dotenv() {
  local bak=".env.takportal-preserve"
  if [[ -f "$bak" ]]; then
    mv -f "$bak" .env
    return 0
  fi
  if [[ ! -f .env && -f .env.example ]]; then
    cp -a .env.example .env
  fi
}

# TAKPORTAL_CHANNEL_AWARE=1  — do not re-exec a checkout that lacks this marker (would git-pull main).

GITHUB_REPO="${GITHUB_REPO:-AdventureSeeker423/TAK-Portal}"

file_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    wc -c < "$1"
  fi
}

beta_mode_from_json() {
  local json="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
  s=json.loads(sys.stdin.read() or "{}")
  print(str(s.get("BETA_MODE") or "").strip().lower())
except Exception:
  print("")
' <<<"$json"
    return
  fi
  echo "$json" | tr -d '\r' | grep -oE '"BETA_MODE"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
    | sed 's/.*"BETA_MODE"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' | tr '[:upper:]' '[:lower:]'
}

read_settings_json() {
  local out=""
  if $COMPOSE_CMD ps -q "$SERVICE_NAME" >/dev/null 2>&1; then
    local cid
    cid="$($COMPOSE_CMD ps -q "$SERVICE_NAME" 2>/dev/null || true)"
    if [[ -n "$cid" ]]; then
      out="$($COMPOSE_CMD exec -T "$SERVICE_NAME" cat /usr/src/app/data/settings.json 2>/dev/null || true)"
      if [[ -n "$out" ]]; then
        echo "$out"
        return 0
      fi
    fi
  fi

  local vol=""
  vol="$(docker inspect tak-portal --format '{{range .Mounts}}{{if eq .Destination "/usr/src/app/data"}}{{.Name}}{{end}}{{end}}' 2>/dev/null || true)"
  if [[ -n "$vol" ]]; then
    local img=""
    img="$(docker inspect tak-portal --format '{{.Image}}' 2>/dev/null || true)"
    if [[ -n "$img" ]]; then
      out="$(docker run --rm --entrypoint cat -v "${vol}:/data:ro" "$img" /data/settings.json 2>/dev/null || true)"
      if [[ -n "$out" ]]; then
        echo "$out"
        return 0
      fi
    fi
  fi

  return 1
}

is_beta_mode() {
  local json=""
  json="$(read_settings_json || true)"
  if [[ -z "$json" ]]; then
    echo "Could not read settings.json from the data volume; treating Beta Mode as off (stable)."
    return 1
  fi
  local val
  val="$(beta_mode_from_json "$json")"
  if [[ "$val" == "true" ]]; then
    return 0
  fi
  return 1
}

installed_version() {
  if [[ ! -f package.json ]]; then
    echo "0.0.0"
    return
  fi
  grep -oE '"version"[[:space:]]*:[[:space:]]*"[^"]+"' package.json | head -1 \
    | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/'
}

tag_is_sane() {
  [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

version_norm() {
  local v="${1#v}"
  v="${v#V}"
  [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]] || { echo "00000000.00000000.00000000"; return; }
  printf '%08d.%08d.%08d' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

highest_semver_tag() {
  local best="" best_norm=""
  local tag a b c norm
  while IFS= read -r tag; do
    [[ "$tag" =~ ^v?([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || continue
    a="${BASH_REMATCH[1]}"
    b="${BASH_REMATCH[2]}"
    c="${BASH_REMATCH[3]}"
    norm="$(printf '%08d.%08d.%08d' "$a" "$b" "$c")"
    if [[ -z "$best_norm" || "$norm" > "$best_norm" ]]; then
      best="$tag"
      best_norm="$norm"
    fi
  done
  echo "$best"
}

latest_release_tag_from_api() {
  local body="" tag=""
  local url="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
  if command -v curl >/dev/null 2>&1; then
    body="$(curl -fsSL -H "Accept: application/vnd.github+json" -H "User-Agent: TAK-Portal" "$url" 2>/dev/null || true)"
  elif command -v wget >/dev/null 2>&1; then
    body="$(wget -qO- --header="Accept: application/vnd.github+json" --header="User-Agent: TAK-Portal" "$url" 2>/dev/null || true)"
  fi
  if [[ -z "$body" ]]; then
    return 1
  fi
  tag="$(echo "$body" | grep -oE '"tag_name"[[:space:]]*:[[:space:]]*"[^"]+"' | head -1 \
    | sed 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
  if tag_is_sane "$tag"; then
    echo "$tag"
    return 0
  fi
  return 1
}

latest_release_tag_from_git() {
  local tags=""
  tags="$(git ls-remote --tags --refs origin 2>/dev/null | awk '{print $2}' | sed 's|refs/tags/||' || true)"
  if [[ -z "$tags" ]]; then
    git fetch origin --tags --force >/dev/null 2>&1 || true
    tags="$(git tag -l 2>/dev/null || true)"
  fi
  echo "$tags" | highest_semver_tag
}

resolve_stable_tag() {
  local tag=""
  tag="$(latest_release_tag_from_api || true)"
  if [[ -n "$tag" ]] && tag_is_sane "$tag"; then
    echo "$tag"
    return 0
  fi
  echo "GitHub Releases API did not return a usable tag; trying git tags..." >&2
  tag="$(latest_release_tag_from_git || true)"
  if [[ -n "$tag" ]] && tag_is_sane "$tag"; then
    echo "$tag"
    return 0
  fi
  return 1
}

checkout_stable_release() {
  local tag="$1"
  local before
  before="$(installed_version)"
  echo "Fetching tags from origin..."
  git fetch origin --tags --force || true
  if ! git fetch origin "refs/tags/${tag}:refs/tags/${tag}" --force 2>/dev/null \
    && ! git fetch origin tag "$tag" --force; then
    echo "ERROR: Could not fetch release tag ${tag} from origin. Not pulling main."
    exit 1
  fi
  local before_n tag_n
  before_n="$(version_norm "$before")"
  tag_n="$(version_norm "$tag")"
  if [[ "$before_n" > "$tag_n" ]]; then
    echo "Rolling back from ${before} to release ${tag} because Beta Mode is off"
  elif [[ "$before_n" < "$tag_n" ]]; then
    echo "Updating from ${before} to GitHub Release ${tag} (Beta Mode is off)..."
  else
    echo "Checking out GitHub Release ${tag} (Beta Mode is off)..."
  fi
  git checkout --force "$tag"
}

checkout_beta_main() {
  echo "Beta Mode is on — tracking origin/main..."
  git fetch origin main --force
  git checkout --force -B main origin/main
}

maybe_reexec_updater() {
  local self_hash="$1"
  if [[ -n "${TAKPORTAL_UPDATE_REEXEC:-}" ]]; then
    return 0
  fi
  if ! grep -q "TAKPORTAL_CHANNEL_AWARE=1" "$0"; then
    echo "Checked out an older updater; finishing this run without re-exec (would git-pull main)."
    return 0
  fi
  local new_hash
  new_hash="$(file_sha256 "$0")"
  if [[ "$new_hash" != "$self_hash" ]]; then
    echo "Updater script changed; continuing with the new script..."
    exec env TAKPORTAL_UPDATE_REEXEC=1 "$0" update
  fi
}

run_update() {
  echo "Updating repository and containers..."

  # 1.4.9 re-execs this script after checkout, then we land here. Write the
  # password before preserve/checkout so .env.takportal-preserve already has it,
  # and before `compose ps` (beta detection) interpolates POSTGRES_PASSWORD.
  if ! ensure_env; then
    echo "Run: ./$(basename "${BASH_SOURCE[0]}") setup"
    exit 1
  fi
  export_compose_secrets || exit 1

  local self_hash=""
  self_hash="$(file_sha256 "$0")"

  if [[ -d .git ]]; then
    preserve_dotenv
    if is_beta_mode; then
      checkout_beta_main
    else
      local tag=""
      if ! tag="$(resolve_stable_tag)"; then
        restore_dotenv
        echo "ERROR: Could not resolve the latest GitHub Release. Not pulling main."
        echo "Check network access to GitHub, then retry."
        exit 1
      fi
      echo "Stable channel: GitHub Release ${tag}"
      checkout_stable_release "$tag"
    fi
    restore_dotenv
    maybe_reexec_updater "$self_hash"
  else
    echo "No .git directory found; skipping git checkout."
  fi

  if ! ensure_env; then
    exit 1
  fi
  export_compose_secrets || exit 1

  echo "Rebuilding and recreating containers..."
  compose_up_stack always

  echo
  sleep 5

  echo "Removing unused Docker images..."
  docker image prune -f
  echo "Old images cleaned up."
}

CMD="${1:-}"

case "$CMD" in
  setup|config)
    echo "Opening .env for configuration..."
    edit_env

    echo
    echo "Setup complete. You can now run:"
    echo "  ./$(basename "${BASH_SOURCE[0]}") start"
    ;;

  start)
    if ! ensure_env; then
      echo "Run: ./$(basename "${BASH_SOURCE[0]}") setup"
      exit 1
    fi
    echo "Starting TAK Portal..."
    compose_up_stack auto
    ;;

  stop)
    echo "Stopping containers (keeping data volumes)..."
    $COMPOSE_CMD down
    ;;

  restart)
    if ! ensure_env; then
      echo "Run: ./$(basename "${BASH_SOURCE[0]}") setup"
      exit 1
    fi
    echo "Restarting stack..."
    compose_up_stack auto
    ;;

  update)
    run_update
    ;;

  logs)
    echo "Following logs from all TAK Portal services (Ctrl+C to exit)..."
    $COMPOSE_CMD logs -f
    ;;

  status)
    $COMPOSE_CMD ps
    ;;

  remove)
    echo "⚠️  This will DELETE containers, volumes, networks, and images."
    echo "    That includes tak_portal_data AND the Postgres volume tak_portal_pg."
    read -p "Type 'yes' to continue: " confirm
    if [[ "$confirm" != "yes" ]]; then
      echo "Canceled."
      exit 0
    fi

    echo "Removing EVERYTHING created by docker compose..."
    $COMPOSE_CMD down -v --rmi local

    echo "Cleanup complete."
    ;;

  data)
    echo "Opening shell in container at /usr/src/app/data..."

    CONTAINER_ID="$($COMPOSE_CMD ps -q "$SERVICE_NAME" 2>/dev/null || true)"
    if [[ -z "$CONTAINER_ID" ]]; then
      echo "ERROR: Service '$SERVICE_NAME' is not running."
      echo "Start it first with:"
      echo "  ./$(basename "${BASH_SOURCE[0]}") start"
      exit 1
    fi

    echo "Working directory will be /usr/src/app/data (settings, agencies, etc.)."
    echo "Type 'exit' to return."
    echo
    $COMPOSE_CMD exec -it -w /usr/src/app/data "$SERVICE_NAME" /bin/sh
    ;;

  db)
    echo "Opening psql as takportal (Ctrl+D to exit)..."
    $COMPOSE_CMD exec -it postgres psql -U takportal -d takportal
    ;;

  *)
    usage
    exit 1
    ;;
esac
