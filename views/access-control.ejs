<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>Access Control</h1>

  <style>
    .ac-user-table-wrap {
      margin-top: 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
    }
    .ac-user-table-scroll {
      max-height: 300px;
      overflow: auto;
    }
    .ac-user-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }
    .ac-user-table th,
    .ac-user-table td {
      padding: 8px;
      border-bottom: 1px solid var(--line);
      text-align: left;
      vertical-align: middle;
      font-size: 0.95rem;
    }
    .ac-pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-size: 0.82rem;
      font-weight: 600;
      line-height: 1.4;
    }
    .ac-pill-user { background: rgba(120,120,120,.12); border-color: rgba(120,120,120,.35); }
    .ac-pill-agency { background: rgba(70,140,255,.12); border-color: rgba(70,140,255,.35); }
    .ac-pill-global { background: rgba(35,180,95,.12); border-color: rgba(35,180,95,.35); }

    .ac-state-legend {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin: 0 0 10px 0;
    }
    .ac-legend-item {
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 0.84rem;
      border: 1px solid transparent;
    }
    .ac-state-inherit-allowed { background: rgba(40,180,95,.08); border-color: rgba(40,180,95,.26); }
    .ac-state-inherit-denied { background: rgba(210,75,75,.08); border-color: rgba(210,75,75,.26); }
    .ac-state-deny { background: rgba(210,75,75,.12); border-color: rgba(210,75,75,.34); }

    .ac-perm-row {
      display: grid;
      grid-template-columns: minmax(300px,1fr) 280px;
      gap: 10px;
      align-items: center;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: 8px;
      margin-bottom: 8px;
      transition: background-color .15s ease;
    }
  </style>

  <div class="card">
    <h2>Select User</h2>

    <div style="display:grid; grid-template-columns: 240px minmax(260px,1fr); gap:10px; align-items:end; max-width: 920px;">
      <label>
        Agency Filter
        <select id="acAgencyFilter">
          <option value="">All Agencies</option>
        </select>
      </label>
      <label>
        Search Existing Users
        <input type="search" id="acUserSearch" placeholder="Search username, name, or email" autocomplete="off" />
      </label>
    </div>

    <div id="acSearchMsg" class="muted" style="margin-top:8px;">Type 2+ characters to search.</div>

    <div class="ac-user-table-wrap">
      <div class="ac-user-table-scroll">
        <table class="ac-user-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Name</th>
              <th>Email</th>
              <th>Agency</th>
              <th>Current Access</th>
              <th>Overrides</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="acSearchRows"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="acEditor" style="display:none;">
    <div class="card">
      <h2>Edit User Permissions</h2>
      <div id="acUserSummary" style="margin-bottom:10px;">
        <strong id="acSelName"></strong>
        <span id="acSelMeta" class="muted" style="margin-left:8px;"></span>
        <span id="acPillRole" class="ac-pill" style="margin-left:8px;"></span>
      </div>

      <div id="acGroups"></div>

      <div style="margin-top:12px; display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
        <button type="button" class="btn" id="acResetBtn">Reset To Role Defaults</button>
        <span id="acMsg" class="msg"></span>
      </div>
    </div>

    <div class="card">
      <h2>Effective Access</h2>
      <ul id="acEffective" class="ac-effective"></ul>
    </div>
  </div>

</main>

<script>
(function () {
  const SECTION_LABELS = {
    core: "Core",
    usersGroups: "Users & Groups",
    administration: "Administration",
    configuration: "Configuration",
    other: "Other",
  };

  const roleLabel = {
    user: "User",
    agency_admin: "Agency Admin",
    global_admin: "Global Admin",
  };

  let registryFlat = [];
  let selectedUsername = null;
  let selectedUserId = null;
  let currentDeny = new Set();
  let currentBaseAllowed = new Set();
  let searchTimer = null;

  const el = (id) => document.getElementById(id);

  function setMsg(text, isErr) {
    const m = el("acMsg");
    if (!m) return;
    m.textContent = text || "";
    m.style.color = isErr ? "#f66" : "";
  }

  function setSearchMsg(text, isErr, isOk) {
    const m = el("acSearchMsg");
    if (!m) return;
    m.textContent = text || "";
    if (isErr) m.style.color = "#f66";
    else if (isOk) m.style.color = "#59d27f";
    else m.style.color = "";
  }

  async function persistOverrides() {
    if (!selectedUsername) return false;
    const body = { deny: Array.from(currentDeny), allow: [] };
    const r = await fetch("/api/access-control/overrides/" + encodeURIComponent(selectedUsername), {
      method: "PUT",
      headers: { "Content-Type": "application/json", Accept: "application/json" },
      body: JSON.stringify(body),
    });
    if (!r.ok) {
      const outText = await r.text();
      throw new Error(outText || "Save failed.");
    }
    return true;
  }

  function roleToPillClass(role) {
    if (role === "global_admin") return "ac-pill ac-pill-global";
    if (role === "agency_admin") return "ac-pill ac-pill-agency";
    return "ac-pill ac-pill-user";
  }

  async function loadRegistry() {
    const r = await fetch("/api/access-control/registry", { headers: { Accept: "application/json" } });
    if (!r.ok) throw new Error("Failed to load registry");
    const j = await r.json();
    registryFlat = j.permissions || [];
  }

  async function loadAgencies() {
    try {
      const r = await fetch("/api/agencies", { headers: { Accept: "application/json" } });
      if (!r.ok) return;
      const list = await r.json();
      const sel = el("acAgencyFilter");
      (Array.isArray(list) ? list : []).forEach((a) => {
        const opt = document.createElement("option");
        opt.value = String(a?.suffix || "").trim().toLowerCase();
        opt.textContent = `${String(a?.name || "Agency")} (${String(a?.suffix || "").trim()})`;
        sel.appendChild(opt);
      });
    } catch (_) {}
  }

  function classifyRowState(id) {
    if (currentDeny.has(id)) return "ac-state-deny";
    return currentBaseAllowed.has(id) ? "ac-state-inherit-allowed" : "ac-state-inherit-denied";
  }

  function buildToggle(id) {
    const d = currentDeny.has(id);
    const baseAllowed = currentBaseAllowed.has(id);
    const inheritLabel = baseAllowed
      ? "Inherit From Role (Allowed)"
      : "Inherit From Role (Not Allowed)";
    return (
      "<select class=\"ac-state\" data-id=\"" + id + "\" style=\"min-width:16rem;\">" +
      "<option value=\"inherit\" " + (!d ? "selected" : "") + ">" + inheritLabel + "</option>" +
      "<option value=\"deny\" " + (d ? "selected" : "") + ">Deny</option>" +
      "</select>"
    );
  }

  function buildEditor() {
    const by = new Map();
    // Show only permissions allowed by the selected user's base role.
    const visible = registryFlat.filter((m) => currentBaseAllowed.has(m.id));
    for (const m of visible) {
      const s = m.section || "other";
      if (!by.has(s)) by.set(s, []);
      by.get(s).push(m);
    }
    const host = el("acGroups");
    host.innerHTML = "";
    if (!visible.length) {
      host.innerHTML = "<p class=\"muted\">No configurable permissions for this access level.</p>";
      return;
    }
    for (const [section, items] of by) {
      const wrap = document.createElement("div");
      wrap.style.marginBottom = "18px";
      const h = document.createElement("h3");
      h.style.margin = "0 0 8px 0";
      h.textContent = SECTION_LABELS[section] || section;
      wrap.appendChild(h);

      for (const m of items) {
        const id = m.id;
        const row = document.createElement("div");
        row.className = "ac-perm-row " + classifyRowState(id);
        row.setAttribute("data-row-id", id);
        row.innerHTML =
          "<div style=\"display:flex; align-items:center; min-height:38px;\"><strong>" + (m.label || id) + "</strong></div>" +
          "<div>" + buildToggle(id) + "</div>";
        wrap.appendChild(row);
      }
      host.appendChild(wrap);
    }

    host.querySelectorAll("select.ac-state").forEach((sel) => {
      sel.addEventListener("change", function () {
        const id = this.getAttribute("data-id");
        if (this.value === "deny") {
          currentDeny.add(id);
        } else {
          currentDeny.delete(id);
        }
        const row = host.querySelector('[data-row-id="' + id + '"]');
        if (row) {
          row.classList.remove("ac-state-deny", "ac-state-inherit-allowed", "ac-state-inherit-denied");
          row.classList.add(classifyRowState(id));
        }
        setMsg("Saving...", false);
        persistOverrides()
          .then(async () => {
            setMsg("Saved.", false);
            runSearch();
            await refreshEffective();
          })
          .catch((err) => {
            setMsg(err?.message || "Save failed.", true);
          });
      });
    });
  }

  async function refreshEffective() {
    if (!selectedUsername) return;
    const r = await fetch("/api/access-control/effective?user=" + encodeURIComponent(selectedUsername), { headers: { Accept: "application/json" } });
    if (!r.ok) {
      el("acEffective").innerHTML = "<li>Could not load effective access.</li>";
      return;
    }
    const j = await r.json();
    const ul = el("acEffective");
    ul.innerHTML = "";
    (j.effectiveLabels || []).forEach((x) => {
      const li = document.createElement("li");
      li.textContent = (x.label || x.id) + (x.section ? " (" + x.section + ")" : "");
      ul.appendChild(li);
    });
  }

  async function selectUser(user) {
    const username = String(user?.username || user || "").trim();
    if (!username) return;
    selectedUsername = username;
    selectedUserId = user?.pk ? String(user.pk) : null;
    setMsg("");

    const r = await fetch("/api/access-control/effective?user=" + encodeURIComponent(username), { headers: { Accept: "application/json" } });
    if (!r.ok) {
      setMsg("User not found or not accessible.", true);
      el("acEditor").style.display = "none";
      return;
    }

    const j = await r.json();
    currentBaseAllowed = new Set(Array.isArray(j.baseIds) ? j.baseIds : []);

    const ov = await fetch("/api/access-control/overrides/" + encodeURIComponent(j.username), { headers: { Accept: "application/json" } });
    const oj = ov.ok ? await ov.json() : { deny: [] };
    currentDeny = new Set(oj.deny || []);

    const role = j.baseRole || "user";
    el("acSelName").textContent = j.displayName || j.username;
    el("acSelMeta").textContent = j.username;
    const rolePill = el("acPillRole");
    rolePill.className = roleToPillClass(role);
    rolePill.textContent = roleLabel[role] || role;

    el("acEditor").style.display = "block";
    buildEditor();
    refreshEffective();
  }

  async function getRoleForUsername(username) {
    const r = await fetch("/api/access-control/effective?user=" + encodeURIComponent(username), { headers: { Accept: "application/json" } });
    if (!r.ok) return "user";
    const j = await r.json();
    return String(j.baseRole || "user");
  }

  async function getOverrideCountForUsername(username) {
    const r = await fetch("/api/access-control/overrides/" + encodeURIComponent(username), { headers: { Accept: "application/json" } });
    if (!r.ok) return 0;
    const j = await r.json().catch(() => ({}));
    return (j.deny || []).length;
  }

  async function renderSearchRows(items) {
    const body = el("acSearchRows");
    body.innerHTML = "";
    if (!items.length) {
      body.innerHTML = '<tr><td colspan="7" class="muted">No matching users.</td></tr>';
      return;
    }

    const withRoles = await Promise.all(items.map(async (u) => {
      const role = await getRoleForUsername(String(u?.username || ""));
      const overrides = await getOverrideCountForUsername(String(u?.username || ""));
      return { u, role, overrides };
    }));

    withRoles.forEach(({ u, role, overrides }) => {
      const tr = document.createElement("tr");
      const username = String(u?.username || "");
      const name = String(u?.name || "");
      const email = String(u?.email || "");
      const agency = String(u?.attributes?.agency_abbreviation || u?.agency_abbreviation || "").toUpperCase();
      tr.innerHTML =
        "<td>" + username + "</td>" +
        "<td>" + (name || "-") + "</td>" +
        "<td>" + (email || "-") + "</td>" +
        "<td>" + (agency || "-") + "</td>" +
        "<td>" +
          "<select class=\"ac-role-select\" data-user-id=\"" + String(u?.pk || "") + "\" data-username=\"" + username + "\">" +
          "<option value=\"user\" " + (role === "user" ? "selected" : "") + ">User</option>" +
          "<option value=\"agency_admin\" " + (role === "agency_admin" ? "selected" : "") + ">Agency Admin</option>" +
          "<option value=\"global_admin\" " + (role === "global_admin" ? "selected" : "") + ">Global Admin</option>" +
          "</select>" +
        "</td>" +
        "<td>" + (overrides > 0 ? String(overrides) : "-") + "</td>" +
        "<td><button type=\"button\" class=\"btn success ac-edit-btn\" data-user=\"" + username + "\" data-user-id=\"" + String(u?.pk || "") + "\">Edit Permissions</button></td>";
      body.appendChild(tr);
    });

    body.querySelectorAll(".ac-edit-btn").forEach((btn) => {
      btn.addEventListener("click", function () {
        const user = { username: this.getAttribute("data-user"), pk: this.getAttribute("data-user-id") };
        selectUser(user);
        window.scrollTo(0, 220);
      });
    });

    body.querySelectorAll(".ac-role-select").forEach((sel) => {
      sel.addEventListener("change", async function () {
        const userId = this.getAttribute("data-user-id");
        const username = this.getAttribute("data-username");
        const role = this.value;
        if (!userId) return;
        const prev = this.getAttribute("data-prev") || "user";
        setSearchMsg("Updating permissions...", false, false);
        this.disabled = true;
        try {
          const r = await fetch("/api/access-control/user-role/" + encodeURIComponent(userId), {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ role }),
          });
          const out = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(out.error || "Failed to update role.");
          this.setAttribute("data-prev", out.role || role);
          const doneLabel = (out.role || role) === "global_admin"
            ? "Permissions updated: Global Admin."
            : (out.role || role) === "agency_admin"
            ? "Permissions updated: Agency Admin."
            : "Permissions updated: User.";
          setSearchMsg(doneLabel, false, true);
          await runSearch();
          if (selectedUsername && selectedUsername === username) {
            await selectUser({ username, pk: userId });
          }
        } catch (e) {
          this.value = prev;
          setSearchMsg(e?.message || "Failed to update permissions.", true, false);
        } finally {
          this.disabled = false;
        }
      });
      sel.setAttribute("data-prev", sel.value);
    });
  }

  async function runSearch() {
    const q = String(el("acUserSearch").value || "").trim();
    const agencySuffix = String(el("acAgencyFilter").value || "").trim().toLowerCase();
    const params = new URLSearchParams();
    params.set("page", "1");
    params.set("pageSize", "5");
    if (q.length >= 2) params.set("q", q);
    if (agencySuffix) params.set("agencySuffix", agencySuffix);

    setSearchMsg("Loading users...", false, false);

    try {
      const r = await fetch("/api/users/search?" + params.toString(), { headers: { Accept: "application/json" } });
      if (!r.ok) throw new Error("Failed to search users.");
      const j = await r.json();
      const items = j.users || [];
      setSearchMsg(items.length ? "" : "No matching users.", false, false);
      await renderSearchRows(items);
    } catch (e) {
      setSearchMsg(e?.message || "Search failed.", true, false);
      el("acSearchRows").innerHTML = '<tr><td colspan="7" class="muted">Search failed.</td></tr>';
    }
  }

  el("acUserSearch").addEventListener("input", function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(runSearch, 300);
  });
  el("acAgencyFilter").addEventListener("change", runSearch);

  el("acResetBtn").addEventListener("click", async function () {
    if (!selectedUsername) return;
    if (!confirm("Clear all permission overrides for " + selectedUsername + "?")) return;
    currentDeny = new Set();
    setMsg("Saving...");
    try {
      const r = await fetch("/api/access-control/overrides/" + encodeURIComponent(selectedUsername), {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ deny: [], allow: [] }),
      });
      if (!r.ok) throw new Error("Reset failed.");
      setMsg("Cleared. Role defaults apply.");
      buildEditor();
      runSearch();
      refreshEffective();
    } catch (e) {
      setMsg(e?.message || "Reset failed.", true);
    }
  });

  Promise.all([loadRegistry(), loadAgencies()])
    .then(runSearch)
    .catch(() => {
      el("acSearchMsg").textContent = "Failed to initialize Access Control.";
    });
})();
</script>

</main>
</div>
</body>
</html>
