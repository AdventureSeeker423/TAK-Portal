<%- include("../partials/header") %>
<%- include("../partials/sidebar") %>

<main class="main">
  <section class="mouHero">
    <div class="mouHero__copy">
      <span class="mouEyebrow">Global Admin</span>
      <h1>MOU Administration</h1>
      <p class="muted">
        Create serverwide or agency-specific MOUs, choose HTML or PDF-backed content,
        and manage the separate serverwide user access statement.
      </p>
    </div>
    <div class="mouHero__actions">
      <a class="btn secondary" href="/mou">Open MOU Hub</a>
      <a class="btn" href="/admin/mou/compliance">Compliance</a>
    </div>
  </section>

  <% if (error) { %>
    <div class="card mouCallout mouCallout--danger">
      <div class="msg bad"><%= error %></div>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="card mouCallout">
      <div class="msg ok"><%= success %></div>
    </div>
  <% } %>

  <div class="mouWorkspace">
    <section class="card mouWorkspace__document">
      <div class="mouSectionHeader">
        <div>
          <h2>Create New MOU Draft</h2>
          <p class="muted">Use HTML for authored content or upload a PDF when the document already exists as a file.</p>
        </div>
      </div>

      <form method="post" action="/admin/mou" enctype="multipart/form-data" class="mouAdminForm" data-mou-draft-form="create">
        <div class="grid2">
          <label>
            Title
            <input type="text" name="title" required />
          </label>
          <label>
            Slug
            <input type="text" name="slug" placeholder="optional-slug" />
          </label>
          <label>
            Scope
            <select name="scopeType" data-mou-scope-select>
              <option value="global">Serverwide</option>
              <option value="agency">Agency specific</option>
            </select>
          </label>
          <label data-mou-agency-field hidden>
            Target agency
            <select name="agencySuffix">
              <option value="">Select agency</option>
              <% agencies.forEach(function (agency) { %>
                <option value="<%= agency.suffix %>"><%= agency.name %></option>
              <% }); %>
            </select>
          </label>
          <label>
            Content type
            <select name="contentType" data-mou-content-select>
              <option value="html">HTML</option>
              <option value="pdf">PDF upload</option>
            </select>
          </label>
          <label>
            Reminder days
            <input type="number" min="1" name="reminderDays" value="7" />
          </label>
        </div>

        <label class="mouCheckboxLabel">
          <input type="checkbox" name="mandatory" value="true" />
          Mark as mandatory
        </label>

        <label data-mou-html-field>
          Draft HTML
          <textarea name="html" rows="16" placeholder="<p>Paste MOU HTML here.</p>"></textarea>
        </label>

        <label data-mou-file-field hidden>
          Upload PDF
          <input type="file" name="contentFile" accept="application/pdf,.pdf" />
        </label>

        <div class="mouActionRow">
          <button class="btn" type="submit">Create Draft</button>
          <a class="btn secondary" href="/admin/mou/compliance">View compliance</a>
        </div>
      </form>
    </section>

    <section class="card mouWorkspace__sidebar">
      <h2 style="margin-top:0;">Serverwide User Agreement</h2>
      <p class="muted">
        This short access statement is shown to standard users and stays separate from the full MOU documents.
      </p>
      <% const currentAgreement = agreement && agreement.current ? agreement.current : null; %>
      <% if (currentAgreement) { %>
        <div class="mouMetaPill" style="margin-bottom:12px;">
          <strong>v<%= currentAgreement.version %></strong>
          <span>current agreement</span>
        </div>
      <% } %>
      <form method="post" action="/admin/mou/user-agreement/save">
        <label>
          Title
          <input type="text" name="title" value="<%= currentAgreement ? currentAgreement.title : 'User Agreement' %>" required />
        </label>
        <label style="margin-top:12px;display:block;">
          Agreement Text
          <textarea name="html" rows="12" required><%- currentAgreement ? currentAgreement.bodyHtml : '<p>I understand that use of this TAK environment is subject to my agency\'s current MOU and local operating policies. I agree to use this access only for authorized mission purposes, to safeguard credentials and shared data, and to follow administrator direction regarding acceptable use and account security.</p>' %></textarea>
        </label>
        <div class="row" style="margin-top:14px;">
          <button class="btn" type="submit">Save User Agreement</button>
        </div>
      </form>
    </section>
  </div>

  <section class="card" style="margin-top:14px;">
    <div class="mouSectionHeader">
      <div>
        <h2>Existing MOU Streams</h2>
        <p class="muted">Serverwide and agency-targeted streams are grouped together here.</p>
      </div>
    </div>
    <% if (!streams || !streams.length) { %>
      <div class="mouEmptyState">
        <h3>No MOU streams yet</h3>
        <p class="muted">Create your first draft using the form above.</p>
      </div>
    <% } else { %>
      <div class="mouCardGrid">
        <% streams.forEach(function (stream) { %>
          <% const draft = (stream.versions || []).find(function (entry) { return entry.state === "draft"; }); %>
          <article class="card mouSummaryCard">
            <div class="mouSummaryCard__top">
              <div>
                <div class="mouBadgeRow">
                  <span class="mouBadge"><%= stream.scopeLabel %></span>
                  <% if (stream.currentDeployed && stream.currentDeployed.contentType) { %>
                    <span class="mouBadge mouBadge--soft"><%= String(stream.currentDeployed.contentType).toUpperCase() %></span>
                  <% } else if (draft && draft.contentType) { %>
                    <span class="mouBadge mouBadge--soft"><%= String(draft.contentType).toUpperCase() %></span>
                  <% } %>
                  <% if (stream.mandatory) { %>
                    <span class="mouBadge mouBadge--accent">Required</span>
                  <% } %>
                </div>
                <h3><%= stream.title %></h3>
                <p class="muted">Slug: <%= stream.slug || "-" %></p>
              </div>
              <div class="mouMetaPill">
                <strong><%= stream.currentDeployed ? ("v" + stream.currentDeployed.version) : "None" %></strong>
                <span>deployed</span>
              </div>
            </div>

            <div class="mouAgencyList">
              <div class="mouAgencyList__row">
                <div>
                  <strong>Draft</strong>
                  <div class="muted"><%= draft ? ("v" + draft.version) : "No draft in progress" %></div>
                </div>
                <span class="mouStatus <%= draft ? 'mouStatus--pending' : 'mouStatus--soft' %>">
                  <%= draft ? "Open draft" : "Ready" %>
                </span>
              </div>
            </div>

            <div class="mouActionRow">
              <% if (draft) { %>
                <a class="btn" href="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/<%= encodeURIComponent(draft.version) %>/edit">Edit Draft</a>
              <% } else { %>
                <form method="post" action="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/new-version" style="display:inline;">
                  <button class="btn" type="submit">New Version Draft</button>
                </form>
              <% } %>
              <% if (stream.currentDeployed) { %>
                <a class="btn secondary" href="/mou/view/<%= encodeURIComponent(stream.mouId) %>/<%= encodeURIComponent(stream.currentDeployed.version) %>">Open deployed</a>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>
</main>

<script>
(function () {
  function syncDraftForm(form) {
    if (!form) return;
    var scopeSelect = form.querySelector("[data-mou-scope-select]");
    var agencyField = form.querySelector("[data-mou-agency-field]");
    var agencySelect = agencyField ? agencyField.querySelector("select") : null;
    var contentSelect = form.querySelector("[data-mou-content-select]");
    var htmlField = form.querySelector("[data-mou-html-field]");
    var htmlArea = htmlField ? htmlField.querySelector("textarea") : null;
    var fileField = form.querySelector("[data-mou-file-field]");
    var fileInput = fileField ? fileField.querySelector("input[type='file']") : null;

    function sync() {
      var scopeValue = scopeSelect ? scopeSelect.value : "global";
      var contentValue = contentSelect ? contentSelect.value : "html";

      if (agencyField) agencyField.hidden = scopeValue !== "agency";
      if (agencySelect) agencySelect.required = scopeValue === "agency";
      if (htmlField) htmlField.hidden = contentValue !== "html";
      if (htmlArea) htmlArea.required = contentValue === "html";
      if (fileField) fileField.hidden = contentValue !== "pdf";
      if (fileInput) fileInput.required = contentValue === "pdf";
    }

    if (scopeSelect) scopeSelect.addEventListener("change", sync);
    if (contentSelect) contentSelect.addEventListener("change", sync);
    sync();
  }

  document.querySelectorAll("[data-mou-draft-form]").forEach(syncDraftForm);
})();
</script>
