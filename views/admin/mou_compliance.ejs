<%- include("../partials/header") %>
<%- include("../partials/sidebar") %>

<main class="main">
  <section class="mouHero">
    <div class="mouHero__copy">
      <span class="mouEyebrow">Compliance</span>
      <h1>MOU Compliance</h1>
      <p class="muted">
        Track required agency signatures and current user-agreement acceptance from a single audit view.
      </p>
    </div>
    <div class="mouHero__actions">
      <a class="btn secondary" href="/admin/mou">Back to admin</a>
      <a class="btn" href="/admin/mou/compliance?export=signatures">Export signatures CSV</a>
    </div>
  </section>

  <div class="card">
    <div class="mouSectionHeader">
      <div>
        <h2>Agency Signature Status</h2>
        <p class="muted">Only target agencies for each MOU are included.</p>
      </div>
      <a class="btn secondary" href="/admin/mou/compliance?export=signatures">Export CSV</a>
    </div>
    <% if (!signatureRows || !signatureRows.length) { %>
      <div class="mouEmptyState">
        <h3>No signature data yet</h3>
        <p class="muted">Deployed MOUs will appear here once they target agencies.</p>
      </div>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>MOU</th>
            <th>Scope</th>
            <th>Agency</th>
            <th>Current Version</th>
            <th>Signed Version</th>
            <th>Signer</th>
            <th>Status</th>
            <% if (isGlobalAdmin) { %>
              <th>Evidence</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% signatureRows.forEach(function (row) { %>
            <tr>
              <td><%= row.mouTitle %></td>
              <td><%= row.scopeLabel %></td>
              <td><%= row.agencyName %></td>
              <td>v<%= row.deployedVersion %></td>
              <td><%= row.signedVersion ? ("v" + row.signedVersion) : "Not signed" %></td>
              <td><%= row.signerDisplayName || "-" %></td>
              <td>
                <span class="mouStatus <%= row.needsSignature ? 'mouStatus--pending' : 'mouStatus--ok' %>">
                  <%= row.needsSignature ? "Needs signature" : "Current" %>
                </span>
              </td>
              <% if (isGlobalAdmin) { %>
                <td>
                  <% if (row.signedVersion) { %>
                    <a class="btn secondary" href="/mou/agency/<%= encodeURIComponent(row.mouId) %>/<%= encodeURIComponent(row.agencyId) %>?version=<%= encodeURIComponent(row.signedVersion) %>">View Evidence</a>
                  <% } else { %>
                    <span class="muted">-</span>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="card" style="margin-top:12px;">
    <div class="mouSectionHeader">
      <div>
        <h2>Standard User Agreement Acceptance</h2>
        <p class="muted">This is the separate serverwide access statement accepted by standard users.</p>
      </div>
      <a class="btn secondary" href="/admin/mou/compliance?export=agreement">Export CSV</a>
    </div>
    <% if (!agreementRows || !agreementRows.length) { %>
      <div class="mouEmptyState">
        <h3>No acceptance data yet</h3>
        <p class="muted">User agreement acknowledgments will appear after users accept the current statement.</p>
      </div>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>User</th>
            <th>Username</th>
            <th>Agreement Version</th>
            <th>Accepted</th>
            <th>Accepted At</th>
          </tr>
        </thead>
        <tbody>
          <% agreementRows.forEach(function (row) { %>
            <tr>
              <td><%= row.displayName || "-" %></td>
              <td><%= row.username || "-" %></td>
              <td><%= row.version ? ("v" + row.version) : "-" %></td>
              <td><%= row.accepted ? "Yes" : "No" %></td>
              <td><%= row.acceptedAt || "-" %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
