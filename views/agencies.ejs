function getAgencyAbbrevChanges() {
  return agencies.filter((a) => {
    const id = String(a._id ?? a.id ?? "");
    if (!id || !(id in abbrevSnapshotById)) return false;
    const oldAbbr = String(abbrevSnapshotById[id] || "").trim().toUpperCase();
    const newAbbr = String(a.groupPrefix || "").trim().toUpperCase();
    return oldAbbr && newAbbr && oldAbbr !== newAbbr;
  });
}

async function finishAgencyAttributesEditing() {
  const changes = getAgencyAbbrevChanges();
  if (changes.length) {
    const lines = changes
      .map((a) => {
        const id = String(a._id ?? a.id ?? "");
        const oldAbbr = abbrevSnapshotById[id] || "";
        const newAbbr = String(a.groupPrefix || "").trim().toUpperCase();
        return `${a.name}: ${oldAbbr} → ${newAbbr}`;
      })
      .join("\n");
    const ok = confirm(
      `Apply abbreviation changes for ${changes.length} agenc${changes.length === 1 ? "y" : "ies"}?\n\n${lines}\n\nThis updates users, admin groups, TAK groups, and templates for each agency listed.`
    );
    if (!ok) return;
  }

  const btn = agencyAttributesEditBtn;
  const prevLabel = "Edit Agency Attributes";
  if (changes.length) {
    btn.disabled = true;
    btn.textContent = "Applying abbreviation changes…";
    setMsg("Applying abbreviation changes…", true);
  }

  const errors = [];
  const summaries = [];
  for (const a of changes) {
    const idx = a._id ?? a.id;
    const gp = String(a.groupPrefix || "").trim().toUpperCase();
    if (!/^[A-Z0-9_-]+$/.test(gp)) {
      errors.push(`${a.name}: invalid abbreviation`);
      continue;
    }
    try {
      const res = await fetch(
        `/api/agencies/${encodeURIComponent(idx)}/rename-group-prefix`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ groupPrefix: gp }),
        }
      );
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "Rename failed"
        );
      }
      if (!data.skipped) {
        summaries.push(
          `${a.name}: ${data.usersUpdated ?? 0} user(s), ${data.groupsRenamed ?? 0} group(s), ${data.templatesUpdated ?? 0} template(s)`
        );
      }
    } catch (e) {
      errors.push(`${a.name}: ${e.message || String(e)}`);
    }
  }

  btn.disabled = false;
  if (errors.length) {
    setMsg(errors.join(" | "), false);
    btn.textContent = "Done Editing";
    return;
  }

  agencyAttributesEditMode = false;
  abbrevSnapshotById = {};
  btn.textContent = prevLabel;
  btn.setAttribute("aria-pressed", "false");

  if (summaries.length) {
    setMsg(`Abbreviation updates applied. ${summaries.join("; ")}`, true);
  }

  await loadAgenciesWithCounts();
}

if (agencyAttributesEditBtn) {
  agencyAttributesEditBtn.addEventListener("click", async function () {
    if (agencyAttributesEditMode) {
      await finishAgencyAttributesEditing();
      return;
    }
    abbrevSnapshotById = {};
    for (const a of agencies) {
      const id = String(a._id ?? a.id ?? "");
      if (!id) continue;
      abbrevSnapshotById[id] = String(a.groupPrefix || "").trim().toUpperCase();
    }
    agencyAttributesEditMode = true;
    agencyAttributesEditBtn.textContent = "Done Editing";
    agencyAttributesEditBtn.setAttribute("aria-pressed", "true");
    renderAgencies();
  });
}

