      <label>Agency Color
        <select name="color" required>
          <option value="" disabled selected>Color</option>
          <option value="Blue">Blue</option>
          <option value="Dark Blue">Dark Blue</option>
          <option value="Brown">Brown</option>
          <option value="Cyan">Cyan</option>
          <option value="Green">Green</option>
          <option value="Dark Green">Dark Green</option>
          <option value="Magenta">Magenta</option>
          <option value="Maroon">Maroon</option>
          <option value="Orange">Orange</option>
          <option value="Purple">Purple</option>
          <option value="Red">Red</option>
          <option value="Teal">Teal</option>
          <option value="White">White</option>
          <option value="Yellow">Yellow</option>
        </select>
      </label>
      </div>

      <div class="createActionsRow agencyCreateActionsRow">
        <button class="btn btn-access createTemplateDownloadBtn" type="button" id="agencyCsvTemplateBtn">Download CSV Template</button>
        <button class="btn" type="button" id="agencyCsvBtn">Create from CSV</button>
        <button class="btn success createAgencySubmitBtnAlignRight" type="submit">Create Agency</button>
        <input type="file" id="agencyCsvFileInput" accept=".csv" style="display:none" />
