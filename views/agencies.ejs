<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>Agencies</h1>

  <div class="card">
    <h2>Create New Agency</h2>
    <form id="addForm" class="grid2">
      <%- include("partials/agency-create-fields", {
        agencyTypeOptions: typeof agencyTypeOptions !== "undefined" ? agencyTypeOptions : [],
        regionOptions: typeof regionOptions !== "undefined" ? regionOptions : [],
        regionCountyLocks: typeof regionCountyLocks !== "undefined" ? regionCountyLocks : [],
        includeColor: true,
        includeName: true,
        fieldsRequired: true,
        idPrefix: "",
        agencyFieldValues: {}
      }) %>

      <div class="createActionsRow agencyCreateActionsRow row">
        <button class="btn btn-access createTemplateDownloadBtn" type="button" id="agencyCsvTemplateBtn">Download CSV Template</button>
        <button class="btn" type="button" id="agencyCsvBtn">Create from CSV</button>
        <button class="btn success createAgencySubmitBtnAlignRight" type="submit">Create New Agency</button>
        <input type="file" id="agencyCsvFileInput" accept=".csv" style="display:none" />
        <span id="msg" class="msg"></span>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Existing Agencies</h2>

    <div class="row agenciesListFilters" style="align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:10px;">
      <label style="min-width: 160px;">
        <select id="agencyStateFilter" aria-label="Filter by state">
          <option value="">All States</option>
        </select>
      </label>
      <label style="min-width: 180px;">
        <select id="agencyTypeFilter" aria-label="Filter by agency type">
          <option value="">All Agency Types</option>
        </select>
      </label>
      <label style="min-width: 180px;">
        <select id="agencyColorFilter" aria-label="Filter by color">
          <option value="">All Colors / Teams</option>
        </select>
      </label>
      <input
        id="agencySearch"
        placeholder="Search name, abbreviation, suffix, or county..."
        style="margin: 10px 0; flex: 1; min-width: 260px; width: auto; box-sizing: border-box;"
        autocomplete="off"
      />
    </div>
    <div id="agenciesListMsg" class="msg"></div>

    <div class="pagination" id="agenciesPagination" style="display:none;">
      <button class="btn pagination-first-last" type="button" id="agenciesFirstBtn">First</button>
      <button class="btn" type="button" id="agenciesPrevBtn">Previous</button>
      <span id="agenciesPageInfo"></span>
      <button class="btn" type="button" id="agenciesNextBtn">Next</button>
      <button class="btn pagination-first-last" type="button" id="agenciesLastBtn">Last</button>
    </div>

    <div class="listCardTableWrap">
      <table class="table listCardTable agenciesTable" id="agencyTable">
        <thead>
          <tr>
            <th data-sort="name" role="button" tabindex="0" title="Sort by Agency">Agency</th>
            <th data-sort="groupPrefix" role="button" tabindex="0" title="Sort by Agency Abbreviation / Short Name">Abbreviation / Short Name</th>
            <th data-sort="suffix" role="button" tabindex="0" title="Sort by username identifier">Username Identifier</th>
            <th data-sort="county" role="button" tabindex="0" title="Sort by County">County</th>
            <th data-sort="countyAbbrev" role="button" tabindex="0" title="Sort by County Abbreviation">County Abbrev</th>
            <th data-sort="state" role="button" tabindex="0">State</th>
            <th data-sort="type" role="button" tabindex="0" title="Sort by Type">Type</th>
            <th class="agencyRegionHeader" data-sort="regionName" role="button" tabindex="0" title="Sort by Region">Region</th>
            <th data-sort="color" role="button" tabindex="0" title="Sort by Color">Color</th>
            <th class="agencyActionsHeader" data-label="Actions">Actions</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card agenciesExportCard">
    <div class="agenciesExportCardActions">
      <button type="button" class="btn" id="exportAgenciesCsvBtn">Export Agencies CSV</button>
    </div>
  </div>
</main>

<!-- Edit Agency Modal -->
<div class="modalOverlay" id="editAgencyOverlay" style="display:none;">
  <div class="modal editAgencyModal" role="dialog" aria-modal="true" aria-labelledby="editAgencyTitle">
    <div class="modalHeader">
      <div class="modalHeaderLeft">
        <h2 id="editAgencyTitle" style="margin:0;">Edit Agency</h2>
      </div>
      <button class="btn" id="editAgencyCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <form id="editAgencyForm" class="editAgencyForm" autocomplete="off">
        <section class="editAgencyTop">
          <%- include("partials/agency-create-fields", {
            agencyTypeOptions: typeof agencyTypeOptions !== "undefined" ? agencyTypeOptions : [],
            regionOptions: typeof regionOptions !== "undefined" ? regionOptions : [],
            regionCountyLocks: typeof regionCountyLocks !== "undefined" ? regionCountyLocks : [],
            includeColor: true,
            includeName: true,
            fieldsRequired: true,
            idPrefix: "edit",
            usernameReadOnly: true,
            agencyFieldValues: {}
          }) %>

          <div class="editAgencyDomainRow">
            <label class="editAgencyDomainField">
              <span class="editAgencyFieldLabel">Agency Email Domains
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover" role="tooltip">If you list one or more domains, the public Request Access form will only accept email addresses ending in those domains. Leave the field empty to allow any email domain for requests.</span>
                </span>
              </span>
              <input type="text" id="lookupDomain" placeholder="agency.gov, county.org" />
              <small id="domainError" class="msg bad" style="display:none;">
                Enter valid domains (e.g., agency.gov) with no @ symbol. Use commas between multiple domains.
              </small>
            </label>

            <div class="editAgencyToggles">
              <div class="settings-field settings-field-bool">
                <span class="settings-label">
                  <span>Auto-Approve User Requests</span>
                  <span class="settings-help-tip">
                    <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                    <span class="settings-help-popover" role="tooltip">When enabled, matching Request Access submissions are approved automatically and a user account is created with this agency's default template. A default template must be set before this can be turned on. If domains are listed, only matching emails are auto-approved. If no domains are listed, any email that selects this agency is auto-approved.</span>
                  </span>
                </span>
                <button
                  type="button"
                  class="settings-toggle is-off"
                  id="autoApproveToggle"
                  aria-pressed="false"
                  aria-label="Auto-Approve User Requests"
                ></button>
              </div>
              <small id="autoApproveHint" class="muted" style="display:none;">
                A default template must be set for this agency on the Templates page before auto-approve can be enabled.
              </small>
              <div class="settings-field settings-field-bool">
                <span class="settings-label">
                  <span>Account Lookup</span>
                  <span class="settings-help-tip">
                    <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                    <span class="settings-help-popover" role="tooltip">Account Lookup (when enabled) lets users request an enrollment QR code by email and username, for shared or apparatus accounts. Lookup still requires a matching approved domain and only works while lookup is enabled.</span>
                  </span>
                </span>
                <button
                  type="button"
                  class="settings-toggle is-off"
                  id="accountLookupToggle"
                  aria-pressed="false"
                  aria-label="Account Lookup"
                ></button>
              </div>
            </div>
          </div>
        </section>

        <section class="editAgencySplit <%= (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin) ? "has-extra-groups" : "admins-only" %>">
          <div class="editAgencySplitPane">
            <div class="editAgencySplitPaneHead">
              <h3>Agency Admins</h3>
              <button class="btn" type="button" id="addAdminsBtn" disabled>Add Admins</button>
            </div>
            <div id="adminsSummary" class="msg"></div>
            <input
              id="adminsFilter"
              placeholder="Filter by username, name, or email..."
            />
            <div id="addAdminsPanel" class="editAgencyAddAdminsPanel">
              <input
                id="addAdminsSearch"
                placeholder="Search username, name, or email to add..."
                autocomplete="off"
              />
              <div id="addAdminsResults" class="groupsBox editAgencyListBox"></div>
            </div>
            <div id="adminsList" class="groupsBox editAgencyListBox"></div>
            <div class="pagination" id="adminsPagination" style="display:none;">
              <button class="btn pagination-first-last" id="adminsFirstBtn" type="button">First</button>
              <button class="btn" id="adminsPrevBtn" type="button">Previous</button>
              <span id="adminsPageInfo"></span>
              <button class="btn" id="adminsNextBtn" type="button">Next</button>
              <button class="btn pagination-first-last" id="adminsLastBtn" type="button">Last</button>
            </div>
            <small id="adminsHint" class="muted"></small>
          </div>

          <% if (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin) { %>
          <div class="editAgencySplitPane" id="editAgencyAccessGroupsSection">
            <div class="editAgencySplitPaneHead">
              <h3>Extra Groups</h3>
              <div class="row" style="gap:8px; flex-wrap:wrap;">
                <button class="btn" type="button" id="accessGroupsSelectAllBtn">Select All</button>
                <button class="btn" type="button" id="accessGroupsClearBtn">Clear</button>
              </div>
            </div>
            <p id="accessGroupsSummary" class="msg"></p>
            <input id="accessGroupSearch" placeholder="Search groups..." />
            <div id="accessGroupsBox" class="groupsBox editAgencyListBox">
              <div id="accessGroupsInner" class="groupsInner"></div>
            </div>
          </div>
          <% } %>
        </section>

        <div class="editAgencyFooter row">
          <span id="editAgencyMsg" class="msg"></span>
          <button class="btn success" id="editAgencySaveBtn" type="submit">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
/** Same list as Add Agency state dropdown and PUT /api/agencies/:index/state */
const AGENCY_STATE_OPTIONS = [
  "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DC", "DE", "FL", "GA", "HI", "ID",
  "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS",
  "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK",
  "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV",
  "WI", "WY", "FED", "OTHER",
];
/** Same list as Add Agency type dropdown (core + settings extras + Other); PATCH /api/agencies/:index/type */
const AGENCY_TYPE_OPTIONS = <%- JSON.stringify(Array.isArray(agencyTypeOptions) ? agencyTypeOptions : []) %>;
/** Region catalog from Settings → Regions; PATCH /api/agencies/:index/region */
const AGENCY_REGION_OPTIONS = <%- JSON.stringify(Array.isArray(regionOptions) ? regionOptions : []) %>;
/** County → region locks; when present, Region is fixed for that state+county */
const AGENCY_REGION_COUNTY_LOCKS = <%- JSON.stringify(Array.isArray(regionCountyLocks) ? regionCountyLocks : []) %>;
const msg = document.getElementById("msg");
const tbody = document.getElementById("tbody");
const addForm = document.getElementById("addForm");
const agencyCsvBtn = document.getElementById("agencyCsvBtn");
const agencyCsvFileInput = document.getElementById("agencyCsvFileInput");
const agencyCsvTemplateBtn = document.getElementById("agencyCsvTemplateBtn");
const refreshBtn = document.getElementById("refreshBtn");
const agencyTable = document.getElementById("agencyTable");

const editAgencyOverlay = document.getElementById("editAgencyOverlay");
const editAgencyForm = document.getElementById("editAgencyForm");
const editAgencyTitle = document.getElementById("editAgencyTitle");
const editAgencyCloseBtn = document.getElementById("editAgencyCloseBtn");
const editAgencySaveBtn = document.getElementById("editAgencySaveBtn");
const editAgencyMsg = document.getElementById("editAgencyMsg");

const adminsSummary = document.getElementById("adminsSummary");
const adminsFilter = document.getElementById("adminsFilter");
const adminsList = document.getElementById("adminsList");
const adminsHint = document.getElementById("adminsHint");
const addAdminsBtn = document.getElementById("addAdminsBtn");
const addAdminsPanel = document.getElementById("addAdminsPanel");
const addAdminsSearch = document.getElementById("addAdminsSearch");
const addAdminsResults = document.getElementById("addAdminsResults");
const adminsPane = addAdminsPanel && addAdminsPanel.closest
  ? addAdminsPanel.closest(".editAgencySplitPane")
  : null;
const adminsFirstBtn = document.getElementById("adminsFirstBtn");
const adminsPrevBtn = document.getElementById("adminsPrevBtn");
const adminsNextBtn = document.getElementById("adminsNextBtn");
const adminsLastBtn = document.getElementById("adminsLastBtn");
const adminsPageInfo = document.getElementById("adminsPageInfo");
const adminsPagination = document.getElementById("adminsPagination");
let adminsCurrentPage = 1;
let adminsPageSize = 50;
let adminsTotalCount = 0;
let adminsHasNext = false;
let adminsHasPrev = false;

const AGENCIES_PAGE_SIZE = 25;
let agenciesPage = 1;
let agenciesFilterTimer = null;
const agencyStateFilter = document.getElementById("agencyStateFilter");
const agencyTypeFilter = document.getElementById("agencyTypeFilter");
const agencyColorFilter = document.getElementById("agencyColorFilter");
const agencySearch = document.getElementById("agencySearch");
const agenciesListMsg = document.getElementById("agenciesListMsg");
const agenciesPagination = document.getElementById("agenciesPagination");
const agenciesFirstBtn = document.getElementById("agenciesFirstBtn");
const agenciesPrevBtn = document.getElementById("agenciesPrevBtn");
const agenciesNextBtn = document.getElementById("agenciesNextBtn");
const agenciesLastBtn = document.getElementById("agenciesLastBtn");
const agenciesPageInfo = document.getElementById("agenciesPageInfo");

let agencies = [];
/** Snapshots per agency id when opening the edit modal (Save Changes applies diffs). */
let nameSnapshotById = {};
let abbrevSnapshotById = {};
let stateSnapshotById = {};
let countySnapshotById = {};
let countyAbbrevSnapshotById = {};
let stateFederalSnapshotById = {};
let colorSnapshotById = {};
let typeSnapshotById = {};
let regionSnapshotById = {};
let accessGroupsSnapshotIds = [];
let editingAgencyId = null;
let sortState = { key: "name", dir: 1 }; // default: Agency asc

function setMsg(text, ok=true){
  msg.textContent = text || "";
  if (ok === "progress") {
    msg.className = "msg progress";
  } else {
    msg.className = "msg " + (ok ? "ok" : "bad");
  }
}

function setEditMsg(text, ok=true){
  if (!editAgencyMsg) return;
  editAgencyMsg.textContent = text || "";
  if (ok === "progress") {
    editAgencyMsg.className = "msg progress";
  } else {
    editAgencyMsg.className = "msg " + (ok ? "ok" : "bad");
  }
}

function setListMsg(text, ok=true){
  if (!agenciesListMsg) return;
  agenciesListMsg.textContent = text || "";
  if (ok === "progress") {
    agenciesListMsg.className = "msg progress";
  } else {
    agenciesListMsg.className = "msg " + (ok ? "ok" : "bad");
  }
}

if (agencyCsvTemplateBtn) {
  agencyCsvTemplateBtn.addEventListener("click", () => {
    const a = document.createElement("a");
    a.href = "/sample-agencies.csv";
    a.download = "agencies-import-template.csv";
    document.body.appendChild(a);
    a.click();
    a.remove();
  });
}

if (agencyCsvBtn && agencyCsvFileInput) {
  agencyCsvBtn.addEventListener("click", () => {
    setMsg("");
    agencyCsvFileInput.value = "";
    agencyCsvFileInput.click();
  });

  agencyCsvFileInput.addEventListener("change", async () => {
    const file = agencyCsvFileInput.files && agencyCsvFileInput.files[0];
    if (!file) return;
    if (!file.name.toLowerCase().endsWith(".csv")) {
      setMsg("Please select a .csv file", false);
      agencyCsvFileInput.value = "";
      return;
    }

    agencyCsvBtn.disabled = true;
    setMsg("Importing agencies from CSV...", true);

    try {
      const fd = new FormData();
      fd.append("file", file);

      const res = await fetch("/api/agencies/import-csv", {
        method: "POST",
        body: fd,
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) {
        setMsg(out.error || "CSV import failed", false);
        return;
      }

      const created = Array.isArray(out.created) ? out.created : [];
      const skipped = Array.isArray(out.skipped) ? out.skipped : [];
      const failed = Array.isArray(out.failed) ? out.failed : [];

      let summary = `Imported ${created.length} agenc${created.length === 1 ? "y" : "ies"} from CSV.`;
      if (skipped.length) {
        summary += ` Skipped ${skipped.length} row${skipped.length === 1 ? "" : "s"}.`;
      }
      if (failed.length) {
        summary += ` ${failed.length} row${failed.length === 1 ? "" : "s"} had errors and were not imported.`;
      }

      if (skipped.length) {
        summary += " Skipped: " + skipped.map((s) => `line ${s.line} (${s.suffix || "n/a"}: ${s.reason || "skipped"})`).join(" | ");
      }
      if (failed.length) {
        const first = failed.slice(0, 20);
        summary += " Errors: " + first
          .map((f) => `line ${f.line} (${f.suffix || "n/a"}): ${(Array.isArray(f.messages) ? f.messages.join("; ") : String(f.messages || "error"))}`)
          .join(" | ");
        if (failed.length > first.length) {
          summary += ` | …and ${failed.length - first.length} more (see browser console).`;
        }
      }

      setMsg(summary, created.length > 0);
      if (skipped.length) console.warn("Agency CSV import skipped rows:", skipped);
      if (failed.length) console.warn("Agency CSV import failed rows:", failed);
      await loadAgenciesWithCounts();
      syncCountyAbbrevFromExisting();
    } catch (err) {
      setMsg(err?.message || "CSV import failed", false);
    } finally {
      agencyCsvBtn.disabled = false;
      agencyCsvFileInput.value = "";
    }
  });
}

function esc(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;");
}

function formatAgencyIdentifierDisplay(a) {
  const sfx = String(a?.suffix || "").trim();
  if (!sfx) return "";
  const isPrefix =
    String(a?.usernameTokenPlacement || "suffix").toLowerCase() === "prefix";
  return `${sfx} (${isPrefix ? "Prefix" : "Suffix"})`;
}

function isAgencyActive(a) {
  return a?.isActive !== false;
}

/** Same list as create-agency form and PATCH /api/agencies/:index/color */
const AGENCY_COLOR_OPTIONS = [
  "Blue", "Dark Blue", "Brown", "Cyan", "Green", "Dark Green", "Magenta", "Maroon",
  "Orange", "Purple", "Red", "Teal", "White", "Yellow",
];
/** Color name → "Blue — Aircraft" from Settings → Deployment Packet Colors / Teams */
const TEAM_COLOR_LABELS = <%- JSON.stringify((typeof teamColorLabels === "object" && teamColorLabels) ? teamColorLabels : {}) %>;

function agencyColorLabel(color) {
  const c = String(color || "").trim();
  return TEAM_COLOR_LABELS[c] || c;
}

function uniqueAgencyFieldValues(key) {
  const seen = new Set();
  const out = [];
  (agencies || []).forEach((a) => {
    const raw = String(a?.[key] || "").trim();
    if (!raw) return;
    const k = raw.toLowerCase();
    if (seen.has(k)) return;
    seen.add(k);
    out.push(raw);
  });
  return out.sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" }));
}

function fillAgencyListFilterOptions() {
  function fill(selectEl, values, labelFn) {
    if (!selectEl) return;
    const prev = String(selectEl.value || "");
    const first = selectEl.querySelector("option");
    selectEl.innerHTML = "";
    if (first) selectEl.appendChild(first);
    (values || []).forEach((v) => {
      const val = String(v || "").trim();
      if (!val) return;
      const opt = document.createElement("option");
      opt.value = val;
      opt.textContent = labelFn ? labelFn(val) : val;
      selectEl.appendChild(opt);
    });
    const stillValid = Array.from(selectEl.options).some((o) => o.value === prev);
    selectEl.value = stillValid ? prev : "";
  }
  fill(agencyStateFilter, uniqueAgencyFieldValues("state"));
  fill(agencyTypeFilter, uniqueAgencyFieldValues("type"));
  fill(
    agencyColorFilter,
    uniqueAgencyFieldValues("color").sort((a, b) =>
      agencyColorLabel(a).localeCompare(agencyColorLabel(b), undefined, { sensitivity: "base" })
    ),
    agencyColorLabel
  );
}

function getFilteredAgencies() {
  const state = String(agencyStateFilter && agencyStateFilter.value || "").trim().toUpperCase();
  const type = String(agencyTypeFilter && agencyTypeFilter.value || "").trim().toLowerCase();
  const color = String(agencyColorFilter && agencyColorFilter.value || "").trim().toLowerCase();
  const needle = String(agencySearch && agencySearch.value || "").trim().toLowerCase();
  return (agencies || []).filter((a) => {
    if (state && String(a.state || "").trim().toUpperCase() !== state) return false;
    if (type && String(a.type || "").trim().toLowerCase() !== type) return false;
    if (color && String(a.color || "").trim().toLowerCase() !== color) return false;
    if (!needle) return true;
    const hay = [
      a.name,
      a.groupPrefix,
      a.suffix,
      formatAgencyIdentifierDisplay(a),
      a.county,
      a.countyAbbrev,
      a.state,
      a.type,
      a.color,
      a.regionName,
      regionNameForId(a.regionId),
    ].map((x) => String(x || "").toLowerCase()).join(" ");
    return hay.includes(needle);
  });
}

function updateAgenciesListMsg(shown, total) {
  if (!agenciesListMsg) return;
  const needle = String(agencySearch && agencySearch.value || "").trim();
  const n = Number(shown || 0);
  const t = Number(total || 0);
  agenciesListMsg.className = "msg ok";
  if (!t) {
    agenciesListMsg.textContent = "No agencies found.";
    return;
  }
  if (!n) {
    agenciesListMsg.textContent = needle ? `No agencies found for "${needle}".` : "No agencies found.";
    return;
  }
  if (needle) {
    agenciesListMsg.textContent = `Showing ${n} of ${t} agenc${t === 1 ? "y" : "ies"} for "${needle}".`;
  } else {
    agenciesListMsg.textContent = `Showing ${n} of ${t} agenc${t === 1 ? "y" : "ies"}.`;
  }
}

function isAgencyStateFederal(a) {
  const raw = a?.stateFederalAgency;
  if (raw === true || raw === 1) return true;
  if (raw === false || raw === 0 || raw == null) return false;
  const s = String(raw).trim().toLowerCase();
  return s === "yes" || s === "true" || s === "1" || s === "y";
}

function countyMatchKey(state, county) {
  return `${String(state || "").trim().toUpperCase()}|${String(county || "").trim().toLowerCase()}`;
}

function countyEditGroupKeyForAgency(a) {
  const id = String(a._id ?? a.id ?? "");
  const snapCounty = id in countySnapshotById ? countySnapshotById[id] : a.county;
  const snapState = id in stateSnapshotById ? stateSnapshotById[id] : a.state;
  return countyMatchKey(snapState, snapCounty);
}

function stateScopeMatchKey(state, county, countyAbbrev) {
  return `${countyMatchKey(state, county)}|${String(countyAbbrev || "").trim().toUpperCase()}`;
}

function stateEditGroupKeyForAgency(a) {
  const id = String(a._id ?? a.id ?? "");
  const snapState = id in stateSnapshotById ? stateSnapshotById[id] : a.state;
  const snapCounty = id in countySnapshotById ? countySnapshotById[id] : a.county;
  const snapCountyAbbrev =
    id in countyAbbrevSnapshotById ? countyAbbrevSnapshotById[id] : a.countyAbbrev;
  return stateScopeMatchKey(snapState, snapCounty, snapCountyAbbrev);
}

function updateAgencyStateFederalLocal(agencyIndex, raw) {
  const row = agencies.find((x) => Number(x._id ?? x.id) === Number(agencyIndex));
  if (!row) return;
  const yes = String(raw || "").trim().toLowerCase() === "yes";
  row.stateFederalAgency = yes;
}

function updateAgencyStateLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = String(raw || "").trim().toUpperCase();
  const editKey = stateEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (stateEditGroupKeyForAgency(a) === editKey) {
      a.state = value;
    }
  }
}

function updateAgencyCountyNameLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = normalizeCountyName(raw);
  if (isAgencyStateFederal(row)) {
    row.county = value;
    return;
  }
  const editKey = countyEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (countyEditGroupKeyForAgency(a) === editKey) {
      a.county = value;
    }
  }
}

function updateAgencyCountyAbbrevLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = String(raw || "").trim().toUpperCase().replace(/[^A-Z0-9]/g, "");
  if (isAgencyStateFederal(row) || !value) {
    row.countyAbbrev = value;
    return;
  }
  const editKey = countyEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (countyEditGroupKeyForAgency(a) === editKey) {
      a.countyAbbrev = value;
    }
  }
}

function regionNameForId(regionId) {
  const id = String(regionId || "").trim();
  if (!id) return "";
  const hit = (AGENCY_REGION_OPTIONS || []).find((r) => String(r?.id || "") === id);
  return hit ? String(hit.name || "").trim() : "";
}

function agencyHasRegion(a) {
  if (String(a?.regionId || "").trim()) return true;
  if (String(a?.regionName || "").trim()) return true;
  const lock = findAgencyCountyRegionLock(a);
  return !!(lock && String(lock.regionId || "").trim());
}

function anyAgencyHasRegion() {
  return (agencies || []).some(agencyHasRegion);
}

function shouldShowRegionColumn() {
  return anyAgencyHasRegion();
}

function findAgencyCountyRegionLock(a) {
  const st = String(a?.state || "").trim().toUpperCase();
  const cn = String(a?.county || "").trim().toLowerCase();
  if (!st) return null;
  const locks = AGENCY_REGION_COUNTY_LOCKS || [];
  const stateLock = locks.find(
    (l) =>
      String(l?.state || "").trim().toUpperCase() === st &&
      (String(l?.scope || "").toLowerCase() === "state" ||
        (!l?.county && String(l?.scope || "") !== "county"))
  );
  if (stateLock) return stateLock;
  if (!cn) return null;
  return (
    locks.find(
      (l) =>
        String(l?.state || "").trim().toUpperCase() === st &&
        String(l?.county || "").trim().toLowerCase() === cn
    ) || null
  );
}

function normalizeVal(v){
  if (v === null || v === undefined) return "";
  return String(v).toLowerCase().trim();
}

function adminGroupNameForAgency(a){
  const abbr = String(a?.groupPrefix || "").trim();
  const countyAbbrev = String(a?.countyAbbrev || "").trim().toUpperCase();
  if (!abbr) return "";
  if (countyAbbrev) {
    return `authentik-${countyAbbrev}-${abbr}-AgencyAdmin`;
  }
  // Legacy pattern (no county abbreviation stored yet)
  return `authentik-${abbr}-AgencyAdmin`;
}

// ---- Admin modal behavior (copy of Groups -> View Members) ----
let activeAdmins = [];
let activeAdminsGroupId = "";
let activeAdminsGroupName = "";

function escAttr(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#39;");
}

function memberRow(u){
  const username = String(u?.username || "");
  const name = String(u?.name || u?.displayName || "");
  const email = String(u?.email || "");
  const pk = String(u?.pk || u?.id || "");
  const canRemove = !!(activeAdminsGroupId && pk);
  const detail = [name, email].filter(Boolean).join(" · ");
  return `
    <div class="editAgencyAdminItem">
      <div class="editAgencyAdminMeta">
        <div class="editAgencyAdminUser">${escAttr(username) || "—"}</div>
        ${detail ? `<div class="muted">${escAttr(detail)}</div>` : ""}
      </div>
      ${canRemove ? `<button class="btn danger" type="button" onclick="removeUserFromAdminsGroup('${escAttr(pk)}')">Remove</button>` : ""}
    </div>
  `;
}

function renderAdminsList(){
  const needle = String(adminsFilter?.value || "").trim().toLowerCase();
  const filtered = needle
    ? (activeAdmins || []).filter(u => {
        const u1 = String(u?.username || "").toLowerCase();
        const u2 = String(u?.name || u?.displayName || "").toLowerCase();
        const u3 = String(u?.email || "").toLowerCase();
        return u1.includes(needle) || u2.includes(needle) || u3.includes(needle);
      })
    : (activeAdmins || []);

  const rowsHtml = filtered.map(memberRow).join("");
  if (adminsList) adminsList.innerHTML = rowsHtml || `<p class="muted" style="margin:0;padding:8px;">No users found.</p>`;
}

let addAdminsOpen = false;
let addAdminsSearchTimer = null;
let addAdminsSearchSeq = 0;

function setAddAdminsButtonEnabled(enabled) {
  if (addAdminsBtn) addAdminsBtn.disabled = !enabled;
}

function setAddAdminsOpen(open) {
  addAdminsOpen = !!open && !!activeAdminsGroupId;
  if (adminsPane) adminsPane.classList.toggle("is-adding-admins", addAdminsOpen);
  if (addAdminsPanel) addAdminsPanel.classList.toggle("is-open", addAdminsOpen);
  if (addAdminsBtn) addAdminsBtn.textContent = addAdminsOpen ? "Done" : "Add Admins";
  if (!addAdminsOpen) {
    if (addAdminsSearch) addAdminsSearch.value = "";
    if (addAdminsResults) addAdminsResults.innerHTML = "";
    return;
  }
  if (addAdminsResults) {
    addAdminsResults.innerHTML = `<p class="muted" style="margin:0;padding:8px;">Type to search users.</p>`;
  }
  if (addAdminsSearch) {
    addAdminsSearch.focus();
    addAdminsSearch.select();
  }
}

function adminMemberIds() {
  return new Set((activeAdmins || []).map((u) => String(u?.pk || u?.id || "")).filter(Boolean));
}

function renderAddAdminsResults(users) {
  if (!addAdminsResults) return;
  const existing = adminMemberIds();
  const items = Array.isArray(users) ? users : [];
  if (!items.length) {
    addAdminsResults.innerHTML = `<p class="muted" style="margin:0;padding:8px;">No matching users.</p>`;
    return;
  }
  addAdminsResults.innerHTML = items.map((u) => {
    const username = String(u?.username || "");
    const name = String(u?.name || u?.displayName || "");
    const email = String(u?.email || "");
    const pk = String(u?.pk || u?.id || "");
    const detail = [name, email].filter(Boolean).join(" · ");
    const already = existing.has(pk);
    return `
      <div class="editAgencyAdminItem">
        <div class="editAgencyAdminMeta">
          <div class="editAgencyAdminUser">${escAttr(username) || "—"}</div>
          ${detail ? `<div class="muted">${escAttr(detail)}</div>` : ""}
        </div>
        ${
          already
            ? `<span class="muted">Already admin</span>`
            : pk
              ? `<button class="btn success" type="button" data-add-admin-pk="${escAttr(pk)}">Add</button>`
              : ""
        }
      </div>
    `;
  }).join("");
}

async function runAddAdminsSearch() {
  if (!addAdminsOpen || !addAdminsResults) return;
  const q = String(addAdminsSearch?.value || "").trim();
  if (q.length < 2) {
    addAdminsResults.innerHTML = `<p class="muted" style="margin:0;padding:8px;">Type to search users.</p>`;
    return;
  }
  const seq = ++addAdminsSearchSeq;
  addAdminsResults.innerHTML = `<p class="muted" style="margin:0;padding:8px;">Searching...</p>`;
  try {
    const params = new URLSearchParams({
      q,
      page: "1",
      pageSize: "25",
      sortKey: "name",
      sortDir: "asc",
    });
    const res = await fetch(`/api/users/search?${params.toString()}`, { headers: { Accept: "application/json" } });
    const out = await res.json().catch(() => ({}));
    if (seq !== addAdminsSearchSeq) return;
    if (!res.ok) throw new Error(out.error || "Search failed");
    renderAddAdminsResults(Array.isArray(out.users) ? out.users : []);
  } catch (e) {
    if (seq !== addAdminsSearchSeq) return;
    addAdminsResults.innerHTML = `<p class="muted" style="margin:0;padding:8px;">${esc(e.message || "Search failed.")}</p>`;
  }
}

if (addAdminsBtn) {
  addAdminsBtn.addEventListener("click", () => {
    if (!activeAdminsGroupId) return;
    setAddAdminsOpen(!addAdminsOpen);
  });
}
if (addAdminsSearch) {
  addAdminsSearch.addEventListener("input", () => {
    clearTimeout(addAdminsSearchTimer);
    addAdminsSearchTimer = setTimeout(() => {
      runAddAdminsSearch().catch(() => {});
    }, 220);
  });
  addAdminsSearch.addEventListener("keydown", (e) => {
    if (e.key === "Enter") e.preventDefault();
  });
}
if (addAdminsResults) {
  addAdminsResults.addEventListener("click", (e) => {
    const btn = e.target && e.target.closest ? e.target.closest("[data-add-admin-pk]") : null;
    if (!btn) return;
    addUserToAdminsGroup(btn.getAttribute("data-add-admin-pk"), btn);
  });
}

async function addUserToAdminsGroup(userPk, btn) {
  if (!activeAdminsGroupId || !userPk) return;
  if (btn) btn.disabled = true;
  try {
    const res = await fetch("/api/groups/mass-assign", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        groupId: activeAdminsGroupId,
        userIds: [String(userPk)],
      }),
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) {
      alert(out.error || "Failed to add user to admin group.");
      if (btn) btn.disabled = false;
      return;
    }
    await loadAdminsPage(1);
    await runAddAdminsSearch();
  } catch (e) {
    alert("Failed to add user to admin group.");
    if (btn) btn.disabled = false;
  }
}

if (adminsFilter) adminsFilter.oninput = renderAdminsList;
if (adminsFirstBtn) adminsFirstBtn.onclick = () => {
  if (adminsCurrentPage > 1) loadAdminsPage(1).catch(() => {});
};
if (adminsPrevBtn) adminsPrevBtn.onclick = () => {
  if (adminsHasPrev) loadAdminsPage(adminsCurrentPage - 1).catch(() => {});
};
if (adminsNextBtn) adminsNextBtn.onclick = () => {
  if (adminsHasNext) loadAdminsPage(adminsCurrentPage + 1).catch(() => {});
};
if (adminsLastBtn) adminsLastBtn.onclick = () => {
  const size = Math.max(1, Number(adminsPageSize || 50));
  const totalPages = Math.max(1, Math.ceil(Number(adminsTotalCount || 0) / size));
  if (adminsCurrentPage < totalPages) loadAdminsPage(totalPages).catch(() => {});
};

async function loadAdminsPage(page) {
  if (!activeAdminsGroupId) return;
  const targetPage = Math.max(1, Number(page || 1));
  const res = await fetch(
    `/api/groups/${encodeURIComponent(activeAdminsGroupId)}/members?page=${targetPage}&pageSize=${adminsPageSize}`
  );
  const out = await res.json();
  if (!res.ok) throw new Error(out.error || "Failed to load admins");
  activeAdmins = Array.isArray(out.users) ? out.users : [];
  adminsCurrentPage = Number(out.page || targetPage || 1);
  adminsPageSize = Number(out.pageSize || adminsPageSize || 50);
  adminsTotalCount = Number(out.memberCount || activeAdmins.length || 0);
  adminsHasNext = !!out.hasNext;
  adminsHasPrev = !!out.hasPrev;
  const totalPages = adminsTotalCount > 0 ? Math.max(1, Math.ceil(adminsTotalCount / Math.max(1, adminsPageSize))) : 1;
  if (adminsPagination) adminsPagination.style.display = adminsTotalCount > adminsPageSize ? "flex" : "none";
  if (adminsPageInfo) adminsPageInfo.textContent = `Page ${adminsCurrentPage} of ${totalPages}`;
  if (adminsFirstBtn) adminsFirstBtn.disabled = adminsCurrentPage <= 1 || !adminsHasPrev;
  if (adminsPrevBtn) adminsPrevBtn.disabled = !adminsHasPrev;
  if (adminsNextBtn) adminsNextBtn.disabled = !adminsHasNext;
  if (adminsLastBtn) adminsLastBtn.disabled = adminsCurrentPage >= totalPages || !adminsHasNext;
  if (adminsSummary) {
    adminsSummary.textContent = "";
    adminsSummary.className = "msg";
  }
  if (adminsHint) adminsHint.textContent = "";
  renderAdminsList();
}

function renderAgencies(){
  const showRegionColumn = shouldShowRegionColumn();
  if (agencyTable) agencyTable.classList.toggle("hide-region-column", !showRegionColumn);

  // apply sort (copy to avoid mutating original order if you later want it)
  const rows = [...getFilteredAgencies()];

  if (sortState.key){
    const key = sortState.key;
    const dir = sortState.dir;
    const th = agencyTable.querySelector(`thead th[data-sort="${CSS.escape(key)}"]`);
    const type = th?.dataset.type || "text";

    rows.sort((a,b) => {
      if (type === "number"){
        const av = Number(a[key] ?? 0);
        const bv = Number(b[key] ?? 0);
        return (av - bv) * dir;
      } else if (key === "stateFederalAgency") {
        const av = isAgencyStateFederal(a) ? "yes" : "no";
        const bv = isAgencyStateFederal(b) ? "yes" : "no";
        return av.localeCompare(bv) * dir;
      } else {
        const av = normalizeVal(a[key]);
        const bv = normalizeVal(b[key]);
        return av.localeCompare(bv) * dir;
      }
    });
  }

  // update header indicators
  agencyTable.querySelectorAll("thead th[data-sort]").forEach(th => {
    th.classList.remove("sorted-asc","sorted-desc");
    if (th.dataset.sort === sortState.key){
      th.classList.add(sortState.dir === 1 ? "sorted-asc" : "sorted-desc");
    }
  });

  const total = rows.length;
  const totalPages = Math.max(1, Math.ceil(total / AGENCIES_PAGE_SIZE));
  if (agenciesPage > totalPages) agenciesPage = totalPages;
  if (agenciesPage < 1) agenciesPage = 1;
  const pageRows = total > AGENCIES_PAGE_SIZE
    ? rows.slice((agenciesPage - 1) * AGENCIES_PAGE_SIZE, agenciesPage * AGENCIES_PAGE_SIZE)
    : rows;
  if (agenciesPagination) agenciesPagination.style.display = total > AGENCIES_PAGE_SIZE ? "flex" : "none";
  if (agenciesPageInfo) agenciesPageInfo.textContent = `Page ${agenciesPage} of ${totalPages}`;
  if (agenciesFirstBtn) agenciesFirstBtn.disabled = agenciesPage <= 1;
  if (agenciesPrevBtn) agenciesPrevBtn.disabled = agenciesPage <= 1;
  if (agenciesNextBtn) agenciesNextBtn.disabled = agenciesPage >= totalPages;
  if (agenciesLastBtn) agenciesLastBtn.disabled = agenciesPage >= totalPages;

  updateAgenciesListMsg(total, (agencies || []).length);

  if (!pageRows.length) {
    tbody.innerHTML =
      `<tr class="emptyStateRow"><td colspan="${showRegionColumn ? 10 : 9}" class="muted">${esc(
        (agenciesListMsg && agenciesListMsg.textContent) || "No agencies found."
      )}</td></tr>`;
    return;
  }

  tbody.innerHTML = pageRows.map((a)=>{
    const agencyId = esc(a._id ?? a.id ?? "");
    const active = isAgencyActive(a);
    const toggleBtnClass = active ? "btn caution" : "btn";
    const toggleLabel = active ? "Disable" : "Enable";
    return `
    <tr class="${active ? "" : "row-disabled"}">
      <td class="agencyNameCell cardTitleCell" data-label="Agency">
        <div class="agencyNameText cardTitleText">${esc(a.name)}</div>${
          !active ? `<span class="agencyStatusBadge cardMetaBadge">Disabled</span>` : ""
        }
      </td>
      <td class="agencyAbbrCell" data-label="Abbreviation / Short Name">${esc(a.groupPrefix)}</td>
      <td class="agencySuffixCell" data-label="Username Identifier">${esc(formatAgencyIdentifierDisplay(a))}</td>
      <td class="agencyCountyCell" data-label="County">${esc(a.county || "")}</td>
      <td class="agencyCountyAbbrevCell" data-label="County Abbrev">${esc(String(a.countyAbbrev || "").trim().toUpperCase())}</td>
      <td class="agencyStateCell" data-label="State">${esc(a.state || "")}</td>
      <td class="agencyTypeCell" data-label="Type">${esc(a.type || "")}</td>
      ${
        showRegionColumn
          ? `<td class="agencyRegionCell" data-label="Region">${esc(a.regionName || regionNameForId(a.regionId) || "")}</td>`
          : ""
      }
      <td class="agencyColorCell" data-label="Color">${esc(agencyColorLabel(a.color) || a.color || "")}</td>
      <td class="agencyActionsCell cardActionsCell">
        <div class="agencyActionsRow cardActionsRow">
          <button class="btn" type="button"
            onclick="openEditAgency('${agencyId}')">
            Edit
          </button>
          <button class="${toggleBtnClass} agency-active-toggle-btn" type="button"
            onclick="toggleAgencyActive('${agencyId}', ${active ? "false" : "true"})">${toggleLabel}</button>
          <button class="btn danger agency-delete-btn" type="button"
            onclick="delAgency('${agencyId}')">
            Delete
          </button>
        </div>
      </td>
    </tr>
  `;
  }).join("");
}

// Open admins modal for the agency's computed admin group.
async function loadAdminsForEditAgency(agencyId) {
  setAddAdminsOpen(false);
  setAddAdminsButtonEnabled(false);
  const a = (agencies || []).find(x => String(x._id ?? x.id) === String(agencyId));
  if(!a){
    if (adminsSummary) {
      adminsSummary.textContent = "Could not find agency.";
      adminsSummary.className = "msg bad";
    }
    return;
  }

  const groupName = adminGroupNameForAgency(a);
  if(!groupName){
    if (adminsSummary) {
      adminsSummary.textContent = "Agency abbreviation is missing; cannot determine admin group.";
      adminsSummary.className = "msg bad";
    }
    return;
  }

  activeAdminsGroupName = groupName;
  activeAdminsGroupId = "";
  activeAdmins = [];

  if (adminsSummary) {
    adminsSummary.textContent = "";
    adminsSummary.className = "msg";
  }
  if (adminsList) adminsList.innerHTML = `<p class="muted" style="margin:0;padding:8px;">Loading admins...</p>`;
  if (adminsHint) adminsHint.textContent = "";
  if (adminsFilter) adminsFilter.value = "";

  try {
    const gRes = await fetch(`/api/agencies/${encodeURIComponent(String(a._id ?? a.id ?? ""))}/admin-group`);
    const gOut = await gRes.json();
    if(!gRes.ok) throw new Error(gOut.error || "Failed to resolve admin group");

    const g = gOut?.group;
    if(!g || !g.pk){
      adminsSummary.textContent = `Admin group "${groupName}" was not found.`;
      adminsSummary.className = "msg bad";
      adminsHint.textContent = "If this agency was created before the new auto-create behavior, create this group or re-save the agency.";
      return;
    }

    activeAdminsGroupId = String(g.pk);
    setAddAdminsButtonEnabled(true);
    await loadAdminsPage(1);
  } catch (e) {
    adminsSummary.textContent = "Failed to load admins.";
    adminsSummary.className = "msg bad";
    if (adminsList) adminsList.innerHTML = "";
    if (adminsHint) adminsHint.textContent = "";
    activeAdmins = [];
    setAddAdminsButtonEnabled(false);
  }
}

window.removeUserFromAdminsGroup = async (userPk) => {
  if(!activeAdminsGroupId) return;

  if(!confirm(`Remove this user from "${activeAdminsGroupName || activeAdminsGroupId}"?`)) return;

  try {
    const res = await fetch("/api/groups/mass-unassign", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        groupId: activeAdminsGroupId,
        userIds: [String(userPk)]
      })
    });
    const out = await res.json();
    if(!res.ok){
      alert(out.error || "Failed to remove user from admin group.");
      return;
    }

    // Optimistically update local list
    activeAdmins = (activeAdmins || []).filter(u => String(u?.pk || u?.id) !== String(userPk));
    if (adminsSummary) {
      adminsSummary.textContent = "";
      adminsSummary.className = "msg";
    }
    renderAdminsList();
  } catch (e) {
    alert("Failed to remove user from admin group.");
  }
};

async function loadAgenciesWithCounts(){
  const res = await fetch("/api/agencies/with-counts");
  const data = await res.json();

  if(!res.ok){
    setMsg(data.error || "Failed to load agencies", false);
    return;
  }

  // Expecting each agency to include an id (recommended). We'll still render even if missing.
  agencies = (Array.isArray(data) ? data : []).map(function (a) {
    return Object.assign({}, a, {
      stateFederalAgency: isAgencyStateFederal(a),
      countyAbbrev: String(a?.countyAbbrev || "")
        .trim()
        .toUpperCase(),
      regionName: regionNameForId(a?.regionId) || String(a?.regionName || "").trim(),
    });
  });
  fillAgencyListFilterOptions();
  renderAgencies();
}

// Prefer deleting by real id.
// If your API currently deletes by index, update the backend route to delete by id.
window.toggleAgencyActive = async (agencyId, isActive) => {
  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(agencyId));
  if (!a) {
    setMsg("Could not find agency.", false);
    return;
  }

  const label = String(a.name || a.suffix || "Agency");
  const enabling = !!isActive;

  let userCount = 0;
  try {
    const previewRes = await fetch(`/api/agencies/${encodeURIComponent(agencyId)}/active-preview`);
    const preview = await previewRes.json().catch(() => ({}));
    if (!previewRes.ok) {
      setMsg(preview.error || "Could not load user count for this agency.", false);
      return;
    }
    userCount = Number(preview.userCount) || 0;
  } catch (e) {
    setMsg(e?.message || "Could not load user count for this agency.", false);
    return;
  }

  const userCountLine =
    userCount === 0
      ? enabling
        ? "No users are queued to be re-enabled."
        : "No active users will be disabled."
      : userCount === 1
        ? enabling
          ? "1 user will be re-enabled."
          : "1 active user will be disabled."
        : enabling
          ? `${userCount} users will be re-enabled.`
          : `${userCount} active users will be disabled.`;

  const ok = confirm(
    enabling
      ? `Enable agency "${label}"?\n\n${userCountLine}`
      : `Disable agency "${label}"?\n\n${userCountLine}`
  );
  if (!ok) return;

  const toggleButtons = document.querySelectorAll(".agency-active-toggle-btn");
  toggleButtons.forEach((btn) => {
    btn.disabled = true;
  });

  const progressUserPart =
    userCount === 1
      ? "1 user"
      : userCount > 1
        ? `${userCount} users`
        : "";
  setMsg(
    enabling
      ? progressUserPart
        ? `Enabling agency "${label}"… Updating ${progressUserPart}.`
        : `Enabling agency "${label}"…`
      : progressUserPart
        ? `Disabling agency "${label}"… Updating ${progressUserPart}.`
        : `Disabling agency "${label}"…`,
    "progress"
  );

  try {
    const res = await fetch(`/api/agencies/${encodeURIComponent(agencyId)}/active`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ is_active: enabling }),
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) {
      setMsg(out.error || "Failed to update agency status.", false);
      return;
    }
    const count = Number(out.usersUpdated || 0);
    const userPart = count
      ? ` ${count} user${count === 1 ? "" : "s"} updated.`
      : "";
    setMsg(
      enabling
        ? `Agency "${label}" enabled.${userPart}`
        : `Agency "${label}" disabled.${userPart}`,
      true
    );
    await loadAgenciesWithCounts();
  } catch (e) {
    setMsg(e?.message || "Failed to update agency status.", false);
  } finally {
    toggleButtons.forEach((btn) => {
      btn.disabled = false;
    });
  }
};

window.delAgency = async (id) => {
  if(!id){
    setMsg("Missing agency id (API should return _id/id).", false);
    return;
  }

  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(id));
  if (!a) {
    setMsg("Could not find agency.", false);
    return;
  }

  const label = String(a.name || a.suffix || "Agency");
  let preview = null;

  try {
    const previewRes = await fetch(`/api/agencies/${encodeURIComponent(id)}/delete-preview`);
    preview = await previewRes.json().catch(() => ({}));
    if (!previewRes.ok) {
      setMsg(preview.error || "Could not load delete preview for this agency.", false);
      return;
    }
  } catch (e) {
    setMsg(e?.message || "Could not load delete preview for this agency.", false);
    return;
  }

  const countLine = (count, singular, plural) => {
    const n = Number(count) || 0;
    const word = n === 1 ? singular : plural;
    return `- ${n} ${word}`;
  };

  const lines = [
    "WARNING!!! DELETING THIS AGENCY IS IRREVERSIBLE. PLEASE SEE THE FOLLOWING ITEMS TO BE DELETED...",
    "",
    countLine(preview.userCount, "User", "Users"),
    countLine(preview.agencyGroupCount, "Agency Specific Group", "Agency Specific Groups"),
  ];

  if (preview.willDeleteCountyGroups) {
    lines.push(countLine(preview.countyGroupCount, "County Specific Group", "County Specific Groups"));
  } else {
    lines.push("- 0 County Specific Groups (other agencies remain in this county)");
  }

  if (preview.willDeleteStateGroups) {
    lines.push(countLine(preview.stateGroupCount, "State Specific Group", "State Specific Groups"));
  } else {
    lines.push("- 0 State Specific Groups (other agencies remain in this state)");
  }

  lines.push(
    countLine(
      preview.agencyDataSyncMissionCount ?? preview.dataSyncMissionCount,
      "Agency Data Sync Mission",
      "Agency Data Sync Missions"
    )
  );
  if (preview.willDeleteCountyGroups) {
    lines.push(
      countLine(
        preview.countyDataSyncMissionCount,
        "County Data Sync Mission",
        "County Data Sync Missions"
      )
    );
  } else {
    lines.push("- 0 County Data Sync Missions (county groups kept)");
  }
  if (preview.willDeleteStateGroups) {
    lines.push(
      countLine(
        preview.stateDataSyncMissionCount,
        "State Data Sync Mission",
        "State Data Sync Missions"
      )
    );
  } else {
    lines.push("- 0 State Data Sync Missions (state groups kept)");
  }

  lines.push(countLine(preview.templateCount, "Template", "Templates"));
  lines.push(
    countLine(preview.integrationCount, "Agency Integration", "Agency Integrations")
  );

  if ((Number(preview.pendingRequestCount) || 0) > 0) {
    lines.push(countLine(preview.pendingRequestCount, "Pending Access Request", "Pending Access Requests"));
  }

  lines.push("");
  lines.push(`Agency: ${label}`);

  const ok = confirm(lines.join("\n"));
  if (!ok) return;

  const finalOk = confirm(
    `FINAL CONFIRMATION\n\nPermanently delete agency "${label}" and ALL items listed previously?\n\nThis action CANNOT be undone.`
  );
  if (!finalOk) return;

  if (String(editingAgencyId) === String(id)) closeEditAgencyModal();

  const deleteButtons = document.querySelectorAll(".agency-delete-btn");
  deleteButtons.forEach((btn) => {
    btn.disabled = true;
  });

  const userPart =
    (Number(preview.userCount) || 0) > 0
      ? ` Removing ${preview.userCount} user${preview.userCount === 1 ? "" : "s"}…`
      : "";
  setMsg(`Deleting agency "${label}"…${userPart}`, "progress");

  try {
    const res = await fetch("/api/agencies/" + encodeURIComponent(id), { method: "DELETE" });
    const out = await res.json().catch(() => ({}));

    if (!res.ok) {
      setMsg(out.error || "Delete failed", false);
      return;
    }

    setMsg(`Agency "${label}" deleted.`, true);
    await loadAgenciesWithCounts();
  } catch (e) {
    setMsg(e?.message || "Delete failed", false);
  } finally {
    deleteButtons.forEach((btn) => {
      btn.disabled = false;
    });
  }
};

// === County normalization helpers ===
function toTitleCaseWords(str) {
  return String(str || "")
    .toLowerCase()
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

// Handler for fixing county names
function normalizeCountyName(raw) {
  let v = String(raw || "").trim().replace(/\s+/g, " ");
  if (!v) return "";

  const lower = v.toLowerCase();
  if (lower.endsWith(" county")) {
    // strip " county" and title-case the base name
    const base = v.slice(0, lower.lastIndexOf(" county"));
    return toTitleCaseWords(base);
  } else {
    // just title-case whatever they typed
    return toTitleCaseWords(v);
  }
}

// === Configure domain / account lookup (agency index id from API) ===
let currentLookupAgencyId = null;
let currentLookupModalEnabled = false;
let currentLookupModalAutoApprove = false;
let currentLookupModalHasDefaultTemplate = false;
let lastSavedLookupDomain = "";
let lookupDomainSaveTimer = null;
let lookupDomainSaveInFlight = false;

function setSettingsToggleState(btn, on) {
  if (!btn) return;
  btn.classList.toggle("is-on", !!on);
  btn.classList.toggle("is-off", !on);
  btn.setAttribute("aria-pressed", on ? "true" : "false");
}

function showDomainModalError(message) {
  const error = document.getElementById("domainError");
  if (!error) return;
  if (message) {
    error.textContent = message;
    error.style.display = "block";
  } else {
    error.style.display = "none";
  }
}

function syncLookupModalToggles() {
  setSettingsToggleState(document.getElementById("accountLookupToggle"), currentLookupModalEnabled);
  const autoToggle = document.getElementById("autoApproveToggle");
  setSettingsToggleState(autoToggle, currentLookupModalAutoApprove);
  const locked = !currentLookupModalHasDefaultTemplate;
  if (autoToggle) {
    autoToggle.classList.toggle("is-locked", locked);
    if (!autoToggle.hasAttribute("data-busy")) {
      autoToggle.disabled = locked;
    }
    autoToggle.setAttribute("aria-disabled", locked ? "true" : "false");
    autoToggle.title = locked
      ? "Set a default template for this agency on the Templates page before enabling auto-approve."
      : "";
  }
  const hint = document.getElementById("autoApproveHint");
  if (hint) {
    hint.style.display = locked ? "block" : "none";
  }
}

function fillDomainSection(id) {
  if (!id) return;
  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(id));
  currentLookupAgencyId = id;
  currentLookupModalEnabled = !!(a && a.lookupEnabled);
  currentLookupModalAutoApprove = !!(a && a.autoApproveRequests);
  currentLookupModalHasDefaultTemplate = !!(a && a.hasDefaultTemplate);
  if (lookupDomainSaveTimer) {
    clearTimeout(lookupDomainSaveTimer);
    lookupDomainSaveTimer = null;
  }
  const domainInput = document.getElementById("lookupDomain");
  if (domainInput) domainInput.value = a && a.lookupDomain != null ? String(a.lookupDomain) : "";
  lastSavedLookupDomain = domainInput ? String(domainInput.value || "") : "";
  showDomainModalError("");
  syncLookupModalToggles();
}

function flushLookupDomainOnClose() {
  if (lookupDomainSaveTimer) {
    clearTimeout(lookupDomainSaveTimer);
    lookupDomainSaveTimer = null;
  }
  saveLookupDomains();
  closeLookupModalHelpTips();
}

function closeLookupModalHelpTips() {
  document.querySelectorAll("#editAgencyOverlay .settings-help-tip.is-open").forEach(function (t) {
    t.classList.remove("is-open");
    var b = t.querySelector(".settings-help-btn");
    if (b) b.setAttribute("aria-expanded", "false");
  });
}

function placeLookupModalHelpTip(tip) {
  if (!tip || !tip.classList) return;
  var btn = tip.querySelector(".settings-help-btn");
  if (!btn) return;
  var container = tip.closest(".modalBody") || document.getElementById("editAgencyOverlay");
  var btnRect = btn.getBoundingClientRect();
  var bounds = container
    ? container.getBoundingClientRect()
    : { top: 0, bottom: window.innerHeight || 0 };
  var spaceBelow = bounds.bottom - btnRect.bottom;
  var spaceAbove = btnRect.top - bounds.top;
  var preferAbove = spaceBelow < 140 && spaceAbove > spaceBelow;
  tip.classList.toggle("popover-above", !!preferAbove);
}

// Close when clicking outside modal (overlay)
const lookupOverlay = document.getElementById("editAgencyOverlay");

if (lookupOverlay) {
  lookupOverlay.addEventListener("click", (e) => {
    if (e.target === lookupOverlay) {
      closeEditAgencyModal();
    }
  });

  lookupOverlay.addEventListener("mouseover", function (e) {
    var tip = e.target && e.target.closest ? e.target.closest(".settings-help-tip") : null;
    if (!tip) return;
    var from = e.relatedTarget;
    if (from && tip.contains(from)) return;
    placeLookupModalHelpTip(tip);
  }, true);

  lookupOverlay.addEventListener("focusin", function (e) {
    var tip = e.target && e.target.closest ? e.target.closest(".settings-help-tip") : null;
    if (tip) placeLookupModalHelpTip(tip);
  }, true);

  lookupOverlay.addEventListener("click", function (e) {
    var helpBtn = e.target.closest && e.target.closest(".settings-help-btn");
    if (helpBtn) {
      e.preventDefault();
      e.stopPropagation();
      var tip = helpBtn.closest(".settings-help-tip");
      if (!tip) return;
      var open = tip.classList.contains("is-open");
      closeLookupModalHelpTips();
      if (!open) {
        placeLookupModalHelpTip(tip);
        tip.classList.add("is-open");
        helpBtn.setAttribute("aria-expanded", "true");
      }
      return;
    }
    if (!e.target.closest || !e.target.closest(".settings-help-tip")) {
      closeLookupModalHelpTips();
    }
  });
}

function parseDomainListClient(raw) {
  return String(raw || "")
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);
}

const domainPartRegex = /^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$/;

function validateDomainFieldForSave(domainInput, errorEl) {
  const parts = parseDomainListClient(domainInput.value);
  for (const p of parts) {
    if (p.includes("@") || !domainPartRegex.test(p)) {
      errorEl.style.display = "block";
      errorEl.textContent =
        "Enter valid domains (e.g., agency.gov) with no @ symbol. Use commas between multiple domains.";
      return false;
    }
  }
  errorEl.style.display = "none";
  return true;
}

function saveLookupDomains() {
  const domainInput = document.getElementById("lookupDomain");
  const error = document.getElementById("domainError");
  if (!currentLookupAgencyId || !domainInput || !error) return Promise.resolve(false);
  if (lookupDomainSaveInFlight) return Promise.resolve(false);
  const nextValue = String(domainInput.value || "");
  if (nextValue === lastSavedLookupDomain) return Promise.resolve(true);
  if (!validateDomainFieldForSave(domainInput, error)) return Promise.resolve(false);

  lookupDomainSaveInFlight = true;
  return fetch(`/api/agencies/${encodeURIComponent(currentLookupAgencyId)}/lookup/domain`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ lookupDomain: nextValue.trim() })
  })
    .then(async (res) => {
      const out = await res.json().catch(() => ({}));
      if (!res.ok) {
        showDomainModalError(out.error || "Could not save domains.");
        return false;
      }
      await loadAgenciesWithCounts();
      const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(currentLookupAgencyId));
      if (domainInput && a) domainInput.value = a.lookupDomain != null ? String(a.lookupDomain) : "";
      lastSavedLookupDomain = domainInput ? String(domainInput.value || "") : nextValue;
      showDomainModalError("");
      return true;
    })
    .catch(() => {
      showDomainModalError("Could not save domains.");
      return false;
    })
    .finally(() => {
      lookupDomainSaveInFlight = false;
    });
}

function scheduleLookupDomainAutoSave() {
  if (lookupDomainSaveTimer) clearTimeout(lookupDomainSaveTimer);
  lookupDomainSaveTimer = setTimeout(function () {
    lookupDomainSaveTimer = null;
    saveLookupDomains();
  }, 350);
}

const lookupDomainInput = document.getElementById("lookupDomain");
if (lookupDomainInput) {
  lookupDomainInput.addEventListener("input", scheduleLookupDomainAutoSave);
  lookupDomainInput.addEventListener("blur", function () {
    if (lookupDomainSaveTimer) {
      clearTimeout(lookupDomainSaveTimer);
      lookupDomainSaveTimer = null;
    }
    saveLookupDomains();
  });
}

const accountLookupToggle = document.getElementById("accountLookupToggle");
if (accountLookupToggle) {
  accountLookupToggle.addEventListener("click", function () {
    const domainInput = document.getElementById("lookupDomain");
    const error = document.getElementById("domainError");
    if (!currentLookupAgencyId || !domainInput || !error) return;
    const enabling = !currentLookupModalEnabled;

    if (enabling) {
      if (!validateDomainFieldForSave(domainInput, error)) return;
      const parts = parseDomainListClient(domainInput.value);
      if (parts.length === 0) {
        showDomainModalError("Enter at least one domain to enable lookup.");
        return;
      }
    }

    if (lookupDomainSaveTimer) {
      clearTimeout(lookupDomainSaveTimer);
      lookupDomainSaveTimer = null;
    }

    accountLookupToggle.disabled = true;
    const url = enabling
      ? `/api/agencies/${encodeURIComponent(currentLookupAgencyId)}/lookup/enable`
      : `/api/agencies/${encodeURIComponent(currentLookupAgencyId)}/lookup/disable`;
    const opts = enabling
      ? {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ lookupDomain: domainInput.value.trim() }),
        }
      : { method: "POST" };

    fetch(url, opts)
      .then(async (res) => {
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          showDomainModalError(out.error || (enabling ? "Could not enable lookup." : "Could not disable lookup."));
          syncLookupModalToggles();
          return;
        }
        currentLookupModalEnabled = enabling;
        if (enabling) lastSavedLookupDomain = String(domainInput.value || "");
        syncLookupModalToggles();
        await loadAgenciesWithCounts();
        setMsg(enabling ? "Account lookup enabled." : "Account lookup disabled.", true);
        showDomainModalError("");
      })
      .catch(() => {
        showDomainModalError(enabling ? "Could not enable lookup." : "Could not disable lookup.");
        syncLookupModalToggles();
      })
      .finally(() => {
        accountLookupToggle.disabled = false;
      });
  });
}

const autoApproveToggle = document.getElementById("autoApproveToggle");
if (autoApproveToggle) {
  autoApproveToggle.addEventListener("click", function () {
    if (!currentLookupAgencyId) return;
    const enabling = !currentLookupModalAutoApprove;

    if (enabling && !currentLookupModalHasDefaultTemplate) {
      syncLookupModalToggles();
      return;
    }

    autoApproveToggle.setAttribute("data-busy", "1");
    autoApproveToggle.disabled = true;
    const url = enabling
      ? `/api/agencies/${encodeURIComponent(currentLookupAgencyId)}/auto-approve/enable`
      : `/api/agencies/${encodeURIComponent(currentLookupAgencyId)}/auto-approve/disable`;

    fetch(url, { method: "POST" })
      .then(async (res) => {
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          showDomainModalError(out.error || (enabling ? "Could not enable auto-approve." : "Could not disable auto-approve."));
          syncLookupModalToggles();
          return;
        }
        currentLookupModalAutoApprove = enabling;
        await loadAgenciesWithCounts();
        const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(currentLookupAgencyId));
        currentLookupModalHasDefaultTemplate = !!(a && a.hasDefaultTemplate);
        currentLookupModalAutoApprove = !!(a && a.autoApproveRequests);
        syncLookupModalToggles();
        setMsg(enabling ? "Auto-approve enabled." : "Auto-approve disabled.", true);
        showDomainModalError("");
      })
      .catch(() => {
        showDomainModalError(enabling ? "Could not enable auto-approve." : "Could not disable auto-approve.");
        syncLookupModalToggles();
      })
      .finally(() => {
        autoApproveToggle.removeAttribute("data-busy");
        syncLookupModalToggles();
      });
  });
}

const COUNTY_KEY = "lastCountyUsed";

function loadLastCounty() {
  try {
    const stored = localStorage.getItem(COUNTY_KEY);
    if (stored) {
      addForm.elements.county.value = stored;
    }
  } catch (e) {
    // localStorage might be unavailable in some environments; fail silently
  }
}

function saveLastCounty(county) {
  try {
    localStorage.setItem(COUNTY_KEY, county);
  } catch (e) {
    // ignore storage errors
  }
}

function findExistingCountyAbbrev(state, county) {
  const s = String(state || "").trim().toUpperCase();
  const c = String(county || "").trim().toLowerCase();
  if (!s || !c) return null;
  const match = (agencies || []).find(a =>
    String(a.state || "").trim().toUpperCase() === s &&
    String(a.county || "").trim().toLowerCase() === c &&
    String(a.countyAbbrev || "").trim() !== ""
  );
  return match ? String(match.countyAbbrev).trim().toUpperCase() : null;
}

function syncCountyAbbrevFromExisting() {
  if (!addForm) return;
  const stateInput = addForm.elements.state;
  const countyInput = addForm.elements.county;
  const countyAbbrevInput = addForm.elements.countyAbbrev;
  if (!stateInput || !countyInput || !countyAbbrevInput) return;

  const normalizedCounty = normalizeCountyName(countyInput.value);
  if (normalizedCounty !== countyInput.value) {
    countyInput.value = normalizedCounty;
  }

  const existing = findExistingCountyAbbrev(stateInput.value, countyInput.value);
  if (existing) {
    countyAbbrevInput.value = existing;
    countyAbbrevInput.readOnly = true;
    countyAbbrevInput.classList.add("readonly");
  } else {
    if (countyAbbrevInput.readOnly) {
      countyAbbrevInput.readOnly = false;
      countyAbbrevInput.classList.remove("readonly");
    }
    // Do not overwrite user-entered value if they already started typing
    if (!countyAbbrevInput.value) {
      countyAbbrevInput.value = "";
    }
  }
}

addForm.onsubmit = async (e) => {
  e.preventDefault();
  setMsg("");

  const groupPrefixInput = addForm.elements.groupPrefix;
  if (groupPrefixInput) {
    const gp = String(groupPrefixInput.value || "").trim();
    groupPrefixInput.value = gp;
    if (!gp || !/^[A-Za-z0-9 _-]+$/.test(gp)) {
      setMsg(
        "Agency abbreviation / short name can only contain letters, numbers, spaces, dashes, and underscores",
        false
      );
      return;
    }
    const gpLower = gp.toLowerCase();
    if (
      agencies.some(
        (a) => String(a.groupPrefix || "").trim().toLowerCase() === gpLower
      )
    ) {
      setMsg("Agency abbreviation / short name already exists", false);
      return;
    }
  }

  const nameInput = addForm.elements.name;
  if (nameInput) {
    const nm = String(nameInput.value || "").trim();
    nameInput.value = nm;
    const nmLower = nm.toLowerCase();
    if (
      nm &&
      agencies.some((a) => String(a.name || "").trim().toLowerCase() === nmLower)
    ) {
      setMsg("Agency name already exists", false);
      return;
    }
  }

  // Normalize county before sending to backend
  const countyInput = addForm.elements.county;
  countyInput.value = normalizeCountyName(countyInput.value);

  // If an existing county abbreviation is known for this state+county, lock it in.
  const stateInput = addForm.elements.state;
  const countyAbbrevInput = addForm.elements.countyAbbrev;
  if (stateInput && countyInput && countyAbbrevInput) {
    const existing = findExistingCountyAbbrev(stateInput.value, countyInput.value);
    if (existing) {
      countyAbbrevInput.value = existing;
      countyAbbrevInput.readOnly = true;
      countyAbbrevInput.classList.add("readonly");
    }
  }

  // Save last-used county AFTER normalization
  if (countyInput.value) {
    saveLastCounty(countyInput.value);
  }

  const body = Object.fromEntries(new FormData(addForm));
  const createLabel = String(body.name || body.groupPrefix || "agency").trim() || "agency";

  setMsg(`Agency creation in progress for "${createLabel}"…`, "progress");

  let res;
  let out = {};
  try {
    res = await fetch("/api/agencies", {
      method:"POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(body)
    });
    out = await res.json().catch(() => ({}));
  } catch (err) {
    setMsg(err?.message || "Add failed", false);
    return;
  }

  if(!res.ok){
    setMsg(out.error || "Add failed", false);
    return;
  }

  addForm.reset();

  const placementSelect = addForm.elements.usernameTokenPlacement;
  if (placementSelect) placementSelect.value = "suffix";
  const stateFederalSelect = addForm.elements.stateFederalAgency;
  if (stateFederalSelect) stateFederalSelect.value = "no";
  if (typeof window.takSyncStateFederalAgencyFields === "function" && stateFederalSelect) {
    window.takSyncStateFederalAgencyFields(stateFederalSelect);
  }
  syncUsernameIdentifierFormLabels();

  // Restore last-used county
  loadLastCounty();

  setMsg("Agency added", true);
  loadAgenciesWithCounts();
};

if (refreshBtn) refreshBtn.onclick = () => loadAgenciesWithCounts();

function agencyNameChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in nameSnapshotById)) return false;
  const oldName = String(nameSnapshotById[id] || "").trim();
  const newName = String(a.name || "").trim();
  return oldName && newName && oldName !== newName;
}

function agencyAbbrevChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in abbrevSnapshotById)) return false;
  const oldAbbr = String(abbrevSnapshotById[id] || "").trim();
  const newAbbr = String(a.groupPrefix || "").trim();
  return oldAbbr && newAbbr && oldAbbr !== newAbbr;
}

function agencyCountyAbbrevChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in countyAbbrevSnapshotById)) return false;
  const oldVal = String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase();
  const newVal = String(a.countyAbbrev || "").trim().toUpperCase();
  return oldVal !== newVal;
}

function agencyCountyNameChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in countySnapshotById)) return false;
  const oldVal = normalizeCountyName(countySnapshotById[id]);
  const newVal = normalizeCountyName(a.county);
  return oldVal !== newVal;
}

function agencyStateChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in stateSnapshotById)) return false;
  const oldVal = String(stateSnapshotById[id] || "").trim().toUpperCase();
  const newVal = String(a.state || "").trim().toUpperCase();
  return oldVal !== newVal;
}

function agencyStateFederalChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in stateFederalSnapshotById)) return false;
  return !!stateFederalSnapshotById[id] !== isAgencyStateFederal(a);
}

function getStateFederalChangesToApply() {
  return agencies.filter((a) => agencyStateFederalChanged(a));
}

function getStateChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyStateChanged(a)) continue;
    const key = stateEditGroupKeyForAgency(a);
    if (seen.has(key)) continue;
    seen.add(key);
    const id = String(a._id ?? a.id ?? "");
    changes.push({
      agency: a,
      key,
      oldState: String(stateSnapshotById[id] || "").trim().toUpperCase(),
      oldCounty: normalizeCountyName(countySnapshotById[id]),
      oldCountyAbbrev: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
      newVal: String(a.state || "").trim().toUpperCase(),
    });
  }
  return changes;
}

function getCountyNameChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyCountyNameChanged(a)) continue;
    const id = String(a._id ?? a.id ?? "");
    if (isAgencyStateFederal(a)) {
      const key = "sf:" + id;
      if (seen.has(key)) continue;
      seen.add(key);
      changes.push({
        agency: a,
        key,
        state: String(stateSnapshotById[id] || a.state || "").trim().toUpperCase(),
        oldCounty: normalizeCountyName(countySnapshotById[id]),
        newVal: normalizeCountyName(a.county),
      });
      continue;
    }
    const oldCounty = normalizeCountyName(countySnapshotById[id]);
    const state = String(stateSnapshotById[id] || a.state || "").trim().toUpperCase();
    const key = countyMatchKey(state, oldCounty);
    if (seen.has(key)) continue;
    seen.add(key);
    changes.push({
      agency: a,
      key,
      state,
      oldCounty,
      newVal: normalizeCountyName(a.county),
    });
  }
  return changes;
}

function getCountyAbbrevChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyCountyAbbrevChanged(a)) continue;
    const id = String(a._id ?? a.id ?? "");
    const newVal = String(a.countyAbbrev || "").trim().toUpperCase();
    if (isAgencyStateFederal(a) || !newVal) {
      const key = "sf:" + id;
      if (seen.has(key)) continue;
      seen.add(key);
      changes.push({
        agency: a,
        key,
        newVal,
        oldVal: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
      });
      continue;
    }
    const key = countyEditGroupKeyForAgency(a);
    if (seen.has(key)) continue;
    seen.add(key);
    changes.push({
      agency: a,
      key,
      newVal,
      oldVal: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
    });
  }
  return changes;
}

function getAgenciesWithAttributeChanges() {
  return agencies.filter((a) => agencyNameChanged(a) || agencyAbbrevChanged(a));
}

async function finishAgencyAttributesEditing() {
  const agenciesToUpdate = getAgenciesWithAttributeChanges();
  const stateFederalChanges = getStateFederalChangesToApply();
  const stateChanges = getStateChangesToApply();
  const countyNameChanges = getCountyNameChangesToApply();
  const countyChanges = getCountyAbbrevChangesToApply();

  // Validate county requirements against the edited in-memory values.
  for (const a of agencies) {
    const label = String(a.name || a.groupPrefix || "Agency");
    const county = normalizeCountyName(a.county);
    const countyAbbrev = String(a.countyAbbrev || "").trim().toUpperCase();
    if (!isAgencyStateFederal(a)) {
      if (!county) {
        setEditMsg(`${label}: County is required unless State/Federal Agency is Yes`, false);
        return false;
      }
      if (!countyAbbrev || countyAbbrev.length < 2 || !/^[A-Z0-9]+$/.test(countyAbbrev)) {
        setEditMsg(
          `${label}: County Abbreviation is required (at least 2 letters or numbers) unless State/Federal Agency is Yes`,
          false
        );
        return false;
      }
    } else if (countyAbbrev && (countyAbbrev.length < 2 || !/^[A-Z0-9]+$/.test(countyAbbrev))) {
      setEditMsg(`${label}: County Abbreviation must be at least 2 characters (letters or numbers) when provided`, false);
      return false;
    }
  }

  const colorTypeRegionChanges = getColorTypeRegionChangesToApply();
  const groupsDirty = accessGroupsDirty();

  const hasWork =
    agenciesToUpdate.length > 0 ||
    stateFederalChanges.length > 0 ||
    stateChanges.length > 0 ||
    countyNameChanges.length > 0 ||
    countyChanges.length > 0 ||
    colorTypeRegionChanges.length > 0 ||
    groupsDirty;

  if (hasWork) {
    const lines = [];
    for (const a of stateFederalChanges) {
      const id = String(a._id ?? a.id ?? "");
      const oldYes = !!stateFederalSnapshotById[id];
      lines.push(
        `${String(nameSnapshotById[id] || a.name || "Agency")}: State/Federal ${oldYes ? "Yes" : "No"} → ${isAgencyStateFederal(a) ? "Yes" : "No"}`
      );
    }
    for (const ch of stateChanges) {
      lines.push(
        `${ch.oldState || "State"}, ${ch.oldCounty || "County"}, ${ch.oldCountyAbbrev || "abbrev"}: state ${ch.oldState || "(none)"} → ${ch.newVal} (matching agencies; state groups renamed only if no agencies remain on ${ch.oldState})`
      );
    }
    for (const ch of countyNameChanges) {
      lines.push(
        `${ch.state}, ${ch.oldCounty || "County"}: county name ${ch.oldCounty || "(none)"} → ${ch.newVal || "(none)"} (all agencies in this county; county groups renamed)`
      );
    }
    for (const ch of countyChanges) {
      const countyLabel = `${ch.agency.county || "County"}, ${ch.agency.state || ""}`;
      lines.push(
        `${countyLabel}: county abbrev ${ch.oldVal || "(none)"} → ${ch.newVal || "(none)"} (all agencies in this county)`
      );
    }
    for (const a of agenciesToUpdate) {
      const id = String(a._id ?? a.id ?? "");
      const parts = [];
      if (agencyNameChanged(a)) {
        parts.push(`name: ${nameSnapshotById[id]} → ${String(a.name || "").trim()}`);
      }
      if (agencyAbbrevChanged(a)) {
        parts.push(
          `abbrev: ${abbrevSnapshotById[id]} → ${String(a.groupPrefix || "").trim()}`
        );
      }
      const label = String(nameSnapshotById[id] || a.name || "Agency");
      lines.push(`${label}: ${parts.join("; ")}`);
    }
    for (const ch of colorTypeRegionChanges) {
      lines.push(ch.line);
    }
    if (groupsDirty) lines.push("Extra groups for agency admins");
    const ok = confirm(
      `Apply agency changes?\n\n${lines.join("\n")}`
    );
    if (!ok) {
      restoreAgenciesFromSnapshots();
      return false;
    }
  }

  if (hasWork) {
    if (editAgencySaveBtn) editAgencySaveBtn.disabled = true;
    setEditMsg("Applying agency changes…", true);
  }

  const errors = [];
  const summaries = [];

  for (const a of stateFederalChanges) {
    const idx = a._id ?? a.id;
    const displayName = String(nameSnapshotById[String(idx)] || a.name || "Agency");
    const yes = isAgencyStateFederal(a);
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/state-federal`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ stateFederalAgency: yes }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "State/Federal update failed"
        );
      }
      summaries.push(`${displayName} (State/Federal): ${yes ? "Yes" : "No"}`);
    } catch (e) {
      errors.push(`${displayName} (State/Federal): ${e.message || String(e)}`);
    }
  }

  for (const ch of stateChanges) {
    const label = `${ch.oldState || "State"}, ${ch.oldCounty || "County"}, ${ch.oldCountyAbbrev || "abbrev"}`;
    const value = ch.newVal;
    if (!value) {
      errors.push(`${label}: state is required`);
      continue;
    }
    if (!AGENCY_STATE_OPTIONS.includes(value)) {
      errors.push(`${label}: invalid state code`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/state`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ state: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "State update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        let summary = `${label} (state): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"} updated`;
        if (data.stateGroupsRenamed) {
          summary += `, ${data.groupsRenamed ?? 0} state group(s) renamed`;
        }
        summaries.push(summary);
      }
    } catch (e) {
      errors.push(`${label} (state): ${e.message || String(e)}`);
    }
  }

  for (const ch of countyNameChanges) {
    const label = `${ch.state}, ${ch.oldCounty || "County"}`;
    const value = ch.newVal;
    const allowEmpty = isAgencyStateFederal(ch.agency);
    if (!value && !allowEmpty) {
      errors.push(`${label}: county name is required`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/county-name`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ county: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "County name update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        summaries.push(
          `${label} (county name): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"}, ${data.groupsRenamed ?? 0} county group(s) renamed`
        );
      }
    } catch (e) {
      errors.push(`${label} (county name): ${e.message || String(e)}`);
    }
  }

  for (const ch of countyChanges) {
    const countyLabel = `${ch.agency.county || "County"}, ${ch.agency.state || ""}`;
    const value = ch.newVal;
    const allowEmpty = isAgencyStateFederal(ch.agency);
    if (!value) {
      if (!allowEmpty) {
        errors.push(`${countyLabel}: county abbreviation must be at least 2 characters`);
        continue;
      }
    } else if (value.length < 2 || !/^[A-Z0-9]+$/.test(value)) {
      errors.push(`${countyLabel}: county abbreviation must be at least 2 characters (letters or numbers)`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/county-abbrev`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ countyAbbrev: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "County abbreviation update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        summaries.push(
          `${countyLabel} (county abbrev): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"}, admin groups ${data.groupRenamed ? "renamed" : "ensured"}`
        );
      }
    } catch (e) {
      errors.push(`${countyLabel} (county abbrev): ${e.message || String(e)}`);
    }
  }

  for (const a of agenciesToUpdate) {
    const idx = a._id ?? a.id;
    const displayName = String(nameSnapshotById[String(idx)] || a.name || "Agency");

    if (agencyAbbrevChanged(a)) {
      const gp = String(a.groupPrefix || "").trim();
      if (!gp || !/^[A-Za-z0-9 _-]+$/.test(gp)) {
        errors.push(
          `${String(a.name || displayName)}: invalid abbreviation / short name (letters, numbers, spaces, dashes, underscores)`
        );
        continue;
      }
      const gpLower = gp.toLowerCase();
      const dup = agencies.some((other) => {
        if (String(other._id ?? other.id) === String(idx)) return false;
        return String(other.groupPrefix || "").trim().toLowerCase() === gpLower;
      });
      if (dup) {
        errors.push(
          `${String(a.name || displayName)}: agency abbreviation / short name already exists`
        );
        continue;
      }
      try {
        const res = await fetch(
          `/api/agencies/${encodeURIComponent(idx)}/rename-group-prefix`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ groupPrefix: gp }),
          }
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(
            typeof data.error === "string"
              ? data.error
              : data.error?.detail || data.error || "Abbreviation / short name rename failed"
          );
        }
        if (!data.skipped) {
          summaries.push(
            `${String(a.name || displayName)} (abbrev): ${data.usersUpdated ?? 0} user(s), ${data.groupsRenamed ?? 0} group(s), ${data.templatesUpdated ?? 0} template(s)`
          );
        }
      } catch (e) {
        errors.push(`${String(a.name || displayName)} (abbrev): ${e.message || String(e)}`);
        continue;
      }
    }

    if (agencyNameChanged(a)) {
      const newName = String(a.name || "").trim();
      if (!newName) {
        errors.push(`${displayName}: agency name is required`);
        continue;
      }
      try {
        const res = await fetch(
          `/api/agencies/${encodeURIComponent(idx)}/rename-agency-name`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name: newName }),
          }
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(
            typeof data.error === "string"
              ? data.error
              : data.error?.detail || data.error || "Name rename failed"
          );
        }
        if (!data.skipped) {
          summaries.push(
            `${newName} (name): ${data.usersUpdated ?? 0} user(s), ${data.groupsUpdated ?? 0} group(s)`
          );
        }
      } catch (e) {
        errors.push(`${displayName} (name): ${e.message || String(e)}`);
      }
    }
  }

  for (const ch of colorTypeRegionChanges) {
    try {
      const res = await fetch(ch.url, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(ch.body),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || ch.failLabel
        );
      }
      summaries.push(ch.line);
    } catch (e) {
      errors.push(`${ch.failLabel}: ${e.message || String(e)}`);
    }
  }

  if (groupsDirty && editingAgencyId) {
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(editingAgencyId)}/access-groups`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ allowedAdminGroupIds: Array.from(accessGroupsPickedIds) })
      });
      const out = await res.json();
      if (!res.ok) throw new Error(out.error || "Access groups save failed");
      summaries.push("Extra groups updated");
    } catch (e) {
      errors.push(e.message || "Access groups save failed");
    }
  }

  if (editAgencySaveBtn) editAgencySaveBtn.disabled = false;
  if (errors.length) {
    setEditMsg(errors.join(" | "), false);
    return false;
  }

  const summaryText = summaries.length
    ? `Agency updates applied. ${summaries.join("; ")}`
    : "No attribute changes.";

  clearAgencyAttributeSnapshots();
  await loadAgenciesWithCounts();
  return { ok: true, summary: summaryText };
}

function getColorTypeRegionChangesToApply() {
  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(editingAgencyId));
  if (!a || !editingAgencyId) return [];
  const id = String(editingAgencyId);
  const idx = a._id ?? a.id;
  const changes = [];
  const newColor = String(a.color || "").trim();
  const oldColor = String(colorSnapshotById[id] || "").trim();
  if (newColor && newColor !== oldColor) {
    changes.push({
      url: `/api/agencies/${encodeURIComponent(idx)}/color`,
      body: { color: newColor },
      line: `Color: ${oldColor || "(none)"} → ${newColor}`,
      failLabel: "Color update failed",
    });
  }
  const newType = String(a.type || "").trim();
  const oldType = String(typeSnapshotById[id] || "").trim();
  if (newType && newType !== oldType) {
    changes.push({
      url: `/api/agencies/${encodeURIComponent(idx)}/type`,
      body: { type: newType },
      line: `Type: ${oldType || "(none)"} → ${newType}`,
      failLabel: "Type update failed",
    });
  }
  const newRegion = String(a.regionId || "").trim();
  const oldRegion = String(regionSnapshotById[id] || "").trim();
  if (newRegion !== oldRegion) {
    changes.push({
      url: `/api/agencies/${encodeURIComponent(idx)}/region`,
      body: { regionId: newRegion || null },
      line: `Region: ${regionNameForId(oldRegion) || oldRegion || "(none)"} → ${regionNameForId(newRegion) || newRegion || "(none)"}`,
      failLabel: "Region update failed",
    });
  }
  return changes;
}

function accessGroupsDirty() {
  const now = Array.from(accessGroupsPickedIds || []).map(String).sort().join(",");
  const snap = (accessGroupsSnapshotIds || []).map(String).sort().join(",");
  return now !== snap;
}

function clearAgencyAttributeSnapshots() {
  nameSnapshotById = {};
  abbrevSnapshotById = {};
  stateSnapshotById = {};
  countySnapshotById = {};
  countyAbbrevSnapshotById = {};
  stateFederalSnapshotById = {};
  colorSnapshotById = {};
  typeSnapshotById = {};
  regionSnapshotById = {};
  accessGroupsSnapshotIds = [];
}

function snapshotAgenciesForEdit() {
  nameSnapshotById = {};
  abbrevSnapshotById = {};
  stateSnapshotById = {};
  countySnapshotById = {};
  countyAbbrevSnapshotById = {};
  stateFederalSnapshotById = {};
  colorSnapshotById = {};
  typeSnapshotById = {};
  regionSnapshotById = {};
  for (const a of agencies) {
    const id = String(a._id ?? a.id ?? "");
    if (!id) continue;
    nameSnapshotById[id] = String(a.name || "").trim();
    abbrevSnapshotById[id] = String(a.groupPrefix || "").trim();
    stateSnapshotById[id] = String(a.state || "").trim().toUpperCase();
    countySnapshotById[id] = String(a.county || "").trim();
    countyAbbrevSnapshotById[id] = String(a.countyAbbrev || "").trim().toUpperCase();
    stateFederalSnapshotById[id] = isAgencyStateFederal(a);
    colorSnapshotById[id] = String(a.color || "").trim();
    typeSnapshotById[id] = String(a.type || "").trim();
    regionSnapshotById[id] = String(a.regionId || "").trim();
  }
}

function restoreAgenciesFromSnapshots() {
  for (const a of agencies) {
    const id = String(a._id ?? a.id ?? "");
    if (!id) continue;
    if (id in nameSnapshotById) a.name = nameSnapshotById[id];
    if (id in abbrevSnapshotById) a.groupPrefix = abbrevSnapshotById[id];
    if (id in stateSnapshotById) a.state = stateSnapshotById[id];
    if (id in countySnapshotById) a.county = countySnapshotById[id];
    if (id in countyAbbrevSnapshotById) a.countyAbbrev = countyAbbrevSnapshotById[id];
    if (id in stateFederalSnapshotById) a.stateFederalAgency = !!stateFederalSnapshotById[id];
    if (id in colorSnapshotById) a.color = colorSnapshotById[id];
    if (id in typeSnapshotById) a.type = typeSnapshotById[id];
    if (id in regionSnapshotById) {
      a.regionId = regionSnapshotById[id] || "";
      a.regionName = regionNameForId(a.regionId);
    }
  }
}

// ---- Access Groups modal ----
const accessGroupsSummary = document.getElementById("accessGroupsSummary");
const accessGroupSearch = document.getElementById("accessGroupSearch");
const accessGroupsBox = document.getElementById("accessGroupsBox");
const accessGroupsInner = document.getElementById("accessGroupsInner");
const accessGroupsSelectAllBtn = document.getElementById("accessGroupsSelectAllBtn");
const accessGroupsClearBtn = document.getElementById("accessGroupsClearBtn");

let accessGroupsAgencyId = null;
let accessGroupsAllGroups = [];
let accessGroupsSelectable = [];
let accessGroupsPickedIds = new Set();

function displayGroupName(name) {
  return String(name || "").replace(/^tak_/i, "");
}

// Exclude this agency's own groups via created_type / created_type_detail (full agency name).
function isGroupRelatedToAgency(group, agency) {
  const name = String(agency?.name || "").trim();
  if (!name) return false;
  const attrs =
    group && typeof group === "object" && group.attributes && typeof group.attributes === "object"
      ? group.attributes
      : {};
  const createdType = String(attrs.created_type || "").trim().toLowerCase();
  if (createdType !== "agency") return false;
  const detail = String(attrs.created_type_detail || "").trim();
  return detail.toLowerCase() === name.toLowerCase();
}

function renderAccessGroupsGrid(filterText) {
  if (!accessGroupsInner) return;
  const q = String(filterText || "").trim().toLowerCase();
  const list = q
    ? accessGroupsSelectable.filter(g => {
        const name = String(g.name || "").toLowerCase();
        const disp = displayGroupName(g.name).toLowerCase();
        return name.includes(q) || disp.includes(q);
      })
    : accessGroupsSelectable;
  const sorted = [...list].sort((a, b) =>
    String(a.name || "").localeCompare(String(b.name || ""), undefined, { sensitivity: "base" })
  );
  accessGroupsInner.innerHTML = sorted.map(g => {
    const id = String(g.pk ?? g.id ?? "");
    const checked = accessGroupsPickedIds.has(id) ? "checked" : "";
    return `
      <label class="groupItem">
        <input type="checkbox" value="${escAttr(id)}" ${checked} />
        <span>${esc(displayGroupName(g.name))}</span>
      </label>
    `;
  }).join("");

  if (!accessGroupsBox) return;
  accessGroupsBox.querySelectorAll("input[type=checkbox]").forEach(cb => {
    cb.addEventListener("change", () => {
      const id = String(cb.value);
      if (cb.checked) accessGroupsPickedIds.add(id);
      else accessGroupsPickedIds.delete(id);
    });
  });
}

async function loadAccessGroupsForEditAgency(agencyId) {
  const a = (agencies || []).find(x => String(x._id ?? x.id) === String(agencyId));
  if (!a || !accessGroupsInner) {
    accessGroupsSnapshotIds = [];
    return;
  }
  accessGroupsAgencyId = agencyId;
  if (accessGroupsSummary) {
    accessGroupsSummary.textContent = `Loading groups for "${a.name || ""}"...`;
    accessGroupsSummary.className = "msg";
  }
  accessGroupsInner.innerHTML = "";
  if (accessGroupSearch) accessGroupSearch.value = "";
  accessGroupsPickedIds = new Set();
  accessGroupsSnapshotIds = [];

  try {
    const [groupsRes, allowedRes] = await Promise.all([
      fetch("/api/groups"),
      fetch(`/api/agencies/${encodeURIComponent(agencyId)}/access-groups`)
    ]);
    const groupsData = await groupsRes.json();
    const allowedData = await allowedRes.json();
    if (!groupsRes.ok) throw new Error(groupsData.error || "Failed to load groups");
    if (!allowedRes.ok) throw new Error(allowedData.error || "Failed to load access groups");

    const allGroups = Array.isArray(groupsData)
      ? groupsData
      : (Array.isArray(groupsData.groups) ? groupsData.groups : []);
    accessGroupsAllGroups = allGroups;
    accessGroupsSelectable = allGroups.filter(g => !isGroupRelatedToAgency(g, a));
    const allowed = Array.isArray(allowedData.allowedAdminGroupIds) ? allowedData.allowedAdminGroupIds : [];
    accessGroupsPickedIds = new Set(allowed.map(String));
    accessGroupsSnapshotIds = allowed.map(String);

    if (accessGroupsSummary) {
      accessGroupsSummary.textContent = "";
      accessGroupsSummary.className = "msg ok";
    }
    renderAccessGroupsGrid("");
  } catch (e) {
    if (accessGroupsSummary) {
      accessGroupsSummary.textContent = e.message || "Failed to load.";
      accessGroupsSummary.className = "msg bad";
    }
  }
}

if (accessGroupSearch) accessGroupSearch.addEventListener("input", () => {
  renderAccessGroupsGrid(accessGroupSearch.value);
});
if (accessGroupsSelectAllBtn) accessGroupsSelectAllBtn.onclick = () => {
  accessGroupsSelectable.forEach(g => accessGroupsPickedIds.add(String(g.pk ?? g.id ?? "")));
  renderAccessGroupsGrid(accessGroupSearch?.value || "");
};
if (accessGroupsClearBtn) accessGroupsClearBtn.onclick = () => {
  accessGroupsPickedIds.clear();
  renderAccessGroupsGrid(accessGroupSearch?.value || "");
};

function isEditAgencyModalOpen() {
  return !!(editAgencyOverlay && editAgencyOverlay.style.display !== "none");
}

function fillEditAgencyForm(a) {
  if (!editAgencyForm || !a) return;
  const set = (name, value) => {
    const el = editAgencyForm.elements[name];
    if (el) el.value = value;
  };
  set("name", a.name || "");
  set("groupPrefix", a.groupPrefix || "");
  set("state", String(a.state || "").trim().toUpperCase());
  set("stateFederalAgency", isAgencyStateFederal(a) ? "yes" : "no");
  set("county", a.county || "");
  set("countyAbbrev", String(a.countyAbbrev || "").trim().toUpperCase());
  set("type", a.type || "");
  set("color", a.color || "");
  set("regionId", a.regionId || "");
  const sf = document.getElementById("editstateFederalAgencySelect");
  if (typeof window.takSyncStateFederalAgencyFields === "function" && sf) {
    window.takSyncStateFederalAgencyFields(sf);
  }
  if (typeof window.takSyncAgencyRegionLock === "function") {
    window.takSyncAgencyRegionLock(editAgencyForm);
  }
}

function applyEditFormToAgencies() {
  if (!editAgencyForm || !editingAgencyId) return null;
  const a = agencies.find((x) => String(x._id ?? x.id) === String(editingAgencyId));
  if (!a) return null;
  const idx = a._id ?? a.id;
  const val = (name) => {
    const el = editAgencyForm.elements[name];
    return el ? String(el.value || "") : "";
  };
  a.name = val("name").trim();
  a.groupPrefix = val("groupPrefix").trim();
  updateAgencyStateFederalLocal(idx, val("stateFederalAgency"));
  updateAgencyStateLocal(idx, val("state"));
  updateAgencyCountyNameLocal(idx, val("county"));
  updateAgencyCountyAbbrevLocal(idx, val("countyAbbrev"));
  a.type = val("type").trim();
  a.color = val("color").trim();
  const regionEl = editAgencyForm.elements.regionId;
  a.regionId = regionEl ? String(regionEl.value || "").trim() : "";
  a.regionName = regionNameForId(a.regionId);
  return a;
}

function openEditAgencyModal() {
  if (!editAgencyOverlay) return;
  editAgencyOverlay.style.display = "flex";
  document.body.classList.add("noScroll");
  document.body.style.overflow = "hidden";
}

function closeEditAgencyModal() {
  if (!editAgencyOverlay) return;
  setAddAdminsOpen(false);
  setAddAdminsButtonEnabled(false);
  flushLookupDomainOnClose();
  restoreAgenciesFromSnapshots();
  editAgencyOverlay.style.display = "none";
  document.body.classList.remove("noScroll");
  document.body.style.overflow = "";
  editingAgencyId = null;
  currentLookupAgencyId = null;
  clearAgencyAttributeSnapshots();
  setEditMsg("");
  if (editAgencySaveBtn) editAgencySaveBtn.disabled = false;
}

window.openEditAgency = async (agencyId) => {
  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(agencyId));
  if (!a) {
    setMsg("Could not find agency.", false);
    return;
  }
  editingAgencyId = String(a._id ?? a.id ?? "");
  snapshotAgenciesForEdit();
  if (editAgencyTitle) {
    const name = String(a.name || "").trim();
    editAgencyTitle.textContent = name ? `Edit Agency - ${name}` : "Edit Agency";
  }
  setEditMsg("");
  fillEditAgencyForm(a);
  fillDomainSection(editingAgencyId);
  openEditAgencyModal();
  const loads = [loadAdminsForEditAgency(editingAgencyId)];
  if (accessGroupsInner) loads.push(loadAccessGroupsForEditAgency(editingAgencyId));
  await Promise.all(loads);
};

if (editAgencyCloseBtn) {
  editAgencyCloseBtn.onclick = () => closeEditAgencyModal();
}
window.addEventListener("keydown", (e) => {
  if (e.key !== "Escape" || !isEditAgencyModalOpen()) return;
  if (addAdminsOpen) {
    setAddAdminsOpen(false);
    return;
  }
  closeEditAgencyModal();
});

if (editAgencyForm) {
  editAgencyForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    setEditMsg("");
    if (!editingAgencyId) {
      setEditMsg("No agency selected.", false);
      return;
    }
    applyEditFormToAgencies();
    const result = await finishAgencyAttributesEditing();
    if (!result || result.ok !== true) return;
    closeEditAgencyModal();
    setListMsg(result.summary, true);
  });
}

const exportAgenciesCsvBtn = document.getElementById("exportAgenciesCsvBtn");
if (exportAgenciesCsvBtn) {
  exportAgenciesCsvBtn.addEventListener("click", async () => {
    const prevLabel = exportAgenciesCsvBtn.textContent;
    exportAgenciesCsvBtn.disabled = true;
    exportAgenciesCsvBtn.textContent = "Exporting…";
    try {
      const res = await fetch("/api/agencies/export-csv");
      if (!res.ok) {
        let errText = "Export failed";
        try {
          const body = await res.json();
          errText = body?.error || errText;
        } catch (_) {
          // ignore
        }
        setMsg(errText, false);
        return;
      }
      const blob = await res.blob();
      const cd = res.headers.get("Content-Disposition") || "";
      const match = /filename="([^"]+)"/i.exec(cd);
      const filename = match ? match[1] : "tak-portal-agencies.csv";
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      setMsg(`Exported ${filename}.`, true);
    } catch (err) {
      setMsg(err?.message || "Export failed", false);
    } finally {
      exportAgenciesCsvBtn.disabled = false;
      exportAgenciesCsvBtn.textContent = prevLabel;
    }
  });
}

if (agenciesFirstBtn) {
  agenciesFirstBtn.onclick = () => {
    if (agenciesPage <= 1) return;
    agenciesPage = 1;
    renderAgencies();
  };
}
if (agenciesPrevBtn) {
  agenciesPrevBtn.onclick = () => {
    if (agenciesPage <= 1) return;
    agenciesPage -= 1;
    renderAgencies();
  };
}
if (agenciesNextBtn) {
  agenciesNextBtn.onclick = () => {
    const totalPages = Math.max(1, Math.ceil(getFilteredAgencies().length / AGENCIES_PAGE_SIZE));
    if (agenciesPage >= totalPages) return;
    agenciesPage += 1;
    renderAgencies();
  };
}
if (agenciesLastBtn) {
  agenciesLastBtn.onclick = () => {
    const totalPages = Math.max(1, Math.ceil(getFilteredAgencies().length / AGENCIES_PAGE_SIZE));
    if (agenciesPage >= totalPages) return;
    agenciesPage = totalPages;
    renderAgencies();
  };
}

function applyAgencyListFilter() {
  agenciesPage = 1;
  renderAgencies();
}

function scheduleAgencyListFilter() {
  clearTimeout(agenciesFilterTimer);
  agenciesFilterTimer = setTimeout(applyAgencyListFilter, 100);
}

if (agencyStateFilter) agencyStateFilter.addEventListener("change", applyAgencyListFilter);
if (agencyTypeFilter) agencyTypeFilter.addEventListener("change", applyAgencyListFilter);
if (agencyColorFilter) agencyColorFilter.addEventListener("change", applyAgencyListFilter);
if (agencySearch) {
  agencySearch.addEventListener("input", scheduleAgencyListFilter);
  agencySearch.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      agencySearch.value = "";
      applyAgencyListFilter();
    }
  });
}
fillAgencyListFilterOptions();

// click-to-sort + keyboard support (Enter/Space)
agencyTable.querySelectorAll("thead th[data-sort]").forEach(th => {
  th.addEventListener("click", () => {
    const key = th.dataset.sort;
    if (sortState.key === key){
      sortState.dir *= -1; // toggle direction
    } else {
      sortState.key = key;
      sortState.dir = 1;
    }
    renderAgencies();
  });

  th.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " "){
      e.preventDefault();
      th.click();
    }
  });
});

// Initialize last county + data on page load
loadLastCounty();
loadAgenciesWithCounts();

// Wire up auto-fill for county abbreviation based on existing agencies
function syncUsernameIdentifierFormLabels() {
  if (!addForm) return;
  const select = addForm.elements.usernameTokenPlacement;
  const labelEl = document.getElementById("usernameIdentifierLabelText");
  if (!select || !labelEl) return;
  const isPrefix = String(select.value || "suffix").toLowerCase() === "prefix";
  labelEl.textContent = isPrefix ? "Username Prefix" : "Username Suffix";
}

if (addForm) {
  const stateInput = addForm.elements.state;
  const countyInput = addForm.elements.county;
  const placementSelect = addForm.elements.usernameTokenPlacement;
  if (placementSelect) {
    placementSelect.addEventListener("change", syncUsernameIdentifierFormLabels);
    syncUsernameIdentifierFormLabels();
  }
  if (stateInput) {
    stateInput.addEventListener("change", syncCountyAbbrevFromExisting);
  }
  if (countyInput) {
    countyInput.addEventListener("blur", syncCountyAbbrevFromExisting);
  }
}
