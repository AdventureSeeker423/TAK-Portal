const COUNTY_KEY = "lastCountyUsed";

function loadLastCounty() {
  try {
    const stored = localStorage.getItem(COUNTY_KEY);
    if (stored) {
      addForm.elements.county.value = stored;
    }
  } catch (e) {
    // localStorage might be unavailable in some environments; fail silently
  }
}

function saveLastCounty(county) {
  try {
    localStorage.setItem(COUNTY_KEY, county);
  } catch (e) {
    // ignore storage errors
  }
}

function findExistingCountyAbbrev(state, county) {
  const s = String(state || "").trim().toUpperCase();
  const c = String(county || "").trim().toLowerCase();
  if (!s || !c) return null;
  const match = (agencies || []).find(a =>
    String(a.state || "").trim().toUpperCase() === s &&
    String(a.county || "").trim().toLowerCase() === c &&
    String(a.countyAbbrev || "").trim() !== ""
  );
  return match ? String(match.countyAbbrev).trim().toUpperCase() : null;
}

function syncCountyAbbrevFromExisting() {
  if (!addForm) return;
  const stateInput = addForm.elements.state;
  const countyInput = addForm.elements.county;
  const countyAbbrevInput = addForm.elements.countyAbbrev;
  if (!stateInput || !countyInput || !countyAbbrevInput) return;

  const normalizedCounty = normalizeCountyName(countyInput.value);
  if (normalizedCounty !== countyInput.value) {
    countyInput.value = normalizedCounty;
  }

  const existing = findExistingCountyAbbrev(stateInput.value, countyInput.value);
  if (existing) {
    countyAbbrevInput.value = existing;
    countyAbbrevInput.readOnly = true;
    countyAbbrevInput.classList.add("readonly");
  } else {
    if (countyAbbrevInput.readOnly) {
      countyAbbrevInput.readOnly = false;
      countyAbbrevInput.classList.remove("readonly");
    }
    // Do not overwrite user-entered value if they already started typing
    if (!countyAbbrevInput.value) {
      countyAbbrevInput.value = "";
    }
  }
}

let countyAbbrevAgencyId = null;

function showCountyAbbrevModal(on) {
  const overlay = document.getElementById("countyAbbrevOverlay");
  if (!overlay) return;
  overlay.style.display = on ? "flex" : "none";
  document.body.style.overflow = on ? "hidden" : "";
}

window.openCountyAbbrevModal = (agencyId) => {
  countyAbbrevAgencyId = agencyId;
  const input = document.getElementById("countyAbbrevInput");
  const summary = document.getElementById("countyAbbrevSummary");
  if (input) input.value = "";
  if (summary) {
    const a = (agencies || []).find(x => String(x._id ?? x.id) === String(agencyId));
    summary.textContent = a
      ? `Set county abbreviation for ${a.name} (${a.groupPrefix}).`
      : "Set county abbreviation for this agency.";
    summary.className = "msg";
  }
  showCountyAbbrevModal(true);
};

const countyAbbrevOverlay = document.getElementById("countyAbbrevOverlay");
const countyAbbrevCloseBtn = document.getElementById("countyAbbrevCloseBtn");
const countyAbbrevCancelBtn = document.getElementById("countyAbbrevCancelBtn");
const countyAbbrevSaveBtn = document.getElementById("countyAbbrevSaveBtn");

if (countyAbbrevOverlay) {
  countyAbbrevOverlay.addEventListener("click", (e) => {
    if (e.target === countyAbbrevOverlay) showCountyAbbrevModal(false);
  });
}
if (countyAbbrevCloseBtn) countyAbbrevCloseBtn.onclick = () => showCountyAbbrevModal(false);
if (countyAbbrevCancelBtn) countyAbbrevCancelBtn.onclick = () => showCountyAbbrevModal(false);
if (countyAbbrevSaveBtn) {
  countyAbbrevSaveBtn.onclick = async () => {
    const input = document.getElementById("countyAbbrevInput");
    const summary = document.getElementById("countyAbbrevSummary");
    const raw = (input && input.value) || "";
    const value = String(raw).trim().toUpperCase().replace(/[^A-Z]/g, "");
    if (!value || value.length < 2) {
      if (summary) {
        summary.textContent = "County abbreviation must be at least 2 letters.";
        summary.className = "msg bad";
      }
      return;
    }
    if (!countyAbbrevAgencyId) return;

    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(countyAbbrevAgencyId)}/county-abbrev`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ countyAbbrev: value }),
      });
      const out = await res.json();
      if (!res.ok) {
        if (summary) {
          summary.textContent = out.error || "Failed to update county abbreviation.";
          summary.className = "msg bad";
        }
        return;
      }
      showCountyAbbrevModal(false);
      setMsg("County abbreviation updated.", true);
      loadAgenciesWithCounts();
    } catch (e) {
      if (summary) {
        summary.textContent = "Failed to update county abbreviation.";
        summary.className = "msg bad";
      }
    }
  };
}

addForm.onsubmit = async (e) => {
  e.preventDefault();
  setMsg("");

  // Normalize county before sending to backend
  const countyInput = addForm.elements.county;
  countyInput.value = normalizeCountyName(countyInput.value);

  // If an existing county abbreviation is known for this state+county, lock it in.
  const stateInput = addForm.elements.state;
  const countyAbbrevInput = addForm.elements.countyAbbrev;
  if (stateInput && countyInput && countyAbbrevInput) {
    const existing = findExistingCountyAbbrev(stateInput.value, countyInput.value);
    if (existing) {
      countyAbbrevInput.value = existing;
      countyAbbrevInput.readOnly = true;
      countyAbbrevInput.classList.add("readonly");
    }
  }

  // Save last-used county AFTER normalization
  if (countyInput.value) {
    saveLastCounty(countyInput.value);
  }

  const body = Object.fromEntries(new FormData(addForm));

  const res = await fetch("/api/agencies", {
    method:"POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify(body)
  });

  const out = await res.json();
  if(!res.ok){
    setMsg(out.error || "Add failed", false);
    return;
  }

  addForm.reset();

  const placementSelect = addForm.elements.usernameTokenPlacement;
  if (placementSelect) placementSelect.value = "suffix";
  const stateFederalSelect = addForm.elements.stateFederalAgency;
  if (stateFederalSelect) stateFederalSelect.value = "no";
  if (typeof window.takSyncStateFederalAgencyFields === "function" && stateFederalSelect) {
    window.takSyncStateFederalAgencyFields(stateFederalSelect);
  }
  syncUsernameIdentifierFormLabels();

  // Restore last-used county
  loadLastCounty();

  setMsg("Agency added", true);
  loadAgenciesWithCounts();
};

if (refreshBtn) refreshBtn.onclick = () => loadAgenciesWithCounts();

function agencyNameChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in nameSnapshotById)) return false;
  const oldName = String(nameSnapshotById[id] || "").trim();
  const newName = String(a.name || "").trim();
  return oldName && newName && oldName !== newName;
}

function agencyAbbrevChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in abbrevSnapshotById)) return false;
  const oldAbbr = String(abbrevSnapshotById[id] || "").trim().toUpperCase();
  const newAbbr = String(a.groupPrefix || "").trim().toUpperCase();
  return oldAbbr && newAbbr && oldAbbr !== newAbbr;
}

function agencyCountyAbbrevChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in countyAbbrevSnapshotById)) return false;
  const oldVal = String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase();
  const newVal = String(a.countyAbbrev || "").trim().toUpperCase();
  return oldVal !== newVal;
}

function agencyCountyNameChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in countySnapshotById)) return false;
  const oldVal = normalizeCountyName(countySnapshotById[id]);
  const newVal = normalizeCountyName(a.county);
  return oldVal !== newVal;
}

function agencyStateChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in stateSnapshotById)) return false;
  const oldVal = String(stateSnapshotById[id] || "").trim().toUpperCase();
  const newVal = String(a.state || "").trim().toUpperCase();
  return oldVal !== newVal;
}

function agencyStateFederalChanged(a) {
  const id = String(a._id ?? a.id ?? "");
  if (!id || !(id in stateFederalSnapshotById)) return false;
  return !!stateFederalSnapshotById[id] !== isAgencyStateFederal(a);
}

function getStateFederalChangesToApply() {
  return agencies.filter((a) => agencyStateFederalChanged(a));
}

function getStateChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyStateChanged(a)) continue;
    const key = stateEditGroupKeyForAgency(a);
    if (seen.has(key)) continue;
    seen.add(key);
    const id = String(a._id ?? a.id ?? "");
    changes.push({
      agency: a,
      key,
      oldState: String(stateSnapshotById[id] || "").trim().toUpperCase(),
      oldCounty: normalizeCountyName(countySnapshotById[id]),
      oldCountyAbbrev: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
      newVal: String(a.state || "").trim().toUpperCase(),
    });
  }
  return changes;
}

function getCountyNameChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyCountyNameChanged(a)) continue;
    const id = String(a._id ?? a.id ?? "");
    if (isAgencyStateFederal(a)) {
      const key = "sf:" + id;
      if (seen.has(key)) continue;
      seen.add(key);
      changes.push({
        agency: a,
        key,
        state: String(stateSnapshotById[id] || a.state || "").trim().toUpperCase(),
        oldCounty: normalizeCountyName(countySnapshotById[id]),
        newVal: normalizeCountyName(a.county),
      });
      continue;
    }
    const oldCounty = normalizeCountyName(countySnapshotById[id]);
    const state = String(stateSnapshotById[id] || a.state || "").trim().toUpperCase();
    const key = countyMatchKey(state, oldCounty);
    if (seen.has(key)) continue;
    seen.add(key);
    changes.push({
      agency: a,
      key,
      state,
      oldCounty,
      newVal: normalizeCountyName(a.county),
    });
  }
  return changes;
}

function getCountyAbbrevChangesToApply() {
  const seen = new Set();
  const changes = [];
  for (const a of agencies) {
    if (!agencyCountyAbbrevChanged(a)) continue;
    const id = String(a._id ?? a.id ?? "");
    const newVal = String(a.countyAbbrev || "").trim().toUpperCase();
    if (isAgencyStateFederal(a) || !newVal) {
      const key = "sf:" + id;
      if (seen.has(key)) continue;
      seen.add(key);
      changes.push({
        agency: a,
        key,
        newVal,
        oldVal: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
      });
      continue;
    }
    const key = countyEditGroupKeyForAgency(a);
    if (seen.has(key)) continue;
    seen.add(key);
    changes.push({
      agency: a,
      key,
      newVal,
      oldVal: String(countyAbbrevSnapshotById[id] || "").trim().toUpperCase(),
    });
  }
  return changes;
}

function getAgenciesWithAttributeChanges() {
  return agencies.filter((a) => agencyNameChanged(a) || agencyAbbrevChanged(a));
}

async function finishAgencyAttributesEditing() {
  const agenciesToUpdate = getAgenciesWithAttributeChanges();
  const stateFederalChanges = getStateFederalChangesToApply();
  const stateChanges = getStateChangesToApply();
  const countyNameChanges = getCountyNameChangesToApply();
  const countyChanges = getCountyAbbrevChangesToApply();

  // Validate county requirements against the edited in-memory values.
  for (const a of agencies) {
    const label = String(a.name || a.groupPrefix || "Agency");
    const county = normalizeCountyName(a.county);
    const countyAbbrev = String(a.countyAbbrev || "").trim().toUpperCase();
    if (!isAgencyStateFederal(a)) {
      if (!county) {
        setMsg(`${label}: County is required unless State/Federal Agency is Yes`, false);
        return;
      }
      if (!countyAbbrev || countyAbbrev.length < 2) {
        setMsg(
          `${label}: County Abbreviation is required (at least 2 letters) unless State/Federal Agency is Yes`,
          false
        );
        return;
      }
    } else if (countyAbbrev && countyAbbrev.length < 2) {
      setMsg(`${label}: County Abbreviation must be at least 2 letters when provided`, false);
      return;
    }
  }

  const hasWork =
    agenciesToUpdate.length > 0 ||
    stateFederalChanges.length > 0 ||
    stateChanges.length > 0 ||
    countyNameChanges.length > 0 ||
    countyChanges.length > 0;

  if (hasWork) {
    const lines = [];
    for (const a of stateFederalChanges) {
      const id = String(a._id ?? a.id ?? "");
      const oldYes = !!stateFederalSnapshotById[id];
      lines.push(
        `${String(nameSnapshotById[id] || a.name || "Agency")}: State/Federal ${oldYes ? "Yes" : "No"} → ${isAgencyStateFederal(a) ? "Yes" : "No"}`
      );
    }
    for (const ch of stateChanges) {
      lines.push(
        `${ch.oldState || "State"}, ${ch.oldCounty || "County"}, ${ch.oldCountyAbbrev || "abbrev"}: state ${ch.oldState || "(none)"} → ${ch.newVal} (matching agencies; state groups renamed only if no agencies remain on ${ch.oldState})`
      );
    }
    for (const ch of countyNameChanges) {
      lines.push(
        `${ch.state}, ${ch.oldCounty || "County"}: county name ${ch.oldCounty || "(none)"} → ${ch.newVal || "(none)"} (all agencies in this county; county groups renamed)`
      );
    }
    for (const ch of countyChanges) {
      const countyLabel = `${ch.agency.county || "County"}, ${ch.agency.state || ""}`;
      lines.push(
        `${countyLabel}: county abbrev ${ch.oldVal || "(none)"} → ${ch.newVal || "(none)"} (all agencies in this county)`
      );
    }
    for (const a of agenciesToUpdate) {
      const id = String(a._id ?? a.id ?? "");
      const parts = [];
      if (agencyNameChanged(a)) {
        parts.push(`name: ${nameSnapshotById[id]} → ${String(a.name || "").trim()}`);
      }
      if (agencyAbbrevChanged(a)) {
        parts.push(
          `abbrev: ${abbrevSnapshotById[id]} → ${String(a.groupPrefix || "").trim().toUpperCase()}`
        );
      }
      const label = String(nameSnapshotById[id] || a.name || "Agency");
      lines.push(`${label}: ${parts.join("; ")}`);
    }
    const ok = confirm(
      `Apply agency changes?\n\n${lines.join("\n")}`
    );
    if (!ok) return;
  }

  const doneBtn = agencyAttributesDoneBtn;
  const cancelBtn = agencyAttributesCancelBtn;
  if (hasWork) {
    if (doneBtn) doneBtn.disabled = true;
    if (cancelBtn) cancelBtn.disabled = true;
    setMsg("Applying agency changes…", true);
  }

  const errors = [];
  const summaries = [];

  for (const a of stateFederalChanges) {
    const idx = a._id ?? a.id;
    const displayName = String(nameSnapshotById[String(idx)] || a.name || "Agency");
    const yes = isAgencyStateFederal(a);
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/state-federal`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ stateFederalAgency: yes }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "State/Federal update failed"
        );
      }
      summaries.push(`${displayName} (State/Federal): ${yes ? "Yes" : "No"}`);
    } catch (e) {
      errors.push(`${displayName} (State/Federal): ${e.message || String(e)}`);
    }
  }

  for (const ch of stateChanges) {
    const label = `${ch.oldState || "State"}, ${ch.oldCounty || "County"}, ${ch.oldCountyAbbrev || "abbrev"}`;
    const value = ch.newVal;
    if (!value) {
      errors.push(`${label}: state is required`);
      continue;
    }
    if (!AGENCY_STATE_OPTIONS.includes(value)) {
      errors.push(`${label}: invalid state code`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/state`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ state: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "State update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        let summary = `${label} (state): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"} updated`;
        if (data.stateGroupsRenamed) {
          summary += `, ${data.groupsRenamed ?? 0} state group(s) renamed`;
        }
        summaries.push(summary);
      }
    } catch (e) {
      errors.push(`${label} (state): ${e.message || String(e)}`);
    }
  }

  for (const ch of countyNameChanges) {
    const label = `${ch.state}, ${ch.oldCounty || "County"}`;
    const value = ch.newVal;
    const allowEmpty = isAgencyStateFederal(ch.agency);
    if (!value && !allowEmpty) {
      errors.push(`${label}: county name is required`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/county-name`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ county: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "County name update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        summaries.push(
          `${label} (county name): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"}, ${data.groupsRenamed ?? 0} county group(s) renamed`
        );
      }
    } catch (e) {
      errors.push(`${label} (county name): ${e.message || String(e)}`);
    }
  }

  for (const ch of countyChanges) {
    const countyLabel = `${ch.agency.county || "County"}, ${ch.agency.state || ""}`;
    const value = ch.newVal;
    const allowEmpty = isAgencyStateFederal(ch.agency);
    if (!value) {
      if (!allowEmpty) {
        errors.push(`${countyLabel}: county abbreviation must be at least 2 letters`);
        continue;
      }
    } else if (value.length < 2 || !/^[A-Z]+$/.test(value)) {
      errors.push(`${countyLabel}: county abbreviation must be at least 2 letters`);
      continue;
    }
    const idx = ch.agency._id ?? ch.agency.id;
    try {
      const res = await fetch(`/api/agencies/${encodeURIComponent(idx)}/county-abbrev`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ countyAbbrev: value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(
          typeof data.error === "string"
            ? data.error
            : data.error?.detail || data.error || "County abbreviation update failed"
        );
      }
      if (!data.skipped) {
        const updatedCount = Array.isArray(data.updatedIndexes) ? data.updatedIndexes.length : 0;
        summaries.push(
          `${countyLabel} (county abbrev): ${updatedCount || 1} agenc${updatedCount === 1 ? "y" : "ies"}, admin groups ${data.groupRenamed ? "renamed" : "ensured"}`
        );
      }
    } catch (e) {
      errors.push(`${countyLabel} (county abbrev): ${e.message || String(e)}`);
    }
  }

  for (const a of agenciesToUpdate) {
    const idx = a._id ?? a.id;
    const displayName = String(nameSnapshotById[String(idx)] || a.name || "Agency");

    if (agencyAbbrevChanged(a)) {
      const gp = String(a.groupPrefix || "").trim().toUpperCase();
      if (!/^[A-Z0-9_-]+$/.test(gp)) {
        errors.push(`${String(a.name || displayName)}: invalid abbreviation`);
        continue;
      }
      try {
        const res = await fetch(
          `/api/agencies/${encodeURIComponent(idx)}/rename-group-prefix`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ groupPrefix: gp }),
          }
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(
            typeof data.error === "string"
              ? data.error
              : data.error?.detail || data.error || "Abbreviation rename failed"
          );
        }
        if (!data.skipped) {
          summaries.push(
            `${String(a.name || displayName)} (abbrev): ${data.usersUpdated ?? 0} user(s), ${data.groupsRenamed ?? 0} group(s), ${data.templatesUpdated ?? 0} template(s)`
          );
        }
      } catch (e) {
        errors.push(`${String(a.name || displayName)} (abbrev): ${e.message || String(e)}`);
        continue;
      }
    }

    if (agencyNameChanged(a)) {
      const newName = String(a.name || "").trim();
      if (!newName) {
        errors.push(`${displayName}: agency name is required`);
        continue;
      }
      try {
        const res = await fetch(
          `/api/agencies/${encodeURIComponent(idx)}/rename-agency-name`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name: newName }),
          }
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          throw new Error(
            typeof data.error === "string"
              ? data.error
              : data.error?.detail || data.error || "Name rename failed"
          );
        }
        if (!data.skipped) {
          summaries.push(
            `${newName} (name): ${data.usersUpdated ?? 0} user(s), ${data.groupsUpdated ?? 0} group(s)`
          );
        }
      } catch (e) {
        errors.push(`${displayName} (name): ${e.message || String(e)}`);
      }
    }
  }

  if (doneBtn) doneBtn.disabled = false;
  if (cancelBtn) cancelBtn.disabled = false;
  if (errors.length) {
    setMsg(errors.join(" | "), false);
    return;
  }

  agencyAttributesEditMode = false;
  nameSnapshotById = {};
  abbrevSnapshotById = {};
  stateSnapshotById = {};
  countySnapshotById = {};
  countyAbbrevSnapshotById = {};
  stateFederalSnapshotById = {};
  if (agencyAttributesEditBtn) agencyAttributesEditBtn.setAttribute("aria-pressed", "false");
  setAgencyAttributesEditControlsVisible(false);

  if (summaries.length) {
    setMsg(`Agency updates applied. ${summaries.join("; ")}`, true);
  }

  await loadAgenciesWithCounts();
}

function cancelAgencyAttributesEditing() {
  for (const a of agencies) {
    const id = String(a._id ?? a.id ?? "");
    if (!id) continue;
    if (id in nameSnapshotById) {
      a.name = nameSnapshotById[id];
    }
    if (id in abbrevSnapshotById) {
      a.groupPrefix = abbrevSnapshotById[id];
    }
    if (id in stateSnapshotById) {
      a.state = stateSnapshotById[id];
    }
    if (id in countySnapshotById) {
      a.county = countySnapshotById[id];
    }
    if (id in countyAbbrevSnapshotById) {
      a.countyAbbrev = countyAbbrevSnapshotById[id];
    }
    if (id in stateFederalSnapshotById) {
      a.stateFederalAgency = !!stateFederalSnapshotById[id];
    }
  }
  agencyAttributesEditMode = false;
  nameSnapshotById = {};
  abbrevSnapshotById = {};
  stateSnapshotById = {};
  countySnapshotById = {};
  countyAbbrevSnapshotById = {};
  stateFederalSnapshotById = {};
  if (agencyAttributesEditBtn) agencyAttributesEditBtn.setAttribute("aria-pressed", "false");
  setAgencyAttributesEditControlsVisible(false);
  renderAgencies();
}

if (agencyAttributesEditBtn) {
  agencyAttributesEditBtn.addEventListener("click", function () {
    nameSnapshotById = {};
    abbrevSnapshotById = {};
    stateSnapshotById = {};
    countySnapshotById = {};
    countyAbbrevSnapshotById = {};
    stateFederalSnapshotById = {};
    for (const a of agencies) {
      const id = String(a._id ?? a.id ?? "");
      if (!id) continue;
      nameSnapshotById[id] = String(a.name || "").trim();
      abbrevSnapshotById[id] = String(a.groupPrefix || "").trim().toUpperCase();
      stateSnapshotById[id] = String(a.state || "").trim().toUpperCase();
      countySnapshotById[id] = String(a.county || "").trim();
      countyAbbrevSnapshotById[id] = String(a.countyAbbrev || "").trim().toUpperCase();
      stateFederalSnapshotById[id] = isAgencyStateFederal(a);
    }
    agencyAttributesEditMode = true;
    agencyAttributesEditBtn.setAttribute("aria-pressed", "true");
    setAgencyAttributesEditControlsVisible(true);
    renderAgencies();
  });
}

if (agencyAttributesDoneBtn) {
  agencyAttributesDoneBtn.addEventListener("click", () => finishAgencyAttributesEditing());
}

if (agencyAttributesCancelBtn) {
  agencyAttributesCancelBtn.addEventListener("click", () => cancelAgencyAttributesEditing());
}

// ---- Access Groups modal ----
const accessGroupsOverlay = document.getElementById("accessGroupsOverlay");
const accessGroupsCloseBtn = document.getElementById("accessGroupsCloseBtn");
const accessGroupsCancelBtn = document.getElementById("accessGroupsCancelBtn");
const accessGroupsSaveBtn = document.getElementById("accessGroupsSaveBtn");
const accessGroupsSummary = document.getElementById("accessGroupsSummary");
const accessGroupSearch = document.getElementById("accessGroupSearch");
const accessGroupsBox = document.getElementById("accessGroupsBox");
const accessGroupsInner = document.getElementById("accessGroupsInner");
const accessGroupsSelectAllBtn = document.getElementById("accessGroupsSelectAllBtn");
const accessGroupsClearBtn = document.getElementById("accessGroupsClearBtn");

let accessGroupsAgencyId = null;
let accessGroupsAllGroups = [];
let accessGroupsSelectable = [];
let accessGroupsPickedIds = new Set();

function displayGroupName(name) {
  return String(name || "").replace(/^tak_/i, "");
}

function getGroupPrefix(groupName) {
  const n = String(groupName || "").trim();
  const withoutTak = n.toLowerCase().startsWith("tak_") ? n.slice(4) : n;
  const spaceIdx = withoutTak.toUpperCase().indexOf(" ");
  if (spaceIdx <= 0) return "";
  return withoutTak.slice(0, spaceIdx).trim().toUpperCase();
}

// Exclude only this agency's own groups (prefix = agency abbreviation). Include global, state, and county.
function isGroupRelatedToAgency(groupName, agency) {
  const prefix = getGroupPrefix(groupName);
  if (!prefix) return false;
  const gp = String(agency?.groupPrefix || "").trim().toUpperCase();
  return prefix === gp;
}

function renderAccessGroupsGrid(filterText) {
  const q = String(filterText || "").trim().toLowerCase();
  const list = q
    ? accessGroupsSelectable.filter(g => {
        const name = String(g.name || "").toLowerCase();
        const disp = displayGroupName(g.name).toLowerCase();
        return name.includes(q) || disp.includes(q);
      })
    : accessGroupsSelectable;
  const sorted = [...list].sort((a, b) =>
    String(a.name || "").localeCompare(String(b.name || ""), undefined, { sensitivity: "base" })
  );
  accessGroupsInner.innerHTML = sorted.map(g => {
    const id = String(g.pk ?? g.id ?? "");
    const checked = accessGroupsPickedIds.has(id) ? "checked" : "";
    return `
      <label class="groupItem">
        <input type="checkbox" value="${escAttr(id)}" ${checked} />
        <span>${esc(displayGroupName(g.name))}</span>
      </label>
    `;
  }).join("");

  accessGroupsBox.querySelectorAll("input[type=checkbox]").forEach(cb => {
    cb.addEventListener("change", () => {
      const id = String(cb.value);
      if (cb.checked) accessGroupsPickedIds.add(id);
      else accessGroupsPickedIds.delete(id);
    });
  });
}

function showAccessGroupsModal(on) {
  if (!accessGroupsOverlay) return;
  accessGroupsOverlay.style.display = on ? "flex" : "none";
  document.body.style.overflow = on ? "hidden" : "";
}

window.openAccessGroupsModal = async (agencyId) => {
  const a = (agencies || []).find(x => String(x._id ?? x.id) === String(agencyId));
  if (!a) {
    setMsg("Agency not found.", false);
    return;
  }
  accessGroupsAgencyId = agencyId;
  accessGroupsSummary.textContent = `Loading groups for "${esc(a.name || "")}"...`;
  accessGroupsSummary.className = "msg";
  accessGroupsInner.innerHTML = "";
  if (accessGroupSearch) accessGroupSearch.value = "";
  accessGroupsPickedIds = new Set();
  showAccessGroupsModal(true);

  try {
    const [groupsRes, allowedRes] = await Promise.all([
      fetch("/api/groups"),
      fetch(`/api/agencies/${encodeURIComponent(agencyId)}/access-groups`)
    ]);
    const groupsData = await groupsRes.json();
    const allowedData = await allowedRes.json();
    if (!groupsRes.ok) throw new Error(groupsData.error || "Failed to load groups");
    if (!allowedRes.ok) throw new Error(allowedData.error || "Failed to load access groups");

    const allGroups = Array.isArray(groupsData) ? groupsData : [];
    accessGroupsSelectable = allGroups.filter(g => !isGroupRelatedToAgency(g.name, a));
    accessGroupsPickedIds = new Set(Array.isArray(allowedData.allowedAdminGroupIds) ? allowedData.allowedAdminGroupIds : []);

    accessGroupsSummary.textContent = `Select extra groups that administrators for "${esc(a.name || "")}" can see. They always see their own agency groups.`;
    accessGroupsSummary.className = "msg ok";
    renderAccessGroupsGrid("");
  } catch (e) {
    accessGroupsSummary.textContent = e.message || "Failed to load.";
    accessGroupsSummary.className = "msg bad";
  }
};

if (accessGroupSearch) accessGroupSearch.addEventListener("input", () => renderAccessGroupsGrid(accessGroupSearch.value));
if (accessGroupsSelectAllBtn) accessGroupsSelectAllBtn.onclick = () => {
  accessGroupsSelectable.forEach(g => accessGroupsPickedIds.add(String(g.pk ?? g.id ?? "")));
  renderAccessGroupsGrid(accessGroupSearch?.value || "");
};
if (accessGroupsClearBtn) accessGroupsClearBtn.onclick = () => {
  accessGroupsPickedIds.clear();
  renderAccessGroupsGrid(accessGroupSearch?.value || "");
};
if (accessGroupsCloseBtn) accessGroupsCloseBtn.onclick = () => showAccessGroupsModal(false);
if (accessGroupsCancelBtn) accessGroupsCancelBtn.onclick = () => showAccessGroupsModal(false);
if (accessGroupsOverlay) accessGroupsOverlay.addEventListener("click", e => { if (e.target === accessGroupsOverlay) showAccessGroupsModal(false); });

if (accessGroupsSaveBtn) accessGroupsSaveBtn.onclick = async () => {
  if (!accessGroupsAgencyId) return;
  try {
    const res = await fetch(`/api/agencies/${encodeURIComponent(accessGroupsAgencyId)}/access-groups`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ allowedAdminGroupIds: Array.from(accessGroupsPickedIds) })
    });
    const out = await res.json();
    if (!res.ok) throw new Error(out.error || "Save failed");
    setMsg("Access groups updated.", true);
    showAccessGroupsModal(false);
    loadAgenciesWithCounts();
  } catch (e) {
    setMsg(e.message || "Save failed", false);
  }
};

const exportAgenciesCsvBtn = document.getElementById("exportAgenciesCsvBtn");
if (exportAgenciesCsvBtn) {
  exportAgenciesCsvBtn.addEventListener("click", async () => {
    const prevLabel = exportAgenciesCsvBtn.textContent;
    exportAgenciesCsvBtn.disabled = true;
    exportAgenciesCsvBtn.textContent = "Exporting…";
    try {
      const res = await fetch("/api/agencies/export-csv");
      if (!res.ok) {
        let errText = "Export failed";
        try {
          const body = await res.json();
          errText = body?.error || errText;
        } catch (_) {
          // ignore
        }
        setMsg(errText, false);
        return;
      }
      const blob = await res.blob();
      const cd = res.headers.get("Content-Disposition") || "";
      const match = /filename="([^"]+)"/i.exec(cd);
      const filename = match ? match[1] : "tak-portal-agencies.csv";
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      setMsg(`Exported ${filename}.`, true);
    } catch (err) {
      setMsg(err?.message || "Export failed", false);
    } finally {
      exportAgenciesCsvBtn.disabled = false;
      exportAgenciesCsvBtn.textContent = prevLabel;
    }
  });
}

// click-to-sort + keyboard support (Enter/Space)
agencyTable.querySelectorAll("thead th[data-sort]").forEach(th => {
  th.addEventListener("click", () => {
    const key = th.dataset.sort;
    if (sortState.key === key){
      sortState.dir *= -1; // toggle direction
    } else {
      sortState.key = key;
      sortState.dir = 1;
    }
    renderAgencies();
  });

  th.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " "){
      e.preventDefault();
      th.click();
    }
  });
});

// Initialize last county + data on page load
setAgencyAttributesEditControlsVisible(false);
loadLastCounty();
loadAgenciesWithCounts();

// Wire up auto-fill for county abbreviation based on existing agencies
function syncUsernameIdentifierFormLabels() {
  if (!addForm) return;
  const select = addForm.elements.usernameTokenPlacement;
  const labelEl = document.getElementById("usernameIdentifierLabelText");
  if (!select || !labelEl) return;
  const isPrefix = String(select.value || "suffix").toLowerCase() === "prefix";
  labelEl.textContent = isPrefix ? "Username Prefix" : "Username Suffix";
}

if (addForm) {
  const stateInput = addForm.elements.state;
  const countyInput = addForm.elements.county;
  const placementSelect = addForm.elements.usernameTokenPlacement;
  if (placementSelect) {
    placementSelect.addEventListener("change", syncUsernameIdentifierFormLabels);
    syncUsernameIdentifierFormLabels();
  }
  if (stateInput) {
    stateInput.addEventListener("change", syncCountyAbbrevFromExisting);
  }
  if (countyInput) {
    countyInput.addEventListener("blur", syncCountyAbbrevFromExisting);
  }
}
</script>

