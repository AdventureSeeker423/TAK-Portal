<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>Agencies</h1>

  <div class="card">
    <h2>Create Agency</h2>
    <form id="addForm" class="grid2">
      <%- include("partials/agency-create-fields", {
        agencyTypeOptions: typeof agencyTypeOptions !== "undefined" ? agencyTypeOptions : [],
        includeColor: true,
        includeName: true,
        fieldsRequired: true,
        idPrefix: "",
        agencyFieldValues: {}
      }) %>

      <div class="createActionsRow agencyCreateActionsRow">
        <button class="btn btn-access createTemplateDownloadBtn" type="button" id="agencyCsvTemplateBtn">Download CSV Template</button>
        <button class="btn" type="button" id="agencyCsvBtn">Create from CSV</button>
        <button class="btn success createAgencySubmitBtnAlignRight" type="submit">Create Agency</button>
        <input type="file" id="agencyCsvFileInput" accept=".csv" style="display:none" />
        <span id="msg" class="msg"></span>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="row" style="justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <h2 style="margin:0;">Existing Agencies</h2>
      <div class="agencyAttributesEditActions" id="agencyAttributesEditActions">
        <button
          type="button"
          class="btn agency-view-mode-only"
          id="agencyAttributesEditBtn"
          aria-pressed="false"
          aria-controls="agencyTable"
        >
          Edit Agency Attributes
        </button>
        <button
          type="button"
          class="btn agency-edit-mode-only"
          id="agencyAttributesCancelBtn"
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn success agency-edit-mode-only"
          id="agencyAttributesDoneBtn"
        >
          Save Changes
        </button>
      </div>
    </div>

    <div class="listCardTableWrap">
      <table class="table listCardTable agenciesTable" id="agencyTable">
        <thead>
          <tr>
            <th data-sort="name" role="button" tabindex="0" title="Sort by Agency">Agency</th>
            <th data-sort="groupPrefix" role="button" tabindex="0" title="Sort by Abbreviation">Abbreviation</th>
            <th data-sort="suffix" role="button" tabindex="0" title="Sort by username identifier">Username Identifier</th>
            <th data-sort="stateFederalAgency" role="button" tabindex="0" title="Sort by State/Federal Agency">State/Federal</th>
            <th data-sort="county" role="button" tabindex="0" title="Sort by County">County</th>
            <th data-sort="countyAbbrev" role="button" tabindex="0" title="Sort by County Abbreviation">County Abbrev</th>
            <th data-sort="state" role="button" tabindex="0">State</th>
            <th data-sort="type" role="button" tabindex="0" title="Sort by Type">Type</th>
            <th data-sort="color" role="button" tabindex="0" title="Sort by Color">Color</th>
            <th class="agencyActionsHeader" data-label="Actions">Actions</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card agenciesExportCard">
    <div class="agenciesExportCardActions">
      <button type="button" class="btn" id="exportAgenciesCsvBtn">Export Agencies CSV</button>
    </div>
  </div>
</main>

<!-- Agency Admins Modal (same behavior as Groups -> View Members) -->
<div class="modalOverlay" id="adminsOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="adminsTitle">
    <div class="modalHeader">
      <h2 id="adminsTitle" style="margin:0;">Agency Admins</h2>
      <button class="btn" id="adminsCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <div id="adminsSummary" class="msg"></div>

      <div style="margin-top:14px;">
        <input
          id="adminsFilter"
          placeholder="Filter by username, name, or email..."
          style="width: 100%; box-sizing: border-box;"
        />
      </div>

      <div
        id="adminsList"
        class="groupsBox"
        style="margin-top:10px; max-height: 320px; overflow:auto;"
      ></div>
      <small id="adminsHint" class="muted"></small>
    </div>
  </div>
</div>

<!-- Access Groups Modal (which extra groups this agency's admins can see) -->
<div class="modalOverlay" id="accessGroupsOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="accessGroupsTitle">
    <div class="modalHeader">
      <h2 id="accessGroupsTitle" style="margin:0;">Agency Access Groups</h2>
      <button class="btn" id="accessGroupsCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <p id="accessGroupsSummary" class="msg"></p>
        <input id="accessGroupSearch" placeholder="Search groups..." style="width:100%; box-sizing:border-box; margin-top:6px;" />
      <div class="row" style="gap:10px; margin-top:8px;">
        <button class="btn" type="button" id="accessGroupsSelectAllBtn">Select All</button>
        <button class="btn" type="button" id="accessGroupsClearBtn">Clear</button>
      </div>
      <div id="accessGroupsBox" class="groupsBox" style="margin-top:10px; max-height:320px; overflow:auto;">
        <div id="accessGroupsInner" class="groupsInner"></div>
      </div>
      <div style="margin-top:14px; text-align:right;">
        <button class="btn" type="button" id="accessGroupsCancelBtn">Cancel</button>
        <button class="btn success" type="button" id="accessGroupsSaveBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Configure domain + account lookup (same agency JSON field: lookupDomain, comma-separated) -->
  <div class="modalOverlay" id="lookupModal" style="display:none;">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="domainModalTitle">
      <div class="modalHeader">
        <h2 id="domainModalTitle" style="margin:0;">Configure Agency Domain(s)</h2>
        <button class="btn" type="button" onclick="showLookupModal(false)">Close</button>
      </div>
      <div class="modalBody">
        <p>Configure approved email domains for this agency (comma-separated, no @ symbol).
        <br><br>If you list one or more domains, the public <strong>Request Access</strong> form will only accept email addresses ending in those domains. Leave the field empty to allow any email domain for requests.
        <br><br><strong>Account Lookup</strong> (when enabled) lets users request an enrollment QR code by email and username, for shared or apparatus accounts. Lookup still requires a matching approved domain and only works while lookup is enabled.

        <div style="margin-top:14px;">
          <label>Agency email domains</label>
          <input type="text" id="lookupDomain" placeholder="agency.gov, county.org"
                style="width:100%; box-sizing:border-box;" />
          <small class="muted" style="display:block; margin-top:4px;">Separate multiple domains with commas.</small>
          <small id="domainError" class="msg bad" style="display:none;">
            Enter valid domains (e.g., agency.gov) with no @ symbol. Use commas between multiple domains.
          </small>
        </div>

        <div style="margin-top:16px; display:flex; flex-wrap:wrap; gap:10px; justify-content:flex-end;">
          <button class="btn" type="button" onclick="showLookupModal(false)">
            Cancel
          </button>
          <button class="btn" type="button" id="saveLookupDomainsBtn">
            Save domains
          </button>
          <button class="btn danger" type="button" id="disableLookupInModalBtn" style="display:none;">
            Disable Account Lookup
          </button>
          <button class="btn success" type="button" id="confirmEnableLookup" style="display:none;">
            Enable Account Lookup
          </button>
        </div>
      </div>
    </div>
  </div>

<!-- County Abbreviation Update Modal -->
<div class="modalOverlay" id="countyAbbrevOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="countyAbbrevTitle">
    <div class="modalHeader">
      <h2 id="countyAbbrevTitle" style="margin:0;">Update County Abbreviation</h2>
      <button class="btn" type="button" id="countyAbbrevCloseBtn">Close</button>
    </div>
    <div class="modalBody">
      <p id="countyAbbrevSummary" class="msg"></p>
      <label style="display:block; margin-top:8px;">
        County Abbreviation
        <input
          id="countyAbbrevInput"
          placeholder="(ex. HM or HML)"
          required
          minlength="2"
          style="width:100%; box-sizing:border-box; margin-top:4px;"
          oninput="this.value = this.value.toUpperCase().replace(/[^A-Z]/g, '')"
        />
      </label>
      <small class="muted">
        Must be at least 2 letters.
      </small>
      <div style="margin-top:14px; text-align:right;">
        <button class="btn" type="button" id="countyAbbrevCancelBtn">Cancel</button>
        <button class="btn success" type="button" id="countyAbbrevSaveBtn">Save</button>
      </div>
    </div>
  </div>
</div>
  </div>

<script>
/** Same list as Add Agency state dropdown and PUT /api/agencies/:index/state */
const AGENCY_STATE_OPTIONS = [
  "AL", "AK", "AZ", "AR", "CA", "CO", "CT", "DE", "FL", "GA", "HI", "ID",
  "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI", "MN", "MS",
  "MO", "MT", "NE", "NV", "NH", "NJ", "NM", "NY", "NC", "ND", "OH", "OK",
  "OR", "PA", "RI", "SC", "SD", "TN", "TX", "UT", "VT", "VA", "WA", "WV",
  "WI", "WY", "FED", "OTHER",
];
/** Same list as Add Agency type dropdown (core + settings extras + Other); PATCH /api/agencies/:index/type */
const AGENCY_TYPE_OPTIONS = <%- JSON.stringify(Array.isArray(agencyTypeOptions) ? agencyTypeOptions : []) %>;
const msg = document.getElementById("msg");
const tbody = document.getElementById("tbody");
const addForm = document.getElementById("addForm");
const agencyCsvBtn = document.getElementById("agencyCsvBtn");
const agencyCsvFileInput = document.getElementById("agencyCsvFileInput");
const agencyCsvTemplateBtn = document.getElementById("agencyCsvTemplateBtn");
const refreshBtn = document.getElementById("refreshBtn");
const agencyAttributesEditBtn = document.getElementById("agencyAttributesEditBtn");
const agencyAttributesDoneBtn = document.getElementById("agencyAttributesDoneBtn");
const agencyAttributesCancelBtn = document.getElementById("agencyAttributesCancelBtn");
const agencyTable = document.getElementById("agencyTable");

// Admins modal (mirrors Groups page View Members)
const adminsOverlay = document.getElementById("adminsOverlay");
const adminsCloseBtn = document.getElementById("adminsCloseBtn");
const adminsSummary = document.getElementById("adminsSummary");
const adminsFilter = document.getElementById("adminsFilter");
const adminsList = document.getElementById("adminsList");
const adminsHint = document.getElementById("adminsHint");

let agencies = [];
/** When true, Name, Type, Color, Abbreviation, State, County, and County Abbrev columns are editable. */
let agencyAttributesEditMode = false;
/** Snapshots per agency id when entering edit mode (Save Changes applies diffs). */
let nameSnapshotById = {};
let abbrevSnapshotById = {};
let stateSnapshotById = {};
let countySnapshotById = {};
let countyAbbrevSnapshotById = {};
let stateFederalSnapshotById = {};
let sortState = { key: "name", dir: 1 }; // default: Agency asc

function setMsg(text, ok=true){
  msg.textContent = text || "";
  if (ok === "progress") {
    msg.className = "msg progress";
  } else {
    msg.className = "msg " + (ok ? "ok" : "bad");
  }
}

function setAgencyAttributesEditControlsVisible(editing) {
  const wrap = document.getElementById("agencyAttributesEditActions");
  if (wrap) wrap.classList.toggle("is-editing", !!editing);
  if (agencyTable) agencyTable.classList.toggle("is-editing-attributes", !!editing);
}

if (agencyCsvTemplateBtn) {
  agencyCsvTemplateBtn.addEventListener("click", () => {
    const a = document.createElement("a");
    a.href = "/sample-agencies.csv";
    a.download = "agencies-import-template.csv";
    document.body.appendChild(a);
    a.click();
    a.remove();
  });
}

if (agencyCsvBtn && agencyCsvFileInput) {
  agencyCsvBtn.addEventListener("click", () => {
    setMsg("");
    agencyCsvFileInput.value = "";
    agencyCsvFileInput.click();
  });

  agencyCsvFileInput.addEventListener("change", async () => {
    const file = agencyCsvFileInput.files && agencyCsvFileInput.files[0];
    if (!file) return;
    if (!file.name.toLowerCase().endsWith(".csv")) {
      setMsg("Please select a .csv file", false);
      agencyCsvFileInput.value = "";
      return;
    }

    agencyCsvBtn.disabled = true;
    setMsg("Importing agencies from CSV...", true);

    try {
      const fd = new FormData();
      fd.append("file", file);

      const res = await fetch("/api/agencies/import-csv", {
        method: "POST",
        body: fd,
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok) {
        setMsg(out.error || "CSV import failed", false);
        return;
      }

      const created = Array.isArray(out.created) ? out.created : [];
      const skipped = Array.isArray(out.skipped) ? out.skipped : [];
      const failed = Array.isArray(out.failed) ? out.failed : [];

      let summary = `Imported ${created.length} agenc${created.length === 1 ? "y" : "ies"} from CSV.`;
      if (skipped.length) {
        summary += ` Skipped ${skipped.length} row${skipped.length === 1 ? "" : "s"}.`;
      }
      if (failed.length) {
        summary += ` ${failed.length} row${failed.length === 1 ? "" : "s"} had errors and were not imported.`;
      }

      if (skipped.length) {
        summary += " Skipped: " + skipped.map((s) => `line ${s.line} (${s.suffix || "n/a"}: ${s.reason || "skipped"})`).join(" | ");
      }
      if (failed.length) {
        const first = failed.slice(0, 20);
        summary += " Errors: " + first
          .map((f) => `line ${f.line} (${f.suffix || "n/a"}): ${(Array.isArray(f.messages) ? f.messages.join("; ") : String(f.messages || "error"))}`)
          .join(" | ");
        if (failed.length > first.length) {
          summary += ` | …and ${failed.length - first.length} more (see browser console).`;
        }
      }

      setMsg(summary, created.length > 0);
      if (skipped.length) console.warn("Agency CSV import skipped rows:", skipped);
      if (failed.length) console.warn("Agency CSV import failed rows:", failed);
      await loadAgenciesWithCounts();
      syncCountyAbbrevFromExisting();
    } catch (err) {
      setMsg(err?.message || "CSV import failed", false);
    } finally {
      agencyCsvBtn.disabled = false;
      agencyCsvFileInput.value = "";
    }
  });
}

function esc(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;");
}

function formatAgencyIdentifierDisplay(a) {
  const sfx = String(a?.suffix || "").trim();
  if (!sfx) return "";
  const isPrefix =
    String(a?.usernameTokenPlacement || "suffix").toLowerCase() === "prefix";
  return `${sfx} (${isPrefix ? "Prefix" : "Suffix"})`;
}

function isAgencyActive(a) {
  return a?.isActive !== false;
}

/** Same list as create-agency form and PATCH /api/agencies/:index/color */
const AGENCY_COLOR_OPTIONS = [
  "Blue", "Dark Blue", "Brown", "Cyan", "Green", "Dark Green", "Magenta", "Maroon",
  "Orange", "Purple", "Red", "Teal", "White", "Yellow",
];

function isAgencyStateFederal(a) {
  const raw = a?.stateFederalAgency;
  if (raw === true || raw === 1) return true;
  if (raw === false || raw === 0 || raw == null) return false;
  const s = String(raw).trim().toLowerCase();
  return s === "yes" || s === "true" || s === "1" || s === "y";
}

function stateFederalDisplayLabel(a) {
  return isAgencyStateFederal(a) ? "Yes" : "No";
}

function buildAgencyCountyAbbrevViewHtml(a) {
  const abbrev = String(a?.countyAbbrev || "")
    .trim()
    .toUpperCase();
  if (abbrev) return esc(abbrev);
  // State/Federal agencies do not need a county abbreviation — never show Update.
  if (isAgencyStateFederal(a)) return "—";
  const agencyId = esc(a._id ?? a.id ?? "");
  return (
    `<button class="btn" type="button" onclick="openCountyAbbrevModal('${agencyId}')">Update</button>`
  );
}

function buildAgencyStateFederalCellHtml(a) {
  const idx = a._id ?? a.id;
  const yes = isAgencyStateFederal(a);
  const aria = esc(a.name || a.groupPrefix || "agency");
  return `<select class="agency-state-federal-select" aria-label="State/Federal Agency for ${aria}" title="When Yes, County and County Abbreviation are optional" onchange="updateAgencyStateFederalLocal(${Number(idx)}, this.value)"><option value="no" ${yes ? "" : "selected"}>No</option><option value="yes" ${yes ? "selected" : ""}>Yes</option></select>`;
}

function updateAgencyStateFederalLocal(agencyIndex, raw) {
  const row = agencies.find((x) => Number(x._id ?? x.id) === Number(agencyIndex));
  if (!row) return;
  const yes = String(raw || "").trim().toLowerCase() === "yes";
  row.stateFederalAgency = yes;
  renderAgencies();
}

function buildAgencyNameCellHtml(a) {
  const idx = a._id ?? a.id;
  const val = String(a.name || "").trim();
  return `<input type="text" class="agency-name-input" aria-label="Agency full name" value="${esc(val)}" maxlength="200" oninput="updateAgencyNameLocal(${Number(idx)}, this.value)" />`;
}

function updateAgencyNameLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (row) row.name = String(raw || "").trim();
}

function buildAgencyAbbrCellHtml(a) {
  const idx = a._id ?? a.id;
  const val = String(a.groupPrefix || "").trim().toUpperCase();
  const aria = esc(a.name || "Agency");
  return `<input type="text" class="agency-abbr-input" aria-label="Abbreviation for ${aria}" value="${esc(val)}" pattern="[A-Z0-9_-]+" title="Letters, numbers, dashes, and underscores" oninput="this.value = this.value.toUpperCase(); updateAgencyAbbrLocal(${Number(idx)}, this.value)" />`;
}

function updateAgencyAbbrLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (row) row.groupPrefix = String(raw || "").trim().toUpperCase();
}

function countyMatchKey(state, county) {
  return `${String(state || "").trim().toUpperCase()}|${String(county || "").trim().toLowerCase()}`;
}

function countyEditGroupKeyForAgency(a) {
  const id = String(a._id ?? a.id ?? "");
  const snapCounty = id in countySnapshotById ? countySnapshotById[id] : a.county;
  const snapState = id in stateSnapshotById ? stateSnapshotById[id] : a.state;
  return countyMatchKey(snapState, snapCounty);
}

function stateScopeMatchKey(state, county, countyAbbrev) {
  return `${countyMatchKey(state, county)}|${String(countyAbbrev || "").trim().toUpperCase()}`;
}

function stateEditGroupKeyForAgency(a) {
  const id = String(a._id ?? a.id ?? "");
  const snapState = id in stateSnapshotById ? stateSnapshotById[id] : a.state;
  const snapCounty = id in countySnapshotById ? countySnapshotById[id] : a.county;
  const snapCountyAbbrev =
    id in countyAbbrevSnapshotById ? countyAbbrevSnapshotById[id] : a.countyAbbrev;
  return stateScopeMatchKey(snapState, snapCounty, snapCountyAbbrev);
}

function buildAgencyStateCellHtml(a) {
  const idx = a._id ?? a.id;
  const current = String(a.state || "").trim().toUpperCase();
  const editKey = stateEditGroupKeyForAgency(a);
  const aria = esc(a.name || "Agency");
  const opts = AGENCY_STATE_OPTIONS.map((st) => {
    const sel = st === current ? " selected" : "";
    return `<option value="${esc(st)}"${sel}>${esc(st)}</option>`;
  }).join("");
  const legacyExtra =
    current && !AGENCY_STATE_OPTIONS.includes(current)
      ? `<option value="${esc(current)}" selected>${esc(current)} (current)</option>`
      : "";
  return `<select class="agency-state-select" data-edit-key="${esc(editKey)}" aria-label="State for ${aria}" title="Updates agencies matching this state, county, and county abbreviation; renames state groups only if no agencies remain on the old state" onchange="updateAgencyStateLocal(${Number(idx)}, this.value)">${legacyExtra}${opts}</select>`;
}

function syncStateInputsForEditKey(editKey, value) {
  if (!tbody || !agencyAttributesEditMode) return;
  tbody.querySelectorAll(".agency-state-select").forEach((sel) => {
    if (sel.dataset.editKey === editKey && sel !== document.activeElement) {
      sel.value = value;
    }
  });
}

function updateAgencyStateLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = String(raw || "").trim().toUpperCase();
  const editKey = stateEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (stateEditGroupKeyForAgency(a) === editKey) {
      a.state = value;
    }
  }

  syncStateInputsForEditKey(editKey, value);
}

function buildAgencyCountyCellHtml(a) {
  const idx = a._id ?? a.id;
  const val = String(a.county || "").trim();
  const editKey = countyEditGroupKeyForAgency(a);
  const aria = esc(a.name || "Agency");
  return `<input type="text" class="agency-county-input" data-edit-key="${esc(editKey)}" aria-label="County for ${aria}" value="${esc(val)}" maxlength="100" title="Updates all agencies in this state and county; renames county groups" oninput="updateAgencyCountyNameLocal(${Number(idx)}, this.value)" />`;
}

function syncCountyNameInputsForEditKey(editKey, value) {
  if (!tbody || !agencyAttributesEditMode) return;
  tbody.querySelectorAll(".agency-county-input").forEach((inp) => {
    if (inp.dataset.editKey === editKey && inp !== document.activeElement) {
      inp.value = value;
    }
  });
}

function updateAgencyCountyNameLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = normalizeCountyName(raw);
  if (isAgencyStateFederal(row)) {
    row.county = value;
    return;
  }
  const editKey = countyEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (countyEditGroupKeyForAgency(a) === editKey) {
      a.county = value;
    }
  }

  syncCountyNameInputsForEditKey(editKey, value);

  const newCountyKey = String(value || "").trim().toLowerCase();
  tbody.querySelectorAll(".agency-county-abbrev-input").forEach((inp) => {
    if (inp.dataset.editKey === editKey) {
      inp.dataset.county = newCountyKey;
    }
  });
}

function buildAgencyCountyAbbrevCellHtml(a) {
  const idx = a._id ?? a.id;
  const val = String(a.countyAbbrev || "").trim().toUpperCase();
  const editKey = countyEditGroupKeyForAgency(a);
  const county = String(a.county || "").trim().toLowerCase();
  const aria = esc(`${a.county || "County"}, ${a.state || ""}`);
  const requiredHint = isAgencyStateFederal(a)
    ? "Optional for State/Federal agencies"
    : "At least 2 letters; updates all agencies in this county";
  return `<input type="text" class="agency-county-abbrev-input" data-edit-key="${esc(editKey)}" data-county="${esc(county)}" aria-label="County abbreviation for ${aria}" value="${esc(val)}" maxlength="8" placeholder="(ex. HM)" title="${esc(requiredHint)}" oninput="this.value = this.value.toUpperCase().replace(/[^A-Z]/g, ''); updateAgencyCountyAbbrevLocal(${Number(idx)}, this.value)" />`;
}

function syncCountyAbbrevInputsForCounty(editKey, value) {
  if (!tbody || !agencyAttributesEditMode) return;
  tbody.querySelectorAll(".agency-county-abbrev-input").forEach((inp) => {
    if (inp.dataset.editKey === editKey && inp !== document.activeElement) {
      inp.value = value;
    }
  });
}

function updateAgencyCountyAbbrevLocal(agencyIndex, raw) {
  const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
  if (!row) return;
  const value = String(raw || "").trim().toUpperCase().replace(/[^A-Z]/g, "");
  if (isAgencyStateFederal(row) || !value) {
    row.countyAbbrev = value;
    return;
  }
  const editKey = countyEditGroupKeyForAgency(row);

  for (const a of agencies) {
    if (countyEditGroupKeyForAgency(a) === editKey) {
      a.countyAbbrev = value;
    }
  }

  syncCountyAbbrevInputsForCounty(editKey, value);
}

function buildAgencyColorCellHtml(a) {
  const idx = a._id ?? a.id;
  const current = String(a.color || "").trim();
  let opts = "";
  if (!current) {
    opts += `<option value="" disabled selected>Choose color…</option>`;
  }
  opts += AGENCY_COLOR_OPTIONS.map((c) => {
    const sel = c === current ? " selected" : "";
    return `<option value="${esc(c)}"${sel}>${esc(c)}</option>`;
  }).join("");
  const legacyExtra =
    current && !AGENCY_COLOR_OPTIONS.includes(current)
      ? `<option value="${esc(current)}" selected>${esc(current)} (current)</option>`
      : "";
  const aria = esc(a.name || "Agency");
  return `<select aria-label="Color for ${aria}" onchange="updateAgencyColor(${Number(idx)}, this.value)">${legacyExtra}${opts}</select>`;
}

async function updateAgencyColor(agencyIndex, newColor) {
  if (!String(newColor || "").trim()) return;
  try {
    const res = await fetch(`/api/agencies/${encodeURIComponent(agencyIndex)}/color`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ color: newColor }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "Failed to update color");
    setMsg("Color saved.", true);
    const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
    if (row) row.color = newColor;
    renderAgencies();
  } catch (e) {
    setMsg(e.message || String(e), false);
    await loadAgenciesWithCounts();
  }
}

function buildAgencyTypeCellHtml(a) {
  const idx = a._id ?? a.id;
  const current = String(a.type || "").trim();
  let opts = "";
  if (!current) {
    opts += `<option value="" disabled selected>Choose type…</option>`;
  }
  opts += AGENCY_TYPE_OPTIONS.map((t) => {
    const sel = t === current ? " selected" : "";
    return `<option value="${esc(t)}"${sel}>${esc(t)}</option>`;
  }).join("");
  const legacyExtra =
    current && !AGENCY_TYPE_OPTIONS.includes(current)
      ? `<option value="${esc(current)}" selected>${esc(current)} (current)</option>`
      : "";
  const aria = esc(a.name || "Agency");
  return `<select class="agency-type-select" aria-label="Type for ${aria}" onchange="updateAgencyType(${Number(idx)}, this.value)">${legacyExtra}${opts}</select>`;
}

async function updateAgencyType(agencyIndex, newType) {
  if (!String(newType || "").trim()) return;
  try {
    const res = await fetch(`/api/agencies/${encodeURIComponent(agencyIndex)}/type`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ type: newType }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "Failed to update agency type");
    setMsg("Type saved.", true);
    const row = agencies.find((x) => String(x._id ?? x.id) === String(agencyIndex));
    if (row) row.type = newType;
    renderAgencies();
  } catch (e) {
    setMsg(e.message || String(e), false);
    await loadAgenciesWithCounts();
  }
}

function normalizeVal(v){
  if (v === null || v === undefined) return "";
  return String(v).toLowerCase().trim();
}

function adminGroupNameForAgency(a){
  const abbr = String(a?.groupPrefix || "").trim().toUpperCase();
  const countyAbbrev = String(a?.countyAbbrev || "").trim().toUpperCase();
  if (!abbr) return "";
  if (countyAbbrev) {
    return `authentik-${countyAbbrev}-${abbr}-AgencyAdmin`;
  }
  // Legacy pattern (no county abbreviation stored yet)
  return `authentik-${abbr}-AgencyAdmin`;
}

