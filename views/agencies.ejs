function renderAgencies(){
  // apply sort (copy to avoid mutating original order if you later want it)
  const rows = [...agencies];

  if (sortState.key){
    const key = sortState.key;
    const dir = sortState.dir;
    const th = agencyTable.querySelector(`thead th[data-sort="${CSS.escape(key)}"]`);
    const type = th?.dataset.type || "text";

    rows.sort((a,b) => {
      if (type === "number"){
        const av = Number(a[key] ?? 0);
        const bv = Number(b[key] ?? 0);
        return (av - bv) * dir;
      } else if (key === "stateFederalAgency") {
        const av = isAgencyStateFederal(a) ? "yes" : "no";
        const bv = isAgencyStateFederal(b) ? "yes" : "no";
        return av.localeCompare(bv) * dir;
      } else {
        const av = normalizeVal(a[key]);
        const bv = normalizeVal(b[key]);
        return av.localeCompare(bv) * dir;
      }
    });
  }

  // update header indicators
  agencyTable.querySelectorAll("thead th[data-sort]").forEach(th => {
    th.classList.remove("sorted-asc","sorted-desc");
    if (th.dataset.sort === sortState.key){
      th.classList.add(sortState.dir === 1 ? "sorted-asc" : "sorted-desc");
    }
  });

  tbody.innerHTML = rows.map((a)=>{
    const agencyId = esc(a._id ?? a.id ?? "");
    const active = isAgencyActive(a);
    const toggleBtnClass = active ? "btn caution" : "btn";
    const toggleLabel = active ? "Disable" : "Enable";
    return `
    <tr class="${active ? "" : "row-disabled"}">
      <td class="agencyNameCell cardTitleCell" data-label="Agency">
        ${
          agencyAttributesEditMode
            ? buildAgencyNameCellHtml(a)
            : `<div class="agencyNameText cardTitleText">${esc(a.name)}</div>${
                !active ? `<span class="agencyStatusBadge cardMetaBadge">Disabled</span>` : ""
              }`
        }
      </td>
      <td class="agencyAbbrCell" data-label="Abbreviation">${
        agencyAttributesEditMode ? buildAgencyAbbrCellHtml(a) : esc(a.groupPrefix)
      }</td>
      <td class="agencySuffixCell" data-label="Username Identifier">${esc(formatAgencyIdentifierDisplay(a))}</td>
      <td class="agencyStateFederalCell" data-label="State/Federal">${
        agencyAttributesEditMode
          ? buildAgencyStateFederalCellHtml(a)
          : esc(stateFederalDisplayLabel(a))
      }</td>
      <td class="agencyCountyCell" data-label="County">${
        agencyAttributesEditMode ? buildAgencyCountyCellHtml(a) : esc(a.county || "")
      }</td>
      <td class="agencyCountyAbbrevCell" data-label="County Abbrev">${
        agencyAttributesEditMode
          ? buildAgencyCountyAbbrevCellHtml(a)
          : buildAgencyCountyAbbrevViewHtml(a)
      }</td>
      <td class="agencyStateCell" data-label="State">${
        agencyAttributesEditMode ? buildAgencyStateCellHtml(a) : esc(a.state || "")
      }</td>
      <td class="agencyTypeCell${agencyAttributesEditMode ? " agency-type-td" : ""}" data-label="Type">${
        agencyAttributesEditMode ? buildAgencyTypeCellHtml(a) : esc(a.type || "")
      }</td>
      <td class="agencyColorCell" data-label="Color">${
        agencyAttributesEditMode ? buildAgencyColorCellHtml(a) : esc(a.color || "")
      }</td>
      ${
        agencyAttributesEditMode
          ? ""
          : `<td class="agencyActionsCell cardActionsCell">
        <div class="agencyActionsRow cardActionsRow">
          <button class="btn" type="button"
            onclick="openAgencyAdmins('${agencyId}')">
            Agency Admins
          </button>
          <% if (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin) { %>
          <button class="btn btn-access" type="button"
            onclick="openAccessGroupsModal('${agencyId}')">
            Manage Groups
          </button>
          <% } %>
          <button class="btn" type="button"
            onclick="openDomainModal('${agencyId}')">
            Domain
          </button>
          <button class="${toggleBtnClass} agency-active-toggle-btn" type="button"
            onclick="toggleAgencyActive('${agencyId}', ${active ? "false" : "true"})">${toggleLabel}</button>
          <button class="btn danger agency-delete-btn" type="button"
            onclick="delAgency('${agencyId}')">
            Delete
          </button>
        </div>
      </td>`
      }
    </tr>
  `;
  }).join("");
}

// Open admins modal for the agency's computed admin group.
window.openAgencyAdmins = async (agencyId) => {
  const a = (agencies || []).find(x => String(x._id ?? x.id) === String(agencyId));
  if(!a){
    setMsg("Could not find agency.", false);
    return;
  }

  const groupName = adminGroupNameForAgency(a);
  if(!groupName){
    setMsg("Agency abbreviation is missing; cannot determine admin group.", false);
    return;
  }

  activeAdminsGroupName = groupName;
  activeAdminsGroupId = "";
  activeAdmins = [];

  adminsSummary.textContent = `Loading admins for "${groupName}"...`;
  adminsSummary.className = "msg";
  adminsList.innerHTML = "";
  adminsHint.textContent = "";
  if (adminsFilter) adminsFilter.value = "";

  showAdminsModal(true);

  try {
    // Resolve group via agencies API (unfiltered; bypasses GROUPS_HIDDEN_PREFIXES)
    const gRes = await fetch(`/api/agencies/${encodeURIComponent(String(a._id ?? a.id ?? ""))}/admin-group`);
    const gOut = await gRes.json();
    if(!gRes.ok) throw new Error(gOut.error || "Failed to resolve admin group");

    const g = gOut?.group;
    if(!g || !g.pk){
      adminsSummary.textContent = `Admin group "${groupName}" was not found in Authentik.`;
      adminsSummary.className = "msg bad";
      adminsHint.textContent = "If this agency was created before the new auto-create behavior, create this group in Authentik or re-save the agency.";
      return;
    }

    activeAdminsGroupId = String(g.pk);

    const res = await fetch(`/api/groups/${encodeURIComponent(activeAdminsGroupId)}/members`);
    const out = await res.json();
    if(!res.ok) throw new Error(out.error || "Failed to load admins");

    activeAdmins = Array.isArray(out.users) ? out.users : [];
    const memberCount = typeof out.memberCount === "number" ? out.memberCount : activeAdmins.length;

    adminsSummary.textContent = `${memberCount} admin${memberCount === 1 ? "" : "s"} in group "${groupName}".`;
    adminsSummary.className = "msg ok";
    adminsHint.textContent = memberCount
      ? "Showing current admins for this agency. Use Remove to strip admin access from individual users."
      : "No users are currently assigned to this agency admin group.";

    renderAdminsList();
  } catch (e) {
    adminsSummary.textContent = "Failed to load admins.";
    adminsSummary.className = "msg bad";
    adminsList.innerHTML = "";
    adminsHint.textContent = "";
    activeAdmins = [];
  }
};

window.removeUserFromAdminsGroup = async (userPk) => {
  if(!activeAdminsGroupId) return;

  if(!confirm(`Remove this user from "${activeAdminsGroupName || activeAdminsGroupId}"?`)) return;

  try {
    const res = await fetch("/api/groups/mass-unassign", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        groupId: activeAdminsGroupId,
        userIds: [String(userPk)]
      })
    });
    const out = await res.json();
    if(!res.ok){
      alert(out.error || "Failed to remove user from admin group.");
      return;
    }

    // Optimistically update local list
    activeAdmins = (activeAdmins || []).filter(u => String(u?.pk || u?.id) !== String(userPk));
    adminsSummary.textContent = `${activeAdmins.length} admin${activeAdmins.length === 1 ? "" : "s"} in group "${activeAdminsGroupName || activeAdminsGroupId}".`;
    adminsSummary.className = "msg ok";
    renderAdminsList();
  } catch (e) {
    alert("Failed to remove user from admin group.");
  }
};

async function loadAgenciesWithCounts(){
  const res = await fetch("/api/agencies/with-counts");
  const data = await res.json();

  if(!res.ok){
    setMsg(data.error || "Failed to load agencies", false);
    return;
  }

  // Expecting each agency to include an id (recommended). We'll still render even if missing.
  agencies = (Array.isArray(data) ? data : []).map(function (a) {
    return Object.assign({}, a, {
      stateFederalAgency: isAgencyStateFederal(a),
      countyAbbrev: String(a?.countyAbbrev || "")
        .trim()
        .toUpperCase(),
    });
  });
  renderAgencies();
}

// Prefer deleting by real id.
// If your API currently deletes by index, update the backend route to delete by id.
window.toggleAgencyActive = async (agencyId, isActive) => {
  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(agencyId));
  if (!a) {
    setMsg("Could not find agency.", false);
    return;
  }

  const label = String(a.name || a.suffix || "Agency");
  const enabling = !!isActive;

  let userCount = 0;
  try {
    const previewRes = await fetch(`/api/agencies/${encodeURIComponent(agencyId)}/active-preview`);
    const preview = await previewRes.json().catch(() => ({}));
    if (!previewRes.ok) {
      setMsg(preview.error || "Could not load user count for this agency.", false);
      return;
    }
    userCount = Number(preview.userCount) || 0;
  } catch (e) {
    setMsg(e?.message || "Could not load user count for this agency.", false);
    return;
  }

  const userCountLine =
    userCount === 0
      ? enabling
        ? "No users are queued to be re-enabled."
        : "No active users will be disabled."
      : userCount === 1
        ? enabling
          ? "1 user will be re-enabled."
          : "1 active user will be disabled."
        : enabling
          ? `${userCount} users will be re-enabled.`
          : `${userCount} active users will be disabled.`;

  const ok = confirm(
    enabling
      ? `Enable agency "${label}"?\n\n${userCountLine}`
      : `Disable agency "${label}"?\n\n${userCountLine}`
  );
  if (!ok) return;

  const toggleButtons = document.querySelectorAll(".agency-active-toggle-btn");
  toggleButtons.forEach((btn) => {
    btn.disabled = true;
  });

  const progressUserPart =
    userCount === 1
      ? "1 user"
      : userCount > 1
        ? `${userCount} users`
        : "";
  setMsg(
    enabling
      ? progressUserPart
        ? `Enabling agency "${label}"… Updating ${progressUserPart}.`
        : `Enabling agency "${label}"…`
      : progressUserPart
        ? `Disabling agency "${label}"… Updating ${progressUserPart}.`
        : `Disabling agency "${label}"…`,
    "progress"
  );

  try {
    const res = await fetch(`/api/agencies/${encodeURIComponent(agencyId)}/active`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ is_active: enabling }),
    });
    const out = await res.json().catch(() => ({}));
    if (!res.ok) {
      setMsg(out.error || "Failed to update agency status.", false);
      return;
    }
    const count = Number(out.usersUpdated || 0);
    const userPart = count
      ? ` ${count} user${count === 1 ? "" : "s"} updated.`
      : "";
    setMsg(
      enabling
        ? `Agency "${label}" enabled.${userPart}`
        : `Agency "${label}" disabled.${userPart}`,
      true
    );
    await loadAgenciesWithCounts();
  } catch (e) {
    setMsg(e?.message || "Failed to update agency status.", false);
  } finally {
    toggleButtons.forEach((btn) => {
      btn.disabled = false;
    });
  }
};

window.delAgency = async (id) => {
  if(!id){
    setMsg("Missing agency id (API should return _id/id).", false);
    return;
  }

  const a = (agencies || []).find((x) => String(x._id ?? x.id) === String(id));
  if (!a) {
    setMsg("Could not find agency.", false);
    return;
  }

  const label = String(a.name || a.suffix || "Agency");
  let preview = null;

  try {
    const previewRes = await fetch(`/api/agencies/${encodeURIComponent(id)}/delete-preview`);
    preview = await previewRes.json().catch(() => ({}));
    if (!previewRes.ok) {
      setMsg(preview.error || "Could not load delete preview for this agency.", false);
      return;
    }
  } catch (e) {
    setMsg(e?.message || "Could not load delete preview for this agency.", false);
    return;
  }

  const countLine = (count, singular, plural) => {
    const n = Number(count) || 0;
    const word = n === 1 ? singular : plural;
    return `- ${n} ${word}`;
  };

  const lines = [
    "WARNING!!! DELETING THIS AGENCY IS IRREVERSIBLE. PLEASE SEE THE FOLLOWING ITEMS TO BE DELETED...",
    "",
    countLine(preview.userCount, "User", "Users"),
    countLine(preview.agencyGroupCount, "Agency Specific Group", "Agency Specific Groups"),
  ];

  if (preview.willDeleteCountyGroups) {
    lines.push(countLine(preview.countyGroupCount, "County Specific Group", "County Specific Groups"));
  } else {
    lines.push("- 0 County Specific Groups (other agencies remain in this county)");
  }

  if (preview.willDeleteStateGroups) {
    lines.push(countLine(preview.stateGroupCount, "State Specific Group", "State Specific Groups"));
  } else {
    lines.push("- 0 State Specific Groups (other agencies remain in this state)");
  }

  lines.push(countLine(preview.templateCount, "Template", "Templates"));
  lines.push(
    countLine(preview.integrationCount, "Agency Integration", "Agency Integrations")
  );

  if ((Number(preview.pendingRequestCount) || 0) > 0) {
    lines.push(countLine(preview.pendingRequestCount, "Pending Access Request", "Pending Access Requests"));
  }

  lines.push("");
  lines.push(`Agency: ${label}`);

  const ok = confirm(lines.join("\n"));
  if (!ok) return;

  const finalOk = confirm(
    `FINAL CONFIRMATION\n\nPermanently delete agency "${label}" and ALL items listed previously?\n\nThis action CANNOT be undone.`
  );
  if (!finalOk) return;

  const deleteButtons = document.querySelectorAll(".agency-delete-btn");
  deleteButtons.forEach((btn) => {
    btn.disabled = true;
  });

  const userPart =
    (Number(preview.userCount) || 0) > 0
      ? ` Removing ${preview.userCount} user${preview.userCount === 1 ? "" : "s"}…`
      : "";
  setMsg(`Deleting agency "${label}"…${userPart}`, "progress");

  try {
    const res = await fetch("/api/agencies/" + encodeURIComponent(id), { method: "DELETE" });
    const out = await res.json().catch(() => ({}));

    if (!res.ok) {
      setMsg(out.error || "Delete failed", false);
      return;
    }

    setMsg(`Agency "${label}" deleted.`, true);
    await loadAgenciesWithCounts();
  } catch (e) {
    setMsg(e?.message || "Delete failed", false);
  } finally {
    deleteButtons.forEach((btn) => {
      btn.disabled = false;
    });
  }
};

// === County normalization helpers ===
function toTitleCaseWords(str) {
  return String(str || "")
    .toLowerCase()
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1))
    .join(" ");
}

// Handler for fixing county names
function normalizeCountyName(raw) {
  let v = String(raw || "").trim().replace(/\s+/g, " ");
  if (!v) return "";

  const lower = v.toLowerCase();
  if (lower.endsWith(" county")) {
    // strip " county" and title-case the base name
    const base = v.slice(0, lower.lastIndexOf(" county"));
    return toTitleCaseWords(base);
  } else {
    // just title-case whatever they typed
    return toTitleCaseWords(v);
  }
}

