<script>
(function(){
  const tbody = document.getElementById('auditTbody');
  const tpl = document.getElementById('detailsTemplate');

  function getUserMap() { return window.AUDIT_USER_MAP || {}; }
  function getGroupMap() { return window.AUDIT_GROUP_MAP || {}; }

  const FRIENDLY_LABELS = {
    username: 'Username',
    userUsername: 'Username',
    name: 'Name',
    displayName: 'Display name',
    email: 'Email',
    is_active: 'Active status',
    groups: 'Groups',
    groupIds: 'Group IDs',
    groupId: 'Group',
    GroupId: 'Group',
    userId: 'User',
    UserId: 'User',
    jobId: 'Job ID',
    created: 'Created count',
    skipped: 'Skipped count',
    durationMs: 'Duration (ms)',
    durationSeconds: 'Duration (s)',
    created_method: 'Creation method',
    tokenIdentifier: 'Token identifier',
    expiresAt: 'Expires at',
    error: 'Error',
    phase: 'Phase',
    total: 'Total',
    processed: 'Processed',
    usernamesCreated: 'Usernames created',
    createdDetails: 'Created (username + template)',
    templatesUsed: 'Templates used',
    summary: 'Summary',
    groupName: 'Group',
    sourceMode: 'Source mode',
    sourceGroupNames: 'Source groups',
    agencyLabels: 'Agencies',
    usernames: 'Users',
    groupsAdded: 'Groups added',
    groupsRemoved: 'Groups removed',
    groupsBefore: 'Groups before',
    groupsAfter: 'Groups after',
    templateNames: 'Templates',
    templates: 'Template changes',
    matched: 'Matched users',
    updated: 'Updated users',
    accessMode: 'Access',
    active: 'Active',
    teamLabel: 'Team',
    roleLabel: 'Role',
    packageName: 'Package',
    clientUid: 'Client UID',
    liveCallsign: 'Live callsign',
  };

  function isUuid(s) {
    if (typeof s !== 'string') return false;
    return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(s.trim());
  }

  function resolveUserName(id) {
    if (id == null || id === '') return null;
    var key = String(id);
    var u = getUserMap()[key];
    if (!u) return null;
    if (u.username && u.name) return u.username + ' - ' + u.name;
    return u.username || u.name || null;
  }

  function resolveGroupName(uuid) {
    if (uuid == null || uuid === '') return null;
    return getGroupMap()[String(uuid)] || null;
  }

  function formatValue(val, key) {
    if (val == null && key !== 'username' && key !== 'name') return { text: '—', empty: true };
    if (typeof val === 'boolean') return { text: val ? 'Yes' : 'No', empty: false };
    if (typeof val === 'number' && (key === 'userId' || key === 'UserId')) {
      var name = resolveUserName(val);
      return { text: name || ('User ID: ' + val), empty: !name };
    }
    if (typeof val === 'number') return { text: String(val), empty: false };
    if (Array.isArray(val)) {
      if (val.length === 0) return { text: '—', empty: true };
      var list = val.map(function (x) {
        if (x && typeof x === 'object' && ('username' in x || 'templateName' in x)) {
          var u = x.username != null ? String(x.username) : '';
          var t = x.templateName != null ? String(x.templateName) : '';
          return t ? u + ' → ' + t : u;
        }
        var id = String(x);
        if (isUuid(id)) {
          var gName = resolveGroupName(id);
          return gName ? gName + ' (' + id + ')' : id;
        }
        return id;
      });
      return { text: list.join(', '), list: list, empty: false };
    }
    if (typeof val === 'string' && (key === 'groupId' || key === 'GroupId') && isUuid(val)) {
      var gn = resolveGroupName(val);
      return { text: gn || val, empty: !gn };
    }
    if (typeof val === 'string' && (key === 'userId' || key === 'UserId') && !isUuid(val)) {
      var un = resolveUserName(val);
      return { text: un || val, empty: !un };
    }
    if (typeof val === 'object') {
      try { return { text: JSON.stringify(val, null, 2), empty: false, pre: true }; } catch (_) { return { text: '—', empty: true }; }
    }
    var s = String(val).trim();
    return { text: s || '—', empty: !s };
  }

  function labelForKey(key) {
    return FRIENDLY_LABELS[key] || key.replace(/_/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); });
  }

  function buildFormattedHtml(details) {
    const keys = Object.keys(details).filter(function(k) { return details[k] !== undefined; });
    if (keys.length === 0) return '<p class="muted">No additional details recorded.</p>';
    keys.sort(function(a, b) {
      if (a === 'summary') return -1;
      if (b === 'summary') return 1;
      return a.localeCompare(b);
    });
    var html = '';
    keys.forEach(function(key) {
      var v = formatValue(details[key], key);
      html += '<div class="detailItem">';
      html += '<span class="detailKey">' + escapeHtml(labelForKey(key)) + '</span>';
      html += '<span class="detailVal' + (v.empty ? ' empty' : '') + '">';
      if (v.list) {
        html += '<ul class="detailList">';
        v.list.forEach(function(item) { html += '<li>' + escapeHtml(item) + '</li>'; });
        html += '</ul>';
      } else if (v.pre) {
        html += '<pre class="detailPre">' + escapeHtml(v.text) + '</pre>';
      } else {
        html += escapeHtml(v.text);
      }
      html += '</span></div>';
    });
    return html;
  }

  function escapeHtml(s) {
    if (typeof s !== 'string') return '';
    var div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  function formatAuditAction(raw) {
    const s = String(raw || "").trim();
    if (!s || s === "—") return "—";
    return s.replace(/_/g, " ");
  }

  function closeModal(){
    const existing = document.querySelector('.modalOverlay');
    if (existing) existing.remove();
  }

  tbody.addEventListener('click', function(e){
    const btn = e.target.closest('.viewDetailsBtn');
    if (!btn) return;

    const tr = btn.closest('tr');
    const raw = tr.getAttribute('data-details');
    const action = formatAuditAction(tr.getAttribute('data-action') || '');
    const targetType = tr.getAttribute('data-target-type') || '—';
    const targetId = tr.getAttribute('data-target-id') || '—';

    let details = {};
    try { details = JSON.parse(raw || '{}'); } catch {}

    var targetDisplay = targetId;
    if (targetType.toLowerCase() === 'user' && targetId && getUserMap()[targetId]) {
      var u = getUserMap()[targetId];
      targetDisplay = (u.username && u.name) ? (u.username + ' - ' + u.name) : (u.username || u.name || targetId);
    } else if (targetType.toLowerCase() === 'group' && targetId && getGroupMap()[targetId]) {
      targetDisplay = getGroupMap()[targetId];
    } else if (targetType.toLowerCase() === 'group') {
      var detailGroupName = String(details?.groupName || details?.name || '').trim();
      if (detailGroupName) targetDisplay = detailGroupName;
    } else if (targetType.toLowerCase() === 'template') {
      var templateName = String(details?.name || details?.beforeName || '').trim();
      if (templateName) {
        var templateSfx = String(details?.agencySuffix || '').trim().toLowerCase();
        targetDisplay = templateSfx ? (templateName + ' (' + templateSfx + ')') : templateName;
      } else if (details?.groupName) {
        targetDisplay = String(details.groupName);
      }
    } else if (targetType.toLowerCase() === 'mutual_aid') {
      targetDisplay = String(details?.title || details?.mutualAidTitle || details?.after?.title || targetId || '—');
    }

    const frag = tpl.content.cloneNode(true);
    const overlay = frag.querySelector('.modalOverlay');
    const summaryEl = frag.querySelector('.auditDetailsSummary');
    const formattedEl = frag.querySelector('.auditDetailsFormatted');
    const pre = frag.querySelector('.detailsPre');
    const closeBtn = frag.querySelector('.closeModalBtn');

    summaryEl.innerHTML =
      '<div class="detailRow"><span class="detailLabel">Action</span><span>' + escapeHtml(action) + '</span></div>' +
      '<div class="detailRow"><span class="detailLabel">Target type</span><span>' + escapeHtml(targetType) + '</span></div>' +
      '<div class="detailRow"><span class="detailLabel">Target</span><span>' + escapeHtml(targetDisplay) + '</span></div>';

    formattedEl.innerHTML = '<div class="detailBlock">' + buildFormattedHtml(details) + '</div>';
    pre.textContent = JSON.stringify(details, null, 2);

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(ev){
      if (ev.target === overlay) closeModal();
    });

    document.body.appendChild(overlay);
  });

})();
</script>
<script>
(function(){
  const form = document.getElementById("auditFilterForm") || document.querySelector('form[action="/audit-log"]');
  if (!form) return;

  const pageInput = document.getElementById("auditPageInput");

  function parseCsv(val) {
    return String(val || "")
      .split(",")
      .map(function(s){ return s.trim(); })
      .filter(Boolean);
  }

  function resetToFirstPage() {
    if (pageInput) pageInput.value = "1";
  }

  function isReadyDateValue(raw) {
    const s = String(raw || "").trim();
    if (!s) return true;
    return /^\d{4}$/.test(s) || /^\d{4}-(0[1-9]|1[0-2])$/.test(s) || /^\d{4}-(0[1-9]|1[0-2])-\d{2}$/.test(s);
  }

  function buildFilterDest(page) {
    const url = new URL(window.location.origin + (form.getAttribute("action") || "/audit-log"));
    const fd = new FormData(form);
    if (page != null) fd.set("page", String(page));
    fd.forEach(function (value, key) {
      const v = String(value == null ? "" : value).trim();
      if (!v) return;
      if (key === "page" && v === "1") return;
      if ((key === "from" || key === "to") && !isReadyDateValue(v)) return;
      url.searchParams.set(key, v);
    });
    return url.pathname + url.search;
  }

  function formatAuditLogTimestamps(root) {
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    (root || document).querySelectorAll(".ts").forEach(function (el) {
      const raw = el.getAttribute("data-ts");
      if (!raw) return;
      try {
        el.textContent = new Date(raw).toLocaleString(undefined, { timeZone: tz });
      } catch (_) {
        el.textContent = raw;
      }
    });
  }
  window.formatAuditLogTimestamps = formatAuditLogTimestamps;

  function applyJsonMap(doc, id, windowKey) {
    const el = doc.getElementById(id);
    if (!el) return;
    try {
      window[windowKey] = JSON.parse(el.textContent || "{}");
    } catch (_) {}
  }

  let refreshGen = 0;
  let refreshAbort = null;

  async function refreshAuditView(page) {
    if (page != null && pageInput) pageInput.value = String(page);
    const dest = buildFilterDest();
    if (refreshAbort) refreshAbort.abort();
    if (dest === window.location.pathname + window.location.search) {
      syncClearBtn();
      return;
    }

    const gen = ++refreshGen;
    refreshAbort = new AbortController();

    try {
      const res = await fetch(dest, {
        credentials: "same-origin",
        redirect: "manual",
        signal: refreshAbort.signal,
        headers: { Accept: "text/html" },
      });
      if (gen !== refreshGen) return;
      if (res.type === "opaqueredirect" || res.status === 401) {
        window.location.assign(dest);
        return;
      }
      if (!res.ok) return;
      const html = await res.text();
      if (gen !== refreshGen) return;

      const doc = new DOMParser().parseFromString(html, "text/html");
      const nextBody = doc.getElementById("auditTbody");
      const curBody = document.getElementById("auditTbody");
      if (nextBody && curBody) curBody.innerHTML = nextBody.innerHTML;

      const nextPager = doc.getElementById("auditPaginationWrap");
      const curPager = document.getElementById("auditPaginationWrap");
      if (nextPager && curPager) curPager.innerHTML = nextPager.innerHTML;

      const nextPageInput = doc.getElementById("auditPageInput");
      if (pageInput && nextPageInput) pageInput.value = nextPageInput.value;

      applyJsonMap(doc, "auditUserMapJson", "AUDIT_USER_MAP");
      applyJsonMap(doc, "auditGroupMapJson", "AUDIT_GROUP_MAP");
      applyJsonMap(doc, "auditAgencyMapJson", "AUDIT_AGENCY_MAP");

      formatAuditLogTimestamps(curBody);
      history.replaceState(null, "", dest);
      syncClearBtn();
    } catch (err) {
      if (err && err.name === "AbortError") return;
    }
  }

  function submitFilters(page) {
    refreshAuditView(page != null ? page : "1");
  }

  function formHasActiveFilters() {
    const keys = ["q", "from", "to"];
    for (let i = 0; i < keys.length; i++) {
      const el = form.querySelector('[name="' + keys[i] + '"]');
      if (el && String(el.value || "").trim()) return true;
    }
    const hiddenIds = ["actorFilterInput", "actionFilterInput", "agencyFilterInput"];
    for (let i = 0; i < hiddenIds.length; i++) {
      const el = document.getElementById(hiddenIds[i]);
      if (el && String(el.value || "").trim()) return true;
    }
    return false;
  }

  const clearBtn = document.getElementById("auditClearFiltersBtn");
  function syncClearBtn() {
    if (!clearBtn) return;
    clearBtn.hidden = !formHasActiveFilters();
  }
  syncClearBtn();

  if (clearBtn) {
    clearBtn.addEventListener("click", function (e) {
      e.preventDefault();
      clearBtn.hidden = true;
      window.location.assign(form.getAttribute("action") || "/audit-log");
    });
  }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    const submitter = e.submitter || document.activeElement;
    const pageAttr = submitter && submitter.getAttribute ? submitter.getAttribute("data-audit-page") : null;
    if (pageAttr) {
      if (submitter.disabled) return;
      refreshAuditView(pageAttr);
      return;
    }
    resetToFirstPage();
    refreshAuditView("1");
  });

  function setupFilter(opts) {
    const container = document.querySelector(opts.containerSelector);
    const input = document.getElementById(opts.inputId);
    if (!container || !input) return;

    const menu = container.querySelector(".filter-menu");
    const toggle = container.querySelector(".filter-toggle");
    const checkboxes = Array.prototype.slice.call(
      container.querySelectorAll('input[type="checkbox"][data-filter-value]')
    );

    const initial = parseCsv(input.value);
    let filterTimer = null;

    function updateToggleLabel(selectedCount) {
      if (!toggle) return;
      const base = toggle.getAttribute("data-filter-label") || "Filter";
      toggle.textContent = selectedCount
        ? (base + " (" + selectedCount + ") ▾")
        : (base + " ▾");
    }

    checkboxes.forEach(function(cb){
      const val = cb.getAttribute("data-filter-value");
      if (val === "__all") {
        cb.checked = initial.length === 0;
      } else {
        cb.checked = initial.includes(val);
      }
    });
    updateToggleLabel(initial.length);

    function syncInput() {
      const selected = checkboxes
        .filter(function(cb){ return cb.checked && cb.getAttribute("data-filter-value") !== "__all"; })
        .map(function(cb){ return cb.getAttribute("data-filter-value"); });

      input.value = selected.join(",");

      const allBox = checkboxes.find(function(cb){ return cb.getAttribute("data-filter-value") === "__all"; });
      if (allBox) {
        allBox.checked = selected.length === 0;
      }
      updateToggleLabel(selected.length);
      syncClearBtn();
    }

    checkboxes.forEach(function(cb){
      cb.addEventListener("change", function(){
        const val = cb.getAttribute("data-filter-value");
        if (val === "__all") {
          if (cb.checked) {
            checkboxes.forEach(function(other){
              if (other !== cb) other.checked = false;
            });
            input.value = "";
          }
        } else {
          const allBox = checkboxes.find(function(x){ return x.getAttribute("data-filter-value") === "__all"; });
          if (allBox && cb.checked) {
            allBox.checked = false;
          }
        }
        syncInput();
        clearTimeout(filterTimer);
        filterTimer = setTimeout(function () {
          submitFilters(1);
        }, 350);
      });
    });

    if (toggle && menu) {
      toggle.addEventListener("click", function(){
        const isOpen = container.classList.contains("open");
        document.querySelectorAll(".filter-multiselect.open").forEach(function(el){
          if (el !== container) el.classList.remove("open");
        });
        if (!isOpen) container.classList.add("open");
        else container.classList.remove("open");
      });
    }
  }

  setupFilter({
    containerSelector: '.filter-multiselect[data-filter="actor"]',
    inputId: "actorFilterInput"
  });
  setupFilter({
    containerSelector: '.filter-multiselect[data-filter="action"]',
    inputId: "actionFilterInput"
  });
  setupFilter({
    containerSelector: '.filter-multiselect[data-filter="agency"]',
    inputId: "agencyFilterInput"
  });

  document.addEventListener("click", function(e){
    const openEls = document.querySelectorAll(".filter-multiselect.open");
    openEls.forEach(function(el){
      if (!el.contains(e.target)) el.classList.remove("open");
    });
  });

  const fromInput = form.querySelector('input[name="from"]');
  const toInput = form.querySelector('input[name="to"]');
  let dateTimer = null;
  function onDateReady() {
    syncClearBtn();
    clearTimeout(dateTimer);
    const fromVal = fromInput ? String(fromInput.value || "").trim() : "";
    const toVal = toInput ? String(toInput.value || "").trim() : "";
    if (!isReadyDateValue(fromVal) || !isReadyDateValue(toVal)) return;
    dateTimer = setTimeout(function () {
      const stillFrom = fromInput ? String(fromInput.value || "").trim() : "";
      const stillTo = toInput ? String(toInput.value || "").trim() : "";
      if (!isReadyDateValue(stillFrom) || !isReadyDateValue(stillTo)) return;
      submitFilters(1);
    }, 350);
  }

  function digitsOnly(el, max) {
    const next = String(el.value || "").replace(/\D/g, "").slice(0, max);
    if (el.value !== next) el.value = next;
    return next;
  }

  function composeSlotDate(month, day, year) {
    const y = String(year || "").replace(/\D/g, "");
    const m = String(month || "").replace(/\D/g, "");
    const d = String(day || "").replace(/\D/g, "");
    if (!y && !m && !d) return "";
    if (y.length !== 4) return null;
    if (!m && !d) return y;
    if (m.length < 2) return null;
    const mi = Number(m);
    if (mi < 1 || mi > 12) return null;
    if (!d) return y + "-" + m;
    if (d.length < 2) return null;
    const di = Number(d);
    if (di < 1 || di > 31) return null;
    return y + "-" + m + "-" + d;
  }

  function setupDateControl(wrap) {
    if (!wrap) return;
    const hidden = wrap.querySelector('input[type="hidden"]');
    const month = wrap.querySelector('[data-part="month"]');
    const day = wrap.querySelector('[data-part="day"]');
    const year = wrap.querySelector('[data-part="year"]');
    const native = wrap.querySelector(".audit-date-native");
    const calBtn = wrap.querySelector(".audit-date-cal");
    if (!hidden || !month || !day || !year) return;
    const parts = [month, day, year];

    function syncHidden() {
      const composed = composeSlotDate(month.value, day.value, year.value);
      if (composed == null) return false;
      hidden.value = composed;
      if (native) native.value = /^\d{4}-\d{2}-\d{2}$/.test(composed) ? composed : "";
      return true;
    }

    function focusPart(el) {
      el.focus();
      try { el.select(); } catch (_) {}
    }

    parts.forEach(function (el, idx) {
      el.addEventListener("focus", function () {
        try { el.select(); } catch (_) {}
      });
      el.addEventListener("keydown", function (e) {
        if (e.key === "/" || e.key === "-" || e.key === "ArrowRight") {
          if (e.key !== "ArrowRight" || el.selectionStart === String(el.value || "").length) {
            e.preventDefault();
            if (parts[idx + 1]) focusPart(parts[idx + 1]);
          }
        } else if (e.key === "ArrowLeft" || e.key === "Backspace") {
          if (!String(el.value || "") || (e.key === "ArrowLeft" && el.selectionStart === 0)) {
            if (parts[idx - 1]) {
              e.preventDefault();
              focusPart(parts[idx - 1]);
            }
          }
        }
      });
      el.addEventListener("input", function () {
        const max = el.getAttribute("data-part") === "year" ? 4 : 2;
        const val = digitsOnly(el, max);
        if (el.getAttribute("data-part") !== "year" && val.length >= 2 && parts[idx + 1]) {
          focusPart(parts[idx + 1]);
        }
        if (syncHidden()) onDateReady();
        else syncClearBtn();
      });
      el.addEventListener("blur", function () {
        if (el.getAttribute("data-part") !== "year" && el.value.length === 1) {
          el.value = "0" + el.value;
        }
        if (syncHidden()) onDateReady();
      });
    });

    if (calBtn && native) {
      calBtn.addEventListener("click", function () {
        if (typeof native.showPicker === "function") {
          try { native.showPicker(); return; } catch (_) {}
        }
        native.click();
      });
      native.addEventListener("change", function () {
        const v = String(native.value || "");
        if (!/^\d{4}-\d{2}-\d{2}$/.test(v)) return;
        year.value = v.slice(0, 4);
        month.value = v.slice(5, 7);
        day.value = v.slice(8, 10);
        hidden.value = v;
        onDateReady();
      });
    }
  }

  document.querySelectorAll(".audit-date-control").forEach(setupDateControl);

  const searchInput = form.querySelector('input[name="q"]');
  if (searchInput) {
    let searchTimer = null;
    searchInput.addEventListener("input", function() {
      syncClearBtn();
      clearTimeout(searchTimer);
      const typed = searchInput.value;
      searchTimer = setTimeout(function () {
        if (searchInput.value !== typed) return;
        submitFilters(1);
      }, 400);
    });
  }
})();
</script>
<script>
(function() {
  if (typeof window.formatAuditLogTimestamps === "function") {
    window.formatAuditLogTimestamps(document);
    return;
  }
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
  document.querySelectorAll(".ts").forEach(el => {
    const raw = el.getAttribute("data-ts");
    if (!raw) return;
    try {
      el.textContent = new Date(raw).toLocaleString(undefined, { timeZone: tz });
    } catch (e) {
      el.textContent = raw;
    }
  });
})();
</script>
<script>
(function() {
  const exportBtn = document.getElementById("exportAuditCsvBtn");
  if (!exportBtn) return;

  function csvEscape(val) {
    const s = String(val == null ? "" : val);
    if (/[",\r\n]/.test(s)) {
      return '"' + s.replace(/"/g, '""') + '"';
    }
    return s;
  }

  function actorLabel(actor) {
    const displayName = String(actor?.displayName || "").trim();
    const username = String(actor?.username || "").trim();
    if (displayName && username) return `${displayName} - ${username}`;
    return displayName || username || "—";
  }

  function formatAuditAction(raw) {
    const s = String(raw || "").trim();
    if (!s) return "—";
    return s.replace(/_/g, " ");
  }

  function targetLabel(item) {
    const type = String(item?.targetType || "").trim().toLowerCase();
    const targetTypeOut = String(item?.targetType || "").trim() || "—";
    const details = item?.details || {};
    const userMap = window.AUDIT_USER_MAP || {};
    const groupMap = window.AUDIT_GROUP_MAP || {};
    const targetId = String(item?.targetId || "").trim();

    let display = String(item?.targetDisplay || "").trim();

    if (!display && (type === "user" || type === "authentik_user")) {
      const username = String(details?.username || details?.userUsername || "").trim();
      const name = String(details?.name || details?.displayName || "").trim();
      if (username && name) display = `${username} - ${name}`;
      else display = username || name;
      if (!display && targetId && userMap[targetId]) {
        const u = userMap[targetId] || {};
        const un = String(u.username || "").trim();
        const dn = String(u.name || "").trim();
        display = (un && dn) ? `${un} - ${dn}` : (un || dn);
      }
    }

    if (!display && (type === "group" || type === "authentik_group")) {
      display = String(details?.name || details?.groupName || "").trim();
      if (!display && targetId && groupMap[targetId]) {
        display = String(groupMap[targetId] || "").trim();
      }
    }

    if (!display) display = targetId || "—";
    return `${targetTypeOut} ${display}`.trim();
  }

  function formatTimestamp(ts) {
    try {
      return new Date(ts).toLocaleString(undefined, {
        timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      });
    } catch (_) {
      return String(ts || "");
    }
  }

  function agencyLabel(item) {
    const agencyMap = window.AUDIT_AGENCY_MAP || {};
    const sfx = String(item?.agencySuffix || "").trim().toLowerCase();
    if (!sfx) return "—";
    const agencyObj = agencyMap[sfx];
    return String(agencyObj?.name || agencyObj?.groupPrefix || sfx);
  }

  async function fetchAllFilteredRows() {
    const form = document.getElementById("auditFilterForm");
    const params = new URLSearchParams();
    const filterKeys = ["q", "actor", "action", "targetType", "agencySuffix", "from", "to"];
    if (form) {
      const fd = new FormData(form);
      filterKeys.forEach(function (key) {
        const v = String(fd.get(key) == null ? "" : fd.get(key)).trim();
        if (!v) return;
        if ((key === "from" || key === "to") && !/^\d{4}(-\d{2}(-\d{2})?)?$/.test(v)) return;
        params.set(key, v);
      });
    }
    const hasFilters = filterKeys.some(function (key) { return params.has(key); });

    const rows = [];
    let page = 1;
    let pageCount = 1;
    const pageSize = 500;

    while (page <= pageCount) {
      params.set("page", String(page));
      params.set("pageSize", String(pageSize));
      if (page === 1) params.set("export", "1");

      const res = await fetch(`/api/audit-log?${params.toString()}`);
      const out = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(out?.error || "Failed to fetch audit logs for export");
      }

      const items = Array.isArray(out?.items) ? out.items : [];
      pageCount = Math.max(1, Number(out?.pageCount || 1));

      items.forEach((item) => {
        rows.push([
          formatTimestamp(item?.timestamp || ""),
          actorLabel(item?.actor),
          formatAuditAction(item?.action),
          targetLabel(item),
          agencyLabel(item),
          JSON.stringify(item?.details || {}),
        ]);
      });

      page += 1;
    }

    return { rows, hasFilters };
  }

  exportBtn.addEventListener("click", async function() {
    const originalLabel = exportBtn.textContent;
    exportBtn.disabled = true;
    exportBtn.textContent = "Exporting...";

    let rows = [];
    let hasFilters = false;
    try {
      const out = await fetchAllFilteredRows();
      rows = out.rows;
      hasFilters = !!out.hasFilters;
    } catch (err) {
      alert(err?.message || "Failed to export audit logs.");
      exportBtn.disabled = false;
      exportBtn.textContent = originalLabel;
      return;
    }

    const header = ["Time", "Actor", "Action", "Target", "Agency", "Details JSON"];
    const lines = [header, ...rows].map((cols) => cols.map(csvEscape).join(","));
    const csv = lines.join("\r\n");

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const ts = new Date().toISOString().replace(/[:.]/g, "-");
    const a = document.createElement("a");
    a.href = url;
    a.download = hasFilters ? `audit-log-view-${ts}.csv` : `audit-log-${ts}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    exportBtn.disabled = false;
    exportBtn.textContent = originalLabel;
  });
})();
</script>