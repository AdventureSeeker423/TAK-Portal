<%- include("partials/header") %>
<%- include("partials/sidebar") %>
<%
  function formatAuditAction(raw) {
    const s = String(raw || "").trim();
    if (!s) return "—";
    return s.replace(/_/g, " ");
  }
  function csvFilterCount(val) {
    return String(val || "")
      .split(",")
      .map(function (s) { return s.trim(); })
      .filter(Boolean).length;
  }
  function filterToggleLabel(base, val) {
    const n = csvFilterCount(val);
    return n ? (base + " (" + n + ") ▾") : (base + " ▾");
  }
  function auditDateParts(val) {
    const s = String(val || "").trim();
    const m = /^(\d{4})(?:-(\d{2})(?:-(\d{2}))?)?$/.exec(s);
    return {
      value: m ? s : (s ? s.slice(0, 10) : ""),
      y: m ? m[1] : "",
      m: m && m[2] ? m[2] : "",
      d: m && m[3] ? m[3] : "",
    };
  }
%>

<main class="main">

  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Audit Log",
    scopedSuffix: "Audit Log",
    singleFallbackTitle: "Agency Audit Log"
  }) %>

  <div class="card">

    <div class="row" style="justify-content: space-between; align-items:center; gap:12px; flex-wrap:wrap;">
      <h2 style="margin:0;">Audit Events</h2>

      <form id="auditFilterForm" method="GET" action="/audit-log" class="row" style="gap:8px; flex-wrap:wrap; align-items:center;">
        <input type="hidden" name="actor" id="actorFilterInput" value="<%= filters?.actor || '' %>" />
        <input type="hidden" name="action" id="actionFilterInput" value="<%= filters?.action || '' %>" />
        <input type="hidden" name="agencySuffix" id="agencyFilterInput" value="<%= filters?.agencySuffix || '' %>" />
        <input type="hidden" name="page" id="auditPageInput" value="<%= result?.page || 1 %>" />
        <input type="hidden" name="pageSize" value="<%= result?.pageSize || filters?.pageSize || 50 %>" />
        <%
          const fromParts = auditDateParts(filters && filters.from);
          const toParts = auditDateParts(filters && filters.to);
        %>
        <span class="audit-date-row">
          <span class="input audit-date-control" data-date-bound="from">
            <input type="hidden" name="from" value="<%= fromParts.value %>" />
            <input type="text" class="audit-date-part" data-part="month" maxlength="2" inputmode="numeric" placeholder="mm" value="<%= fromParts.m %>" aria-label="From month" autocomplete="off" spellcheck="false" />
            <span class="audit-date-sep">/</span>
            <input type="text" class="audit-date-part" data-part="day" maxlength="2" inputmode="numeric" placeholder="dd" value="<%= fromParts.d %>" aria-label="From day" autocomplete="off" spellcheck="false" />
            <span class="audit-date-sep">/</span>
            <input type="text" class="audit-date-part" data-part="year" maxlength="4" inputmode="numeric" placeholder="yyyy" value="<%= fromParts.y %>" aria-label="From year" autocomplete="off" spellcheck="false" />
            <button type="button" class="audit-date-cal" aria-label="Choose from date" tabindex="-1">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="1.5" y="3" width="13" height="11.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M1.5 6.5h13M5 1.5v3M11 1.5v3" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>
            </button>
            <input type="date" class="audit-date-native" tabindex="-1" aria-hidden="true"<%= fromParts.d ? ' value="' + fromParts.value + '"' : "" %> />
          </span>
          <span class="audit-date-to">to</span>
          <span class="input audit-date-control" data-date-bound="to">
            <input type="hidden" name="to" value="<%= toParts.value %>" />
            <input type="text" class="audit-date-part" data-part="month" maxlength="2" inputmode="numeric" placeholder="mm" value="<%= toParts.m %>" aria-label="To month" autocomplete="off" spellcheck="false" />
            <span class="audit-date-sep">/</span>
            <input type="text" class="audit-date-part" data-part="day" maxlength="2" inputmode="numeric" placeholder="dd" value="<%= toParts.d %>" aria-label="To day" autocomplete="off" spellcheck="false" />
            <span class="audit-date-sep">/</span>
            <input type="text" class="audit-date-part" data-part="year" maxlength="4" inputmode="numeric" placeholder="yyyy" value="<%= toParts.y %>" aria-label="To year" autocomplete="off" spellcheck="false" />
            <button type="button" class="audit-date-cal" aria-label="Choose to date" tabindex="-1">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="1.5" y="3" width="13" height="11.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M1.5 6.5h13M5 1.5v3M11 1.5v3" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>
            </button>
            <input type="date" class="audit-date-native" tabindex="-1" aria-hidden="true"<%= toParts.d ? ' value="' + toParts.value + '"' : "" %> />
          </span>
        </span>

        <input
          type="text"
          name="q"
          class="input audit-search-input"
          placeholder="Search any field…"
          value="<%= filters?.q || '' %>"
          aria-label="Search audit log"
          autocomplete="off"
          spellcheck="false"
        />

        <div class="filter-multiselect" data-filter="actor">
          <button type="button" class="btn filter-toggle" id="actorFilterToggle" data-filter-label="Actor"><%= filterToggleLabel("Actor", filters?.actor) %></button>
          <div class="filter-menu">
            <div class="filter-menu-inner">
              <label class="filter-option">
                <input type="checkbox" value="" data-filter-value="__all" checked>
                <span>All actors</span>
              </label>
              <% (Array.isArray(actorOptions) ? actorOptions : []).forEach(function(a) { %>
                <%
                  const actorLabel = (a.displayName && a.username) ? (a.displayName + ' - ' + a.username) : (a.displayName || a.username || '');
                %>
                <label class="filter-option">
                  <input type="checkbox" value="<%= a.username %>" data-filter-value="<%= a.username %>">
                  <span><%= actorLabel %></span>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="filter-multiselect" data-filter="action">
          <button type="button" class="btn filter-toggle" id="actionFilterToggle" data-filter-label="Action"><%= filterToggleLabel("Action", filters?.action) %></button>
          <div class="filter-menu">
            <div class="filter-menu-inner">
              <label class="filter-option">
                <input type="checkbox" value="" data-filter-value="__all" checked>
                <span>All actions</span>
              </label>
              <% (Array.isArray(actionOptions) ? actionOptions : []).forEach(function(a) { %>
                <label class="filter-option">
                  <input type="checkbox" value="<%= a %>" data-filter-value="<%= a %>">
                  <span><%= formatAuditAction(a) %></span>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="filter-multiselect" data-filter="agency">
          <button type="button" class="btn filter-toggle" id="agencyFilterToggle" data-filter-label="Agency"><%= filterToggleLabel("Agency", filters?.agencySuffix) %></button>
          <div class="filter-menu">
            <div class="filter-menu-inner">
              <label class="filter-option">
                <input type="checkbox" value="" data-filter-value="__all" checked>
                <span>All agencies</span>
              </label>
              <% (agencyOptions || []).forEach(function(a) { %>
                <% if (!a.value) { return; } %>
                <label class="filter-option">
                  <input type="checkbox" value="<%= a.value %>" data-filter-value="<%= a.value %>">
                  <span><%= a.label %></span>
                </label>
              <% }); %>
            </div>
          </div>
        </div>

        <%
          const hasActiveFilters = !!(
            String(filters?.q || "").trim() ||
            String(filters?.from || "").trim() ||
            String(filters?.to || "").trim() ||
            csvFilterCount(filters?.actor) ||
            csvFilterCount(filters?.action) ||
            csvFilterCount(filters?.agencySuffix) ||
            String(filters?.targetType || "").trim()
          );
        %>
        <button class="btn btn-grey" type="button" id="auditClearFiltersBtn" <%= hasActiveFilters ? "" : "hidden" %>>Clear Filters</button>
        <button class="btn qr" id="exportAuditCsvBtn" type="button">Export View To CSV</button>
      </form>
    </div>

    <div class="listCardTableWrap" style="overflow-x: auto;">
    <table class="table listCardTable audit-log-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Actor</th>
          <th>Action</th>
          <th>Target</th>
          <th>Agency</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody id="auditTbody">

        <% if (!result || !result.items || !result.items.length) { %>
          <tr class="emptyStateRow">
            <td colspan="6" class="muted">No audit events found.</td>
          </tr>
        <% } %>

        <% (result?.items || []).forEach((log) => { %>
          <tr data-details='<%- JSON.stringify(log.details || {}) %>'
              data-action="<%= log.action || '' %>"
              data-target-type="<%= log.targetType || '' %>"
              data-target-id="<%= log.targetId || '' %>">

            <!-- Time -->
            <td class="auditTimeCell" data-label="Time">
              <span class="ts" data-ts="<%= log.timestamp || '' %>"></span>
            </td>

            <!-- Actor -->
            <td class="auditActorCell" data-label="Actor">
              <strong><%= log.actor?.displayName || log.actor?.username || '—' %></strong><br>
              <span class="muted"><%= log.actor?.username || '' %></span>
            </td>

            <!-- Action -->
            <td class="cardTitleCell">
              <span class="badge cardTitleText"><%= formatAuditAction(log.action) %></span>
            </td>

          <!-- Target (names from details or userMap/groupMap, fallback to ID) -->
          <td class="auditTargetCell" data-label="Target">
            <%
              const type = String(log.targetType || '').toLowerCase();
              const details = log.details || {};
              const targetId = String(log.targetId || '').trim();
              const uMap = typeof userMap !== 'undefined' ? userMap : {};
              const gMap = typeof groupMap !== 'undefined' ? groupMap : {};

              let display = log.targetDisplay || '';

              if (type === 'user' || type === 'authentik_user') {
                const username = details.username || details.userUsername || '';
                const name =
                  details.name ||
                  details.displayName ||
                  [details.firstName, details.lastName].filter(Boolean).join(' ');

                if (username && name) {
                  display = `${username} - ${name}`;
                } else if (username) {
                  display = username;
                } else if (name) {
                  display = name;
                }
                if (!display && targetId && uMap[targetId]) {
                  const u = uMap[targetId];
                  if (u && (u.username || u.name)) {
                    display = u.username && u.name ? `${u.username} - ${u.name}` : (u.username || u.name);
                  }
                }
                if (!display && targetId) display = targetId;
              }

              if (type === 'group' || type === 'authentik_group') {
                const groupName = details.name || details.groupName;
                if (groupName) display = groupName;
                else if (targetId && gMap[targetId]) display = gMap[targetId] || targetId;
                else if (targetId) display = targetId;
              }

              if (type === 'template') {
                const templateName = details.name || details.beforeName;
                if (templateName) {
                  const sfx = String(details.agencySuffix || '').trim().toLowerCase();
                  display = sfx ? `${templateName} (${sfx})` : templateName;
                } else if (targetId && targetId !== 'bulk') {
                  display = targetId;
                } else if (details.groupName) {
                  display = details.groupName;
                }
              }

              if (type === 'mutual_aid') {
                display =
                  details.title ||
                  details.mutualAidTitle ||
                  (details.after && details.after.title) ||
                  targetId ||
                  '—';
              }

              if (type === 'tak_client') {
                const callsign = details.callsign || '';
                const username = details.username || '';
                if (callsign && username) display = `${callsign} (${username})`;
                else display = callsign || username || targetId || '—';
              }

              if (type === 'data_package' || type === 'data_sync_mission' || type === 'data_sync_file') {
                display =
                  details.fileName ||
                  details.missionName ||
                  details.name ||
                  targetId ||
                  '—';
              }

              if (!display && targetId) display = targetId;
              if (!display) display = '—';
            %>
            <strong><%= log.targetType || '—' %></strong><br>
            <span class="muted"><%= display %></span>
          </td>

            <!-- Agency -->
            <td class="auditAgencyCell" data-label="Agency">
              <%
                const sfx = String(log.agencySuffix || '').toLowerCase();
                const agencyObj = agencyMap?.[sfx];
                const agencyLabel = agencyObj ? (agencyObj.name || agencyObj.groupPrefix || sfx) : (sfx || '—');
              %>
              <%= agencyLabel %>
            </td>

            <!-- Details -->
            <td class="cardActionsCell">
              <% if (log.details && Object.keys(log.details).length) { %>
                <div class="cardActionsRow">
                  <button class="btn viewDetailsBtn" type="button">View Details</button>
                </div>
              <% } else { %>
                <span class="muted">—</span>
              <% } %>
            </td>

          </tr>
        <% }) %>

      </tbody>
    </table>
    </div>

    <!-- Pagination: submit the current form (search + filters) with a new page -->
    <div id="auditPaginationWrap">
    <% if (result && result.pageCount > 1) {
      const atFirst = result.page <= 1;
      const atLast = result.page >= result.pageCount;
    %>
      <nav class="audit-pagination" aria-label="Audit log pages">
        <button type="submit" class="btn<%= atFirst ? ' disabled' : '' %>" form="auditFilterForm" data-audit-page="1" <%= atFirst ? 'disabled' : '' %>>First</button>
        <button type="submit" class="btn<%= atFirst ? ' disabled' : '' %>" form="auditFilterForm" data-audit-page="<%= Math.max(1, result.page - 1) %>" <%= atFirst ? 'disabled' : '' %>>Prev</button>
        <span class="audit-page-info" id="auditPageInfo">Page <%= result.page %> of <%= result.pageCount %></span>
        <button type="submit" class="btn<%= atLast ? ' disabled' : '' %>" form="auditFilterForm" data-audit-page="<%= Math.min(result.pageCount, result.page + 1) %>" <%= atLast ? 'disabled' : '' %>>Next</button>
        <button type="submit" class="btn<%= atLast ? ' disabled' : '' %>" form="auditFilterForm" data-audit-page="<%= result.pageCount %>" <%= atLast ? 'disabled' : '' %>>Last</button>
      </nav>
    <% } %>
    </div>

  </div>

  <!-- Inline Modal -->
  <template id="detailsTemplate">
    <div class="modalOverlay">
      <div class="modalCard card">
        <div class="row" style="justify-content: space-between; align-items:center;">
          <h2 style="margin:0;">Audit Details</h2>
          <button class="btn closeModalBtn">Close</button>
        </div>
        <div class="auditDetailsSummary"></div>
        <div class="auditDetailsFormatted"></div>
        <details class="auditDetailsRawWrap">
          <summary class="muted">Raw data</summary>
          <pre class="detailsPre"></pre>
        </details>
      </div>
    </div>
  </template>

</main>

<script type="application/json" id="auditUserMapJson"><%- JSON.stringify(typeof userMap !== 'undefined' ? userMap : {}) %></script>
<script type="application/json" id="auditGroupMapJson"><%- JSON.stringify(typeof groupMap !== 'undefined' ? groupMap : {}) %></script>
<script type="application/json" id="auditAgencyMapJson"><%- JSON.stringify(typeof agencyMap !== 'undefined' ? agencyMap : {}) %></script>
<script>
  window.AUDIT_USER_MAP = <%- JSON.stringify(typeof userMap !== 'undefined' ? userMap : {}) %>;
  window.AUDIT_GROUP_MAP = <%- JSON.stringify(typeof groupMap !== 'undefined' ? groupMap : {}) %>;
  window.AUDIT_AGENCY_MAP = <%- JSON.stringify(typeof agencyMap !== 'undefined' ? agencyMap : {}) %>;
</script>

<style>
.filter-multiselect{
  position:relative;
}
.filter-multiselect .filter-toggle{
  white-space:nowrap;
}
.btn-grey {
  background-color: #6c757d;
  border-color: #6c757d;
  color: #fff;
}
.btn-grey:hover {
  background-color: #5a6268;
  border-color: #545b62;
}
#auditClearFiltersBtn[hidden] {
  display: none !important;
}
.filter-multiselect .filter-menu{
  position:absolute;
  top:calc(100% + 4px);
  right:0;
  z-index:20;
  min-width:320px;
  max-height:260px;
  overflow:auto;
  background:var(--card,#111827);
  border:1px solid rgba(255,255,255,.08);
  border-radius:8px;
  box-shadow:0 12px 30px rgba(0,0,0,.6);
  padding:6px 0;
  display:none;
}
.filter-multiselect.open .filter-menu{
  display:block;
}
.filter-multiselect .filter-menu-inner{
  padding:0 8px 6px;
}
.filter-multiselect .filter-option{
  display:flex;
  flex-direction:row;
  align-items:center;
  gap:10px;
  padding:6px 10px;
  font-size:13px;
  cursor:pointer;
}
.filter-multiselect .filter-option input[type="checkbox"]{
  margin:0;
  flex-shrink:0;
  width:1.125em;
  height:1.125em;
  display:inline-block;
  vertical-align:middle;
}
.filter-multiselect .filter-option span{
  flex:1;
  min-width:0;
  text-align:left;
}
.filter-multiselect .filter-summary{
  margin-left:6px;
  font-size:11px;
  color:var(--muted-color,#9ca3af);
}
.audit-date-row{
  display:inline-flex;
  align-items:center;
  gap:8px;
}
.audit-date-to{
  font-size:13px;
  color:var(--muted,#a8b3cf);
}
.audit-date-control{
  position:relative;
  display:inline-flex;
  align-items:center;
  gap:0;
  width:auto;
  min-width:168px;
  padding:8px 34px 8px 12px;
  box-sizing:border-box;
}
.audit-date-control .audit-date-part{
  background:transparent;
  border:none;
  box-shadow:none;
  padding:0 2px;
  margin:0;
  border-radius:4px;
  text-align:center;
  color:inherit;
  font:inherit;
  outline:none;
  box-sizing:content-box;
  overflow:visible;
}
.audit-date-control .audit-date-part:focus{
  border:none;
  box-shadow:none;
  background:color-mix(in srgb, var(--btn) 18%, transparent);
}
.audit-date-part[data-part="month"],
.audit-date-part[data-part="day"]{
  width:3ch;
  min-width:3ch;
}
.audit-date-part[data-part="year"]{
  width:5ch;
  min-width:5ch;
}
.audit-date-sep{
  color:var(--muted,#a8b3cf);
  padding:0 1px;
  user-select:none;
}
.audit-date-cal{
  position:absolute;
  right:6px;
  top:50%;
  transform:translateY(-50%);
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:22px;
  height:22px;
  padding:0;
  border:none;
  background:transparent;
  color:var(--muted,#a8b3cf);
  cursor:pointer;
}
.audit-date-cal:hover{
  color:var(--text,#e5e7eb);
}
.audit-date-native{
  position:absolute;
  width:0;
  height:0;
  opacity:0;
  pointer-events:none;
  border:0;
  padding:0;
  margin:0;
}
.audit-search-input{
  width:auto;
  min-width:180px;
  max-width:260px;
}
.audit-search-input::-webkit-search-cancel-button,
.audit-search-input::-webkit-search-decoration{
  -webkit-appearance:none;
  appearance:none;
  display:none;
}

.audit-pagination{
  margin:16px 0 8px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:8px;
  width:100%;
  font-size:14px;
}
.audit-pagination .btn{
  padding:4px 14px;
  border-radius:999px;
  min-width:4.5rem;
  text-align:center;
  text-decoration:none;
  appearance:none;
  font: inherit;
  cursor:pointer;
}
.audit-pagination .btn.disabled{
  opacity:0.45;
  cursor:default;
  pointer-events:none;
}
.audit-page-info{
  padding:4px 12px;
  border-radius:999px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);
  font-size:13px;
  white-space:nowrap;
}

.modalOverlay{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.6);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:1000;
}

.modalCard{
  width: min(900px, 95%);
  max-height: 80vh;
  overflow:auto;
}

.detailsPre{
  background: rgba(255,255,255,.05);
  padding:12px;
  border-radius:8px;
  font-size:13px;
  white-space:pre-wrap;
  margin-top:8px;
}
.auditDetailsSummary{
  background: rgba(255,255,255,.06);
  padding:12px;
  border-radius:8px;
  margin-bottom:12px;
  font-size:14px;
}
.auditDetailsSummary .detailRow{ display:flex; gap:12px; margin-bottom:6px; }
.auditDetailsSummary .detailRow:last-child{ margin-bottom:0; }
.auditDetailsSummary .detailLabel{ color: var(--muted-color, #888); min-width:100px; }
.auditDetailsFormatted{ margin-bottom:12px; }
.auditDetailsFormatted .detailBlock{ margin-bottom:12px; }
.auditDetailsFormatted .detailBlock:last-child{ margin-bottom:0; }
.auditDetailsFormatted .detailItem{ display:flex; gap:12px; padding:6px 0; border-bottom:1px solid rgba(255,255,255,.06); font-size:14px; }
.auditDetailsFormatted .detailItem:last-child{ border-bottom:none; }
.auditDetailsFormatted .detailKey{ color: var(--muted-color, #888); min-width:140px; flex-shrink:0; }
.auditDetailsFormatted .detailVal{ word-break:break-word; }
.auditDetailsFormatted .detailVal.empty{ font-style:italic; color: var(--muted-color, #888); }
.auditDetailsFormatted ul.detailList{ margin:0; padding-left:20px; }
.auditDetailsFormatted .detailPre{ margin:0; padding:8px; background: rgba(0,0,0,.2); border-radius:4px; font-size:12px; white-space:pre-wrap; word-break:break-word; max-height:200px; overflow:auto; }
.auditDetailsRawWrap{ margin-top:12px; }
.auditDetailsRawWrap summary{ cursor:pointer; padding:4px 0; }

@media (max-width: 990px) {
  .listCardTableWrap {
    overflow-x: hidden;
  }
  .audit-log-table.listCardTable {
    width: 100%;
    min-width: 0 !important;
    border-collapse: separate;
    border-spacing: 0 12px;
  }
  .audit-log-table.listCardTable thead { display: none; }
  .audit-log-table.listCardTable tbody {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .audit-log-table.listCardTable tbody tr {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "title title"
      "time actor"
      "target agency"
      "actions actions";
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
  }
  .audit-log-table .cardTitleCell { grid-area: title; }
  .audit-log-table .auditTimeCell { grid-area: time; }
  .audit-log-table .auditActorCell { grid-area: actor; }
