<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Channel Patch",
    scopedSuffix: "Channel Patch",
    singleFallbackTitle: "Agency Channel Patch"
  }) %>

  <div id="cpBridgeBanner" class="cp-bridge" hidden>
    <span class="cp-bridgeDot"></span>
    <span id="cpBridgeText">Checking TAK stream…</span>
  </div>

  <div class="card cp-formCard">
    <div class="row" style="justify-content:space-between; align-items:center; margin-bottom:12px; gap:10px; flex-wrap:wrap;">
      <h2 style="margin:0;" id="cpFormTitle">New Patch</h2>
      <button class="btn" id="cpCancelEditBtn" type="button" style="display:none;">Cancel Edit</button>
    </div>

    <label class="cp-field">
      Name
      <input id="cpName" type="text" placeholder="e.g. Law Family Patch" maxlength="120" />
    </label>

    <div class="cp-channelsSection">
      <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
        <label style="margin:0; font-weight:600;">Channels</label>
        <input id="cpChannelSearch" type="search" placeholder="Filter channels…" style="max-width:260px; flex:1;" />
      </div>
      <div id="cpChannelsBox" class="groupsBox cp-channelsBox">
        <div class="msg">Loading channels…</div>
      </div>
    </div>

    <div class="row" style="margin-top:14px; gap:14px; align-items:center; flex-wrap:wrap;">
      <button class="btn" type="button" id="cpSubmitBtn">Create Patch</button>
      <div class="cp-enableCreate" id="cpEnableCreateRow">
        <span>Enable</span>
        <button
          type="button"
          id="cpCreateEnabled"
          class="settings-toggle is-on"
          aria-pressed="true"
          aria-label="Enable"
        ></button>
      </div>
    </div>
    <div id="cpFormMsg" class="msg" style="margin-top:10px;"></div>
  </div>

  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
      <h2 style="margin:0;">Patches</h2>
      <button class="btn" type="button" id="cpRefreshBtn" style="opacity:.85;">Refresh</button>
    </div>
    <div id="cpPatchBoard" class="cp-board">
      <div class="msg">Loading patches…</div>
    </div>
  </div>
</main>

<style>
  .cp-bridge {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    font-size: 0.92rem;
  }
  .cp-bridge.is-up { border-color: color-mix(in srgb, #3dba7a 45%, var(--line)); }
  .cp-bridge.is-down { border-color: color-mix(in srgb, #e35d5d 45%, var(--line)); }
  .cp-bridgeDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8b93a7;
    flex: 0 0 auto;
  }
  .cp-bridge.is-up .cp-bridgeDot { background: #3dba7a; box-shadow: 0 0 0 3px rgba(61,186,122,.2); }
  .cp-bridge.is-down .cp-bridgeDot { background: #e35d5d; }

  .cp-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin-bottom: 14px;
  }
  .cp-field input {
    width: 100%;
    max-width: 420px;
    box-sizing: border-box;
  }

  .cp-channelsBox {
    max-height: 280px;
    margin-top: 8px;
  }
  .cp-channelsInner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px 10px;
  }

  .cp-enableCreate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    user-select: none;
    font-size: 0.92rem;
  }

  .cp-board {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cp-patch {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
  }
  .cp-patch.is-on {
    border-color: color-mix(in srgb, #22c55e 55%, var(--line));
    background: color-mix(in srgb, #22c55e 16%, var(--panel));
  }
  .cp-patch.is-off {
    border-color: color-mix(in srgb, #ef4444 50%, var(--line));
    background: color-mix(in srgb, #ef4444 14%, var(--panel));
  }
  .cp-patchTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cp-patchTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .cp-patchActions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cp-enableRow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
  }
  .cp-danger {
    background: transparent;
    border: 1px solid color-mix(in srgb, #e35d5d 55%, var(--line));
    color: #e35d5d;
  }
  .cp-danger:hover {
    background: color-mix(in srgb, #e35d5d 12%, transparent);
  }

  .cp-topology {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .cp-node {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cp-empty {
    padding: 18px 4px;
    color: var(--muted, #8b93a7);
  }
</style>

<script>
(function () {
  const formTitle = document.getElementById("cpFormTitle");
  const cancelEditBtn = document.getElementById("cpCancelEditBtn");
  const channelsBox = document.getElementById("cpChannelsBox");
  const channelSearch = document.getElementById("cpChannelSearch");
  const nameInput = document.getElementById("cpName");
  const submitBtn = document.getElementById("cpSubmitBtn");
  const createEnabledBtn = document.getElementById("cpCreateEnabled");
  const enableCreateRow = document.getElementById("cpEnableCreateRow");
  const formMsg = document.getElementById("cpFormMsg");
  const board = document.getElementById("cpPatchBoard");
  const refreshBtn = document.getElementById("cpRefreshBtn");
  const bridgeBanner = document.getElementById("cpBridgeBanner");
  const bridgeText = document.getElementById("cpBridgeText");

  /** @type {{ name: string, displayName: string, baseKey: string }[]} */
  let channels = [];
  /** @type {object[]} */
  let patchesCache = [];
  /** Persist checked names across filter re-renders */
  const selectedNames = new Set();
  /** @type {string|null} */
  let editingId = null;

  function esc(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function displayFor(nameOrKey) {
    const raw = String(nameOrKey || "").trim();
    const hit = channels.find(
      (c) => c.name === raw || c.baseKey === raw.toLowerCase() || c.displayName === raw
    );
    return hit ? hit.displayName : raw.replace(/^tak_/i, "");
  }

  function isToggleOn(btn) {
    return !!(btn && btn.classList.contains("is-on"));
  }

  function setToggle(btn, on) {
    if (!btn) return;
    btn.classList.toggle("is-on", !!on);
    btn.classList.toggle("is-off", !on);
    btn.setAttribute("aria-pressed", on ? "true" : "false");
  }

  function setBridge(connected) {
    bridgeBanner.hidden = false;
    bridgeBanner.classList.toggle("is-up", !!connected);
    bridgeBanner.classList.toggle("is-down", !connected);
    bridgeText.textContent = connected
      ? "TAK stream connected"
      : "TAK stream disconnected";
  }

  function renderChannelsBox() {
    const q = String(channelSearch.value || "").trim().toLowerCase();
    const list = channels.filter((c) => {
      if (!q) return true;
      return (
        c.displayName.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q)
      );
    });

    if (!list.length) {
      channelsBox.innerHTML = '<div class="msg">No matching channels.</div>';
      return;
    }

    channelsBox.innerHTML =
      '<div class="cp-channelsInner">' +
      list
        .map((c) => {
          const checked = selectedNames.has(c.name) ? "checked" : "";
          return `<label class="groupItem"><input type="checkbox" value="${esc(
            c.name
          )}" ${checked} /><span>${esc(c.displayName)}</span></label>`;
        })
        .join("") +
      "</div>";
  }

  function setMsg(text, isError) {
    formMsg.textContent = text || "";
    formMsg.style.color = isError ? "#e35d5d" : "";
  }

  function setCreateMode() {
    editingId = null;
    formTitle.textContent = "New Patch";
    submitBtn.textContent = "Create Patch";
    cancelEditBtn.style.display = "none";
    enableCreateRow.style.display = "";
    setToggle(createEnabledBtn, true);
    nameInput.value = "";
    channelSearch.value = "";
    selectedNames.clear();
    renderChannelsBox();
    setMsg("");
  }

  function setEditMode(id) {
    const patch = patchesCache.find((p) => String(p.id) === String(id));
    if (!patch) return;

    editingId = String(patch.id);
    formTitle.textContent = "Edit Patch";
    submitBtn.textContent = "Save Changes";
    cancelEditBtn.style.display = "inline-block";
    enableCreateRow.style.display = "none";
    setMsg("");

    nameInput.value = patch.name || "";
    channelSearch.value = "";
    selectedNames.clear();
    for (const g of patch.groups || []) {
      const hit = channels.find(
        (c) =>
          c.name === g ||
          c.baseKey === String(g).toLowerCase() ||
          c.displayName === g
      );
      selectedNames.add(hit ? hit.name : g);
    }
    renderChannelsBox();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function api(path, opts) {
    const res = await fetch(path, {
      headers: { Accept: "application/json", "Content-Type": "application/json" },
      ...opts,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      const err = new Error(data.error || data.message || res.statusText || "Request failed");
      err.status = res.status;
      throw err;
    }
    return data;
  }

  function renderBoard(patches) {
    patchesCache = Array.isArray(patches) ? patches : [];
    if (!patchesCache.length) {
      board.innerHTML = '<div class="cp-empty">No patches yet.</div>';
      return;
    }

    board.innerHTML = patchesCache
      .map((p) => {
        const groups = Array.isArray(p.groups) ? p.groups : [];
        const nodesHtml = groups
          .map((g) => `<span class="cp-node">${esc(displayFor(g))}</span>`)
          .join("");

        return `
          <article class="cp-patch ${p.enabled ? "is-on" : "is-off"}" data-id="${esc(p.id)}">
            <div class="cp-patchTop">
              <h3 class="cp-patchTitle">${esc(p.name)}</h3>
              <div class="cp-patchActions">
                <div class="cp-enableRow">
                  <button
                    type="button"
                    class="settings-toggle ${p.enabled ? "is-on" : "is-off"} cp-enableToggle"
                    aria-pressed="${p.enabled ? "true" : "false"}"
                    aria-label="Enable ${esc(p.name)}"
                  ></button>
                </div>
                <button type="button" class="btn cp-editBtn">Edit</button>
                <button type="button" class="btn cp-danger cp-deleteBtn">Delete</button>
              </div>
            </div>
            <div class="cp-topology">${nodesHtml}</div>
          </article>`;
      })
      .join("");
  }

  async function loadMeta() {
    const meta = await api("/api/channel-patch/meta");
    channels = Array.isArray(meta.channels) ? meta.channels : [];
    channels.sort((a, b) =>
      String(a.displayName || "").localeCompare(String(b.displayName || ""), undefined, {
        sensitivity: "base",
      })
    );
    setBridge(!!meta.bridgeConnected);
    renderChannelsBox();
  }

  async function loadPatches() {
    const data = await api("/api/channel-patch");
    setBridge(!!data.bridgeConnected);
    renderBoard(Array.isArray(data.patches) ? data.patches : []);
  }

  async function refreshAll() {
    await loadMeta();
    await loadPatches();
  }

  channelSearch.addEventListener("input", () => {
    renderChannelsBox();
  });

  channelsBox.addEventListener("change", (e) => {
    const cb = e.target && e.target.matches('input[type="checkbox"]') ? e.target : null;
    if (!cb) return;
    if (cb.checked) selectedNames.add(cb.value);
    else selectedNames.delete(cb.value);
  });

  createEnabledBtn.addEventListener("click", () => {
    setToggle(createEnabledBtn, !isToggleOn(createEnabledBtn));
  });

  cancelEditBtn.addEventListener("click", () => setCreateMode());

  submitBtn.addEventListener("click", async () => {
    setMsg("");
    const groups = Array.from(selectedNames);
    if (groups.length < 2) {
      setMsg("Select at least two channels.", true);
      return;
    }
    const name = String(nameInput.value || "").trim();
    submitBtn.disabled = true;
    const isEdit = !!editingId;
    try {
      if (isEdit) {
        await api("/api/channel-patch/" + encodeURIComponent(editingId), {
          method: "PATCH",
          body: JSON.stringify({
            name,
            groups,
          }),
        });
        setCreateMode();
        setMsg("Patch updated.");
      } else {
        await api("/api/channel-patch", {
          method: "POST",
          body: JSON.stringify({
            name: name || undefined,
            groups,
            enabled: isToggleOn(createEnabledBtn),
          }),
        });
        setCreateMode();
        setMsg("Patch created.");
      }
      await loadPatches();
    } catch (err) {
      setMsg(err.message || (isEdit ? "Update failed" : "Create failed"), true);
    } finally {
      submitBtn.disabled = false;
    }
  });

  board.addEventListener("click", async (e) => {
    const toggle = e.target.closest(".cp-enableToggle");
    if (toggle) {
      const card = toggle.closest(".cp-patch");
      if (!card) return;
      const id = card.getAttribute("data-id");
      const next = !isToggleOn(toggle);
      setToggle(toggle, next);
      card.classList.toggle("is-on", next);
      card.classList.toggle("is-off", !next);
      toggle.disabled = true;
      try {
        await api("/api/channel-patch/" + encodeURIComponent(id), {
          method: "PATCH",
          body: JSON.stringify({ enabled: next }),
        });
        await loadPatches();
      } catch (err) {
        setToggle(toggle, !next);
        card.classList.toggle("is-on", !next);
        card.classList.toggle("is-off", next);
        alert(err.message || "Update failed");
      } finally {
        toggle.disabled = false;
      }
      return;
    }

    const editBtn = e.target.closest(".cp-editBtn");
    if (editBtn) {
      const card = editBtn.closest(".cp-patch");
      if (!card) return;
      setEditMode(card.getAttribute("data-id"));
      return;
    }

    const btn = e.target.closest(".cp-deleteBtn");
    if (!btn) return;
    const card = btn.closest(".cp-patch");
    if (!card) return;
    const id = card.getAttribute("data-id");
    const title = card.querySelector(".cp-patchTitle")?.textContent || "this patch";
    if (!confirm(`Delete ${title}?`)) return;
    btn.disabled = true;
    try {
      await api("/api/channel-patch/" + encodeURIComponent(id), { method: "DELETE" });
      if (editingId && String(editingId) === String(id)) setCreateMode();
      await loadPatches();
    } catch (err) {
      alert(err.message || "Delete failed");
      btn.disabled = false;
    }
  });

  refreshBtn.addEventListener("click", () => {
    refreshAll().catch((err) => {
      board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
        err.message || "Failed to refresh"
      )}</div>`;
    });
  });

  refreshAll().catch((err) => {
    setMsg(err.message || "Failed to load", true);
    board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
      err.message || "Failed to load patches"
    )}</div>`;
  });
})();
</script>
