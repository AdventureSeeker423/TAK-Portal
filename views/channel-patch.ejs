<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Channel Patch",
    scopedSuffix: "Channel Patch",
    singleFallbackTitle: "Agency Channel Patch"
  }) %>

  <p class="cp-lead">
    Link TAK portal groups like a radio patch console. Pick a hub channel, add spokes,
    and choose both-ways or one-way flow. Multiple patches can run at once.
  </p>

  <div id="cpBridgeBanner" class="cp-bridge" hidden>
    <span class="cp-bridgeDot"></span>
    <span id="cpBridgeText">Checking TAK stream…</span>
  </div>

  <div class="card cp-createCard">
    <h2 style="margin-top:0;">New Patch</h2>

    <div class="cp-createGrid">
      <label class="cp-field">
        Name
        <input id="cpName" type="text" placeholder="e.g. Fire Mutual Aid Patch" maxlength="120" />
      </label>

      <label class="cp-field">
        Hub group
        <select id="cpHub"></select>
      </label>
    </div>

    <div class="cp-spokesSection">
      <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
        <label style="margin:0; font-weight:600;">Spoke groups</label>
        <input id="cpSpokeSearch" type="search" placeholder="Filter groups…" style="max-width:260px; flex:1;" />
      </div>
      <div id="cpSpokesBox" class="groupsBox cp-spokesBox">
        <div class="msg">Loading groups…</div>
      </div>
    </div>

    <div id="cpSpokeDirections" class="cp-dirPanel" hidden>
      <div class="cp-dirHeader">Spoke directions <span class="cp-muted">(default: both ways)</span></div>
      <div id="cpDirRows" class="cp-dirRows"></div>
    </div>

    <div class="row" style="margin-top:14px; gap:10px; align-items:center;">
      <button class="btn" type="button" id="cpCreateBtn">Create Patch</button>
      <label class="cp-enableCreate">
        <input type="checkbox" id="cpCreateEnabled" checked />
        Enable immediately
      </label>
    </div>
    <div id="cpCreateMsg" class="msg" style="margin-top:10px;"></div>
  </div>

  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
      <h2 style="margin:0;">Active Patches</h2>
      <button class="btn" type="button" id="cpRefreshBtn" style="opacity:.85;">Refresh</button>
    </div>
    <div id="cpPatchBoard" class="cp-board">
      <div class="msg">Loading patches…</div>
    </div>
  </div>
</main>

<style>
  .cp-lead {
    margin: 0 0 16px;
    max-width: 62ch;
    color: var(--muted, #8b93a7);
    line-height: 1.45;
  }

  .cp-bridge {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    font-size: 0.92rem;
  }
  .cp-bridge.is-up { border-color: color-mix(in srgb, #3dba7a 45%, var(--line)); }
  .cp-bridge.is-down { border-color: color-mix(in srgb, #e35d5d 45%, var(--line)); }
  .cp-bridgeDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8b93a7;
    flex: 0 0 auto;
  }
  .cp-bridge.is-up .cp-bridgeDot { background: #3dba7a; box-shadow: 0 0 0 3px rgba(61,186,122,.2); }
  .cp-bridge.is-down .cp-bridgeDot { background: #e35d5d; }

  .cp-createGrid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 12px;
    margin-bottom: 14px;
  }
  @media (max-width: 800px) {
    .cp-createGrid { grid-template-columns: 1fr; }
  }
  .cp-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .cp-field input,
  .cp-field select {
    width: 100%;
    box-sizing: border-box;
  }

  .cp-spokesBox {
    max-height: 240px;
    margin-top: 8px;
  }
  .cp-spokesInner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px 10px;
  }

  .cp-dirPanel {
    margin-top: 14px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
  }
  .cp-dirHeader { font-weight: 600; margin-bottom: 10px; }
  .cp-muted { font-weight: 400; color: var(--muted, #8b93a7); font-size: 0.9em; }
  .cp-dirRows { display: flex; flex-direction: column; gap: 8px; }
  .cp-dirRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
  }
  .cp-dirLabel {
    font-weight: 500;
    min-width: 140px;
  }
  .cp-dirRow .segmented { flex-wrap: wrap; }

  .cp-enableCreate {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    user-select: none;
  }

  .cp-board {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cp-patch {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--btn) 8%, transparent), transparent 42%),
      var(--panel);
  }
  .cp-patch.is-off {
    opacity: 0.72;
    background: var(--panel);
  }
  .cp-patchTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cp-patchTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .cp-patchMeta {
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--muted, #8b93a7);
  }
  .cp-patchActions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cp-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    cursor: pointer;
    user-select: none;
    font-size: 0.88rem;
  }
  .cp-toggle input { margin: 0; }
  .cp-danger {
    background: transparent;
    border: 1px solid color-mix(in srgb, #e35d5d 55%, var(--line));
    color: #e35d5d;
  }
  .cp-danger:hover {
    background: color-mix(in srgb, #e35d5d 12%, transparent);
  }

  .cp-topology {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .cp-node {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cp-node.is-hub {
    border-color: color-mix(in srgb, var(--btn) 55%, var(--line));
    background: color-mix(in srgb, var(--btn) 18%, transparent);
  }
  .cp-edge {
    font-size: 0.78rem;
    color: var(--muted, #8b93a7);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    letter-spacing: 0.02em;
  }
  .cp-statusLine {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--muted, #8b93a7);
  }
  .cp-statusLine.is-err { color: #e35d5d; }
  .cp-empty {
    padding: 18px 4px;
    color: var(--muted, #8b93a7);
  }
</style>

<script>
(function () {
  const hubSelect = document.getElementById("cpHub");
  const spokesBox = document.getElementById("cpSpokesBox");
  const spokeSearch = document.getElementById("cpSpokeSearch");
  const dirPanel = document.getElementById("cpSpokeDirections");
  const dirRows = document.getElementById("cpDirRows");
  const nameInput = document.getElementById("cpName");
  const createBtn = document.getElementById("cpCreateBtn");
  const createEnabled = document.getElementById("cpCreateEnabled");
  const createMsg = document.getElementById("cpCreateMsg");
  const board = document.getElementById("cpPatchBoard");
  const refreshBtn = document.getElementById("cpRefreshBtn");
  const bridgeBanner = document.getElementById("cpBridgeBanner");
  const bridgeText = document.getElementById("cpBridgeText");

  /** @type {{ name: string, displayName: string, baseKey: string }[]} */
  let channels = [];
  /** @type {Map<string, string>} baseKey -> direction */
  const spokeDirs = new Map();

  function esc(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function displayFor(nameOrKey) {
    const raw = String(nameOrKey || "").trim();
    const hit = channels.find(
      (c) => c.name === raw || c.baseKey === raw.toLowerCase() || c.displayName === raw
    );
    return hit ? hit.displayName : raw.replace(/^tak_/i, "");
  }

  function setBridge(connected) {
    bridgeBanner.hidden = false;
    bridgeBanner.classList.toggle("is-up", !!connected);
    bridgeBanner.classList.toggle("is-down", !connected);
    bridgeText.textContent = connected
      ? "TAK stream connected — patches can rebroadcast"
      : "TAK stream disconnected — patches saved but will not forward until connected";
  }

  function selectedSpokeNames() {
    return Array.from(spokesBox.querySelectorAll('input[type="checkbox"]:checked')).map(
      (cb) => cb.value
    );
  }

  function hubName() {
    return String(hubSelect.value || "").trim();
  }

  function renderHubOptions() {
    const prev = hubSelect.value;
    hubSelect.innerHTML =
      '<option value="">Select hub group…</option>' +
      channels
        .map(
          (c) =>
            `<option value="${esc(c.name)}">${esc(c.displayName)}</option>`
        )
        .join("");
    if (prev && channels.some((c) => c.name === prev)) hubSelect.value = prev;
  }

  function renderSpokesBox() {
    const q = String(spokeSearch.value || "").trim().toLowerCase();
    const hub = hubName();
    const list = channels.filter((c) => {
      if (hub && c.name === hub) return false;
      if (!q) return true;
      return (
        c.displayName.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q)
      );
    });

    if (!list.length) {
      spokesBox.innerHTML = '<div class="msg">No matching groups.</div>';
      return;
    }

    const selected = new Set(selectedSpokeNames());
    spokesBox.innerHTML =
      '<div class="cp-spokesInner">' +
      list
        .map((c) => {
          const checked = selected.has(c.name) ? "checked" : "";
          return `<label class="groupItem"><input type="checkbox" value="${esc(
            c.name
          )}" ${checked} /><span>${esc(c.displayName)}</span></label>`;
        })
        .join("") +
      "</div>";
  }

  function dirGlyph(direction) {
    if (direction === "from_hub") return "hub → spoke";
    if (direction === "to_hub") return "spoke → hub";
    return "↔ both";
  }

  function renderDirectionRows() {
    const spokes = selectedSpokeNames();
    // Drop dirs for deselected
    for (const key of Array.from(spokeDirs.keys())) {
      if (!spokes.includes(key)) spokeDirs.delete(key);
    }
    for (const name of spokes) {
      if (!spokeDirs.has(name)) spokeDirs.set(name, "both");
    }

    if (!spokes.length) {
      dirPanel.hidden = true;
      dirRows.innerHTML = "";
      return;
    }

    dirPanel.hidden = false;
    dirRows.innerHTML = spokes
      .map((name) => {
        const dir = spokeDirs.get(name) || "both";
        const opts = [
          ["both", "Both ways"],
          ["from_hub", "Hub → Spoke"],
          ["to_hub", "Spoke → Hub"],
        ];
        return `
          <div class="cp-dirRow" data-group="${esc(name)}">
            <div class="cp-dirLabel">${esc(displayFor(name))}</div>
            <div class="segmented" role="group" aria-label="Direction for ${esc(
              displayFor(name)
            )}">
              ${opts
                .map(
                  ([v, label]) =>
                    `<button type="button" class="segBtn ${
                      dir === v ? "active" : ""
                    }" data-dir="${v}">${label}</button>`
                )
                .join("")}
            </div>
          </div>`;
      })
      .join("");
  }

  function setMsg(el, text, isError) {
    el.textContent = text || "";
    el.style.color = isError ? "#e35d5d" : "";
  }

  async function api(path, opts) {
    const res = await fetch(path, {
      headers: { Accept: "application/json", "Content-Type": "application/json" },
      ...opts,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      const err = new Error(data.error || data.message || res.statusText || "Request failed");
      err.status = res.status;
      throw err;
    }
    return data;
  }

  function renderBoard(patches) {
    if (!patches || !patches.length) {
      board.innerHTML =
        '<div class="cp-empty">No patches yet. Create one above to link groups.</div>';
      return;
    }

    board.innerHTML = patches
      .map((p) => {
        const spokesHtml = (p.spokes || [])
          .map((s) => {
            return `
              <span class="cp-edge">${esc(dirGlyph(s.direction))}</span>
              <span class="cp-node">${esc(displayFor(s.group))}</span>`;
          })
          .join("");

        const status = p.lastError
          ? `<div class="cp-statusLine is-err">Last error: ${esc(p.lastError)}</div>`
          : p.lastForwardAt
            ? `<div class="cp-statusLine">Last forwarded: ${esc(
                new Date(p.lastForwardAt).toLocaleString()
              )}</div>`
            : `<div class="cp-statusLine">Waiting for traffic…</div>`;

        return `
          <article class="cp-patch ${p.enabled ? "" : "is-off"}" data-id="${esc(p.id)}">
            <div class="cp-patchTop">
              <div>
                <h3 class="cp-patchTitle">${esc(p.name)}</h3>
                <div class="cp-patchMeta">
                  ${p.enabled ? "Enabled" : "Disabled"}
                  ${p.createdBy ? " · " + esc(p.createdBy) : ""}
                </div>
              </div>
              <div class="cp-patchActions">
                <label class="cp-toggle">
                  <input type="checkbox" class="cp-enableToggle" ${
                    p.enabled ? "checked" : ""
                  } />
                  ${p.enabled ? "On" : "Off"}
                </label>
                <button type="button" class="btn cp-danger cp-deleteBtn">Delete</button>
              </div>
            </div>
            <div class="cp-topology">
              <span class="cp-node is-hub" title="Hub">${esc(
                displayFor(p.hubGroup)
              )}</span>
              ${spokesHtml}
            </div>
            ${status}
          </article>`;
      })
      .join("");
  }

  async function loadMeta() {
    const meta = await api("/api/channel-patch/meta");
    channels = Array.isArray(meta.channels) ? meta.channels : [];
    channels.sort((a, b) =>
      String(a.displayName || "").localeCompare(String(b.displayName || ""), undefined, {
        sensitivity: "base",
      })
    );
    setBridge(!!meta.bridgeConnected);
    renderHubOptions();
    renderSpokesBox();
    renderDirectionRows();
  }

  async function loadPatches() {
    const data = await api("/api/channel-patch");
    setBridge(!!data.bridgeConnected);
    renderBoard(Array.isArray(data.patches) ? data.patches : []);
  }

  async function refreshAll() {
    await loadMeta();
    await loadPatches();
  }

  hubSelect.addEventListener("change", () => {
    // If hub was selected as spoke, uncheck it
    const hub = hubName();
    spokesBox.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
      if (cb.value === hub) cb.checked = false;
    });
    renderSpokesBox();
    renderDirectionRows();
  });

  spokeSearch.addEventListener("input", () => {
    renderSpokesBox();
  });

  spokesBox.addEventListener("change", (e) => {
    if (e.target && e.target.matches('input[type="checkbox"]')) {
      renderDirectionRows();
    }
  });

  dirRows.addEventListener("click", (e) => {
    const btn = e.target.closest(".segBtn");
    if (!btn) return;
    const row = btn.closest(".cp-dirRow");
    if (!row) return;
    const group = row.getAttribute("data-group");
    const dir = btn.getAttribute("data-dir");
    if (!group || !dir) return;
    spokeDirs.set(group, dir);
    row.querySelectorAll(".segBtn").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
  });

  createBtn.addEventListener("click", async () => {
    setMsg(createMsg, "");
    const hub = hubName();
    const spokes = selectedSpokeNames().map((group) => ({
      group,
      direction: spokeDirs.get(group) || "both",
    }));
    if (!hub) {
      setMsg(createMsg, "Select a hub group.", true);
      return;
    }
    if (!spokes.length) {
      setMsg(createMsg, "Select at least one spoke group.", true);
      return;
    }
    createBtn.disabled = true;
    try {
      await api("/api/channel-patch", {
        method: "POST",
        body: JSON.stringify({
          name: String(nameInput.value || "").trim() || undefined,
          hubGroup: hub,
          spokes,
          enabled: !!createEnabled.checked,
        }),
      });
      nameInput.value = "";
      spokeDirs.clear();
      spokesBox.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
        cb.checked = false;
      });
      renderDirectionRows();
      setMsg(createMsg, "Patch created.");
      await loadPatches();
    } catch (err) {
      setMsg(createMsg, err.message || "Create failed", true);
    } finally {
      createBtn.disabled = false;
    }
  });

  board.addEventListener("change", async (e) => {
    const toggle = e.target.closest(".cp-enableToggle");
    if (!toggle) return;
    const card = toggle.closest(".cp-patch");
    if (!card) return;
    const id = card.getAttribute("data-id");
    const enabled = !!toggle.checked;
    toggle.disabled = true;
    try {
      await api("/api/channel-patch/" + encodeURIComponent(id), {
        method: "PATCH",
        body: JSON.stringify({ enabled }),
      });
      await loadPatches();
    } catch (err) {
      alert(err.message || "Update failed");
      toggle.checked = !enabled;
    } finally {
      toggle.disabled = false;
    }
  });

  board.addEventListener("click", async (e) => {
    const btn = e.target.closest(".cp-deleteBtn");
    if (!btn) return;
    const card = btn.closest(".cp-patch");
    if (!card) return;
    const id = card.getAttribute("data-id");
    const title = card.querySelector(".cp-patchTitle")?.textContent || "this patch";
    if (!confirm(`Delete ${title}?`)) return;
    btn.disabled = true;
    try {
      await api("/api/channel-patch/" + encodeURIComponent(id), { method: "DELETE" });
      await loadPatches();
    } catch (err) {
      alert(err.message || "Delete failed");
      btn.disabled = false;
    }
  });

  refreshBtn.addEventListener("click", () => {
    refreshAll().catch((err) => {
      board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
        err.message || "Failed to refresh"
      )}</div>`;
    });
  });

  refreshAll().catch((err) => {
    setMsg(createMsg, err.message || "Failed to load", true);
    board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
      err.message || "Failed to load patches"
    )}</div>`;
  });

  // Soft poll for bridge / last-forward status
  setInterval(() => {
    loadPatches().catch(() => {});
  }, 15000);
})();
</script>
