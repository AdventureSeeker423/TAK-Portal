<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Channel Patch",
    scopedSuffix: "Channel Patch",
    singleFallbackTitle: "Agency Channel Patch"
  }) %>

  <p class="cp-lead">
    Select the channels you want linked. Traffic on any selected channel is
    rebroadcast to the others in both directions.
  </p>

  <div id="cpBridgeBanner" class="cp-bridge" hidden>
    <span class="cp-bridgeDot"></span>
    <span id="cpBridgeText">Checking TAK stream…</span>
  </div>

  <div class="card cp-createCard">
    <h2 style="margin-top:0;">New Patch</h2>

    <label class="cp-field">
      Name
      <input id="cpName" type="text" placeholder="e.g. Law Family Patch" maxlength="120" />
    </label>

    <div class="cp-channelsSection">
      <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
        <label style="margin:0; font-weight:600;">Channels</label>
        <input id="cpChannelSearch" type="search" placeholder="Filter channels…" style="max-width:260px; flex:1;" />
      </div>
      <div id="cpChannelsBox" class="groupsBox cp-channelsBox">
        <div class="msg">Loading channels…</div>
      </div>
      <div id="cpSelectedHint" class="cp-selectedHint"></div>
    </div>

    <div class="row" style="margin-top:14px; gap:14px; align-items:center; flex-wrap:wrap;">
      <button class="btn" type="button" id="cpCreateBtn">Create Patch</button>
      <div class="cp-enableCreate">
        <span>Enable immediately</span>
        <button
          type="button"
          id="cpCreateEnabled"
          class="settings-toggle is-on"
          aria-pressed="true"
          aria-label="Enable immediately"
        ></button>
      </div>
    </div>
    <div id="cpCreateMsg" class="msg" style="margin-top:10px;"></div>
  </div>

  <div class="card">
    <div class="row" style="justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;">
      <h2 style="margin:0;">Patches</h2>
      <button class="btn" type="button" id="cpRefreshBtn" style="opacity:.85;">Refresh</button>
    </div>
    <div id="cpPatchBoard" class="cp-board">
      <div class="msg">Loading patches…</div>
    </div>
  </div>
</main>

<style>
  .cp-lead {
    margin: 0 0 16px;
    max-width: 62ch;
    color: var(--muted, #8b93a7);
    line-height: 1.45;
  }

  .cp-bridge {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 10px 14px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--panel) 88%, transparent);
    font-size: 0.92rem;
  }
  .cp-bridge.is-up { border-color: color-mix(in srgb, #3dba7a 45%, var(--line)); }
  .cp-bridge.is-down { border-color: color-mix(in srgb, #e35d5d 45%, var(--line)); }
  .cp-bridgeDot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8b93a7;
    flex: 0 0 auto;
  }
  .cp-bridge.is-up .cp-bridgeDot { background: #3dba7a; box-shadow: 0 0 0 3px rgba(61,186,122,.2); }
  .cp-bridge.is-down .cp-bridgeDot { background: #e35d5d; }

  .cp-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    margin-bottom: 14px;
  }
  .cp-field input {
    width: 100%;
    max-width: 420px;
    box-sizing: border-box;
  }

  .cp-channelsBox {
    max-height: 280px;
    margin-top: 8px;
  }
  .cp-channelsInner {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 4px 10px;
  }
  .cp-selectedHint {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--muted, #8b93a7);
  }

  .cp-enableCreate {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    user-select: none;
    font-size: 0.92rem;
  }

  .cp-board {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cp-patch {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px 16px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--btn) 8%, transparent), transparent 42%),
      var(--panel);
  }
  .cp-patch.is-off {
    opacity: 0.72;
    background: var(--panel);
  }
  .cp-patchTop {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cp-patchTitle {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .cp-patchMeta {
    margin-top: 4px;
    font-size: 0.85rem;
    color: var(--muted, #8b93a7);
  }
  .cp-patchActions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cp-enableRow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
  }
  .cp-danger {
    background: transparent;
    border: 1px solid color-mix(in srgb, #e35d5d 55%, var(--line));
    color: #e35d5d;
  }
  .cp-danger:hover {
    background: color-mix(in srgb, #e35d5d 12%, transparent);
  }

  .cp-topology {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .cp-node {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 65%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cp-statusLine {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--muted, #8b93a7);
  }
  .cp-statusLine.is-err { color: #e35d5d; }
  .cp-empty {
    padding: 18px 4px;
    color: var(--muted, #8b93a7);
  }
</style>

<script>
(function () {
  const channelsBox = document.getElementById("cpChannelsBox");
  const channelSearch = document.getElementById("cpChannelSearch");
  const selectedHint = document.getElementById("cpSelectedHint");
  const nameInput = document.getElementById("cpName");
  const createBtn = document.getElementById("cpCreateBtn");
  const createEnabledBtn = document.getElementById("cpCreateEnabled");
  const createMsg = document.getElementById("cpCreateMsg");
  const board = document.getElementById("cpPatchBoard");
  const refreshBtn = document.getElementById("cpRefreshBtn");
  const bridgeBanner = document.getElementById("cpBridgeBanner");
  const bridgeText = document.getElementById("cpBridgeText");

  /** @type {{ name: string, displayName: string, baseKey: string }[]} */
  let channels = [];
  /** Persist checked names across filter re-renders */
  const selectedNames = new Set();

  function esc(s) {
    return String(s ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function displayFor(nameOrKey) {
    const raw = String(nameOrKey || "").trim();
    const hit = channels.find(
      (c) => c.name === raw || c.baseKey === raw.toLowerCase() || c.displayName === raw
    );
    return hit ? hit.displayName : raw.replace(/^tak_/i, "");
  }

  function isToggleOn(btn) {
    return !!(btn && btn.classList.contains("is-on"));
  }

  function setToggle(btn, on) {
    if (!btn) return;
    btn.classList.toggle("is-on", !!on);
    btn.classList.toggle("is-off", !on);
    btn.setAttribute("aria-pressed", on ? "true" : "false");
  }

  function setBridge(connected) {
    bridgeBanner.hidden = false;
    bridgeBanner.classList.toggle("is-up", !!connected);
    bridgeBanner.classList.toggle("is-down", !connected);
    bridgeText.textContent = connected
      ? "TAK stream connected — patches can rebroadcast"
      : "TAK stream disconnected — patches saved but will not forward until connected";
  }

  function updateSelectedHint() {
    const n = selectedNames.size;
    if (n < 2) {
      selectedHint.textContent = n === 0
        ? "Select at least two channels."
        : "Select one more channel.";
      return;
    }
    selectedHint.textContent = n + " channels selected — both directions.";
  }

  function renderChannelsBox() {
    const q = String(channelSearch.value || "").trim().toLowerCase();
    const list = channels.filter((c) => {
      if (!q) return true;
      return (
        c.displayName.toLowerCase().includes(q) ||
        c.name.toLowerCase().includes(q)
      );
    });

    if (!list.length) {
      channelsBox.innerHTML = '<div class="msg">No matching channels.</div>';
      updateSelectedHint();
      return;
    }

    channelsBox.innerHTML =
      '<div class="cp-channelsInner">' +
      list
        .map((c) => {
          const checked = selectedNames.has(c.name) ? "checked" : "";
          return `<label class="groupItem"><input type="checkbox" value="${esc(
            c.name
          )}" ${checked} /><span>${esc(c.displayName)}</span></label>`;
        })
        .join("") +
      "</div>";
    updateSelectedHint();
  }

  function setMsg(el, text, isError) {
    el.textContent = text || "";
    el.style.color = isError ? "#e35d5d" : "";
  }

  async function api(path, opts) {
    const res = await fetch(path, {
      headers: { Accept: "application/json", "Content-Type": "application/json" },
      ...opts,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      const err = new Error(data.error || data.message || res.statusText || "Request failed");
      err.status = res.status;
      throw err;
    }
    return data;
  }

  function renderBoard(patches) {
    if (!patches || !patches.length) {
      board.innerHTML =
        '<div class="cp-empty">No patches yet. Select channels above to create one.</div>';
      return;
    }

    board.innerHTML = patches
      .map((p) => {
        const groups = Array.isArray(p.groups) ? p.groups : [];
        const nodesHtml = groups
          .map(
            (g) =>
              `<span class="cp-node">${esc(displayFor(g))}</span>`
          )
          .join("");

        const status = p.lastError
          ? `<div class="cp-statusLine is-err">Last error: ${esc(p.lastError)}</div>`
          : p.lastForwardAt
            ? `<div class="cp-statusLine">Last forwarded: ${esc(
                new Date(p.lastForwardAt).toLocaleString()
              )}</div>`
            : `<div class="cp-statusLine">Waiting for traffic…</div>`;

        return `
          <article class="cp-patch ${p.enabled ? "" : "is-off"}" data-id="${esc(p.id)}">
            <div class="cp-patchTop">
              <div>
                <h3 class="cp-patchTitle">${esc(p.name)}</h3>
                <div class="cp-patchMeta">
                  ${p.enabled ? "Enabled" : "Disabled"}
                  ${p.createdBy ? " · " + esc(p.createdBy) : ""}
                </div>
              </div>
              <div class="cp-patchActions">
                <div class="cp-enableRow">
                  <span>${p.enabled ? "On" : "Off"}</span>
                  <button
                    type="button"
                    class="settings-toggle ${p.enabled ? "is-on" : "is-off"} cp-enableToggle"
                    aria-pressed="${p.enabled ? "true" : "false"}"
                    aria-label="Enable ${esc(p.name)}"
                  ></button>
                </div>
                <button type="button" class="btn cp-danger cp-deleteBtn">Delete</button>
              </div>
            </div>
            <div class="cp-topology">${nodesHtml}</div>
            ${status}
          </article>`;
      })
      .join("");
  }

  async function loadMeta() {
    const meta = await api("/api/channel-patch/meta");
    channels = Array.isArray(meta.channels) ? meta.channels : [];
    channels.sort((a, b) =>
      String(a.displayName || "").localeCompare(String(b.displayName || ""), undefined, {
        sensitivity: "base",
      })
    );
    setBridge(!!meta.bridgeConnected);
    renderChannelsBox();
  }

  async function loadPatches() {
    const data = await api("/api/channel-patch");
    setBridge(!!data.bridgeConnected);
    renderBoard(Array.isArray(data.patches) ? data.patches : []);
  }

  async function refreshAll() {
    await loadMeta();
    await loadPatches();
  }

  channelSearch.addEventListener("input", () => {
    renderChannelsBox();
  });

  channelsBox.addEventListener("change", (e) => {
    const cb = e.target && e.target.matches('input[type="checkbox"]') ? e.target : null;
    if (!cb) return;
    if (cb.checked) selectedNames.add(cb.value);
    else selectedNames.delete(cb.value);
    updateSelectedHint();
  });

  createEnabledBtn.addEventListener("click", () => {
    setToggle(createEnabledBtn, !isToggleOn(createEnabledBtn));
  });

  createBtn.addEventListener("click", async () => {
    setMsg(createMsg, "");
    const groups = Array.from(selectedNames);
    if (groups.length < 2) {
      setMsg(createMsg, "Select at least two channels.", true);
      return;
    }
    createBtn.disabled = true;
    try {
      await api("/api/channel-patch", {
        method: "POST",
        body: JSON.stringify({
          name: String(nameInput.value || "").trim() || undefined,
          groups,
          enabled: isToggleOn(createEnabledBtn),
        }),
      });
      nameInput.value = "";
      selectedNames.clear();
      renderChannelsBox();
      setMsg(createMsg, "Patch created.");
      await loadPatches();
    } catch (err) {
      setMsg(createMsg, err.message || "Create failed", true);
    } finally {
      createBtn.disabled = false;
    }
  });

  board.addEventListener("click", async (e) => {
    const toggle = e.target.closest(".cp-enableToggle");
    if (toggle) {
      const card = toggle.closest(".cp-patch");
      if (!card) return;
      const id = card.getAttribute("data-id");
      const next = !isToggleOn(toggle);
      setToggle(toggle, next);
      const label = card.querySelector(".cp-enableRow span");
      if (label) label.textContent = next ? "On" : "Off";
      toggle.disabled = true;
      try {
        await api("/api/channel-patch/" + encodeURIComponent(id), {
          method: "PATCH",
          body: JSON.stringify({ enabled: next }),
        });
        await loadPatches();
      } catch (err) {
        setToggle(toggle, !next);
        if (label) label.textContent = !next ? "On" : "Off";
        alert(err.message || "Update failed");
      } finally {
        toggle.disabled = false;
      }
      return;
    }

    const btn = e.target.closest(".cp-deleteBtn");
    if (!btn) return;
    const card = btn.closest(".cp-patch");
    if (!card) return;
    const id = card.getAttribute("data-id");
    const title = card.querySelector(".cp-patchTitle")?.textContent || "this patch";
    if (!confirm(`Delete ${title}?`)) return;
    btn.disabled = true;
    try {
      await api("/api/channel-patch/" + encodeURIComponent(id), { method: "DELETE" });
      await loadPatches();
    } catch (err) {
      alert(err.message || "Delete failed");
      btn.disabled = false;
    }
  });

  refreshBtn.addEventListener("click", () => {
    refreshAll().catch((err) => {
      board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
        err.message || "Failed to refresh"
      )}</div>`;
    });
  });

  refreshAll().catch((err) => {
    setMsg(createMsg, err.message || "Failed to load", true);
    board.innerHTML = `<div class="msg" style="color:#e35d5d;">${esc(
      err.message || "Failed to load patches"
    )}</div>`;
  });
})();
</script>
