        function resolveSubTakClient(sub) {
          if (!sub) return "";
          var raw = sub.takClient != null ? String(sub.takClient).trim() : "";
          if (!raw || raw === "—") {
            raw = sub.platform != null ? String(sub.platform).trim() : "";
          }
          return raw;
        }

        function isPreferenceConfigClient(sub) {
          var client = resolveSubTakClient(sub).toUpperCase();
          return client === "ATAK-CIV" || client === "TAKAWARE-CIV";
        }

        function isDataSyncClient(sub) {
          var client = resolveSubTakClient(sub).toUpperCase();
          return client === "ATAK-CIV" || client === "ITAK" || client === "TAKAWARE-CIV";
        }

        function setPreferenceConfigVisible(visible) {
          if (prefConfigSectionEl) prefConfigSectionEl.style.display = visible ? "block" : "none";
          if (!visible) {
            setPrefConfigLoading(false);
            showPrefConfigStatus("");
          }
        }

        function setDataSyncSectionVisible(visible) {
          if (dataSyncSectionEl) dataSyncSectionEl.style.display = visible ? "block" : "none";
          if (!visible) {
            setDataSyncLoading(false);
            showDataSyncStatus("");
          }
        }

        function groupControlDisplayName(g) {
          if (!g) return "—";
          if (g.displayName) return g.displayName;
          var name = g.name || "";
          var mode = String(g.accessMode || g.typeLabel || "").toUpperCase();
          if (mode === "READ") return name + "_READ";
          if (mode === "WRITE") return name + "_WRITE";
          return name || "—";
        }

        function showPrefConfigStatus(msg, kind) {
          if (!prefConfigStatusEl) return;
          if (!msg) {
            prefConfigStatusEl.textContent = "";
            prefConfigStatusEl.style.display = "none";
            prefConfigStatusEl.className = "pref-config-status";
            return;
          }
          prefConfigStatusEl.textContent = msg;
          prefConfigStatusEl.style.display = "block";
          prefConfigStatusEl.className = "pref-config-status" + (kind === "error" ? " error" : kind === "success" ? " success" : "");
        }

        function setPrefConfigLoading(on) {
          if (prefConfigLoadingEl) prefConfigLoadingEl.style.display = on ? "block" : "none";
          if (prefConfigFormEl) prefConfigFormEl.style.display = "block";
        }

        function fillSelectOptions(selectEl, options, selectedValue, emptyLabel) {
          if (!selectEl) return;
          selectEl.innerHTML = "";
          if (emptyLabel) {
            var emptyOpt = document.createElement("option");
            emptyOpt.value = "";
            emptyOpt.textContent = emptyLabel;
            selectEl.appendChild(emptyOpt);
          }
          (options || []).forEach(function (opt) {
            var o = document.createElement("option");
            if (opt && typeof opt === "object") {
              o.value = opt.value != null ? String(opt.value) : "";
              o.textContent = opt.label != null ? String(opt.label) : o.value;
            } else {
              o.value = String(opt);
              o.textContent = String(opt);
            }
            selectEl.appendChild(o);
          });
          var sel = selectedValue != null ? String(selectedValue).trim() : "";
          if (sel) {
            var match = Array.prototype.find.call(selectEl.options, function (opt) {
              return String(opt.value).toLowerCase() === sel.toLowerCase();
            });
            if (match) selectEl.value = match.value;
            else if (!emptyLabel) {
              var custom = document.createElement("option");
              custom.value = sel;
              custom.textContent = sel;
              selectEl.appendChild(custom);
              selectEl.value = sel;
            } else if (emptyLabel) {
              var customEmpty = document.createElement("option");
              customEmpty.value = sel;
              customEmpty.textContent = sel;
              selectEl.appendChild(customEmpty);
              selectEl.value = sel;
            }
          }
        }

        function loadPreferenceConfig(clientId) {
          if (!clientId) return Promise.reject(new Error("Missing client id"));
          setPrefConfigLoading(true);
          showPrefConfigStatus("");
          return fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/preference-config", {
            headers: { Accept: "application/json" },
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to load configuration");
                return body;
              });
            })
            .then(function (data) {
              setPrefConfigLoading(false);
              if (prefConfigCallsignEl) prefConfigCallsignEl.value = data.callsign || "";
              fillSelectOptions(prefConfigTeamEl, data.teamOptions || [], data.teamLabel || "", "Select team…");
              fillSelectOptions(prefConfigRoleEl, data.roleOptions || [], data.roleLabel || "Team Member", null);
              return data;
            })
            .catch(function (err) {
              setPrefConfigLoading(false);
              showPrefConfigStatus(err.message || "Failed to load configuration", "error");
              throw err;
            });
        }

        function sendPreferenceConfig(clientId) {
          if (!clientId || prefConfigSendInFlight) return;
          var callsign = prefConfigCallsignEl ? String(prefConfigCallsignEl.value || "").trim() : "";
          var teamLabel = prefConfigTeamEl ? String(prefConfigTeamEl.value || "").trim() : "";
          var roleLabel = prefConfigRoleEl ? String(prefConfigRoleEl.value || "").trim() : "";
          if (!callsign) {
            showPrefConfigStatus("Callsign is required.", "error");
            return;
          }

          prefConfigSendInFlight = true;
          if (prefConfigSendBtn) {
            prefConfigSendBtn.disabled = true;
            prefConfigSendBtn.textContent = "Sending…";
          }
          showPrefConfigStatus("");

          fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/send-preference-config", {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify({ callsign: callsign, teamLabel: teamLabel, roleLabel: roleLabel }),
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to send configuration");
                return body;
              });
            })
            .then(function (data) {
              var label = data.callsign || data.username || "client";
              showPrefConfigStatus("Configuration sent to " + label + ".", "success");
            })
            .catch(function (err) {
              showPrefConfigStatus(err.message || "Failed to send configuration", "error");
            })
            .finally(function () {
              prefConfigSendInFlight = false;
              if (prefConfigSendBtn) {
                prefConfigSendBtn.disabled = false;
                prefConfigSendBtn.textContent = "Send Configuration";
              }
            });
        }

        function showDataSyncStatus(msg, kind) {
          if (!dataSyncStatusEl) return;
          if (!msg) {
            dataSyncStatusEl.textContent = "";
            dataSyncStatusEl.style.display = "none";
            dataSyncStatusEl.className = "pref-config-status";
            return;
          }
          dataSyncStatusEl.textContent = msg;
          dataSyncStatusEl.style.display = "block";
          dataSyncStatusEl.className = "pref-config-status" + (kind === "error" ? " error" : kind === "success" ? " success" : "");
        }

        function setDataSyncLoading(on) {
          if (dataSyncLoadingEl) dataSyncLoadingEl.style.display = on ? "block" : "none";
          if (dataSyncFormEl) dataSyncFormEl.style.display = "block";
        }

        function loadDataSyncMissions(clientId) {
          if (!clientId) return Promise.reject(new Error("Missing client id"));
          setDataSyncLoading(true);
          showDataSyncStatus("");
          return fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/data-sync-missions", {
            headers: { Accept: "application/json" },
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to load missions");
                return body;
              });
            })
            .then(function (data) {
              setDataSyncLoading(false);
              var missions = Array.isArray(data.missions) ? data.missions : [];
              var options = missions.map(function (m) {
                var label = m.name || "";
                if (m.groupName) label += " — " + m.groupName;
                return { value: m.name, label: label };
              });
              fillSelectOptions(dataSyncMissionSelectEl, options, "", missions.length ? "Select mission…" : "No accessible missions");
              return data;
            })
            .catch(function (err) {
              setDataSyncLoading(false);
              showDataSyncStatus(err.message || "Failed to load missions", "error");
              throw err;
            });
        }

        function sendDataSyncInvite(clientId) {
          if (!clientId || dataSyncSendInFlight) return;
          var missionName = dataSyncMissionSelectEl ? String(dataSyncMissionSelectEl.value || "").trim() : "";
          if (!missionName) {
            showDataSyncStatus("Select a mission.", "error");
            return;
          }

          dataSyncSendInFlight = true;
          if (dataSyncSendBtn) {
            dataSyncSendBtn.disabled = true;
            dataSyncSendBtn.textContent = "Sending…";
          }
          showDataSyncStatus("");

          fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/send-data-sync-invite", {
            method: "POST",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify({ missionName: missionName }),
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to send invite");
                return body;
              });
            })
            .then(function (data) {
              var label = data.callsign || data.username || "client";
              showDataSyncStatus('Data Sync invite sent for "' + (data.missionName || missionName) + '" to ' + label + ".", "success");
            })
            .catch(function (err) {
              showDataSyncStatus(err.message || "Failed to send invite", "error");
            })
            .finally(function () {
              dataSyncSendInFlight = false;
              if (dataSyncSendBtn) {
                dataSyncSendBtn.disabled = false;
                dataSyncSendBtn.textContent = "Send Data Sync";
              }
            });
        }

        function showGroupControlError(msg) {
          if (!errorEl) return;
          if (msg) {
            errorEl.textContent = msg;
            errorEl.style.display = "block";
          } else {
            errorEl.textContent = "";
            errorEl.style.display = "none";
          }
        }

        function setGroupControlLoading(on) {
          if (loadingEl) loadingEl.style.display = on ? "block" : "none";
          if (tableWrap) tableWrap.style.display = "block";
        }

        function renderGroupControlRows(groups) {
          if (!tableBody) return;
          tableBody.innerHTML = "";
          (groups || []).forEach(function (g) {
            var tr = document.createElement("tr");
            tr.className = (g.active ? "group-control-row-active" : "group-control-row-inactive") + " group-control-row";
            tr.setAttribute("data-group-name", g.name || "");
            tr.setAttribute("data-access-mode", g.accessMode || g.typeLabel || "");

            if (g.locked) tr.setAttribute("data-locked", "true");
            if (g.locked && g.active) {
              tr.className += " group-control-row-locked";
            }

            var tdOn = document.createElement("td");
            var cb = document.createElement("input");
            cb.type = "checkbox";
            cb.checked = !!g.active;
            cb.className = "group-control-checkbox";
            if (g.locked && g.active) cb.disabled = true;
            cb.setAttribute("aria-label", "Enable " + groupControlDisplayName(g));
            tdOn.appendChild(cb);

            var tdName = document.createElement("td");
            tdName.textContent = groupControlDisplayName(g);

            tr.appendChild(tdOn);
            tr.appendChild(tdName);
            tableBody.appendChild(tr);
          });
        }

        function loadGroupControlState(clientId, opts) {
          opts = opts || {};
          if (!clientId) return Promise.reject(new Error("Missing client id"));
          if (opts.showLoading !== false) setGroupControlLoading(true);
          return fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/groups", {
            headers: { Accept: "application/json" },
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to load groups");
                return body;
              });
            })
            .then(function (data) {
              setGroupControlLoading(false);
              renderGroupControlRows(data.groups || []);
              return data;
            })
            .catch(function (err) {
              setGroupControlLoading(false);
              if (!opts.silent) showGroupControlError(err.message || "Failed to load groups");
              throw err;
            });
        }

        function closeClientGroupsModal(ev) {
          if (ev) {
            ev.preventDefault();
            ev.stopPropagation();
          }
          if (groupControlRefreshTimer) {
            clearInterval(groupControlRefreshTimer);
            groupControlRefreshTimer = null;
          }
          currentGroupControlClientId = null;
          showGroupControlError("");
          showPrefConfigStatus("");
          showDataSyncStatus("");
          setPrefConfigLoading(false);
          setDataSyncLoading(false);
          setPreferenceConfigVisible(false);
          setDataSyncSectionVisible(false);
          if (window.DashboardMiniMap) window.DashboardMiniMap.destroy();
          if (overlay) overlay.style.display = "none";
        }

        function openClientGroupsModal(sub) {
          if (!overlay || !sub) return;
          refreshGroupControlElements();

          var clientId = (sub.clientUid && String(sub.clientUid).trim()) || (sub.subscriptionUid && String(sub.subscriptionUid).trim()) || "";
          if (!clientId) return;

          currentGroupControlClientId = clientId;
          var username = (sub.username && String(sub.username).trim()) || "";
          var callsign = (sub.callsign && String(sub.callsign).trim()) || "";
          var titleParts = ["Connected User"];
          if (username) titleParts.push(username);
          if (callsign) titleParts.push(callsign);
          if (titleEl) titleEl.textContent = titleParts.join(" — ");
          showGroupControlError("");
          showPrefConfigStatus("");

          var canPreferenceConfig = isPreferenceConfigClient(sub);
          var canDataSync = isDataSyncClient(sub);
          setPreferenceConfigVisible(canPreferenceConfig);
          setDataSyncSectionVisible(canDataSync);
          setGroupControlLoading(true);
          if (canPreferenceConfig) setPrefConfigLoading(true);
          if (canDataSync) setDataSyncLoading(true);

          overlay.style.display = "flex";

          loadGroupControlState(clientId).catch(function () {});
          if (canPreferenceConfig) {
            loadPreferenceConfig(clientId).catch(function () {});
          }
          if (canDataSync) {
            loadDataSyncMissions(clientId).catch(function () {});
          }

          if (groupControlRefreshTimer) clearInterval(groupControlRefreshTimer);
          groupControlRefreshTimer = setInterval(function () {
            if (!currentGroupControlClientId || groupToggleInFlight) return;
            loadGroupControlState(currentGroupControlClientId, { showLoading: false, silent: true }).catch(function () {});
          }, GROUP_CONTROL_REFRESH_MS);

          if (window.DashboardMiniMap && callsign) {
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                if (!currentGroupControlClientId) return;
                window.DashboardMiniMap.open(clientId, callsign).catch(function () {});
              });
            });
          }
        }

        function applyGroupControlToggle(tr, active) {
          if (!tr || !currentGroupControlClientId || groupToggleInFlight) return;
          var cb = tr.querySelector(".group-control-checkbox");
          if (!cb || cb.disabled) return;
          if (tr.getAttribute("data-locked") === "true" && !active) {
            showGroupControlError("The only assigned group cannot be disabled.");
            return;
          }

          var groupName = tr.getAttribute("data-group-name") || "";
          var accessMode = tr.getAttribute("data-access-mode") || "";
          var previous = !active;

          cb.checked = active;
          groupToggleInFlight = true;
          cb.disabled = true;
          showGroupControlError("");

          fetch("/api/tak/clients/" + encodeURIComponent(currentGroupControlClientId) + "/groups", {
            method: "PUT",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify({ groupName: groupName, accessMode: accessMode, active: active }),
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to update group");
                return body;
              });
            })
            .then(function (data) {
              renderGroupControlRows(data.groups || []);
            })
            .catch(function (err) {
              cb.checked = previous;
              tr.className = (previous ? "group-control-row-active" : "group-control-row-inactive") + " group-control-row";
              showGroupControlError(err.message || "Failed to update group");
            })
            .finally(function () {
              cb.disabled = false;
              groupToggleInFlight = false;
            });
        }

        function onGroupControlCheckboxChange(e) {
          var cb = e.target;
          if (!cb || !cb.classList.contains("group-control-checkbox")) return;
          var tr = cb.closest("tr");
          if (!tr) return;
          applyGroupControlToggle(tr, cb.checked);
        }

        function onGroupControlRowClick(e) {
          var tr = e.target.closest("tr.group-control-row");
          if (!tr || !tableBody || !tableBody.contains(tr)) return;
          if (e.target.closest("input.group-control-checkbox")) return;
          var cb = tr.querySelector(".group-control-checkbox");
          if (!cb || cb.disabled) return;
          applyGroupControlToggle(tr, !cb.checked);
        }

        if (tableBody) {
          tableBody.addEventListener("change", onGroupControlCheckboxChange);
          tableBody.addEventListener("click", onGroupControlRowClick);
        }
        if (closeBtn) {
          closeBtn.addEventListener("click", function (e) {
            closeClientGroupsModal(e);
          });
        }
        if (prefConfigSendBtn) {
          prefConfigSendBtn.addEventListener("click", function () {
            if (!currentGroupControlClientId) return;
            sendPreferenceConfig(currentGroupControlClientId);
          });
        }
        if (dataSyncSendBtn) {
          dataSyncSendBtn.addEventListener("click", function () {
            if (!currentGroupControlClientId) return;
            sendDataSyncInvite(currentGroupControlClientId);
          });
        }
        if (overlay) {
          overlay.addEventListener("click", function (e) {
            if (e.target === overlay) {
              closeClientGroupsModal(e);
            }
          });
          // Prevent any clicks inside the modal content from toggling the card
          var modalEl = overlay.querySelector(".modal");
          if (modalEl) {
            modalEl.addEventListener("click", function (e) {
              e.stopPropagation();
            });
          }
        }

        // Row click -> open modal with that subscription's groups
        var tbody = document.getElementById("connectedClientsTableBody");
        if (tbody) {
          tbody.addEventListener("click", function (e) {
            var tr = e.target.closest("tr");
            if (!tr) return;
            e.stopPropagation();
            var uid = tr.getAttribute("data-client-uid");
            if (!uid || !latestSubscriptions.length) return;
            var sub = latestSubscriptions.find(function (s) {
              return String(s.clientUid) === uid || String(s.subscriptionUid) === uid;
            });
            if (!sub) return;
            openClientGroupsModal(sub);
          });
        }

        if (expandedRefreshTimer) clearInterval(expandedRefreshTimer);
        expandedRefreshTimer = setInterval(function () {
          if (!card.classList.contains("connected-clients-expanded-card")) return;
          fetch("/api/tak/subscriptions", { headers: { Accept: "application/json" } })
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (!data.configured || !Array.isArray(data.data)) return;
              var list = data.data.filter(function (item) {
                return !isExcludedConnectedClient(item);
              });
              var nextRows = list.map(function (item) {
                return {
                  callsign: item.callsign != null ? String(item.callsign).trim() : "",
                  username: item.username != null ? String(item.username).trim() : "",
                  takClient: item.takClient != null ? String(item.takClient).trim() || "—" : "—",
                  battery: item.battery != null ? String(item.battery).trim() : "",
                  role: item.role != null ? String(item.role).trim() || "—" : "—",
                  team: item.team != null ? String(item.team).trim() : "",
                  subscriptionUid: item.subscriptionUid != null ? String(item.subscriptionUid).trim() : "",
                  clientUid: item.clientUid != null ? String(item.clientUid).trim() : ""
                };
              });
              setConnectedClientsData(nextRows, list);
            })
            .catch(function () {});
        }, EXPANDED_REFRESH_MS);
      }

      function collapse() {
        if (window.DashboardMiniMap) window.DashboardMiniMap.destroy();
        if (expandedRefreshTimer) {
          clearInterval(expandedRefreshTimer);
          expandedRefreshTimer = null;
        }
        if (groupControlRefreshTimer) {
          clearInterval(groupControlRefreshTimer);
          groupControlRefreshTimer = null;
        }
        currentGroupControlClientId = null;
        card.innerHTML = originalCardHtml;
        card.classList.remove("connected-clients-expanded-card");
        row.classList.remove("connected-clients-row-expanded");
        // Reapply latest known metrics so the compact card shows the up-to-date value.
        var cc = typeof window.__latestConnectedClients === "string" ? window.__latestConnectedClients : null;
        var ciVal = typeof window.__latestConnectedIntegrations === "string" ? window.__latestConnectedIntegrations : null;
        var ccEl = document.getElementById("takClients");
        if (ccEl && cc != null) ccEl.textContent = cc;
        var ciEl = document.getElementById("takConnectedIntegrations");
        if (ciEl && ciVal != null) ciEl.textContent = ciVal;
      }

      card.style.cursor = "pointer";
      function tryExpand() {
        if (card.classList.contains("connected-clients-expanded-card")) return;
        card.querySelector(".statValue").textContent = "…";
        fetch("/api/tak/subscriptions", { headers: { Accept: "application/json" } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (!data.configured || !Array.isArray(data.data)) {
              collapse();
              return;
            }
            var list = data.data.filter(function (item) {
              return !isExcludedConnectedClient(item);
            });
            var rows = list.map(function (item) {
              return {
                callsign: item.callsign != null ? String(item.callsign).trim() : "",
                username: item.username != null ? String(item.username).trim() : "",
                takClient: item.takClient != null ? String(item.takClient).trim() || "—" : "—",
                battery: item.battery != null ? String(item.battery).trim() : "",
                role: item.role != null ? String(item.role).trim() || "—" : "—",
                team: item.team != null ? String(item.team).trim() : "",
                subscriptionUid: item.subscriptionUid != null ? String(item.subscriptionUid).trim() : "",
                clientUid: item.clientUid != null ? String(item.clientUid).trim() : ""
              };
            });
            renderExpandedView(rows, list);
          })
          .catch(function () { collapse(); });
      }
      card.addEventListener("click", function (e) {
        if (card.classList.contains("connected-clients-expanded-card")) {
          collapse();
          return;
        }
        tryExpand();
      });
      card.addEventListener("keydown", function (e) {
        if (card.classList.contains("connected-clients-expanded-card")) {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            collapse();
          }
          return;
        }
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          tryExpand();
        }
      });

      window.__dashboardTakRefresh = function () {
        fetch("/api/tak/metrics", { headers: { Accept: "application/json" } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            // Reuse the same smoothing logic used by the polling script
            if (typeof window.__takApplyDashboardMetrics === "function") {
              window.__takApplyDashboardMetrics(data);
            } else {
              var el = document.getElementById("takClients");
              var cc = data && typeof data.connectedClients === "number" ? String(data.connectedClients) : "--";
              if (el) el.textContent = cc;
              window.__latestConnectedClients = cc;
              var ci = document.getElementById("takConnectedIntegrations");
              var ciVal = data && typeof data.connectedIntegrations === "number" ? String(data.connectedIntegrations) : "--";
              if (ci) ci.textContent = ciVal;
              window.__latestConnectedIntegrations = ciVal;
              var disk = document.getElementById("takDisk");
              if (disk) disk.textContent = data && typeof data.diskUsagePercent === "number" ? (data.diskUsagePercent < 10 ? data.diskUsagePercent.toFixed(1).replace(/\.0$/, "") : String(Math.round(data.diskUsagePercent))) : "--";
              var up = document.getElementById("takUptime");
              if (up && data && typeof data.uptimeSeconds === "number") {
                var s = Math.max(0, Math.floor(data.uptimeSeconds));
                var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
                var parts = [];
                if (d) parts.push(d + "d");
                if (h || d) parts.push(h + "h");
                if (s < 86400) parts.push(m + "m");
                up.textContent = parts.join(" ");
              }
            }
          }).catch(function () {});
      };
    })();
  </script>

