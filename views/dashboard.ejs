<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Dashboard",
    scopedSuffix: "Dashboard",
    singleFallbackTitle: "Agency Dashboard",
    singleAgencyCustomTitle:
      typeof agencyDisplayName !== "undefined" && agencyDisplayName
        ? String(agencyDisplayName) + " Dashboard"
        : "",
    useGlobalServerPrefix: true
  }) %>

  <% 
    const hasMutualAid = isGlobalAdmin && mutualAid && (mutualAid.activeIncidents > 0 || mutualAid.activeEvents > 0);
    const hasUserRequests = typeof pendingUserRequestsCount !== "undefined" && pendingUserRequestsCount > 0;
    const hasPendingMouDocs =
      !!(typeof isAgencyDashboard !== "undefined" && isAgencyDashboard) &&
      typeof pendingMouDocumentsCount !== "undefined" &&
      pendingMouDocumentsCount > 0;
  %>

  <% if (hasMutualAid || hasUserRequests || hasPendingMouDocs) { %>
    <div style="margin: 10px 0 14px 0;">

      <!-- Mutual Aid Incident -->
      <% if (isGlobalAdmin && mutualAid && mutualAid.activeIncidents > 0) { %>
        <% if (isGlobalAdmin) { %>
          <a href="/mutual-aid" style="text-decoration:none;">
        <% } %>

        <div class="maBanner maBannerIncident">
          <%= mutualAid.activeIncidents %> Mutual Aid Incident<%= mutualAid.activeIncidents === 1 ? "" : "s" %> 
          <%= mutualAid.activeIncidents === 1 ? "Is" : "Are" %> Active
        </div>

        <% if (isGlobalAdmin || isAgencyAdmin) { %>
          </a>
        <% } %>
      <% } %>

      <!-- Mutual Aid Event -->
      <% if (isGlobalAdmin && mutualAid && mutualAid.activeEvents > 0) { %>
        <% if (isGlobalAdmin) { %>
          <a href="/mutual-aid" style="text-decoration:none;">
        <% } %>

        <div class="maBanner maBannerEvent">
          <%= mutualAid.activeEvents %> Mutual Aid Event<%= mutualAid.activeEvents === 1 ? "" : "s" %> 
          <%= mutualAid.activeEvents === 1 ? "Is" : "Are" %> Active
        </div>

        <% if (isGlobalAdmin || isAgencyAdmin) { %>
          </a>
        <% } %>
      <% } %>

      <!-- Pending User Requests -->
      <% if (hasUserRequests) { %>
        <% if (isGlobalAdmin || isAgencyAdmin) { %>
          <a href="/pending-user-requests" style="text-decoration:none;">
        <% } %>

        <div class="userReqBanner">
          <%= pendingUserRequestsCount %> Pending User Request<%= pendingUserRequestsCount === 1 ? "" : "s" %>
        </div>

        <% if (isGlobalAdmin || isAgencyAdmin) { %>
          </a>
        <% } %>
      <% } %>

      <!-- Pending MOU Signatures -->
      <% if (hasPendingMouDocs) { %>
        <a href="/mou" style="text-decoration:none;">
          <div class="mouPendingBanner">
            <%= pendingMouDocumentsCount %> Document<%= pendingMouDocumentsCount === 1 ? "" : "s" %> Awaiting Signature
          </div>
        </a>
      <% } %>

    </div>
  <% } %>

  <% if (typeof error !== "undefined" && error) { %>
    <div class="card">
      <div class="msg bad"><%= typeof error === "string" ? error : JSON.stringify(error) %></div>
    </div>
  <% } %>

  <!-- Top stats -->
  <% const agencyDash = typeof isAgencyDashboard !== "undefined" && isAgencyDashboard; %>
  <% const multiAgencyDash = agencyDash && typeof isMultiAgencyDashboard !== "undefined" && isMultiAgencyDashboard; %>
  <div class="<%= multiAgencyDash ? 'grid3' : (agencyDash ? 'grid2 dashboardAgencyStats' : 'grid3') %>">
    <a href="/users/manage" class="statCardLink">
      <div class="card stat">
        <div class="statLabel">Total Users</div>
        <div class="statValue"><%= stats.totalUsers %></div>
        <div class="statHint"></div>
      </div>
    </a>

    <% if (multiAgencyDash) { %>
    <div class="card stat">
      <div class="statLabel">Managed Agencies</div>
      <div class="statValue"><%= stats.totalAgencies %></div>
      <div class="statHint"></div>
    </div>
    <% } else if (!agencyDash) { %>
    <% if (isGlobalAdmin) { %>
    <a href="/agencies" class="statCardLink">
    <% } %>
    <div class="card stat">
      <div class="statLabel">Total Agencies</div>
      <div class="statValue"><%= stats.totalAgencies %></div>
      <div class="statHint"></div>
    </div>
    <% if (isGlobalAdmin) { %>
    </a>
    <% } %>
    <% } %>

    <a href="/groups" class="statCardLink">
      <div class="card stat">
        <div class="statLabel">Total Groups / Channels</div>
        <div class="statValue"><%= stats.totalGroups %></div>
        <div class="statHint"></div>
      </div>
    </a>
  </div>

  <!-- TAK stats row: 4-wide global; agency admin shows connected users only -->
  <div class="<%= agencyDash ? 'gridTakStatsAgencyOnly' : 'gridTakStats' %> gridTight" id="takStatsRow" style="margin-top:8px;" <%= (isGlobalAdmin || isAgencyAdmin) ? 'data-can-expand-clients="true"' : '' %>>
    <div class="card stat" id="connectedClientsStatCard" role="<%= (isGlobalAdmin || isAgencyAdmin) ? 'button' : '' %>" tabindex="<%= (isGlobalAdmin || isAgencyAdmin) ? '0' : '-1' %>">
      <div class="statLabel">Connected Users</div>
      <div class="statValue" id="takClients">--</div>
      <div class="statHint"></div>
    </div>

    <% if (isGlobalAdmin) { %>
    <a href="/integrations" class="statCardLink">
    <div class="card stat">
      <div class="statLabel">Connected Integrations</div>
      <div class="statValue" id="takConnectedIntegrations">--</div>
      <div class="statHint"></div>
    </div>
    </a>
    <% } %>

    <% if (!agencyDash) { %>
    <div class="card stat">
      <div class="statLabel">TAK Server Uptime</div>
      <div class="statValue" id="takUptime">--</div>
      <div class="statHint" id="takUptimeHint"></div>
    </div>

    <div class="card stat">
      <div class="statLabel">Disk Usage %</div>
      <div class="statValue" id="takDisk">--</div>
      <div class="statHint"></div>
    </div>
    <% } %>
  </div>

  <% if (multiAgencyDash) { %>
  <div class="grid2 gridTight" style="margin-top:8px;">
    <div class="card">
      <h2 class="cardTitle">Users by Agency</h2>
      <div class="chartWrap">
        <canvas id="agencyChart"></canvas>
      </div>
    </div>
    <div class="card">
      <h2 class="cardTitle">Users by Template</h2>
      <div class="chartWrap">
        <canvas id="templateChart"></canvas>
      </div>
    </div>
  </div>
  <% } else if (agencyDash) { %>
  <div class="grid1 gridTight" style="margin-top:8px;">
    <div class="card">
      <h2 class="cardTitle">Users by Template</h2>
      <div class="chartWrap">
        <canvas id="templateChart"></canvas>
      </div>
    </div>
  </div>
  <% } else { %>
  <!-- Two pies side by side -->
  <div class="grid2 gridTight" style="margin-top:8px;">
    <div class="card">
      <h2 class="cardTitle">Users by Agency</h2>
      <div class="chartWrap">
        <canvas id="agencyChart"></canvas>
      </div>
    </div>

    <div class="card">
      <h2 class="cardTitle">Users by Type</h2>
      <div class="chartWrap">
        <canvas id="typeChart"></canvas>
      </div>
    </div>
  </div>
  <% } %>

  <% if (isGlobalAdmin) { %>
    <div class="card" style="margin-top:8px;">
      <h2>Bookmarks</h2>
      <div class="row" style="flex-wrap:wrap; gap:10px;">
        <% (bookmarks || []).forEach(function(bm) { %>
          <a class="btn" href="<%= bm.url %>" target="_blank" rel="noopener noreferrer">
            <%= bm.title %>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <script>
    (function() {
      const IS_AGENCY_DASHBOARD = <%- JSON.stringify(!!(typeof isAgencyDashboard !== "undefined" && isAgencyDashboard)) %>;
      const IS_MULTI_AGENCY_DASHBOARD = <%- JSON.stringify(!!(typeof isMultiAgencyDashboard !== "undefined" && isMultiAgencyDashboard)) %>;

      function initCharts() {
        var agencyColorNameToHex = {
          "Blue": "#1e88e5",
          "Dark Blue": "#0d47a1",
          "Brown": "#6d4c41",
          "Cyan": "#00acc1",
          "Green": "#43a047",
          "Dark Green": "#1b5e20",
          "Magenta": "#d81b60",
          "Maroon": "#800000",
          "Orange": "#ff7b00",
          "Purple": "#8e24aa",
          "Red": "#e53935",
          "Teal": "#00897b",
          "White": "#ffffff",
          "Yellow": "#fdd835"
        };
        const defaultColor = "#9ca3af";
        function resolveColor(c) {
          if (!c || typeof c !== "string") return defaultColor;
          const raw = c.trim();
          if (!raw) return defaultColor;
          if (raw.charAt(0) === "#") return raw;
          return agencyColorNameToHex[raw] || agencyColorNameToHex[raw.toLowerCase()] || raw;
        }
        const pieOptions = {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: "bottom",
              labels: { boxWidth: 14, boxHeight: 14, padding: 12, font: { size: 15 } }
            }
          }
        };
        const templateChartPalette = [
          "#1e88e5", "#43a047", "#e53935", "#8e24aa", "#ff7b00", "#00acc1",
          "#6d4c41", "#d81b60", "#0d47a1", "#1b5e20", "#800000", "#fdd835",
          "#00897b", "#5e35b1", "#f4511e", "#26a69a", "#7cb342", "#ec407a",
          "#ab47bc", "#29b6f6", "#8d6e63", "#78909c", "#ff7043", "#9ccc65"
        ];
        function chartPaletteColors(count, baseColor) {
          if (count <= 0) return [];
          if (count === 1 && baseColor) return [baseColor];
          const colors = [];
          for (var i = 0; i < count; i++) {
            if (i < templateChartPalette.length) {
              colors.push(templateChartPalette[i]);
            } else {
              var hue = Math.round((i * 137.508) % 360);
              colors.push("hsl(" + hue + ", 62%, 50%)");
            }
          }
          return colors;
        }

        if (IS_AGENCY_DASHBOARD) {
          const usersByTemplate = <%- JSON.stringify((charts && charts.usersByTemplate) || {}) %>;
          const templateChartColor = <%- JSON.stringify(typeof templateChartColor !== "undefined" ? templateChartColor : null) %>;
          const baseColor = resolveColor(templateChartColor);
          const templateLabels = Object.keys(usersByTemplate);
          const templateData = Object.values(usersByTemplate);

          if (IS_MULTI_AGENCY_DASHBOARD) {
            const usersByAgency = <%- JSON.stringify((charts && charts.usersByAgency) || {}) %>;
            const agencyColors = <%- JSON.stringify(typeof agencyColors !== "undefined" ? agencyColors : {}) %>;
            const agencyLabels = Object.keys(usersByAgency);
            const agencyData = Object.values(usersByAgency);
            const agencyBackgroundColors = agencyLabels.map(function(label) {
              return resolveColor(agencyColors[label]);
            });
            new Chart(document.getElementById("agencyChart"), {
              type: "pie",
              data: {
                labels: agencyLabels,
                datasets: [{
                  data: agencyData,
                  backgroundColor: agencyBackgroundColors,
                  borderColor: "#ffffff",
                  borderWidth: 2
                }]
              },
              options: pieOptions
            });
          }

          new Chart(document.getElementById("templateChart"), {
            type: "pie",
            data: {
              labels: templateLabels,
              datasets: [{
                data: templateData,
                backgroundColor: chartPaletteColors(templateLabels.length, baseColor),
                borderColor: "#ffffff",
                borderWidth: 2
              }]
            },
            options: pieOptions
          });
          return;
        }

        const usersByAgency = <%- JSON.stringify((charts && charts.usersByAgency) || {}) %>;
        const unknownAgency = <%- JSON.stringify((charts && charts.unknownAgency) || 0) %>;
        const agencyColors = <%- JSON.stringify(typeof agencyColors !== "undefined" ? agencyColors : {}) %>;
        const defaultAgencyColor = "#9ca3af";

        const agencyLabels = Object.keys(usersByAgency);
        const agencyData = Object.values(usersByAgency);
        if (unknownAgency > 0) { agencyLabels.push("Unknown"); agencyData.push(unknownAgency); }

        const agencyBackgroundColors = agencyLabels.map(function(label) {
          const c = agencyColors[label];
          if (!c || typeof c !== "string") return defaultAgencyColor;
          const raw = c.trim();
          if (!raw) return defaultAgencyColor;
          if (raw.charAt(0) === "#") return raw;
          return agencyColorNameToHex[raw] || agencyColorNameToHex[raw.toLowerCase()] || raw;
        });

        new Chart(document.getElementById("agencyChart"), {
          type: "pie",
          data: {
            labels: agencyLabels,
            datasets: [{
              data: agencyData,
              backgroundColor: agencyBackgroundColors,
              borderColor: "#ffffff",
              borderWidth: 2
            }]
          },
          options: pieOptions
        });

        const usersByType = <%- JSON.stringify((charts && charts.usersByType) || {}) %>;
        const unknownType = <%- JSON.stringify((charts && charts.unknownType) || 0) %>;

        const typeLabels = Object.keys(usersByType);
        const typeData = Object.values(usersByType);
        if (unknownType > 0) { typeLabels.push("Unknown"); typeData.push(unknownType); }

        const typeColors = <%- JSON.stringify(typeof typeColors !== "undefined" ? typeColors : {}) %>;
        const typeBackgroundColors = typeLabels.map(function(label) {
          const c = typeColors[label];
          if (!c || typeof c !== "string") return defaultAgencyColor;
          const raw = c.trim();
          if (!raw) return defaultAgencyColor;
          if (raw.charAt(0) === "#") return raw;
          return agencyColorNameToHex[raw] || agencyColorNameToHex[raw.toLowerCase()] || defaultAgencyColor;
        });

        new Chart(document.getElementById("typeChart"), {
          type: "pie",
          data: {
            labels: typeLabels,
            datasets: [{
              data: typeData,
              backgroundColor: typeBackgroundColors,
              borderColor: "#ffffff",
              borderWidth: 2
            }]
          },
          options: pieOptions
        });
      }

      function loadChartJsAndInit() {
        if (window.Chart) return initCharts();
        var cdnScript = document.createElement("script");
        cdnScript.src = "https://cdn.jsdelivr.net/npm/chart.js";
        cdnScript.onload = initCharts;
        document.head.appendChild(cdnScript);
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadChartJsAndInit);
      } else {
        loadChartJsAndInit();
      }
    })();
  </script>

  <script>
    (function(){
      const $ = (id) => document.getElementById(id);
      const IS_AGENCY_DASHBOARD_TAK = <%- JSON.stringify(!!(typeof isAgencyDashboard !== "undefined" && isAgencyDashboard)) %>;
      window.__latestConnectedClients = window.__latestConnectedClients || null;
      window.__latestConnectedIntegrations = window.__latestConnectedIntegrations || null;

      // Disk formatting:
      // < 10 => 1 decimal (trim trailing .0), >= 10 => integer
      function fmtPct(n){
        if (typeof n !== "number" || !isFinite(n)) return "--";
        if (n < 10) return n.toFixed(1).replace(/\.0$/, "");
        return String(Math.round(n));
      }

      function fmtUptime(seconds){
        if (typeof seconds !== "number" || !isFinite(seconds)) return "--";
        const s = Math.max(0, Math.floor(seconds));
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const parts = [];
        if (d) parts.push(d + "d");
        if (h || d) parts.push(h + "h");
        if (s < 86400) parts.push(m + "m");
        return parts.join(" ");
      }

      function apply(data){
        // Preserve previous values when new data is briefly missing or zero,
        // to avoid flickering 60 → 0 → 60 during sampling gaps.
        var prevCcStr = typeof window.__latestConnectedClients === "string" ? window.__latestConnectedClients : null;
        var prevCiStr = typeof window.__latestConnectedIntegrations === "string" ? window.__latestConnectedIntegrations : null;

        var diskEl = $("takDisk");
        if (diskEl) {
          var nextDisk = data && typeof data.diskUsagePercent === "number" ? data.diskUsagePercent : null;
          diskEl.textContent = fmtPct(nextDisk);
        }

        var rawCc = data && typeof data.connectedClients === "number" ? data.connectedClients : null;
        var rawCi = data && typeof data.connectedIntegrations === "number" ? data.connectedIntegrations : null;

        var ccStr;
        if (rawCc === null || !isFinite(rawCc)) {
          ccStr = prevCcStr || "--";
        } else if (
          !IS_AGENCY_DASHBOARD_TAK &&
          rawCc === 0 &&
          prevCcStr &&
          isFinite(Number(prevCcStr)) &&
          Number(prevCcStr) > 0
        ) {
          ccStr = prevCcStr;
        } else {
          ccStr = String(rawCc);
        }

        var ciStr;
        if (rawCi === null || !isFinite(rawCi)) {
          ciStr = prevCiStr || "--";
        } else if (
          !IS_AGENCY_DASHBOARD_TAK &&
          rawCi === 0 &&
          prevCiStr &&
          isFinite(Number(prevCiStr)) &&
          Number(prevCiStr) > 0
        ) {
          ciStr = prevCiStr;
        } else {
          ciStr = String(rawCi);
        }

        $("takClients").textContent = ccStr;
        window.__latestConnectedClients = ccStr;

        var ciEl = document.getElementById("takConnectedIntegrations");
        if (ciEl) ciEl.textContent = ciStr;
        window.__latestConnectedIntegrations = ciStr;

        var uptimeEl = $("takUptime");
        if (uptimeEl) uptimeEl.textContent = fmtUptime(data && data.uptimeSeconds);
        var uptimeHintEl = $("takUptimeHint");
        if (uptimeHintEl) uptimeHintEl.textContent = "";
      }

      async function refresh(){
        try{
          const res = await fetch("/api/tak/metrics", { headers: { "Accept": "application/json" } });
          if (!res.ok) throw new Error("HTTP " + res.status);
          const data = await res.json();
          apply(data);
        }catch(e){
          // no "Connected"/status pill on this page; just leave values as-is
        }
      }

      // Initial render from server-side snapshot
      const initial = <%- JSON.stringify(takMetrics || null) %>;
      if (initial) apply(initial);
      // Expose smoothing-aware updater for other scripts (manual refresh, etc.)
      window.__takApplyDashboardMetrics = apply;

      // Delay the first health check until after full page load, then +5s.
      // Then poll every 20s.
      function startTakPolling() {
        setTimeout(async () => {
          await refresh();
          setInterval(refresh, 20000);
        }, 5000);
      }

      if (document.readyState === "complete") {
        startTakPolling();
      } else {
        window.addEventListener("load", startTakPolling, { once: true });
      }
    })();
  </script>

  <script>
    (function () {
      var row = document.getElementById("takStatsRow");
      var card = document.getElementById("connectedClientsStatCard");
      if (!row || !card || !row.getAttribute("data-can-expand-clients")) return;

      var NODERED_PREFIX = "nodered-";
      var TLS_CALLSIGN_PREFIX = "tls:";

      function isExcludedConnectedClient(item) {
        var u = (item.username != null ? String(item.username).trim() : "").toLowerCase();
        if (u.indexOf(NODERED_PREFIX) === 0) return true;
        var c = (item.callsign != null ? String(item.callsign).trim() : "").toLowerCase();
        return c.indexOf(TLS_CALLSIGN_PREFIX) === 0;
      }

      var TEAM_COLORS = {
        "Blue": "#1e88e5", "Dark Blue": "#0d47a1", "Brown": "#6d4c41", "Cyan": "#00acc1",
        "Green": "#43a047", "Dark Green": "#1b5e20", "Magenta": "#d81b60", "Maroon": "#800000",
        "Orange": "#ff7b00", "Purple": "#8e24aa", "Red": "#e53935", "Teal": "#00897b",
        "White": "#ffffff", "Yellow": "#fdd835"
      };

      var originalCardHtml = card.innerHTML;
      var expandedRefreshTimer = null;
      var groupControlRefreshTimer = null;
      var EXPANDED_REFRESH_MS = 20000;
      var GROUP_CONTROL_REFRESH_MS = 8000;
      var currentGroupControlClientId = null;

      function esc(s) {
        if (s == null || s === "") return "";
        var div = document.createElement("div");
        div.textContent = s;
        return div.innerHTML;
      }

      function teamToBg(team) {
        if (!team) return "transparent";
        var hex = TEAM_COLORS[team];
        return hex ? hex + "33" : "transparent";
      }

      var latestSubscriptions = [];

      function batteryCell(value) {
        var s = value != null ? String(value).trim() : "";
        return s ? esc(s) : "—";
      }

      function fillExpandedTableBody(rows, rawItems) {
        latestSubscriptions = Array.isArray(rawItems) ? rawItems.slice() : [];
        var tbody = document.getElementById("connectedClientsTableBody");
        if (!tbody) return;
        tbody.innerHTML = "";
        (rows || []).forEach(function (r) {
          var tr = document.createElement("tr");
          if (r.clientUid || r.subscriptionUid) {
            tr.setAttribute("data-client-uid", r.clientUid || r.subscriptionUid);
          }
          var bg = teamToBg(r.team);
          if (bg !== "transparent") tr.style.backgroundColor = bg;
          tr.innerHTML = "<td>" + esc(r.callsign) + "</td><td>" + esc(r.username) + "</td><td>" + esc(r.takClient) + "</td><td>" + batteryCell(r.battery) + "</td><td>" + esc(r.role) + "</td>";
          tbody.appendChild(tr);
        });
      }

      function renderExpandedView(rows, rawItems) {
        var html = '<div class="connected-clients-expanded">' +
          '<div class="connected-clients-expanded-header">' +
          '<h2 class="cardTitle">Connected Users</h2>' +
          '<button type="button" class="btn" id="connectedClientsCloseBtn">Close</button>' +
          '</div>' +
          '<div class="connected-clients-table-wrap"><table class="connected-clients-table">' +
          '<thead><tr><th>Callsign</th><th>Username</th><th>TAK Client</th><th>Battery</th><th>Role</th></tr></thead>' +
          '<tbody id="connectedClientsTableBody"></tbody></table></div></div>' +
          '<div class="modalOverlay" id="clientGroupsOverlay" style="display:none;">' +
            '<div class="modal group-control-modal" role="dialog" aria-modal="true" aria-labelledby="clientGroupsTitle">' +
              '<div class="modalHeader">' +
                '<h2 id="clientGroupsTitle" style="margin:0;">Group Control</h2>' +
                '<button class="btn" id="clientGroupsCloseBtn" type="button">Close</button>' +
              '</div>' +
              '<div class="modalBody">' +
                '<div id="clientGroupsError" class="msg error" style="display:none; margin-bottom:10px;"></div>' +
                '<div id="clientGroupsLoading" class="muted" style="display:none;">Loading groups…</div>' +
                '<div class="group-control-table-wrap" id="clientGroupsTableWrap" style="display:none;">' +
                  '<table class="group-control-table">' +
                    '<thead><tr><th>Enabled</th><th>Group</th></tr></thead>' +
                    '<tbody id="clientGroupsTableBody"></tbody>' +
                  '</table>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>';
        card.innerHTML = html;
        card.classList.add("connected-clients-expanded-card");
        row.classList.add("connected-clients-row-expanded");
        fillExpandedTableBody(rows, rawItems);
        document.getElementById("connectedClientsCloseBtn").addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          collapse();
        });
        // Wire up modal behavior
        var overlay = document.getElementById("clientGroupsOverlay");
        var closeBtn = document.getElementById("clientGroupsCloseBtn");
        var tableBody = document.getElementById("clientGroupsTableBody");
        var tableWrap = document.getElementById("clientGroupsTableWrap");
        var loadingEl = document.getElementById("clientGroupsLoading");
        var errorEl = document.getElementById("clientGroupsError");
        var titleEl = document.getElementById("clientGroupsTitle");
        var groupToggleInFlight = false;

        function groupControlDisplayName(g) {
          if (!g) return "—";
          if (g.displayName) return g.displayName;
          var name = g.name || "";
          var mode = String(g.accessMode || g.typeLabel || "").toUpperCase();
          if (mode === "READ") return name + "_READ";
          if (mode === "WRITE") return name + "_WRITE";
          return name || "—";
        }

        function showGroupControlError(msg) {
          if (!errorEl) return;
          if (msg) {
            errorEl.textContent = msg;
            errorEl.style.display = "block";
          } else {
            errorEl.textContent = "";
            errorEl.style.display = "none";
          }
        }

        function setGroupControlLoading(on) {
          if (loadingEl) loadingEl.style.display = on ? "block" : "none";
          if (tableWrap) tableWrap.style.display = on ? "none" : "block";
        }

        function renderGroupControlRows(groups) {
          if (!tableBody) return;
          tableBody.innerHTML = "";
          (groups || []).forEach(function (g) {
            var tr = document.createElement("tr");
            tr.className = g.active ? "group-control-row-active" : "group-control-row-inactive";
            tr.setAttribute("data-group-name", g.name || "");
            tr.setAttribute("data-access-mode", g.accessMode || g.typeLabel || "");

            var tdOn = document.createElement("td");
            var cb = document.createElement("input");
            cb.type = "checkbox";
            cb.checked = !!g.active;
            cb.className = "group-control-checkbox";
            cb.setAttribute("aria-label", "Enable " + groupControlDisplayName(g));
            tdOn.appendChild(cb);

            var tdName = document.createElement("td");
            tdName.textContent = groupControlDisplayName(g);

            tr.appendChild(tdOn);
            tr.appendChild(tdName);
            tableBody.appendChild(tr);
          });
        }

        function loadGroupControlState(clientId, opts) {
          opts = opts || {};
          if (!clientId) return Promise.reject(new Error("Missing client id"));
          if (opts.showLoading !== false) setGroupControlLoading(true);
          return fetch("/api/tak/clients/" + encodeURIComponent(clientId) + "/groups", {
            headers: { Accept: "application/json" },
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to load groups");
                return body;
              });
            })
            .then(function (data) {
              setGroupControlLoading(false);
              renderGroupControlRows(data.groups || []);
              return data;
            })
            .catch(function (err) {
              setGroupControlLoading(false);
              if (!opts.silent) showGroupControlError(err.message || "Failed to load groups");
              throw err;
            });
        }

        function closeClientGroupsModal(ev) {
          if (ev) {
            ev.preventDefault();
            ev.stopPropagation();
          }
          if (groupControlRefreshTimer) {
            clearInterval(groupControlRefreshTimer);
            groupControlRefreshTimer = null;
          }
          currentGroupControlClientId = null;
          showGroupControlError("");
          if (overlay) overlay.style.display = "none";
        }

        function openClientGroupsModal(sub) {
          if (!overlay || !sub) return;

          var clientId = (sub.clientUid && String(sub.clientUid).trim()) || (sub.subscriptionUid && String(sub.subscriptionUid).trim()) || "";
          if (!clientId) return;

          currentGroupControlClientId = clientId;
          var callsign = (sub.callsign && String(sub.callsign).trim()) || "";
          var username = (sub.username && String(sub.username).trim()) || "";
          var label = callsign || username || "Client";

          if (titleEl) titleEl.textContent = "Group Control — " + label;
          showGroupControlError("");
          overlay.style.display = "flex";

          loadGroupControlState(clientId).catch(function () {});

          if (groupControlRefreshTimer) clearInterval(groupControlRefreshTimer);
          groupControlRefreshTimer = setInterval(function () {
            if (!currentGroupControlClientId || groupToggleInFlight) return;
            loadGroupControlState(currentGroupControlClientId, { showLoading: false, silent: true }).catch(function () {});
          }, GROUP_CONTROL_REFRESH_MS);
        }

        function onGroupControlCheckboxChange(e) {
          var cb = e.target;
          if (!cb || !cb.classList.contains("group-control-checkbox")) return;
          var tr = cb.closest("tr");
          if (!tr || !currentGroupControlClientId) return;

          var groupName = tr.getAttribute("data-group-name") || "";
          var accessMode = tr.getAttribute("data-access-mode") || "";
          var active = cb.checked;
          var previous = !active;

          groupToggleInFlight = true;
          cb.disabled = true;
          showGroupControlError("");

          fetch("/api/tak/clients/" + encodeURIComponent(currentGroupControlClientId) + "/groups", {
            method: "PUT",
            headers: { Accept: "application/json", "Content-Type": "application/json" },
            body: JSON.stringify({ groupName: groupName, accessMode: accessMode, active: active }),
          })
            .then(function (res) {
              return res.json().then(function (body) {
                if (!res.ok) throw new Error((body && body.error) || "Failed to update group");
                return body;
              });
            })
            .then(function (data) {
              renderGroupControlRows(data.groups || []);
            })
            .catch(function (err) {
              cb.checked = previous;
              tr.className = previous ? "group-control-row-active" : "group-control-row-inactive";
              showGroupControlError(err.message || "Failed to update group");
            })
            .finally(function () {
              cb.disabled = false;
              groupToggleInFlight = false;
            });
        }

        if (tableBody) {
          tableBody.addEventListener("change", onGroupControlCheckboxChange);
        }
        if (closeBtn) {
          closeBtn.addEventListener("click", function (e) {
            closeClientGroupsModal(e);
          });
        }
        if (overlay) {
          overlay.addEventListener("click", function (e) {
            if (e.target === overlay) {
              closeClientGroupsModal(e);
            }
          });
          // Prevent any clicks inside the modal content from toggling the card
          var modalEl = overlay.querySelector(".modal");
          if (modalEl) {
            modalEl.addEventListener("click", function (e) {
              e.stopPropagation();
            });
          }
        }

        // Row click -> open modal with that subscription's groups
        var tbody = document.getElementById("connectedClientsTableBody");
        if (tbody) {
          tbody.addEventListener("click", function (e) {
            var tr = e.target.closest("tr");
            if (!tr) return;
            e.stopPropagation();
            var uid = tr.getAttribute("data-client-uid");
            if (!uid || !latestSubscriptions.length) return;
            var sub = latestSubscriptions.find(function (s) {
              return String(s.clientUid) === uid || String(s.subscriptionUid) === uid;
            });
            if (!sub) return;
            openClientGroupsModal(sub);
          });
        }

        if (expandedRefreshTimer) clearInterval(expandedRefreshTimer);
        expandedRefreshTimer = setInterval(function () {
          if (!card.classList.contains("connected-clients-expanded-card")) return;
          fetch("/api/tak/subscriptions", { headers: { Accept: "application/json" } })
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (!data.configured || !Array.isArray(data.data)) return;
              var list = data.data.filter(function (item) {
                return !isExcludedConnectedClient(item);
              });
              var nextRows = list.map(function (item) {
                return {
                  callsign: item.callsign != null ? String(item.callsign).trim() : "",
                  username: item.username != null ? String(item.username).trim() : "",
                  takClient: item.takClient != null ? String(item.takClient).trim() || "—" : "—",
                  battery: item.battery != null ? String(item.battery).trim() : "",
                  role: item.role != null ? String(item.role).trim() || "—" : "—",
                  team: item.team != null ? String(item.team).trim() : "",
                  subscriptionUid: item.subscriptionUid != null ? String(item.subscriptionUid).trim() : "",
                  clientUid: item.clientUid != null ? String(item.clientUid).trim() : ""
                };
              });
              nextRows.sort(function (a, b) { return (a.callsign || "").localeCompare(b.callsign || "", undefined, { sensitivity: "base" }); });
              fillExpandedTableBody(nextRows, list);
            })
            .catch(function () {});
        }, EXPANDED_REFRESH_MS);
      }

      function collapse() {
        if (expandedRefreshTimer) {
          clearInterval(expandedRefreshTimer);
          expandedRefreshTimer = null;
        }
        if (groupControlRefreshTimer) {
          clearInterval(groupControlRefreshTimer);
          groupControlRefreshTimer = null;
        }
        currentGroupControlClientId = null;
        card.innerHTML = originalCardHtml;
        card.classList.remove("connected-clients-expanded-card");
        row.classList.remove("connected-clients-row-expanded");
        // Reapply latest known metrics so the compact card shows the up-to-date value.
        var cc = typeof window.__latestConnectedClients === "string" ? window.__latestConnectedClients : null;
        var ciVal = typeof window.__latestConnectedIntegrations === "string" ? window.__latestConnectedIntegrations : null;
        var ccEl = document.getElementById("takClients");
        if (ccEl && cc != null) ccEl.textContent = cc;
        var ciEl = document.getElementById("takConnectedIntegrations");
        if (ciEl && ciVal != null) ciEl.textContent = ciVal;
      }

      card.style.cursor = "pointer";
      function tryExpand() {
        if (card.classList.contains("connected-clients-expanded-card")) return;
        card.querySelector(".statValue").textContent = "…";
        fetch("/api/tak/subscriptions", { headers: { Accept: "application/json" } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            if (!data.configured || !Array.isArray(data.data)) {
              collapse();
              return;
            }
            var list = data.data.filter(function (item) {
              return !isExcludedConnectedClient(item);
            });
            var rows = list.map(function (item) {
              return {
                callsign: item.callsign != null ? String(item.callsign).trim() : "",
                username: item.username != null ? String(item.username).trim() : "",
                takClient: item.takClient != null ? String(item.takClient).trim() || "—" : "—",
                battery: item.battery != null ? String(item.battery).trim() : "",
                role: item.role != null ? String(item.role).trim() || "—" : "—",
                team: item.team != null ? String(item.team).trim() : "",
                subscriptionUid: item.subscriptionUid != null ? String(item.subscriptionUid).trim() : "",
                clientUid: item.clientUid != null ? String(item.clientUid).trim() : ""
              };
            });
            rows.sort(function (a, b) { return (a.callsign || "").localeCompare(b.callsign || "", undefined, { sensitivity: "base" }); });
            renderExpandedView(rows, list);
          })
          .catch(function () { collapse(); });
      }
      card.addEventListener("click", function (e) {
        if (card.classList.contains("connected-clients-expanded-card")) {
          collapse();
          return;
        }
        tryExpand();
      });
      card.addEventListener("keydown", function (e) {
        if (card.classList.contains("connected-clients-expanded-card")) {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            collapse();
          }
          return;
        }
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          tryExpand();
        }
      });

      window.__dashboardTakRefresh = function () {
        fetch("/api/tak/metrics", { headers: { Accept: "application/json" } })
          .then(function (res) { return res.json(); })
          .then(function (data) {
            // Reuse the same smoothing logic used by the polling script
            if (typeof window.__takApplyDashboardMetrics === "function") {
              window.__takApplyDashboardMetrics(data);
            } else {
              var el = document.getElementById("takClients");
              var cc = data && typeof data.connectedClients === "number" ? String(data.connectedClients) : "--";
              if (el) el.textContent = cc;
              window.__latestConnectedClients = cc;
              var ci = document.getElementById("takConnectedIntegrations");
              var ciVal = data && typeof data.connectedIntegrations === "number" ? String(data.connectedIntegrations) : "--";
              if (ci) ci.textContent = ciVal;
              window.__latestConnectedIntegrations = ciVal;
              var disk = document.getElementById("takDisk");
              if (disk) disk.textContent = data && typeof data.diskUsagePercent === "number" ? (data.diskUsagePercent < 10 ? data.diskUsagePercent.toFixed(1).replace(/\.0$/, "") : String(Math.round(data.diskUsagePercent))) : "--";
              var up = document.getElementById("takUptime");
              if (up && data && typeof data.uptimeSeconds === "number") {
                var s = Math.max(0, Math.floor(data.uptimeSeconds));
                var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60);
                var parts = [];
                if (d) parts.push(d + "d");
                if (h || d) parts.push(h + "h");
                if (s < 86400) parts.push(m + "m");
                up.textContent = parts.join(" ");
              }
            }
          }).catch(function () {});
      };
    })();
  </script>

