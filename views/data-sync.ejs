  function renderMissionsTable() {
    var filter = (missionTableFilter && missionTableFilter.value || "").trim().toLowerCase();
    missionsTbody.innerHTML = "";

    var activeCount = 0;
    for (var i = 0; i < missionsCache.length; i++) {
      var m = missionsCache[i];
      var name = m && m.name != null ? String(m.name) : "";
      if (filter && name.toLowerCase().indexOf(filter) === -1) continue;
      if (renderMissionRow(m, missionsTbody)) activeCount += 1;
    }

    if (!activeCount) {
      var trA = document.createElement("tr");
      var tdA = document.createElement("td");
      tdA.colSpan = 7;
      tdA.textContent = filter ? "No active missions match the filter." : "No active data sync missions.";
      trA.appendChild(tdA);
      missionsTbody.appendChild(trA);
    }
  }

  function renderArchivedPackagesTable() {
    if (!archivedMissionsTbody) return;
    var filter = (missionTableFilter && missionTableFilter.value || "").trim().toLowerCase();
    archivedMissionsTbody.innerHTML = "";

    var archivedCount = 0;
    for (var i = 0; i < archivedPackagesCache.length; i++) {
      var pkg = archivedPackagesCache[i] || {};
      var filename = firstVal(pkg, ["filename", "name", "original_filename"]);
      var hay = (
        filename + " " +
        packageDisplayGroup(pkg) + " " +
        normalizePackageKeywords(pkg).join(" ")
      ).toLowerCase();
      if (filter && hay.indexOf(filter) === -1) continue;
      if (renderArchivedPackageRow(pkg, archivedMissionsTbody)) archivedCount += 1;
    }

    if (!archivedCount) {
      var trR = document.createElement("tr");
      var tdR = document.createElement("td");
      tdR.colSpan = 5;
      tdR.textContent = filter ? "No archived missions match the filter." : "No archived data sync missions.";
      trR.appendChild(tdR);
      archivedMissionsTbody.appendChild(trR);
    }
    if (archivedMissionCount) archivedMissionCount.textContent = String(archivedCount);
  }

  async function permanentlyDeleteActiveMission(name) {
    setMissionsMsg("Deleting mission permanently…", undefined);
    try {
      var res = await fetch(API + "/missions/" + encodeURIComponent(name) + "/permanent", {
        method: "DELETE",
      });
      var j = await res.json().catch(function () { return {}; });
      if (!res.ok) throw new Error((j && j.error) || "Delete failed");
      var msg = "Data sync permanently deleted.";
      if (j && j.deletedFiles) {
        msg += " Removed " + j.deletedFiles + " file-sync cop" + (j.deletedFiles === 1 ? "y" : "ies") + ".";
      }
      setMissionsMsg(msg, true);
      await loadMissions({ silent: true });
    } catch (e) {
      setMissionsMsg(e.message || "Delete failed", false);
    }
  }
  async function archiveMission(name) {
    if (!window.confirm(
      "Archive data sync \"" + name + "\"?\n\nThis removes the mission from the active list on the TAK Server."
    )) return;
    setMissionsMsg("Archiving mission…", undefined);
    try {
      var delRes = await fetch(API + "/missions/" + encodeURIComponent(name), { method: "DELETE" });
      var delJson = await delRes.json().catch(function () { return {}; });
      if (!delRes.ok) throw new Error((delJson && delJson.error) || "Failed to remove active mission");
      setMissionsMsg("Mission archived (removed from active list).", true);
      await loadMissions({ silent: true });
    } catch (e) {
      setMissionsMsg(e.message || "Archive failed", false);
    }
  }

  async function restoreArchivedPackage(pkg) {
    var hash = firstVal(pkg, ["hash", "sha256", "uid", "id"]);
    var filename = firstVal(pkg, ["filename", "name", "original_filename"]);
    var missionName = String(filename || "").trim().replace(/\.zip$/i, "");
    if (!hash || !missionName) {
      setArchivedMissionsMsg("Archived entry is missing hash or name.", false);
      return;
    }
    if (!window.confirm("Restore archived data sync \"" + (filename || missionName) + "\" as an active mission?")) return;

    setArchivedMissionsMsg("Restoring mission…", undefined);
    try {
      var groups = parsePackageGroupsField(firstVal(pkg, ["groups", "Groups", "group", "Group"]));
      if (groups.length !== 1) {
        throw new Error("Restore requires exactly one group on the archived file entry.");
      }

      var payload = {
        name: missionName,
        tool: "public",
        description: "",
        defaultRole: buildDefaultRoleObject("MISSION_SUBSCRIBER"),
        groups: [groups[0]],
        keywords: [],
        inviteOnly: false,
      };
      var missionRes = await fetch(API + "/missions/" + encodeURIComponent(missionName), {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      var missionText = await missionRes.text();
      var missionJson = {};
      try { missionJson = JSON.parse(missionText); } catch (_) { missionJson = { raw: missionText }; }
      if (!missionRes.ok) throw new Error((missionJson && missionJson.error) || missionText.slice(0, 500) || "Failed to recreate active mission");

      var delRes = await fetch(FILE_SYNC_API + "/packages/" + encodeURIComponent(hash), { method: "DELETE" });
      var delJson = await delRes.json().catch(function () { return {}; });
      if (!delRes.ok && delRes.status !== 404) {
        throw new Error(
          (delJson && delJson.error) ||
            "Active mission restored, but the archived file-sync copy could not be removed from TAK."
        );
      }

      setArchivedMissionsMsg("Mission restored to active list and removed from file sync.", true);
      await loadMissions({ silent: true });
    } catch (e) {
      setArchivedMissionsMsg(e.message || "Restore failed", false);
    }
  }

  async function downloadArchivedPackage(hash, filename) {
    setArchivedMissionsMsg("Downloading archived package…", undefined);
    try {
      var res = await fetch(FILE_SYNC_API + "/packages/download?hash=" + encodeURIComponent(hash));
      if (!res.ok) throw new Error("Download failed (HTTP " + res.status + ")");
      var blob = await res.blob();
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = filename || ("data-sync-archived-" + hash + ".zip");
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function () {
        try { URL.revokeObjectURL(a.href); } catch (_) {}
      }, 2500);
      setArchivedMissionsMsg("Download started.", true);
    } catch (e) {
      setArchivedMissionsMsg(e.message || "Download failed", false);
    }
  }

  function sanitizeDownloadFilename(name) {
    var s = String(name || "mission")
      .replace(/[^\w.\- ()\[\]]+/g, "_")
      .trim()
      .slice(0, 120);
    return s || "mission";
  }

  async function fetchMissionArchiveBlob(missionName, password) {
    var url = API + "/missions/" + encodeURIComponent(missionName) + "/export-archive";
    var qs = [];
    if (password) qs.push("password=" + encodeURIComponent(password));
    if (qs.length) url += "?" + qs.join("&");
    var res = await fetch(url);
    if (!res.ok) {
      var text = await res.text().catch(function () { return ""; });
      var err = "Export failed (HTTP " + res.status + ")";
      try {
        var j = JSON.parse(text);
        if (j && j.error) err = j.error;
      } catch (_) {
        var m = text.match(/<title>([^<]+)<\/title>/i);
        if (m) err = m[1].trim();
      }
      throw new Error(err);
    }
    return res.blob();
  }

  function triggerBrowserHtmlDownload(blob, missionName) {
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = sanitizeDownloadFilename(missionName) + ".html";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () {
      try {
        URL.revokeObjectURL(a.href);
      } catch (_) {
        /* ignore */
      }
    }, 2500);
  }

