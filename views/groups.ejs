          <button class="btn btn-access" type="button"
            onclick="openGroupMembers('${esc(g.pk)}')">Members</button>
          ${locked ? `<span class="muted">Actions Hidden</span>` : editable ? `
            <button class="btn danger" type="button"
              onclick="deleteGroup('${esc(g.pk)}')">Delete</button>
          ` : ``}
        </div>
      </td>
    </tr>
  `;
  }).join("");

  const shown = filtered.length;
  const total = Number(groupsTotal || shown);
  const needleLabel = String(filter.value || "").trim();
  if (!total) {
    setMsg(listMsg, needleLabel ? `No groups found for "${needleLabel}".` : "No groups found.", true);
  } else if (needleLabel) {
    setMsg(listMsg, `Showing ${shown} of ${total} group(s) for "${needleLabel}".`, true);
  } else {
    setMsg(listMsg, `Showing ${shown} of ${total} group(s).`, true);
  }
  const pag = document.getElementById("groupsPagination");
  const info = document.getElementById("groupsPageInfo");
  const first = document.getElementById("groupsFirstBtn");
  const prev = document.getElementById("groupsPrevBtn");
  const next = document.getElementById("groupsNextBtn");
  const last = document.getElementById("groupsLastBtn");
  const totalPages = Math.max(1, Math.ceil(total / GROUPS_PAGE_SIZE));
  if (pag) pag.style.display = total > GROUPS_PAGE_SIZE ? "flex" : "none";
  if (info) info.textContent = `Page ${groupsPage} of ${totalPages}`;
  if (first) first.disabled = groupsPage <= 1;
  if (last) last.disabled = groupsPage >= totalPages;
  if (prev) prev.disabled = groupsPage <= 1;
  if (next) next.disabled = groupsPage >= totalPages;
}

function updateGroupScopeDetailOptions() {
  if (!groupScopeSelect || !groupScopeDetailWrap || !groupScopeDetailSelect) return;

  const scope = String(groupScopeSelect.value || "all").trim().toLowerCase();
  const scopedAgencies = agenciesForScopeFilter();

  // Default: hide detail selector
  groupScopeDetailWrap.style.display = "none";
  groupScopeDetailSelect.innerHTML = "";

  if (scope === "region") {
    const regionList = (regionsCache || [])
      .map((r) => String(r?.name || "").trim())
      .filter(Boolean)
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" }));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All Regional Groups</option>` +
      regionList
        .map((r) => `<option value="${esc(r)}">${esc(r)}</option>`)
        .join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
    return;
  }

  if (!scopedAgencies.length) return;

  if (scope === "state") {
    const stateSet = new Set(
      scopedAgencies
        .map(a => String(a.state || "").trim())
        .filter(Boolean)
        .map(s => s.toUpperCase())
    );

    const stateList = Array.from(stateSet).sort((a, b) => a.localeCompare(b));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All State Groups</option>` +
      stateList.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
  } else if (scope === "county") {
    const countySet = new Set(
      scopedAgencies
        .map(a => String(a.county || "").trim())
        .filter(Boolean)
    );

    const countyList = Array.from(countySet).sort((a, b) => a.localeCompare(b));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All County Groups</option>` +
      countyList
        .map(c => `<option value="${esc(c)}">${esc(c)}</option>`)
        .join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
  } else if (scope === "agency") {
    const options = scopedAgencies
      .slice()
      .sort((a, b) =>
        String(a.name || "").localeCompare(String(b.name || ""), undefined, {
          sensitivity: "base",
        })
      )
      .map((agency) => {
        const name = String(agency?.name || "").trim();
        const prefix = String(agency?.groupPrefix || "").trim();
        if (!name) return "";
        const label = prefix ? `${name} (${prefix})` : name;
        return `<option value="${esc(name)}">${esc(label)}</option>`;
      })
      .filter(Boolean)
      .join("");

    groupScopeDetailSelect.innerHTML =
      `<option value="">All Agency Groups</option>${options}`;

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";

    // Single-agency admin: default sub-filter to their only managed agency.
    if (!IS_GLOBAL_ADMIN && prefixList.length === 1) {
      groupScopeDetailSelect.value = prefixList[0];
    }
  }
}

async function loadGroups(){
  setMsg(listMsg, "Loading groups...", true);
  const params = new URLSearchParams({
    q: String(filter && filter.value || "").trim(),
    page: String(groupsPage),
    pageSize: String(GROUPS_PAGE_SIZE),
  });
  if (groupScopeSelect) {
    params.set("scope", String(groupScopeSelect.value || "all").trim().toLowerCase());
  }
  if (groupScopeDetailSelect && groupScopeDetailSelect.value) {
    params.set("detail", String(groupScopeDetailSelect.value || "").trim());
  }
  const res = await fetch("/api/groups/search?" + params.toString());
  const out = await res.json();

  if(!res.ok){
    setMsg(listMsg, out.error || "Failed to load groups", false);
    return;
  }

  groupsCache = Array.isArray(out.groups) ? out.groups : [];
  groupsTotal = Number(out.total || 0);
  groupsPage = Number(out.page || groupsPage || 1);
  renderGroups();
}

