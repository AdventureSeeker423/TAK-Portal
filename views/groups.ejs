function renderGroups(){
  const needle = String(filter.value || "").trim().toLowerCase();

  // Base search filtering
  let filteredRaw = needle
    ? groupsCache.filter(g => {
        const name = String(g.name || "").toLowerCase();
        const desc = String(g?.attributes?.description || "").toLowerCase();
        const patched = CAN_SEE_CHANNEL_PATCH && Array.isArray(g.patchedWith)
          ? g.patchedWith.join(" ").toLowerCase()
          : "";
        return name.includes(needle) || desc.includes(needle) || patched.includes(needle);
      })
    : groupsCache;

  // Scope + sub-filter (global admin and agency / multi-agency admin)
  if ((IS_GLOBAL_ADMIN || IS_AGENCY_ADMIN) && groupScopeSelect && groupScopeDetailSelect) {
    const scope = String(groupScopeSelect.value || "all").trim().toLowerCase();
    const detail = String(groupScopeDetailSelect.value || "").trim();

    if (scope !== "all") {
      if (scope === "global") {
        filteredRaw = filteredRaw.filter(g => getPortalGroupScope(g) === "global");
      } else if (scope === "state") {
        filteredRaw = filteredRaw.filter(g => {
          if (getPortalGroupScope(g) !== "state") return false;
          if (!detail) return true;
          return getPortalGroupStateDetail(g) === String(detail).trim().toUpperCase();
        });
      } else if (scope === "county") {
        filteredRaw = filteredRaw.filter(g => {
          if (getPortalGroupScope(g) !== "county") return false;
          if (!detail) return true;
          return (
            getPortalGroupCountyDetail(g).toUpperCase() ===
            String(detail).trim().toUpperCase()
          );
        });
      } else if (scope === "region") {
        filteredRaw = filteredRaw.filter(g => {
          if (getPortalGroupScope(g) !== "region") return false;
          if (!detail) return true;
          return (
            getPortalGroupRegionDetail(g).toLowerCase() ===
            String(detail).trim().toLowerCase()
          );
        });
      } else if (scope === "agency") {
        filteredRaw = filteredRaw.filter(g => {
          if (getPortalGroupScope(g) !== "agency") return false;
          if (!detail) return true;
          const detailTrim = String(detail).trim();
          const agencyName = getPortalGroupAgencyNameDetail(g);
          if (agencyName && agencyName.toLowerCase() === detailTrim.toLowerCase()) {
            return true;
          }
          return (
            getPortalGroupAgencyPrefixDetail(g).toLowerCase() ===
            detailTrim.toLowerCase()
          );
        });
      }
    }
  }

  const filtered = stableSortedCopy(filteredRaw, sortKey, sortDir);

  tbody.innerHTML = filtered.map(g => {
    const locked = groupActionsLocked(g.name);
    const editable = !locked && isGroupEditable(g);
    const desc = String(g?.attributes?.description || "").trim();
    const isPrivate = String(g?.attributes?.private || "").trim().toLowerCase() === "yes";
    const patchedWithLabel =
      CAN_SEE_CHANNEL_PATCH && Array.isArray(g.patchedWith) && g.patchedWith.length
        ? g.patchedWith.join(", ")
        : "";

    return `
    <tr>
      <td class="groupNameCell cardTitleCell">
        <div class="groupNameText cardTitleText">${esc(stripTakPrefix(g.name))}</div>
        ${desc ? `<div class="muted groupDescText">${esc(desc)}</div>` : ""}
        ${patchedWithLabel ? `<div class="groupPatchedText">Channel Patched With ${esc(patchedWithLabel)}</div>` : ""}
        ${IS_GLOBAL_ADMIN && isPrivate ? `<span class="groupPrivateBadge cardMetaBadge">Private</span>` : ""}
      </td>
      ${IS_GLOBAL_ADMIN ? `<td class="groupPrivateCell">${isPrivate ? "Private" : ""}</td>` : ``}
      <td class="groupActionsCell cardActionsCell">
        <div class="groupActionsRow cardActionsRow">
          <button class="btn" type="button"
            onclick="openGroupMembers('${esc(g.pk)}')">View Members</button>
          ${locked ? `<span class="muted">Actions Hidden</span>` : `
            <button class="btn success" type="button"
              onclick="openMassAssign('${esc(g.pk)}')">Assign</button>
            <button class="btn" type="button"
              onclick="openMassUnassign('${esc(g.pk)}')">Unassign</button>
            ${IS_GLOBAL_ADMIN ? `
            <button class="btn btn-access" type="button"
              onclick="openGroupAdminAccess('${esc(g.pk)}')">Admin Access</button>
            ` : ``}
            ${editable ? `
            <button class="btn" type="button"
              onclick="editGroupName('${esc(g.pk)}')">Edit</button>
            <button class="btn danger" type="button"
              onclick="deleteGroup('${esc(g.pk)}')">Delete</button>
            ` : ``}
          `}
        </div>
      </td>
    </tr>
  `;
  }).join("");

  renderSourceGroupList();
}

function updateGroupScopeDetailOptions() {
  if (!groupScopeSelect || !groupScopeDetailWrap || !groupScopeDetailSelect) return;

  const scope = String(groupScopeSelect.value || "all").trim().toLowerCase();
  const scopedAgencies = agenciesForScopeFilter();

  // Default: hide detail selector
  groupScopeDetailWrap.style.display = "none";
  groupScopeDetailSelect.innerHTML = "";

  if (scope === "region") {
    const regionList = (regionsCache || [])
      .map((r) => String(r?.name || "").trim())
      .filter(Boolean)
      .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: "base" }));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All Regional Groups</option>` +
      regionList
        .map((r) => `<option value="${esc(r)}">${esc(r)}</option>`)
        .join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
    return;
  }

  if (!scopedAgencies.length) return;

  if (scope === "state") {
    const stateSet = new Set(
      scopedAgencies
        .map(a => String(a.state || "").trim())
        .filter(Boolean)
        .map(s => s.toUpperCase())
    );

    const stateList = Array.from(stateSet).sort((a, b) => a.localeCompare(b));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All State Groups</option>` +
      stateList.map(s => `<option value="${esc(s)}">${esc(s)}</option>`).join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
  } else if (scope === "county") {
    const countySet = new Set(
      scopedAgencies
        .map(a => String(a.county || "").trim())
        .filter(Boolean)
    );

    const countyList = Array.from(countySet).sort((a, b) => a.localeCompare(b));

    groupScopeDetailSelect.innerHTML =
      `<option value="">All County Groups</option>` +
      countyList
        .map(c => `<option value="${esc(c)}">${esc(c)}</option>`)
        .join("");

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";
  } else if (scope === "agency") {
    const options = scopedAgencies
      .slice()
      .sort((a, b) =>
        String(a.name || "").localeCompare(String(b.name || ""), undefined, {
          sensitivity: "base",
        })
      )
      .map((agency) => {
        const name = String(agency?.name || "").trim();
        const prefix = String(agency?.groupPrefix || "").trim();
        if (!name) return "";
        const label = prefix ? `${name} (${prefix})` : name;
        return `<option value="${esc(name)}">${esc(label)}</option>`;
      })
      .filter(Boolean)
      .join("");

    groupScopeDetailSelect.innerHTML =
      `<option value="">All Agency Groups</option>${options}`;

    groupScopeDetailWrap.style.display = "flex";
    groupScopeDetailSelect.value = "";

    // Single-agency admin: default sub-filter to their only managed agency.
    if (!IS_GLOBAL_ADMIN && prefixList.length === 1) {
      groupScopeDetailSelect.value = prefixList[0];
    }
  }
}

