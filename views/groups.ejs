// Delete w/ impact
window.deleteGroup = async (groupId) => {
  // Give immediate feedback so the user sees something while impact is computed
  setMsg(listMsg, "Calculating delete impact...", true);

  const g = (groupsCache || []).find(x => String(x.pk) === String(groupId));
  const name = String(g?.name || "").trim();
  if (name && groupActionsLocked(name)) {
    setMsg(listMsg, `Actions are locked for group ${name}`, false);
    return;
  }

  const impactRes = await fetch(`/api/groups/${encodeURIComponent(groupId)}/impact`);
  const impact = await impactRes.json();

  if(!impactRes.ok){
    setMsg(listMsg, impact.error || "Failed to fetch delete impact", false);
    return;
  }

  const tmplCount = Number(impact.templatesAffectedCount || 0);
  const userCount = Number(impact.usersAffected || 0);

  let tmplPreview = "";
  if (tmplCount > 0) {
    const names = (impact.templatesAffected || [])
      .slice(0, 6)
      .map(t => t.name)
      .filter(Boolean);
    tmplPreview = names.length ? `\n\nTemplates (first ${names.length}):\n- ${names.join("\n- ")}` : "";
    if ((impact.templatesAffected || []).length > 6) tmplPreview += `\n- ...and more`;
  }

  const ok = confirm(
    `DELETE GROUP: "${stripTakPrefix(impact.groupName || name)}"?\n\n` +
    `This will:\n` +
    `• Remove this group from ${userCount} user(s)\n` +
    `• Remove this group from ${tmplCount} template(s)\n\n` +
    `Then delete the group.` +
    tmplPreview
  );

  if(!ok) return;

  const delRes = await fetch("/api/groups/" +
    encodeURIComponent(groupId), { method:"DELETE" });
  const out = await delRes.json();

  if(!delRes.ok){
    setMsg(listMsg, out.error || "Delete failed", false);
    return;
  }

  setMsg(
    listMsg,
    `Deleted "${stripTakPrefix(out.groupName || name)}". Removed from ${out.usersUpdated} user(s), updated ${out.templatesUpdated} template(s).`,
    true
  );

  await loadGroups();
};

function selectedMassCount(){
  const mode = selectedMassMode();
  if (mode === "agency") {
    return agencyList ? agencyList.querySelectorAll("input.agencyChk:checked").length : 0;
  }
  if (mode === "agencyType") {
    return agencyTypeList ? agencyTypeList.querySelectorAll("input.agencyTypeChk:checked").length : 0;
  }
  if (mode === "group") return selectedSourceGroupIds.size;
  if (mode === "template") return selectedTemplateIndices.size;
  if (mode === "users") return selectedUserIds.size;
  return 0;
}

function massWhoNoun(count){
  const mode = selectedMassMode();
  const n = Number(count || 0);
  if (mode === "agency") return n === 1 ? "agency" : "agencies";
  if (mode === "agencyType") return n === 1 ? "agency type" : "agency types";
  if (mode === "group") return n === 1 ? "group" : "groups";
  if (mode === "template") return n === 1 ? "template" : "templates";
  if (mode === "users") return n === 1 ? "user" : "users";
  return n === 1 ? "item" : "items";
}

function updateMassChrome(){
  const adding = massAction !== "unassign";
  const count = selectedMassCount();
  const who = massWhoNoun(count);
  const verb = adding ? "Assign" : "Unassign";
  if (massTitle) massTitle.textContent = verb;
  if (massApplyBtn) {
    massApplyBtn.textContent = (count
      ? `${verb} for ${count} selected ${who}`
      : `${verb} for selected ${who}`).toUpperCase();
    massApplyBtn.className = adding ? "btn success" : "btn caution";
    massApplyBtn.disabled = count < 1;
  }
  if (massActionAssignBtn) massActionAssignBtn.classList.toggle("active", adding);
  if (massActionUnassignBtn) massActionUnassignBtn.classList.toggle("active", !adding);
  if (templateModeVerb) templateModeVerb.textContent = adding ? "add" : "remove";
}

function setMassAction(next){
  massAction = next === "unassign" ? "unassign" : "assign";
