<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Groups / Channels",
    scopedSuffix: "Groups / Channels",
    singleFallbackTitle: "Agency Groups / Channels"
  }) %>

  <% if (typeof canSeeChannelPatch !== "undefined" && canSeeChannelPatch && Number(activeChannelPatchCount) > 0) { %>
    <a href="/channel-patch" style="text-decoration:none;">
      <div class="channelPatchBanner" style="margin: 10px 0 14px 0;">
        <%= activeChannelPatchCount %> Channel Patch<%= Number(activeChannelPatchCount) === 1 ? "" : "es" %> Active
      </div>
    </a>
  <% } %>

  <div class="card">
  <h2>Create Group / Channel</h2>

  <div class="row">
    <% if (isGlobalAdmin) { %>
    <label>Group Type
      <select id="createType">
        <option value="agency" selected>Agency-Specific Group</option>
        <option value="county">County-Specific Group</option>
        <option value="region">Region-Specific Group</option>
        <option value="state">State-Specific Group</option>
        <option value="generic">Global Group</option>
      </select>
    </label>
    <% } else { %>
    <select id="createType" disabled style="display:none;">
      <option value="agency" selected>Agency-Specific Group</option>
    </select>
    <% } %>

    <label id="agencyPrefixWrap" style="display:none;">Select Agency
      <select id="agencyPrefixSelect">
        <option value="">Select Agency</option>
      </select>
    </label>

    <label id="countyWrap" style="display:none;">Select County
      <select id="countySelect">
        <option value="">Select County</option>
      </select>
    </label>

    <label id="regionWrap" style="display:none;">Select Region
      <select id="regionSelect">
        <option value="">Select Region</option>
      </select>
    </label>
<label id="stateWrap" style="display:none;">Select State
  <select id="stateSelect">
    <option value="">Select State</option>
  </select>
</label>

    <label style="flex: 1; min-width: 160px;">Group Name
      <input
        id="groupName"
        placeholder="Group name"
        style="width: 100%;"
      />
    </label>

    <label style="min-width: 220px;">Channel Behavior
      <select id="behaviorSelect" style="min-width: 120px;">
        <option value="both" selected>BOTH - Send and Recieve (default)</option>
        <option value="read">READ - Recieve Only</option>
        <option value="write">WRITE - Send Only</option>
      </select>
    </label>

    <% if (isGlobalAdmin) { %>
    <label id="privateWrap" style="min-width: 220px;">Hide From Agency Admins
      <select id="privateSelect" style="min-width: 120px;">
        <option value="no" selected>No</option>
        <option value="yes">Yes</option>
      </select>
    </label>
    <% } %>

  </div>

  <div class="row" style="margin-top:8px;">
    <label style="flex: 1; min-width: 0;">Group Description
      <input
        id="groupDescription"
        placeholder="One-line description for this group (optional)"
        style="width: 100%;"
      />
    </label>
  </div>

  <div class="row createGroupActionRow" style="margin-top:10px; justify-content:flex-end;">
    <button class="btn createGroupSubmitBtnAlignRight" id="createBtn" type="button">Create New Group</button>
  </div>

