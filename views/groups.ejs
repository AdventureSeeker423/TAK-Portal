/** Agency types that currently have at least one registered agency (scoped for agency admins). */
function agencyTypesWithAgencies(){
  const list = typeof agenciesForScopeFilter === "function"
    ? agenciesForScopeFilter()
    : (Array.isArray(agenciesCache) ? agenciesCache : []);
  const counts = new Map();
  for (const a of list) {
    const type = String(a?.type || "").trim();
    const sfx = String(a?.suffix || "").trim();
    if (!type || !sfx) continue;
    counts.set(type, (counts.get(type) || 0) + 1);
  }
  return Array.from(counts.entries())
    .map(([type, count]) => ({ type, count }))
    .sort((a, b) => a.type.localeCompare(b.type, undefined, { sensitivity: "base" }));
}

function suffixesForSelectedAgencyTypes(types){
  const wanted = new Set(
    (types || []).map((t) => String(t || "").trim().toLowerCase()).filter(Boolean)
  );
  if (!wanted.size) return [];
  const list = typeof agenciesForScopeFilter === "function"
    ? agenciesForScopeFilter()
    : (Array.isArray(agenciesCache) ? agenciesCache : []);
  const suffixes = [];
  for (const a of list) {
    const type = String(a?.type || "").trim().toLowerCase();
    if (!wanted.has(type)) continue;
    const sfx = String(a?.suffix || "").trim().toLowerCase();
    if (sfx) suffixes.push(sfx);
  }
  return Array.from(new Set(suffixes));
}

function renderAgencyTypeList(){
  if (!agencyTypeList) return;
  const needle = String(agencyTypeSearch?.value || "").trim().toLowerCase();
  const items = agencyTypesWithAgencies().filter((x) => {
    if (!needle) return true;
    return x.type.toLowerCase().includes(needle);
  });
  agencyTypeList.innerHTML = items.map((x) => {
    const label = `${x.type} (${x.count} ${x.count === 1 ? "agency" : "agencies"})`;
    return `
      <label class="groupItem">
        <input type="checkbox" class="agencyTypeChk" value="${esc(x.type)}" />
        <span>${esc(label)}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No agency types with registered agencies.</div>`;
}

