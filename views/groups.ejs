}

const exportGroupsCsvBtn = document.getElementById("exportGroupsCsvBtn");
if (exportGroupsCsvBtn) {
  exportGroupsCsvBtn.addEventListener("click", async () => {
    const prevLabel = exportGroupsCsvBtn.textContent;
    exportGroupsCsvBtn.disabled = true;
    exportGroupsCsvBtn.textContent = "Exporting…";
    try {
      const res = await fetch("/api/groups/export-csv");
      if (!res.ok) {
        let errText = "Export failed";
        try {
          const body = await res.json();
          errText = body?.error || errText;
        } catch (_) {
          // ignore
        }
        setMsg(listMsg, errText, false);
        return;
      }
      const blob = await res.blob();
      const cd = res.headers.get("Content-Disposition") || "";
      const match = /filename="([^"]+)"/i.exec(cd);
      const filename = match ? match[1] : "tak-portal-groups.csv";
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      setMsg(listMsg, `Exported ${filename}.`, true);
    } catch (err) {
      setMsg(listMsg, err?.message || "Export failed", false);
    } finally {
      exportGroupsCsvBtn.disabled = false;
      exportGroupsCsvBtn.textContent = prevLabel;
    }
  });
}

