let activeMembers = [];
let activeMembersGroupName = "";
let activeMembersGroupId = "";
let membersSortKey = "name";
let membersSortDir = "asc";
let membersCurrentPage = 1;
let membersPageSize = 100;
let membersTotalCount = 0;
let membersHasNext = false;
let membersHasPrev = false;

window.setMembersSort = function(key){
  key = String(key || "").toLowerCase();
  if (!["username", "name", "email"].includes(key)) return;
  if (membersSortKey === key) {
    membersSortDir = membersSortDir === "asc" ? "desc" : "asc";
  } else {
    membersSortKey = key;
    membersSortDir = "asc";
  }
  renderMembersList();
};

function renderMembersList(){
  const needle = String(membersFilter.value || "").trim().toLowerCase();

  const items = (activeMembers || []).slice().sort((a, b) => {
    const ak = String(a[membersSortKey] || "").toLowerCase();
    const bk = String(b[membersSortKey] || "").toLowerCase();
    if (ak < bk) return membersSortDir === "asc" ? -1 : 1;
    if (ak > bk) return membersSortDir === "asc" ? 1 : -1;
    return 0;
  });

  const filtered = needle
    ? items.filter(u => {
        const uName = String(u.username || "").toLowerCase();
        const n = String(u.name || "").toLowerCase();
        const em = String(u.email || "").toLowerCase();
        return uName.includes(needle) || n.includes(needle) || em.includes(needle);
      })
    : items;

  if (!filtered.length) {
    membersList.innerHTML = `<div class="muted">No members match your filter.</div>`;
    return;
  }

  const sortArrow = (key) => {
    if (membersSortKey !== key) return "";
    return membersSortDir === "asc" ? " ▲" : " ▼";
  };

  const rowsHtml = filtered.map(u => `
    <tr>
      <td>${esc(u.username || "")}</td>
      <td>${esc(u.name || "")}</td>
      <td>${esc(u.email || "")}</td>
      <td style="text-align:right;">
        <button class="btn danger" type="button"
          onclick="removeUserFromGroup('${esc(u.pk)}')">Remove</button>
      </td>
    </tr>
  `).join("");

  membersList.innerHTML = `
    <table class="table">
      <thead>
        <tr>
          <th><span style="cursor:pointer;" onclick="setMembersSort('username')">Username${sortArrow('username')}</span></th>
          <th><span style="cursor:pointer;" onclick="setMembersSort('name')">Name${sortArrow('name')}</span></th>
          <th><span style="cursor:pointer;" onclick="setMembersSort('email')">Email${sortArrow('email')}</span></th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        ${rowsHtml}
      </tbody>
    </table>
  `;
}

function renderMembersPagination() {
  const total = Number(membersTotalCount || 0);
  const size = Math.max(1, Number(membersPageSize || 100));
  const totalPages = total > 0 ? Math.max(1, Math.ceil(total / size)) : 1;
  if (membersPageInfo) membersPageInfo.textContent = `Page ${membersCurrentPage} of ${totalPages}`;
  if (membersPrevBtn) membersPrevBtn.disabled = !membersHasPrev;
  if (membersNextBtn) membersNextBtn.disabled = !membersHasNext;
}

async function loadMembersPage(page) {
  if (!activeMembersGroupId) return;
  const targetPage = Math.max(1, Number(page || 1));
  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";

  const res = await fetch(
    `/api/groups/${encodeURIComponent(activeMembersGroupId)}/members?page=${targetPage}&pageSize=${membersPageSize}`
  );
  const out = await res.json();
  if (!res.ok) throw new Error(out.error || "Failed to load members");

  activeMembers = Array.isArray(out.users) ? out.users : [];
  membersCurrentPage = Number(out.page || targetPage || 1);
  membersPageSize = Number(out.pageSize || membersPageSize || 100);
  membersTotalCount = Number(out.memberCount || activeMembers.length || 0);
  membersHasNext = !!out.hasNext;
  membersHasPrev = !!out.hasPrev;

    const groupLabel = stripTakPrefix(String(activeMembersGroupName || out.group?.name || activeMembersGroupId || ""));
  membersSummary.textContent = `${membersTotalCount} member${membersTotalCount === 1 ? "" : "s"} in group "${groupLabel}".`;
  membersSummary.className = "msg ok";

  renderMembersList();
  renderMembersPagination();
}

window.openGroupMembers = async (groupId) => {
  setMsg(listMsg, "");

  const g = (groupsCache || []).find(x => String(x.pk) === String(groupId));
  activeMembersGroupName = String(g?.name || "");
  activeMembersGroupId = String(groupId || "");

  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";
  membersList.innerHTML = "";
  membersFilter.value = "";
  membersCurrentPage = 1;
  membersTotalCount = 0;
  membersHasNext = false;
  membersHasPrev = false;
  renderMembersPagination();

  showMembersModal(true);

  try {
    await loadMembersPage(1);
  } catch (e) {
    membersSummary.textContent = "Failed to load members.";
    membersSummary.className = "msg bad";
    membersList.innerHTML = "";
    activeMembers = [];
    membersTotalCount = 0;
    membersHasNext = false;
    membersHasPrev = false;
    renderMembersPagination();
  }
};

window.removeUserFromGroup = async (userPk) => {
  if (!activeMembersGroupId) return;

  const label = stripTakPrefix(String(activeMembersGroupName || activeMembersGroupId || ""));
  if (!confirm(`Remove this user from group "${label}"?`)) return;

  try {
    const res = await fetch("/api/groups/mass-unassign", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        groupId: activeMembersGroupId,
        userIds: [String(userPk)]
      })
    });
    const out = await res.json();
    if (!res.ok) {
      alert(out.error || "Failed to remove user from group.");
      return;
    }

    activeMembers = activeMembers.filter(u => String(u.pk) !== String(userPk));
    const memberCount = Math.max(0, Number(membersTotalCount || 0) - 1);
    membersTotalCount = memberCount;
    const groupLabel = stripTakPrefix(String(label || ""));

    membersSummary.textContent =
      `${memberCount} member${memberCount === 1 ? "" : "s"} in group "${groupLabel}".`;
    membersSummary.className = "msg ok";


    renderMembersList();
    renderMembersPagination();
  } catch (e) {
    alert("Failed to remove user from group.");
  }
};

editGroupSaveBtn.onclick = async () => {
  setMsg(editGroupMsg, "");

  if (!editGroupCurrentId) {
    setMsg(editGroupMsg, "No group selected.", false);
    return;
  }

  const type = editType ? editType.value : "generic";
  const baseName = String(editGroupNameInput.value || "").trim();
  const behavior = editBehaviorSelect
    ? String(editBehaviorSelect.value || "both").toLowerCase()
    : "both";

  let prefix = "";
  let county = "";
  let state = "";

  if (!baseName) {
    setMsg(editGroupMsg, "Group name cannot be empty.", false);
    return;
  }

  // IMPORTANT: prevent agency admins from changing agency groups to global/county
  if (!IS_GLOBAL_ADMIN && editGroupOriginalType === "agency" && type !== "agency") {
    setMsg(editGroupMsg, "You are not allowed to change an agency group to a different type.", false);
    return;
  }

  if (type === "agency") {
    prefix = String(editAgencyPrefixSelect?.value || "").trim().toUpperCase();
    if (!prefix) {
      setMsg(editGroupMsg, "Select an agency prefix.", false);
      return;
    }
  } else if (type === "county") {
    county = String(editCountySelect?.value || "").trim();
    if (!county) {
      setMsg(editGroupMsg, "Select a county.", false);
      return;
    }
  } else if (type === "state") {
    state = String(editStateSelect?.value || "").trim().toUpperCase();
    if (!state) {
      setMsg(editGroupMsg, "Select a state.", false);
      return;
    }
  }

  const newName = buildGroupNameFromParts({
    type,
    baseName,
    behavior,
    prefix,
    county,
    state,
  });

  const newDescription = String(editGroupDescriptionInput.value || "").trim();
  const newPrivate = (IS_GLOBAL_ADMIN && editPrivateSelect && type === "agency")
    ? String(editPrivateSelect.value || "no").trim().toLowerCase()
    : null;

  if (!newName) {
    setMsg(editGroupMsg, "Invalid group name.", false);
    return;
  }

  const privateUnchanged = (newPrivate === null) || (newPrivate === editGroupCurrentPrivate);

  if (newName === editGroupCurrentName && newDescription === editGroupCurrentDescription && privateUnchanged) {
    setMsg(editGroupMsg, "No changes made.", true);
    return;
  }

  if (!confirm(`Save changes to "${stripTakPrefix(editGroupCurrentName)}"?`)) return;

  const res = await fetch(`/api/groups/${encodeURIComponent(editGroupCurrentId)}`, {
    method: "PATCH",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({
      name: newName,
      description: newDescription || null,
      private: (IS_GLOBAL_ADMIN && editPrivateSelect && type === "agency")
        ? String(editPrivateSelect.value || "no").trim().toLowerCase()
        : undefined,
    }),
  });

  let out = {};
  try { out = await res.json(); } catch (e) {}

  if (!res.ok) {
    setMsg(editGroupMsg, out.error || "Update failed", false);
    return;
  }

  setMsg(editGroupMsg, `Updated "${stripTakPrefix(newName)}"`, true);
  editGroupCurrentName = newName;
  editGroupCurrentDescription = newDescription;
  if (newPrivate !== null) editGroupCurrentPrivate = newPrivate;
  await loadGroups();
  showEditGroupModal(false);
};

