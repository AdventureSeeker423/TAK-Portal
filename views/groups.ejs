if (massApplyBtn) {
  massApplyBtn.onclick = async () => {
  setMsg(massMsg, "");
  if (!activeMassGroupId) return setMsg(massMsg, "No target group selected.", false);
  if (groupActionsLocked(activeMassGroupName)) {
    return setMsg(massMsg, `Actions are locked for group ${activeMassGroupName || activeMassGroupId}`, false);
  }

  const mode = selectedMassMode();
  let payload = { groupId: activeMassGroupId, sourceMode: mode };

  if (mode === "agency") {
    const suffixes = Array.from(agencyList.querySelectorAll('input.agencyChk:checked'))
      .map(x => String(x.value).trim().toLowerCase())
      .filter(Boolean);
    if (!suffixes.length) return setMsg(massMsg, "Select one or more agencies.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} all users in ${suffixes.length} agency suffix(es)?`)) return;
    payload.suffixes = suffixes;
  }

  if (mode === "agencyType") {
    const types = Array.from(agencyTypeList.querySelectorAll("input.agencyTypeChk:checked"))
      .map((x) => String(x.value || "").trim())
      .filter(Boolean);
    if (!types.length) return setMsg(massMsg, "Select one or more agency types.", false);
    const suffixes = suffixesForSelectedAgencyTypes(types);
    if (!suffixes.length) return setMsg(massMsg, "No agencies found for the selected type(s).", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} all users in ${types.length} agency type(s) (${suffixes.length} agency suffix(es))?`)) return;
    payload.sourceMode = "agency";
    payload.suffixes = suffixes;
  }

  if (mode === "group") {
    const srcIds = Array.from(selectedSourceGroupIds);
    if (!srcIds.length) return setMsg(massMsg, "Select one or more source groups.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} users already in ${srcIds.length} selected group(s)?`)) return;
    payload.sourceGroupIds = srcIds;
  }

  if (mode === "users") {
    const userIds = Array.from(selectedUserIds);
    if (!userIds.length) return setMsg(massMsg, "Select one or more users.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} ${userIds.length} user(s)?`)) return;
    payload.userIds = userIds;
  }

  if (mode === "template") {
    const templateIndices = Array.from(selectedTemplateIndices);
    if (!templateIndices.length) return setMsg(massMsg, "Select one or more templates.", false);
    const actionVerb = massAction === "unassign" ? "remove" : "add";
    if (!confirm(`${actionVerb === "add" ? "Add" : "Remove"} "${activeMassGroupName}" ${actionVerb === "add" ? "to" : "from"} ${templateIndices.length} template(s)?`)) return;

    const startedAt = Date.now();
    setMsg(massMsg, `Preparing... 0 of ? • 0:00`, "progress");

    try {
      const startRes = await fetch("/api/templates/bulk-group-update/start", {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({
          action: actionVerb,
          groupName: activeMassGroupName,
          templateIndices,
        })
      });
      const startOut = await startRes.json();
      if (!startRes.ok || !startOut?.jobId) {
        return setMsg(massMsg, startOut.error || "Template update failed", false);
      }

      let done = false;
      while (!done) {
        const statusRes = await fetch(`/api/templates/bulk-jobs/${encodeURIComponent(startOut.jobId)}`);
        const statusOut = await statusRes.json();
        if (!statusRes.ok || !statusOut.success) {
          throw new Error(statusOut.error || "Failed to read template update status");
        }

        const total = Number(statusOut.total || 0);
        const processed = Number(statusOut.processed || 0);
        const matched = Number(statusOut.matched || 0);
        const elapsedMs = Date.now() - startedAt;
        const phase = String(statusOut.phase || "");
        const phaseLabel = templateBulkPhaseLabel(phase);

        if (statusOut.status === "running") {
          const totalLabel = total > 0 ? String(total) : "?";
          let detail = `${processed} of ${totalLabel}`;
          if (phase === "fetching_users" || phase === "matching" || phase === "applying") {
            detail += ` • ${matched} user${matched === 1 ? "" : "s"} matched`;
          }
          if (phase === "applying" && Number(statusOut.updated || 0) > 0) {
            detail += ` • ${Number(statusOut.updated || 0)} updated`;
          }
          setMsg(massMsg, `${phaseLabel}... ${detail} • ${fmtMassElapsed(elapsedMs)}`, "progress");
          await new Promise(r => setTimeout(r, 800));
          continue;
        }

        if (statusOut.status === "failed") {
          setMsg(massMsg, statusOut.error || "Template update failed", false);
          done = true;
          continue;
        }

        await loadTemplatesForMassModal();
        renderTemplateSourceList();
        const result = statusOut.result || {};
        const sync = result.currentTemplateSync && typeof result.currentTemplateSync === "object"
          ? result.currentTemplateSync
          : {};
        const syncMsg = ` Users matched: ${Number(sync.matched || statusOut.matched || 0)}, updated: ${Number(sync.updated || statusOut.updated || 0)}, groups updated: ${Number(sync.groupsUpdated || statusOut.groupsUpdated || 0)}.`;
        setMsg(
          massMsg,
          `Updated ${Number(result.updated || statusOut.templatesUpdated || 0)} template(s). Skipped ${Number(result.skipped || statusOut.templatesSkipped || 0)}.${syncMsg} • ${fmtMassElapsed(elapsedMs)}`,
          true
        );
        done = true;
      }
    } catch (e) {
      return setMsg(massMsg, e?.message || "Template update failed", false);
    }
    await refreshMembersAfterMass();
    return;
  }

  const startEndpoint = massAction === "unassign" ? "/api/groups/mass-unassign/start" : "/api/groups/mass-assign/start";
  try {
    const startRes = await fetch(startEndpoint, {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    });
    const startOut = await startRes.json();
    if (!startRes.ok || !startOut?.jobId) {
      return setMsg(massMsg, startOut.error || `Mass ${massAction} failed`, false);
    }

    const startedAt = Date.now();
    setMsg(massMsg, `Preparing... 0 of ? • 0:00`, "progress");

    let done = false;
    while (!done) {
      const statusRes = await fetch(`/api/groups/mass-jobs/${encodeURIComponent(startOut.jobId)}`);
      const statusOut = await statusRes.json();
      if (!statusRes.ok || !statusOut.success) {
        throw new Error(statusOut.error || "Failed to read mass action status");
      }

      const total = Number(statusOut.total || 0);
      const processed = Number(statusOut.processed || 0);
      const elapsedMs = Date.now() - startedAt;
      const phase = String(statusOut.phase || "");
      const sourceMode = String(statusOut.sourceMode || mode || "agency");

      if (statusOut.status === "running") {
        const loadingLabel =
          sourceMode === "group" ? "Loading groups" :
          sourceMode === "users" ? "Loading users" :
          "Loading agencies";
        const phaseLabel =
          phase === "queued" ? "Preparing" :
          phase === "loading_users" ? loadingLabel :
          phase === "matching" ? "Matching users" :
          phase === "applying" ? "Applying changes" :
          "In Progress";
        if (phase === "queued" || phase === "loading_users") {
          const totalLabel = total > 0 ? String(total) : "?";
          setMsg(massMsg, `${phaseLabel}... ${processed} of ${totalLabel} • ${fmtMassElapsed(elapsedMs)}`, "progress");
        } else {
          const totalLabel = total > 0 ? String(total) : "?";
          setMsg(massMsg, `${phaseLabel}... ${processed} of ${totalLabel} • ${fmtMassElapsed(elapsedMs)}`, "progress");
        }
        await new Promise(r => setTimeout(r, 800));
        continue;
      }

      if (statusOut.status === "failed") {
        setMsg(massMsg, statusOut.error || `Mass ${massAction} failed`, false);
        done = true;
        continue;
      }

      const result = statusOut.result || {};
      setMsg(
        massMsg,
        `Completed. Matched ${Number(result.matched || 0)} user(s). Updated ${Number(result.updated || 0)}. • ${fmtMassElapsed(elapsedMs)}`,
        true
      );
      done = true;
    }
    await refreshMembersAfterMass();
  } catch (e) {
    setMsg(massMsg, `Mass ${massAction} failed`, false);
  }
};
}

