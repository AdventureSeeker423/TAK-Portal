window.removeUserFromGroup = async (userPk) => {
  if (!activeMembersGroupId) return;

  const label = stripTakPrefix(String(activeMembersGroupName || activeMembersGroupId || ""));
  if (!confirm(`Remove this user from group "${label}"?`)) return;

  try {
    const res = await fetch("/api/groups/mass-unassign", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({
        groupId: activeMembersGroupId,
        userIds: [String(userPk)]
      })
    });
    const out = await res.json();
    if (!res.ok) {
      alert(out.error || "Failed to remove user from group.");
      return;
    }

    activeMembers = activeMembers.filter(u => String(u.pk) !== String(userPk));
    const memberCount = Math.max(0, Number(membersTotalCount || 0) - 1);
    membersTotalCount = memberCount;
    const groupLabel = stripTakPrefix(String(label || ""));

    membersSummary.textContent =
      `${memberCount} member${memberCount === 1 ? "" : "s"} in group "${groupLabel}".`;
    membersSummary.className = "msg ok";


    renderMembersList();
    renderMembersPagination();
  } catch (e) {
    alert("Failed to remove user from group.");
  }
};

editGroupSaveBtn.onclick = async () => {
  setMsg(editGroupMsg, "");

  if (!editGroupCurrentId) {
    setMsg(editGroupMsg, "No group selected.", false);
    return;
  }

  const type = editType ? editType.value : "generic";
  const baseName = String(editGroupNameInput.value || "").trim();
  const behavior = editBehaviorSelect
    ? String(editBehaviorSelect.value || "both").toLowerCase()
    : "both";

  let prefix = "";
  let county = "";
  let region = "";
  let state = "";

  if (!baseName) {
    setMsg(editGroupMsg, "Group name cannot be empty.", false);
    return;
  }

  // IMPORTANT: prevent agency admins from changing agency groups to global/county
  if (!IS_GLOBAL_ADMIN && editGroupOriginalType === "agency" && type !== "agency") {
    setMsg(editGroupMsg, "You are not allowed to change an agency group to a different type.", false);
    return;
  }

  if (type === "agency") {
    prefix = String(editAgencyPrefixSelect?.value || "").trim();
    if (!prefix) {
      setMsg(editGroupMsg, "Select an agency prefix.", false);
      return;
    }
  } else if (type === "county") {
    county = String(editCountySelect?.value || "").trim();
    if (!county) {
      setMsg(editGroupMsg, "Select a county.", false);
      return;
    }
  } else if (type === "region") {
    region = String(editRegionSelect?.value || "").trim();
    if (!region) {
      setMsg(editGroupMsg, "Select a region.", false);
      return;
    }
  } else if (type === "state") {
    state = String(editStateSelect?.value || "").trim().toUpperCase();
    if (!state) {
      setMsg(editGroupMsg, "Select a state.", false);
      return;
    }
  }

  const newName = buildGroupNameFromParts({
    type,
    baseName,
    behavior,
    prefix,
    county,
    region,
    state,
  });

  const newDescription = String(editGroupDescriptionInput.value || "").trim();
  const newPrivate = (IS_GLOBAL_ADMIN && editPrivateSelect && type === "agency")
    ? String(editPrivateSelect.value || "no").trim().toLowerCase()
    : null;

  if (!newName) {
    setMsg(editGroupMsg, "Invalid group name.", false);
    return;
  }

  // Global groups cannot use the mutual-aid reserved prefix
  if (type === "generic") {
    const withoutTak = stripTakPrefix(newName).toLowerCase();
    if (withoutTak.startsWith("ma -")) {
      setMsg(
        editGroupMsg,
        'Global groups cannot start with "MA -". Create mutual aid groups from the Mutual Aid page.',
        false
      );
      return;
    }
  }

  const privateUnchanged = (newPrivate === null) || (newPrivate === editGroupCurrentPrivate);

  if (newName === editGroupCurrentName && newDescription === editGroupCurrentDescription && privateUnchanged) {
    setMsg(editGroupMsg, "No changes made.", true);
    return;
  }

  if (!confirm(`Save changes to "${stripTakPrefix(editGroupCurrentName)}"?`)) return;

  const res = await fetch(`/api/groups/${encodeURIComponent(editGroupCurrentId)}`, {
    method: "PATCH",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({
      name: newName,
      description: newDescription || null,
      private: (IS_GLOBAL_ADMIN && editPrivateSelect && type === "agency")
        ? String(editPrivateSelect.value || "no").trim().toLowerCase()
        : undefined,
    }),
  });

  let out = {};
  try { out = await res.json(); } catch (e) {}

  if (!res.ok) {
    setMsg(editGroupMsg, out.error || "Update failed", false);
    return;
  }

  setMsg(editGroupMsg, `Updated "${stripTakPrefix(newName)}"`, true);
  editGroupCurrentName = newName;
  editGroupCurrentDescription = newDescription;
  if (newPrivate !== null) editGroupCurrentPrivate = newPrivate;
  await loadGroups();
  showEditGroupModal(false);
};

