function memberAgencyLabel(u){
  const abbr = String(
    u?.agency_abbreviation ||
    u?.attributes?.agency_abbreviation ||
    u?.attributes?.agencyAbbreviation ||
    ""
  ).trim();
  const name = String(u?.agency_name || u?.attributes?.agency_name || u?.agency || "").trim();
  if (abbr && name && name.toLowerCase() !== abbr.toLowerCase()) return { abbr, name };
  if (abbr) return { abbr, name: "" };
  if (name) return { abbr: name, name: "" };
  return { abbr: "", name: "" };
}

function memberTemplateLabel(u){
  const raw = String(u?.current_template || u?.attributes?.current_template || "").trim();
  if (!raw || raw.toLowerCase() === "manual group selection") return "";
  return raw;
}

function memberSortValue(u, key){
  if (key === "agency") {
    const agency = memberAgencyLabel(u);
    return String(agency.name || agency.abbr || "").toLowerCase();
  }
  if (key === "template") return memberTemplateLabel(u).toLowerCase();
  return String(u?.[key] || "").toLowerCase();
}

function renderMembersList(){
  if (!membersList) return;
  const items = (activeMembers || []).slice().sort((a, b) => {
    const ak = memberSortValue(a, membersSortKey);
    const bk = memberSortValue(b, membersSortKey);
    if (ak < bk) return membersSortDir === "asc" ? -1 : 1;
    if (ak > bk) return membersSortDir === "asc" ? 1 : -1;
    return String(a.username || "").localeCompare(String(b.username || ""));
  });

  if (!items.length) {
    membersList.innerHTML = `<div class="muted" style="padding:10px;">${
      membersQuery ? "No members match your search." : "No members in this group."
    }</div>`;
    return;
  }

  const sortArrow = (key) => {
    if (membersSortKey !== key) return "";
    return membersSortDir === "asc" ? " ▲" : " ▼";
  };

  const rowsHtml = items.map(u => {
    const agency = memberAgencyLabel(u);
    const template = memberTemplateLabel(u);
    const active = u.is_active !== false;
    const email = String(u.email || "").trim();
    return `
    <tr class="${active ? "" : "membersRowDisabled"}">
      <td class="membersUserCell" data-label="User">
        <div class="membersUserName">${esc(u.username || "")}</div>
        <div class="muted membersUserMeta">${esc(u.name || "—")}</div>
        ${email ? `<div class="muted membersUserMeta">${esc(email)}</div>` : ""}
      </td>
      <td class="membersAgencyCell" data-label="Agency">${esc(agency.name || agency.abbr || "—")}</td>
      <td class="membersTemplateCell" data-label="Template">${esc(template || "—")}</td>
      <td class="membersRemoveCell" data-label="Actions">
        <button class="btn danger" type="button"
          onclick="removeUserFromGroup('${esc(u.pk)}')">Remove</button>
      </td>
    </tr>
  `;
  }).join("");

  membersList.innerHTML = `
    <table class="table membersTable">
      <thead>
        <tr>
          <th><span style="cursor:pointer;" onclick="setMembersSort('username')">User${sortArrow('username')}</span></th>
          <th><span style="cursor:pointer;" onclick="setMembersSort('agency')">Agency${sortArrow('agency')}</span></th>
          <th><span style="cursor:pointer;" onclick="setMembersSort('template')">Template${sortArrow('template')}</span></th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        ${rowsHtml}
      </tbody>
    </table>
  `;
}

function renderMembersPagination() {
  const total = Number(membersTotalCount || 0);
  const size = Math.max(1, Number(membersPageSize || 100));
  const totalPages = total > 0 ? Math.max(1, Math.ceil(total / size)) : 1;
  const wrap = document.getElementById("membersPagination");
  if (wrap) wrap.style.display = total > size ? "flex" : "none";
  if (membersPageInfo) membersPageInfo.textContent = `Page ${membersCurrentPage} of ${totalPages}`;
  if (membersFirstBtn) membersFirstBtn.disabled = membersCurrentPage <= 1 || !membersHasPrev;
  if (membersLastBtn) membersLastBtn.disabled = membersCurrentPage >= totalPages || !membersHasNext;
  if (membersPrevBtn) membersPrevBtn.disabled = !membersHasPrev;
  if (membersNextBtn) membersNextBtn.disabled = !membersHasNext;

  if (membersRange) {
    if (!total) {
      membersRange.textContent = "";
    } else {
      const start = (membersCurrentPage - 1) * size + 1;
      const end = Math.min(membersCurrentPage * size, total);
      membersRange.textContent = `${start}–${end} of ${total}`;
    }
  }
}

async function loadMembersPage(page) {
  if (!activeMembersGroupId) return;
  const targetPage = Math.max(1, Number(page || 1));
  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";

  const params = new URLSearchParams({
    page: String(targetPage),
    pageSize: String(membersPageSize),
  });
  if (membersQuery) params.set("q", membersQuery);

  const res = await fetch(
    `/api/groups/${encodeURIComponent(activeMembersGroupId)}/members?${params.toString()}`
  );
  const out = await res.json();
  if (!res.ok) throw new Error(out.error || "Failed to load members");

  activeMembers = Array.isArray(out.users) ? out.users : [];
  membersCurrentPage = Number(out.page || targetPage || 1);
  membersPageSize = Number(out.pageSize || membersPageSize || 100);
  membersTotalCount = Number(out.memberCount || activeMembers.length || 0);
  membersHasNext = !!out.hasNext;
  membersHasPrev = !!out.hasPrev;

  const groupLabel = stripTakPrefix(String(activeMembersGroupName || out.group?.name || activeMembersGroupId || ""));
  if (membersQuery) {
    membersSummary.textContent = `${membersTotalCount} member${membersTotalCount === 1 ? "" : "s"} matching "${membersQuery}" in "${groupLabel}".`;
  } else {
    membersSummary.textContent = `${membersTotalCount} member${membersTotalCount === 1 ? "" : "s"} in "${groupLabel}".`;
  }
  membersSummary.className = "msg ok";

  renderMembersList();
  renderMembersPagination();
}

async function refreshMembersAfterMass() {
  if (!activeMembersGroupId) return;
  try {
    await loadMembersPage(membersCurrentPage || 1);
  } catch (_) {}
}

window.openGroupMembers = async (groupId) => {
