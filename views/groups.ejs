/** Which create/edit group types have underlying data available. */
function getGroupTypeAvailability() {
  const agencies = Array.isArray(agenciesCache) ? agenciesCache : [];
  const regions = Array.isArray(regionsCache) ? regionsCache : [];
  return {
    agency: agencies.some(
      (a) => String(a.groupPrefix || "").trim() || String(a.suffix || "").trim()
    ),
    county: agencies.some((a) => String(a.county || "").trim()),
    region: regions.some((r) => String(r?.name || "").trim()),
    state: agencies.some((a) => String(a.state || "").trim()),
    generic: true,
  };
}

function applyTypeOptionVisibility(select, { forceShow } = {}) {
  if (!select || select.disabled) return;
  const avail = getGroupTypeAvailability();
  const force = String(forceShow || "").trim().toLowerCase();
  Array.from(select.options).forEach((opt) => {
    const v = String(opt.value || "").trim().toLowerCase();
    if (v === "generic") {
      opt.hidden = false;
      opt.disabled = false;
      return;
    }
    const show = !!avail[v] || (force && v === force);
    opt.hidden = !show;
    opt.disabled = !show;
  });
  const selected = select.options[select.selectedIndex];
  if (selected && (selected.hidden || selected.disabled)) {
    const first = Array.from(select.options).find((o) => !o.hidden && !o.disabled);
    if (first) {
      select.value = first.value;
      if (typeof select.onchange === "function") select.onchange();
    }
  }
}

function updateCreateEditTypeOptions(forceEditType) {
  applyTypeOptionVisibility(createType);
  applyTypeOptionVisibility(editType, { forceShow: forceEditType });
}

function agencyItems(){
  return agenciesCache
    .filter(a => String(a.suffix || "").trim())
    .slice()
    .sort((a,b)=>String(a.name||"").localeCompare(String(b.name||"")))
    .map(a => {
      const sfx = String(a.suffix || "").trim().toLowerCase();
      const prefix = String(a.groupPrefix || "").trim();
      return { name: String(a.name || ""), suffix: sfx, prefix };
    });
}

// Parse a full group name into type/prefix/county/baseName/behavior
function parseGroupName(fullName) {
  let name = String(fullName || "").trim();
  // Remove mandatory tak_ prefix before parsing
  name = stripTakPrefix(name);
  let behavior = "both";

  // Strip behavior suffix first
  if (name.endsWith("_READ")) {
    behavior = "read";
    name = name.slice(0, -5);
  } else if (name.endsWith("_WRITE")) {
    behavior = "write";
    name = name.slice(0, -6);
  }

  let type = "generic";
  let agencyPrefix = "";
  let county = "";
  let region = "";
  let state = "";
  let baseName = name;

  // Try to split on " - "
  const dashIdx = name.indexOf(" - ");
  if (dashIdx > 0) {
    const left = name.slice(0, dashIdx).trim();
    const right = name.slice(dashIdx + 3).trim();
    // County groups are formatted like "<County> Co - <Title>".
    // Normalize the left side so we can correctly detect/edit them.
    const leftNoCo = left.replace(/\s+co\s*$/i, "").trim();
    const leftUpper = left.toUpperCase();
    const leftNoCoUpper = leftNoCo.toUpperCase();

    // Check for agency short name (exact left side, case-insensitive)
    const agencyMatch = (agenciesCache || []).find(a =>
      String(a.groupPrefix || "").trim().toUpperCase() === leftUpper
    );

    if (agencyMatch) {
      type = "agency";
      agencyPrefix = String(agencyMatch.groupPrefix || "").trim() || left;
      baseName = right || "";
    } else {
      // Try County (compare uppercase)
      const countySet = new Set(
        (agenciesCache || [])
          .map(a => String(a.county || "").trim())
          .filter(Boolean)
          .map(c => c.toUpperCase())
      );
      if (countySet.has(leftNoCoUpper) || countySet.has(leftUpper)) {
        type = "county";
        // Use canonical casing from agenciesCache so the dropdown value matches.
        const canonical = (agenciesCache || [])
          .map(a => String(a.county || "").trim())
          .filter(Boolean)
          .find(c => c.toUpperCase() === leftNoCoUpper);
        county = canonical || leftNoCo || left; // keep original case for the dropdown
        baseName = right || "";
      } else {
  // Try State (compare uppercase; only allow states that exist in agenciesCache)
  const stateSet = new Set(
    (agenciesCache || [])
      .map(a => String(a.state || "").trim())
      .filter(Boolean)
      .map(s => s.toUpperCase())
  );
  if (stateSet.has(leftUpper) || stateSet.has(leftNoCoUpper)) {
    type = "state";
    state = leftUpper; // store as uppercase abbreviation
    baseName = right || "";
  } else {

        // Fallback: treat everything as base name
        baseName = name;
      }
      }
    }
  } else {
    baseName = name;
  }


  // Fallback parse for new format without " - "
  // Agency: "<PREFIX> <Title>" — longest short-name match (supports spaces)
  if (type === "generic") {
    const upperName = name.toUpperCase();
    const agencyPrefixes = (agenciesCache || [])
      .map((a) => String(a.groupPrefix || "").trim())
      .filter(Boolean)
      .sort((a, b) => b.length - a.length);
    const hit = agencyPrefixes.find((pfx) =>
      upperName.startsWith(pfx.toUpperCase() + " ")
    );
    if (hit) {
      type = "agency";
      agencyPrefix = hit;
      baseName = name.slice(hit.length + 1).trim();
    }
  }

  // County: "<County> Co <Title>"
  if (type === "generic") {
    const counties = Array.from(new Set(
      (agenciesCache || [])
        .map(a => String(a.county || "").trim())
        .filter(Boolean)
    )).sort((a,b)=>b.length - a.length); // longest first
    const hitCounty = counties.find(cn => name.toLowerCase().startsWith((cn + " Co ").toLowerCase()));
    if (hitCounty) {
      type = "county";
      county = hitCounty;
      baseName = name.slice((hitCounty + " Co ").length).trim();
    }
  }
  // Region: "<Region Name> <Title>" (longest match first)
  if (type === "generic") {
    const regions = (regionsCache || [])
      .map((r) => String(r?.name || "").trim())
      .filter(Boolean)
      .sort((a, b) => b.length - a.length);
    const hitRegion = regions.find((rn) =>
      name.toLowerCase().startsWith((rn + " ").toLowerCase())
    );
    if (hitRegion) {
      type = "region";
      region = hitRegion;
      baseName = name.slice(hitRegion.length + 1).trim();
    }
  }
  // State: "<State> <Title>"
  if (type === "generic") {
    const states = Array.from(new Set(
      (agenciesCache || [])
        .map(a => String(a.state || "").trim())
        .filter(Boolean)
    )).sort((a,b)=>b.length - a.length); // longest first

    const hitState = states.find(st =>
      name.toUpperCase().startsWith(st.toUpperCase() + " ")
    );

    if (hitState) {
      type = "state";
      state = hitState.toUpperCase();
      baseName = name.slice(hitState.length + 1).trim();
    }
  }

  return { type, agencyPrefix, county, region, state, baseName, behavior };
}

function normalizeCreatedType(raw) {
  return String(raw || "").trim().toLowerCase();
}

/** Scope bucket for Existing Groups filters (agency / county / region / state / global). */
function getPortalGroupScope(g) {
  const parsed = parseGroupName(g?.name || "");
  const createdType = normalizeCreatedType(g?.attributes?.created_type);

  // Name patterns win for scoped types (fixes legacy groups mis-tagged as Global).
  if (
    parsed.type === "agency" ||
    parsed.type === "county" ||
    parsed.type === "region" ||
    parsed.type === "state"
  ) {
    return parsed.type;
  }

  if (
    createdType === "agency" ||
    createdType === "county" ||
    createdType === "region" ||
    createdType === "state"
  ) {
    return createdType;
  }
  if (createdType === "global") return "global";

  return "global";
}

function getPortalGroupStateDetail(g) {
  const parsed = parseGroupName(g?.name || "");
  if (parsed.type === "state" && parsed.state) {
    return String(parsed.state).trim().toUpperCase();
  }
  if (normalizeCreatedType(g?.attributes?.created_type) === "state") {
    return String(g?.attributes?.created_type_detail || "").trim().toUpperCase();
  }
  return "";
}

function getPortalGroupCountyDetail(g) {
  const parsed = parseGroupName(g?.name || "");
  if (parsed.type === "county" && parsed.county) {
    return String(parsed.county).trim();
  }
  if (normalizeCreatedType(g?.attributes?.created_type) === "county") {
    return String(g?.attributes?.created_type_detail || "").trim();
  }
  return "";
}

function getPortalGroupRegionDetail(g) {
  const parsed = parseGroupName(g?.name || "");
  if (parsed.type === "region" && parsed.region) {
    return String(parsed.region).trim();
  }
  if (normalizeCreatedType(g?.attributes?.created_type) === "region") {
    return String(g?.attributes?.created_type_detail || "").trim();
  }
  return "";
}

function getPortalGroupAgencyPrefixDetail(g) {
  if (normalizeCreatedType(g?.attributes?.created_type) === "agency") {
    const detail = String(g?.attributes?.created_type_detail || "").trim();
    if (detail) {
      const byName = agenciesCache.find(
        (a) => String(a.name || "").trim().toLowerCase() === detail.toLowerCase()
      );
      if (byName) return String(byName.groupPrefix || "").trim();
      return detail;
    }
  }
  const parsed = parseGroupName(g?.name || "");
  if (parsed.type === "agency" && parsed.agencyPrefix) {
    return String(parsed.agencyPrefix).trim();
  }
  return "";
}

function getPortalGroupAgencyNameDetail(g) {
  if (normalizeCreatedType(g?.attributes?.created_type) === "agency") {
    return String(g?.attributes?.created_type_detail || "").trim();
  }
  const prefix = getPortalGroupAgencyPrefixDetail(g);
  if (!prefix) return "";
  const match = agenciesCache.find(
    (a) =>
      String(a.groupPrefix || "").trim().toLowerCase() === prefix.toLowerCase()
  );
  return match ? String(match.name || "").trim() : "";
}

// Build a full group name from broken-out fields
function buildGroupNameFromParts({ type, baseName, behavior, prefix, county, region, state }) {
  let name = String(baseName || "").trim();
  if (!name) return "";

  const b = String(behavior || "both").toLowerCase();
  if (b === "read") name += "_READ";
  else if (b === "write") name += "_WRITE";

  if (type === "agency") {
    const p = String(prefix || "").trim();
    if (!p) return "";
    name = `${p} ${name}`;
  } else if (type === "county") {
    const c = String(county || "").trim();
    if (!c) return "";
    name = `${c} Co ${name}`;
  } else if (type === "region") {
    const r = String(region || "").trim();
    if (!r) return "";
    name = `${r} ${name}`;
  } else if (type === "state") {
    const s = String(state || "").trim().toUpperCase();
    if (!s) return "";
    name = `${s} ${name}`;
  }

  return ensureTakPrefix(name);
}

function isGroupEditable(groupOrName){
  <% if (isGlobalAdmin) { %>
  return true;
  <% } %>

  // Prefer full group object (attribute ownership); accept name string for legacy callers.
  if (groupOrName && typeof groupOrName === "object") {
    const detail = String(groupOrName?.attributes?.created_type_detail || "").trim();
    const createdType = normalizeCreatedType(groupOrName?.attributes?.created_type);
    if (createdType === "agency" && detail) {
      return agenciesCache.some(
        (a) => String(a.name || "").trim().toLowerCase() === detail.toLowerCase()
      );
    }
  }

  const raw = String(
    (groupOrName && typeof groupOrName === "object"
      ? groupOrName.name
      : groupOrName) || ""
  ).trim();
  if (!raw) return false;

  const n = stripTakPrefix(raw);
  const prefixes = agenciesCache
    .map((a) => String(a.groupPrefix || "").trim())
    .filter(Boolean)
    .sort((a, b) => b.length - a.length);
  const nUpper = n.toUpperCase();
  return prefixes.some((prefix) => {
    const p = prefix.toUpperCase();
    return (
      nUpper.startsWith(p + " ") ||
      nUpper.startsWith(p + "-") ||
      nUpper.startsWith(p + " -")
    );
  });
}

function renderAgencyList(){
  const needle = String(agencySearch.value || "").trim().toLowerCase();
