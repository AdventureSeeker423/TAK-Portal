}

function renderAdminAccessGrid() {
  if (!adminAccessInner) return;

  const sorted = [...adminAccessSelectable].sort((a, b) =>
    adminAccessAgencyLabel(a).localeCompare(adminAccessAgencyLabel(b), undefined, { sensitivity: "base" })
  );

  adminAccessInner.innerHTML = sorted.map(a => {
    const id = String(a.id ?? "");
    const checked = adminAccessPickedIds.has(id) ? "checked" : "";
    const hasAccess = adminAccessPickedIds.has(id);
    const rowStyle = hasAccess
      ? "background: rgba(46, 160, 67, 0.18); border: 1px solid rgba(46, 160, 67, 0.45);"
      : "background: rgba(248, 81, 73, 0.14); border: 1px solid rgba(248, 81, 73, 0.35);";
    return `
      <label class="groupItem" style="${rowStyle}">
        <input type="checkbox" class="adminAccessChk" value="${esc(id)}" ${checked} />
        <span>${esc(adminAccessAgencyLabel(a))}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No agencies found.</div>`;

  adminAccessInner.querySelectorAll("input.adminAccessChk").forEach(cb => {
    cb.addEventListener("change", () => {
      const id = String(cb.value);
      if (cb.checked) adminAccessPickedIds.add(id);
      else adminAccessPickedIds.delete(id);
      renderAdminAccessGrid();
      scheduleAdminAccessSave();
    });
  });
}

function scheduleAdminAccessSave() {
  if (adminAccessSaving) {
    adminAccessSaveQueued = true;
    return;
  }
  if (adminAccessSaveTimer) clearTimeout(adminAccessSaveTimer);
  adminAccessSaveTimer = setTimeout(() => {
    adminAccessSaveTimer = null;
    saveAdminAccess();
  }, 200);
}

async function saveAdminAccess() {
  if (!adminAccessGroupId || adminAccessSaving) {
    if (adminAccessGroupId && adminAccessSaving) adminAccessSaveQueued = true;
    return;
  }

  adminAccessSaving = true;
  setAdminAccessControlsDisabled(true);
  adminAccessSummary.textContent = "Saving...";
  adminAccessSummary.className = "msg";

  const agencyIds = Array.from(adminAccessPickedIds)
    .map(x => Number(x))
    .filter(n => Number.isInteger(n) && n >= 0);

  try {
    const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ agencyIds })
    });
    const out = await res.json();
    if (!res.ok) {
      const errMsg = typeof out.error === "string" ? out.error : (out.error?.message || "Save failed");
      throw new Error(errMsg);
    }

    adminAccessSelectable.forEach(a => {
      const id = String(a.id ?? "");
      a.hasAccess = adminAccessPickedIds.has(id);
    });
    adminAccessSummary.textContent = "Changes saved.";
    adminAccessSummary.className = "msg ok";
  } catch (e) {
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`);
      const data = await res.json();
      if (res.ok) {
        adminAccessSelectable = (Array.isArray(data.agencies) ? data.agencies : []).filter(a => a.selectable !== false);
        adminAccessPickedIds = new Set(
          adminAccessSelectable
            .filter(a => a.hasAccess)
            .map(a => String(a.id ?? ""))
            .filter(Boolean)
        );
        renderAdminAccessGrid();
      }
    } catch (_) {
      // ignore reload failure
    }
    adminAccessSummary.textContent = e.message || "Save failed";
    adminAccessSummary.className = "msg bad";
  } finally {
    adminAccessSaving = false;
    setAdminAccessControlsDisabled(false);
    if (adminAccessSaveQueued) {
      adminAccessSaveQueued = false;
      saveAdminAccess();
    }
  }
}

window.openGroupAdminAccess = async (groupId) => {
  if (!IS_GLOBAL_ADMIN) return;
  adminAccessGroupId = String(groupId || "").trim();
  if (!adminAccessGroupId) return;

  adminAccessSummary.textContent = "Loading agencies...";
  adminAccessSummary.className = "msg";
  if (adminAccessInner) adminAccessInner.innerHTML = "";
  adminAccessPickedIds = new Set();
  adminAccessSelectable = [];
  adminAccessSaveQueued = false;
  if (adminAccessSaveTimer) {
    clearTimeout(adminAccessSaveTimer);
    adminAccessSaveTimer = null;
  }
  showAdminAccessModal(true);

  try {
    const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Failed to load admin access");

    const groupLabel = stripTakPrefix(data.groupName || "");
    adminAccessSelectable = (Array.isArray(data.agencies) ? data.agencies : []).filter(a => a.selectable !== false);
    adminAccessPickedIds = new Set(
      adminAccessSelectable
        .filter(a => a.hasAccess)
        .map(a => String(a.id ?? ""))
        .filter(Boolean)
    );

    adminAccessSummary.textContent = groupLabel
      ? `Select agencies whose administrators can access "${groupLabel}". Changes save automatically.`
      : "Select agencies whose administrators can access this group. Changes save automatically.";
    adminAccessSummary.className = "msg ok";
    renderAdminAccessGrid();
  } catch (e) {
    adminAccessSummary.textContent = e.message || "Failed to load.";
    adminAccessSummary.className = "msg bad";
  }
};

if (adminAccessSelectAllBtn) {
  adminAccessSelectAllBtn.onclick = () => {
    if (adminAccessSaving) return;
    adminAccessSelectable.forEach(a => adminAccessPickedIds.add(String(a.id ?? "")));
    renderAdminAccessGrid();
    saveAdminAccess();
  };
}
if (adminAccessClearBtn) {
  adminAccessClearBtn.onclick = () => {
    if (adminAccessSaving) return;
    adminAccessPickedIds.clear();
    renderAdminAccessGrid();
    saveAdminAccess();
  };
}
if (adminAccessCloseBtn) adminAccessCloseBtn.onclick = () => showAdminAccessModal(false);
if (adminAccessOverlay) {
  adminAccessOverlay.addEventListener("click", e => {
    if (e.target === adminAccessOverlay) showAdminAccessModal(false);
  });
}

(async () => {
  createType.onchange();
  if (editType) editType.onchange();
  initGroupSort();
  await loadAgencies();
  await loadRegions();
  await loadTemplatesForMassModal();
  updateCreateEditTypeOptions();
  updateGroupScopeDetailOptions();
  await loadGroups();
})();
</script>

