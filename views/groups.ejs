massApplyBtn.onclick = async () => {
  setMsg(massMsg, "");
  if (!activeMassGroupId) return setMsg(massMsg, "No target group selected.", false);
  if (groupActionsLocked(activeMassGroupName)) {
    return setMsg(massMsg, `Actions are locked for group ${activeMassGroupName || activeMassGroupId}`, false);
  }

  const mode = selectedMassMode();
  let payload = { groupId: activeMassGroupId, sourceMode: mode };

  if (mode === "agency") {
    const suffixes = Array.from(agencyList.querySelectorAll('input.agencyChk:checked'))
      .map(x => String(x.value).trim().toLowerCase())
      .filter(Boolean);
    if (!suffixes.length) return setMsg(massMsg, "Select one or more agencies.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} all users in ${suffixes.length} agency suffix(es)?`)) return;
    payload.suffixes = suffixes;
  }

  if (mode === "group") {
    const srcIds = Array.from(selectedSourceGroupIds);
    if (!srcIds.length) return setMsg(massMsg, "Select one or more source groups.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} users already in ${srcIds.length} selected group(s)?`)) return;
    payload.sourceGroupIds = srcIds;
  }

  if (mode === "users") {
    const userIds = Array.from(selectedUserIds);
    if (!userIds.length) return setMsg(massMsg, "Select one or more users.", false);
    const actionVerb = massAction === "unassign" ? "unassign" : "assign";
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} ${userIds.length} user(s)?`)) return;
    payload.userIds = userIds;
  }

  if (mode === "template") {
    const templateIndices = Array.from(selectedTemplateIndices);
    if (!templateIndices.length) return setMsg(massMsg, "Select one or more templates.", false);
    const actionVerb = massAction === "unassign" ? "remove" : "add";
    if (!confirm(`${actionVerb === "add" ? "Add" : "Remove"} "${activeMassGroupName}" ${actionVerb === "add" ? "to" : "from"} ${templateIndices.length} template(s)?`)) return;

    try {
      const res = await fetch("/api/templates/bulk-group-update", {
        method: "POST",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify({
          action: actionVerb,
          groupName: activeMassGroupName,
          templateIndices,
        })
      });
      const out = await res.json();
      if (!res.ok) {
        return setMsg(massMsg, out.error || "Template update failed", false);
      }
      await loadTemplatesForMassModal();
      renderTemplateSourceList();
      const sync = out && typeof out.currentTemplateSync === "object" ? out.currentTemplateSync : {};
      const syncMsg = ` Users matched: ${Number(sync.matched || 0)}, updated: ${Number(sync.updated || 0)}, groups updated: ${Number(sync.groupsUpdated || 0)}.`;
      return setMsg(
        massMsg,
        `Updated ${Number(out.updated || 0)} template(s). Skipped ${Number(out.skipped || 0)}.${syncMsg}`,
        true
      );
    } catch (e) {
      return setMsg(massMsg, "Template update failed", false);
    }
  }

  const startEndpoint = massAction === "unassign" ? "/api/groups/mass-unassign/start" : "/api/groups/mass-assign/start";
  const fmtElapsed = (ms) => {
    const sec = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m}:${String(s).padStart(2, "0")}`;
  };

  try {
    const startRes = await fetch(startEndpoint, {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    });
    const startOut = await startRes.json();
    if (!startRes.ok || !startOut?.jobId) {
      return setMsg(massMsg, startOut.error || `Mass ${massAction} failed`, false);
    }

    const startedAt = Date.now();
    setMsg(massMsg, `Preparing... 0 of ? • 0:00`, true);

    let done = false;
    while (!done) {
      const statusRes = await fetch(`/api/groups/mass-jobs/${encodeURIComponent(startOut.jobId)}`);
      const statusOut = await statusRes.json();
      if (!statusRes.ok || !statusOut.success) {
        throw new Error(statusOut.error || "Failed to read mass action status");
      }

      const total = Number(statusOut.total || 0);
      const processed = Number(statusOut.processed || 0);
      const elapsedMs = Date.now() - startedAt;
      const phase = String(statusOut.phase || "");
      const sourceMode = String(statusOut.sourceMode || mode || "agency");

      if (statusOut.status === "running") {
        const loadingLabel =
          sourceMode === "group" ? "Loading groups" :
          sourceMode === "users" ? "Loading users" :
          "Loading agencies";
        const phaseLabel =
          phase === "queued" ? "Preparing" :
          phase === "loading_users" ? loadingLabel :
          phase === "matching" ? "Matching users" :
          phase === "applying" ? "Applying changes" :
          "In Progress";
        if (phase === "queued" || phase === "loading_users") {
          const totalLabel = total > 0 ? String(total) : "?";
          setMsg(massMsg, `${phaseLabel}... ${processed} of ${totalLabel} • ${fmtElapsed(elapsedMs)}`, true);
        } else {
          const totalLabel = total > 0 ? String(total) : "?";
          setMsg(massMsg, `${phaseLabel}... ${processed} of ${totalLabel} • ${fmtElapsed(elapsedMs)}`, true);
        }
        await new Promise(r => setTimeout(r, 800));
        continue;
      }

      if (statusOut.status === "failed") {
        setMsg(massMsg, statusOut.error || `Mass ${massAction} failed`, false);
        done = true;
        continue;
      }

      const result = statusOut.result || {};
      setMsg(
        massMsg,
        `Completed. Matched ${Number(result.matched || 0)} user(s). Updated ${Number(result.updated || 0)}. • ${fmtElapsed(elapsedMs)}`,
        true
      );
      done = true;
    }
  } catch (e) {
    setMsg(massMsg, `Mass ${massAction} failed`, false);
  }
};

if (reloadBtn) reloadBtn.onclick = loadGroups;

// ---- Admin Access modal (global admins: which agencies can see this group) ----
const adminAccessOverlay = document.getElementById("adminAccessOverlay");
const adminAccessCloseBtn = document.getElementById("adminAccessCloseBtn");
const adminAccessSummary = document.getElementById("adminAccessSummary");
const adminAccessInner = document.getElementById("adminAccessInner");
const adminAccessSelectAllBtn = document.getElementById("adminAccessSelectAllBtn");
const adminAccessClearBtn = document.getElementById("adminAccessClearBtn");

let adminAccessGroupId = null;
let adminAccessSelectable = [];
let adminAccessPickedIds = new Set();
let adminAccessSaving = false;
let adminAccessSaveTimer = null;
let adminAccessSaveQueued = false;

function setAdminAccessControlsDisabled(disabled) {
  if (adminAccessSelectAllBtn) adminAccessSelectAllBtn.disabled = !!disabled;
  if (adminAccessClearBtn) adminAccessClearBtn.disabled = !!disabled;
  if (adminAccessInner) {
    adminAccessInner.querySelectorAll("input.adminAccessChk").forEach(cb => {
      cb.disabled = !!disabled;
    });
  }
}

function showAdminAccessModal(on) {
  if (!adminAccessOverlay) return;
  adminAccessOverlay.style.display = on ? "flex" : "none";
  document.body.style.overflow = on ? "hidden" : "";
}

function adminAccessAgencyLabel(a) {
  const prefix = String(a.groupPrefix || "").trim().toUpperCase();
  const name = String(a.name || "").trim();
  return prefix ? `${name} (${prefix})` : name;
}

function renderAdminAccessGrid() {
  if (!adminAccessInner) return;

  const sorted = [...adminAccessSelectable].sort((a, b) =>
    adminAccessAgencyLabel(a).localeCompare(adminAccessAgencyLabel(b), undefined, { sensitivity: "base" })
  );

  adminAccessInner.innerHTML = sorted.map(a => {
    const id = String(a.id ?? "");
    const checked = adminAccessPickedIds.has(id) ? "checked" : "";
    const hasAccess = adminAccessPickedIds.has(id);
    const rowStyle = hasAccess
      ? "background: rgba(46, 160, 67, 0.18); border: 1px solid rgba(46, 160, 67, 0.45);"
      : "background: rgba(248, 81, 73, 0.14); border: 1px solid rgba(248, 81, 73, 0.35);";
    return `
      <label class="groupItem" style="${rowStyle}">
        <input type="checkbox" class="adminAccessChk" value="${esc(id)}" ${checked} />
        <span>${esc(adminAccessAgencyLabel(a))}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No agencies found.</div>`;

  adminAccessInner.querySelectorAll("input.adminAccessChk").forEach(cb => {
    cb.addEventListener("change", () => {
      const id = String(cb.value);
      if (cb.checked) adminAccessPickedIds.add(id);
      else adminAccessPickedIds.delete(id);
      renderAdminAccessGrid();
      scheduleAdminAccessSave();
    });
  });
}

function scheduleAdminAccessSave() {
  if (adminAccessSaving) {
    adminAccessSaveQueued = true;
    return;
  }
  if (adminAccessSaveTimer) clearTimeout(adminAccessSaveTimer);
  adminAccessSaveTimer = setTimeout(() => {
    adminAccessSaveTimer = null;
    saveAdminAccess();
  }, 200);
}

async function saveAdminAccess() {
  if (!adminAccessGroupId || adminAccessSaving) {
    if (adminAccessGroupId && adminAccessSaving) adminAccessSaveQueued = true;
    return;
  }

  adminAccessSaving = true;
  setAdminAccessControlsDisabled(true);
  adminAccessSummary.textContent = "Saving...";
  adminAccessSummary.className = "msg";

  const agencyIds = Array.from(adminAccessPickedIds)
    .map(x => Number(x))
    .filter(n => Number.isInteger(n) && n >= 0);

  try {
    const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ agencyIds })
    });
    const out = await res.json();
    if (!res.ok) {
      const errMsg = typeof out.error === "string" ? out.error : (out.error?.message || "Save failed");
      throw new Error(errMsg);
    }

    adminAccessSelectable.forEach(a => {
      const id = String(a.id ?? "");
      a.hasAccess = adminAccessPickedIds.has(id);
    });
    adminAccessSummary.textContent = "Changes saved.";
    adminAccessSummary.className = "msg ok";
  } catch (e) {
    try {
      const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`);
      const data = await res.json();
      if (res.ok) {
        adminAccessSelectable = (Array.isArray(data.agencies) ? data.agencies : []).filter(a => a.selectable !== false);
        adminAccessPickedIds = new Set(
          adminAccessSelectable
            .filter(a => a.hasAccess)
            .map(a => String(a.id ?? ""))
            .filter(Boolean)
        );
        renderAdminAccessGrid();
      }
    } catch (_) {
      // ignore reload failure
    }
    adminAccessSummary.textContent = e.message || "Save failed";
    adminAccessSummary.className = "msg bad";
  } finally {
    adminAccessSaving = false;
    setAdminAccessControlsDisabled(false);
    if (adminAccessSaveQueued) {
      adminAccessSaveQueued = false;
      saveAdminAccess();
    }
  }
}

window.openGroupAdminAccess = async (groupId) => {
  if (!IS_GLOBAL_ADMIN) return;
  adminAccessGroupId = String(groupId || "").trim();
  if (!adminAccessGroupId) return;

  adminAccessSummary.textContent = "Loading agencies...";
  adminAccessSummary.className = "msg";
  if (adminAccessInner) adminAccessInner.innerHTML = "";
  adminAccessPickedIds = new Set();
  adminAccessSelectable = [];
  adminAccessSaveQueued = false;
  if (adminAccessSaveTimer) {
    clearTimeout(adminAccessSaveTimer);
    adminAccessSaveTimer = null;
  }
  showAdminAccessModal(true);

  try {
    const res = await fetch(`/api/groups/${encodeURIComponent(adminAccessGroupId)}/admin-access`);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Failed to load admin access");

    const groupLabel = stripTakPrefix(data.groupName || "");
    adminAccessSelectable = (Array.isArray(data.agencies) ? data.agencies : []).filter(a => a.selectable !== false);
    adminAccessPickedIds = new Set(
      adminAccessSelectable
        .filter(a => a.hasAccess)
        .map(a => String(a.id ?? ""))
        .filter(Boolean)
    );

    adminAccessSummary.textContent = groupLabel
      ? `Select agencies whose administrators can access "${groupLabel}". Changes save automatically.`
      : "Select agencies whose administrators can access this group. Changes save automatically.";
    adminAccessSummary.className = "msg ok";
    renderAdminAccessGrid();
  } catch (e) {
    adminAccessSummary.textContent = e.message || "Failed to load.";
    adminAccessSummary.className = "msg bad";
  }
};

if (adminAccessSelectAllBtn) {
  adminAccessSelectAllBtn.onclick = () => {
    if (adminAccessSaving) return;
    adminAccessSelectable.forEach(a => adminAccessPickedIds.add(String(a.id ?? "")));
    renderAdminAccessGrid();
    saveAdminAccess();
  };
}
if (adminAccessClearBtn) {
  adminAccessClearBtn.onclick = () => {
    if (adminAccessSaving) return;
    adminAccessPickedIds.clear();
    renderAdminAccessGrid();
    saveAdminAccess();
  };
}
if (adminAccessCloseBtn) adminAccessCloseBtn.onclick = () => showAdminAccessModal(false);
if (adminAccessOverlay) {
  adminAccessOverlay.addEventListener("click", e => {
    if (e.target === adminAccessOverlay) showAdminAccessModal(false);
  });
}

(async () => {
  createType.onchange();
  if (editType) editType.onchange();
  initGroupSort();
  await loadAgencies();
  await loadTemplatesForMassModal();
  updateGroupScopeDetailOptions();
  await loadGroups();
})();
</script>

