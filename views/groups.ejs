<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1><%
    const agencyOnlyGroupsPage = !isGlobalAdmin && isAgencyAdmin;
    const groupsPageAbbrev = typeof agencyPageTitleAbbrev !== "undefined" ? agencyPageTitleAbbrev : null;
    if (agencyOnlyGroupsPage && groupsPageAbbrev) { %><%= groupsPageAbbrev %> Groups<% }
    else if (agencyOnlyGroupsPage) { %>Agency Groups<% }
    else { %>Groups<% }
  %></h1>

  <div class="card">
  <h2>Create Group</h2>

  <div class="row">
    <% if (isGlobalAdmin) { %>
    <label>Group Type
      <select id="createType">
        <option value="agency" selected>Agency-Specific Group</option>
        <option value="county">County-Specific Group</option>
        <option value="state">State-Specific Group</option>
        <option value="generic">Global Group</option>
      </select>
    </label>
    <% } else { %>
    <select id="createType" disabled style="display:none;">
      <option value="agency" selected>Agency-Specific Group</option>
    </select>
    <% } %>

    <label id="agencyPrefixWrap" style="display:none;">Select Agency
      <select id="agencyPrefixSelect">
        <option value="">Select Agency</option>
      </select>
    </label>

    <label id="countyWrap" style="display:none;">Select County
      <select id="countySelect">
        <option value="">Select County</option>
      </select>
    </label>
<label id="stateWrap" style="display:none;">Select State
  <select id="stateSelect">
    <option value="">Select State</option>
  </select>
</label>

    <label style="flex: 1; min-width: 160px;">Group Name
      <input
        id="groupName"
        placeholder="Group name"
        style="width: 100%;"
      />
    </label>

    <label style="min-width: 220px;">Channel Behavior
      <select id="behaviorSelect" style="min-width: 120px;">
        <option value="both" selected>BOTH - Send and Recieve (default)</option>
        <option value="read">READ - Recieve Only</option>
        <option value="write">WRITE - Send Only</option>
      </select>
    </label>

    <% if (isGlobalAdmin) { %>
    <label id="privateWrap" style="min-width: 220px;">Hide From Agency Admins
      <select id="privateSelect" style="min-width: 120px;">
        <option value="no" selected>No</option>
        <option value="yes">Yes</option>
      </select>
    </label>
    <% } %>

  </div>

  <div class="row" style="margin-top:8px;">
    <label style="flex: 1; min-width: 0;">Group Description
      <input
        id="groupDescription"
        placeholder="One-line description for this group (optional)"
        style="width: 100%;"
      />
    </label>
  </div>

  <div class="row createGroupActionRow" style="margin-top:10px; justify-content:flex-end;">
    <button class="btn createGroupSubmitBtnAlignRight" id="createBtn" type="button">Create New Group</button>
  </div>

  <div id="createMsg" class="msg"></div>
</div>


  <div class="card">
    <div class="row" style="justify-content: space-between; align-items:center;">
      <h2 style="margin:0;">Existing Groups</h2>
    </div>

    <div class="row" style="align-items:center; gap:12px; flex-wrap:wrap;">
      <% if (isGlobalAdmin) { %>
        <label style="min-width: 220px;">
          <select id="groupScopeSelect" aria-label="Group scope filter">
            <option value="all" selected>All Groups</option>
            <option value="agency">Agency Groups</option>
            <option value="county">County Groups</option>
            <option value="state">State Groups</option>
            <option value="global">Global Groups</option>
          </select>
        </label>

        <label id="groupScopeDetailWrap" style="display:none; min-width: 220px;">
          <select id="groupScopeDetailSelect" aria-label="Group scope detail filter"></select>
        </label>
      <% } %>

      <input
        id="filter"
        placeholder="Search Groups"
        style="margin: 10px 0; flex: 1; min-width: 260px; width: auto; box-sizing: border-box;"
      />
    </div>

    <div id="listMsg" class="msg"></div>

    <div class="listCardTableWrap">
      <table class="table listCardTable groupsListTable">
        <thead>
          <tr>
            <th class="sortable" data-key="name">
              Group Name <span class="sortIndicator" aria-hidden="true"></span>
            </th>
            <% if (isGlobalAdmin) { %>
            <th class="sortable groupPrivateCol" data-key="private">
              Private <span class="sortIndicator" aria-hidden="true"></span>
            </th>
            <% } %>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card groupsExportCard">
    <div class="groupsExportCardActions">
      <button type="button" class="btn" id="exportGroupsCsvBtn">Export Groups CSV</button>
    </div>
  </div>
</main>

