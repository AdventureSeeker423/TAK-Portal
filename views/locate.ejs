<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main locate-page">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Locate Persons",
    scopedSuffix: "Locate Persons",
    singleFallbackTitle: "Agency Locate Persons"
  }) %>

  <div class="card">
    <div class="row" style="justify-content: space-between; align-items: center; margin-bottom: 12px;">
      <h2 style="margin: 0;" id="locFormTitle">Create Locator</h2>
      <button class="btn" id="locCancelEditBtn" type="button" style="display:none;">Cancel</button>
    </div>

    <div class="row loc-create-row">
      <label class="loc-field loc-field-title">Title
        <input id="locTitle" type="text" maxlength="120" placeholder="Missing Person" />
      </label>
      <label class="loc-field">Channel
        <select id="locChannel">
          <option value="">Select…</option>
        </select>
      </label>
      <label class="loc-field">Data Sync
        <select id="locMission">
          <option value="">None</option>
        </select>
      </label>
      <label class="loc-field">Color
        <select id="locColor"></select>
      </label>
      <label class="loc-field loc-field-interval">Interval
        <input id="locPing" type="number" min="0" max="86400" value="15" placeholder="0 = once" />
      </label>
      <div class="loc-field loc-drop-wrap">
        <span>Drop Points</span>
        <button
          type="button"
          id="locDropPoints"
          class="settings-toggle is-off"
          aria-pressed="false"
          aria-label="Drop Points"
          disabled
        ></button>
      </div>
    </div>

    <label class="loc-field loc-field-block">Heading
      <input id="locHeading" type="text" maxlength="160" value="<%= defaultLocateHeading %>" />
    </label>
    <label class="loc-field loc-field-block">Message
      <textarea id="locIntro" rows="3"><%= defaultLocateIntro %></textarea>
    </label>

    <div class="loc-fields-head">
      <span>Additional Fields</span>
      <button class="btn" type="button" id="locAddFieldBtn">Add Field</button>
    </div>
    <div id="locFields" class="loc-fields"></div>

    <div class="row loc-create-footer">
      <div id="locFormMsg" class="msg"></div>
      <button class="btn success" type="button" id="locSubmitBtn">Create Locator</button>
    </div>
  </div>

  <div class="card">
    <div class="row" style="justify-content: space-between; align-items:center;">
      <h2 style="margin:0;">Existing Locators</h2>
    </div>
    <div class="row" style="margin: 10px 0;">
      <input id="locFilter" type="search" placeholder="Filter…" style="flex: 1; min-width: 220px;" autocomplete="off" />
    </div>
    <div id="locListMsg" class="msg" style="margin-left:0;"></div>
    <div class="listCardTableWrap locate-table-scroll">
      <table class="table locate-table locate-table-active listCardTable">
        <thead>
          <tr>
            <th>Title</th>
            <th>Channel</th>
            <th>Color</th>
            <th>Status</th>
            <th>Last Fix</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="locTbody"></tbody>
      </table>
    </div>
  </div>

  <details class="card" style="margin-top:1.25rem;">
    <summary style="cursor:pointer;font-weight:600;user-select:none;">
      Archived Locators <span id="archivedCountWrap">(<span id="archivedLocCount">0</span>)</span>
    </summary>
    <div style="margin-top:12px;">
      <div id="archivedListMsg" class="msg" style="margin-left:0;"></div>
      <div class="listCardTableWrap locate-table-scroll" style="margin-top:12px;">
        <table class="table locate-table locate-table-archived listCardTable">
          <thead>
            <tr>
              <th>Title</th>
              <th>Channel</th>
              <th>Color</th>
              <th>Status</th>
              <th>Last Fix</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="locArchivedTbody"></tbody>
        </table>
      </div>
    </div>
  </details>

  <div id="locHistOverlay" class="modalOverlay" style="display:none;" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="locHistTitle" style="width:min(900px,96vw); max-height:85vh; overflow:auto;">
      <div class="modalHeader">
        <h2 id="locHistTitle" style="margin:0;">History</h2>
        <button type="button" class="btn" id="locHistCloseBtn">Close</button>
      </div>
      <div class="modalBody">
        <table class="table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Name</th>
              <th>Position</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody id="locHistTbody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="sendLinkOverlay" class="modalOverlay" style="display:none;" aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="sendLinkModalTitle" style="width:min(480px,96vw);">
      <div class="modalHeader">
        <h2 id="sendLinkModalTitle" style="margin:0;">Send Link</h2>
        <button type="button" class="btn" id="sendLinkCloseBtn">Close</button>
      </div>
      <div class="modalBody">
        <div id="sendLinkSmsWrap">
          <label for="sendLinkPhonesIn">Phone</label>
          <input type="text" id="sendLinkPhonesIn" autocomplete="tel" />
          <div style="margin-top:10px;">
            <button type="button" class="btn success" id="sendLinkSmsBtn">Send SMS</button>
          </div>
        </div>
        <div id="sendLinkEmailWrap">
          <label for="sendLinkRecipientsIn">Email</label>
          <input type="text" id="sendLinkRecipientsIn" autocomplete="email" />
          <div style="margin-top:10px;">
            <button type="button" class="btn success" id="sendLinkEmailBtn">Send Email</button>
          </div>
        </div>
        <div id="sendLinkCopyWrap">
          <button type="button" class="btn" id="sendLinkCopyBtn">Copy Link</button>
        </div>
      </div>
    </div>
  </div>
</main>

<style>
  .locate-page.main { min-width: 0; max-width: 100%; }
  .locate-page .card { min-width: 0; }
  .loc-create-row { align-items: flex-end; gap: 12px; flex-wrap: wrap; }
  .loc-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; flex: 1 1 160px; }
  .loc-field-title { flex: 2 1 220px; }
  .loc-field-interval { flex: 0 1 120px; }
  .loc-field-block { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; }
  .loc-field-block textarea { width: 100%; box-sizing: border-box; resize: vertical; }
  .loc-drop-wrap { display: flex; flex-direction: column; gap: 6px; justify-content: flex-end; flex: 0 0 auto; }
  .loc-drop-wrap .settings-toggle { margin-top: 4px; }
  .loc-fields-head { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; margin-bottom: 8px; font-weight: 600; }
  .loc-fields { display: flex; flex-direction: column; gap: 8px; }
  .loc-field-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; padding: 8px 0; border-top: 1px solid rgba(127,127,127,.18); }
  .loc-field-row select, .loc-field-row input { min-width: 0; }
  .loc-field-type { flex: 0 1 150px; }
  .loc-field-label { flex: 1 1 180px; }
  .loc-field-req { display: flex; flex-direction: column; gap: 6px; }
  .loc-field-options { flex: 1 1 100%; }
  .loc-create-footer { margin-top: 14px; justify-content: flex-end; gap: 14px; align-items: center; flex-wrap: wrap; }
  .loc-create-footer .msg { margin-right: auto; margin-left: 0; }
  #sendLinkOverlay label { display: block; margin-top: 12px; font-weight: 600; }
  #sendLinkOverlay input { width: 100%; box-sizing: border-box; margin-top: 6px; }
  #sendLinkEmailWrap { margin-top: 8px; }
  #sendLinkCopyWrap { margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(127,127,127,.18); }
  .locate-page .locate-actions-cell .btn { margin: 0 4px 4px 0; }
  .locate-page .locate-table-scroll { overflow-x: auto; }
  @media (max-width: 900px) {
    .locate-table.listCardTable thead { display: none; }
    .locate-table.listCardTable tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 12px;
      padding: 10px 12px;
    }
    .locate-table.listCardTable tbody td { display: block; }
    .locate-table.listCardTable tbody td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.75rem;
      opacity: 0.7;
      margin-bottom: 2px;
    }
    .locate-table .cardActionsCell { grid-column: 1 / -1; }
  }
</style>

<script>
(function () {
  var SMS_CONFIGURED = <%= smsConfigured ? "true" : "false" %>;
  var EMAIL_CONFIGURED = <%= emailConfigured ? "true" : "false" %>;
  var TEAM_COLORS = <%- JSON.stringify(teamColors || []) %>;
  var DEFAULT_HEADING = <%- JSON.stringify(defaultLocateHeading) %>;
  var DEFAULT_INTRO = <%- JSON.stringify(defaultLocateIntro) %>;

  var channels = [];
  var editingId = null;
  var locatorsCache = [];
  var sendLinkLoc = null;

  var formTitle = document.getElementById("locFormTitle");
  var cancelBtn = document.getElementById("locCancelEditBtn");
  var titleIn = document.getElementById("locTitle");
  var channelSel = document.getElementById("locChannel");
  var missionSel = document.getElementById("locMission");
  var colorSel = document.getElementById("locColor");
  var pingIn = document.getElementById("locPing");
  var dropBtn = document.getElementById("locDropPoints");
  var headingIn = document.getElementById("locHeading");
  var introIn = document.getElementById("locIntro");
  var fieldsEl = document.getElementById("locFields");
  var formMsg = document.getElementById("locFormMsg");
  var submitBtn = document.getElementById("locSubmitBtn");
  var tbody = document.getElementById("locTbody");
  var archivedTbody = document.getElementById("locArchivedTbody");
  var archivedCountEl = document.getElementById("archivedLocCount");
  var archivedListMsg = document.getElementById("archivedListMsg");
  var listMsg = document.getElementById("locListMsg");
  var filterIn = document.getElementById("locFilter");

  function setMsg(el, text, bad) {
    if (!el) return;
    el.textContent = text || "";
    el.className = "msg" + (text ? (bad ? " bad" : " ok") : "");
  }

  function dropOn() {
    return dropBtn.classList.contains("is-on");
  }
  function setDrop(on, enabled) {
    var allow = !!enabled;
    dropBtn.disabled = !allow;
    if (!allow) on = false;
    dropBtn.classList.toggle("is-on", !!on);
    dropBtn.classList.toggle("is-off", !on);
    dropBtn.setAttribute("aria-pressed", on ? "true" : "false");
  }
  dropBtn.addEventListener("click", function () {
    if (dropBtn.disabled) return;
    setDrop(!dropOn(), true);
  });

  TEAM_COLORS.forEach(function (c) {
    var o = document.createElement("option");
    o.value = c;
    o.textContent = c;
    colorSel.appendChild(o);
  });
  colorSel.value = "Cyan";

  function fieldTypesUsed() {
    var used = {};
    fieldsEl.querySelectorAll("[data-field-type]").forEach(function (sel) {
      var t = sel.value;
      if (t === "firstName" || t === "lastName" || t === "message") used[t] = true;
    });
    return used;
  }

  function syncTypeOptions() {
    var used = fieldTypesUsed();
    fieldsEl.querySelectorAll("[data-field-type]").forEach(function (sel) {
      var cur = sel.value;
      Array.prototype.forEach.call(sel.options, function (opt) {
        if (opt.value === "firstName" || opt.value === "lastName" || opt.value === "message") {
          opt.disabled = used[opt.value] && cur !== opt.value;
        }
      });
    });
  }

  function addFieldRow(preset) {
    preset = preset || {};
    var row = document.createElement("div");
    row.className = "loc-field-row";
    var typeWrap = document.createElement("label");
    typeWrap.className = "loc-field-type";
    typeWrap.textContent = "Type";
    var typeSel = document.createElement("select");
    typeSel.setAttribute("data-field-type", "1");
    [["firstName","First Name"],["lastName","Last Name"],["message","Message"],["text","Text"],["choice","Choice"]].forEach(function (pair) {
      var o = document.createElement("option");
      o.value = pair[0];
      o.textContent = pair[1];
      typeSel.appendChild(o);
    });
    typeSel.value = preset.type || "text";
    typeWrap.appendChild(typeSel);

    var labelWrap = document.createElement("label");
    labelWrap.className = "loc-field-label";
    labelWrap.textContent = "Label";
    var labelIn = document.createElement("input");
    labelIn.type = "text";
    labelIn.setAttribute("data-field-label", "1");
    labelIn.value = preset.label || "";
    labelWrap.appendChild(labelIn);

    var reqWrap = document.createElement("div");
    reqWrap.className = "loc-field-req";
    var reqSpan = document.createElement("span");
    reqSpan.textContent = "Required";
    var reqBtn = document.createElement("button");
    reqBtn.type = "button";
    reqBtn.className = "settings-toggle " + (preset.required ? "is-on" : "is-off");
    reqBtn.setAttribute("aria-pressed", preset.required ? "true" : "false");
    reqBtn.setAttribute("aria-label", "Required");
    reqBtn.addEventListener("click", function () {
      var on = !reqBtn.classList.contains("is-on");
      reqBtn.classList.toggle("is-on", on);
      reqBtn.classList.toggle("is-off", !on);
      reqBtn.setAttribute("aria-pressed", on ? "true" : "false");
    });
    reqWrap.appendChild(reqSpan);
    reqWrap.appendChild(reqBtn);

    var rm = document.createElement("button");
    rm.type = "button";
    rm.className = "btn danger";
    rm.textContent = "Remove";
    rm.addEventListener("click", function () {
      row.remove();
      syncTypeOptions();
    });

    var optWrap = document.createElement("label");
    optWrap.className = "loc-field-options";
    optWrap.textContent = "Options";
    var optIn = document.createElement("input");
    optIn.type = "text";
    optIn.setAttribute("data-field-options", "1");
    optIn.value = Array.isArray(preset.options) ? preset.options.join(", ") : "";
    optWrap.appendChild(optIn);

    function syncChoice() {
      optWrap.style.display = typeSel.value === "choice" ? "" : "none";
    }
    typeSel.addEventListener("change", function () {
      syncTypeOptions();
      syncChoice();
    });
    row.appendChild(typeWrap);
    row.appendChild(labelWrap);
    row.appendChild(reqWrap);
    row.appendChild(rm);
    row.appendChild(optWrap);
    if (preset.id) row.setAttribute("data-field-id", preset.id);
    fieldsEl.appendChild(row);
    syncChoice();
    syncTypeOptions();
  }

  document.getElementById("locAddFieldBtn").addEventListener("click", function () {
    addFieldRow({ type: "text", required: false });
  });

  function collectForm() {
    var fields = [];
    fieldsEl.querySelectorAll(".loc-field-row").forEach(function (row) {
      var type = row.querySelector("[data-field-type]").value;
      var label = row.querySelector("[data-field-label]").value.trim();
      var req = row.querySelector(".settings-toggle").classList.contains("is-on");
      var item = { type: type, label: label, required: req };
      var id = row.getAttribute("data-field-id");
      if (id) item.id = id;
      if (type === "choice") {
        item.options = row.querySelector("[data-field-options]").value.split(",").map(function (s) {
          return s.trim();
        }).filter(Boolean);
      }
      fields.push(item);
    });
    return {
      heading: headingIn.value.trim() || DEFAULT_HEADING,
      intro: introIn.value.trim() || DEFAULT_INTRO,
      fields: fields
    };
  }

  function resetForm() {
    editingId = null;
    formTitle.textContent = "Create Locator";
    submitBtn.textContent = "Create Locator";
    cancelBtn.style.display = "none";
    titleIn.value = "";
    channelSel.value = "";
    channelSel.disabled = false;
    missionSel.disabled = false;
    fillMissions([]);
    colorSel.value = "Cyan";
    pingIn.value = "15";
    setDrop(false, false);
    headingIn.value = DEFAULT_HEADING;
    introIn.value = DEFAULT_INTRO;
    fieldsEl.innerHTML = "";
    setMsg(formMsg, "", false);
  }

  function fillChannels(list) {
    channels = Array.isArray(list) ? list : [];
    var prev = channelSel.value;
    channelSel.innerHTML = '<option value="">Select…</option>';
    channels.forEach(function (c) {
      var o = document.createElement("option");
      o.value = c.name;
      o.textContent = c.displayName || c.name;
      channelSel.appendChild(o);
    });
    if (prev) channelSel.value = prev;
  }

  function fillMissions(list, preferred) {
    var prev = preferred != null ? preferred : missionSel.value;
    missionSel.innerHTML = '<option value="">None</option>';
    (list || []).forEach(function (m) {
      var name = m && m.name ? String(m.name) : "";
      if (!name) return;
      var o = document.createElement("option");
      o.value = name;
      o.textContent = name;
      missionSel.appendChild(o);
    });
    if (prev) missionSel.value = prev;
    setDrop(dropOn(), !!missionSel.value);
  }

  async function loadMissionsForChannel(channel, preferred) {
    if (!channel) {
      fillMissions([]);
      return;
    }
    var res = await fetch("/api/locate/missions?channel=" + encodeURIComponent(channel));
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok || !data.ok) {
      fillMissions([]);
      return;
    }
    fillMissions(data.missions || [], preferred);
  }

  channelSel.addEventListener("change", function () {
    var keep = missionSel.value;
    setDrop(dropOn(), false);
    loadMissionsForChannel(channelSel.value, keep).then(function () {
      setDrop(dropOn() && !!missionSel.value, !!missionSel.value);
    });
  });
  missionSel.addEventListener("change", function () {
    setDrop(dropOn() && !!missionSel.value, !!missionSel.value);
  });

  function publicUrl(slug) {
    return window.location.origin + "/locate/" + encodeURIComponent(slug);
  }

  function statusPill(loc) {
    var pill = document.createElement("span");
    var label = "Inactive";
    var bg = "#3a3a3a";
    var fg = "#ccc";
    if (loc.archived) {
      label = "Archived";
      bg = "#4a4a2a";
      fg = "#eee8a8";
    } else if (!loc.active) {
      label = "Disabled";
    } else if (loc.sharingStoppedByUser) {
      label = "Stopped";
      bg = "#b45309";
      fg = "#ffedd5";
    } else if (loc.hasPositionPing) {
      label = "Active";
      bg = "#1f4d2a";
      fg = "#b8ffc8";
    }
    pill.textContent = label;
    pill.style.cssText = "display:inline-block;padding:2px 10px;border-radius:999px;font-size:0.85rem;background:" + bg + ";color:" + fg + ";";
    return pill;
  }

  function lastFixText(loc) {
    if (!loc.lastCoordsAt) return "—";
    var d = new Date(loc.lastCoordsAt);
    if (isNaN(d.getTime())) return "—";
    return d.toLocaleString();
  }

  function addBtn(wrap, label, onClick, extra) {
    var b = document.createElement("button");
    b.type = "button";
    b.className = extra ? "btn " + extra : "btn";
    b.textContent = label;
    b.addEventListener("click", onClick);
    wrap.appendChild(b);
  }

  function matchesFilter(loc, q) {
    if (!q) return true;
    var hay = [loc.title, loc.channelDisplay, loc.channel, loc.color, loc.slug].join(" ").toLowerCase();
    return hay.indexOf(q) >= 0;
  }

  function renderList() {
    var q = (filterIn.value || "").trim().toLowerCase();
    var active = locatorsCache.filter(function (l) { return !l.archived && matchesFilter(l, q); });
    var archived = locatorsCache.filter(function (l) { return l.archived && matchesFilter(l, q); });
    tbody.innerHTML = "";
    if (!active.length) {
      var tr0 = document.createElement("tr");
      tr0.className = "emptyStateRow";
      var td0 = document.createElement("td");
      td0.colSpan = 6;
      td0.textContent = "No locators.";
      tr0.appendChild(td0);
      tbody.appendChild(tr0);
    } else {
      active.forEach(function (loc) {
        var tr = document.createElement("tr");
        var tdTitle = document.createElement("td");
        tdTitle.className = "cardTitleCell";
        tdTitle.setAttribute("data-label", "Title");
        tdTitle.textContent = loc.title || "";
        var tdCh = document.createElement("td");
        tdCh.setAttribute("data-label", "Channel");
        tdCh.textContent = loc.channelDisplay || loc.channel || "";
        var tdColor = document.createElement("td");
        tdColor.setAttribute("data-label", "Color");
        tdColor.textContent = loc.color || "";
        var tdSt = document.createElement("td");
        tdSt.setAttribute("data-label", "Status");
        tdSt.appendChild(statusPill(loc));
        var tdFix = document.createElement("td");
        tdFix.setAttribute("data-label", "Last Fix");
        tdFix.textContent = lastFixText(loc);
        var tdAct = document.createElement("td");
        tdAct.className = "locate-actions-cell cardActionsCell";
        var wrap = document.createElement("div");
        wrap.className = "cardActionsRow locate-actions-cell";
        addBtn(wrap, "Send", function () { openSendLink(loc); }, "qr");
        addBtn(wrap, "Edit", function () { beginEdit(loc); });
        addBtn(wrap, "Ping", function () { api("/api/locate/locators/" + encodeURIComponent(loc.id) + "/manual-ping", { method: "POST" }).then(loadLocators).catch(function (e) { setMsg(listMsg, e.message, true); }); });
        addBtn(wrap, "History", function () { openHistory(loc.id); });
        addBtn(wrap, loc.active ? "Disable" : "Enable", function () {
          api("/api/locate/locators/" + encodeURIComponent(loc.id), { method: "PATCH", body: JSON.stringify({ active: !loc.active }) }).then(loadLocators).catch(function (e) { setMsg(listMsg, e.message, true); });
        }, loc.active ? "" : "success");
        addBtn(wrap, "Archive", function () {
          if (!window.confirm("Archive this locator?")) return;
          api("/api/locate/locators/" + encodeURIComponent(loc.id) + "/archive", { method: "POST" }).then(loadLocators).catch(function (e) { setMsg(listMsg, e.message, true); });
        }, "danger");
        tdAct.appendChild(wrap);
        tr.appendChild(tdTitle);
        tr.appendChild(tdCh);
        tr.appendChild(tdColor);
        tr.appendChild(tdSt);
        tr.appendChild(tdFix);
        tr.appendChild(tdAct);
        tbody.appendChild(tr);
      });
    }

    archivedTbody.innerHTML = "";
    if (archivedCountEl) archivedCountEl.textContent = String(archived.length);
    if (!archived.length) {
      var trA = document.createElement("tr");
      trA.className = "emptyStateRow";
      var tdA = document.createElement("td");
      tdA.colSpan = 6;
      tdA.textContent = "No archived locators.";
      trA.appendChild(tdA);
      archivedTbody.appendChild(trA);
    } else {
      archived.forEach(function (loc) {
        var tr = document.createElement("tr");
        var tdTitle = document.createElement("td");
        tdTitle.className = "cardTitleCell";
        tdTitle.setAttribute("data-label", "Title");
        tdTitle.textContent = loc.title || "";
        var tdCh = document.createElement("td");
        tdCh.setAttribute("data-label", "Channel");
        tdCh.textContent = loc.channelDisplay || loc.channel || "";
        var tdColor = document.createElement("td");
        tdColor.setAttribute("data-label", "Color");
        tdColor.textContent = loc.color || "";
        var tdSt = document.createElement("td");
        tdSt.setAttribute("data-label", "Status");
        tdSt.appendChild(statusPill(loc));
        var tdFix = document.createElement("td");
        tdFix.setAttribute("data-label", "Last Fix");
        tdFix.textContent = lastFixText(loc);
        var tdAct = document.createElement("td");
        tdAct.className = "locate-actions-cell cardActionsCell";
        var wrap = document.createElement("div");
        wrap.className = "cardActionsRow locate-actions-cell";
        addBtn(wrap, "History", function () { openHistory(loc.id); });
        addBtn(wrap, "Restore", function () {
          api("/api/locate/locators/" + encodeURIComponent(loc.id) + "/reactivate", { method: "POST" }).then(function () {
            setMsg(archivedListMsg, "Locator restored.", false);
            return loadLocators();
          }).catch(function (e) { setMsg(archivedListMsg, e.message, true); });
        }, "success");
        addBtn(wrap, "Delete", function () {
          if (!window.confirm("Delete this locator?")) return;
          api("/api/locate/locators/" + encodeURIComponent(loc.id), { method: "DELETE" }).then(function () {
            setMsg(archivedListMsg, "Locator deleted.", false);
            return loadLocators();
          }).catch(function (e) { setMsg(archivedListMsg, e.message, true); });
        }, "danger");
        tdAct.appendChild(wrap);
        tr.appendChild(tdTitle);
        tr.appendChild(tdCh);
        tr.appendChild(tdColor);
        tr.appendChild(tdSt);
        tr.appendChild(tdFix);
        tr.appendChild(tdAct);
        archivedTbody.appendChild(tr);
      });
    }
  }

  filterIn.addEventListener("input", renderList);

  function beginEdit(loc) {
    editingId = loc.id;
    formTitle.textContent = "Edit Locator";
    submitBtn.textContent = "Save";
    cancelBtn.style.display = "";
    titleIn.value = loc.title || "";
    channelSel.value = loc.channel || "";
    channelSel.disabled = false;
    missionSel.disabled = false;
    loadMissionsForChannel(loc.channel, loc.mission || "").then(function () {
      missionSel.value = loc.mission || "";
      setDrop(!!loc.dropPoints, !!loc.mission);
    });
    colorSel.value = loc.color || "Cyan";
    pingIn.value = loc.pingIntervalSeconds != null ? String(loc.pingIntervalSeconds) : "15";
    headingIn.value = (loc.form && loc.form.heading) || DEFAULT_HEADING;
    introIn.value = (loc.form && loc.form.intro) || DEFAULT_INTRO;
    fieldsEl.innerHTML = "";
    ((loc.form && loc.form.fields) || []).forEach(function (f) { addFieldRow(f); });
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  cancelBtn.addEventListener("click", resetForm);

  async function api(url, opts) {
    var res = await fetch(url, Object.assign({
      credentials: "same-origin",
      headers: { "Content-Type": "application/json", Accept: "application/json" }
    }, opts || {}));
    var data = await res.json().catch(function () { return {}; });
    if (!res.ok || data.ok === false) throw new Error(data.error || ("HTTP " + res.status));
    return data;
  }

  submitBtn.addEventListener("click", function () {
    var ping = parseInt(String(pingIn.value), 10);
    if (!Number.isFinite(ping) || ping < 0 || ping > 86400) {
      setMsg(formMsg, "Invalid interval.", true);
      return;
    }
    if (ping > 0 && ping < 10) {
      setMsg(formMsg, "Invalid interval.", true);
      return;
    }
    var payload = {
      title: titleIn.value.trim(),
      pingIntervalSeconds: ping,
      color: colorSel.value,
      dropPoints: dropOn(),
      channel: channelSel.value,
      mission: missionSel.value,
      form: collectForm()
    };
    var req;
    if (editingId) {
      req = api("/api/locate/locators/" + encodeURIComponent(editingId), {
        method: "PATCH",
        body: JSON.stringify(payload)
      });
    } else {
      req = api("/api/locate/locators", { method: "POST", body: JSON.stringify(payload) });
    }
    req.then(function () {
      setMsg(formMsg, editingId ? "Saved." : "Created.", false);
      resetForm();
      loadLocators();
    }).catch(function (e) {
      setMsg(formMsg, e.message || String(e), true);
    });
  });

  function openHistory(id) {
    var overlay = document.getElementById("locHistOverlay");
    var tb = document.getElementById("locHistTbody");
    tb.innerHTML = "";
    overlay.style.display = "flex";
    overlay.setAttribute("aria-hidden", "false");
    api("/api/locate/locators/" + encodeURIComponent(id) + "/history").then(function (data) {
      var rows = data.history || [];
      if (!rows.length) {
        var tr = document.createElement("tr");
        var td = document.createElement("td");
        td.colSpan = 4;
        td.textContent = "None.";
        tr.appendChild(td);
        tb.appendChild(tr);
        return;
      }
      rows.forEach(function (h) {
        var tr = document.createElement("tr");
        var t1 = document.createElement("td");
        t1.textContent = h.at ? new Date(h.at).toLocaleString() : "";
        var t2 = document.createElement("td");
        t2.textContent = h.callsign || h.name || "";
        var t3 = document.createElement("td");
        t3.textContent = (h.latitude != null && h.longitude != null) ? (Number(h.latitude).toFixed(5) + ", " + Number(h.longitude).toFixed(5)) : "—";
        var t4 = document.createElement("td");
        t4.textContent = h.remarks || "";
        tr.appendChild(t1); tr.appendChild(t2); tr.appendChild(t3); tr.appendChild(t4);
        tb.appendChild(tr);
      });
    }).catch(function (e) {
      var tr = document.createElement("tr");
      var td = document.createElement("td");
      td.colSpan = 4;
      td.textContent = e.message || "Failed.";
      tr.appendChild(td);
      tb.appendChild(tr);
    });
  }
  document.getElementById("locHistCloseBtn").addEventListener("click", function () {
    document.getElementById("locHistOverlay").style.display = "none";
    document.getElementById("locHistOverlay").setAttribute("aria-hidden", "true");
  });

  function openSendLink(loc) {
    sendLinkLoc = loc;
    document.getElementById("sendLinkSmsWrap").style.display = SMS_CONFIGURED ? "" : "none";
    document.getElementById("sendLinkEmailWrap").style.display = EMAIL_CONFIGURED ? "" : "none";
    document.getElementById("sendLinkPhonesIn").value = "";
    document.getElementById("sendLinkRecipientsIn").value = "";
    document.getElementById("sendLinkOverlay").style.display = "flex";
    document.getElementById("sendLinkOverlay").setAttribute("aria-hidden", "false");
  }
  document.getElementById("sendLinkCloseBtn").addEventListener("click", function () {
    document.getElementById("sendLinkOverlay").style.display = "none";
    document.getElementById("sendLinkOverlay").setAttribute("aria-hidden", "true");
    sendLinkLoc = null;
  });
  document.getElementById("sendLinkCopyBtn").addEventListener("click", function () {
    if (!sendLinkLoc) return;
    var url = publicUrl(sendLinkLoc.slug);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).catch(function () {
        window.prompt("", url);
      });
    } else {
      window.prompt("", url);
    }
  });
  document.getElementById("sendLinkSmsBtn").addEventListener("click", function () {
    if (!sendLinkLoc) return;
    api("/api/locate/locators/" + encodeURIComponent(sendLinkLoc.id) + "/send-link-sms", {
      method: "POST",
      body: JSON.stringify({ phones: document.getElementById("sendLinkPhonesIn").value })
    }).catch(function (e) { window.alert(e.message || String(e)); });
  });
  document.getElementById("sendLinkEmailBtn").addEventListener("click", function () {
    if (!sendLinkLoc) return;
    api("/api/locate/locators/" + encodeURIComponent(sendLinkLoc.id) + "/send-link-email", {
      method: "POST",
      body: JSON.stringify({ recipients: document.getElementById("sendLinkRecipientsIn").value })
    }).catch(function (e) { window.alert(e.message || String(e)); });
  });

  function loadLocators() {
    return api("/api/locate/locators").then(function (data) {
      locatorsCache = data.locators || [];
      if (data.smsConfigured != null) SMS_CONFIGURED = !!data.smsConfigured;
      if (data.emailConfigured != null) EMAIL_CONFIGURED = !!data.emailConfigured;
      renderList();
    }).catch(function (e) {
      setMsg(listMsg, e.message || String(e), true);
    });
  }

  api("/api/locate/meta").then(function (data) {
    fillChannels(data.channels || []);
    if (data.smsConfigured != null) SMS_CONFIGURED = !!data.smsConfigured;
    if (data.emailConfigured != null) EMAIL_CONFIGURED = !!data.emailConfigured;
  }).catch(function (e) {
    setMsg(formMsg, e.message || String(e), true);
  });
  loadLocators();
  setInterval(loadLocators, 8000);
})();
</script>
