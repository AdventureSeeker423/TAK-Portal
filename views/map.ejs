<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Live TAK Map</title>
    <link
      href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/map.css" />
  </head>
  <body>
    <div class="map-shell">
      <div id="map" aria-label="TAK live map"></div>

      <div class="map-offline-banner" id="mapOfflineBanner" hidden>
        Stream disconnected — reload the page to retry.
      </div>

      <header class="map-hud">
        <div class="map-hud-title">
          <h1>Live TAK Map</h1>
          <div class="sub" id="mapStreamHost">Connecting to TAK stream…</div>
        </div>
        <div class="map-hud-center">
          <span class="map-zulu" id="mapZulu">— Z</span>
          <span class="map-counts" id="mapVisibleCounts">0 / 0 visible</span>
        </div>
        <div class="map-hud-actions">
          <div class="map-status" id="mapConnStatus" title="Stream status">
            <span class="map-status-dot" id="mapConnDot"></span>
            <span id="mapConnLabel">Connecting</span>
          </div>
          <select class="map-select" id="mapBasemapSelect" title="Basemap"></select>
          <button type="button" class="map-btn" id="mapFitBtn">Fit visible</button>
          <a class="map-btn" href="/dashboard">Dashboard</a>
        </div>
      </header>

      <button
        type="button"
        class="map-panel-expand map-panel-expand-left"
        id="mapExpandLeft"
        title="Show channels and contacts"
        hidden
      >
        Channels ›
      </button>
      <button
        type="button"
        class="map-panel-expand map-panel-expand-right"
        id="mapExpandRight"
        title="Show marker details"
        hidden
      >
        ‹ Details
      </button>

      <aside class="map-panel map-panel-left" id="mapPanelLeft" aria-label="Channels and contacts">
        <div class="map-panel-tabs">
          <button type="button" class="map-tab active" data-tab="channels">Channels</button>
          <button type="button" class="map-tab" data-tab="contacts">Contacts</button>
          <button type="button" class="map-panel-collapse" id="mapCollapseLeft" title="Collapse panel">‹</button>
        </div>

        <div class="map-tab-panel active" data-panel="channels">
          <div class="map-search map-search-compact">
            <input id="mapLayerSearch" type="search" placeholder="Filter channels…" autocomplete="off" />
          </div>
          <div class="map-layer-actions">
            <button type="button" class="map-link-btn" id="mapGroupsAll">All</button>
            <button type="button" class="map-link-btn" id="mapGroupsNone">None</button>
          </div>
          <div class="map-layer-list" id="mapLayerList"></div>
        </div>

        <div class="map-tab-panel" data-panel="contacts">
          <div class="map-search">
            <input id="mapSearch" type="search" placeholder="Filter callsign or UID…" autocomplete="off" />
          </div>
          <div class="map-marker-list" id="mapMarkerList"></div>
        </div>
      </aside>

      <aside class="map-panel map-panel-right collapsed" id="mapPanelRight" aria-label="Marker details">
        <div class="map-panel-head">
          <h2 id="mapDetailTitle">Details</h2>
          <button type="button" class="map-panel-collapse" id="mapCollapseRight" title="Collapse panel">›</button>
        </div>
        <div class="map-detail-body" id="mapDetail">
          <div class="map-detail-empty">Select a marker to view details.</div>
        </div>
        <div class="map-detail-actions" id="mapDetailActions" hidden>
          <button type="button" class="map-btn map-btn-sm" id="mapCenterBtn">Center</button>
          <button type="button" class="map-btn map-btn-sm" id="mapLockBtn">Lock</button>
          <button type="button" class="map-btn map-btn-sm" id="mapCopyRawBtn">Copy RAW</button>
        </div>
      </aside>

      <footer class="map-coords-bar">
        <span>Cursor: <strong id="mapCursor">—</strong> <span class="map-hint">(right-click to copy)</span></span>
        <span>Zoom: <strong id="mapZoom">—</strong></span>
        <span>Basemap: <strong id="mapBasemapLabel">Dark</strong></span>
        <span id="mapUpdated">Updated —</span>
      </footer>
    </div>

    <script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
    <script src="/map.js" defer></script>
  </body>
</html>
