<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TAK Portal is upgrading its database</title>
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      background: #0f1419;
      color: #e7ecf1;
    }
    .box { width: min(560px, 92vw); text-align: center; }
    h1 { font-size: 1.4rem; font-weight: 650; margin: 0 0 12px; }
    p { color: #9aa7b4; line-height: 1.5; }
    .pct { font-size: 2.4rem; font-weight: 700; margin: 18px 0 8px; }
    .bar {
      height: 10px;
      background: #243040;
      border-radius: 99px;
      overflow: hidden;
    }
    .bar > span {
      display: block;
      height: 100%;
      background: #3b82f6;
      width: 0%;
      transition: width 0.4s ease;
    }
    .file { margin-top: 14px; font-size: 0.9rem; color: #cbd5e1; }
    button {
      margin-top: 18px;
      background: #3b82f6;
      color: white;
      border: 0;
      border-radius: 8px;
      padding: 10px 18px;
      font-size: 0.95rem;
      cursor: pointer;
      display: none;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>TAK Portal is upgrading its database</h1>
    <p>This is a one-time upgrade. The portal will reload when it finishes. You can leave this page open.</p>
    <div class="pct" id="pct">0%</div>
    <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="barwrap">
      <span id="bar"></span>
    </div>
    <p class="file" id="eta">Calculating time remaining…</p>
    <p class="file" id="file"></p>
    <p class="file" id="msg"></p>
    <button type="button" id="retry">Retry import</button>
  </div>
  <script>
    const pctEl = document.getElementById("pct");
    const bar = document.getElementById("bar");
    const barwrap = document.getElementById("barwrap");
    const etaEl = document.getElementById("eta");
    const fileEl = document.getElementById("file");
    const msgEl = document.getElementById("msg");
    const retry = document.getElementById("retry");
    async function tick() {
      try {
        const r = await fetch("/api/system/migration-status", { cache: "no-store" });
        const s = await r.json();
        if (!s.active) {
          window.location.replace("/");
          return;
        }
        const p = Math.max(0, Math.min(100, Number(s.percent) || 0));
        pctEl.textContent = p + "%";
        bar.style.width = p + "%";
        barwrap.setAttribute("aria-valuenow", String(p));
        etaEl.textContent = s.etaLabel || "";
        fileEl.textContent = s.currentFile ? ("Current file: " + s.currentFile) : "";
        msgEl.textContent = s.message || "";
        retry.style.display = s.phase === "failed" ? "inline-block" : "none";
      } catch (e) {}
    }
    retry.addEventListener("click", async () => {
      retry.disabled = true;
      try { await fetch("/api/system/migration-retry", { method: "POST" }); } catch (e) {}
      retry.disabled = false;
      tick();
    });
    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>
