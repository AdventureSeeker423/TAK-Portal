                              <% } %>
                              </select>
                              <input type="hidden" name="signingAdminUsername_<%= agency.suffix %>" data-mou-signing-admin-username value="<%= agencySigningConfig && agencySigningConfig.assignedAdminUsername ? agencySigningConfig.assignedAdminUsername : '' %>" />
                              <input type="hidden" name="signingAdminName_<%= agency.suffix %>" data-mou-signing-admin-name value="<%= agencySigningConfig && agencySigningConfig.assignedAdminName ? agencySigningConfig.assignedAdminName : '' %>" />
                            </label>
                            <label class="mouAssignSigningField" data-mou-signing-email hidden style="display:none;">
                              <span class="muted">Recipient Email</span>
                              <input type="email" name="signingEmail_<%= agency.suffix %>" value="<%= agencySigningConfig && agencySigningConfig.inviteEmail ? agencySigningConfig.inviteEmail : "" %>" placeholder="signer@example.com" />
                            </label>
                            <button type="button" class="btn secondary mouAssignCopyLinkBtn" data-mou-copy-sign-link hidden style="display:none;" data-sign-path="<%= stream.externalSignPaths && stream.externalSignPaths[agency.suffix] ? stream.externalSignPaths[agency.suffix] : '' %>">Copy Link</button>
                            <input type="hidden" name="signingLinkCopied_<%= agency.suffix %>" data-mou-signing-link-copied value="0" />
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </div>

              <div class="msg" data-assignment-status></div>
