<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <div class="row" style="justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
    <div>
      <h1 style="margin-bottom:6px;">MOU / Documents</h1>
      <div class="muted">Review documents, signatures, and user access terms in one place.</div>
    </div>
    <div class="mouActionRow">
      <% if (isGlobalAdmin) { %>
        <a class="btn secondary" href="/admin/mou/compliance">Compliance</a>
      <% } %>
      <a class="btn secondary" href="/setup-my-device">Setup My Device</a>
    </div>
  </div>

  <% if (error) { %>
    <div class="card mouCallout mouCallout--danger">
      <div class="msg bad"><%= error %></div>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="card mouCallout">
      <div class="msg ok"><%= success %></div>
    </div>
  <% } %>

  <% if (isGlobalAdmin) { %>
    <section class="card" style="margin-bottom:14px;">
      <div class="mouSectionHeader">
        <div>
          <h2>Create New MOU Draft</h2>
          <p class="muted">Create the document first. Once deployed, you can activate it serverwide or assign it to specific agencies.</p>
        </div>
      </div>

      <form method="post" action="/admin/mou" enctype="multipart/form-data" class="mouAdminForm" data-mou-draft-form="create">
        <input type="hidden" name="mandatory" value="true" />
        <div class="grid2">
          <label>
            Title
            <input type="text" name="title" required />
          </label>
          <label>
            Content type
            <select name="contentType" data-mou-content-select>
              <option value="html">HTML</option>
              <option value="pdf">PDF upload</option>
            </select>
          </label>
          <label>
            Reminder days
            <input type="number" min="1" name="reminderDays" value="7" />
          </label>
        </div>

        <label data-mou-html-field>
          Draft HTML
          <textarea name="html" rows="16" placeholder="<p>Paste MOU HTML here.</p>"></textarea>
        </label>

        <label data-mou-file-field hidden>
          Upload PDF
          <input type="file" name="contentFile" accept="application/pdf,.pdf" />
        </label>

        <div class="mouFormFooter">
          <button class="btn success" type="submit">Create Draft</button>
        </div>
      </form>
    </section>

    <section class="card" style="margin-bottom:14px;">
      <div class="mouSectionHeader">
        <div>
          <h2>Serverwide User Agreement</h2>
          <p class="muted">Enable or disable the login popup for all non-global-admin users. Responses are not stored.</p>
        </div>
      </div>

      <% const currentAgreement = adminAgreement && adminAgreement.current ? adminAgreement.current : null; %>
      <form method="post" action="/admin/mou/user-agreement/save" class="mouAdminForm">
        <label class="mouCheckboxLabel">
          <input type="checkbox" name="enabled" value="true" <%= adminAgreement && adminAgreement.enabled ? "checked" : "" %> />
          Enable serverwide user agreement popup
        </label>
        <label>
          Title
          <input type="text" name="title" value="<%= currentAgreement ? currentAgreement.title : 'User Agreement' %>" required />
        </label>
        <label>
          Agreement Text
          <textarea name="html" rows="14" required><%- currentAgreement ? currentAgreement.bodyHtml : '<p>I understand that use of this TAK environment is subject to my agency\'s current MOU and local operating policies. I agree to use this access only for authorized mission purposes, to safeguard credentials and shared data, and to follow administrator direction regarding acceptable use and account security.</p>' %></textarea>
        </label>
        <div class="mouFormFooter">
          <button class="btn success" type="submit">Save User Agreement</button>
        </div>
      </form>
    </section>
  <% } %>

  <section class="mouSectionHeader">
    <div>
      <h2>Active documents</h2>
      <p class="muted">Only MOUs visible to your role and agency access are shown here.</p>
    </div>
  </section>

  <% if (!cards || !cards.length) { %>
    <div class="card mouEmptyState">
      <h3>No MOUs available</h3>
      <p class="muted">There are no deployed MOUs in scope for your account right now.</p>
    </div>
  <% } else { %>
    <div class="mouCardGrid">
      <% cards.forEach(function (card) { %>
        <article class="card mouSummaryCard">
          <div class="mouSummaryCard__top">
            <div>
              <div class="mouBadgeRow">
                <span class="mouBadge"><%= card.scopeLabel %></span>
                <span class="mouBadge mouBadge--soft"><%= String(card.deployed && card.deployed.contentType || "html").toUpperCase() %></span>
                <% if (card.stream.mandatory) { %>
                  <span class="mouBadge mouBadge--accent">Required</span>
                <% } %>
              </div>
              <h3><%= card.stream.title %></h3>
              <p class="muted">
                Version v<%= card.deployed ? card.deployed.version : "-" %>
                <% if (card.deployed && card.deployed.deployedAt) { %>
                  • Deployed <%= card.deployed.deployedAt %>
                <% } %>
              </p>
            </div>
            <% if (card.targetAgencies && card.targetAgencies.length) { %>
              <div class="mouMetaPill">
                <strong><%= card.targetAgencies.length %></strong>
                <span><%= card.stream.scopeType === "global" ? "target agencies" : "target agency" %></span>
              </div>
            <% } %>
          </div>

          <% if (card.signatures && card.signatures.length) { %>
            <div class="mouAgencyList">
              <% card.signatures.forEach(function (entry) { %>
                <div class="mouAgencyList__row">
                  <div>
                    <strong><%= entry.agency.name %></strong>
                    <% if (entry.signature) { %>
                      <div class="muted">Signed by <%= entry.signature.signerDisplayName %></div>
                    <% } else { %>
                      <div class="muted">Pending agency signature</div>
                    <% } %>
                  </div>
                  <span class="mouStatus <%= entry.signature ? 'mouStatus--ok' : 'mouStatus--pending' %>">
                    <%= entry.signature ? "Signed" : "Pending" %>
                  </span>
                </div>
              <% }); %>
            </div>
          <% } else if (card.targetAgencies && card.targetAgencies.length) { %>
            <div class="mouTargetList muted">
              Applies to
              <%= card.targetAgencies.map(function (agency) { return agency.name; }).join(", ") %>
            </div>
          <% } %>

          <div class="mouActionRow">
            <% if (card.deployed) { %>
              <a class="btn" href="/mou/view/<%= encodeURIComponent(card.stream.mouId) %>/<%= encodeURIComponent(card.deployed.version) %>">Open</a>
              <a class="btn secondary" href="/mou/file/<%= encodeURIComponent(card.stream.mouId) %>/<%= encodeURIComponent(card.deployed.version) %>?download=1">Download</a>
              <% if (isAgencyAdmin && card.signableAgencyChoices && card.signableAgencyChoices.length && String((settings && settings.MOU_REQUIRE_AGENCY_SIGNATURE) || "true").toLowerCase() === "true") { %>
                <a class="btn secondary" href="/mou/sign/<%= encodeURIComponent(card.stream.mouId) %>/<%= encodeURIComponent(card.deployed.version) %>">
                  <%= card.allSigned ? "Review Signatures" : "Sign / Review" %>
                </a>
              <% } %>
              <% if (isGlobalAdmin) { %>
                <a class="btn secondary" href="/admin/mou/compliance">Compliance</a>
              <% } %>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  <% } %>

  <% if (isGlobalAdmin) { %>
    <section class="card" style="margin-top:14px;">
      <div class="mouSectionHeader">
        <div>
          <h2>Manage MOU Streams</h2>
          <p class="muted">Edit drafts, deploy versions, assign active documents, or delete entire streams.</p>
        </div>
      </div>
      <% if (!adminStreams || !adminStreams.length) { %>
        <div class="mouEmptyState">
          <h3>No MOU streams yet</h3>
          <p class="muted">Create your first draft using the form above.</p>
        </div>
      <% } else { %>
        <div class="mouCardGrid">
          <% adminStreams.forEach(function (stream) { %>
            <% const draft = (stream.versions || []).find(function (entry) { return entry.state === "draft"; }); %>
            <article class="card mouSummaryCard">
              <div class="mouSummaryCard__top">
                <div>
                  <div class="mouBadgeRow">
                    <span class="mouBadge"><%= stream.scopeLabel %></span>
                    <% if (stream.currentDeployed && stream.currentDeployed.contentType) { %>
                      <span class="mouBadge mouBadge--soft"><%= String(stream.currentDeployed.contentType).toUpperCase() %></span>
                    <% } else if (draft && draft.contentType) { %>
                      <span class="mouBadge mouBadge--soft"><%= String(draft.contentType).toUpperCase() %></span>
                    <% } %>
                    <span class="mouBadge mouBadge--accent">Required</span>
                  </div>
                  <h3><%= stream.title %></h3>
                  <p class="muted">Current deployed: <%= stream.currentDeployed ? ("v" + stream.currentDeployed.version) : "None" %> • <%= stream.scopeLabel %></p>
                </div>
                <div class="mouMetaPill">
                  <strong><%= draft ? ("v" + draft.version) : "None" %></strong>
                  <span>draft</span>
                </div>
              </div>

              <% if (stream.currentDeployed) { %>
                <form method="post" action="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/assignments/save" class="mouAdminForm" data-mou-assignment-form>
                  <label class="mouCheckboxLabel">
                    <input type="checkbox" name="serverwide" value="true" <%= stream.assignments && stream.assignments.serverwide ? "checked" : "" %> data-mou-serverwide-toggle />
                    Make active for the whole server
                  </label>

                  <div data-mou-agency-assignment-block <%= stream.assignments && stream.assignments.serverwide ? "hidden" : "" %>>
                    <div class="muted" style="margin-bottom:8px;">Or activate it only for selected agencies:</div>
                    <div class="mouAgencyCheckboxGrid">
                      <% agencies.forEach(function (agency) { %>
                        <label class="mouAgencyCheckbox">
                          <input
                            type="checkbox"
                            name="agencySuffixes"
                            value="<%= agency.suffix %>"
                            <%= stream.assignments && stream.assignments.agencySuffixes && stream.assignments.agencySuffixes.includes(agency.suffix) ? "checked" : "" %>
                          />
                          <span><%= agency.name %></span>
                        </label>
                      <% }); %>
                    </div>
                  </div>

                  <div class="mouFormFooter">
                    <button class="btn success" type="submit">Save Assignment</button>
                  </div>
                </form>
              <% } else { %>
                <div class="mouTargetList muted">Deploy a version before assigning this document.</div>
              <% } %>

              <div class="mouActionRow">
                <% if (draft) { %>
                  <a class="btn" href="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/<%= encodeURIComponent(draft.version) %>/edit">Edit Draft</a>
                <% } else { %>
                  <form method="post" action="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/new-version" style="display:inline;">
                    <button class="btn" type="submit">New Version Draft</button>
                  </form>
                <% } %>
                <% if (stream.currentDeployed) { %>
                  <a class="btn secondary" href="/mou/view/<%= encodeURIComponent(stream.mouId) %>/<%= encodeURIComponent(stream.currentDeployed.version) %>">Open Deployed</a>
                <% } %>
                <form method="post" action="/admin/mou/<%= encodeURIComponent(stream.mouId) %>/delete" style="display:inline;" onsubmit="return confirm('Delete this MOU and all of its versions, signatures, and evidence files?');">
                  <button class="btn danger" type="submit">Delete</button>
                </form>
              </div>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  <% } %>
</main>

<script>
(function () {
  function syncDraftForm(form) {
    if (!form) return;
    var scopeSelect = form.querySelector("[data-mou-scope-select]");
    var agencyField = form.querySelector("[data-mou-agency-field]");
    var agencySelect = agencyField ? agencyField.querySelector("select") : null;
    var contentSelect = form.querySelector("[data-mou-content-select]");
    var htmlField = form.querySelector("[data-mou-html-field]");
    var htmlArea = htmlField ? htmlField.querySelector("textarea") : null;
    var fileField = form.querySelector("[data-mou-file-field]");
    var fileInput = fileField ? fileField.querySelector("input[type='file']") : null;

    function sync() {
      var contentValue = contentSelect ? contentSelect.value : "html";

      if (agencyField) agencyField.hidden = true;
      if (agencySelect) agencySelect.required = false;
      if (htmlField) htmlField.hidden = contentValue !== "html";
      if (htmlArea) htmlArea.required = contentValue === "html";
      if (fileField) fileField.hidden = contentValue !== "pdf";
      if (fileInput) {
        fileInput.required = contentValue === "pdf";
        if (contentValue === "html") fileInput.value = "";
      }
    }

    if (scopeSelect) scopeSelect.addEventListener("change", sync);
    if (contentSelect) contentSelect.addEventListener("change", sync);
    sync();
  }

  function syncAssignmentForm(form) {
    if (!form) return;
    var serverwideToggle = form.querySelector("[data-mou-serverwide-toggle]");
    var agencyBlock = form.querySelector("[data-mou-agency-assignment-block]");

    function sync() {
      var checked = !!(serverwideToggle && serverwideToggle.checked);
      if (agencyBlock) agencyBlock.hidden = checked;
    }

    if (serverwideToggle) serverwideToggle.addEventListener("change", sync);
    sync();
  }

  document.querySelectorAll("[data-mou-draft-form]").forEach(syncDraftForm);
  document.querySelectorAll("[data-mou-assignment-form]").forEach(syncAssignmentForm);
})();
</script>
