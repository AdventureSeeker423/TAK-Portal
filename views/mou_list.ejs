                                <option value="specific_agency_admin" <%= agencySigningMode === "specific_agency_admin" ? "selected" : "" %>>Specific Agency Admin</option>
                                <option value="external_link" <%= agencySigningMode === "external_link" ? "selected" : "" %>>External One-Time Link</option>
