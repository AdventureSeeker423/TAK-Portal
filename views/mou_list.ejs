<script>
(function () {
  var MOU_CREATE_DRAFT_KEY = "mouCreateDraft";

  function setFieldVisible(field, visible) {
    if (!field) return;
    field.hidden = !visible;
    field.style.display = visible ? "" : "none";
  }

  function markExternalLinkCopied(container) {
    if (!container) return;
    container.setAttribute("data-external-link-copied", "true");
    var hidden = container.querySelector("[data-mou-signing-link-copied]");
    if (hidden) hidden.value = "1";
  }

  function resetExternalLinkCopied(container) {
    if (!container) return;
    container.removeAttribute("data-external-link-copied");
    var hidden = container.querySelector("[data-mou-signing-link-copied]");
    if (hidden) hidden.value = "0";
  }

  function applyExternalInvitePaths(assignForm, externalInvites) {
    if (!assignForm || !Array.isArray(externalInvites)) return;
    var bySuffix = {};
    externalInvites.forEach(function (row) {
      bySuffix[String(row.agencySuffix || "").trim().toLowerCase()] = String(row.signPath || "").trim();
    });
    assignForm.querySelectorAll("[data-mou-agency-option]").forEach(function (option) {
      var suffix = String(option.getAttribute("data-agency-suffix") || "").trim().toLowerCase();
      if (!suffix || !bySuffix[suffix]) return;
      option.setAttribute("data-external-sign-path", bySuffix[suffix]);
      var copyBtn = option.querySelector("[data-mou-copy-sign-link]");
      if (copyBtn) copyBtn.setAttribute("data-sign-path", bySuffix[suffix]);
      syncSigningModeFields(option);
    });
  }

  function prepareAssignModalCopy(container) {
    var assignForm = container ? container.closest("[data-mou-assignment-form]") : null;
    if (!assignForm) return Promise.resolve();

    var checkbox = container.querySelector("[data-mou-agency-checkbox]");
    if (!checkbox || !checkbox.checked) {
      return Promise.reject(new Error("Select this agency before copying a sign link."));
    }

    var modeSelect = container.querySelector("[data-mou-signing-mode]");
    if (!modeSelect || String(modeSelect.value || "") !== "external_link") {
      return Promise.reject(new Error("Set signing method to External One-Time Link for this agency."));
    }

    markExternalLinkCopied(container);

    assignForm.querySelectorAll("[data-mou-agency-option]").forEach(function (option) {
      syncAdminHiddenFields(option);
    });

    var invalid = null;
    assignForm.querySelectorAll("[data-mou-agency-option]").forEach(function (option) {
      if (invalid) return;
      if (option.style.display === "none") return;
      var input = option.querySelector("[data-mou-agency-checkbox]");
      if (!input || !input.checked) return;
      var agencyLabel = option.querySelector(".mouAssignAgencyRow__check span");
      var agencyName = agencyLabel ? agencyLabel.textContent.trim() : "selected agency";
      invalid = validateSigningContainer(option, agencyName) || null;
    });
    if (invalid) return Promise.reject(new Error(invalid));

    var payload = new URLSearchParams(new FormData(assignForm));
    return fetch(assignForm.getAttribute("action") + "?format=json&skipNotifications=1", {
      method: "POST",
      headers: {
        Accept: "application/json",
        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
      },
      body: payload.toString(),
    }).then(async function (res) {
      var out = await res.json().catch(function () {
        return {};
      });
      if (!res.ok) {
        throw new Error(out.error || "Failed to save assignment.");
      }
      applyExternalInvitePaths(assignForm, out.externalInvites);
      return out;
    });
  }

  function resolveMouIdFromContainer(container) {
    if (!container) return "";
    var explicit = String(container.getAttribute("data-mou-id") || "").trim();
    if (explicit) return explicit;
    var form = container.closest("[data-mou-assignment-form], [data-mou-signing-form]");
    if (!form) return "";
    var fromForm = String(form.getAttribute("data-mou-id") || "").trim();
    if (fromForm) return fromForm;
    var action = form.getAttribute("action") || "";
    var match = action.match(/\/admin\/mou\/([^/]+)\//);
    return match ? decodeURIComponent(match[1]) : "";
  }

  function ensureExternalSignLink(container, button) {
    var path = String(
      (button && button.getAttribute("data-sign-path")) ||
        container.getAttribute("data-external-sign-path") ||
        ""
    ).trim();
    if (path) return Promise.resolve(path);

    var suffix = String(container.getAttribute("data-agency-suffix") || "").trim().toLowerCase();
    var mouId = resolveMouIdFromContainer(container);
    if (!mouId || !suffix) {
      return Promise.reject(
        new Error("Unable to resolve document/agency for this sign link.")
      );
    }

    var emailInput = container.querySelector("[data-mou-signing-email] input");
    var body = new URLSearchParams();
    var modeSelect = container.querySelector("[data-mou-signing-mode]");
    if (modeSelect) {
      body.set("signingMode", String(modeSelect.value || ""));
    } else if (container.getAttribute("data-mou-signature-row") === "true") {
      body.set("signingMode", "external_link");
    }
    if (emailInput && String(emailInput.value || "").trim()) {
      body.set("signingEmail", String(emailInput.value || "").trim());
    }
    var copiedInput = container.querySelector("[data-mou-signing-link-copied]");
    if (copiedInput && String(copiedInput.value || "").trim() === "1") {
      body.set("signingLinkCopied", "1");
    }

    return fetch(
      "/admin/mou/" +
        encodeURIComponent(mouId) +
        "/signing/" +
        encodeURIComponent(suffix) +
        "/ensure-link",
      {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        },
        body: body.toString(),
      }
    ).then(async function (res) {
      var out = await res.json().catch(function () {
        return {};
      });
      if (!res.ok) {
        throw new Error(out.error || "Unable to create sign link.");
      }
      return String(out.externalSignPath || "").trim();
    });
  }

  function copyExternalSignLink(button) {
    if (!button) return;
    var container = button.closest("[data-mou-agency-option], [data-mou-signing-form], tr[data-mou-signature-row]");
    var defaultLabel = button.textContent || "Copy Link";
    button.disabled = true;
    var prepare = container && container.closest("[data-mou-assignment-form]")
      ? prepareAssignModalCopy(container)
      : Promise.resolve();
    prepare
      .then(function () {
        return ensureExternalSignLink(container, button);
      })
      .then(function (path) {
        if (!path) {
          throw new Error("Unable to create sign link.");
        }
        button.setAttribute("data-sign-path", path);
        if (container) {
          container.setAttribute("data-external-sign-path", path);
          syncSigningModeFields(container);
        }
        var fullUrl = path.indexOf("http") === 0 ? path : window.location.origin + path;
        function onCopied() {
          markExternalLinkCopied(container);
          button.textContent = "Copied";
          window.setTimeout(function () {
            button.textContent = defaultLabel;
          }, 1800);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(fullUrl).then(onCopied).catch(function () {
            window.prompt("Copy this sign link:", fullUrl);
            onCopied();
          });
        }
        window.prompt("Copy this sign link:", fullUrl);
        onCopied();
      })
      .catch(function (err) {
        window.alert(err && err.message ? err.message : "Unable to copy sign link.");
      })
      .finally(function () {
        button.disabled = false;
      });
  }

  function syncAdminHiddenFields(container) {
    var adminSelect = container.querySelector("[data-mou-signing-admin-select]");
    var usernameInput = container.querySelector("[data-mou-signing-admin-username]");
    var nameInput = container.querySelector("[data-mou-signing-admin-name]");
    if (!adminSelect) return;
    var selected = adminSelect.options[adminSelect.selectedIndex];
    var selectedValue = selected ? String(selected.value || "") : "";
    if (usernameInput) {
      usernameInput.value = selected
        ? selected.getAttribute("data-admin-username") ||
          (selectedValue.indexOf("user:") === 0 ? selectedValue.slice(5) : "")
        : "";
    }
    if (nameInput) {
      nameInput.value = selected ? (selected.getAttribute("data-admin-name") || "") : "";
    }
  }

  function loadAgencyAdminOptions(container) {
    var adminSelect = container.querySelector("[data-mou-signing-admin-select]");
    if (!adminSelect || adminSelect.dataset.loaded === "true") return;
    var suffix = container.getAttribute("data-agency-suffix") || "";
    if (!suffix) return;
    adminSelect.dataset.loaded = "loading";
    var preserved = adminSelect.value;
    var preservedUsernameInput = container.querySelector("[data-mou-signing-admin-username]");
    var preservedUsername = preservedUsernameInput
      ? String(preservedUsernameInput.value || "").trim()
      : "";
    fetch("/admin/mou/agency-admins/" + encodeURIComponent(suffix), {
      headers: { Accept: "application/json" },
    })
      .then(function (res) { return res.json(); })
      .then(function (out) {
        var users = Array.isArray(out.users) ? out.users : [];
        adminSelect.innerHTML = '<option value="">Select agency admin...</option>';
          users.forEach(function (user) {
            var opt = document.createElement("option");
            opt.value = user.email || ("user:" + (user.username || ""));
            var label = user.name || user.username || user.email || "Agency Admin";
            if (user.email) {
              label += " (" + user.email + ")";
            } else if (user.username) {
              label += " (portal login)";
            }
            opt.textContent = label;
            opt.setAttribute("data-admin-username", user.username || "");
            opt.setAttribute("data-admin-name", user.name || user.username || "");
            if (preserved && String(opt.value) === String(preserved)) {
              opt.selected = true;
            } else if (
              !preserved &&
              preservedUsername &&
              opt.value === ("user:" + preservedUsername)
            ) {
              opt.selected = true;
            }
            adminSelect.appendChild(opt);
          });
        adminSelect.dataset.loaded = "true";
      })
      .catch(function () {
        adminSelect.dataset.loaded = "error";
      });
  }

  function syncSigningModeFields(container) {
    if (!container) return;
    var modeSelect = container.querySelector("[data-mou-signing-mode]");
    var emailWrap = container.querySelector("[data-mou-signing-email]");
    var adminWrap = container.querySelector("[data-mou-signing-admin]");
    var adminSelect = container.querySelector("[data-mou-signing-admin-select]");
    var copyBtn = container.querySelector("[data-mou-copy-sign-link]");
    if (!modeSelect) return;
    var mode = String(modeSelect.value || "");
    setFieldVisible(emailWrap, mode === "external_link");
    setFieldVisible(adminWrap, mode === "specific_agency_admin");
    if (adminSelect) {
      adminSelect.disabled = mode !== "specific_agency_admin";
      if (mode === "specific_agency_admin") {
        loadAgencyAdminOptions(container);
      }
    }
    if (copyBtn) {
      var path = String(container.getAttribute("data-external-sign-path") || copyBtn.getAttribute("data-sign-path") || "").trim();
      copyBtn.setAttribute("data-sign-path", path);
      setFieldVisible(copyBtn, mode === "external_link");
      if (mode !== "external_link") {
        resetExternalLinkCopied(container);
      }
    }
  }

  function initSigningControls(container) {
    if (!container || container.dataset.signingBound === "true") return;
    container.dataset.signingBound = "true";
    var modeSelect = container.querySelector("[data-mou-signing-mode]");
    var adminSelect = container.querySelector("[data-mou-signing-admin-select]");
    if (modeSelect) {
      modeSelect.addEventListener("change", function () {
        syncSigningModeFields(container);
      });
      syncSigningModeFields(container);
    }
    if (adminSelect) {
      adminSelect.addEventListener("change", function () {
        syncAdminHiddenFields(container);
      });
    }
  }

  function validateSigningContainer(container, labelText) {
    var modeSelect = container.querySelector("[data-mou-signing-mode]");
    var mode = modeSelect ? String(modeSelect.value || "") : "";
    var label = labelText || "this agency";
    if (mode === "external_link") {
      var emailInput = container.querySelector("[data-mou-signing-email] input");
      var hasEmail = emailInput && String(emailInput.value || "").trim();
      var linkCopied =
        container.getAttribute("data-external-link-copied") === "true" ||
        String((container.querySelector("[data-mou-signing-link-copied]") || {}).value || "") === "1";
      if (!hasEmail && !linkCopied) {
        return "Copy the sign link or enter a Recipient Email for External One-Time Link on " + label + ".";
      }
    }
    if (mode === "specific_agency_admin") {
      var adminSelect = container.querySelector("[data-mou-signing-admin-select]");
      if (!adminSelect || !String(adminSelect.value || "").trim()) {
        return "Agency Admin selection is required for Specific Agency Admin on " + label + ".";
      }
    }
    return "";
  }

  function initSigningMethodForm(form) {
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    var statusEl = form.querySelector("[data-signing-status]");
    initSigningControls(form);
    form.addEventListener("submit", function (event) {
      event.preventDefault();
      syncAdminHiddenFields(form);
      var signingError = validateSigningContainer(form, "this agency");
      if (signingError) {
        if (statusEl) {
          statusEl.className = "msg bad";
          statusEl.textContent = signingError;
        }
        return;
      }
      var payload = new URLSearchParams(new FormData(form));
      payload.set("action", "save_resend");
      if (statusEl) {
        statusEl.className = "msg";
        statusEl.textContent = "Saving signing method...";
      }
      fetch(form.getAttribute("action") + "?format=json", {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
        },
        body: payload.toString(),
      }).then(async function (res) {
        var out = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          throw new Error(out.error || "Failed to update signing method.");
        }
        if (out.externalSignPath) {
          form.setAttribute("data-external-sign-path", out.externalSignPath);
          var copyBtn = form.querySelector("[data-mou-copy-sign-link]");
          if (copyBtn) copyBtn.setAttribute("data-sign-path", out.externalSignPath);
          syncSigningModeFields(form);
        }
        window.location.href = out.redirectUrl || "/mou?success=" + encodeURIComponent("Signing method updated.");
      }).catch(function (err) {
        if (statusEl) {
          statusEl.className = "msg bad";
          statusEl.textContent = err && err.message ? err.message : "Failed to update signing method.";
        }
      });
    });
  }

  function getCurrentUrlWithoutFlashParams() {
    try {
      var url = new URL(window.location.href);
      var hadFlash = false;
      ["error", "success"].forEach(function (key) {
        if (url.searchParams.has(key)) {
          url.searchParams.delete(key);
          hadFlash = true;
        }
      });
      if (!hadFlash) return "";
      return url.pathname + (url.searchParams.toString() ? "?" + url.searchParams.toString() : "") + (url.hash || "");
    } catch (_err) {
      return "";
    }
  }

  function clearFlashQueryParams() {
    if (!window.history || typeof window.history.replaceState !== "function") return;
    var nextUrl = getCurrentUrlWithoutFlashParams();
    if (!nextUrl) return;
    window.history.replaceState({}, document.title, nextUrl);
  }

  function readCreateDraft() {
    try {
      if (!window.sessionStorage) return null;
      var raw = window.sessionStorage.getItem(MOU_CREATE_DRAFT_KEY);
      if (!raw) return null;
      var parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : null;
    } catch (_err) {
      return null;
    }
  }

  function writeCreateDraft(value) {
    try {
      if (!window.sessionStorage) return;
      window.sessionStorage.setItem(MOU_CREATE_DRAFT_KEY, JSON.stringify(value || {}));
    } catch (_err) {}
  }

  function clearCreateDraft() {
    try {
      if (!window.sessionStorage) return;
      window.sessionStorage.removeItem(MOU_CREATE_DRAFT_KEY);
    } catch (_err) {}
  }

  function openOverlay(overlay) {
    if (!overlay) return;
    overlay.style.display = "flex";
    document.body.style.overflow = "hidden";
  }

  function closeOverlay(overlay) {
    if (!overlay) return;
    overlay.style.display = "none";
    var anyOpen = Array.from(document.querySelectorAll(".modalOverlay")).some(function (item) {
      return item.style.display !== "none";
    });
    if (!anyOpen) document.body.style.overflow = "";
  }

  function syncContentFields(form) {
    if (!form) return;
    var contentSelect = form.querySelector("[data-mou-content-select]");
    var richtextField = form.querySelector("[data-mou-richtext-field]");
    var richtextArea = form.querySelector("[data-mou-richtext-input]");
    var richtextLabel = form.querySelector("[data-mou-richtext-label]");
    var fileField = form.querySelector("[data-mou-file-field]");
    var fileInput = fileField ? fileField.querySelector("input[type='file']") : null;

    function sync() {
      var contentValue = contentSelect ? contentSelect.value : "markdown";
      setFieldVisible(richtextField, contentValue !== "pdf");
      if (richtextArea) {
        richtextArea.required = contentValue !== "pdf";
        richtextArea.placeholder = contentValue === "markdown"
          ? "# Paste Document Markdown here"
          : "<p>Paste Document HTML here.</p>";
      }
      if (richtextLabel) {
        richtextLabel.textContent = contentValue === "markdown" ? "Document Markdown" : "Document HTML";
      }
      setFieldVisible(fileField, contentValue === "pdf");
      if (fileInput) {
        fileInput.required = contentValue === "pdf";
        if (contentValue !== "pdf") fileInput.value = "";
      }
    }

    if (contentSelect) contentSelect.addEventListener("change", sync);
    sync();
  }

  function getCustomFieldLabels(editorRoot) {
    if (!editorRoot) return [];
    return Array.from(
      editorRoot.querySelectorAll("[data-custom-field-row] input[name='customFieldLabels']")
    )
      .map(function (input) { return String(input.value || "").trim(); })
      .filter(Boolean);
  }

  function initCustomFieldEditor(editorRoot, options) {
    if (!editorRoot || editorRoot.__mouCustomFieldBound) return;
    editorRoot.__mouCustomFieldBound = true;
    var rowsWrap = editorRoot.querySelector("[data-custom-field-rows]");
    var addBtn = editorRoot.querySelector("[data-custom-field-add]");
    var template = editorRoot.querySelector("[data-custom-field-template]");
    var onChange = options && typeof options.onChange === "function"
      ? options.onChange
      : function () {};

    function bindRow(row) {
      if (!row) return;
      var input = row.querySelector("input[name='customFieldLabels']");
      var removeBtn = row.querySelector("[data-custom-field-remove]");
      if (input) input.addEventListener("input", onChange);
      if (removeBtn) {
        removeBtn.addEventListener("click", function () {
          row.remove();
          onChange();
        });
      }
    }

    function addRow(value) {
      if (!rowsWrap || !template || !template.content.firstElementChild) return;
      var row = template.content.firstElementChild.cloneNode(true);
      var input = row.querySelector("input[name='customFieldLabels']");
      if (input && value) input.value = String(value);
      rowsWrap.appendChild(row);
      bindRow(row);
      onChange();
    }

    Array.from(rowsWrap ? rowsWrap.querySelectorAll("[data-custom-field-row]") : []).forEach(bindRow);
    if (addBtn) {
      addBtn.addEventListener("click", function () {
        addRow("");
      });
    }
    editorRoot.__mouAddCustomFieldRow = addRow;
  }

  function syncCreateFormDraft(form) {
    if (!form) return;
    var titleInput = form.querySelector('input[name="title"]');
    var contentSelect = form.querySelector("[data-mou-content-select]");
    var richtextArea = form.querySelector("[data-mou-richtext-input]");
    var customFieldEditor = form.querySelector("[data-custom-field-editor]");
    var successVisible = !!document.querySelector(".mouCallout .msg.ok");
    var errorVisible = !!document.querySelector(".mouCallout--danger .msg.bad");

    initCustomFieldEditor(customFieldEditor, { onChange: saveDraft });

    function saveDraft() {
      writeCreateDraft({
        title: titleInput ? String(titleInput.value || "") : "",
        contentType: contentSelect ? String(contentSelect.value || "markdown") : "markdown",
        html: richtextArea ? String(richtextArea.value || "") : "",
        customFieldLabels: getCustomFieldLabels(customFieldEditor),
      });
    }

    if (successVisible) {
      clearCreateDraft();
    } else {
      var draft = readCreateDraft();
      if (draft) {
        if (titleInput && !String(titleInput.value || "").trim()) {
          titleInput.value = String(draft.title || "");
        }
        if (contentSelect && draft.contentType) {
          contentSelect.value = String(draft.contentType || "markdown");
          contentSelect.dispatchEvent(new Event("change", { bubbles: true }));
        }
        if (richtextArea && !String(richtextArea.value || "")) {
          richtextArea.value = String(draft.html || "");
        }
        if (customFieldEditor && Array.isArray(draft.customFieldLabels)) {
          var addCustomFieldRow = customFieldEditor.__mouAddCustomFieldRow;
          if (typeof addCustomFieldRow === "function") {
            Array.from(customFieldEditor.querySelectorAll("[data-custom-field-row]")).forEach(function (row) {
              row.remove();
            });
            draft.customFieldLabels.forEach(function (label) {
              addCustomFieldRow(label);
            });
          }
        }
      }
      if (errorVisible || draft) {
        saveDraft();
      }
    }

    if (titleInput) titleInput.addEventListener("input", saveDraft);
    if (contentSelect) contentSelect.addEventListener("change", saveDraft);
    if (richtextArea) richtextArea.addEventListener("input", saveDraft);
    form.addEventListener("submit", saveDraft);
  }

  function syncEditorForm(form) {
    if (!form) return;
    syncContentFields(form);
    initCustomFieldEditor(form.querySelector("[data-custom-field-editor]"), { onChange: function () {} });
    var overlay = form.closest(".modalOverlay");
    var statusEl = form.querySelector("[data-editor-status]");
    var previewBtn = form.querySelector("[data-mou-preview-button]");
    var saveInFlight = null;
    var saveCurrentBtn = form.querySelector("[data-save-current]");
    var saveNewBtn = form.querySelector("[data-save-new-version]");
    var currentPdfLink = form.querySelector("[data-current-pdf-url]");
    var fileInput = form.querySelector("[data-mou-file-field] input[type='file']");
    var contentSelect = form.querySelector("[data-mou-content-select]");

    function setStatus(kind, text) {
      if (!statusEl) return;
      statusEl.className = "msg " + (kind || "");
      statusEl.textContent = text || "";
    }

    function setBusy(isBusy) {
      if (saveCurrentBtn) saveCurrentBtn.disabled = isBusy;
      if (saveNewBtn) saveNewBtn.disabled = isBusy;
      if (previewBtn) previewBtn.disabled = isBusy;
    }

    async function submitTo(url) {
      if (saveInFlight) return saveInFlight;
      var requestUrl = url + (url.indexOf("?") === -1 ? "?format=json" : "&format=json");
      setBusy(true);
      setStatus("pending", "Saving...");
      saveInFlight = fetch(requestUrl, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form)
      }).then(async function (res) {
        var out = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(out.error || "Failed to save document.");
        setStatus("ok", "Saved.");
        return out;
      }).catch(function (err) {
        setStatus("bad", err && err.message ? err.message : "Failed to save document.");
        throw err;
      }).finally(function () {
        saveInFlight = null;
        setBusy(false);
      });
      return saveInFlight;
    }

    function previewUnsaved() {
      var contentValue = contentSelect ? contentSelect.value : "markdown";
      if (contentValue === "pdf") {
        var selectedFile = fileInput && fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
        if (selectedFile) {
          window.open(URL.createObjectURL(selectedFile), "_blank");
          return;
        }
        if (currentPdfLink && currentPdfLink.href) {
          window.open(currentPdfLink.href, "_blank");
          return;
        }
        setStatus("bad", "Choose a PDF file to preview.");
        return;
      }

      var previewWindow = window.open("", "_blank");
      if (!previewWindow) {
        setStatus("bad", "Preview popup was blocked.");
        return;
      }
      setStatus("pending", "Opening preview...");
      fetch(form.getAttribute("action").replace(/\/save$/, "/preview"), {
        method: "POST",
        body: new FormData(form)
      }).then(function (res) {
        if (!res.ok) throw new Error("Failed to preview document.");
        return res.text();
      }).then(function (html) {
        previewWindow.document.open();
        previewWindow.document.write(html);
        previewWindow.document.close();
        setStatus("", "");
      }).catch(function (err) {
        previewWindow.close();
        setStatus("bad", err && err.message ? err.message : "Failed to preview document.");
      });
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
    });
    if (saveCurrentBtn) {
      saveCurrentBtn.addEventListener("click", function () {
        submitTo(form.getAttribute("action"))
          .then(function () {
            closeOverlay(overlay);
          })
          .catch(function () {});
      });
    }
    if (saveNewBtn) {
      saveNewBtn.addEventListener("click", function () {
        submitTo(saveNewBtn.getAttribute("data-save-new-url"))
          .then(function (out) {
            closeOverlay(overlay);
            if (out && out.redirectUrl) {
              window.location.href = out.redirectUrl;
            }
          })
          .catch(function () {});
      });
    }
    if (previewBtn) {
      previewBtn.addEventListener("click", function () {
        previewUnsaved();
      });
    }
  }

  function syncAssignmentForm(form) {
    if (!form) return;
    var serverwideToggle = form.querySelector("[data-mou-serverwide-toggle]");
    var agencyBlock = form.querySelector("[data-mou-agency-assignment-block]");
    var agencySearch = form.querySelector("[data-mou-agency-search]");
    var agencyOptions = Array.from(form.querySelectorAll("[data-mou-agency-option]"));
    var selectAllBtn = form.querySelector("[data-mou-agency-select-all]");
    var clearAllBtn = form.querySelector("[data-mou-agency-clear-all]");
    var statusEl = form.querySelector("[data-assignment-status]");
    var submitBtn = form.querySelector("button[type='submit']");

    function setStatus(kind, text) {
      if (!statusEl) return;
      statusEl.className = "msg " + (kind || "");
      statusEl.textContent = text || "";
    }

    function filterOptions() {
      var query = agencySearch ? String(agencySearch.value || "").trim().toLowerCase() : "";
      agencyOptions.forEach(function (option) {
        var label = String(option.getAttribute("data-agency-label") || "").toLowerCase();
        option.style.display = !query || label.indexOf(query) !== -1 ? "" : "none";
      });
    }

    function syncRowState() {
      agencyOptions.forEach(function (option) {
        var input = option.querySelector("[data-mou-agency-checkbox]");
        option.classList.toggle("mouAssignAgencyRow--selected", !!(input && input.checked));
        var signingBlock = option.querySelector("[data-mou-agency-signing]");
        if (signingBlock) signingBlock.hidden = !(input && input.checked);
        if (input && input.checked) {
          syncSigningModeFields(option);
        }
      });
    }

    agencyOptions.forEach(function (option) {
      initSigningControls(option);
    });

    function sync() {
      var checked = !!(serverwideToggle && serverwideToggle.checked);
      setFieldVisible(agencyBlock, !checked);
      filterOptions();
      syncRowState();
    }

    if (serverwideToggle) serverwideToggle.addEventListener("change", sync);
    if (agencySearch) agencySearch.addEventListener("input", filterOptions);
    agencyOptions.forEach(function (option) {
      var input = option.querySelector("[data-mou-agency-checkbox]");
      if (input) {
        input.addEventListener("change", function () {
          syncRowState();
        });
      }
    });
    if (selectAllBtn) {
      selectAllBtn.addEventListener("click", function () {
        agencyOptions.forEach(function (option) {
          if (option.style.display === "none") return;
          var input = option.querySelector("[data-mou-agency-checkbox]");
          if (input) input.checked = true;
        });
        syncRowState();
      });
    }
    if (clearAllBtn) {
      clearAllBtn.addEventListener("click", function () {
        agencyOptions.forEach(function (option) {
          if (option.style.display === "none") return;
          var input = option.querySelector("[data-mou-agency-checkbox]");
          if (input) input.checked = false;
        });
        syncRowState();
      });
    }
    function validateSigningSelections() {
      var invalid = null;
      agencyOptions.forEach(function (option) {
        if (invalid) return;
        if (option.style.display === "none") return;
        var input = option.querySelector("[data-mou-agency-checkbox]");
        if (!input || !input.checked) return;
        var agencyLabel = option.querySelector(".mouAssignAgencyRow__check span");
        var agencyName = agencyLabel ? agencyLabel.textContent.trim() : "selected agency";
        invalid = validateSigningContainer(option, agencyName) || null;
      });
      return invalid;
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      var signingError = validateSigningSelections();
      if (signingError) {
        setStatus("bad", signingError);
        return;
      }
      agencyOptions.forEach(function (option) {
        syncAdminHiddenFields(option);
      });
      if (submitBtn) submitBtn.disabled = true;
      setStatus("pending", "Saving assignment...");
      var payload = new URLSearchParams(new FormData(form));
      fetch(form.getAttribute("action") + "?format=json", {
        method: "POST",
        headers: {
          Accept: "application/json",
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        body: payload.toString()
      }).then(async function (res) {
        var out = await res.json().catch(function () { return {}; });
        if (!res.ok) {
          throw new Error(out.error || "Failed to save assignment.");
        }
        setStatus("ok", "Assignment saved.");
        window.location.href = out.redirectUrl || "/mou?success=" + encodeURIComponent("Document assignment updated.");
      }).catch(function (err) {
        console.error("[MOU_ASSIGN][client]", err);
        setStatus("bad", err && err.message ? err.message : "Failed to save assignment.");
      }).finally(function () {
        if (submitBtn) submitBtn.disabled = false;
      });
    });
    sync();
  }

  function syncUserAgreementForm(form) {
    if (!form) return;
    var toggle = form.querySelector("[data-user-agreement-toggle]");
    var label = form.querySelector("[data-user-agreement-toggle-label]");
    var titleWrap = form.querySelector("[data-user-agreement-title-wrap]");
    var fields = form.querySelector("[data-user-agreement-fields]");
    var footer = form.querySelector("[data-user-agreement-footer]");
    if (!toggle) return;

    function sync() {
      var enabled = !!toggle.checked;
      if (label) label.textContent = enabled ? "Enabled" : "Disabled";
      setFieldVisible(titleWrap, enabled);
      setFieldVisible(fields, enabled);
      setFieldVisible(footer, enabled);
    }

    toggle.addEventListener("change", function () {
      sync();
      if (typeof form.requestSubmit === "function") {
        form.requestSubmit();
      } else {
        form.submit();
      }
    });

    sync();
  }

  function parseSortableValue(value) {
    var raw = String(value == null ? "" : value).trim();
    if (!raw) return "";
    if (/^-?\d+(\.\d+)?$/.test(raw)) return Number(raw);
    return raw.toLowerCase();
  }

  function stableSortRows(rows, key, dir) {
    return rows
      .map(function (row, index) {
        return { row: row, index: index };
      })
      .sort(function (a, b) {
        var aValue = parseSortableValue(a.row.getAttribute("data-" + key));
        var bValue = parseSortableValue(b.row.getAttribute("data-" + key));
        if (aValue < bValue) return -1 * dir;
        if (aValue > bValue) return 1 * dir;
        return a.index - b.index;
      })
      .map(function (entry) {
        return entry.row;
      });
  }

  function initSortableTable(config) {
    if (!config || !config.tableId || !config.tbodyId) return;
    var table = document.getElementById(config.tableId);
    var tbody = document.getElementById(config.tbodyId);
    if (!table || !tbody) return;

    var rows = Array.from(tbody.querySelectorAll("tr[data-table-row]"));
    var headers = Array.from(table.querySelectorAll("th.sortable"));
    var searchInput = config.searchInputId ? document.getElementById(config.searchInputId) : null;
    var agencyFilter = config.agencyFilterId ? document.getElementById(config.agencyFilterId) : null;
    var statusFilter = config.statusFilterId ? document.getElementById(config.statusFilterId) : null;
    var sortKey = "";
    var sortDir = 1;

    function updateSortIndicators() {
      headers.forEach(function (th) {
        th.style.cursor = "pointer";
        var indicator = th.querySelector(".sortIndicator");
        var key = th.getAttribute("data-key");
        if (!indicator) return;
        indicator.textContent = key && key === sortKey ? (sortDir === 1 ? "▲" : "▼") : "";
      });
    }

    function rowMatchesFilters(row) {
      var searchValue = searchInput ? String(searchInput.value || "").trim().toLowerCase() : "";
      var titleValue = String(row.getAttribute("data-title") || "").toLowerCase();
      if (searchValue && titleValue.indexOf(searchValue) === -1) return false;

      if (agencyFilter) {
        var selectedAgency = String(agencyFilter.value || "all").trim().toLowerCase();
        var rowAgency = String(row.getAttribute("data-agencyid") || "").trim().toLowerCase();
        if (selectedAgency !== "all" && rowAgency !== selectedAgency) return false;
      }

      if (statusFilter) {
        var selectedStatus = String(statusFilter.value || "all").trim().toLowerCase();
        var rowStatus = String(row.getAttribute("data-status") || "").trim().toLowerCase();
        if (selectedStatus !== "all" && rowStatus !== selectedStatus) return false;
      }

      return true;
    }

    function render() {
      var orderedRows = sortKey ? stableSortRows(rows, sortKey, sortDir) : rows.slice();
      orderedRows.forEach(function (row) {
        row.style.display = rowMatchesFilters(row) ? "" : "none";
        tbody.appendChild(row);
      });
      updateSortIndicators();
    }

    headers.forEach(function (th) {
      th.addEventListener("click", function () {
        var key = th.getAttribute("data-key");
        if (!key) return;
        if (sortKey === key) {
          sortDir *= -1;
        } else {
          sortKey = key;
          sortDir = 1;
        }
        render();
      });
    });

    if (searchInput) {
      searchInput.addEventListener("input", render);
    }
    if (agencyFilter) {
      agencyFilter.addEventListener("change", render);
    }
    if (statusFilter) {
      statusFilter.addEventListener("change", render);
    }

    render();
  }

  document.querySelectorAll("[data-overlay-target]").forEach(function (button) {
    button.addEventListener("click", function () {
      var overlay = document.getElementById(button.getAttribute("data-overlay-target"));
      openOverlay(overlay);
    });
  });

  document.querySelectorAll("[data-close-overlay]").forEach(function (button) {
    button.addEventListener("click", function () {
      closeOverlay(button.closest(".modalOverlay"));
    });
  });

  document.querySelectorAll(".modalOverlay").forEach(function (overlay) {
    overlay.addEventListener("click", function (event) {
      if (event.target === overlay) closeOverlay(overlay);
    });
  });

  window.addEventListener("keydown", function (event) {
    if (event.key !== "Escape") return;
    var openOverlayEl = Array.from(document.querySelectorAll(".modalOverlay")).find(function (overlay) {
      return overlay.style.display !== "none";
    });
    if (openOverlayEl) closeOverlay(openOverlayEl);
  });

  document.querySelectorAll("[data-mou-create-form]").forEach(function (form) {
    syncContentFields(form);
    syncCreateFormDraft(form);
  });
  document.querySelectorAll("[data-mou-editor-form]").forEach(syncEditorForm);
  document.querySelectorAll("[data-mou-assignment-form]").forEach(syncAssignmentForm);
  document.querySelectorAll("[data-user-agreement-form]").forEach(syncUserAgreementForm);
  initSortableTable({
    tableId: "mouDocumentsTable",
    tbodyId: "mouDocumentsTbody",
    searchInputId: "mouDocumentsSearch"
  });
  initSortableTable({
    tableId: "mouSignatureTable",
    tbodyId: "mouSignatureTbody",
    searchInputId: "mouSignatureSearch",
    agencyFilterId: "mouSignatureAgencyFilter",
    statusFilterId: "mouSignatureStatusFilter"
  });

  var editVersionKey = new URLSearchParams(window.location.search).get("editVersion");
  if (editVersionKey) {
    var editorOverlay = document.querySelector('[data-edit-key="' + editVersionKey.replace(/"/g, '\\"') + '"]');
    if (editorOverlay) openOverlay(editorOverlay);
  }

  clearFlashQueryParams();

  document.querySelectorAll("[data-mou-signing-form]").forEach(initSigningMethodForm);

  document.querySelectorAll("[data-mou-delete-form]").forEach(function (form) {
    form.addEventListener("submit", function (event) {
      if (form.getAttribute("data-has-blocking-signatures") === "true") {
        event.preventDefault();
        window.alert(form.getAttribute("data-blocking-message") || "This document cannot be deleted yet.");
        return;
      }
      if (!window.confirm("Delete this document and all of its versions?")) {
        event.preventDefault();
      }
    });
  });

  document.addEventListener("click", function (event) {
    var copyBtn = event.target.closest("[data-mou-copy-sign-link]");
    if (!copyBtn) return;
    event.preventDefault();
    copyExternalSignLink(copyBtn);
  });
})();
</script>
