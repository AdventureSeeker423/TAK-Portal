                                <option value="<%= agencySigningConfig.assignedAdminEmail %>" data-admin-username="<%= agencySigningConfig.assignedAdminUsername || '' %>" data-admin-name="<%= agencySigningConfig.assignedAdminName || '' %>" selected><%= agencySigningConfig.assignedAdminName || agencySigningConfig.assignedAdminUsername || agencySigningConfig.assignedAdminEmail %></option>
