<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <div class="row" style="justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
    <div>
      <h1 style="margin-bottom:6px;">View / Sign Document</h1>
      <div class="muted">Review the current version, then sign on behalf of your agency.</div>
      <div class="mouBadgeRow">
        <span class="mouBadge"><%= scopeLabel || "Serverwide" %></span>
        <span class="mouBadge mouBadge--soft">v<%= version.version %></span>
        <span class="mouBadge mouBadge--soft"><%= String(contentType || "html").toUpperCase() %></span>
      </div>
    </div>
    <div class="mouActionRow">
      <% if (downloadUrl) { %>
        <a class="btn secondary" href="<%= downloadUrl %>">Download</a>
        <button class="btn secondary" type="button" onclick="window.print()">Print</button>
      <% } %>
      <a class="btn" href="/mou">Back to MOU / Documents</a>
    </div>
  </div>

  <% if (error) { %>
    <div class="card mouCallout mouCallout--danger">
      <div class="msg bad"><%= error %></div>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="card mouCallout">
      <div class="msg ok"><%= success %></div>
    </div>
  <% } %>

  <div class="mouWorkspace">
    <section class="card mouWorkspace__document">
      <div class="mouViewerToolbar">
        <div>
          <h2 style="margin:0;"><%= stream.title %></h2>
          <div class="muted">Review the exact current version before signing.</div>
        </div>
        <% if (contentType === "pdf") { %>
          <a class="btn secondary" target="_blank" rel="noopener noreferrer" href="<%= fileUrl %>">Open PDF</a>
        <% } %>
      </div>
      <% if (contentType === "pdf") { %>
        <iframe class="mouPdfFrame" src="<%= fileUrl %>" title="<%= stream.title %>"></iframe>
      <% } else { %>
        <div class="mouDocumentShell">
          <%- html %>
        </div>
      <% } %>
    </section>

    <section class="card mouWorkspace__sidebar">
      <h2 style="margin-top:0;">View / Sign Document</h2>
      <% const hasPendingAgency = agencyChoices.some(function (agency) { return !agency.currentSignature; }); %>
      <% const firstPendingAgency = agencyChoices.find(function (agency) { return !agency.currentSignature; }); %>
      <div class="mouAgencyList" style="margin-bottom: 16px;">
        <% agencyChoices.forEach(function (agency) { %>
          <div class="mouAgencyList__row">
            <div>
              <strong><%= agency.name %></strong>
              <% if (agency.currentSignature) { %>
                <div class="muted">Already signed by <%= agency.currentSignature.signerDisplayName %></div>
              <% } else { %>
                <div class="muted">Awaiting signature</div>
              <% } %>
            </div>
            <span class="mouStatus <%= agency.currentSignature ? 'mouStatus--ok' : 'mouStatus--pending' %>">
              <%= agency.currentSignature ? "Signed" : "Pending" %>
            </span>
          </div>
        <% }); %>
      </div>

      <% if (!hasPendingAgency) { %>
        <div class="msg ok" style="margin-bottom: 14px;">All agencies available to you have already signed this version.</div>
      <% } %>

      <form method="post" action="/mou/sign/<%= encodeURIComponent(stream.mouId) %>/<%= encodeURIComponent(version.version) %>" id="mouSignForm">
        <input type="hidden" name="agencySuffix" value="<%= firstPendingAgency ? firstPendingAgency.suffix : '' %>" <%= hasPendingAgency ? "" : "disabled" %> />
        <div style="margin-bottom:12px;">
          <div class="muted">Agency</div>
          <strong><%= firstPendingAgency ? firstPendingAgency.name : (agencyChoices[0] ? agencyChoices[0].name : '-') %></strong>
        </div>

        <div class="card" style="margin:0 0 12px 0;padding:14px 16px;">
          By signing this document, I affirm that I am authorized to sign on behalf of my agency and attest that this acknowledgment is made for my agency.
        </div>

        <label style="margin-top:12px;display:block;">
          Draw signature
          <canvas id="signatureCanvas" width="520" height="180" class="mouSignatureCanvas" aria-label="Signature canvas"></canvas>
        </label>

        <div class="row" style="margin-top:10px;">
          <button class="btn" type="button" id="clearSignatureBtn">Clear Signature</button>
        </div>

        <label style="margin-top:12px;display:block;">
          Type Your Full Name
          <input type="text" name="attestationText" placeholder="Type your full name if drawing is unavailable" <%= hasPendingAgency ? "" : "disabled" %> />
        </label>

        <input type="hidden" name="signatureDataUrl" id="signatureDataUrl" value="" />

        <div class="row" style="margin-top:16px;justify-content:flex-end;">
          <a class="btn secondary" href="/mou">Cancel</a>
          <button class="btn success" type="submit" <%= hasPendingAgency ? "" : "disabled" %>>Sign Document</button>
        </div>
      </form>
    </section>
  </div>
</main>

<script>
(function () {
  var canvas = document.getElementById("signatureCanvas");
  var form = document.getElementById("mouSignForm");
  var hidden = document.getElementById("signatureDataUrl");
  var clearBtn = document.getElementById("clearSignatureBtn");
  if (!canvas || !form || !hidden) return;

  var ctx = canvas.getContext("2d");
  var drawing = false;
  var hasInk = false;

  function pointFromEvent(evt) {
    var rect = canvas.getBoundingClientRect();
    var source = evt.touches && evt.touches[0] ? evt.touches[0] : evt;
    return {
      x: source.clientX - rect.left,
      y: source.clientY - rect.top,
    };
  }

  function begin(evt) {
    evt.preventDefault();
    drawing = true;
    var point = pointFromEvent(evt);
    ctx.beginPath();
    ctx.moveTo(point.x, point.y);
  }

  function draw(evt) {
    if (!drawing) return;
    evt.preventDefault();
    var point = pointFromEvent(evt);
    ctx.lineWidth = 2;
    ctx.lineCap = "round";
    ctx.strokeStyle = "#111827";
    ctx.lineTo(point.x, point.y);
    ctx.stroke();
    hasInk = true;
  }

  function end(evt) {
    if (evt) evt.preventDefault();
    drawing = false;
  }

  canvas.addEventListener("mousedown", begin);
  canvas.addEventListener("mousemove", draw);
  window.addEventListener("mouseup", end);
  canvas.addEventListener("touchstart", begin, { passive: false });
  canvas.addEventListener("touchmove", draw, { passive: false });
  canvas.addEventListener("touchend", end, { passive: false });

  clearBtn.addEventListener("click", function () {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    hasInk = false;
    hidden.value = "";
  });

  form.addEventListener("submit", function () {
    hidden.value = hasInk ? canvas.toDataURL("image/png") : "";
  });
})();
</script>
