<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1><%= stream && stream.title ? stream.title : "MOU" %></h1>

  <% if (updatedFromOlderVersion) { %>
    <div class="card" style="margin-bottom:12px;">
      <div class="msg pending">This document has been updated. You are viewing the latest deployed version.</div>
    </div>
  <% } %>

  <div class="card">
    <div class="row" style="justify-content:space-between;align-items:center;">
      <div>
        <strong>Version:</strong> v<%= version && version.version ? version.version : "-" %>
        <% if (mode === "signed_evidence" && signature) { %>
          <br />
          <span class="muted">Signed by <%= signature.signerDisplayName %> for <%= signature.agencyNameAtSign %> on <%= signature.signedAt %></span>
        <% } %>
      </div>
      <a class="btn" href="/mou">Back to MOUs</a>
    </div>
  </div>

  <div class="card mouDocumentShell">
    <%- html %>
  </div>
</main>
