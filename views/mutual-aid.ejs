<script>
const ENROLLMENT_FLYER_HTML = <%- JSON.stringify(typeof enrollmentFlyerHtml !== "undefined" ? enrollmentFlyerHtml : "") %>;
const FLYER_USER_AGREEMENT = <%- JSON.stringify(
  typeof flyerUserAgreement !== "undefined" && flyerUserAgreement
    ? flyerUserAgreement
    : { enabled: false, text: "" }
) %>;
// ----- Shared helpers -----
function esc(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#39;");
}

function displayGroupName(name){
  const n = String(name || "").trim();
  return n.toLowerCase().startsWith("tak_") ? n.slice(4) : n;
}

function setMsg(el, text, ok=true){
  el.textContent = text || "";
  if (ok === "progress") {
    el.className = "msg progress";
  } else {
    el.className = "msg " + (ok ? "ok" : "bad");
  }
}

async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
  } catch (e) {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
  }
}

// ----- Mutual aid members modal -----
const membersOverlay = document.getElementById("membersOverlay");
const membersCloseBtn = document.getElementById("membersCloseBtn");
const membersSummary = document.getElementById("membersSummary");
const membersFilter = document.getElementById("membersFilter");
const membersList = document.getElementById("membersList");
const membersHint = document.getElementById("membersHint");
const membersPrevBtn = document.getElementById("membersPrevBtn");
const membersNextBtn = document.getElementById("membersNextBtn");
const membersPageInfo = document.getElementById("membersPageInfo");

let activeMembers = [];
let activeMembersGroupId = "";
let activeMembersGroupName = "";
let membersCurrentPage = 1;
let membersPageSize = 100;
let membersTotalCount = 0;
let membersHasNext = false;
let membersHasPrev = false;

function showMembersModal(show) {
  if (!membersOverlay) return;
  membersOverlay.style.display = show ? "flex" : "none";
  document.body.classList.toggle("noScroll", !!show);
}

function renderMembersList() {
  const needle = String(membersFilter?.value || "").trim().toLowerCase();
  const items = (activeMembers || []).filter((u) => {
    if (!needle) return true;
    const uname = String(u.username || "").toLowerCase();
    const name = String(u.name || "").toLowerCase();
    const em = String(u.email || "").toLowerCase();
    return uname.includes(needle) || name.includes(needle) || em.includes(needle);
  });

  if (!items.length) {
    membersList.innerHTML = '<div class="muted">No members match your filter.</div>';
    return;
  }

  const rows = items
    .map(
      (u) => `
    <tr>
      <td>${esc(u.username || "")}</td>
      <td>${esc(u.name || "")}</td>
      <td>${esc(u.email || "")}</td>
    </tr>
  `
    )
    .join("");

  membersList.innerHTML = `
    <table class="table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        ${rows}
      </tbody>
    </table>
  `;
}

function renderMembersPagination() {
  const total = Number(membersTotalCount || 0);
  const size = Math.max(1, Number(membersPageSize || 100));
  const totalPages = total > 0 ? Math.max(1, Math.ceil(total / size)) : 1;
  if (membersPageInfo) membersPageInfo.textContent = `Page ${membersCurrentPage} of ${totalPages}`;
  if (membersPrevBtn) membersPrevBtn.disabled = !membersHasPrev;
  if (membersNextBtn) membersNextBtn.disabled = !membersHasNext;
}

async function loadMembersPage(page) {
  if (!activeMembersGroupId) return;
  const targetPage = Math.max(1, Number(page || 1));
  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";

  const res = await fetch(
    `/api/groups/${encodeURIComponent(activeMembersGroupId)}/members?page=${targetPage}&pageSize=${membersPageSize}`
  );
  const out = await res.json();
  if (!res.ok) throw new Error(out.error || "Failed to load members");

  activeMembers = Array.isArray(out.users) ? out.users : [];
  membersCurrentPage = Number(out.page || targetPage || 1);
  membersPageSize = Number(out.pageSize || membersPageSize || 100);
  membersTotalCount = Number(out.memberCount || activeMembers.length || 0);
  membersHasNext = !!out.hasNext;
  membersHasPrev = !!out.hasPrev;

  const label = activeMembersGroupName || displayGroupName(out.group?.name || "") || activeMembersGroupId;
  membersSummary.textContent = `${membersTotalCount} member${
    membersTotalCount === 1 ? "" : "s"
  } in group "${label}".`;
  membersSummary.className = "msg ok";
  membersHint.textContent = membersTotalCount
    ? "Showing current members of this mutual aid group's Authentik group."
    : "No users are currently assigned to this mutual aid group.";

  renderMembersList();
  renderMembersPagination();
}

async function openMutualAidMembers(groupId, groupName) {
  activeMembersGroupId = String(groupId || "");
  activeMembersGroupName = displayGroupName(groupName || "");

  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";
  membersList.innerHTML = "";
  membersHint.textContent = "";
  if (membersFilter) membersFilter.value = "";
  membersCurrentPage = 1;
  membersTotalCount = 0;
  membersHasNext = false;
  membersHasPrev = false;
  renderMembersPagination();

  showMembersModal(true);

  try {
    await loadMembersPage(1);
  } catch (e) {
    membersSummary.textContent = "Failed to load members.";
    membersSummary.className = "msg bad";
    membersList.innerHTML = "";
    membersHint.textContent = "";
    activeMembers = [];
    membersTotalCount = 0;
    membersHasNext = false;
    membersHasPrev = false;
    renderMembersPagination();
  }
}

if (membersCloseBtn && membersOverlay) {
  membersCloseBtn.onclick = () => showMembersModal(false);
  membersOverlay.addEventListener("click", (e) => {
    if (e.target === membersOverlay) showMembersModal(false);
  });
}
if (membersFilter) {
  membersFilter.oninput = renderMembersList;
}
if (membersPrevBtn) {
  membersPrevBtn.onclick = () => {
    if (membersHasPrev && membersCurrentPage > 1) {
      loadMembersPage(membersCurrentPage - 1).catch(() => {});
    }
  };
}
if (membersNextBtn) {
  membersNextBtn.onclick = () => {
    if (membersHasNext) {
      loadMembersPage(membersCurrentPage + 1).catch(() => {});
    }
  };
}

