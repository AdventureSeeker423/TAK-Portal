async function loadTemplatesForMassModal(){
  try {
    const res = await fetch("/api/templates");
    const out = await res.json();
    if (!res.ok) throw new Error(out.error || "Failed to load templates");
    templatesCache = (Array.isArray(out) ? out : [])
      .map((t) => ({
        idx: Number(t?._index),
        name: String(t?.name || "").trim(),
        agencySuffix: String(t?.agencySuffix || "").trim().toLowerCase(),
        groups: Array.isArray(t?.groups)
          ? t.groups.map((g) => String(g || "").trim()).filter(Boolean)
          : [],
      }))
      .filter((t) => Number.isInteger(t.idx) && t.idx >= 0);
  } catch (_) {
    templatesCache = [];
  }
}

function getAgencyLabelBySuffix(sfxRaw){
  const sfx = String(sfxRaw || "").trim().toLowerCase();
  const agency = (agenciesCache || []).find((a) =>
    String(a?.suffix || "").trim().toLowerCase() === sfx
  );
  if (!agency) return sfx.toUpperCase();
  const name = String(agency?.name || "").trim();
  const prefix = String(agency?.groupPrefix || "").trim();
  return prefix ? `${name} (${prefix})` : name;
}

function renderTemplateSourceList(){
  if (!templateList) return;
  const needle = String(templateSearch?.value || "").trim().toLowerCase();
  const activeGroupName = String(activeMassGroupName || "").trim();
  const items = (templatesCache || [])
    .slice()
    .sort((a, b) => {
      const aa = getAgencyLabelBySuffix(a.agencySuffix);
      const bb = getAgencyLabelBySuffix(b.agencySuffix);
      const byAgency = aa.localeCompare(bb);
      if (byAgency !== 0) return byAgency;
      return String(a.name || "").localeCompare(String(b.name || ""));
    })
    .filter((t) => {
      if (!needle) return true;
      const n = String(t.name || "").toLowerCase();
      const a = getAgencyLabelBySuffix(t.agencySuffix).toLowerCase();
      const s = String(t.agencySuffix || "").toLowerCase();
      return n.includes(needle) || a.includes(needle) || s.includes(needle);
    });

  templateList.innerHTML = items.map((t) => {
    const id = String(t.idx);
    const checked = selectedTemplateIndices.has(id) ? "checked" : "";
    const hasGroup = !!(activeGroupName && Array.isArray(t.groups) && t.groups.includes(activeGroupName));
    const label = `${getAgencyLabelBySuffix(t.agencySuffix)} - ${t.name}`;
    const rowStyle = hasGroup
      ? "background: rgba(46, 160, 67, 0.18); border: 1px solid rgba(46, 160, 67, 0.45);"
      : "background: rgba(248, 81, 73, 0.14); border: 1px solid rgba(248, 81, 73, 0.35);";
    return `
      <label class="groupItem" style="${rowStyle}">
        <input type="checkbox" class="srcTemplateChk" value="${esc(id)}" ${checked} />
        <span>${esc(label)}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No templates found.</div>`;
}

