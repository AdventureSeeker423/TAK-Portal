function hexToRgb(hex) {
  const h = String(hex || "").replace(/^#/, "");
  if (h.length === 3) {
    const r = int(h[0] + h[0]);
    const g = int(h[1] + h[1]);
    const b = int(h[2] + h[2]);
    return [r, g, b];
  }
  if (h.length !== 6) return [0, 0, 0];
  const r = int(h.slice(0, 2));
  const g = int(h.slice(2, 4));
  const b = int(h.slice(4, 6));
  return [r, g, b];
  function int(s) {
    const n = parseInt(s, 16);
    return Number.isFinite(n) ? n : 0;
  }
}

function makeQrDataUrl(text, cellSize = 8, margin = 2) {
  // qrcode-generator (cdnjs) exposes global: qrcode
  const qr = qrcode(0, "M");
  qr.addData(String(text || ""));
  qr.make();
  return qr.createDataURL(cellSize, margin);
}

function fitOneLine(doc, text, maxWidthPt, startSizePt) {
  let size = startSizePt;
  doc.setFontSize(size);
  while (size > 10 && doc.getTextWidth(text) > maxWidthPt) {
    size -= 1;
    doc.setFontSize(size);
  }
  return size;
}

function drawNumberedList(doc, items, x, y, maxWidth, lineHeight = 16, indent = 14) {
  let cursorY = y;

  doc.setFont("helvetica", "normal");
  doc.setFontSize(12);

  items.forEach((text, i) => {
    const number = `${i + 1}.`;

    // Draw the number
    doc.text(number, x, cursorY);

    // Draw the text, indented
    const lines = doc.splitTextToSize(text, maxWidth - indent);
    doc.text(lines, x + indent, cursorY);

    cursorY += lines.length * lineHeight;
  });

  return cursorY;
}


async function buildDeploymentPacketPdf() {
  try {
    if (!qrEnrollUrl || !qrImg?.src) {
      throw new Error("QR not ready yet.");
    }

    // jsPDF UMD bundle exposes window.jspdf.jsPDF
    const jsPDF = window.jspdf?.jsPDF;
    if (!jsPDF) {
      throw new Error("PDF library failed to load.");
    }
    if (typeof window.qrcode !== "function") {
      throw new Error("QR library failed to load.");
    }

    const doc = new jsPDF({ orientation: "portrait", unit: "pt", format: "letter" });
    const pageW = doc.internal.pageSize.getWidth();
    const pageH = doc.internal.pageSize.getHeight();

    // Slightly larger margins so content isn't so close to the page edges.
    const margin = 54;

    // --- Page 1: App QR codes + Instructions ---
    const qrSize1 = 280; // Bigger but still safe on Letter
    const textWidth = pageW - margin * 2;
    let y = margin;

    const takAwareUrl = "https://apps.apple.com/us/app/tak-aware/id6738631659";
    const atakUrl = "https://play.google.com/store/apps/details?id=com.atakmap.app.civ";
    const takAwareQr = makeQrDataUrl(takAwareUrl, 10, 2);
    const atakQr = makeQrDataUrl(atakUrl, 10, 2);

    /* =========================================================
      TAK AWARE (iOS)
    ========================================================= */

    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Download TAK Aware (iOS)", margin, y);

    doc.addImage(takAwareQr, "PNG", margin, y + 14, qrSize1, qrSize1);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    drawNumberedList(
      doc,
      [
        "Open TAK Aware on your iPhone or iPad.",
        "When prompted, allow Location access and set it to Always Allow.",
        "Enter your assigned Call Sign, Team, and Role.",
        "Tap Connect to a TAK Server, then select Scan QR Code.",
        "Allow camera access and scan the QR code.",
        "Confirm the status shows Succeeded."
      ],
      margin + qrSize1 + 28,
      y + 32,
      textWidth - qrSize1 - 28
    );

    /* =========================================================
      ATAK (Android)
    ========================================================= */

    y = y + qrSize1 + 110;

    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Download ATAK (Android)", margin, y);

    doc.addImage(atakQr, "PNG", margin, y + 14, qrSize1, qrSize1);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    drawNumberedList(
      doc,
      [
        "Open the camera on your Android device.",
        "Point your camera at the QR code and open the link.",
        "Install and open ATAK.",
        "Select Yes to perform quick enrollment."
      ],
      margin + qrSize1 + 28,
      y + 32,
      textWidth - qrSize1 - 28
    );

    /* =========================================================
       PAGE 2 — USER QR + CALLSIGN FORMAT
    ========================================================= */

    doc.addPage();

    // Callsign header
    doc.setFont("helvetica", "normal");
    doc.setFontSize(20);
    doc.setTextColor(80);
    doc.text("Callsign Format:", pageW / 2, margin, { align: "center" });

    // Callsign text (properly spaced)
    const callsignText = "AGENCY-LASTNAME-CALLSIGN";
    doc.setFont("helvetica", "bold");
    doc.setFontSize(36);
    doc.setTextColor(0);
    doc.text(callsignText, pageW / 2, margin + 42, { align: "center" });

    // Main enrollment QR
    const qrSize2 = Math.min(pageW - margin * 2, pageH - (margin * 2 + 120));
    const qrY2 = margin + 70;

    doc.addImage(qrImg.src, "PNG", (pageW - qrSize2) / 2, qrY2, qrSize2, qrSize2);

    // Username label
    const userLabel = String(qrActiveItem?.username || "").trim();
    if (userLabel) {
      const userY = Math.min(pageH - margin, qrY2 + qrSize2 + 32);
      doc.setFont("helvetica", "bold");
      doc.setFontSize(24);
      doc.text(userLabel, pageW / 2, userY, { align: "center" });
    }

    // --- Page 3: Team Color Guide ---
    doc.addPage();
    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Team Color Guide", pageW / 2, margin, { align: "center" });

    // Add a full row of whitespace under the title.
    y = margin + 30 + 44;
    const lineH = 44;
    const swatch = 22;
    doc.setFont("helvetica", "bold");
    doc.setFontSize(20);
    for (const c of TEAM_COLORS) {
      if (y + lineH > pageH - margin) break;
      const [r, g, b] = hexToRgb(c.hex);
      doc.setFillColor(r, g, b);
      doc.setDrawColor(0);
      doc.rect(margin, y - swatch + 6, swatch, swatch, "FD");

      // For white swatches, add a border so it shows up.
      if (String(c.hex).toLowerCase() == "#ffffff") {
        doc.setDrawColor(120);
        doc.rect(margin, y - swatch + 6, swatch, swatch);
        doc.setDrawColor(0);
      }

      const label = c.desc ? `${c.name} — ${c.desc}` : c.name;
      doc.setTextColor(0);
      doc.text(label, margin + swatch + 12, y);
      y += lineH;
    }

    // --- Page 4: Team Role Guide ---
    doc.addPage();
    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Team Role Guide", pageW / 2, margin, { align: "center" });

    // Add a full row of whitespace under the title.
    y = margin + 30 + 44;
    doc.setFont("helvetica", "bold");
    doc.setFontSize(20);
    for (const r of TEAM_ROLES) {
      if (y + lineH > pageH - margin) break;
      const label = r.desc ? `${r.name} — ${r.desc}` : r.name;
      doc.text(label, margin, y);
      y += lineH;
    }

    const filenameSafe = (String(qrActiveItem?.username || "deployment-packet")
      .trim()
      .replace(/[^a-z0-9_-]+/gi, "-")
      .replace(/-+/g, "-")
      .replace(/^[-_]+|[-_]+$/g, "")
      || "deployment-packet").toLowerCase();
    return doc;
  } catch (e) {
    throw e;
  }

  function min(a, b) { return a < b ? a : b; }
}

// Download the same packet built by buildDeploymentPacketPdf().
async function downloadDeploymentPacket() {
  try {
    const doc = await buildDeploymentPacketPdf();

    const filenameSafe = ((qrActiveItem?.username || "deployment-packet")
      .trim()
      .replace(/[^a-z0-9_-]+/gi, "-")
      .replace(/-+/g, "-")
      .replace(/^[-_]+|[-_]+$/g, "")
      || "deployment-packet").toLowerCase();

    doc.save(`${filenameSafe}-packet.pdf`);
    setMsg(qrMsg, "Packet downloaded.", true);
  } catch (e) {
    setMsg(qrMsg, e?.message || String(e), false);
  }
}

if (qrPacketBtn) {
  qrPacketBtn.onclick = downloadDeploymentPacket;
}

