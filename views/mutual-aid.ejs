let addMaUserParent = null;

function isSubMutualAidType(type) {
  return String(type || "").trim().toUpperCase().startsWith("SUB-");
}

function baseMutualAidType(type) {
  return String(type || "").trim().toUpperCase().replace(/^SUB-/, "");
}

function formatMutualAidTypeLabel(type) {
  const t = String(type || "").trim().toUpperCase();
  if (!t) return "";
  if (isSubMutualAidType(t)) {
    const base = baseMutualAidType(t);
    if (!base) return "Sub";
    return `Sub-${base.charAt(0)}${base.slice(1).toLowerCase()}`;
  }
  return `${t.charAt(0)}${t.slice(1).toLowerCase()}`;
}

function createSubButtonLabel(type) {
  const base = baseMutualAidType(type);
  if (!base) return "Create Sub";
  return `Create Sub-${base.charAt(0)}${base.slice(1).toLowerCase()}`;
}

function updateAddMaUserExpireUi() {
  const enabled = String(addMaUserExpireEnabled?.value || "").toLowerCase() === "yes";
  if (addMaExpireAt) {
    addMaExpireAt.disabled = !enabled;
    addMaExpireAt.style.display = enabled ? "block" : "none";
    if (!enabled) addMaExpireAt.value = "";
  }
}

function openAddMaUserModal(parentItem) {
  addMaUserParent = parentItem;
  const subBtnLabel = createSubButtonLabel(parentItem?.type);
  if (addMaUserTitleEl) {
    addMaUserTitleEl.textContent = subBtnLabel;
  }
  const parentType = baseMutualAidType(parentItem?.type);
  const subLabel = parentType
    ? `Sub-${parentType.charAt(0)}${parentType.slice(1).toLowerCase()}`
    : "Sub deployment";
  if (addMaUserTypeLine) {
    addMaUserTypeLine.textContent = `Type: ${subLabel}`;
  }
  if (addMaUserTitleInput) addMaUserTitleInput.value = "";
  if (addMaUserExpireEnabled) addMaUserExpireEnabled.value = "no";
  if (addMaExpireAt) addMaExpireAt.value = "";
  updateAddMaUserExpireUi();
  setMsg(addMaUserMsg, "", true);
  addMaUserOverlay.style.display = "flex";
  document.body.classList.add("noScroll");
}

function closeAddMaUserModal() {
  addMaUserOverlay.style.display = "none";
  document.body.classList.remove("noScroll");
  addMaUserParent = null;
}

if (addMaUserCloseBtn) addMaUserCloseBtn.onclick = closeAddMaUserModal;
if (addMaUserExpireEnabled) addMaUserExpireEnabled.onchange = updateAddMaUserExpireUi;
if (addMaUserSaveBtn) {
  addMaUserSaveBtn.onclick = async () => {
    if (!addMaUserParent) return;
    const title = String(addMaUserTitleInput?.value || "").trim();
    if (!title) {
      setMsg(addMaUserMsg, "Title is required.", false);
      return;
    }

    let expireEnabled = false;
    let expireAt = null;
    expireEnabled = String(addMaUserExpireEnabled?.value || "").toLowerCase() === "yes";
    if (expireEnabled) {
      const raw = String(addMaExpireAt?.value || "").trim();
      if (!raw) {
        setMsg(addMaUserMsg, "Expiration date/time is required.", false);
        return;
      }
      expireAt = new Date(raw).toISOString();
    }

    addMaUserSaveBtn.disabled = true;
    setMsg(addMaUserMsg, "Creating...", true);
    try {
      const res = await fetch(
        `/api/mutual-aid/${encodeURIComponent(addMaUserParent.id)}/additional-user`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ title, expireEnabled, expireAt }),
        }
      );
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Create failed");
      closeAddMaUserModal();
      setMsg(maListMsg, `Additional user created (${data.item?.username || "ok"}).`, true);
      await loadList();
    } catch (e) {
      setMsg(addMaUserMsg, e?.message || String(e), false);
    } finally {
      addMaUserSaveBtn.disabled = false;
    }
  };
}

editSaveBtn.onclick = async () => {
  if(!activeItem) return;
  const sub = isSubMutualAidType(activeItem?.type);
  const type = sub
    ? String(activeItem.type || "").trim().toUpperCase()
    : String(editType?.value || "").trim().toUpperCase();
  const title = String(editName.value || "").trim();
  if(!title){ setMsg(editMsg, "Name is required.", false); return; }

  setMsg(editMsg, "Saving...", true);

  // Expiration payload (EVENT + INCIDENT)
  let expireEnabled = false;
  let expireAt = null;
  expireEnabled = String(editExpireEnabled.value || "").toLowerCase() === "yes";
  if (expireEnabled) {
    const raw = String(editExpireAt.value || "").trim();
    if (!raw) {
      setMsg(editMsg, "Expiration date/time is required.", false);
      return;
    }
    expireAt = new Date(raw).toISOString();
  }
  const res = await fetch(`/api/mutual-aid/${encodeURIComponent(activeItem.id)}`, {
    method: "PATCH",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ type, title, expireEnabled, expireAt })
  });
  const data = await res.json();
  if(!res.ok){ setMsg(editMsg, data.error || "Failed to save", false); return; }
  setMsg(editMsg, "Saved.", true);
  editOverlay.style.display = "none";
  document.body.classList.remove("noScroll");
  await loadList();
};

// Group assignment is handled via the "Assign" button on each row.

// ----- Mass assign modal (adapted from groups page) -----
const massOverlay = document.getElementById("massOverlay");
const massCloseBtn = document.getElementById("massCloseBtn");
const massTitle = document.getElementById("massTitle");
const massMsg = document.getElementById("massMsg");
const massApplyBtn = document.getElementById("massApplyBtn");
const massSkipBtn = document.getElementById("massSkipBtn");

const massAgencyPane = document.getElementById("massAgencyPane");
const massGroupPane = document.getElementById("massGroupPane");
const massUsersPane = document.getElementById("massUsersPane");

const agencySearch = document.getElementById("agencySearch");
const agencyList = document.getElementById("agencyList");
const agencySelectAll = document.getElementById("agencySelectAll");
const agencyClearAll = document.getElementById("agencyClearAll");

const sourceGroupSearch = document.getElementById("sourceGroupSearch");
const sourceGroupList = document.getElementById("sourceGroupList");
const groupSelectAll = document.getElementById("groupSelectAll");
const groupClearAll = document.getElementById("groupClearAll");

const userSearch = document.getElementById("userSearch");
const userList = document.getElementById("userList");
const userSelectAll = document.getElementById("userSelectAll");
const userClearAll = document.getElementById("userClearAll");

let agenciesCache = [];
// NOTE: groupsCache is used by both the Mutual Aid create form and the mass-assign modal.
// Use `var` so it's available before this point in the script (no TDZ issues).
var groupsCache = [];
let usersSearchCache = [];
let massMode = "agency";
let massAction = "assign";
let activeMassGroupId = "";
let activeMassGroupName = "";

const selectedSourceGroupIds = new Set();
const selectedUserIds = new Set();

function resetMassState() {
  selectedSourceGroupIds.clear();
  selectedUserIds.clear();
  agencySearch.value = "";
  sourceGroupSearch.value = "";
  userSearch.value = "";
  usersSearchCache = [];
}

function openMassAssign({ groupId, groupName }){
  activeMassGroupId = String(groupId || "");
  activeMassGroupName = displayGroupName(groupName || "");
  massAction = "assign";
  massTitle.textContent = `Mass Assign — ${activeMassGroupName}`;
  massApplyBtn.textContent = "Mass Assign";
  setMsg(massMsg, "", true);
  resetMassState();
  massOverlay.style.display = "flex";
  document.body.classList.add("noScroll");

  // load caches if empty
  Promise.all([loadAgencies(), loadGroups()]).catch(()=>{});
}

function openMassUnassign({ groupId, groupName }){
  activeMassGroupId = String(groupId || "");
  activeMassGroupName = displayGroupName(groupName || "");
  massAction = "unassign";
  massTitle.textContent = `Mass Unassign — ${activeMassGroupName}`;
  massApplyBtn.textContent = "Mass Unassign";
  setMsg(massMsg, "", true);
  resetMassState();
  massOverlay.style.display = "flex";
  document.body.classList.add("noScroll");

  // load caches if empty
  Promise.all([loadAgencies(), loadGroups()]).catch(()=>{});
}

function closeMassAssign(){
  massOverlay.style.display = "none";
  document.body.classList.remove("noScroll");
}

massCloseBtn.onclick = closeMassAssign;
massSkipBtn.onclick = closeMassAssign;

function setMassMode(mode){
  massMode = mode;
  document.querySelectorAll(".segBtn").forEach(b => {
    b.classList.toggle("active", b.dataset.mode === mode);
  });
  massAgencyPane.style.display = mode === "agency" ? "block" : "none";
  massGroupPane.style.display = mode === "group" ? "block" : "none";
  massUsersPane.style.display = mode === "users" ? "block" : "none";
  if(mode === "agency") renderAgencyList();
  if(mode === "group") renderSourceGroupList();
  if(mode === "users") renderUserList(usersSearchCache);
}

document.querySelectorAll(".segBtn").forEach(b => {
  b.onclick = () => setMassMode(b.dataset.mode);
});

async function loadAgencies(){
  const res = await fetch("/api/agencies");
  const out = await res.json();
  agenciesCache = res.ok && Array.isArray(out) ? out : [];
  renderAgencyList();
}

function agencyItems(){
  return agenciesCache
    .filter(a => String(a.suffix || "").trim())
    .slice()
    .sort((a,b)=>String(a.name||"").localeCompare(String(b.name||"")))
    .map(a => ({ name: String(a.name||""), suffix: String(a.suffix||"").trim().toLowerCase() }));
}

function renderAgencyList(){
  const needle = String(agencySearch.value||"").trim().toLowerCase();
  const items = agencyItems().filter(x => {
    if(!needle) return true;
    return x.name.toLowerCase().includes(needle) || x.suffix.includes(needle);
  });
  agencyList.innerHTML = items.map(x => {
    const label = `${x.name} (${x.suffix})`;
    return `
      <label class="groupItem">
        <input type="checkbox" class="agencyChk" value="${esc(x.suffix)}" />
        <span>${esc(label)}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No agencies found.</div>`;
}

agencySearch.oninput = () => renderAgencyList();
agencySelectAll.onclick = () => {
  agencyList.querySelectorAll("input.agencyChk").forEach(ch => ch.checked = true);
};
agencyClearAll.onclick = () => {
  agencyList.querySelectorAll("input.agencyChk").forEach(ch => ch.checked = false);
};

async function loadGroups(){
  const res = await fetch("/api/groups");
  const out = await res.json();
  groupsCache = res.ok && Array.isArray(out) ? out : [];
  renderSourceGroupList();
  renderExistingGroupSelect();
}

function renderSourceGroupList(){
  const needle = String(sourceGroupSearch.value||"").trim().toLowerCase();
  const items = groupsCache
    .slice()
    .sort((a,b)=>displayGroupName(a.name).localeCompare(displayGroupName(b.name)))
    .filter(g => {
      if (!needle) return true;
      const label = displayGroupName(g.name).toLowerCase();
      return label.includes(needle) || String(g.name||"").toLowerCase().includes(needle);
    });

  sourceGroupList.innerHTML = items.map(g => {
    const id = String(g.pk);
    const label = displayGroupName(g.name);
    return `
      <label class="groupItem">
        <input type="checkbox" class="srcGroupChk" value="${esc(id)}" />
        <span>${esc(label)}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No groups found.</div>`;

  // Restore selections
  sourceGroupList.querySelectorAll("input.srcGroupChk").forEach(ch => {
    if(selectedSourceGroupIds.has(String(ch.value))) ch.checked = true;
    ch.onchange = () => {
      if(ch.checked) selectedSourceGroupIds.add(String(ch.value));
      else selectedSourceGroupIds.delete(String(ch.value));
    };
  });
}

sourceGroupSearch.oninput = () => renderSourceGroupList();
groupSelectAll.onclick = () => {
  sourceGroupList.querySelectorAll("input.srcGroupChk").forEach(ch => { ch.checked = true; selectedSourceGroupIds.add(String(ch.value)); });
};
groupClearAll.onclick = () => {
  sourceGroupList.querySelectorAll("input.srcGroupChk").forEach(ch => { ch.checked = false; });
  selectedSourceGroupIds.clear();
};


function renderUserList(users){
  userList.innerHTML = (users || []).map(u => {
    const pk = String(u.pk);
    const username = String(u.username || "");
    const name = String(u.name || "");
    const email = String(u.email || "");
    const label = `${username} — ${name || "(no name)"} — ${email || "(no email)"}`;
    const checked = selectedUserIds.has(pk) ? "checked" : "";
    return `
      <label class="groupItem">
        <input type="checkbox" class="userChk" value="${esc(pk)}" ${checked} />
        <span>${esc(label)}</span>
      </label>
    `;
  }).join("") || `<div style="padding:10px; color: var(--muted);">No users loaded.</div>`;

  userList.querySelectorAll("input.userChk").forEach(ch => {
    ch.onchange = () => {
      const id = String(ch.value || "").trim();
      if (!id) return;
      if (ch.checked) selectedUserIds.add(id);
      else selectedUserIds.delete(id);
    };
  });
}

let userSearchT = null;
userSearch.oninput = () => {
  clearTimeout(userSearchT);
  userSearchT = setTimeout(async () => {
    const q = String(userSearch.value || "").trim();
    if (!q) {
      usersSearchCache = [];
      renderUserList([]);
      return;
    }
    try {
      const res = await fetch(`/api/users/search?q=${encodeURIComponent(q)}&page=1&pageSize=200`);
      const out = await res.json();
      if (!res.ok) throw new Error(out.error || "Search failed");
      const arr = Array.isArray(out.users) ? out.users : [];
      usersSearchCache = arr.slice(0, 200);
      renderUserList(usersSearchCache);
    } catch (e) {
      renderUserList([]);
    }
  }, 220);
};

userSelectAll.onclick = () => {
  // Add all shown users to the persistent selection set
  usersSearchCache.forEach(u => {
    const id = String(u.pk || "").trim();
    if (id) selectedUserIds.add(id);
  });
  renderUserList(usersSearchCache);
};
userClearAll.onclick = () => {
  selectedUserIds.clear();
  renderUserList(usersSearchCache);
};

massApplyBtn.onclick = async () => {
  if(!activeMassGroupId){ setMsg(massMsg, "Missing target group", false); return; }
  const actionVerb = massAction === "unassign" ? "unassign" : "assign";
  setMsg(massMsg, "", true);

  const mode = massMode || "agency";
  let payload = { groupId: activeMassGroupId, sourceMode: mode };

  if(mode === "agency"){
    const suffixes = Array.from(agencyList.querySelectorAll("input.agencyChk:checked")).map(ch => String(ch.value));
    if (!suffixes.length) return setMsg(massMsg, "Select one or more agencies.", false);
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} all users in ${suffixes.length} agency suffix(es)?`)) return;
    payload.suffixes = suffixes;
  }

  if(mode === "group"){
    const sourceGroupIds = Array.from(selectedSourceGroupIds);
    if (!sourceGroupIds.length) return setMsg(massMsg, "Select one or more source groups.", false);
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} users already in ${sourceGroupIds.length} selected group(s)?`)) return;
    payload.sourceGroupIds = sourceGroupIds;
  }

  if(mode === "users"){
    const userIds = Array.from(selectedUserIds);
    if (!userIds.length) return setMsg(massMsg, "Select one or more users.", false);
    if (!confirm(`Mass ${actionVerb} "${activeMassGroupName}" ${actionVerb === "assign" ? "to" : "from"} ${userIds.length} user(s)?`)) return;
    payload.userIds = userIds;
  }

  const startEndpoint = massAction === "unassign" ? "/api/groups/mass-unassign/start" : "/api/groups/mass-assign/start";
  const fmtElapsed = (ms) => {
    const sec = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m}:${String(s).padStart(2, "0")}`;
  };

  try {
    const startRes = await fetch(startEndpoint, {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    });
    const startOut = await startRes.json();
    if (!startRes.ok || !startOut?.jobId) {
      return setMsg(massMsg, startOut.error || `Mass ${actionVerb} failed`, false);
    }

    const startedAt = Date.now();
    setMsg(massMsg, `Preparing... 0 of ? • 0:00`, true);

    let done = false;
    while (!done) {
      const statusRes = await fetch(`/api/groups/mass-jobs/${encodeURIComponent(startOut.jobId)}`);
      const statusOut = await statusRes.json();
      if (!statusRes.ok || !statusOut.success) {
        throw new Error(statusOut.error || "Failed to read mass action status");
      }

      const total = Number(statusOut.total || 0);
      const processed = Number(statusOut.processed || 0);
      const elapsedMs = Date.now() - startedAt;
      const phase = String(statusOut.phase || "");
      const sourceMode = String(statusOut.sourceMode || mode || "agency");

      if (statusOut.status === "running") {
        const loadingLabel =
          sourceMode === "group" ? "Loading groups" :
          sourceMode === "users" ? "Loading users" :
          "Loading agencies";
        const phaseLabel =
          phase === "queued" ? "Preparing" :
          phase === "loading_users" ? loadingLabel :
          phase === "matching" ? "Matching users" :
          phase === "applying" ? "Applying changes" :
          "In Progress";
        const totalLabel = total > 0 ? String(total) : "?";
        setMsg(massMsg, `${phaseLabel}... ${processed} of ${totalLabel} • ${fmtElapsed(elapsedMs)}`, true);
        await new Promise(r => setTimeout(r, 800));
        continue;
      }

      if (statusOut.status === "failed") {
        setMsg(massMsg, statusOut.error || `Mass ${actionVerb} failed`, false);
        done = true;
        continue;
      }

      const result = statusOut.result || {};
      setMsg(
        massMsg,
        `Completed. Matched ${Number(result.matched || 0)} user(s). Updated ${Number(result.updated || 0)}. • ${fmtElapsed(elapsedMs)}`,
        true
      );
      done = true;
    }
  } catch (e) {
    setMsg(massMsg, `Mass ${actionVerb} failed`, false);
  }
};

// ----- List rendering -----
function isGroupCreatorItem(it) {
  if (isSubMutualAidType(it?.type)) return false;
  if (it?.groupWasCreated === true) return true;
  return String(it?.groupMode || "new").toLowerCase() !== "existing";
}

function getGroupAnchorForGroup(groupId) {
  const gid = String(groupId || "");
  const master = (allItems || []).filter(
    (x) => String(x.groupId || "") === gid && isGroupCreatorItem(x)
  );
  if (master.length) {
    master.sort((a, b) =>
      String(a.createdAt || "").localeCompare(String(b.createdAt || ""))
    );
    return master[0];
  }
  const primaries = (allItems || []).filter(
    (x) => String(x.groupId || "") === gid && !isSubMutualAidType(x?.type)
  );
  primaries.sort((a, b) =>
    String(a.createdAt || "").localeCompare(String(b.createdAt || ""))
  );
  return primaries[0] || null;
}

function displayTitleForRow(it, masterOpt) {
  const title = String(it?.title || "").trim();
  if (!isSubMutualAidType(it?.type)) return title;
  const master = masterOpt || getGroupAnchorForGroup(it?.groupId);
  const masterTitle = String(master?.title || "").trim();
  if (masterTitle && title) return `${masterTitle} - ${title}`;
  return title || masterTitle;
}

function buildDisplayUnits(filteredItems) {
  const filteredIdSet = new Set(filteredItems.map((x) => String(x.id)));
  const groupIds = [...new Set(filteredItems.map((x) => String(x.groupId || "")))];
  const units = [];

  for (const gid of groupIds) {
    const allInGroup = (allItems || []).filter((x) => String(x.groupId || "") === gid);
    const anchor = getGroupAnchorForGroup(gid);
    const visible = allInGroup.filter((x) => filteredIdSet.has(String(x.id)));
    if (!visible.length) continue;

    if (anchor && allInGroup.length > 1) {
      const children = visible
        .filter((x) => String(x.id) !== String(anchor.id))
        .sort((a, b) =>
          String(a.createdAt || "").localeCompare(String(b.createdAt || ""))
        );
      if (!filteredIdSet.has(String(anchor.id)) && !children.length) continue;
      units.push({
        kind: "unit",
        master: anchor,
        children,
        totalCount: allInGroup.length,
      });
    } else {
      for (const it of visible) {
        units.push({ kind: "single", item: it });
      }
    }
  }
  return units;
}

function unitSortValue(unit, key) {
  const it = unit.kind === "unit" ? unit.master : unit.item;
  return maGetSortValue(it, key);
}

function sortDisplayUnits(units, key, dir) {
  const sign = dir === "desc" ? -1 : 1;
  return units.slice().sort((a, b) => {
    const av = unitSortValue(a, key);
    const bv = unitSortValue(b, key);
    const cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: "base" });
    if (cmp !== 0) return cmp * sign;
    return 0;
  });
}

function renderMutualAidRow(it, opts = {}) {
  const isChild = !!opts.isChild;
  const isLastChild = !!opts.isLastChild;
  const isSub = isSubMutualAidType(it.type);
  const master = opts.master || null;
  const canCreateSub = !isSub;
  const typeLabel = formatMutualAidTypeLabel(it.type);
  const displayTitle = displayTitleForRow(it, master);
  const isAnchor =
    master && String(master.id) === String(it.id);
  const rowClass = [
    isAnchor && !isSub ? "ma-unit-master" : "",
    isChild || isSub ? "ma-unit-child" : "",
    (isChild || isSub) && isLastChild ? "ma-unit-child-last" : "",
  ]
    .filter(Boolean)
    .join(" ");

  const titleBlock = `<div style="font-weight:600;">${esc(displayTitle)}</div>`;
  const channelLine = `<div style="color: var(--muted); font-size: 12px;">${esc(displayGroupName(it.groupName || ""))}</div>`;

  return `
    <tr class="${rowClass}">
      <td>${esc(typeLabel)}</td>
      <td>
        ${titleBlock}
        ${channelLine}
        ${it.expireEnabled && it.expireAt ? `<div style="color: var(--muted); font-size: 12px;">Expires: ${esc(new Date(it.expireAt).toLocaleString())}</div>` : ""}
      </td>
      <td>
        <div class="row" style="gap:10px; flex-wrap: wrap;">
          ${isSub ? "" : `<button class="btn" type="button" data-act="members" data-id="${esc(it.id)}">View Members</button>`}
          ${isAnchor ? `<button class="btn success" type="button" data-act="assign" data-id="${esc(it.id)}">Assign</button>` : ""}
          ${isAnchor ? `<button class="btn" type="button" data-act="unassign" data-id="${esc(it.id)}">Unassign</button>` : ""}
          <button class="btn" type="button" data-act="edit" data-id="${esc(it.id)}">Edit</button>
          <button class="btn qr" type="button" data-act="qr" data-id="${esc(it.id)}">Show QR</button>
          ${canCreateSub ? `<button class="btn maAddUser" type="button" data-act="adduser" data-id="${esc(it.id)}">${esc(createSubButtonLabel(it.type))}</button>` : ""}
          <button class="btn danger" type="button" data-act="del" data-id="${esc(it.id)}">Delete</button>
        </div>
      </td>
    </tr>
  `;
}

function renderList(){
  const needle = String(maFilter.value||"").trim().toLowerCase();
  let items = allItems.filter(it => {
    if(!needle) return true;
    const master = getGroupAnchorForGroup(it.groupId);
    const rowTitle = displayTitleForRow(it, master).toLowerCase();
    return (
      String(it.type||"").toLowerCase().includes(needle) ||
      String(it.title||"").toLowerCase().includes(needle) ||
      rowTitle.includes(needle) ||
      String(it.groupName||"").toLowerCase().includes(needle) ||
      displayGroupName(it.groupName||"").toLowerCase().includes(needle) ||
      String(it.username||"").toLowerCase().includes(needle)
    );
  });

  const units = sortDisplayUnits(buildDisplayUnits(items), maSortState.key, maSortState.dir);
  updateSortIndicators();

  const html = units
    .map((unit) => {
      if (unit.kind === "single") {
        return renderMutualAidRow(unit.item, {});
      }
      const parts = [];
      parts.push(renderMutualAidRow(unit.master, { master: unit.master }));
      unit.children.forEach((child, idx) => {
        parts.push(
          renderMutualAidRow(child, {
            isChild: true,
            isLastChild: idx === unit.children.length - 1,
            master: unit.master,
          })
        );
      });
      return parts.join("");
    })
    .join("");

  maTbody.innerHTML =
    html || `<tr><td colspan="3" style="color:var(--muted); padding: 10px;">No mutual aid items found.</td></tr>`;

  maTbody.querySelectorAll("button[data-act]").forEach(btn => {
    const id = String(btn.dataset.id);
    const act = String(btn.dataset.act);
    const it = allItems.find(x => String(x.id) === id);
    if(!it) return;
    btn.onclick = () => {
      if(act === "members") return openMutualAidMembers(it.groupId, it.groupName);
      if(act === "assign") return openMassAssign({ groupId: it.groupId, groupName: it.groupName });
      if(act === "unassign") return openMassUnassign({ groupId: it.groupId, groupName: it.groupName });
      if(act === "edit") return openEdit(it);
      if(act === "qr") return openQrModal(it);
      if(act === "adduser") return openAddMaUserModal(it);
      if(act === "del") return deleteItem(it);
    };
  });
}

async function loadList(){
  setMsg(maListMsg, "Loading...", true);
  const res = await fetch("/api/mutual-aid");
  const data = await res.json();
  if(!res.ok){
    allItems = [];
    renderList();
    setMsg(maListMsg, data.error || "Failed to load", false);
    return;
  }
  allItems = Array.isArray(data) ? data : [];
  refreshMutualAidExcludedGroupIds();
  renderExistingGroupSelect();
  renderList();
  setMsg(maListMsg, `Loaded ${allItems.length} item(s).`, true);
}

maFilter.oninput = () => renderList();

async function deleteItem(item){
  const anchor = getGroupAnchorForGroup(item.groupId);
  const isAnchor = !!(anchor && String(anchor.id) === String(item.id));
  const isCreator = isGroupCreatorItem(item);
  const linkedCount = (allItems || []).filter(
    (x) => String(x.groupId || "") === String(item.groupId || "")
  ).length;

  let extra;
  if (isCreator && isAnchor && linkedCount > 1) {
    extra =
      `This is the master deployment for a shared channel.\n\n` +
      `This will delete all ${linkedCount} linked deployment(s), revoke TAK certs for each user, and delete the shared group.`;
  } else if (isCreator && isAnchor) {
    extra = "This will revoke TAK certs, delete the user, and delete the group.";
  } else {
    extra =
      "This will revoke TAK certs and delete this deployment user only. (The shared group and other linked deployments will remain.)";
  }

  const ok = confirm(`Delete ${item.type} "${item.title}"?\n\n${extra}`);
  if(!ok) return;
  setMsg(maListMsg, "Deleting...", true);
  const res = await fetch(`/api/mutual-aid/${encodeURIComponent(item.id)}`, { method: "DELETE" });
  const data = await res.json().catch(()=>({}));
  if(!res.ok){ setMsg(maListMsg, data.error || "Delete failed", false); return; }
  const n = Number(data.deletedCount || 1);
  setMsg(maListMsg, n > 1 ? `Deleted ${n} linked deployments.` : "Deleted.", true);
  await loadList();
}

// ----- Create flow -----
maCreateBtn.onclick = async () => {
  setMsg(maCreateMsg, "", true);
  const type = String(maType.value || "").trim().toUpperCase();
  const title = String(maTitle.value || "").trim();
  if(!title){ setMsg(maCreateMsg, "Name is required.", false); return; }

  maCreateBtn.disabled = true;
  setMsg(maCreateMsg, "Creating...", true);
  try {
    // Expiration payload (EVENT + INCIDENT)
    let expireEnabled = false;
    let expireAt = null;
    expireEnabled = String(maExpireEnabled.value || "").toLowerCase() === "yes";
    if (expireEnabled) {
      const raw = String(maExpireAt.value || "").trim();
      if (!raw) {
        setMsg(maCreateMsg, "Expiration date/time is required.", false);
        maCreateBtn.disabled = false;
        return;
      }
      expireAt = new Date(raw).toISOString();
    }
    const groupMode =
      String(maGroupMode?.value || "new").toLowerCase() === "existing" ? "existing" : "new";
    const existingGroupId =
      groupMode === "existing" ? String(maExistingGroup?.value || "").trim() : "";
    if (groupMode === "existing" && !existingGroupId) {
      setMsg(maCreateMsg, "Please select an existing group.", false);
      maCreateBtn.disabled = false;
      return;
    }

    const res = await fetch("/api/mutual-aid", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ type, title, expireEnabled, expireAt, groupMode, existingGroupId }),
    });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error || "Create failed");

    const item = data.item;
    setMsg(maCreateMsg, `Created ${displayGroupName(item.groupName)} (user: ${item.username}).`, true);
    maTitle.value = "";
    maExpireEnabled.value = "no";
    maExpireAt.value = "";
    if (maGroupMode) maGroupMode.value = "new";
    if (maExistingGroup) maExistingGroup.value = "";
    updateCreateGroupModeUi();
    updateCreateExpireUi();
    await loadList();

    if (groupMode !== "existing") {
      openMassAssign({ groupId: item.groupId, groupName: displayGroupName(item.groupName) });
    }
  } catch (e){
    setMsg(maCreateMsg, e.message || String(e), false);
  } finally {
    maCreateBtn.disabled = false;
  }
};

// initial
loadList();
</script>

</div></body></html>
