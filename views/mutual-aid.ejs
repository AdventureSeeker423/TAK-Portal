  #maExpireAt::-webkit-calendar-picker-indicator,
  #editExpireAt::-webkit-calendar-picker-indicator {
    filter: invert(1);
  }

  /* Optional: ensure the text is white too, if you're on a dark background */
  #maExpireAt,
  #editExpireAt {
    color: #fff;
  }

    .btn.qrCopy {
    background: #6b7280;   /* neutral gray */
    border-color: #6b7280;
  }
  .btn.qrCopy:hover { filter: brightness(0.95); }
  .btn.qrCopy:disabled { opacity: 0.6; }

  /* Keep Save Image as-is: no class, no overrides */

  .btn.qrEmail {
    background: #7c3aed;   /* accent purple */
    border-color: #7c3aed;
  }
  .btn.qrEmail:hover { filter: brightness(0.95); }
  .btn.qrEmail:disabled { opacity: 0.6; }

