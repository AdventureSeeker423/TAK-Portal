async function emailDeploymentPacket() {
  try {
    if (!qrEnrollUrl || !qrImg?.src) {
      setMsg(emailPacketMsg, "QR not ready yet.", false);
      return;
    }
    const rawTo = String(emailPacketTo?.value || "").trim();
    if (!rawTo) {
      setMsg(emailPacketMsg, "Please enter at least one email address.", false);
      return;
    }

    // Build the PDF exactly like the Download Packet button.
    const jsPDF = window.jspdf?.jsPDF;
    if (!jsPDF) throw new Error("PDF library failed to load.");
    if (typeof window.qrcode !== "function") throw new Error("QR library failed to load.");

    // Reuse the existing builder and just output bytes.
    const doc = await buildDeploymentPacketPdf();
    const ab = doc.output("arraybuffer");
    const b64 = arrayBufferToBase64(ab);

    const filenameSafe = ((qrActiveItem?.username || "deployment-packet")
      .trim()
      .replace(/[^a-z0-9_-]+/gi, "-")
      .replace(/-+/g, "-")
      .replace(/^[-_]+|[-_]+$/g, "")
      || "deployment-packet").toLowerCase();
    const filename = `${filenameSafe}-packet.pdf`;

    emailPacketSendBtn.disabled = true;
    setMsg(emailPacketMsg, "Sending...", true);

    const res = await fetch(`/api/mutual-aid/${encodeURIComponent(qrActiveId)}/packet/email`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ to: rawTo, pdfBase64: b64, filename })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || "Send failed");

    setMsg(emailPacketMsg, "Sent!", true);
    closeEmailPacketModal();
    setMsg(qrMsg, "Packet emailed.", true);
  } catch (e) {
    setMsg(emailPacketMsg, e?.message || String(e), false);
  } finally {
    if (emailPacketSendBtn) emailPacketSendBtn.disabled = false;
  }
}

if (emailPacketSendBtn) emailPacketSendBtn.onclick = emailDeploymentPacket;

function arrayBufferToBase64(buffer) {
  const bytes = new Uint8Array(buffer);
  let binary = "";
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) {
    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
  }
  return btoa(binary);
}


