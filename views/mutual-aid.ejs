// Groups created by the MA workflow — excluded from "Use Existing Group" picker.
// Normal existing groups stay selectable even if another mutual aid already uses them.
let mutualAidExcludedGroupIds = new Set();

function refreshMutualAidExcludedGroupIds() {
  mutualAidExcludedGroupIds = new Set(
    (allItems || [])
      .filter((it) => {
        if (it?.groupWasCreated === true) return true;
        if (isSubMutualAidType(it?.type)) return false;
        return String(it?.groupMode || "new").toLowerCase() !== "existing";
      })
      .map((it) => String(it?.groupId || "").trim())
      .filter(Boolean)
  );
}

function isMutualAidGroupName(name) {
  const raw = String(name || "").trim().toLowerCase();
  const withoutTak = raw.startsWith("tak_") ? raw.slice(4) : raw;
  return withoutTak.startsWith("ma -") || withoutTak.startsWith("ma-");
}

function groupsForExistingSelect() {
  return (groupsCache || []).filter((g) => {
    const id = String(g?.pk || "").trim();
    if (id && mutualAidExcludedGroupIds.has(id)) return false;
    if (isMutualAidGroupName(g?.name)) return false;
    return true;
  });
}

function renderExistingGroupSelect() {
  if (!maExistingGroup) return;
  const current = String(maExistingGroup.value || "");
  const items = groupsForExistingSelect()
    .slice()
    .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")));

  const opts = [`<option value="">-- Select A Group --</option>`].concat(
    items.map((g) => {
      const id = String(g.pk);
      const rawName = String(g.name || "");
      const label = displayGroupName(rawName);
      return `<option value="${esc(id)}">${esc(label)}</option>`;
    })
  );

  maExistingGroup.innerHTML = opts.join("");
  if (current) maExistingGroup.value = current;
}

function updateCreateGroupModeUi() {
  const mode = String(maGroupMode?.value || "new").toLowerCase();
  const isExisting = mode === "existing";
  // Use flex so Existing Group participates in the full-width field row.
  if (maExistingGroupWrap) maExistingGroupWrap.style.display = isExisting ? "flex" : "none";

  if (isExisting) {
    // Ensure groups are loaded and dropdown is populated.
    if (!groupsCache || !groupsCache.length) {
      loadGroups().catch(() => {});
    } else {
      renderExistingGroupSelect();
    }
  } else {
    if (maExistingGroup) maExistingGroup.value = "";
  }
}

