// ------- Sorting state -------
let maSortState = {
  key: "title",
  dir: "asc"
};

function normalizeSortValue(v){
  return String(v ?? "").trim().toLowerCase();
}

function maGetSortValue(it, key){
  if (key === "type") return normalizeSortValue(it.type);
  if (key === "title") return normalizeSortValue(it.title);
  if (key === "createdBy") return normalizeSortValue(createdBySortLabel(it));
  return "";
}

function createdBySortLabel(it) {
  const cb = it?.createdBy || {};
  const role = String(cb.role || "global_admin").trim().toLowerCase();
  if (role === "agency_admin") {
    const name = String(cb.displayName || cb.username || "").trim();
    const agency = Array.isArray(cb.agencyNames) && cb.agencyNames.length
      ? String(cb.agencyNames[0] || "").trim()
      : "";
    return [name, agency].filter(Boolean).join(" ");
  }
  if (role === "multi_agency_admin") return "Multi-Agency Admin";
  return "Global Admin";
}

function formatCreatedByHtml(it) {
  const cb = it?.createdBy || {};
  const role = String(cb.role || "global_admin").trim().toLowerCase();
  if (role === "agency_admin") {
    const name = String(cb.displayName || cb.username || "").trim() || "Agency Admin";
    const agency = Array.isArray(cb.agencyNames) && cb.agencyNames.length
      ? String(cb.agencyNames[0] || "").trim()
      : "";
    return `
      <div class="maCreatedByName">${esc(name)}</div>
      ${agency ? `<div class="muted" style="font-size: 12px;">${esc(agency)}</div>` : ""}
    `;
  }
  if (role === "multi_agency_admin") {
    return `<div class="maCreatedByName">Multi-Agency Admin</div>`;
  }
  return `<div class="maCreatedByName">Global Admin</div>`;
}

function stableSortedCopy(arr, key, dir){
  const sign = dir === "desc" ? -1 : 1;
  return (arr || [])
    .map((item, idx) => ({ item, idx }))
    .sort((a, b) => {
      const av = maGetSortValue(a.item, key);
      const bv = maGetSortValue(b.item, key);

      const cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: "base" });
      if (cmp !== 0) return cmp * sign;
      return a.idx - b.idx;
    })
    .map(x => x.item);
}

function updateSortIndicators(){
  const thead = document.getElementById("maThead");
  const ths = Array.from(thead ? thead.querySelectorAll("th.sortable") : []);
  ths.forEach(th => {
    const key = th.dataset.key;
    const indicator = th.querySelector(".sortIndicator");
    if (!indicator) return;

    if (key === maSortState.key) {
      indicator.textContent = maSortState.dir === "asc" ? "▲" : "▼";
    } else {
      indicator.textContent = "";
    }
  });
}



const maThead = document.getElementById("maThead");
if (maThead){
  maThead.addEventListener("click", (e) => {
    const th = e.target && e.target.closest ? e.target.closest("th.sortable") : null;
    if (!th) return;

    const key = th.dataset.key;
    if (!key) return;

    if (maSortState.key === key){
      maSortState.dir = maSortState.dir === "asc" ? "desc" : "asc";
    } else {
      maSortState.key = key;
      maSortState.dir = "asc";
    }

    renderList();
  });
}
