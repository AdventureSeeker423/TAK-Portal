<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script>
// ----- Shared helpers -----
function esc(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#39;");
}

function displayGroupName(name){
  const n = String(name || "").trim();
  return n.toLowerCase().startsWith("tak_") ? n.slice(4) : n;
}

function setMsg(el, text, ok=true){
  el.textContent = text || "";
  el.className = "msg " + (ok ? "ok" : "bad");
}

async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
  } catch (e) {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
  }
}

// ----- Mutual aid members modal -----
const membersOverlay = document.getElementById("membersOverlay");
const membersCloseBtn = document.getElementById("membersCloseBtn");
const membersSummary = document.getElementById("membersSummary");
const membersFilter = document.getElementById("membersFilter");
const membersList = document.getElementById("membersList");
const membersHint = document.getElementById("membersHint");
const membersPrevBtn = document.getElementById("membersPrevBtn");
const membersNextBtn = document.getElementById("membersNextBtn");
const membersPageInfo = document.getElementById("membersPageInfo");

let activeMembers = [];
let activeMembersGroupId = "";
let activeMembersGroupName = "";
let membersCurrentPage = 1;
let membersPageSize = 100;
let membersTotalCount = 0;
let membersHasNext = false;
let membersHasPrev = false;

function showMembersModal(show) {
  if (!membersOverlay) return;
  membersOverlay.style.display = show ? "flex" : "none";
  document.body.classList.toggle("noScroll", !!show);
}

function renderMembersList() {
  const needle = String(membersFilter?.value || "").trim().toLowerCase();
  const items = (activeMembers || []).filter((u) => {
    if (!needle) return true;
    const uname = String(u.username || "").toLowerCase();
    const name = String(u.name || "").toLowerCase();
    const em = String(u.email || "").toLowerCase();
    return uname.includes(needle) || name.includes(needle) || em.includes(needle);
  });

  if (!items.length) {
    membersList.innerHTML = '<div class="muted">No members match your filter.</div>';
    return;
  }

  const rows = items
    .map(
      (u) => `
    <tr>
      <td>${esc(u.username || "")}</td>
      <td>${esc(u.name || "")}</td>
      <td>${esc(u.email || "")}</td>
    </tr>
  `
    )
    .join("");

  membersList.innerHTML = `
    <table class="table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Name</th>
          <th>Email</th>
        </tr>
      </thead>
      <tbody>
        ${rows}
      </tbody>
    </table>
  `;
}

function renderMembersPagination() {
  const total = Number(membersTotalCount || 0);
  const size = Math.max(1, Number(membersPageSize || 100));
  const totalPages = total > 0 ? Math.max(1, Math.ceil(total / size)) : 1;
  if (membersPageInfo) membersPageInfo.textContent = `Page ${membersCurrentPage} of ${totalPages}`;
  if (membersPrevBtn) membersPrevBtn.disabled = !membersHasPrev;
  if (membersNextBtn) membersNextBtn.disabled = !membersHasNext;
}

async function loadMembersPage(page) {
  if (!activeMembersGroupId) return;
  const targetPage = Math.max(1, Number(page || 1));
  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";

  const res = await fetch(
    `/api/groups/${encodeURIComponent(activeMembersGroupId)}/members?page=${targetPage}&pageSize=${membersPageSize}`
  );
  const out = await res.json();
  if (!res.ok) throw new Error(out.error || "Failed to load members");

  activeMembers = Array.isArray(out.users) ? out.users : [];
  membersCurrentPage = Number(out.page || targetPage || 1);
  membersPageSize = Number(out.pageSize || membersPageSize || 100);
  membersTotalCount = Number(out.memberCount || activeMembers.length || 0);
  membersHasNext = !!out.hasNext;
  membersHasPrev = !!out.hasPrev;

  const label = activeMembersGroupName || displayGroupName(out.group?.name || "") || activeMembersGroupId;
  membersSummary.textContent = `${membersTotalCount} member${
    membersTotalCount === 1 ? "" : "s"
  } in group "${label}".`;
  membersSummary.className = "msg ok";
  membersHint.textContent = membersTotalCount
    ? "Showing current members of this mutual aid group's Authentik group."
    : "No users are currently assigned to this mutual aid group.";

  renderMembersList();
  renderMembersPagination();
}

async function openMutualAidMembers(groupId, groupName) {
  activeMembersGroupId = String(groupId || "");
  activeMembersGroupName = displayGroupName(groupName || "");

  membersSummary.textContent = "Loading members...";
  membersSummary.className = "msg";
  membersList.innerHTML = "";
  membersHint.textContent = "";
  if (membersFilter) membersFilter.value = "";
  membersCurrentPage = 1;
  membersTotalCount = 0;
  membersHasNext = false;
  membersHasPrev = false;
  renderMembersPagination();

  showMembersModal(true);

  try {
    await loadMembersPage(1);
  } catch (e) {
    membersSummary.textContent = "Failed to load members.";
    membersSummary.className = "msg bad";
    membersList.innerHTML = "";
    membersHint.textContent = "";
    activeMembers = [];
    membersTotalCount = 0;
    membersHasNext = false;
    membersHasPrev = false;
    renderMembersPagination();
  }
}

if (membersCloseBtn && membersOverlay) {
  membersCloseBtn.onclick = () => showMembersModal(false);
  membersOverlay.addEventListener("click", (e) => {
    if (e.target === membersOverlay) showMembersModal(false);
  });
}
if (membersFilter) {
  membersFilter.oninput = renderMembersList;
}
if (membersPrevBtn) {
  membersPrevBtn.onclick = () => {
    if (membersHasPrev && membersCurrentPage > 1) {
      loadMembersPage(membersCurrentPage - 1).catch(() => {});
    }
  };
}
if (membersNextBtn) {
  membersNextBtn.onclick = () => {
    if (membersHasNext) {
      loadMembersPage(membersCurrentPage + 1).catch(() => {});
    }
  };
}

// ----- Page state -----

const maType = document.getElementById("maType");
const maTitle = document.getElementById("maTitle");
const maCreateBtn = document.getElementById("maCreateBtn");
const maCreateMsg = document.getElementById("maCreateMsg");

const maExpireWrap = document.getElementById("maExpireWrap");
const maExpireEnabled = document.getElementById("maExpireEnabled");
const maExpireAt = document.getElementById("maExpireAt");

const maGroupMode = document.getElementById("maGroupMode");
const maExistingGroupWrap = document.getElementById("maExistingGroupWrap");
const maExistingGroup = document.getElementById("maExistingGroup");
const maCreateHelp = document.getElementById("maCreateHelp");

const maFilter = document.getElementById("maFilter");
const maTbody = document.getElementById("maTbody");
const maListMsg = document.getElementById("maListMsg");


// ------- Sorting state -------
let maSortState = {
  key: "title",
  dir: "asc"
};

function normalizeSortValue(v){
  return String(v ?? "").trim().toLowerCase();
}

function maGetSortValue(it, key){
  if (key === "type") return normalizeSortValue(it.type);
  if (key === "title") return normalizeSortValue(it.title);
  return "";
}

function stableSortedCopy(arr, key, dir){
  const sign = dir === "desc" ? -1 : 1;
  return (arr || [])
    .map((item, idx) => ({ item, idx }))
    .sort((a, b) => {
      const av = maGetSortValue(a.item, key);
      const bv = maGetSortValue(b.item, key);

      const cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: "base" });
      if (cmp !== 0) return cmp * sign;
      return a.idx - b.idx;
    })
    .map(x => x.item);
}

function updateSortIndicators(){
  const thead = document.getElementById("maThead");
  const ths = Array.from(thead ? thead.querySelectorAll("th.sortable") : []);
  ths.forEach(th => {
    const key = th.dataset.key;
    const indicator = th.querySelector(".sortIndicator");
    if (!indicator) return;

    if (key === maSortState.key) {
      indicator.textContent = maSortState.dir === "asc" ? "▲" : "▼";
    } else {
      indicator.textContent = "";
    }
  });
}



const maThead = document.getElementById("maThead");
if (maThead){
  maThead.addEventListener("click", (e) => {
    const th = e.target && e.target.closest ? e.target.closest("th.sortable") : null;
    if (!th) return;

    const key = th.dataset.key;
    if (!key) return;

    if (maSortState.key === key){
      maSortState.dir = maSortState.dir === "asc" ? "desc" : "asc";
    } else {
      maSortState.key = key;
      maSortState.dir = "asc";
    }

    renderList();
  });
}
let allItems = [];
let activeItem = null;

// ----- Create: expiration controls -----
function updateCreateExpireUi(){
  // Expiration is supported for both EVENT and INCIDENT.
  const enabled = String(maExpireEnabled.value || "").toLowerCase() === "yes";
  maExpireAt.style.display = enabled ? "block" : "none";
  if (!enabled) maExpireAt.value = "";
}
maType.onchange = updateCreateExpireUi;
maExpireEnabled.onchange = updateCreateExpireUi;
updateCreateExpireUi();

// Group IDs tied to mutual aid channels — excluded from "Use Existing Group" picker.
let mutualAidExcludedGroupIds = new Set();

function refreshMutualAidExcludedGroupIds() {
  mutualAidExcludedGroupIds = new Set(
    (allItems || [])
      .map((it) => String(it?.groupId || "").trim())
      .filter(Boolean)
  );
}

function isMutualAidGroupName(name) {
  const raw = String(name || "").trim().toLowerCase();
  const withoutTak = raw.startsWith("tak_") ? raw.slice(4) : raw;
  return withoutTak.startsWith("ma -") || withoutTak.startsWith("ma-");
}

function groupsForExistingSelect() {
  return (groupsCache || []).filter((g) => {
    const id = String(g?.pk || "").trim();
    if (id && mutualAidExcludedGroupIds.has(id)) return false;
    if (isMutualAidGroupName(g?.name)) return false;
    return true;
  });
}

function renderExistingGroupSelect() {
  if (!maExistingGroup) return;
  const current = String(maExistingGroup.value || "");
  const items = groupsForExistingSelect()
    .slice()
    .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")));

  const opts = [`<option value="">-- Select A Group --</option>`].concat(
    items.map((g) => {
      const id = String(g.pk);
      const rawName = String(g.name || "");
      const label = displayGroupName(rawName);
      return `<option value="${esc(id)}">${esc(label)}</option>`;
    })
  );

  maExistingGroup.innerHTML = opts.join("");
  if (current) maExistingGroup.value = current;
}

function updateCreateGroupModeUi() {
  const mode = String(maGroupMode?.value || "new").toLowerCase();
  const isExisting = mode === "existing";
  // Use flex so the "Existing Group" label sits above the dropdown.
  if (maExistingGroupWrap) maExistingGroupWrap.style.display = isExisting ? "flex" : "none";

  if (maCreateHelp) {
    maCreateHelp.innerHTML = isExisting
      ? `This will create a matching user with an auto-generated 18-character password and add it to the selected group.`
      : `This will create a group named <strong>MA - TITLE</strong> and a matching user with an auto-generated 18-character password.`;
  }

  if (isExisting) {
    // Ensure groups are loaded and dropdown is populated.
    if (!groupsCache || !groupsCache.length) {
      loadGroups().catch(() => {});
    } else {
      renderExistingGroupSelect();
    }
  } else {
    if (maExistingGroup) maExistingGroup.value = "";
  }
}

if (maGroupMode) maGroupMode.onchange = updateCreateGroupModeUi;
