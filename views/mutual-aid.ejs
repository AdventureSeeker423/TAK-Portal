const editLogoChooseBtn = document.getElementById("editLogoChooseBtn");
const editLogoCurrent = document.getElementById("editLogoCurrent");
const editLogoRemoveBtn = document.getElementById("editLogoRemoveBtn");
let editLogoRemovePending = false;

function logoUrlToDisplayName(logoUrl) {
  const path = String(logoUrl || "").trim();
  if (!path) return "";
  const base = path.split("/").pop() || path;
  try {
    return decodeURIComponent(base);
  } catch {
    return base;
  }
}

function setEditLogoCurrentLabel(text) {
  if (!editLogoCurrent) return;
  const label = String(text || "").trim() || "No file chosen";
  editLogoCurrent.textContent = label;
  editLogoCurrent.title = label;
}

function updateEditLogoRemoveBtn(hasCustom) {
  if (!editLogoRemoveBtn) return;
  editLogoRemoveBtn.style.display = hasCustom ? "inline-block" : "none";
}

function openEdit(item){
  activeItem = item;
  editOverlay.style.display = "flex";
  document.body.classList.add("noScroll");
  const sub = isSubMutualAidType(item?.type);
  if (editTypeWrap) editTypeWrap.style.display = sub ? "none" : "";
  if (editType) {
    const base = baseMutualAidType(item?.type) || "INCIDENT";
    editType.value = base;
    editType.disabled = false;
  }
  editName.value = item.title || "";
  // Expiration fields (EVENT + INCIDENT)
  editExpireEnabled.value = item.expireEnabled ? "yes" : "no";
  if (item.expireAt) {
    const d = new Date(item.expireAt);
    if (!Number.isNaN(d.getTime())) {
      const pad = (n) => String(n).padStart(2, "0");
      const yyyy = d.getFullYear();
      const mm = pad(d.getMonth() + 1);
      const dd = pad(d.getDate());
      const hh = pad(d.getHours());
      const min = pad(d.getMinutes());
      editExpireAt.value = `${yyyy}-${mm}-${dd}T${hh}:${min}`;
    } else {
      editExpireAt.value = "";
    }
	  } else {
	    editExpireAt.value = "";
	  }
  updateEditExpireUi();

  editLogoRemovePending = false;
  if (editLogoFile) editLogoFile.value = "";

  const anchor = getGroupAnchorForGroup(item?.groupId);
  const isAnchor = !!(anchor && String(anchor.id) === String(item.id));
  const showLogo = !sub && isAnchor;
  if (editLogoWrap) editLogoWrap.style.display = showLogo ? "block" : "none";
  if (showLogo) {
    const customLogo = String(anchor?.logoUrl || item?.logoUrl || "").trim();
    if (customLogo) {
      setEditLogoCurrentLabel(logoUrlToDisplayName(customLogo));
    } else {
      setEditLogoCurrentLabel("No file chosen");
    }
    updateEditLogoRemoveBtn(!!customLogo);
  } else {
    setEditLogoCurrentLabel("No file chosen");
    updateEditLogoRemoveBtn(false);
  }

  setMsg(editMsg, "", true);
}

if (editLogoChooseBtn && editLogoFile) {
  editLogoChooseBtn.onclick = () => editLogoFile.click();
}

if (editLogoFile) {
  editLogoFile.onchange = () => {
    editLogoRemovePending = false;
    const file = editLogoFile.files && editLogoFile.files[0];
    if (file) {
      setEditLogoCurrentLabel(file.name);
      updateEditLogoRemoveBtn(true);
    } else {
      setEditLogoCurrentLabel("No file chosen");
      updateEditLogoRemoveBtn(false);
    }
  };
}

if (editLogoRemoveBtn) {
  editLogoRemoveBtn.onclick = () => {
    editLogoRemovePending = true;
    if (editLogoFile) editLogoFile.value = "";
    setEditLogoCurrentLabel("No file chosen");
    updateEditLogoRemoveBtn(false);
  };
}

function updateEditExpireUi(){
  // Expiration is supported for both EVENT and INCIDENT.
  editExpireEnabledWrap.style.display = "block";

  const enabled = String(editExpireEnabled.value || "").toLowerCase() === "yes";

  editExpireAt.disabled = !enabled;
  editExpireAt.style.display = enabled ? "block" : "none";

  if (!enabled) {
    editExpireAt.value = "";
  }
}

