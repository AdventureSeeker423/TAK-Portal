    border-bottom: 2px solid var(--line);
  }

  .btn.maAddUser {
    background: #ea580c;
    border-color: #ea580c;
    color: #fff;
  }
  .btn.maAddUser:hover {
    filter: brightness(0.95);
  }

  #addMaUserOverlay #addMaExpireAt::-webkit-calendar-picker-indicator {
