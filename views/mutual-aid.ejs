function hexToRgb(hex) {
  const h = String(hex || "").replace(/^#/, "");
  if (h.length === 3) {
    const r = int(h[0] + h[0]);
    const g = int(h[1] + h[1]);
    const b = int(h[2] + h[2]);
    return [r, g, b];
  }
  if (h.length !== 6) return [0, 0, 0];
  const r = int(h.slice(0, 2));
  const g = int(h.slice(2, 4));
  const b = int(h.slice(4, 6));
  return [r, g, b];
  function int(s) {
    const n = parseInt(s, 16);
    return Number.isFinite(n) ? n : 0;
  }
}

function makeQrDataUrl(text, cellSize = 8, margin = 2) {
  // qrcode-generator (cdnjs) exposes global: qrcode
  const qr = qrcode(0, "M");
  qr.addData(String(text || ""));
  qr.make();
  return qr.createDataURL(cellSize, margin);
}

function fitOneLine(doc, text, maxWidthPt, startSizePt) {
  let size = startSizePt;
  doc.setFontSize(size);
  while (size > 10 && doc.getTextWidth(text) > maxWidthPt) {
    size -= 1;
    doc.setFontSize(size);
  }
  return size;
}

function drawNumberedList(doc, items, x, y, maxWidth, lineHeight = 16, indent = 14) {
  let cursorY = y;

  doc.setFont("helvetica", "normal");
  doc.setFontSize(12);

  items.forEach((text, i) => {
    const number = `${i + 1}.`;

    // Draw the number
    doc.text(number, x, cursorY);

    // Draw the text, indented
    const lines = doc.splitTextToSize(text, maxWidth - indent);
    doc.text(lines, x + indent, cursorY);

    cursorY += lines.length * lineHeight;
  });

  return cursorY;
}


async function loadHiResEnrollmentQrDataUrl(itemId) {
  const res = await fetch(`/api/mutual-aid/${encodeURIComponent(itemId)}/qr/download`);
  if (!res.ok) {
    let msg = "Failed to load enrollment QR";
    try {
      const t = await res.text();
      if (t) msg = t;
    } catch {
      /* ignore */
    }
    throw new Error(msg);
  }
  const blob = await res.blob();
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(String(reader.result || ""));
    reader.onerror = () => reject(new Error("Failed to read enrollment QR"));
    reader.readAsDataURL(blob);
  });
}

/** Downscale a PNG data URL for PDF embed (keeps PNG for scannable QRs). */
function downscalePngDataUrl(dataUrl, maxEdge = 1100) {
  return new Promise((resolve) => {
    const src = String(dataUrl || "");
    if (!src) {
      resolve("");
      return;
    }
    const img = new Image();
    img.onload = () => {
      try {
        const w = img.naturalWidth || img.width || 0;
        const h = img.naturalHeight || img.height || 0;
        if (!w || !h) {
          resolve(src);
          return;
        }
        const scale = Math.min(1, maxEdge / Math.max(w, h));
        if (scale >= 0.98) {
          resolve(src);
          return;
        }
        const canvas = document.createElement("canvas");
        canvas.width = Math.max(1, Math.round(w * scale));
        canvas.height = Math.max(1, Math.round(h * scale));
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          resolve(src);
          return;
        }
        ctx.imageSmoothingEnabled = false;
        ctx.fillStyle = "#ffffff";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        resolve(canvas.toDataURL("image/png"));
      } catch {
        resolve(src);
      }
    };
    img.onerror = () => resolve(src);
    img.src = src;
  });
}

function splitServerNameForFlyer(serverName) {
  const raw = String(serverName || "").trim();
  if (!raw) return { orgName: "TAK", orgA: "TAK", orgB: "" };
  const takMatch = raw.match(/^(.*?)(TAK)$/i);
  if (takMatch && takMatch[1]) {
    return {
      orgName: raw,
      orgA: takMatch[1].trim() || "TAK",
      orgB: takMatch[2],
    };
  }
  return { orgName: raw, orgA: raw, orgB: "" };
}

/**
 * Human-readable placeholders for CALLSIGN_FORMAT_EXPRESSION.
 * Keys must match settings.ejs callsign FIELD_OPTIONS values (and users.service.js buildCallsign).
 * Never collapse unknown tokens to "X" — that hid misconfigured/custom fields.
 */
const CALLSIGN_FORMAT_LABELS = {
  stateAbbreviation: "State",
  county: "County",
  countyAbbreviation: "CountyAbbrev",
  agencyAbbreviation: "Agency",
  agencyTypeCode: "AgencyType",
  currentTemplate: "Template",
  firstName: "FirstName",
  firstInitial: "FirstInitial",
  lastNameUpper: "LastName",
  lastName: "LastName",
  lastInitial: "LastInitial",
  badgeNumber: "RadioID",
  radioCallsignOrBlank: "RadioCallsign",
};

function readableCallsignFormat(expression) {
  const expr = String(expression || "").trim();
  if (!expr) return "Agency-LastName-RadioID";
  return expr.replace(/\{\{\s*([a-zA-Z0-9_]+)\s*\}\}/g, (_, key) => {
    const label = CALLSIGN_FORMAT_LABELS[key];
    if (label) return label;
    // Preserve a readable token name (do not use "X")
    const k = String(key || "");
    return k ? k.charAt(0).toUpperCase() + k.slice(1) : "?";
  });
}

function markdownToFlyerPlainText(md) {
  return String(md || "")
    .replace(/\r\n/g, "\n")
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/^#{1,6}\s+/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*\d+\.\s+/gm, "")
    .replace(/[*_~]+/g, "")
    .replace(/\n+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function buildFlyerTeamRoleListHtml(roles) {
  const list = Array.isArray(roles) ? roles : [];
  if (!list.length) {
    return `<span class="ref-empty">No team roles configured</span>`;
  }
  return (
    `<ul class="ref-list">` +
    list
      .map((r) => {
        const label = esc(r.name || "");
        const desc = String(r.desc || "").trim();
        return `<li><strong>${label}</strong>${
          desc ? ` <span class="ref-desc">— ${esc(desc)}</span>` : ""
        }</li>`;
      })
      .join("") +
    `</ul>`
  );
}

function buildFlyerTeamColorListHtml(colors) {
  const list = Array.isArray(colors) ? colors : [];
  if (!list.length) {
    return `<span class="ref-empty">No team colors configured</span>`;
  }
  return (
    `<ul class="ref-list">` +
    list
      .map((c) => {
        const hex = String(c.hex || "#888").trim() || "#888";
        const border =
          String(hex).toLowerCase() === "#ffffff" ? "border:1px solid #999;" : "";
        const label = esc(c.name || "");
        const desc = String(c.desc || "").trim();
        return `<li><span class="ref-swatch" style="background:${esc(
          hex
        )};${border}"></span><strong>${label}</strong>${
          desc ? ` <span class="ref-desc">— ${esc(desc)}</span>` : ""
        }</li>`;
      })
      .join("") +
    `</ul>`
  );
}

async function loadBrandLogoDataUrl() {
  const logoPath = getSetting("BRAND_LOGO_URL");
  if (!logoPath) return "";
  try {
    const abs = /^https?:\/\//i.test(logoPath)
      ? logoPath
      : new URL(logoPath, window.location.origin).href;
    const res = await fetch(abs, { credentials: "same-origin" });
    if (!res.ok) return "";
    const blob = await res.blob();
    return await new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result || ""));
      reader.onerror = () => reject(new Error("Failed to read brand logo"));
      reader.readAsDataURL(blob);
    });
  } catch (err) {
    console.warn("[mutual-aid] brand logo for flyer skipped:", err?.message || err);
    return "";
  }
}

function fillEnrollmentFlyerHtml(tokens) {
  let html = String(ENROLLMENT_FLYER_HTML || "");
  Object.keys(tokens || {}).forEach((key) => {
    const value = String(tokens[key] ?? "");
    html = html.split(`{{${key}}}`).join(value);
  });
  return html;
}

/**
 * Render the flyer in an isolated iframe so its CSS (body/header/main/*)
 * cannot restyle the live Mutual Aid page during capture.
 */
async function mountEnrollmentFlyerIframe(filledHtml) {
  const letterW = Math.round(8.5 * 96);
  const letterH = Math.round(11 * 96);
  const iframe = document.createElement("iframe");
  iframe.id = "maEnrollmentFlyerFrame";
  iframe.setAttribute("aria-hidden", "true");
  iframe.setAttribute("tabindex", "-1");
  iframe.style.cssText = [
    "position:fixed",
    "left:-12000px",
    "top:0",
    `width:${letterW}px`,
    `height:${letterH}px`,
    "margin:0",
    "padding:0",
    "border:0",
    "opacity:1",
    "pointer-events:none",
    "visibility:visible",
    "z-index:-1",
    "background:#fff",
  ].join(";");
  document.body.appendChild(iframe);

  const idoc = iframe.contentDocument;
  if (!idoc) {
    iframe.remove();
    throw new Error("Flyer frame unavailable.");
  }
  idoc.open();
  idoc.write(String(filledHtml || ""));
  idoc.close();

  await new Promise((resolve) => {
    const done = () => resolve();
    if (idoc.readyState === "complete") {
      done();
      return;
    }
    iframe.addEventListener("load", done, { once: true });
    setTimeout(done, 200);
  });

  try {
    if (idoc.fonts?.ready) {
      await Promise.race([
        idoc.fonts.ready,
        new Promise((r) => setTimeout(r, 900)),
      ]);
    }
  } catch {
    /* ignore font wait */
  }

  const target =
    idoc.getElementById("maEnrollmentFlyerRoot") ||
    idoc.querySelector(".content") ||
    idoc.body;

  return {
    iframe,
    idoc,
    target,
    letterW,
    letterH,
    cleanup() {
      try {
        iframe.remove();
      } catch {
        /* ignore */
      }
    },
  };
}

async function renderEnrollmentFlyerPageImage(qrDataUrl) {
  if (!ENROLLMENT_FLYER_HTML) {
    throw new Error("Enrollment flyer template is not available.");
  }
  if (typeof window.html2canvas !== "function") {
    throw new Error("Flyer renderer failed to load.");
  }

  const serverName = String(getSetting("SERVER_NAME") || "").trim();
  const split = splitServerNameForFlyer(serverName || "TAK");
  const channelName =
    displayGroupName(qrActiveItem?.groupName || "").trim() ||
    String(qrActiveItem?.title || "").trim() ||
    "Mutual Aid Channel";
  const eventName = String(qrActiveItem?.title || "").trim() || "Mutual Aid Operation";
  const typeLabel = String(qrActiveItem?.type || "Event").trim() || "Event";
  const portalBase = String(getSetting("TAK_PORTAL_PUBLIC_URL") || "")
    .trim()
    .replace(/\/+$/, "");
  const requestAccessUrl = portalBase
    ? `${portalBase}/request-access`
    : "/request-access";
  const callsignFormat = readableCallsignFormat(
    getSetting("CALLSIGN_FORMAT_EXPRESSION")
  );

  const agreementEnabled = !!(
    FLYER_USER_AGREEMENT &&
    FLYER_USER_AGREEMENT.enabled &&
    String(FLYER_USER_AGREEMENT.text || "").trim()
  );
  const compliancePlainRaw = agreementEnabled
    ? markdownToFlyerPlainText(FLYER_USER_AGREEMENT.text)
    : "";
  const compliancePlain =
    compliancePlainRaw.length > 450
      ? `${compliancePlainRaw.slice(0, 447).trim()}...`
      : compliancePlainRaw;
  const complianceBannerHtml = compliancePlain
    ? `<div class="alert-banner"><strong>&#9888; Compliance Notice:</strong> <span class="alert-banner-text">${esc(
        compliancePlain
      )}</span></div>`
    : "";

  let logoHtml = `<div class="logo-shield">TAK<span>PORTAL</span></div>`;
  try {
    const logoDataUrl = await loadBrandLogoDataUrl();
    if (logoDataUrl) {
      logoHtml = `<img class="flyer-logo" id="maFlyerLogoImg" src="${logoDataUrl}" alt="${esc(
        serverName || "TAK Portal"
      )} Logo">`;
    }
  } catch {
    /* keep fallback shield */
  }

  const headerTitleHtml = serverName
    ? `<h1 class="header-title"><span class="header-server">${esc(
        serverName
      )}</span><span class="header-enrollment">Mutual Aid Enrollment</span></h1>`
    : `<h1 class="header-title header-title-solo"><span class="header-enrollment">Mutual Aid Enrollment</span></h1>`;

  const tokens = {
    ORG_NAME: esc(split.orgName),
    ORG_NAME_A: esc(split.orgA),
    ORG_NAME_B: esc(split.orgB),
    HEADER_TITLE_HTML: headerTitleHtml,
    EVENT_NAME: esc(eventName),
    EVENT_SUBTITLE: esc(`${typeLabel} — Multi-Agency Mutual Aid`),
    CHANNEL_NAME: esc(channelName),
    QR_LABEL: esc(channelName),
    // Do not HTML-escape; this is a data: URL for <img src>.
    QR_DATA_URL: String(qrDataUrl || ""),
    LOGO_HTML: logoHtml,
    COMPLIANCE_BANNER_HTML: complianceBannerHtml,
    CALLSIGN_FORMAT: esc(callsignFormat),
    TEAM_ROLE_LIST_HTML: buildFlyerTeamRoleListHtml(TEAM_ROLES),
    TEAM_COLOR_LIST_HTML: buildFlyerTeamColorListHtml(TEAM_COLORS),
    REQUEST_ACCESS_URL: esc(requestAccessUrl),
  };

  const filled = fillEnrollmentFlyerHtml(tokens);
  const frame = await mountEnrollmentFlyerIframe(filled);
  const { target, idoc, letterW, letterH, cleanup } = frame;

  try {
    await new Promise((resolve) => setTimeout(resolve, 150));
    const waitImg = (img) => {
      if (!img || img.complete) return Promise.resolve();
      return new Promise((resolve) => {
        img.onload = () => resolve();
        img.onerror = () => resolve();
        setTimeout(resolve, 1500);
      });
    };
    await waitImg(idoc.getElementById("maFlyerQrImg"));
    await waitImg(idoc.getElementById("maFlyerLogoImg"));

    if (target && target.style) {
      target.style.width = `${letterW}px`;
      target.style.height = `${letterH}px`;
      target.style.maxWidth = `${letterW}px`;
      target.style.overflow = "hidden";
    }
    if (idoc.body) {
      idoc.body.style.margin = "0";
      idoc.body.style.width = `${letterW}px`;
      idoc.body.style.height = `${letterH}px`;
      idoc.body.style.overflow = "hidden";
    }
    if (idoc.documentElement) {
      idoc.documentElement.style.width = `${letterW}px`;
      idoc.documentElement.style.height = `${letterH}px`;
    }

    // ~192 DPI Letter capture; JPEG kept lossy for email size but sharp enough to print.
    const captureOpts = {
      scale: 2,
      backgroundColor: "#ffffff",
      useCORS: true,
      allowTaint: true,
      logging: false,
      width: letterW,
      height: letterH,
      windowWidth: letterW,
      windowHeight: letterH,
      scrollX: 0,
      scrollY: 0,
      x: 0,
      y: 0,
      onclone(clonedDoc) {
        try {
          const style = clonedDoc.createElement("style");
          style.textContent = `
            * {
              font-family: Arial, Helvetica, sans-serif !important;
              letter-spacing: 0 !important;
              word-spacing: normal !important;
              box-sizing: border-box !important;
            }
            html, body, #maEnrollmentFlyerRoot {
              width: ${letterW}px !important;
              height: ${letterH}px !important;
              max-width: ${letterW}px !important;
              overflow: hidden !important;
              margin: 0 !important;
              padding: 0 !important;
              border: 0 !important;
              background: #fff !important;
            }
            .flyer-sheet {
              width: ${letterW}px !important;
              height: ${letterH}px !important;
              margin: 0 !important;
              padding: 0.38in !important;
              border: 0 !important;
              background: #fff !important;
              display: table !important;
              table-layout: fixed !important;
              overflow: hidden !important;
            }
            .flyer-sheet-inner {
              display: table-cell !important;
              vertical-align: top !important;
              background: #fff !important;
            }
            header, .header-row, .header-logo-cell, .header-title-cell, .header-badge-cell {
              background: #0f1b2d !important;
            }
            .header-row {
              display: table !important;
              width: 100% !important;
            }
            .header-logo-cell, .header-title-cell, .header-badge-cell {
              display: table-cell !important;
              vertical-align: middle !important;
            }
            .header-badge {
              display: inline-block !important;
              white-space: nowrap !important;
              overflow: visible !important;
            }
            .header-badge .badge-value {
              white-space: nowrap !important;
              overflow: visible !important;
              text-align: center !important;
            }
            .flyer-cols {
              width: 100% !important;
              border-collapse: collapse !important;
              table-layout: fixed !important;
            }
            .col-steps, .col-ref {
              vertical-align: top !important;
              overflow: visible !important;
            }
            .step {
              display: table !important;
              width: 100% !important;
              table-layout: fixed !important;
            }
            .step-n, .step-t {
              display: table-cell !important;
              vertical-align: top !important;
            }
            .nav-path, .note-box, .nav-paths, .steps, .qr-wrap {
              display: block !important;
              width: 100% !important;
              float: none !important;
              position: static !important;
            }
            .qr-wrap, .qr-title, .qr-sub {
              text-align: center !important;
            }
            .alert-banner, .alert-banner * {
              letter-spacing: 0 !important;
              word-spacing: normal !important;
              white-space: normal !important;
              overflow-wrap: break-word !important;
            }
            .ref-list {
              display: block !important;
            }
            .ref-list li {
              display: block !important;
              flex: none !important;
              height: auto !important;
              margin: 0 0 3px !important;
              line-height: 1.4 !important;
              overflow: visible !important;
              white-space: normal !important;
            }
            .ref-swatch {
              display: inline-block !important;
              vertical-align: -1px !important;
              margin-right: 4px !important;
              position: static !important;
            }
          `;
          (clonedDoc.head || clonedDoc.documentElement).appendChild(style);
        } catch (err) {
          console.warn("[mutual-aid] flyer capture clone harden failed:", err?.message || err);
        }
      },
    };

    // Prefer foreignObjectRendering for correct text spacing; fall back if blank/unusable.
    let canvas = null;
    try {
      canvas = await window.html2canvas(target, {
        ...captureOpts,
        foreignObjectRendering: true,
      });
      if (!canvas || canvas.width < 10 || canvas.height < 10) {
        throw new Error("foreignObject capture empty");
      }
      // Detect a near-blank capture (all white / transparent).
      // Sample inside the navy header, below the page inset.
      const sampleY = Math.min(
        canvas.height - 32,
        Math.round(canvas.height * (0.38 / 11)) + 20
      );
      const probe = canvas.getContext("2d").getImageData(
        Math.round(canvas.width * 0.12),
        sampleY,
        24,
        24
      ).data;
      let dark = 0;
      for (let i = 0; i < probe.length; i += 4) {
        if (probe[i] + probe[i + 1] + probe[i + 2] < 720) dark += 1;
      }
      if (dark < 2) throw new Error("foreignObject capture blank");
    } catch (foErr) {
      console.warn(
        "[mutual-aid] flyer foreignObject capture fallback:",
        foErr?.message || foErr
      );
      canvas = await window.html2canvas(target, {
        ...captureOpts,
        foreignObjectRendering: false,
      });
    }

    // Cover residual 1px white fringe at the inner sheet / header join.
    try {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        const inset = Math.round(canvas.width * (0.38 / 8.5));
        const fringe = Math.max(2, Math.round(canvas.width * 0.002));
        const headerH = Math.round(canvas.height * 0.11);
        ctx.fillStyle = "#0f1b2d";
        ctx.fillRect(inset, inset, fringe, headerH);
        ctx.fillRect(canvas.width - inset - fringe, inset, fringe, headerH);
      }
    } catch {
      /* ignore */
    }

    return canvas.toDataURL("image/jpeg", 0.92);
  } finally {
    cleanup();
  }
}

async function buildDeploymentPacketPdf() {
  try {
    if (!qrEnrollUrl || !qrActiveId) {
      throw new Error("QR not ready yet.");
    }

    // jsPDF UMD bundle exposes window.jspdf.jsPDF
    const jsPDF = window.jspdf?.jsPDF;
    if (!jsPDF) {
      throw new Error("PDF library failed to load.");
    }
    if (typeof window.qrcode !== "function") {
      throw new Error("QR library failed to load.");
    }

    const doc = new jsPDF({ orientation: "portrait", unit: "pt", format: "letter" });
    const pageW = doc.internal.pageSize.getWidth();
    const pageH = doc.internal.pageSize.getHeight();

    // Slightly larger margins so content isn't so close to the page edges.
    const margin = 54;

    // Flyer uses the compact modal QR (1024px). Dedicated QR page uses a downscaled hi-res PNG.
    let flyerQr = String(qrCodeDataUrl || (qrImg && qrImg.src) || "").trim();
    if (!flyerQr || flyerQr.indexOf("data:image") !== 0) {
      try {
        await ensureEnrollmentQrReady(qrActiveItem || { id: qrActiveId });
        flyerQr = String(qrCodeDataUrl || "").trim();
      } catch (flyerQrErr) {
        console.warn(
          "[mutual-aid] flyer QR load failed:",
          flyerQrErr?.message || flyerQrErr
        );
      }
    }

    let packetEnrollmentQr = "";
    try {
      const hiResEnrollmentQr = await loadHiResEnrollmentQrDataUrl(qrActiveId);
      packetEnrollmentQr = await downscalePngDataUrl(hiResEnrollmentQr, 1100);
    } catch (qrLoadErr) {
      console.warn(
        "[mutual-aid] enrollment QR load failed:",
        qrLoadErr?.message || qrLoadErr
      );
      packetEnrollmentQr = flyerQr;
    }

    // --- Page 1: Enrollment flyer (white-body Letter flyer) ---
    let flyerOk = false;
    if (flyerQr) {
      try {
        const flyerImage = await renderEnrollmentFlyerPageImage(flyerQr);
        doc.addImage(flyerImage, "JPEG", 0, 0, pageW, pageH, undefined, "FAST");
        flyerOk = true;
      } catch (flyerErr) {
        console.warn(
          "[mutual-aid] enrollment flyer page skipped:",
          flyerErr?.message || flyerErr
        );
      }
    }

    // Existing instructional pages start here (were pages 1–4; now 2–5 if flyer succeeded).
    if (flyerOk) {
      doc.addPage();
    } else {
      // Soft-fail: still generate instructional pages. Callers may show this via qrMsg.
      if (typeof setMsg === "function" && qrMsg) {
        setMsg(
          qrMsg,
          "Enrollment flyer could not be rendered; continuing with instructional pages.",
          true
        );
      }
    }

    // --- App QR codes + Instructions ---
    const qrSize1 = 280; // Bigger but still safe on Letter
    const textWidth = pageW - margin * 2;
    let y = margin;

    const takAwareUrl = "https://apps.apple.com/us/app/tak-aware/id6738631659";
    const atakUrl = "https://play.google.com/store/apps/details?id=com.atakmap.app.civ";
    const takAwareQr = makeQrDataUrl(takAwareUrl, 10, 2);
    const atakQr = makeQrDataUrl(atakUrl, 10, 2);

    /* =========================================================
      TAK AWARE (iOS)
    ========================================================= */

    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Download TAK Aware (iOS)", margin, y);

    doc.addImage(takAwareQr, "PNG", margin, y + 14, qrSize1, qrSize1);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    drawNumberedList(
      doc,
      [
        "Open TAK Aware on your iPhone or iPad.",
        "When prompted, allow Location access and set it to Always Allow.",
        "Enter your assigned Call Sign, Team, and Role.",
        "Tap Connect to a TAK Server, then select Scan QR Code.",
        "Allow camera access and scan the QR code.",
        "Confirm the status shows Succeeded."
      ],
      margin + qrSize1 + 28,
      y + 32,
      textWidth - qrSize1 - 28
    );

    /* =========================================================
      ATAK (Android)
    ========================================================= */

    y = y + qrSize1 + 110;

    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Download ATAK (Android)", margin, y);

    doc.addImage(atakQr, "PNG", margin, y + 14, qrSize1, qrSize1);

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);
    drawNumberedList(
      doc,
      [
        "Open the camera on your Android device.",
        "Point your camera at the QR code and open the link.",
        "Install and open ATAK.",
        "Select Yes to perform quick enrollment."
      ],
      margin + qrSize1 + 28,
      y + 32,
      textWidth - qrSize1 - 28
    );

    /* =========================================================
       PAGE 2 — USER QR + CALLSIGN FORMAT
    ========================================================= */

    doc.addPage();

    // Callsign header — same CALLSIGN_FORMAT_EXPRESSION as packet page 1 / settings.ejs
    doc.setFont("helvetica", "normal");
    doc.setFontSize(20);
    doc.setTextColor(80);
    doc.text("Callsign Format:", pageW / 2, margin, { align: "center" });

    const callsignText = readableCallsignFormat(
      getSetting("CALLSIGN_FORMAT_EXPRESSION")
    );
    doc.setFont("helvetica", "bold");
    doc.setFontSize(36);
    doc.setTextColor(0);
    fitOneLine(doc, callsignText, pageW - margin * 2, 36);
    doc.text(callsignText, pageW / 2, margin + 42, { align: "center" });

    // Main enrollment QR (PNG kept for scan reliability; downscaled for packet size)
    const maxQrBox = Math.min(pageW - margin * 2, pageH - (margin * 2 + 120));
    const qrY2 = margin + 70;
    if (packetEnrollmentQr) {
      const qrProps = doc.getImageProperties(packetEnrollmentQr);
      const qrScale = Math.min(maxQrBox / qrProps.width, maxQrBox / qrProps.height);
      const drawQrW = qrProps.width * qrScale;
      const drawQrH = qrProps.height * qrScale;

      doc.addImage(
        packetEnrollmentQr,
        "PNG",
        (pageW - drawQrW) / 2,
        qrY2,
        drawQrW,
        drawQrH
      );

      // Username label
      const userLabel = String(qrActiveItem?.username || "").trim();
      if (userLabel) {
        const userY = Math.min(pageH - margin, qrY2 + drawQrH + 32);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(24);
        doc.text(userLabel, pageW / 2, userY, { align: "center" });
      }
    }

    // --- Page 3: Team Color Guide ---
    doc.addPage();
    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Team Color Guide", pageW / 2, margin, { align: "center" });

    // Add a full row of whitespace under the title.
    y = margin + 30 + 44;
    const lineH = 44;
    const swatch = 22;
    doc.setFont("helvetica", "bold");
    doc.setFontSize(20);
    for (const c of TEAM_COLORS) {
      if (y + lineH > pageH - margin) break;
      const [r, g, b] = hexToRgb(c.hex);
      doc.setFillColor(r, g, b);
      doc.setDrawColor(0);
      doc.rect(margin, y - swatch + 6, swatch, swatch, "FD");

      // For white swatches, add a border so it shows up.
      if (String(c.hex).toLowerCase() == "#ffffff") {
        doc.setDrawColor(120);
        doc.rect(margin, y - swatch + 6, swatch, swatch);
        doc.setDrawColor(0);
      }

      const label = c.desc ? `${c.name} — ${c.desc}` : c.name;
      doc.setTextColor(0);
      doc.text(label, margin + swatch + 12, y);
      y += lineH;
    }

    // --- Page 4: Team Role Guide ---
    doc.addPage();
    doc.setFont("helvetica", "bold");
    doc.setFontSize(26);
    doc.text("Team Role Guide", pageW / 2, margin, { align: "center" });

    // Add a full row of whitespace under the title.
    y = margin + 30 + 44;
    doc.setFont("helvetica", "bold");
    doc.setFontSize(20);
    for (const r of TEAM_ROLES) {
      if (y + lineH > pageH - margin) break;
      const label = r.desc ? `${r.name} — ${r.desc}` : r.name;
      doc.text(label, margin, y);
      y += lineH;
    }

    const filenameSafe = (String(qrActiveItem?.username || "deployment-packet")
      .trim()
      .replace(/[^a-z0-9_-]+/gi, "-")
      .replace(/-+/g, "-")
      .replace(/^[-_]+|[-_]+$/g, "")
      || "deployment-packet").toLowerCase();
    return doc;
  } catch (e) {
    throw e;
  }

  function min(a, b) { return a < b ? a : b; }
}

// Download the same packet built by buildDeploymentPacketPdf().
async function downloadDeploymentPacketForItem(item) {
  try {
    setMsg(maListMsg, "Building packet...", "progress");
    await ensureEnrollmentQrReady(item);
    const doc = await buildDeploymentPacketPdf();

    const filenameSafe = ((qrActiveItem?.username || "deployment-packet")
      .trim()
      .replace(/[^a-z0-9_-]+/gi, "-")
      .replace(/-+/g, "-")
      .replace(/^[-_]+|[-_]+$/g, "")
      || "deployment-packet").toLowerCase();

    doc.save(`${filenameSafe}-packet.pdf`);
    setMsg(maListMsg, "Packet downloaded.", true);
  } catch (e) {
    setMsg(maListMsg, e?.message || String(e), false);
  }
}

