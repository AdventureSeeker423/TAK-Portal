<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Mutual Aid",
    scopedSuffix: "Mutual Aid",
    singleFallbackTitle: "Agency Mutual Aid"
  }) %>

  <div class="card">
    <h2>Create Mutual Aid</h2>

    <div class="row createMaFields">
      <label class="createMaField createMaField--type">Type
        <select id="maType">
          <option value="INCIDENT" selected>Incident</option>
          <option value="EVENT">Event</option>
          <option value="STANDBY">Standby</option>
        </select>
      </label>

      <label class="createMaField createMaField--title">Title
        <input
          id="maTitle"
          placeholder="Title (ex. County Fair, Search, etc...)"
        />
      </label>

      <label class="createMaField createMaField--group">Group
        <select id="maGroupMode">
          <option value="new" selected>Create New Group</option>
          <option value="existing">Use Existing Group</option>
        </select>
      </label>

      <label id="maExistingGroupWrap" class="createMaField createMaField--existing" style="display:none;">
        Existing Group
        <select id="maExistingGroup"></select>
      </label>

      <label id="maExpireWrap" class="createMaField createMaField--expire">Expires
        <select id="maExpireEnabled">
          <option value="no" selected>No</option>
          <option value="yes">Yes</option>
        </select>
      </label>

      <label id="maExpireAtWrap" class="createMaField createMaField--expireAt" style="display:none;">Expire At
        <input id="maExpireAt" type="datetime-local" />
      </label>

      <div class="createMaField createMaField--submit">
        <button class="btn" id="maCreateBtn" type="button">Create New Mutual Aid</button>
      </div>
    </div>

    <div id="maCreateMsg" class="msg" style="margin-top:10px;"></div>
  </div>

  <div class="card">
    <div class="row" style="justify-content: space-between; align-items:center;">
      <h2 style="margin:0;">Active Incidents & Events</h2>
    </div>

    <div class="row" style="margin: 10px 0;">
      <input id="maFilter" placeholder="Filter..." style="flex: 1; min-width: 260px;" />
    </div>

    <div class="listCardTableWrap">
      <table class="table listCardTable maListTable">
        <thead id="maThead">
          <tr>
            <th class="sortable maTypeCol" data-key="type">Type <span class="sortIndicator" aria-hidden="true"></span></th>
            <th class="sortable" data-key="title">Title <span class="sortIndicator" aria-hidden="true"></span></th>
            <th class="sortable" data-key="createdBy">Created By <span class="sortIndicator" aria-hidden="true"></span></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="maTbody"></tbody>
      </table>
    </div>

    <div id="maListMsg" class="msg"></div>
  </div>
</main>

<style>
  /* Make the calendar icon white on the expire date inputs */
  #maExpireAt::-webkit-calendar-picker-indicator,
  #editExpireAt::-webkit-calendar-picker-indicator {
    filter: invert(1);
  }

  /* Optional: ensure the text is white too, if you're on a dark background */
  #maExpireAt,
  #editExpireAt {
    color: #fff;
  }

    .btn.qrCopy {
    background: #6b7280;   /* neutral gray */
    border-color: #6b7280;
  }
  .btn.qrCopy:hover { filter: brightness(0.95); }
  .btn.qrCopy:disabled { opacity: 0.6; }

  /* Keep Save Image as-is: no class, no overrides */

  .btn.qrEmail {
    background: #7c3aed;   /* accent purple */
    border-color: #7c3aed;
  }
  .btn.qrEmail:hover { filter: brightness(0.95); }
  .btn.qrEmail:disabled { opacity: 0.6; }

  /* Linked mutual aid deployments (shared channel) */
  .ma-unit-master td {
    background: rgba(124, 58, 237, 0.08);
    border-top: 1px solid var(--line);
  }
  .ma-unit-master:first-child td {
    border-top: none;
  }
  .ma-unit-child td {
    background: rgba(255, 255, 255, 0.02);
    border-top: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .ma-unit-child .maTitleCell {
    padding-left: 28px;
  }
  .ma-unit-child-last td {
    border-bottom: 2px solid var(--line);
  }

  .maListTable .maTypeBadge,
  .maListTable .cardMetaBadge {
    display: none;
  }

  .maListTable .maActionsRow {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .maListTable .maActionsRow .btn {
    width: auto;
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
  }

  .row.createMaFields {
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
    width: 100%;
  }
  .createMaField {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .createMaField select,
  .createMaField input {
    width: 100%;
    box-sizing: border-box;
  }
  .createMaField--type {
    flex: 0 1 140px;
  }
  .createMaField--title {
    flex: 1.4 1 200px;
  }
  .createMaField--expire {
    flex: 0 1 120px;
  }
  .createMaField--expireAt {
    flex: 0 1 220px;
  }
  .createMaField--group {
    flex: 1.1 1 200px;
  }
  .createMaField--existing {
    flex: 1.3 1 240px;
  }
  .createMaField--submit {
    flex: 0 0 auto;
    align-self: flex-end;
    justify-content: flex-end;
  }
  .createMaField--submit .btn {
    width: auto;
    white-space: nowrap;
  }

  .btn.maAddUser {
    background: #ea580c;
    border-color: #ea580c;
    color: #fff;
  }
  .btn.maAddUser:hover {
    filter: brightness(0.95);
  }

  #addMaUserOverlay #addMaExpireAt::-webkit-calendar-picker-indicator {
    filter: invert(1);
  }
  #addMaUserOverlay #addMaExpireAt {
    color: #fff;
  }

  /* Modal footer actions: secondary left, primary/success on the far right */
  .maModalActions {
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .maModalActions .msg {
    margin-right: auto;
    flex: 1 1 auto;
    min-width: 0;
  }

  #editLogoWrap .edit-logo-row {
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 0;
  }
  #editLogoWrap .edit-logo-file-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }
  #editLogoWrap #editLogoFile {
    position: absolute;
    width: 0.1px;
    height: 0.1px;
    opacity: 0;
    overflow: hidden;
    z-index: -1;
  }
  #editLogoWrap .edit-logo-current {
    font-size: 13px;
    opacity: 0.85;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

@media (max-width: 900px) {
  .createMaField--type,
  .createMaField--title,
  .createMaField--expire,
  .createMaField--expireAt,
  .createMaField--group,
  .createMaField--existing,
  .createMaField--submit {
    flex: 1 1 100%;
  }
  .createMaField--submit .btn {
    width: 100% !important;
    justify-content: center;
  }
}

/* Mobile: stacked cards, no horizontal scroll (same pattern as Groups) */
@media (max-width: 990px) {
  .listCardTableWrap {
    overflow-x: hidden;
  }

  .listCardTable {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 12px;
  }

  .listCardTable thead {
    display: none;
  }

  .listCardTable tbody tr {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    overflow: hidden;
  }

  .maListTable .maTitleCell.cardTitleCell { order: 1; }
  .maListTable .maCreatedByCell { order: 2; }
  .maListTable .maActionsCell.cardActionsCell { order: 3; }
  .maListTable .maTypeCell,
  .maListTable th.maTypeCol {
    order: 99;
    display: none !important;
  }

  .listCardTable tbody td {
    display: block;
    border-top: none;
    padding: 8px 12px;
    word-break: normal;
    overflow-wrap: normal;
    min-width: 0 !important;
    max-width: none !important;
  }

  .listCardTable .cardTitleCell {
    padding-top: 12px;
    padding-bottom: 4px;
  }

  .listCardTable .cardTitleText {
    white-space: normal;
    overflow: visible;
    text-overflow: unset;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
  }

  .maListTable .maTypeBadge,
  .maListTable .cardMetaBadge {
    display: inline-block;
    margin: 0 0 6px;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }

  .ma-unit-master td {
    background: rgba(124, 58, 237, 0.08);
    border-top: none;
  }
  .ma-unit-child {
    margin-left: 0;
  }
  .ma-unit-child .maTitleCell {
    padding-left: 20px;
    border-left: 3px solid rgba(124, 58, 237, 0.45);
  }
  .ma-unit-child td {
    border-top: none;
    background: transparent;
  }
  .ma-unit-child-last td {
    border-bottom: none;
  }

  .listCardTable .cardActionsCell {
    border-top: 1px solid var(--line);
    padding-top: 10px;
    padding-bottom: 12px;
  }

  .listCardTable .cardActionsRow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    min-width: 0;
  }

  .listCardTable .cardActionsRow .btn {
    width: 100% !important;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    white-space: nowrap;
    word-break: normal !important;
    overflow-wrap: normal !important;
    box-sizing: border-box;
    text-align: center;
  }
}

@media (max-width: 400px) {
  .listCardTable .cardActionsRow {
    grid-template-columns: 1fr;
  }
}

</style>


