<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAK Portal</title>
    <link rel="stylesheet" href="/styles.css" />
    <% const t = brandTokens || {}; %>
    <style>
      :root {
        --font-body: <%= (t.fonts && t.fonts.body) || "IBM Plex Sans, system-ui, -apple-system, Segoe UI, Roboto, sans-serif" %>;
        --font-heading: <%= (t.fonts && t.fonts.heading) || "IBM Plex Sans, system-ui, -apple-system, Segoe UI, Roboto, sans-serif" %>;
        --font-mono: <%= (t.fonts && t.fonts.mono) || "IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace" %>;
      }
      body.theme-dark {
        --bg: <%= (t.dark && t.dark.bg) || "#0b0f18" %>;
        --panel: <%= (t.dark && t.dark.panel) || "#131927" %>;
        --card: <%= (t.dark && t.dark.card) || "#191f2e" %>;
        --text: <%= (t.dark && t.dark.text) || "#dce6f5" %>;
        --muted: <%= (t.dark && t.dark.muted) || "#8494ad" %>;
        --line: <%= (t.dark && t.dark.line) || "#1c2535" %>;
        --btn: <%= (t.dark && t.dark.primary) || "#4488c7" %>;
        --btn-hover: <%= (t.dark && t.dark.primaryHover) || "#56a0df" %>;
      }
      body.theme-light {
        --bg: <%= (t.light && t.light.bg) || "#edf1f7" %>;
        --panel: <%= (t.light && t.light.panel) || "#ffffff" %>;
        --card: <%= (t.light && t.light.card) || "#f4f6fb" %>;
        --text: <%= (t.light && t.light.text) || "#0d1f38" %>;
        --muted: <%= (t.light && t.light.muted) || "#4a5568" %>;
        --line: <%= (t.light && t.light.line) || "#d8e0ec" %>;
        --btn: <%= (t.light && t.light.primary) || "#2f54a5" %>;
        --btn-hover: <%= (t.light && t.light.primaryHover) || "#3d68c2" %>;
      }
    </style>

    <% if (brandLogoUrl) { %>
      <link rel="icon" href="<%= brandLogoUrl %>" type="image/png" />
      <link rel="shortcut icon" href="<%= brandLogoUrl %>" type="image/png" />
    <% } %>
  </head>
  <body class="theme-<%= brandTheme || 'dark' %>">

    <!-- Theme toggle (per-device) -->
    <button
      id="themeToggle"
      class="theme-toggle"
      type="button"
      title="Toggle theme"
      aria-label="Toggle theme"
    >
      <!-- Sun icon (light mode) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        width="1em"
        height="1em"
        fill="currentColor"
        stroke-linecap="round"
        class="theme-toggle__icon theme-toggle__icon--sun"
        viewBox="0 0 32 32"
      >
        <clipPath id="theme-toggle__sun__cutout">
          <path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" />
        </clipPath>
        <g clip-path="url(#theme-toggle__sun__cutout)">
          <circle cx="16" cy="16" r="9.34" />
          <g stroke="currentColor" stroke-width="1.5">
            <path d="M16 5.5v-4" />
            <path d="M16 30.5v-4" />
            <path d="M1.5 16h4" />
            <path d="M26.5 16h4" />
            <path d="m23.4 8.6 2.8-2.8" />
            <path d="m5.7 26.3 2.9-2.9" />
            <path d="m5.8 5.8 2.8 2.8" />
            <path d="m23.4 23.4 2.9 2.9" />
          </g>
        </g>
      </svg>

      <!-- Moon icon (dark mode) -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        width="1em"
        height="1em"
        fill="currentColor"
        viewBox="0 0 24 24"
        class="theme-toggle__icon theme-toggle__icon--moon"
      >
        <path d="M21 12.79A9 9 0 0 1 12.21 3 7 7 0 1 0 21 12.79Z" />
      </svg>
    </button>

		<!-- Mobile menu button (shows under 900px via CSS) -->
		<button
		  class="sidebarToggle"
		  id="sidebarToggle"
		  type="button"
		  aria-controls="sidebar"
		  aria-expanded="false"
>
			☰ Menu
		</button>

		<!-- Overlay shown when sidebar is open on small screens -->
		<div class="sidebarOverlay" id="sidebarOverlay" aria-hidden="true"></div>

		<div class="app">

      <script>
        (function () {
          function isOverlayOpen(el) {
            if (!el) return false;
            const cs = window.getComputedStyle(el);
            if (!cs) return false;
            return cs.display !== "none" && cs.visibility !== "hidden";
          }

          function syncModalOpenClass() {
            const overlays = document.querySelectorAll(".modalOverlay");
            let anyOpen = false;
            overlays.forEach((el) => {
              if (!anyOpen && isOverlayOpen(el)) anyOpen = true;
            });
            document.body.classList.toggle("modal-open", anyOpen);
          }

          function initModalOpenWatcher() {
            syncModalOpenClass();
            const mo = new MutationObserver(syncModalOpenClass);
            mo.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["style", "class"],
              subtree: true,
              childList: true,
            });
            window.addEventListener("resize", syncModalOpenClass);
          }

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initModalOpenWatcher);
          } else {
            initModalOpenWatcher();
          }
        })();
      </script>

			<script src="/sidebar.js" defer=""></script>
      <script src="/theme-toggle.js" defer></script>
		