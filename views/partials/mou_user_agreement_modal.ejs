<% if (agreementSummary && agreementSummary.shouldRequire && agreementSummary.agreement) { %>
  <div class="modalOverlay" id="userAgreementOverlay">
    <div class="modal userAgreementModal" role="dialog" aria-modal="true" aria-labelledby="userAgreementTitle">
      <div class="modalHeader">
        <h2 id="userAgreementTitle" style="margin:0;"><%= agreementSummary.agreement.title || "End-User Agreement" %></h2>
      </div>
      <div class="modalBody">
        <div class="mouDocumentShell">
          <%- agreementSummary.agreement.bodyHtml %>
        </div>
        <div class="row" style="margin-top:16px;gap:10px;flex-wrap:wrap;justify-content:flex-end;">
          <button class="btn danger" type="button" id="userAgreementDeclineBtn">Decline</button>
          <button class="btn success" type="button" id="userAgreementAcceptBtn">Agree</button>
        </div>
        <div class="msg" id="userAgreementMsg" style="margin-top:12px;"></div>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var acceptBtn = document.getElementById("userAgreementAcceptBtn");
    var declineBtn = document.getElementById("userAgreementDeclineBtn");
    var msg = document.getElementById("userAgreementMsg");
    var postAcceptUrl = <%- JSON.stringify(
      (typeof isAgencyAdmin !== "undefined" && isAgencyAdmin) ||
      (typeof isGlobalAdmin !== "undefined" && isGlobalAdmin)
        ? "/dashboard"
        : "/setup-my-device"
    ) %>;
    if (!acceptBtn || !declineBtn || !msg) return;

    function setBusy(isBusy, text, ok) {
      acceptBtn.disabled = isBusy;
      declineBtn.disabled = isBusy;
      msg.className = "msg " + (ok === false ? "bad" : ok === true ? "ok" : "pending");
      msg.textContent = text || "";
    }

    acceptBtn.addEventListener("click", async function () {
      try {
        setBusy(true, "Continuing...", null);
        var res = await fetch("/api/mou/user-agreement/accept", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: "{}"
        });
        var out = await res.json();
        if (!res.ok) throw new Error(out.error || "Failed to continue.");
        setBusy(true, "Continuing...", true);
        window.location.href = postAcceptUrl;
      } catch (err) {
        setBusy(false, err && err.message ? err.message : "Failed to continue.", false);
      }
    });

    declineBtn.addEventListener("click", async function () {
      try {
        setBusy(true, "Logging out...", null);
        var res = await fetch("/api/mou/user-agreement/decline", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: "{}"
        });
        var out = await res.json();
        if (!res.ok) throw new Error(out.error || "Failed to log out.");
        window.location.href = out.logoutUrl || "/logout";
      } catch (err) {
        setBusy(false, err && err.message ? err.message : "Failed to log out.", false);
      }
    });
  })();
  </script>
<% } %>
