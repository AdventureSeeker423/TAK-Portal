      const installed = findInstalledMatch(p);
      const needsUpdate = !!(installed && isRemoteNewer(installed, p));
      let actionBtn = "";
      if (needsUpdate) {
        actionBtn = "<button class=\"btn success\" type=\"button\" data-takwerx-download data-takwerx-index=\"" + idx + "\">Update To Latest</button>";
