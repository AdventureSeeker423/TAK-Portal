          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ plugin: pluginItem }),
        })
          .then(function (res) {
            return res.text().then(function (text) {
              var data = {};
              try { data = text ? JSON.parse(text) : {}; } catch (_) {}
              return { res: res, data: data, text: text };
            });
          })
          .then(function (_ref) {
            const res = _ref.res;
            const data = _ref.data;
            const text = _ref.text;
            const errMsg = (data && data.error) || (typeof text === "string" && text.slice(0, 200)) || "Download failed";
            if (!res.ok) {
              setTakwerxMsg(errMsg, false);
              btn.textContent = isUpdate ? "Update To Latest" : "Add To Server";
              btn.disabled = false;
              return;
            }
            setTakwerxMsg(isUpdate ? "Plugin updated on server." : "Plugin added/updated on server.", true);
            loadState();
          })
          .catch(function (err) {
            btn.textContent = isUpdate ? "Update To Latest" : "Add To Server";
            btn.disabled = false;
            setTakwerxMsg(err.message || "Failed to add plugin", false);
          });
      });
    });
  }

  async function loadTakwerxPlugins() {
    const version = (takwerxVersion && takwerxVersion.value || "").trim();
    setTakwerxMsg("Loading…", true);
    try {
      const qs = version ? ("?product_version=" + encodeURIComponent(version)) : "";
      const res = await fetch("/api/plugins/takwerx/plugins" + qs);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to load TAKwerx plugins");
      const versions = Array.isArray(data.versions) ? data.versions.filter(Boolean) : [];
      if (takwerxVersion) {
        const previous = (takwerxVersion.value || "").trim();
        if (versions.length === 0) {
          takwerxVersion.innerHTML = "<option value=\"\">No versions available</option>";
          takwerxVersion.value = "";
        } else {
          takwerxVersion.innerHTML = versions.map(function (v) {
            return "<option value=\"" + esc(v) + "\">" + esc(v) + "</option>";
          }).join("");
          const selected = versions.includes(previous) ? previous : versions[0];
          takwerxVersion.value = selected;
          takwerxVersionsLoaded = true;
          // Refetch only if we asked for a concrete version that isn't what's selected now.
          if (version && selected !== version) {
            return loadTakwerxPlugins();
          }
        }
      }
      // Only show plugins that have a downloadable APK for the selected ATAK version.
      takwerxPluginsCache = (data.plugins || []).filter(function (p) {
        return p && p.apk_url;
      });
      takwerxSearchText = "";
      if (takwerxSearch) takwerxSearch.value = "";
      setTakwerxMsg(takwerxPluginsCache.length ? "" : "No plugins found for this ATAK version.", true);
      renderTakwerxMarketplace(getTakwerxDisplayList());
    } catch (err) {
      setTakwerxMsg(err.message || "Failed to load", false);
      takwerxPluginsCache = [];
      takwerxSearchText = "";
      if (takwerxSearch) takwerxSearch.value = "";
      renderTakwerxMarketplace([]);
    }
  }

  if (takwerxVersion) {
    takwerxVersion.addEventListener("change", function () { loadTakwerxPlugins(); });
  }
  if (takwerxSearch) {
    takwerxSearch.addEventListener("input", function () {
      takwerxSearchText = takwerxSearch.value || "";
      renderTakwerxMarketplace(getTakwerxDisplayList());
    });
  }

  getLinkCodeBtn.addEventListener("click", async function () {
    setLinkStatus("Requesting code from TAK.gov…", true);
    try {
      const res = await fetch("/api/plugins/link-code", { method: "POST", headers: { "Content-Type": "application/json" } });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to get code");
      linkCodeArea.style.display = "block";
      linkCodeDisplay.textContent = data.linkCode || "";
      const openUrl = data.verificationUriComplete || data.verificationUri || "https://tak.gov/register-device";
      if (verificationUriLink) verificationUriLink.href = openUrl;
      window.open(openUrl, "_blank", "noopener,noreferrer");
      setLinkStatus(data.message || "Enter the code on TAK.gov if needed, then click Step 2: Link account.", true);
      if (data.linkCodeExpiry) {
        const interval = setInterval(function () {
          const sec = Math.max(0, Math.floor((data.linkCodeExpiry - Date.now()) / 1000));
          linkCodeExpiry.textContent = "Expires in " + sec + "s";
          if (sec <= 0) clearInterval(interval);
        }, 1000);
      }
    } catch (err) {
      setLinkStatus(err.message || "Error", false);
    }
  });

  linkAccountBtn.addEventListener("click", async function () {
    setLinkStatus("Linking…", true);
    try {
      const res = await fetch("/api/plugins/link", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({}),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Link failed");
      setLinkStatus(data.message || "Linked.", true);
      loadState();
    } catch (err) {
      setLinkStatus(err.message || "Error", false);
    }
  });

  if (unlinkBtn) {
    unlinkBtn.addEventListener("click", async function () {
      if (!confirm("Unlink your TAK.gov account? Downloaded plugins will remain stored.")) return;
      try {
        const res = await fetch("/api/plugins/unlink", { method: "POST", headers: { "Content-Type": "application/json" } });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Unlink failed");
        loadState();
      } catch (err) {
        setMarketplaceMsg(err.message || "Unlink failed", false);
      }
    });
  }

  uploadPluginBtn.addEventListener("click", function () {
    const file = pluginFile && pluginFile.files && pluginFile.files[0];
    if (!file) {
      setAddPluginMsg("Select a plugin file first.", false);
      return;
    }
    setAddPluginMsg("Uploading…", true);
    const form = new FormData();
    form.append("plugin", file);
    const name = (uploadName && uploadName.value || "").trim();
    if (name) form.append("name", name);
    fetch("/api/plugins/upload", { method: "POST", body: form })
      .then(function (res) { return res.json().then(function (data) { return { res, data }; }); })
      .then(function (_ref) {
        const res = _ref.res;
        const data = _ref.data;
        if (!res.ok) throw new Error(data.error || "Upload failed");
        setAddPluginMsg("Plugin uploaded: " + (data.plugin && data.plugin.name) + ".", true);
        pluginFile.value = "";
        if (uploadName) uploadName.value = "";
        loadState();
      })
      .catch(function (err) {
        setAddPluginMsg(err.message || "Upload failed", false);
      });
  });

  downloadPluginBtn.addEventListener("click", function () {
    const url = (pluginUrl && pluginUrl.value || "").trim();
    if (!url) {
      setAddPluginMsg("Enter a plugin URL.", false);
      return;
    }
    setAddPluginMsg("Downloading…", true);
    const body = { url: url };
    const name = (downloadName && downloadName.value || "").trim();
    if (name) body.name = name;
    fetch("/api/plugins/download", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    })
      .then(function (res) { return res.json().then(function (data) { return { res, data }; }); })
      .then(function (_ref) {
        const res = _ref.res;
        const data = _ref.data;
        if (!res.ok) throw new Error(data.error || "Download failed");
        setAddPluginMsg("Plugin downloaded: " + (data.plugin && data.plugin.name) + ".", true);
        if (pluginUrl) pluginUrl.value = "";
        if (downloadName) downloadName.value = "";
        loadState();
      })
      .catch(function (err) {
        setAddPluginMsg(err.message || "Download failed", false);
      });
  });

  async function deletePlugin(id) {
    setPluginsMsg("Deleting…", true);
    try {
      const res = await fetch("/api/plugins/" + encodeURIComponent(id), { method: "DELETE" });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Delete failed");
      setPluginsMsg("Plugin removed.", true);
      loadState();
    } catch (err) {
      setPluginsMsg(err.message || "Delete failed", false);
    }
  }

  // Initial state from server-rendered data (optional; we refetch for consistency)
  const initialPlugins = typeof plugins !== "undefined" && Array.isArray(plugins) ? plugins : [];
  const initialLink = typeof takGovLink !== "undefined" && takGovLink ? takGovLink : { linked: false };
  if (initialLink.linked) {
    if (takGovLinkCard) takGovLinkCard.style.display = "none";
    if (unlinkBtn) unlinkBtn.style.display = "";
    if (marketplaceIntro) marketplaceIntro.style.display = "none";
    if (marketplaceBrowse) marketplaceBrowse.style.display = "block";
  } else {
    if (takGovLinkCard) takGovLinkCard.style.display = "";
    if (unlinkBtn) unlinkBtn.style.display = "none";
    if (marketplaceIntro) marketplaceIntro.style.display = "block";
    if (marketplaceBrowse) marketplaceBrowse.style.display = "none";
  }
  downloadedPluginsCache = initialPlugins;
  renderPluginCards(initialPlugins);
  loadState();

  // --- TAK Server OTA auto-sync status ---
  const syncStatusEl = document.getElementById("takServerSyncStatus");
  const syncLabelEl = document.getElementById("takServerSyncLabel");
  let syncPollTimer = null;

  function applySyncStatus(sync) {
    if (!syncStatusEl || !syncLabelEl) return;
    syncStatusEl.classList.remove("is-error", "is-success", "is-blocked", "is-syncing");
    const state = (sync && sync.state) || "idle";
    const portalCount = sync && sync.portalCount != null ? sync.portalCount : null;
    const syncedCount = sync && sync.syncedCount != null ? sync.syncedCount : null;
    let label = "";
    if (state === "pending" || state === "syncing" || (sync && sync.inProgress)) {
      label = portalCount != null ? (portalCount + "/" + portalCount + " syncing…") : "Syncing…";
      syncStatusEl.classList.add("is-syncing");
    } else if (state === "success") {
      label =
        portalCount != null && syncedCount != null
          ? syncedCount + "/" + portalCount + " on TAK Server"
          : syncedCount != null
            ? syncedCount + " on TAK Server"
            : "Synced";
      syncStatusEl.classList.add("is-success");
    } else if (state === "blocked_ssh") {
      label = "SSH required for TAK Server sync";
      syncStatusEl.classList.add("is-blocked");
    } else if (state === "error") {
      label = "Sync failed";
      syncStatusEl.classList.add("is-error");
    } else if (portalCount != null) {
      label = (syncedCount != null ? syncedCount : 0) + "/" + portalCount + " on TAK Server";
    }
    syncLabelEl.textContent = label;
    syncLabelEl.className = "";
  }

  function refreshSyncStatus() {
    return fetch("/api/plugins/sync-status")
      .then(function (res) { return res.json(); })
      .then(function (data) {
        const sync = data && data.sync ? data.sync : null;
        applySyncStatus(sync);
        const busy = !!(sync && (sync.inProgress || sync.state === "syncing" || sync.state === "pending"));
        if (busy) {
          if (!syncPollTimer) {
            syncPollTimer = setInterval(refreshSyncStatus, 2000);
          }
        } else if (syncPollTimer) {
          clearInterval(syncPollTimer);
          syncPollTimer = null;
        }
      })
      .catch(function () {
        applySyncStatus({ state: "error" });
      });
  }

  refreshSyncStatus();
})();
