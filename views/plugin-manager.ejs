        const pluginItem = list[idx];
        if (!pluginItem || !pluginItem.apk_url) return;
        const isUpdate = btn.textContent === "Update To Latest";
        btn.disabled = true;
        btn.textContent = isUpdate ? "Updating…" : "Adding…";
        setTakwerxMsg("", true);
        fetch("/api/plugins/takwerx/download", {
