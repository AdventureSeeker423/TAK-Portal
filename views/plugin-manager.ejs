<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>Plugin Manager</h1>

  <!-- Link TAK.gov Account (OAuth 2.0 device flow – same as OpenTAKServer). Hidden entirely when linked. -->
  <div class="card" id="takGovLinkCard">
    <h2>Link TAK.gov Account</h2>
    <div id="linkSetupBlock">
      <div class="grid2">
        <button class="btn tile" type="button" id="getLinkCodeBtn">
          <span class="title">Step 1: Get link code and open TAK.gov</span>
          <span class="desc">Request a code from TAK.gov and open the page in a new tab.</span>
        </button>
        <button class="btn tile" type="button" id="linkAccountBtn">
          <span class="title">Step 2: Link account</span>
          <span class="desc">After entering the code and authorizing on TAK.gov, click here to complete linking.</span>
        </button>
      </div>
      <div id="linkCodeArea" style="display: none; margin-top: 16px; padding: 12px; background: var(--card); border-radius: 8px; border: 1px solid var(--line);">
        <div class="row" style="align-items: center; gap: 8px; flex-wrap: wrap;">
          <code id="linkCodeDisplay" style="font-size: 1.4rem; padding: 10px 14px; background: var(--bg); border-radius: 6px; letter-spacing: 0.05em;"></code>
          <span id="linkCodeExpiry" class="muted"></span>
        </div>
      </div>
      <a id="verificationUriLink" href="https://tak.gov/register-device" target="_blank" rel="noopener noreferrer" style="display: none;" aria-hidden="true"></a>
    </div>
    <div id="linkStatus" class="msg"></div>
  </div>

  <!-- Downloaded plugins: cards (above Plugin Browser) -->
  <div class="card">
    <h2 style="margin-top: 0;">Downloaded Plugins</h2>
    <div id="takServerSyncStatus" class="plugin-sync-status" aria-live="polite">
      <span id="takServerSyncLabel" class="muted">Checking…</span>
    </div>
    <div class="row" style="flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 12px;">
      <label>Filter by ATAK version
        <select id="downloadedVersionFilter" style="min-width: 160px;">
          <option value="" selected>All versions</option>
        </select>
      </label>
    </div>
    <div id="pluginsMsg" class="msg"></div>
    <div id="pluginsLoading" class="muted" style="margin-top: 16px;">Loading Plugins...</div>
    <div id="pluginCards" class="plugin-cards" style="display: none; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
      <!-- Filled by JS -->
    </div>
    <div id="pluginsEmpty" style="display: none; margin-top: 16px; color: var(--muted);">
      No plugins yet. Add plugins from TAKwerx Plugins or the Plugin Browser below, or use Manual Plugin Upload at the bottom.
    </div>
  </div>

  <!-- TAKwerx Plugins (public GitHub Releases; no TAK.gov link required) -->
  <div class="card" id="takwerxCard">
    <h2 style="margin-top: 0;">TAKwerx Plugins</h2>
    <div class="row" style="flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 12px;">
      <label>ATAK version
        <select id="takwerxVersion" style="min-width: 120px;">
          <option value="" selected>Loading…</option>
        </select>
      </label>
      <label style="flex: 1; min-width: 200px;">Search
        <input type="text" id="takwerxSearch" placeholder="Search plugins…" style="width: 100%;" />
      </label>
    </div>
    <div id="takwerxMsg" class="msg" style="margin-top: 8px;"></div>
    <div id="takwerxGrid" class="plugin-cards marketplace-grid" style="display: none; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
      <!-- TAKwerx plugin cards -->
    </div>
    <div id="takwerxEmpty" style="display: none; margin-top: 16px; color: var(--muted);">
      No TAKwerx plugins available for this ATAK version.
    </div>
  </div>

  <!-- TAK.gov Plugin Browser (browse UI visible when linked) -->
  <div class="card" id="marketplaceCard">
    <div class="plugin-browser-header" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 0;">
      <h2 style="margin: 0;">TAK Plugin Browser</h2>
      <button class="btn" type="button" id="unlinkBtnBadge" style="display: none; margin-left: auto;">Unlink Account</button>
    </div>
    <div id="marketplaceBrowse" style="display: none;">
      <div class="row" style="flex-wrap: wrap; gap: 12px; align-items: flex-end; margin-top: 12px;">
        <label>ATAK version
          <select id="takgovVersion" style="min-width: 120px;">
            <option value="5.7.0" selected>5.7.0</option>
          </select>
        </label>
        <label style="flex: 1; min-width: 200px;">Search
          <input type="text" id="takgovSearch" placeholder="Search plugins…" style="width: 100%;" />
        </label>
      </div>
      <div id="marketplaceMsg" class="msg" style="margin-top: 8px;"></div>
      <div id="marketplaceGrid" class="plugin-cards marketplace-grid" style="display: none; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
        <!-- TAK.gov plugin cards -->
      </div>
      <div id="marketplaceEmpty" style="display: none; margin-top: 16px; color: var(--muted);">
        No plugins returned. Try a different ATAK version.
      </div>
    </div>
  </div>

  <!-- Manual Plugin Upload (collapsed) -->
  <details class="card settings-section" style="margin-top: 24px;">
    <summary class="settings-summary" style="cursor: pointer; padding: 4px 0;">Manual Plugin Upload</summary>
    <div class="settings-body" style="margin-top: 12px;">
      <p class="muted" style="margin-top: 4px;">Upload an APK from your computer or download from a URL (e.g. after linking TAK.gov you can use plugin URLs from TAK.gov).</p>
      <div class="row" style="flex-wrap: wrap; gap: 16px;">
        <div style="flex: 1; min-width: 280px;">
          <label>Upload plugin file (APK)
            <input type="file" id="pluginFile" accept=".apk,.zip,.jar" />
          </label>
          <label style="margin-top: 8px;">Display name (optional)
            <input type="text" id="uploadName" placeholder="e.g. Mission Package Tools" style="width: 100%;" />
          </label>
          <button class="btn" type="button" id="uploadPluginBtn" style="margin-top: 8px;">Upload Plugin</button>
        </div>
        <div style="flex: 1; min-width: 280px;">
          <label>Or download from URL
            <input type="url" id="pluginUrl" placeholder="https://..." style="width: 100%;" />
          </label>
          <label style="margin-top: 8px;">Display name (optional)
            <input type="text" id="downloadName" placeholder="e.g. Mission Package Tools" style="width: 100%;" />
          </label>
          <button class="btn" type="button" id="downloadPluginBtn" style="margin-top: 8px;">Download Plugin</button>
        </div>
      </div>
      <div id="addPluginMsg" class="msg"></div>
    </div>
  </details>
</main>

<style>
  .plugin-cards .plugin-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }
  .plugin-cards .plugin-card .plugin-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .plugin-cards .plugin-card .plugin-name { font-weight: 600; flex: 1; min-width: 0; }
  .plugin-cards .plugin-card .plugin-version-pill {
    flex-shrink: 0;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--line);
    color: var(--muted);
  }
  .plugin-cards .plugin-card .plugin-desc { font-size: 0.85rem; color: var(--muted); max-height: 2.6em; overflow: hidden; text-overflow: ellipsis; }
  .plugin-cards .plugin-card .plugin-desc-empty { font-style: italic; }
  .plugin-cards .plugin-card .plugin-meta { font-size: 0.9rem; color: var(--muted); }
  .plugin-cards .plugin-card .plugin-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; align-items: center; }
  .btn.favorite { background: #e6c200; color: #000; border-color: #e6c200; }
  .btn.favorite:hover { filter: brightness(1.08); }
  .btn.favorite.is-favorite { background: #f0d000; color: #000; }
  .marketplace-grid .plugin-card .plugin-desc { font-size: 0.85rem; color: var(--muted); max-height: 2.6em; overflow: hidden; text-overflow: ellipsis; }
  .plugin-sync-status {
    margin: 4px 0 0;
    padding: 0;
    border: none;
    background: transparent;
    font-size: 0.9rem;
  }
  .plugin-sync-status.is-error #takServerSyncLabel { color: #c44; }
  .plugin-sync-status.is-success #takServerSyncLabel { color: #2a7; }
  .plugin-sync-status.is-blocked #takServerSyncLabel { color: #c80; }
  .plugin-sync-status.is-syncing #takServerSyncLabel { color: var(--muted); }

  @media (max-width: 990px) {
    .plugin-cards {
      grid-template-columns: minmax(0, 1fr) !important;
    }
    .plugin-cards .plugin-card .plugin-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .plugin-cards .plugin-card .plugin-actions .btn {
      width: 100%;
      margin: 0;
      box-sizing: border-box;
      text-align: center;
    }
    .main .row {
      flex-direction: column;
      align-items: stretch !important;
    }
    .main .row > label,
    .main .row > div {
      flex: 1 1 100% !important;
      min-width: 0 !important;
      width: 100%;
    }
    .main select,
    .main input[type="text"],
    .main input[type="search"] {
      width: 100%;
      min-width: 0 !important;
      max-width: 100%;
      box-sizing: border-box;
    }
  }
</style>

<script>
(function () {
  const getLinkCodeBtn = document.getElementById("getLinkCodeBtn");
  const linkAccountBtn = document.getElementById("linkAccountBtn");
  const unlinkBtn = document.getElementById("unlinkBtnBadge");
  const linkCodeDisplay = document.getElementById("linkCodeDisplay");
  const linkCodeExpiry = document.getElementById("linkCodeExpiry");
  const linkCodeArea = document.getElementById("linkCodeArea");
  const verificationUriLink = document.getElementById("verificationUriLink");
  const linkStatus = document.getElementById("linkStatus");
  const takGovLinkCard = document.getElementById("takGovLinkCard");
  const pluginFile = document.getElementById("pluginFile");
  const uploadName = document.getElementById("uploadName");
  const uploadPluginBtn = document.getElementById("uploadPluginBtn");
  const pluginUrl = document.getElementById("pluginUrl");
  const downloadName = document.getElementById("downloadName");
  const downloadPluginBtn = document.getElementById("downloadPluginBtn");
  const addPluginMsg = document.getElementById("addPluginMsg");
  const pluginsLoading = document.getElementById("pluginsLoading");
  const pluginCards = document.getElementById("pluginCards");
  const pluginsEmpty = document.getElementById("pluginsEmpty");
  const pluginsMsg = document.getElementById("pluginsMsg");
  const downloadedVersionFilter = document.getElementById("downloadedVersionFilter");
  const marketplaceIntro = document.getElementById("marketplaceIntro");
  const marketplaceBrowse = document.getElementById("marketplaceBrowse");
  const takgovVersion = document.getElementById("takgovVersion");
  const takgovSearch = document.getElementById("takgovSearch");
  const marketplaceMsg = document.getElementById("marketplaceMsg");
  const marketplaceGrid = document.getElementById("marketplaceGrid");
  const marketplaceEmpty = document.getElementById("marketplaceEmpty");
  const takwerxVersion = document.getElementById("takwerxVersion");
  const takwerxSearch = document.getElementById("takwerxSearch");
  const takwerxMsg = document.getElementById("takwerxMsg");
  const takwerxGrid = document.getElementById("takwerxGrid");
  const takwerxEmpty = document.getElementById("takwerxEmpty");

  let takgovPluginsCache = [];
  let takgovSearchText = "";
  let downloadedPluginsCache = [];
  let updateStatusCache = {};
  let downloadedVersionFilterValue = "";
  let takgovVersionsLoaded = false;
  let takwerxPluginsCache = [];
  let takwerxSearchText = "";
  let takwerxVersionsLoaded = false;

  function esc(s) {
    if (s == null || s === undefined) return "";
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function setLinkStatus(text, ok) {
    linkStatus.textContent = text || "";
    linkStatus.style.color = ok === false ? "var(--danger)" : "";
  }

  function setAddPluginMsg(text, ok) {
    addPluginMsg.textContent = text || "";
    addPluginMsg.style.color = ok === false ? "var(--danger)" : "";
  }

  function setPluginsMsg(text, ok) {
    pluginsMsg.textContent = text || "";
    pluginsMsg.style.color = ok === false ? "var(--danger)" : "";
  }

  function formatSize(bytes) {
    if (bytes == null) return "—";
    if (bytes < 1024) return bytes + " B";
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
    return (bytes / (1024 * 1024)).toFixed(2) + " MB";
  }

  function formatDate(iso) {
    if (!iso) return "—";
    try {
      const d = new Date(iso);
      return isNaN(d.getTime()) ? iso : d.toLocaleDateString() + " " + d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
    } catch (_) { return iso; }
  }

  function getAtakVersionValue(p) {
    if (!p) return "";
    const direct = p.atakVersion || p.atak_version || "";
    const directValue = String(direct || "").trim();
    if (directValue) return directValue;
    const versionText = typeof p.version === "string" ? p.version : "";
    const bracket = versionText.match(/\[(\d+\.\d+(?:\.\d+)?)\]/);
    return bracket && bracket[1] ? bracket[1] : "";
  }

  function getAtakVersionKey(p) {
    const s = getAtakVersionValue(p);
    const m = s.match(/^(\d+)\.(\d+)/);
    return m ? (m[1] + "." + m[2]) : s;
  }

  function refreshDownloadedVersionFilterOptions(plugins) {
    if (!downloadedVersionFilter) return;
    const current = downloadedVersionFilterValue || "";
    const versions = Array.from(new Set(
      (Array.isArray(plugins) ? plugins : [])
        .map(function (p) { return getAtakVersionKey(p); })
        .filter(Boolean)
    )).sort(function (a, b) {
      const ap = a.split(".").map(function (n) { return parseInt(n, 10) || 0; });
      const bp = b.split(".").map(function (n) { return parseInt(n, 10) || 0; });
      if ((bp[0] || 0) !== (ap[0] || 0)) return (bp[0] || 0) - (ap[0] || 0);
      return (bp[1] || 0) - (ap[1] || 0);
    });
    const allowed = new Set([""]);
    versions.forEach(function (v) { allowed.add(v); });
    downloadedVersionFilterValue = allowed.has(current) ? current : "";
    downloadedVersionFilter.innerHTML =
      "<option value=\"\">All versions</option>" +
      versions.map(function (v) {
        return "<option value=\"" + esc(v) + "\"" + (downloadedVersionFilterValue === v ? " selected" : "") + ">" + esc(v) + ".x</option>";
      }).join("");
  }

  function renderPluginCards(plugins) {
    if (pluginsLoading) pluginsLoading.style.display = "none";
    refreshDownloadedVersionFilterOptions(plugins);
    const filtered = (Array.isArray(plugins) ? plugins : []).filter(function (p) {
      if (!downloadedVersionFilterValue) return true;
      return getAtakVersionKey(p) === downloadedVersionFilterValue;
    });
    const list = filtered.slice().sort(function (a, b) {
      const na = (a.name || a.filename || a.id || "").toLowerCase();
      const nb = (b.name || b.filename || b.id || "").toLowerCase();
      return na.localeCompare(nb);
    });
    if (list.length === 0) {
      pluginCards.innerHTML = "";
      pluginCards.style.display = "none";
      if (pluginsEmpty) pluginsEmpty.style.display = "block";
      return;
    }
    if (pluginsEmpty) pluginsEmpty.style.display = "none";
    pluginCards.style.display = "grid";
    pluginCards.innerHTML = list.map(function (p) {
      const name = esc(p.name || p.filename || p.id);
      const desc = (p.description || "").trim();
      const descShort = desc.slice(0, 120);
      const exists = p.exists !== false;
      const downloadUrl = "/api/plugins/" + esc(p.id) + "/download";
      const isFavorite = p.favorite === true;
      const updateAvailable = !!p.package_name && updateStatusCache[p.id] === true;
      const versionPill = p.version ? "<span class=\"plugin-version-pill\">v" + esc(p.version) + "</span>" : "";
      return "<div class=\"plugin-card\" data-id=\"" + esc(p.id) + "\">" +
        "<div class=\"plugin-card-header\">" +
        "<div class=\"plugin-name\">" + name + "</div>" +
        (versionPill || "") +
        "</div>" +
        (desc ? "<div class=\"plugin-desc\">" + esc(descShort) + (desc.length > 120 ? "…" : "") + "</div>" : "<div class=\"plugin-desc plugin-desc-empty\">No description</div>") +
        (exists ? "" : "<div class=\"plugin-meta\" style=\"color: var(--danger);\">File missing on disk</div>") +
        "<div class=\"plugin-actions\">" +
        "<button class=\"btn favorite " + (isFavorite ? "is-favorite" : "") + "\" type=\"button\" data-favorite=\"" + esc(p.id) + "\" title=\"" + (isFavorite ? "Unfavorite" : "Favorite") + "\">" + (isFavorite ? "★ Unfavorite" : "☆ Favorite") + "</button>" +
        "<button class=\"btn\" type=\"button\" data-edit-desc=\"" + esc(p.id) + "\" title=\"Edit description\">Edit description</button>" +
        (exists ? "<a href=\"" + downloadUrl + "\" class=\"btn\" download>Download</a>" : "") +
        (updateAvailable ? "<button class=\"btn success\" type=\"button\" data-update=\"" + esc(p.id) + "\">Update To Latest</button>" : "") +
        "<button class=\"btn danger\" type=\"button\" data-delete=\"" + esc(p.id) + "\">Delete</button>" +
        "</div></div>";
    }).join("");
    pluginCards.querySelectorAll("[data-delete]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const id = btn.getAttribute("data-delete");
        if (!id) return;
        if (!confirm("Remove this plugin and delete its file from the server? This cannot be undone.")) return;
        deletePlugin(id);
      });
    });
    pluginCards.querySelectorAll("[data-favorite]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const id = btn.getAttribute("data-favorite");
        if (!id) return;
        const isFavorite = btn.classList.contains("is-favorite");
        toggleFavorite(id, !isFavorite, btn);
      });
    });
    pluginCards.querySelectorAll("[data-update]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const id = btn.getAttribute("data-update");
        if (!id) return;
        updateInstalledPlugin(id, btn);
      });
    });
    pluginCards.querySelectorAll("[data-edit-desc]").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const id = btn.getAttribute("data-edit-desc");
        if (!id) return;
        const p = list.find(function (x) { return x.id === id; });
        const current = (p && p.description) ? String(p.description) : "";
        const value = window.prompt("Edit plugin description:", current);
        if (value === null) return;
        try {
          const res = await fetch("/api/plugins/" + encodeURIComponent(id), {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ description: value.trim() }),
          });
          const data = await res.json();
          if (!res.ok) {
            setPluginsMsg(data.error || "Failed to update description", false);
            return;
          }
          setPluginsMsg("Description updated.", true);
          await loadState();
          window.setTimeout(function () { setPluginsMsg("", true); }, 10000);
        } catch (err) {
          setPluginsMsg(err.message || "Failed to update description", false);
        }
      });
    });
  }

  function toggleFavorite(id, favorite, btnEl) {
    fetch("/api/plugins/" + encodeURIComponent(id), {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ favorite: favorite }),
    })
      .then(function (res) { return res.json().then(function (data) { return { res, data }; }); })
      .then(function (_ref) {
        const res = _ref.res;
        const data = _ref.data;
        if (!res.ok) {
          setPluginsMsg(data.error || "Failed to update favorite", false);
          return;
        }
        if (btnEl) {
          btnEl.classList.toggle("is-favorite", favorite);
          btnEl.textContent = favorite ? "★ Unfavorite" : "☆ Favorite";
          btnEl.title = favorite ? "Unfavorite" : "Favorite";
        }
        loadState();
      })
      .catch(function (err) {
        setPluginsMsg(err.message || "Failed to update favorite", false);
      });
  }

  function versionCore(v) {
    const s = String(v || "").trim().replace(/^v/i, "");
    const m = s.match(/^(\d+(?:\.\d+)*)/);
    return m ? m[1] : s;
  }

  function isRemoteNewer(installed, remote) {
    const cv = versionCore(installed && installed.version);
    const rv = versionCore(remote && remote.version);
    if (!rv) return false;
    if (!cv) return true;
    const cParts = cv.split(".").map(function (n) { return parseInt(n, 10) || 0; });
    const rParts = rv.split(".").map(function (n) { return parseInt(n, 10) || 0; });
    for (let i = 0; i < Math.max(cParts.length, rParts.length); i++) {
      const c = cParts[i] || 0;
      const r = rParts[i] || 0;
      if (r > c) return true;
      if (r < c) return false;
    }
    const cr = installed && installed.revision_code != null ? installed.revision_code : 0;
    const rr = remote && remote.revision_code != null ? remote.revision_code : 0;
    return rr > cr;
  }

  function findInstalledMatch(remotePlugin) {
    const pkg = remotePlugin && remotePlugin.package_name;
    if (!pkg) return null;
    const pVer = (remotePlugin.atakVersion || remotePlugin.atak_version || "").toString();
    const pKeyMatch = pVer.match(/^(\d+)\.(\d+)/);
    const pKey = pKeyMatch ? pKeyMatch[1] + "." + pKeyMatch[2] : "";
    return (downloadedPluginsCache || []).find(function (d) {
      if (d.package_name !== pkg) return false;
      if (!pKey) return true;
      const dVer = (d.atakVersion || d.atak_version || "").toString();
      const dKeyMatch = dVer.match(/^(\d+)\.(\d+)/);
      if (!dKeyMatch) return !dVer;
      return dKeyMatch[1] + "." + dKeyMatch[2] === pKey;
    }) || null;
  }

  function updateInstalledPlugin(id, btnEl) {
    if (btnEl) { btnEl.disabled = true; btnEl.textContent = "Updating…"; }
    setPluginsMsg("", true);
    fetch("/api/plugins/" + encodeURIComponent(id) + "/update", { method: "POST" })
      .then(function (res) {
        return res.text().then(function (text) {
          var data = {};
          try { data = text ? JSON.parse(text) : {}; } catch (_) {}
          return { res: res, data: data };
        });
      })
      .then(function (_ref) {
        const res = _ref.res;
        const data = _ref.data;
        if (!res.ok) {
          setPluginsMsg((data && data.error) || "Update failed", false);
          if (btnEl) { btnEl.disabled = false; btnEl.textContent = "Update To Latest"; }
          return;
        }
        setPluginsMsg("Plugin updated to latest.", true);
        loadState();
      })
      .catch(function (err) {
        setPluginsMsg(err.message || "Update failed", false);
        if (btnEl) { btnEl.disabled = false; btnEl.textContent = "Update To Latest"; }
      });
  }

  async function loadState() {
    try {
      const res = await fetch("/api/plugins/state");
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to load state");
      const link = data.takGovLink || {};
      const plugins = data.plugins || [];
      if (link.linked) {
        if (takGovLinkCard) takGovLinkCard.style.display = "none";
        if (unlinkBtn) unlinkBtn.style.display = "";
        linkCodeArea.style.display = "none";
        setLinkStatus("", true);
        if (marketplaceIntro) marketplaceIntro.style.display = "none";
        if (marketplaceBrowse) marketplaceBrowse.style.display = "block";
      } else {
        if (takGovLinkCard) takGovLinkCard.style.display = "";
        if (unlinkBtn) unlinkBtn.style.display = "none";
        const linkSetup = document.getElementById("linkSetupBlock");
        if (linkSetup) linkSetup.style.display = "";
        if (marketplaceIntro) marketplaceIntro.style.display = "block";
        if (marketplaceBrowse) marketplaceBrowse.style.display = "none";
        if (link.linkCode && link.linkCodeExpiry && Date.now() < link.linkCodeExpiry) {
          linkCodeArea.style.display = "block";
          linkCodeDisplay.textContent = link.linkCode;
          if (verificationUriLink) {
            verificationUriLink.href = link.verificationUriComplete || link.verificationUri || "https://tak.gov/register-device";
          }
          const sec = Math.max(0, Math.floor((link.linkCodeExpiry - Date.now()) / 1000));
          linkCodeExpiry.textContent = "Expires in " + sec + "s";
        } else {
          linkCodeArea.style.display = "none";
        }
      }
      downloadedPluginsCache = plugins;
      updateStatusCache = {};
      renderPluginCards(plugins);

      // Auto-detect available updates (TAK.gov + TAKwerx) in the background.
      if (plugins.some(function (p) { return !!p.package_name && (p.source === "tak.gov" || p.source === "takwerx"); })) {
        (async function () {
          try {
            const statusRes = await fetch("/api/plugins/update-status");
            const statusData = await statusRes.json();
            if (statusData && statusData.updateStatus) {
              updateStatusCache = statusData.updateStatus;
              renderPluginCards(downloadedPluginsCache);
              if (takgovPluginsCache.length) renderTakgovMarketplace(getTakgovDisplayList());
              if (takwerxPluginsCache.length) renderTakwerxMarketplace(getTakwerxDisplayList());
            }
          } catch (_) {}
        })();
      }

      if (link.linked) {
        if (!takgovVersionsLoaded) await loadTakgovVersions();
        loadTakgovPlugins();
      } else if (takgovPluginsCache.length > 0) {
        renderTakgovMarketplace(getTakgovDisplayList());
      }
      loadTakwerxPlugins();
      if (typeof refreshSyncStatus === "function") refreshSyncStatus();
    } catch (err) {
      if (pluginsLoading) pluginsLoading.style.display = "none";
      setPluginsMsg(err.message || "Failed to load plugins", false);
    }
  }

  function setMarketplaceMsg(text, ok) {
    if (!marketplaceMsg) return;
    marketplaceMsg.textContent = text || "";
    marketplaceMsg.style.color = ok === false ? "var(--danger)" : "";
  }

  async function loadTakgovVersions() {
    if (!takgovVersion) return;
    const previous = (takgovVersion.value || "").trim();
    try {
      const res = await fetch("/api/plugins/takgov/versions?product=ATAK-CIV");
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to load ATAK versions");
      const versions = Array.isArray(data.versions) ? data.versions.filter(Boolean) : [];
      if (versions.length === 0) return;
      takgovVersion.innerHTML = versions.map(function (v) {
        return "<option value=\"" + esc(v) + "\">" + esc(v) + "</option>";
      }).join("");
      takgovVersion.value = versions.includes(previous) ? previous : versions[0];
      takgovVersionsLoaded = true;
    } catch (_) {
      // Keep fallback option if dynamic discovery fails.
    }
  }

  function getTakgovDisplayList() {
    const raw = takgovPluginsCache || [];
    const sorted = raw.slice().sort(function (a, b) {
      const na = (a.display_name || a.package_name || a.name || "").toLowerCase();
      const nb = (b.display_name || b.package_name || b.name || "").toLowerCase();
      return na.localeCompare(nb);
    });
    const q = (takgovSearchText || "").trim().toLowerCase();
    if (!q) return sorted;
    return sorted.filter(function (p) {
      const name = (p.display_name || p.package_name || p.name || "").toLowerCase();
      const desc = (p.description || "").toLowerCase();
      const pkg = (p.package_name || "").toLowerCase();
      return name.includes(q) || desc.includes(q) || pkg.includes(q);
    });
  }

  function renderTakgovMarketplace(plugins) {
    if (!marketplaceGrid || !marketplaceEmpty) return;
    const list = Array.isArray(plugins) ? plugins : [];
    if (list.length === 0) {
      marketplaceGrid.innerHTML = "";
      marketplaceGrid.style.display = "none";
      marketplaceEmpty.style.display = "block";
      marketplaceEmpty.textContent = (takgovSearchText || "").trim() ? "No plugins match your search." : "No plugins returned. Try a different ATAK version.";
      return;
    }
    marketplaceEmpty.style.display = "none";
    marketplaceGrid.style.display = "grid";
    marketplaceGrid.innerHTML = list.map(function (p, idx) {
      const name = esc(p.display_name || p.package_name || p.name || "Plugin");
      const desc = (p.description || "").slice(0, 120);
      const installed = findInstalledMatch(p);
      const needsUpdate = !!(installed && isRemoteNewer(installed, p));
      let actionBtn = "";
      if (needsUpdate) {
        actionBtn = "<button class=\"btn success\" type=\"button\" data-takgov-download data-takgov-index=\"" + idx + "\">Update To Latest</button>";
      } else if (!installed) {
        actionBtn = "<button class=\"btn success\" type=\"button\" data-takgov-download data-takgov-index=\"" + idx + "\">Add To Server</button>";
      }
      return "<div class=\"plugin-card\" data-takgov-index=\"" + idx + "\">" +
        "<div class=\"plugin-card-header\">" +
        "<div class=\"plugin-name\">" + name + "</div>" +
        "</div>" +
        (desc ? "<div class=\"plugin-desc\">" + esc(desc) + (desc.length >= 120 ? "…" : "") + "</div>" : "") +
        "<div class=\"plugin-actions\">" +
        actionBtn +
        "</div></div>";
    }).join("");
    marketplaceGrid.querySelectorAll("[data-takgov-download]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const idx = parseInt(btn.getAttribute("data-takgov-index"), 10);
        const pluginItem = list[idx];
        if (!pluginItem || !pluginItem.apk_url) return;
        const isUpdate = btn.textContent === "Update To Latest";
        btn.disabled = true;
        btn.textContent = isUpdate ? "Updating…" : "Adding…";
        setMarketplaceMsg("", true);
        fetch("/api/plugins/takgov/download", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ plugin: pluginItem }),
        })
          .then(function (res) {
            return res.text().then(function (text) {
              var data = {};
              try { data = text ? JSON.parse(text) : {}; } catch (_) {}
              return { res: res, data: data, text: text };
            });
          })
          .then(function (_ref) {
            const res = _ref.res;
            const data = _ref.data;
            const text = _ref.text;
            const errMsg = (data && data.error) || (typeof text === "string" && text.slice(0, 200)) || "Download failed";
            if (!res.ok) {
              setMarketplaceMsg(errMsg, false);
              btn.textContent = isUpdate ? "Update To Latest" : "Add To Server";
              btn.disabled = false;
              return;
            }
            setMarketplaceMsg(isUpdate ? "Plugin updated on server." : "Plugin added/updated on server.", true);
            loadState();
          })
          .catch(function (err) {
            btn.textContent = isUpdate ? "Update To Latest" : "Add To Server";
            btn.disabled = false;
            setMarketplaceMsg(err.message || "Failed to add plugin", false);
          });
      });
    });
  }

  async function loadTakgovPlugins() {
    const version = (takgovVersion && takgovVersion.value || "5.7.0").trim();
    setMarketplaceMsg("Loading…", true);
    try {
      const res = await fetch("/api/plugins/takgov/plugins?product=ATAK-CIV&product_version=" + encodeURIComponent(version));
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Failed to load plugins");
      takgovPluginsCache = data.plugins || [];
      takgovSearchText = "";
      if (takgovSearch) takgovSearch.value = "";
      setMarketplaceMsg(takgovPluginsCache.length ? "" : "No plugins found for this product/version.", true);
      renderTakgovMarketplace(getTakgovDisplayList());
    } catch (err) {
      setMarketplaceMsg(err.message || "Failed to load", false);
      takgovPluginsCache = [];
      takgovSearchText = "";
      if (takgovSearch) takgovSearch.value = "";
      renderTakgovMarketplace([]);
    }
  }

  if (takgovVersion) {
    takgovVersion.addEventListener("change", function () { loadTakgovPlugins(); });
  }
  if (takgovSearch) {
    takgovSearch.addEventListener("input", function () {
      takgovSearchText = takgovSearch.value || "";
      renderTakgovMarketplace(getTakgovDisplayList());
    });
  }
  if (downloadedVersionFilter) {
    downloadedVersionFilter.addEventListener("change", function () {
      downloadedVersionFilterValue = downloadedVersionFilter.value || "";
      renderPluginCards(downloadedPluginsCache);
    });
  }

  function setTakwerxMsg(text, ok) {
