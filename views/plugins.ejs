<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <h1>ATAK Plugins</h1>

  <%
    const pluginListRaw = Array.isArray(plugins) ? plugins : [];
    const selectedVersionRaw = typeof selectedAtakVersion === "string" ? selectedAtakVersion.trim() : "";
    function getAtakVersion(p) {
      if (!p) return "";
      const direct = p.atakVersion || p.atak_version || "";
      if (String(direct || "").trim()) return String(direct).trim();
      const versionText = typeof p.version === "string" ? p.version : "";
      const bracket = versionText.match(/\[(\d+\.\d+(?:\.\d+)?)\]/);
      return bracket && bracket[1] ? bracket[1] : "";
    }
    function toVersionKey(v) {
      const s = String(v || "").trim();
      const m = s.match(/^(\d+)\.(\d+)/);
      return m ? (m[1] + "." + m[2]) : s;
    }
    const versionOptions = Array.from(new Set(
      pluginListRaw
        .map((p) => toVersionKey(getAtakVersion(p)))
        .filter(Boolean)
    )).sort((a, b) => {
      const ap = a.split(".").map((n) => parseInt(n, 10) || 0);
      const bp = b.split(".").map((n) => parseInt(n, 10) || 0);
      if (bp[0] !== ap[0]) return bp[0] - ap[0];
      return (bp[1] || 0) - (ap[1] || 0);
    });
    const selectedVersion = versionOptions.includes(selectedVersionRaw) ? selectedVersionRaw : "";
    const pluginList = selectedVersion
      ? pluginListRaw.filter((p) => toVersionKey(getAtakVersion(p)) === selectedVersion)
      : pluginListRaw;
    const recommended = pluginList.filter((p) => p.favorite === true).sort((a, b) => {
      const na = (a.name || a.filename || a.id || "").toLowerCase();
      const nb = (b.name || b.filename || b.id || "").toLowerCase();
      return na.localeCompare(nb);
    });
    const other = pluginList.filter((p) => p.favorite !== true).sort((a, b) => {
      const na = (a.name || a.filename || a.id || "").toLowerCase();
      const nb = (b.name || b.filename || b.id || "").toLowerCase();
      return na.localeCompare(nb);
    });

    function formatSize(bytes) {
      if (bytes == null) return "—";
      if (bytes < 1024) return bytes + " B";
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
      return (bytes / (1024 * 1024)).toFixed(2) + " MB";
    }
    function formatDate(iso) {
      if (!iso) return "—";
      try {
        const d = new Date(iso);
        return isNaN(d.getTime()) ? iso : d.toLocaleDateString() + " " + d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      } catch (_) { return iso; }
    }
    function esc(s) {
      if (s == null || s === undefined) return "";
      return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }
    function renderCard(p) {
      const name = esc(p.name || p.filename || p.id);
      const desc = (p.description || "").trim();
      const descShort = desc.slice(0, 120);
      const exists = p.exists !== false;
      const downloadUrl = "/api/plugins/" + encodeURIComponent(p.id) + "/download";
      const versionPill = p.version ? '<span class="plugin-version-pill">v' + esc(p.version) + '</span>' : '';
      return '<div class="plugin-card" data-id="' + esc(p.id) + '">' +
        '<div class="plugin-card-header">' +
        '<div class="plugin-name">' + name + '</div>' +
        versionPill +
        '</div>' +
        (desc ? '<div class="plugin-desc">' + esc(descShort) + (desc.length > 120 ? "…" : "") + '</div>' : '') +
        (exists ? '' : '<div class="plugin-meta" style="color: var(--danger);">File missing on disk</div>') +
        '<div class="plugin-actions">' +
        (exists ? '<a href="' + downloadUrl + '" class="btn" download>Download</a>' : '') +
        '</div></div>';
    }
  %>

  <% if (versionOptions.length > 0) { %>
  <div class="card" style="margin-top: 16px;">
    <form method="get" action="/plugins" class="row" style="align-items: flex-end; gap: 12px; flex-wrap: wrap;">
      <label>ATAK version
        <select name="atak" style="min-width: 140px;">
          <option value="" <%= selectedVersion ? "" : "selected" %>>All versions</option>
          <% versionOptions.forEach(function (v) { %>
            <option value="<%= v %>" <%= selectedVersion === v ? "selected" : "" %>><%= v %>.x</option>
          <% }); %>
        </select>
      </label>
      <button type="submit" class="btn">Apply</button>
      <% if (selectedVersion) { %>
      <a class="btn" href="/plugins">Clear</a>
      <% } %>
    </form>
  </div>
  <% } %>

  <% if (recommended.length > 0) { %>
  <div class="card" style="margin-top: 20px;">
    <h2 style="margin-top: 0;">Recommended Plugins</h2>
    <div class="plugin-cards onboarding-plugin-cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
      <% recommended.forEach(function (p) { %><%- renderCard(p) %><% }); %>
    </div>
  </div>
  <% } %>

  <% if (other.length > 0) { %>
  <div class="card" style="margin-top: 24px;">
    <h2 style="margin-top: 0;"><%= recommended.length > 0 ? "Other Plugins" : "Avaliable Plugins" %></h2>
    <div class="plugin-cards onboarding-plugin-cards" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 16px;">
      <% other.forEach(function (p) { %><%- renderCard(p) %><% }); %>
    </div>
  </div>
  <% } %>

  <% if (pluginList.length === 0) { %>
  <div class="card" style="margin-top: 20px;">
    <p class="muted">No plugins have been added yet. Check back later or contact your TAK Portal administrator.</p>
  </div>
  <% } %>
</main>

<style>
  .plugin-cards.onboarding-plugin-cards .plugin-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }
  .plugin-cards.onboarding-plugin-cards .plugin-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .plugin-cards.onboarding-plugin-cards .plugin-name { font-weight: 600; flex: 1; min-width: 0; }
  .plugin-cards.onboarding-plugin-cards .plugin-version-pill {
    flex-shrink: 0;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--line);
    color: var(--muted);
  }
  .plugin-cards.onboarding-plugin-cards .plugin-desc { font-size: 0.85rem; color: var(--muted); max-height: 2.6em; overflow: hidden; text-overflow: ellipsis; }
  .plugin-cards.onboarding-plugin-cards .plugin-meta { font-size: 0.9rem; color: var(--muted); }
  .plugin-cards.onboarding-plugin-cards .plugin-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: auto; }
</style>
