<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAK Portal - Review Access Request</title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      .groupsBox{
        margin-top: 10px;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 12px;
        padding: 10px;
        max-height: 320px;
        overflow-y: auto;
        overflow-x: hidden;
      }
      .groupsInner{
        column-width: 310px;
        column-gap: 14px;
        column-count: 4;
      }
      .groupItem{
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 10px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
      }
      .groupItem:hover{ background: rgba(255,255,255,.06); }
      .groupItem input{
        margin: 0;
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
      }
      .groupItem span{
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .approveEmailPwdRow,
      .approveFinalRow{
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }
      .approveFinalRow > label{
        margin: 0;
      }
      .requestPermissionsSelect{
        width: 100%;
        max-width: none;
        box-sizing: border-box;
      }
      .passwordWrap {
        position: relative;
        display: flex;
        align-items: center;
      }
      .passwordWrap input {
        width: 100%;
        padding-right: 2.5rem;
      }
      .passwordToggle {
        position: absolute;
        right: 8px;
        background: none;
        border: none;
        color: #fff;
        cursor: pointer;
        font-size: 1rem;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .passwordToggle:focus-visible {
        outline: 2px solid var(--accent, #fff);
        outline-offset: 2px;
      }
      @media (max-width: 640px) {
        .approveEmailPwdRow,
        .approveFinalRow{
          grid-template-columns: 1fr;
        }
      }
    </style>
    <% if (brandLogoUrl) { %>
      <link rel="icon" href="<%= brandLogoUrl %>" type="image/png" />
      <link rel="shortcut icon" href="<%= brandLogoUrl %>" type="image/png" />
    <% } %>
  </head>
  <body class="theme-<%= brandTheme || 'dark' %>" data-theme-default-only="true">
    <div class="app">
      <main class="main" style="max-width: 980px; margin: 0 auto;">
        <h1>Review Access Request</h1>
        <%
          const usernamePrefixLabel = String((settings && settings.USERNAME_PREFIX_LABEL) || "").trim() || "Badge Number / Username";
        %>
        <div class="card">
          <h2 style="margin-top:0;">User Access Request</h2>
          <p class="muted approveNote" id="approveNote"></p>
          <p class="muted" id="reviewInfo">Loading request...</p>

          <form id="reviewForm" class="grid2 approveForm" autocomplete="off" style="display:none;">
            <label><%= usernamePrefixLabel %>
              <input type="text" name="badge" placeholder="Enter <%= usernamePrefixLabel %>" required />
            </label>

            <label>Agency
              <select name="agencySuffix" id="agencySelect" class="agencySelect" required></select>
            </label>

            <label>First Name
              <input name="firstName" placeholder="John" required />
            </label>

            <label>Last Name
              <input name="lastName" placeholder="Doe" required />
            </label>

            <div class="approveEmailPwdRow">
              <label>Email (optional)
                <input name="email" type="email" placeholder="example@agency.gov" />
              </label>

              <label>Password (optional)
                <div class="passwordWrap">
                  <input
                    class="passwordInput"
                    name="password"
                    type="password"
                    placeholder="Min 12 characters: upper, lower, number, and symbol"
                    minlength="12"
                    pattern="(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}"
                    title="Password must contain a minimum of 12 characters, upper, lower, number, and symbol"
                  />
                  <button
                    type="button"
                    class="passwordToggle"
                    id="passwordToggle"
                    aria-label="Show password"
                  >👁</button>
                </div>
              </label>

              <label>Radio Callsign (optional)
                <input name="radioCallsign" type="text" placeholder="ex. T05 or C10 or B01G" autocomplete="off" />
              </label>
            </div>

            <div class="approveFinalRow">
              <label>Template
                <select name="templateIndex" id="templateSelect" class="templateSelect"></select>
              </label>

              <label>Role
                <select name="role" id="roleSelect" class="roleSelect" aria-label="ATAK role"></select>
              </label>

              <label>Permissions
                <select name="permissions" id="permissionsSelect" class="requestPermissionsSelect" aria-label="User permissions">
                  <option value="user" selected>User</option>
                  <option value="agency_admin">Agency Admin</option>
                </select>
              </label>
            </div>

            <div class="manualGroupsWrap" id="manualGroupsWrap" style="display:none; grid-column: 1 / -1;">
              <h3 style="margin-top:0;">Manual Groups</h3>
              <label style="display:block;">
                Groups
                <input id="groupFilter" class="groupFilter" placeholder="Search groups..." />
                <div class="row" style="gap:10px; margin-top:8px;">
                  <button class="btn" id="selectAllBtn" type="button">Select All</button>
                  <button class="btn" id="clearAllBtn" type="button">Clear</button>
                </div>
                <div class="groupsBox">
                  <div class="groupsInner" id="groupsInner"></div>
                </div>
              </label>
            </div>

            <div style="grid-column: 1 / -1; display:flex; align-items:center; gap:10px; flex-wrap: wrap; justify-content:flex-end;">
              <button class="btn danger" id="rejectBtn" type="button">Reject</button>
              <button class="btn success" id="approveBtn" type="submit">Create New User</button>
              <span class="msg createMsg" id="actionMsg"></span>
            </div>
          </form>
        </div>
      </main>
    </div>

    <script>
    (function () {
      const token = <%- JSON.stringify(reviewToken || "") %>;
      const form = document.getElementById("reviewForm");
      const reviewInfo = document.getElementById("reviewInfo");
      const approveNote = document.getElementById("approveNote");
      const actionMsg = document.getElementById("actionMsg");
      const rejectBtn = document.getElementById("rejectBtn");
      const approveBtn = document.getElementById("approveBtn");
      const agencySelect = document.getElementById("agencySelect");
      const templateSelect = document.getElementById("templateSelect");
      const roleSelect = document.getElementById("roleSelect");
      const manualGroupsWrap = document.getElementById("manualGroupsWrap");
      const groupsInner = document.getElementById("groupsInner");
      const groupFilter = document.getElementById("groupFilter");
      const selectAllBtn = document.getElementById("selectAllBtn");
      const clearAllBtn = document.getElementById("clearAllBtn");
      const passwordInput = form.querySelector(".passwordInput");
      const passwordToggle = document.getElementById("passwordToggle");

      const pickedManualGroupIds = new Set();
      const ATAK_ROLE_OPTIONS = ["Team Member", "Team Lead", "HQ", "Sniper", "Medic", "Forward Observer", "RTO", "K9"];
      let reviewRequest = null;
      let groupsCache = [];
      let templatesCache = [];
      let agenciesCache = [];

      function esc(s) {
        return String(s ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function setMsg(text, ok) {
        actionMsg.textContent = text || "";
        actionMsg.className = "msg createMsg " + (ok === false ? "bad" : ok === "pending" ? "pending" : "ok");
      }

      function isValidPassword(pwd) {
        if (!pwd) return true;
        return /^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}$/.test(String(pwd || ""));
      }

      function renderRoleOptions(selectedRole) {
        roleSelect.innerHTML = ATAK_ROLE_OPTIONS
          .map((role) => '<option value="' + esc(role) + '">' + esc(role) + "</option>")
          .join("");
        const pick = String(selectedRole || "Team Member").trim();
        roleSelect.value = ATAK_ROLE_OPTIONS.includes(pick) ? pick : "Team Member";
      }

      function renderApproveNote(reqObj) {
        if (!reqObj || String(reqObj.agencySuffix || "") !== "__other__") {
          approveNote.textContent = "";
          return;
        }
        const agencyName = esc(reqObj.otherAgency || "Other");
        const reason = esc(reqObj.otherReason || "");
        approveNote.innerHTML =
          "<strong>Requested Agency:</strong> " + agencyName + "<br>" +
          (reason ? "<strong>Reason for Access:</strong> " + reason : "");
      }

      function renderGroupsBox() {
        const needle = String(groupFilter.value || "").trim().toLowerCase();
        const sorted = groupsCache.slice().sort((a, b) =>
          String(a.name || "").localeCompare(String(b.name || ""))
        );
        const filtered = needle
          ? sorted.filter((g) => String(g.name || "").toLowerCase().includes(needle))
          : sorted;
        groupsInner.innerHTML = filtered.map((g) => {
          const id = String(g.pk);
          const name = String(g.name || "").replace(/^tak_/i, "");
          return '<label class="groupItem"><input type="checkbox" value="' + esc(id) + '" /><span>' + esc(name) + "</span></label>";
        }).join("");

        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = pickedManualGroupIds.has(String(cb.value));
        });
      }

      async function refreshMetaForAgency() {
        const agencySuffix = String(agencySelect.value || "").trim().toLowerCase();
        const res = await fetch("/request-access/" + encodeURIComponent(token) + "/meta?agencySuffix=" + encodeURIComponent(agencySuffix));
        const out = await res.json();
        if (!res.ok) throw new Error(out.error || "Failed to load templates.");

        templatesCache = Array.isArray(out.templates) ? out.templates : [];
        groupsCache = Array.isArray(out.groups) ? out.groups : [];

        const manual = { name: "Manual Group Selection", role: "Team Member", groups: [] };
        const rest = templatesCache
          .filter((t) => String(t.name || "").trim().toLowerCase() !== "manual group selection")
          .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")));
        templatesCache = [manual, ...rest];

        templateSelect.innerHTML = templatesCache
          .map((t) => '<option value="' + esc(t.name) + '">' + esc(t.name) + "</option>")
          .join("");

        let defaultName = "Manual Group Selection";
        const defaultTpl = templatesCache.find((t) => !!t.isDefault && String(t.name || "").trim());
        if (defaultTpl) {
          defaultName = String(defaultTpl.name).trim();
        } else {
          const firstNonManual = templatesCache.find(
            (t) => String(t.name || "").trim().toLowerCase() !== "manual group selection"
          );
          if (firstNonManual) defaultName = String(firstNonManual.name).trim();
        }

        templateSelect.value = defaultName;
        const currentDefaultTemplate = templatesCache.find(
          (t) => String(t.name || "").trim().toLowerCase() === String(defaultName || "").trim().toLowerCase()
        );
        renderRoleOptions(currentDefaultTemplate?.role || "Team Member");
        templateSelect.dispatchEvent(new Event("change"));
      }

      if (passwordInput && passwordToggle) {
        passwordToggle.addEventListener("click", () => {
          const isHidden = passwordInput.type === "password";
          passwordInput.type = isHidden ? "text" : "password";
          passwordToggle.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
        });
      }

      templateSelect.addEventListener("change", function () {
        const isManual =
          String(templateSelect.value || "").trim().toLowerCase() === "manual group selection";
        const selectedName = String(templateSelect.value || "").trim();
        const selectedTemplate = templatesCache.find(
          (t) => String(t.name || "").trim().toLowerCase() === selectedName.toLowerCase()
        );
        manualGroupsWrap.style.display = isManual ? "block" : "none";
        renderRoleOptions(selectedTemplate?.role || "Team Member");
        if (isManual) renderGroupsBox();
      });

      agencySelect.addEventListener("change", async function () {
        pickedManualGroupIds.clear();
        groupFilter.value = "";
        renderGroupsBox();
        try {
          await refreshMetaForAgency();
        } catch (err) {
          setMsg(err.message || "Failed to load templates", false);
        }
      });

      groupFilter.addEventListener("input", renderGroupsBox);
      groupsInner.addEventListener("change", function (e) {
        const cb = e.target;
        if (!cb || cb.tagName !== "INPUT" || cb.type !== "checkbox") return;
        const id = String(cb.value);
        if (cb.checked) pickedManualGroupIds.add(id);
        else pickedManualGroupIds.delete(id);
      });
      selectAllBtn.addEventListener("click", function () {
        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = true;
          pickedManualGroupIds.add(String(cb.value));
        });
      });
      clearAllBtn.addEventListener("click", function () {
        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = false;
        });
        pickedManualGroupIds.clear();
      });

      rejectBtn.addEventListener("click", async function () {
        if (!confirm("Reject this request? This will delete it.")) return;
        rejectBtn.disabled = true;
        approveBtn.disabled = true;
        setMsg("Rejecting request...", "pending");
        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/reject", {
            method: "POST",
          });
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Failed to reject request.");
          setMsg("Request rejected.", true);
          form.style.display = "none";
          reviewInfo.textContent = "This request has been reviewed.";
        } catch (err) {
          setMsg(err.message || "Failed to reject request.", false);
          rejectBtn.disabled = false;
          approveBtn.disabled = false;
        }
      });

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        setMsg("");

        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        const pwd = String(payload.password || "").trim();
        if (!isValidPassword(pwd)) {
          setMsg("Password must be at least 12 characters with upper, lower, number, and symbol.", false);
          return;
        }
        if (String(payload.templateIndex || "").trim().toLowerCase() === "manual group selection") {
          payload.manualGroupIds = Array.from(pickedManualGroupIds);
        }

        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        setMsg("User creation in progress...", "pending");

        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/approve", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Failed to create user.");

          const username = (out.user && out.user.username) || out.username || payload.badge || "";
          setMsg(username ? "User created: " + username : "User created.", true);
          form.style.display = "none";
          reviewInfo.textContent = "This request has been reviewed.";
        } catch (err) {
          setMsg(err.message || "Failed to create user.", false);
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      });

      async function init() {
        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/data");
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Request not found.");
          reviewRequest = out.request || null;
          if (!reviewRequest) throw new Error("Request not found.");

          reviewInfo.textContent = "";
          renderApproveNote(reviewRequest);

          form.badge.value = reviewRequest.badgeNumber || "";
          form.firstName.value = reviewRequest.firstName || "";
          form.lastName.value = reviewRequest.lastName || "";
          form.email.value = reviewRequest.email || "";
          form.radioCallsign.value = reviewRequest.radioCallsign || "";

          const metaRes = await fetch("/request-access/" + encodeURIComponent(token) + "/meta");
          const metaOut = await metaRes.json();
          if (!metaRes.ok) throw new Error(metaOut.error || "Failed to load metadata.");

          agenciesCache = Array.isArray(metaOut.agencies) ? metaOut.agencies : [];
          agencySelect.innerHTML = agenciesCache
            .slice()
            .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")))
            .map((a) => '<option value="' + esc(a.suffix) + '">' + esc(a.name) + " (" + esc(a.groupPrefix) + ")</option>")
            .join("");

          const requestedAgency = String(reviewRequest.agencySuffix || "").trim().toLowerCase();
          if (requestedAgency === "__other__") {
            const opt = document.createElement("option");
            opt.value = "__other__";
            opt.textContent = "Other / Not Listed";
            opt.selected = true;
            agencySelect.insertBefore(opt, agencySelect.firstChild);
          } else if (
            requestedAgency &&
            Array.from(agencySelect.options).some((o) => String(o.value) === requestedAgency)
          ) {
            agencySelect.value = requestedAgency;
          } else if (agencySelect.options.length) {
            agencySelect.selectedIndex = 0;
          }

          renderGroupsBox();
          await refreshMetaForAgency();
          form.style.display = "";
        } catch (err) {
          reviewInfo.textContent = err.message || "Request not found.";
          form.style.display = "none";
        }
      }

      init();
    })();
    </script>
    <script>
      try { localStorage.removeItem("tak-portal-theme"); } catch (e) {}
    </script>
    <script src="/theme-toggle.js" defer></script>
  </body>
</html>
