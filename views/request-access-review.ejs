<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>TAK Portal - Review Access Request</title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      .groupsBox{
        margin-top: 10px;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 12px;
        padding: 10px;
        max-height: 320px;
        overflow-y: auto;
        overflow-x: hidden;
      }
      .groupsInner{
        column-width: 310px;
        column-gap: 14px;
        column-count: 4;
      }
      .groupItem{
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 10px;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
      }
      .groupItem:hover{ background: rgba(255,255,255,.06); }
      .groupItem input{
        margin: 0;
        width: 16px;
        height: 16px;
        flex: 0 0 auto;
      }
      .groupItem span{
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .approveEmailPwdRow,
      .approveFinalRow{
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
      }
      .approveFinalRow > label{
        margin: 0;
      }
      .requestPermissionsSelect{
        width: 100%;
        max-width: none;
        box-sizing: border-box;
      }
      .passwordWrap {
        position: relative;
        display: flex;
        align-items: center;
      }
      .passwordWrap input {
        width: 100%;
        padding-right: 2.5rem;
      }
      .passwordToggle {
        position: absolute;
        right: 8px;
        background: none;
        border: none;
        color: #fff;
        cursor: pointer;
        font-size: 1rem;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .passwordToggle:focus-visible {
        outline: 2px solid var(--accent, #fff);
        outline-offset: 2px;
      }
      .reviewFormActions,
      .createActionsRow {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }
      @media (max-width: 640px) {
        .approveEmailPwdRow,
        .approveFinalRow{
          grid-template-columns: 1fr;
        }
        .groupsInner{
          column-count: 1;
          column-width: auto;
        }
        .groupItem{
          min-height: 44px;
          padding: 10px 8px;
          white-space: normal;
        }
        .groupItem input{
          width: 20px;
          height: 20px;
        }
        .groupItem span{
          white-space: normal;
          overflow: visible;
          text-overflow: unset;
        }
      }
      @media (max-width: 990px) {
        .approveEmailPwdRow,
        .approveFinalRow{
          grid-template-columns: 1fr;
        }
        .groupsInner{
          column-count: 1;
          column-width: auto;
        }
        .reviewFormActions,
        .createActionsRow{
          flex-direction: column;
          align-items: stretch;
          justify-content: stretch;
        }
        .reviewFormActions .btn,
        .createActionsRow .btn{
          width: 100%;
        }
        .reviewFormActions .msg,
        .createActionsRow .msg{
          width: 100%;
          text-align: center;
        }
      }
    </style>
    <% if (brandLogoUrl) { %>
      <link rel="icon" href="<%= brandLogoUrl %>" type="image/png" />
      <link rel="shortcut icon" href="<%= brandLogoUrl %>" type="image/png" />
    <% } %>
  </head>
  <body class="theme-<%= brandTheme || 'dark' %>" data-theme-default-only="true">
    <div class="app">
      <main class="main" style="max-width: 980px; margin: 0 auto;">
        <h1>Review Access Request</h1>
        <%
          const usernamePrefixLabel = String((settings && settings.USERNAME_PREFIX_LABEL) || "").trim() || "Badge Number / Username";
        %>
        <div class="card">
          <h2 style="margin-top:0;" id="reviewCardTitle">User Access Request</h2>
          <p class="muted approveNote" id="approveNote"></p>
          <p class="muted" id="reviewInfo">Loading request...</p>
          <div id="listMsg" class="msg"></div>

          <form id="createAgencyForm" class="grid2 createAgencyForm" autocomplete="off" style="display:none;">
            <%- include("partials/agency-create-fields", {
              agencyTypeOptions: typeof agencyTypeOptions !== "undefined" ? agencyTypeOptions : [],
              regionOptions: typeof regionOptions !== "undefined" ? regionOptions : [],
              regionCountyLocks: typeof regionCountyLocks !== "undefined" ? regionCountyLocks : [],
              includeColor: true,
              includeName: true,
              fieldsRequired: true,
              idPrefix: "reviewCreateAgency_",
              agencyFieldValues: {}
            }) %>

            <div class="createActionsRow agencyCreateActionsRow">
              <button class="btn danger" id="createAgencyRejectBtn" type="button">Reject</button>
              <button class="btn warning" id="skipAgencyBtn" type="button">Skip Agency Creation</button>
              <button class="btn success" type="submit">Create Agency</button>
              <span class="msg createAgencyMsg" id="createAgencyMsg"></span>
            </div>
          </form>

          <form id="reviewForm" class="grid2 approveForm" autocomplete="off" style="display:none;">
            <label><%= usernamePrefixLabel %>
              <input type="text" name="badge" placeholder="Enter <%= usernamePrefixLabel %>" required />
            </label>

            <label id="agencyFieldLabel">Agency
              <select name="agencySuffix" id="agencySelect" class="agencySelect" required></select>
              <input type="hidden" name="agencySuffix" id="agencySuffixLocked" disabled />
            </label>

            <label>First Name
              <input name="firstName" placeholder="John" required />
            </label>

            <label>Last Name
              <input name="lastName" placeholder="Doe" required />
            </label>

            <div class="approveEmailPwdRow">
              <label>Email (optional)
                <input name="email" type="email" placeholder="example@agency.gov" />
              </label>

              <label>Password (optional)
                <div class="passwordWrap">
                  <input
                    class="passwordInput"
                    name="password"
                    type="password"
                    placeholder="Min 12 characters: upper, lower, number, and symbol"
                    minlength="12"
                    pattern="(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}"
                    title="Password must contain a minimum of 12 characters, upper, lower, number, and symbol"
                  />
                  <button
                    type="button"
                    class="passwordToggle"
                    id="passwordToggle"
                    aria-label="Show password"
                  >👁</button>
                </div>
              </label>

              <label>Radio Callsign (optional)
                <input name="radioCallsign" type="text" placeholder="ex. T05 or C10 or B01G" autocomplete="off" />
              </label>
            </div>

            <div class="approveFinalRow">
              <label>Template
                <select name="templateIndex" id="templateSelect" class="templateSelect"></select>
              </label>

              <label>Role
                <select name="role" id="roleSelect" class="roleSelect" aria-label="ATAK role"></select>
              </label>

              <label>Permissions
                <select name="permissions" id="permissionsSelect" class="requestPermissionsSelect" aria-label="User permissions">
                  <option value="user" selected>User</option>
                  <option value="agency_admin">Agency Admin</option>
                </select>
              </label>
            </div>

            <div class="manualGroupsWrap" id="manualGroupsWrap" style="display:none; grid-column: 1 / -1;">
              <h3 style="margin-top:0;">Manual Groups</h3>
              <label style="display:block;">
                Groups
                <input id="groupFilter" class="groupFilter" placeholder="Search groups..." />
                <div class="row" style="gap:10px; margin-top:8px;">
                  <button class="btn" id="selectAllBtn" type="button">Select All</button>
                  <button class="btn" id="clearAllBtn" type="button">Clear</button>
                </div>
                <div class="groupsBox">
                  <div class="groupsInner" id="groupsInner"></div>
                </div>
              </label>
            </div>

            <div class="reviewFormActions">
              <button class="btn danger" id="rejectBtn" type="button">Reject</button>
              <button class="btn success" id="approveBtn" type="submit">Create New User</button>
              <span class="msg createMsg" id="actionMsg"></span>
            </div>
          </form>
        </div>
      </main>
    </div>

    <script>
    (function () {
      const token = <%- JSON.stringify(reviewToken || "") %>;
      const form = document.getElementById("reviewForm");
      const createAgencyForm = document.getElementById("createAgencyForm");
      const reviewCardTitle = document.getElementById("reviewCardTitle");
      const reviewInfo = document.getElementById("reviewInfo");
      const approveNote = document.getElementById("approveNote");
      const listMsg = document.getElementById("listMsg");
      const actionMsg = document.getElementById("actionMsg");
      const createAgencyMsg = document.getElementById("createAgencyMsg");
      const rejectBtn = document.getElementById("rejectBtn");
      const createAgencyRejectBtn = document.getElementById("createAgencyRejectBtn");
      const skipAgencyBtn = document.getElementById("skipAgencyBtn");
      const createAgencySubmitBtn = createAgencyForm
        ? createAgencyForm.querySelector('button[type="submit"]')
        : null;
      const approveBtn = document.getElementById("approveBtn");
      const agencySelect = document.getElementById("agencySelect");
      const templateSelect = document.getElementById("templateSelect");
      const roleSelect = document.getElementById("roleSelect");
      const manualGroupsWrap = document.getElementById("manualGroupsWrap");
      const groupsInner = document.getElementById("groupsInner");
      const groupFilter = document.getElementById("groupFilter");
      const selectAllBtn = document.getElementById("selectAllBtn");
      const clearAllBtn = document.getElementById("clearAllBtn");
      const passwordInput = form.querySelector(".passwordInput");
      const passwordToggle = document.getElementById("passwordToggle");

      const pickedManualGroupIds = new Set();
      const ATAK_ROLE_OPTIONS = ["Team Member", "Team Lead", "HQ", "Sniper", "Medic", "Forward Observer", "RTO", "K9"];
      let reviewRequest = null;
      let canChangeAgency = false;
      let groupsCache = [];
      let templatesCache = [];
      let agenciesCache = [];

      function esc(s) {
        return String(s ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function setMsg(text, ok) {
        actionMsg.textContent = text || "";
        actionMsg.className = "msg createMsg " + (ok === false ? "bad" : ok === "pending" ? "pending" : "ok");
      }

      function setAgencyMsg(text, ok) {
        if (!createAgencyMsg) return;
        createAgencyMsg.textContent = text || "";
        createAgencyMsg.className = "msg createAgencyMsg " + (ok === false ? "bad" : ok === "pending" ? "pending" : "ok");
      }

      function setListMsg(text, ok) {
        if (!listMsg) return;
        listMsg.textContent = text || "";
        listMsg.className = "msg " + (ok === false ? "bad" : "ok");
      }

      function setFormValue(targetForm, name, value) {
        const el = targetForm && targetForm.elements ? targetForm.elements[name] : null;
        if (!el) return;
        el.value = value == null ? "" : String(value);
      }

      function mainGroupNameForAgency(agencyLike) {
        const prefix = String(agencyLike.groupPrefix || "").trim();
        return prefix ? "tak_" + prefix + " Main" : "";
      }

      function isOtherRequest(reqObj) {
        return String(reqObj?.agencySuffix || "") === "__other__";
      }

      function isValidPassword(pwd) {
        if (!pwd) return true;
        return /^(?=.*[A-Z])(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{12,}$/.test(String(pwd || ""));
      }

      function renderRoleOptions(selectedRole) {
        roleSelect.innerHTML = ATAK_ROLE_OPTIONS
          .map((role) => '<option value="' + esc(role) + '">' + esc(role) + "</option>")
          .join("");
        const pick = String(selectedRole || "Team Member").trim();
        roleSelect.value = ATAK_ROLE_OPTIONS.includes(pick) ? pick : "Team Member";
      }

      function renderApproveNote(reqObj) {
        if (!reqObj || String(reqObj.agencySuffix || "") !== "__other__") {
          approveNote.textContent = "";
          return;
        }
        const agencyName = esc(reqObj.otherAgency || "Other");
        const reason = esc(reqObj.otherReason || "");
        approveNote.innerHTML =
          "<strong>Requested Agency:</strong> " + agencyName + "<br>" +
          (reason ? "<strong>Reason for Access:</strong> " + reason : "");
      }

      function renderGroupsBox() {
        const needle = String(groupFilter.value || "").trim().toLowerCase();
        const sorted = groupsCache.slice().sort((a, b) =>
          String(a.name || "").localeCompare(String(b.name || ""))
        );
        const filtered = needle
          ? sorted.filter((g) => String(g.name || "").toLowerCase().includes(needle))
          : sorted;
        groupsInner.innerHTML = filtered.map((g) => {
          const id = String(g.pk);
          const name = String(g.name || "").replace(/^tak_/i, "");
          return '<label class="groupItem"><input type="checkbox" value="' + esc(id) + '" /><span>' + esc(name) + "</span></label>";
        }).join("");

        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = pickedManualGroupIds.has(String(cb.value));
        });
      }

      function fillAgencySelect() {
        agencySelect.innerHTML = agenciesCache
          .slice()
          .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")))
          .map((a) => '<option value="' + esc(a.suffix) + '">' + esc(a.name) + " (" + esc(a.groupPrefix) + ")</option>")
          .join("");
      }

      async function reloadMetaAgencies() {
        const metaRes = await fetch("/request-access/" + encodeURIComponent(token) + "/meta");
        const metaOut = await metaRes.json();
        if (!metaRes.ok) throw new Error(metaOut.error || "Failed to load metadata.");
        agenciesCache = Array.isArray(metaOut.agencies) ? metaOut.agencies : [];
        if (Array.isArray(metaOut.groups)) groupsCache = metaOut.groups;
      }

      async function rejectRequest() {
        if (!confirm("Reject this request? This will delete it.")) return;
        if (rejectBtn) rejectBtn.disabled = true;
        if (approveBtn) approveBtn.disabled = true;
        if (createAgencyRejectBtn) createAgencyRejectBtn.disabled = true;
        if (skipAgencyBtn) skipAgencyBtn.disabled = true;
        if (createAgencySubmitBtn) createAgencySubmitBtn.disabled = true;
        setMsg("Rejecting request...", "pending");
        setAgencyMsg("Rejecting request...", "pending");
        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/reject", {
            method: "POST",
          });
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Failed to reject request.");
          setMsg("Request rejected.", true);
          setAgencyMsg("Request rejected.", true);
          form.style.display = "none";
          if (createAgencyForm) createAgencyForm.style.display = "none";
          reviewInfo.textContent = "This request has been reviewed.";
        } catch (err) {
          setMsg(err.message || "Failed to reject request.", false);
          setAgencyMsg(err.message || "Failed to reject request.", false);
          if (rejectBtn) rejectBtn.disabled = false;
          if (approveBtn) approveBtn.disabled = false;
          if (createAgencyRejectBtn) createAgencyRejectBtn.disabled = false;
          if (skipAgencyBtn) skipAgencyBtn.disabled = false;
          if (createAgencySubmitBtn) createAgencySubmitBtn.disabled = false;
        }
      }

      async function refreshMetaForAgency() {
        const agencySuffix = String(agencySelect.value || "").trim().toLowerCase();
        const res = await fetch("/request-access/" + encodeURIComponent(token) + "/meta?agencySuffix=" + encodeURIComponent(agencySuffix));
        const out = await res.json();
        if (!res.ok) throw new Error(out.error || "Failed to load templates.");

        templatesCache = Array.isArray(out.templates) ? out.templates : [];
        groupsCache = Array.isArray(out.groups) ? out.groups : [];

        const manual = { name: "Manual Group Selection", role: "Team Member", groups: [] };
        const rest = templatesCache
          .filter((t) => String(t.name || "").trim().toLowerCase() !== "manual group selection")
          .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")));
        templatesCache = [manual, ...rest];

        templateSelect.innerHTML = templatesCache
          .map((t) => '<option value="' + esc(t.name) + '">' + esc(t.name) + "</option>")
          .join("");

        let defaultName = "Manual Group Selection";
        const defaultTpl = templatesCache.find((t) => !!t.isDefault && String(t.name || "").trim());
        if (defaultTpl) {
          defaultName = String(defaultTpl.name).trim();
        } else {
          const firstNonManual = templatesCache.find(
            (t) => String(t.name || "").trim().toLowerCase() !== "manual group selection"
          );
          if (firstNonManual) defaultName = String(firstNonManual.name).trim();
        }

        templateSelect.value = defaultName;
        const currentDefaultTemplate = templatesCache.find(
          (t) => String(t.name || "").trim().toLowerCase() === String(defaultName || "").trim().toLowerCase()
        );
        renderRoleOptions(currentDefaultTemplate?.role || "Team Member");
        templateSelect.dispatchEvent(new Event("change"));
      }

      if (passwordInput && passwordToggle) {
        passwordToggle.addEventListener("click", () => {
          const isHidden = passwordInput.type === "password";
          passwordInput.type = isHidden ? "text" : "password";
          passwordToggle.setAttribute("aria-label", isHidden ? "Hide password" : "Show password");
        });
      }

      templateSelect.addEventListener("change", function () {
        const isManual =
          String(templateSelect.value || "").trim().toLowerCase() === "manual group selection";
        const selectedName = String(templateSelect.value || "").trim();
        const selectedTemplate = templatesCache.find(
          (t) => String(t.name || "").trim().toLowerCase() === selectedName.toLowerCase()
        );
        manualGroupsWrap.style.display = isManual ? "block" : "none";
        renderRoleOptions(selectedTemplate?.role || "Team Member");
        if (isManual) renderGroupsBox();
      });

      agencySelect.addEventListener("change", async function () {
        pickedManualGroupIds.clear();
        groupFilter.value = "";
        renderGroupsBox();
        try {
          await refreshMetaForAgency();
        } catch (err) {
          setMsg(err.message || "Failed to load templates", false);
        }
      });

      groupFilter.addEventListener("input", renderGroupsBox);
      groupsInner.addEventListener("change", function (e) {
        const cb = e.target;
        if (!cb || cb.tagName !== "INPUT" || cb.type !== "checkbox") return;
        const id = String(cb.value);
        if (cb.checked) pickedManualGroupIds.add(id);
        else pickedManualGroupIds.delete(id);
      });
      selectAllBtn.addEventListener("click", function () {
        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = true;
          pickedManualGroupIds.add(String(cb.value));
        });
      });
      clearAllBtn.addEventListener("click", function () {
        Array.from(groupsInner.querySelectorAll('input[type="checkbox"]')).forEach((cb) => {
          cb.checked = false;
        });
        pickedManualGroupIds.clear();
      });

      if (rejectBtn) rejectBtn.addEventListener("click", rejectRequest);
      if (createAgencyRejectBtn) createAgencyRejectBtn.addEventListener("click", rejectRequest);

      form.addEventListener("submit", async function (e) {
        e.preventDefault();
        setMsg("");

        const fd = new FormData(form);
        const payload = Object.fromEntries(fd.entries());
        const pwd = String(payload.password || "").trim();
        if (!isValidPassword(pwd)) {
          setMsg("Password must be at least 12 characters with upper, lower, number, and symbol.", false);
          return;
        }
        if (String(payload.templateIndex || "").trim().toLowerCase() === "manual group selection") {
          payload.manualGroupIds = Array.from(pickedManualGroupIds);
        }

        approveBtn.disabled = true;
        rejectBtn.disabled = true;
        setMsg("User creation in progress...", "pending");

        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/approve", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Failed to create user.");

          const username = (out.user && out.user.username) || out.username || payload.badge || "";
          setMsg(username ? "User created: " + username : "User created.", true);
          form.style.display = "none";
          if (createAgencyForm) createAgencyForm.style.display = "none";
          reviewInfo.textContent = "This request has been reviewed.";
        } catch (err) {
          setMsg(err.message || "Failed to create user.", false);
          approveBtn.disabled = false;
          rejectBtn.disabled = false;
        }
      });

      async function showUserForm(opts) {
        const options = opts && typeof opts === "object" ? opts : {};
        const preferredAgencySuffix = String(options.preferredAgencySuffix || "").trim().toLowerCase();
        const preselectGroupNames = Array.isArray(options.preselectGroupNames)
          ? options.preselectGroupNames.map((n) => String(n || "").trim().toLowerCase()).filter(Boolean)
          : [];

        if (createAgencyForm) createAgencyForm.style.display = "none";
        if (reviewCardTitle) reviewCardTitle.textContent = "Create User (Approve Request)";
        renderApproveNote(reviewRequest);

        form.badge.value = reviewRequest.badgeNumber || "";
        form.firstName.value = reviewRequest.firstName || "";
        form.lastName.value = reviewRequest.lastName || "";
        form.email.value = reviewRequest.email || "";
        form.radioCallsign.value = reviewRequest.radioCallsign || "";

        fillAgencySelect();
        const requestedAgency = String(reviewRequest.agencySuffix || "").trim().toLowerCase();
        const lockedInput = document.getElementById("agencySuffixLocked");

        function selectAgencyValue(desired) {
          const want = String(desired || "").trim().toLowerCase();
          if (!want || want === "__other__") return false;
          const match = Array.from(agencySelect.options).find(
            (o) => String(o.value).toLowerCase() === want
          );
          if (match) {
            agencySelect.value = match.value;
            return true;
          }
          return false;
        }

        if (canChangeAgency) {
          agencySelect.disabled = false;
          agencySelect.removeAttribute("title");
          if (lockedInput) {
            lockedInput.disabled = true;
            lockedInput.value = "";
          }
          const selectedPreferred = selectAgencyValue(preferredAgencySuffix);
          if (!selectedPreferred) {
            if (requestedAgency === "__other__" || !requestedAgency) {
              const opt = document.createElement("option");
              opt.value = "";
              opt.textContent = "Select agency for creation...";
              opt.selected = true;
              agencySelect.insertBefore(opt, agencySelect.firstChild);
            } else {
              selectAgencyValue(requestedAgency);
            }
          }
        } else {
          if (!selectAgencyValue(preferredAgencySuffix)) selectAgencyValue(requestedAgency);
          if (!agencySelect.value && agencySelect.options.length) agencySelect.selectedIndex = 0;
          agencySelect.disabled = true;
          agencySelect.title = "Agency is locked to the requested agency";
          if (lockedInput) {
            lockedInput.disabled = false;
            lockedInput.value = agencySelect.value || requestedAgency;
          }
        }

        pickedManualGroupIds.clear();
        renderGroupsBox();
        await refreshMetaForAgency();

        if (preselectGroupNames.length) {
          const wanted = new Set(preselectGroupNames);
          groupsCache.forEach((g) => {
            if (wanted.has(String(g.name || "").trim().toLowerCase())) {
              pickedManualGroupIds.add(String(g.pk));
            }
          });
          if (pickedManualGroupIds.size) {
            templateSelect.value = "Manual Group Selection";
            templateSelect.dispatchEvent(new Event("change"));
          }
        }

        form.style.display = "";
      }

      async function showCreateAgencyForm() {
        if (!createAgencyForm) {
          showUserForm();
          return;
        }

        const createdAgency = reviewRequest.createdAgency || null;
        if (createdAgency && createdAgency.suffix) {
          const createdSuffix = String(createdAgency.suffix || "").trim().toLowerCase();
          const mainGroupName =
            String(createdAgency.mainGroupName || "").trim() ||
            mainGroupNameForAgency(createdAgency);
          setListMsg("Agency was already created. Continue by creating the user.", true);
          await showUserForm({
            preferredAgencySuffix: createdSuffix,
            preselectGroupNames: mainGroupName ? [mainGroupName] : [],
          });
          return;
        }

        form.style.display = "none";
        if (reviewCardTitle) reviewCardTitle.textContent = "Create Agency";
        const reason = esc(reviewRequest.otherReason || "");
        approveNote.innerHTML =
          "<strong>Requested by:</strong> " +
          esc((reviewRequest.lastName || "") + ", " + (reviewRequest.firstName || "")) +
          "<br>" +
          (reason ? "<strong>Reason for Access:</strong> " + reason : "");

        setFormValue(createAgencyForm, "name", reviewRequest.otherAgency || "");
        setFormValue(createAgencyForm, "groupPrefix", reviewRequest.groupPrefix || "");
        setFormValue(createAgencyForm, "usernameTokenPlacement", reviewRequest.usernameTokenPlacement || "suffix");
        setFormValue(createAgencyForm, "suffix", reviewRequest.suffix || "");
        setFormValue(createAgencyForm, "state", reviewRequest.state || "");
        setFormValue(createAgencyForm, "county", reviewRequest.county || "");
        setFormValue(createAgencyForm, "countyAbbrev", reviewRequest.countyAbbrev || "");
        setFormValue(createAgencyForm, "type", reviewRequest.type || "");
        setFormValue(
          createAgencyForm,
          "stateFederalAgency",
          reviewRequest.stateFederalAgency === true ||
            String(reviewRequest.stateFederalAgency || "").toLowerCase() === "yes" ||
            String(reviewRequest.stateFederalAgency || "").toLowerCase() === "true"
            ? "yes"
            : "no"
        );
        setFormValue(createAgencyForm, "color", "");
        if (typeof window.takSyncStateFederalAgencyFields === "function") {
          const sf = createAgencyForm.querySelector('select[name="stateFederalAgency"]');
          if (sf) window.takSyncStateFederalAgencyFields(sf);
        }

        const placementSelect = createAgencyForm.elements.usernameTokenPlacement;
        const placementLabel = createAgencyForm.querySelector("#reviewCreateAgency_usernameIdentifierLabelText");
        function syncPlacementLabel() {
          if (!placementSelect || !placementLabel) return;
          const isPrefix = String(placementSelect.value || "suffix").toLowerCase() === "prefix";
          placementLabel.textContent = isPrefix ? "Username Prefix" : "Username Suffix";
        }
        if (placementSelect && !placementSelect.dataset.reviewBound) {
          placementSelect.dataset.reviewBound = "1";
          placementSelect.addEventListener("change", syncPlacementLabel);
        }
        syncPlacementLabel();

        createAgencyForm.style.display = "";
      }

      if (skipAgencyBtn) {
        skipAgencyBtn.addEventListener("click", function () {
          setListMsg("Agency creation skipped. Select an existing agency for the user.", true);
          showUserForm().catch((err) => {
            setMsg(err.message || "Failed to load user form", false);
          });
        });
      }

      if (createAgencyForm) {
        createAgencyForm.addEventListener("submit", async function (e) {
          e.preventDefault();
          setAgencyMsg("");

          const fd = new FormData(createAgencyForm);
          const payload = Object.fromEntries(fd.entries());
          const createdSuffix = String(payload.suffix || "").trim().toLowerCase();

          try {
            if (createAgencySubmitBtn) createAgencySubmitBtn.disabled = true;
            if (skipAgencyBtn) skipAgencyBtn.disabled = true;
            if (createAgencyRejectBtn) createAgencyRejectBtn.disabled = true;
            setAgencyMsg("Creating agency…", "pending");

            const res = await fetch("/request-access/" + encodeURIComponent(token) + "/create-agency", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });
            const out = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(out.error || "Failed to create agency");

            await reloadMetaAgencies();

            const linkedAgency = out && out.createdAgency ? out.createdAgency : null;
            const linkedSuffix = String(linkedAgency?.suffix || createdSuffix).trim().toLowerCase();
            const mainGroupName =
              String(linkedAgency?.mainGroupName || "").trim() ||
              (out && out.mainGroup && out.mainGroup.name) ||
              mainGroupNameForAgency({ groupPrefix: payload.groupPrefix });

            if (reviewRequest) reviewRequest.createdAgency = linkedAgency || reviewRequest.createdAgency;
            setListMsg("Agency created. Continue by creating the user.", true);
            await showUserForm({
              preferredAgencySuffix: linkedSuffix,
              preselectGroupNames: mainGroupName ? [mainGroupName] : [],
            });
          } catch (err) {
            setAgencyMsg(err.message || "Failed to create agency", false);
          } finally {
            if (createAgencySubmitBtn) createAgencySubmitBtn.disabled = false;
            if (skipAgencyBtn) skipAgencyBtn.disabled = false;
            if (createAgencyRejectBtn) createAgencyRejectBtn.disabled = false;
          }
        });
      }

      async function init() {
        try {
          const res = await fetch("/request-access/" + encodeURIComponent(token) + "/data");
          const out = await res.json();
          if (!res.ok) throw new Error(out.error || "Request not found.");
          reviewRequest = out.request || null;
          canChangeAgency = !!out.canChangeAgency;
          if (!reviewRequest) throw new Error("Request not found.");

          reviewInfo.textContent = "";
          await reloadMetaAgencies();

          if (canChangeAgency && isOtherRequest(reviewRequest)) {
            await showCreateAgencyForm();
          } else {
            await showUserForm();
          }
        } catch (err) {
          reviewInfo.textContent = err.message || "Request not found.";
          form.style.display = "none";
          if (createAgencyForm) createAgencyForm.style.display = "none";
        }
      }

      init();
    })();
    </script>
    <script>
      try { localStorage.removeItem("tak-portal-theme"); } catch (e) {}
    </script>
    <script src="/theme-toggle.js" defer></script>
  </body>
</html>
