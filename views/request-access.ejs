<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= typeof portalTitle !== "undefined" && portalTitle ? portalTitle : "TAK Portal" %></title>
    <link rel="stylesheet" href="/styles.css" />
    <style>
      .requestAccessContactRow {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }
      @media (max-width: 640px) {
        .requestAccessContactRow {
          grid-template-columns: 1fr;
        }
      }
      #otherWrap {
        display: grid;
        gap: 12px;
      }
      #otherWrap > label {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
    </style>

    <% if (brandLogoUrl) { %>
      <link rel="icon" href="<%= brandLogoUrl %>" type="image/png" />
      <link rel="shortcut icon" href="<%= brandLogoUrl %>" type="image/png" />
    <% } %>
  </head>
  <body
    class="theme-<%= brandTheme || 'dark' %>"
    data-theme-default-only="true"
    <% if (primaryButtonColor || siteFontFamily) { %>
      style="<% if (primaryButtonColor) { %>--btn:<%= primaryButtonColor %>;<% } %><% if (siteFontFamily) { %>--site-font:<%= siteFontFamily %>;<% } %>"
    <% } %>
  >

<button
  id="themeToggle"
  class="theme-toggle"
  type="button"
  title="Toggle theme"
  aria-label="Toggle theme"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    width="1em"
    height="1em"
    fill="currentColor"
    stroke-linecap="round"
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 32 32"
  >
    <clipPath id="theme-toggle__sun__cutout">
      <path d="M0-5h30a1 1 0 0 0 9 13v24H0Z" />
    </clipPath>
    <g clip-path="url(#theme-toggle__sun__cutout)">
      <circle cx="16" cy="16" r="9.34" />
      <g stroke="currentColor" stroke-width="1.5">
        <path d="M16 5.5v-4" />
        <path d="M16 30.5v-4" />
        <path d="M1.5 16h4" />
        <path d="M26.5 16h4" />
        <path d="m23.4 8.6 2.8-2.8" />
        <path d="m5.7 26.3 2.9-2.9" />
        <path d="m5.8 5.8 2.8 2.8" />
        <path d="m23.4 23.4 2.9 2.9" />
      </g>
    </g>
  </svg>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    width="1em"
    height="1em"
    fill="currentColor"
    viewBox="0 0 24 24"
    class="theme-toggle__icon theme-toggle__icon--moon"
  >
    <path d="M21 12.79A9 9 0 0 1 12.21 3 7 7 0 1 0 21 12.79Z" />
  </svg>
</button>

<div class="app">

<main class="main" style="max-width: 980px; margin: 0 auto;">
  <%
    const brandedPortalTitle =
      typeof portalTitle !== "undefined" && portalTitle ? portalTitle : "TAK Portal";
    const usernamePrefixLabel = String((settings && settings.USERNAME_PREFIX_LABEL) || "").trim() || "Badge Number / Username";
  %>
  <h1>Request <%= brandedPortalTitle %> Access</h1>

  <div class="card">
    <p>
      Please use this form to request access to <%= brandedPortalTitle %>. Once submitted, an administrator will review your request. After it has been approved, you will receive an email with instructions on how to access your account.
    </p>

    <% if (typeof error !== "undefined" && error) { %>
      <div class="msg bad" style="margin-bottom: 12px;">
        <% if (showLoginLink) { %>
          An account with this badge number already exists. To login or to reset your password <a href="<%= loginUrl || '/' %>">click here</a>.
        <% } else { %>
          <%= error %>
        <% } %>
      </div>
    <% } %>

    <form method="POST" action="/request-access" class="grid2" autocomplete="off">

      <label>First Name
        <input name="firstName" placeholder="John" required value="<%= (form && form.firstName) ? form.firstName : '' %>" />
      </label>

      <label>Last Name
        <input name="lastName" placeholder="Doe" required value="<%= (form && form.lastName) ? form.lastName : '' %>" />
      </label>

      <div class="requestAccessContactRow">
        <label>Email Address
          <input name="email" type="email" placeholder="example@agency.gov" required value="<%= (form && form.email) ? form.email : '' %>" />
        </label>

        <label><%= usernamePrefixLabel %>
          <input
            name="badgeNumber"
            required
            placeholder="Enter <%= usernamePrefixLabel %>"
            pattern="[A-Za-z0-9._-]+"
            title="Use letters, numbers, periods, dashes, and underscores only."
            value="<%= (form && form.badgeNumber) ? form.badgeNumber : '' %>"
          />
        </label>

        <label>Radio Callsign (optional)
          <input
            name="radioCallsign"
            type="text"
            placeholder="ex. T05 or C10 or B01G"
            autocomplete="off"
            value="<%= (form && form.radioCallsign) ? form.radioCallsign : '' %>"
          />
        </label>
      </div>

      <label style="grid-column: 1 / -1;">Agency
        <select name="agencySuffix" id="agencySelect" required>
          <% 
            const list = Array.isArray(agencies) ? agencies.slice() : [];
            list.sort((a,b) => String(a?.name||'').localeCompare(String(b?.name||'')));
            const selected = (form && form.agencySuffix) ? String(form.agencySuffix) : '';
          %>
          <option value="" disabled <%= !selected ? 'selected' : '' %>>Select Agency</option>
          <% list.forEach(a => { %>
            <option value="<%= a.suffix %>" <%= (selected && selected === a.suffix) ? 'selected' : '' %>>
              <%= a.name %> (<%= a.groupPrefix %>)
            </option>
          <% }) %>
          <option value="__other__" <%= selected === '__other__' ? 'selected' : '' %>>Other / My Agency Isn't Listed</option>
        </select>
      </label>

      <div id="otherWrap" style="grid-column: 1 / -1; display:none;">
        <label>Agency Name
          <input name="otherAgency" id="otherAgency"
            value="<%= (form && form.otherAgency) ? form.otherAgency : '' %>" />
        </label>

        <%- include("partials/agency-create-fields", {
          agencyTypeOptions: typeof agencyTypeOptions !== "undefined" ? agencyTypeOptions : [],
          includeColor: false,
          includeName: false,
          fieldsRequired: false,
          idPrefix: "requestAccess_",
          agencyFieldValues: {
            groupPrefix: (form && form.groupPrefix) ? form.groupPrefix : "",
            usernameTokenPlacement: (form && form.usernameTokenPlacement) ? form.usernameTokenPlacement : "suffix",
            suffix: (form && form.suffix) ? form.suffix : "",
            state: (form && form.state) ? form.state : "",
            county: (form && form.county) ? form.county : "",
            countyAbbrev: (form && form.countyAbbrev) ? form.countyAbbrev : "",
            type: (form && form.type) ? form.type : ""
          }
        }) %>

        <label>Reason for requesting access
          <textarea name="otherReason" id="otherReason"
            rows="4" style="width: 100%; box-sizing: border-box;"><%= (form && form.otherReason) ? form.otherReason : '' %></textarea>
        </label>
      </div>

      <% if (hcaptchaEnabled && hcaptchaSiteKey) { %>
      <div style="grid-column: 1 / -1; margin-top: 10px; display: flex; flex-direction: column; align-items: center;">
        <div id="hcaptchaWidget"></div>
        <div class="msg bad" id="hcaptchaError"
             style="margin-top: 8px; display:none; text-align: center;">
          Please complete the captcha before submitting.
        </div>
      </div>
      <% } %>

      <div style="grid-column: 1 / -1; display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap: wrap;">
        <button class="btn success" id="submitRequestBtn" type="submit">
          Submit Access Request
        </button>
      </div>

    </form>
  </div>
</main>

<script>
(function(){
  const sel = document.getElementById('agencySelect');
  const wrap = document.getElementById('otherWrap');
  const otherAgency = document.getElementById('otherAgency');
  const otherReason = document.getElementById('otherReason');
  const placementSelect = document.getElementById('requestAccess_usernameTokenPlacementSelect');
  const placementLabel = document.getElementById('requestAccess_usernameIdentifierLabelText');

  function syncPlacementLabel() {
    if (!placementSelect || !placementLabel) return;
    const isPrefix = String(placementSelect.value || 'suffix').toLowerCase() === 'prefix';
    placementLabel.textContent = isPrefix ? 'Username Prefix' : 'Username Suffix';
  }

  function setOtherRequired(isOther) {
    if (otherAgency) otherAgency.required = !!isOther;
    if (otherReason) otherReason.required = !!isOther;
    if (!wrap) return;
    const fields = wrap.querySelectorAll('input[name], select[name]');
    fields.forEach((el) => {
      const name = String(el.getAttribute('name') || '');
      if (name === 'otherAgency' || name === 'otherReason' || name === 'usernameTokenPlacement') {
        // usernameTokenPlacement always has a default; otherAgency/otherReason handled above
        return;
      }
      if (name === 'groupPrefix' || name === 'suffix' || name === 'state' ||
          name === 'county' || name === 'countyAbbrev' || name === 'type') {
        el.required = !!isOther;
      }
    });
  }

  function update() {
    const isOther = sel && sel.value === '__other__';
    if (wrap) wrap.style.display = isOther ? 'grid' : 'none';
    setOtherRequired(isOther);
  }

  if (sel) sel.addEventListener('change', update);
  if (placementSelect) placementSelect.addEventListener('change', syncPlacementLabel);
  syncPlacementLabel();
  update();
})();
</script>

<% if (hcaptchaEnabled && hcaptchaSiteKey) { %>
<script>
(function(){
  var form = document.querySelector('form[action="/request-access"]');
  var errorBox = document.getElementById('hcaptchaError');
  var captchaCompleted = false;

  if (!form) return;

  window.hcaptchaOnLoad = function() {
    try {
      hcaptcha.render('hcaptchaWidget', {
        sitekey: "<%= hcaptchaSiteKey %>",
        callback: function() {
          captchaCompleted = true;
          if (errorBox) errorBox.style.display = 'none';
        },
        'expired-callback': function() {
          captchaCompleted = false;
        },
        'error-callback': function() {
          captchaCompleted = false;
        }
      });
    } catch (e) {
      captchaCompleted = false;
    }
  };

  form.addEventListener('submit', function(e) {
    if (!captchaCompleted) {
      e.preventDefault();
      e.stopPropagation();

      if (errorBox) {
        errorBox.style.display = 'block';
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      return false;
    }
  });
})();
</script>

<script src="https://js.hcaptcha.com/1/api.js?onload=hcaptchaOnLoad&render=explicit" async defer></script>
<% } %>

<script>
  // This page always starts from the server-configured default theme on refresh.
  try { localStorage.removeItem("tak-portal-theme"); } catch (e) {}
</script>
<script src="/theme-toggle.js" defer></script>

</div>
</body>
</html>