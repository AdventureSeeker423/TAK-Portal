    <%
      const emailTemplatesList = Array.isArray(
        typeof emailTemplates !== "undefined" ? emailTemplates : []
      )
        ? emailTemplates
        : [];

      // Desired order
      const templateOrder = [
        "user_created_password_set.html",
        "user_created_no_password.html",
        "user_reenabled.html",
        "groups_updated.html",
        "password_changed.html",
        "mutual_aid_created.html",
        "bulk_email.html",
        "mou_document_updated_to_agencies.html",
        "mou_reminder_agency.html",
        "mou_document_signed_to_global_admins.html",
        "mou_document_countersigned.html",
        "mou_external_sign_invite.html",
        "mou_external_signed_copy.html"
      ];

      const friendlyNames = {
        "user_created_password_set.html": "User Created (with Password)",
        "user_created_no_password.html": "User Created (without Password)",
        "user_reenabled.html": "User Re-Enabled (existing password)",
        "groups_updated.html": "Groups Updated",
        "password_changed.html": "Password Changed by Admin",
        "mutual_aid_created.html": "Mutual Aid",
        "bulk_email.html": "Bulk Email",
        "mou_document_updated_to_agencies.html": "MOU Updated To Agency Admins",
        "mou_reminder_agency.html": "MOU Agency Reminder",
        "mou_document_signed_to_global_admins.html": "MOU Signed (to Global Admins)",
        "mou_document_countersigned.html": "MOU Countersigned",
        "mou_external_sign_invite.html": "MOU External Sign Invite",
        "mou_external_signed_copy.html": "MOU External Signed Copy"
      };

      function templateSortIndex(filename) {
        const idx = templateOrder.indexOf(filename);
        return idx === -1 ? templateOrder.length : idx;
      }

      const orderedEmailTemplates = emailTemplatesList
        .slice()
        .sort(function (a, b) {
          return templateSortIndex(a.filename) - templateSortIndex(b.filename);
        });
    %>
    <% if (orderedEmailTemplates.length) { %>
    <!-- Email Templates -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-email-templates" data-settings-modal="email-templates" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-email-templates">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-email-templates">Email Templates</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Edit HTML bodies for system notification emails. Overrides are stored separately from /email_templates.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
<div style="margin-top:.75rem;display:flex;gap:.5rem;flex-wrap:wrap;">
              <button
                type="submit"
                class="btn"
                name="_resetAllEmailTemplates"
                value="1"
                onclick="return confirm('Reset ALL email templates to the built-in defaults from /email_templates? This will discard every custom template override.');"
              >
                Reset All to Default
              </button>
            </div>

            <script>
              window.EMAIL_TEMPLATE_DEFAULTS = {};
              window.EMAIL_TEMPLATE_CURRENT = {};
              <% orderedEmailTemplates.forEach(function (tpl) { %>
              window.EMAIL_TEMPLATE_DEFAULTS["<%= tpl.idSafe %>"] = <%- JSON.stringify((tpl.defaultHtml != null && tpl.defaultHtml !== undefined) ? tpl.defaultHtml : "") %>;
              window.EMAIL_TEMPLATE_CURRENT["<%= tpl.idSafe %>"] = <%- JSON.stringify((tpl.html != null && tpl.html !== undefined) ? tpl.html : "") %>;
              <% }); %>
            </script>

            <% orderedEmailTemplates.forEach(function (tpl) { %>
              <details
                class="email-template-item"
                data-template-id="<%= tpl.idSafe %>"
                style="margin-top:1rem;border:1px solid #e5e7eb;border-radius:0.5rem;padding:0.5rem 0.75rem;"
              >
                <summary
                  style="display:flex;align-items:center;justify-content:space-between;cursor:pointer;list-style:none;"
                >
                  <span class="settings-label">
                    <%= friendlyNames[tpl.filename] || tpl.filename %>
                  </span>

                  <span
                    class="email-template-badge"
                    data-badge="<%= tpl.idSafe %>"
                    style="<%= tpl.overridden ? 'background:#2563eb;color:#fff;' : 'background:#e5e7eb;color:#374151;' %>padding:0.1rem 0.4rem;border-radius:999px;font-size:0.75rem;"
                  >
                    <%= tpl.overridden ? "Custom" : "Default" %>
                  </span>
                </summary>

                <div style="margin-top:0.75rem;">
                  <textarea
                    id="email-template-<%= tpl.idSafe %>"
                    name="settings[EMAIL_TEMPLATES_OVERRIDES][<%= tpl.filename %>]"
                    class="email-template-editor"
                    rows="30"
                    style="width:100%;min-height:450px;font-family:monospace;font-size:.85rem;white-space:pre;overflow:auto;"
                  ></textarea>

                  <input
                    type="hidden"
                    name="settings[EMAIL_TEMPLATES_OVERRIDES_RESET][<%= tpl.filename %>]"
                    value="0"
                    data-reset-flag="<%= tpl.idSafe %>"
                  />

                  <small
                    class="settings-help"
                    data-reset-note="<%= tpl.idSafe %>"
                    style="display:none;"
                  >
                    This template will be reset to the built-in default when you save using the button at the bottom of the page.
                  </small>

                  <div style="margin-top:.75rem;display:flex;gap:.5rem;flex-wrap:wrap;">
                    <button
                      type="submit"
                      class="btn"
                      name="_saveTemplate"
                      value="<%= tpl.filename %>"
                    >
                      Save Custom Template
                    </button>

                    <button
                      type="button"
                      class="btn"
                      data-reset-template="<%= tpl.idSafe %>"
                    >
                      Reset to Default
                    </button>
                  </div>
                </div>
              </details>
            <% }); %>
          
        </div>
      </div>
    </div>
    <% } %>

<div id="sms-settings" hidden aria-hidden="true"></div>
    <!-- SMS -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-sms" data-settings-modal="sms" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-sms">
