<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main settings-page">
  <h1>Settings</h1>
  <div id="settingsAutoSaveStatus" class="muted settings-autosave-status" aria-live="polite"></div>

<% if (importStatus) { %>
  <div class="alert success" style="margin-top: 12px;">
    Configuration imported successfully. Your data folder has been restored from the uploaded zip.
  </div>
<% } %>
<% if (importError) { %>
  <div class="alert error" style="margin-top: 12px;">
    Import failed: <%= importError %>
  </div>
<% } %>
<% if (typeof smsTest !== 'undefined' && smsTest === 'ok') { %>
  <div class="alert success" style="margin-top: 12px;">
    Test SMS sent successfully.
  </div>
<% } %>
<% if (typeof smsTest !== 'undefined' && smsTest === 'fail' && smsErr) { %>
  <div class="alert error" style="margin-top: 12px;">
    SMS test failed: <%= smsErr %>
  </div>
<% } %>


  <div class="settings-hub" id="settingsHub">
    <div class="settings-hub-search">
      <label class="settings-hub-search-label" for="settingsHubSearch">Search settings</label>
      <input
        type="search"
        id="settingsHubSearch"
        class="settings-hub-search-input"
        placeholder="Search settings…"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div id="settingsSearchResults" class="settings-search-results" hidden></div>
    <p id="settingsHubSearchEmpty" class="settings-hub-search-empty" hidden>No settings match your search.</p>
    <div id="settingsHubCategories">

    <section class="settings-hub-category" aria-labelledby="settingsCatAuth">
      <h2 class="settings-hub-category-title" id="settingsCatAuth">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Authentication
      </h2>
      <div class="settings-hub-grid">
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="authentik">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Authentik</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="portal-access">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Portal Access Control</span></span>
        </div>
      </div>
    </section>

    <section class="settings-hub-category" aria-labelledby="settingsCatTak">
      <h2 class="settings-hub-category-title" id="settingsCatTak">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        TAK Server
      </h2>
      <div class="settings-hub-grid">
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="tak-server">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Connection &amp; Certificates</span></span>
        </div>
        <% if (typeof takSshMaintenanceVisible !== "undefined" && takSshMaintenanceVisible) { %>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="tak-maintenance">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Maintenance</span></span>
        </div>
        <% } %>
      </div>
    </section>

    <section class="settings-hub-category" aria-labelledby="settingsCatMsg">
      <h2 class="settings-hub-category-title" id="settingsCatMsg">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16v12H5.17L4 17.17V4z"/><path d="M8 8h8M8 12h5"/></svg>
        Messaging
      </h2>
      <div class="settings-hub-grid">
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="email">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Email</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="sms">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">SMS</span></span>
        </div>
        <% if (typeof emailTemplates !== "undefined" && Array.isArray(emailTemplates) && emailTemplates.length) { %>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="email-templates">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Email Templates</span></span>
        </div>
        <% } %>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="mou">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">MOU</span></span>
        </div>
      </div>
    </section>

    <section class="settings-hub-category" aria-labelledby="settingsCatAppear">
      <h2 class="settings-hub-category-title" id="settingsCatAppear">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Configuration
      </h2>
      <div class="settings-hub-grid">
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="branding">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Branding &amp; Appearance</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="callsign">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Callsign Format</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="live-map">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Live Map</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="bookmarks">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Dashboard Bookmarks</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="auto-create-groups">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Auto Create Groups / Channels</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="auto-create-data-sync">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Auto Create Data Sync Missions</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="allowed-client-devices">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Supported TAK Clients</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="request-access">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Request Access Page</span></span>
        </div>
      </div>
    </section>

    <%
      const _settingsPerm = typeof perm === "function" ? perm : function () { return false; };
      const canSeeSettingsAdminLinks =
        _settingsPerm("page.audit_log") ||
        _settingsPerm("page.plugin_manager") ||
        _settingsPerm("page.access_control");
    %>
    <% if (canSeeSettingsAdminLinks) { %>
    <section class="settings-hub-category" aria-labelledby="settingsCatAdmin">
      <h2 class="settings-hub-category-title" id="settingsCatAdmin">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Administration
      </h2>
      <div class="settings-hub-grid">
        <% if (_settingsPerm("page.audit_log")) { %>
        <a href="/audit-log" class="settings-hub-card">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Audit Log</span></span>
        </a>
        <% } %>
        <% if (_settingsPerm("page.plugin_manager")) { %>
        <a href="/plugin-manager" class="settings-hub-card">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Plugin Manager</span></span>
        </a>
        <% } %>
        <% if (_settingsPerm("page.access_control")) { %>
        <a href="/access-control" class="settings-hub-card">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Access Control</span></span>
        </a>
        <% } %>
      </div>
    </section>
    <% } %>

    <section class="settings-hub-category" aria-labelledby="settingsCatRef">
      <h2 class="settings-hub-category-title" id="settingsCatRef">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        Reference Data
      </h2>
      <div class="settings-hub-grid">
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="agency-types">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Agency Types</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="regions">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Regions</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="deployment-packet-colors">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Deployment Packet Colors / Teams</span></span>
        </div>
        <div class="settings-hub-card" role="button" tabindex="0" data-open-settings-modal="deployment-packet-roles">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Deployment Packet Roles</span></span>
        </div>
      </div>
    </section>

    <section class="settings-hub-category" aria-labelledby="settingsCatBackup">
      <h2 class="settings-hub-category-title" id="settingsCatBackup">
        <svg class="settings-hub-category-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Backup &amp; Restore
      </h2>
      <div class="settings-hub-grid">
        <a href="/settings/export-data" class="settings-hub-card">
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Export Configuration</span></span>
        </a>
        <div class="settings-hub-card" role="button" tabindex="0" data-import-config>
          <span class="settings-hub-card-main"><span class="settings-hub-card-title">Import Configuration</span></span>
        </div>
      </div>
    </section>
    </div>
  </div>

  <form id="settingsForm" method="post" action="/settings" autocomplete="off" enctype="multipart/form-data">
    <%
      const BOOL_KEYS = new Set([
        "TAK_REVOKE_ON_DISABLE",
        "TAK_DEBUG",
        "TAK_BYPASS_ENABLED",
        "SHOW_ITAK_LINKS",
        "ALLOWED_CLIENT_TAK_AWARE",
        "ALLOWED_CLIENT_TAK_TRACKER",
        "ALLOWED_CLIENT_ATAK",
        "ALLOWED_CLIENT_LIVE_MAP",
        "ALLOWED_CLIENT_CLOUDTAK",
        "ALLOWED_CLIENT_DATA_PACKAGE",
        "EMAIL_ENABLED",
        "EMAIL_GROUP_CHANGES_ENABLED",
        "SMTP_SECURE",
        "EMAIL_FAIL_HARD",
        "PORTAL_AUTH_ENABLED",
        "REQUEST_ACCESS_ENABLED",
        "REQUEST_ACCESS_REQUIRE_ALL_AGENCY_DETAILS",
        "BETA_MODE",
        "LIVE_MAP_ENABLED",
        "MOU_ENABLED",
        "MOU_SEND_EMAILS",
        "AUTO_CREATE_AGENCY_GROUPS_ENABLED",
        "AUTO_CREATE_COUNTY_GROUPS_ENABLED",
        "AUTO_CREATE_REGION_GROUPS_ENABLED",
        "AUTO_CREATE_STATE_GROUPS_ENABLED",
        "AUTO_CREATE_AGENCY_DATA_SYNC_ENABLED",
        "AUTO_CREATE_COUNTY_DATA_SYNC_ENABLED",
        "AUTO_CREATE_STATE_DATA_SYNC_ENABLED"
      ]);
      function renderHelpTip(helpText) {
        if (!helpText) return;
    %>
        <span class="settings-help-tip">
          <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
          <span class="settings-help-popover" role="tooltip"><%= helpText %></span>
        </span>
    <%
      }

      function renderField(key, label, helpText, defaultValue) {
        if (BOOL_KEYS.has(key)) {
          const rawVal = (settings && typeof settings[key] === "string")
            ? settings[key].toLowerCase()
            : "";
          const defaultBool =
            defaultValue === "true" || defaultValue === "false"
              ? defaultValue
              : "false";
          const currentVal =
            rawVal === "true" ? "true" :
            rawVal === "false" ? "false" :
            defaultBool;
          const isOn = currentVal === "true";
    %>
      <div class="settings-field settings-field-bool">
        <span class="settings-label">
          <span><%= label || key %></span>
          <% renderHelpTip(helpText); %>
        </span>
        <button
          type="button"
          class="settings-toggle <%= isOn ? 'is-on' : 'is-off' %>"
          data-settings-bool-toggle
          aria-pressed="<%= isOn ? 'true' : 'false' %>"
          aria-label="<%= label || key %>"
        ></button>
        <input
          type="hidden"
          name="settings[<%= key %>]"
          value="<%= isOn ? 'true' : 'false' %>"
          data-settings-bool-input
        />
      </div>
    <%
          return;
        }
    %>
      <label class="settings-field">
        <span class="settings-label">
          <span><%= label || key %></span>
          <% renderHelpTip(helpText); %>
        </span>
        <%
          const resolvedVal = (typeof settings[key] === 'string')
            ? settings[key]
            : (typeof defaultValue === 'string' ? defaultValue : '');
        %>
        <input
          type="text"
          name="settings[<%= key %>]"
          value="<%= resolvedVal %>"
        />
      </label>
    <% } %>

    <%
      // Build known keys list so bookmarks can scale without changing
      // the underlying settings.json format (flat BOOKMARKn_TITLE/URL keys).
      const bookmarkKeys = [];
      for (let i = 1; i <= 20; i++) {
        bookmarkKeys.push(`BOOKMARK${i}_TITLE`, `BOOKMARK${i}_URL`);
      }

      const additionalAgencyTypeKeys = ["AGENCY_TYPES_CUSTOMIZED"];
      for (let i = 1; i <= 30; i++) {
        additionalAgencyTypeKeys.push(`ADDITIONAL_AGENCY_TYPE_${i}`);
      }

      const autoCreateGroupKeys = [
        "AUTO_CREATE_AGENCY_GROUPS_ENABLED",
        "AUTO_CREATE_COUNTY_GROUPS_ENABLED",
        "AUTO_CREATE_REGION_GROUPS_ENABLED",
        "AUTO_CREATE_STATE_GROUPS_ENABLED",
        "AUTO_CREATE_AGENCY_DATA_SYNC_ENABLED",
        "AUTO_CREATE_COUNTY_DATA_SYNC_ENABLED",
        "AUTO_CREATE_STATE_DATA_SYNC_ENABLED",
        "AUTO_CREATE_AGENCY_DATA_SYNC_TITLE",
        "AUTO_CREATE_COUNTY_DATA_SYNC_TITLE",
        "AUTO_CREATE_STATE_DATA_SYNC_TITLE",
        "AUTO_CREATE_AGENCY_DATA_SYNC_GROUP_INDEX",
        "AUTO_CREATE_COUNTY_DATA_SYNC_GROUP_INDEX",
        "AUTO_CREATE_STATE_DATA_SYNC_GROUP_INDEX",
      ];
      for (let i = 1; i <= 3; i++) {
        autoCreateGroupKeys.push(
          `AUTO_CREATE_AGENCY_GROUP_TITLE_${i}`,
          `AUTO_CREATE_COUNTY_GROUP_TITLE_${i}`,
          `AUTO_CREATE_REGION_GROUP_TITLE_${i}`,
          `AUTO_CREATE_STATE_GROUP_TITLE_${i}`
        );
      }

      const knownKeys = new Set([
        "AUTHENTIK_URL",
        "AUTHENTIK_TOKEN",
        "USERS_HIDDEN_PREFIXES",
        "GROUPS_HIDDEN_PREFIXES",
        "USERS_ACTIONS_HIDDEN_PREFIXES",
        "GROUPS_ACTIONS_HIDDEN_PREFIXES",
        "DASHBOARD_AUTHENTIK_STATS_REFRESH_SECONDS",
        "DASHBOARD_TAK_STATS_REFRESH_SECONDS",

        "TAK_URL",
        "TAK_API_P12_PATH",
        "TAK_API_P12_PASSPHRASE",
        "TAK_CA_PATH",
        "TAK_REVOKE_ON_DISABLE",
        "TAK_DEBUG",
        "TAK_BYPASS_ENABLED",
        "CLOUDTAK_URL",
        "SHOW_ITAK_LINKS",
        "ALLOWED_CLIENT_TAK_AWARE",
        "ALLOWED_CLIENT_TAK_TRACKER",
        "ALLOWED_CLIENT_ATAK",
        "ALLOWED_CLIENT_LIVE_MAP",
        "ALLOWED_CLIENT_CLOUDTAK",
        "ALLOWED_CLIENT_DATA_PACKAGE",
        "ALLOWED_CLIENT_RECOMMENDED_IOS",
        "ALLOWED_CLIENT_RECOMMENDED_ANDROID",
        "ALLOWED_CLIENT_RECOMMENDED_WEB",
        "ALLOWED_CLIENT_RECOMMENDED_PC",
        "ALLOWED_CLIENT_ORDER_IOS",
        "ALLOWED_CLIENT_ORDER_ANDROID",
        "ALLOWED_CLIENT_ORDER_WEB",
        "ALLOWED_CLIENT_ORDER_PC",
        "TAK_SSH_HOST",
        "TAK_SSH_PORT",
        "TAK_SSH_USER",
        "TAK_SSH_PRIVATE_KEY_PATH",
        "TAK_SSH_PUBLIC_KEY_PATH",
        "TAK_SSH_PASSPHRASE",
        "TAK_SSH_ONBOARDED",
        "TAK_SSH_LAST_HANDSHAKE_AT",

        "PORTAL_AUTH_ENABLED",
        "PORTAL_AUTH_REQUIRED_GROUP",
        "AUTHENTIK_PUBLIC_URL",
        "TAK_PORTAL_PUBLIC_URL",

        "EMAIL_ENABLED",
        "EMAIL_GROUP_CHANGES_ENABLED",
        "EMAIL_PROVIDER",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_FROM",
        "EMAIL_ALWAYS_CC",
        "EMAIL_SEND_COPY_TO",
        "EMAIL_FAIL_HARD",
        "MOU_ENABLED",
        "MOU_SEND_EMAILS",
        "MOU_DEFAULT_REMINDER_DAYS",
        "MOU_HTML_MAX_KB",
        "MOU_REMINDER_SWEEP_HOURS",
        "REQUEST_ACCESS_ENABLED",
        "REQUEST_ACCESS_REQUIRE_ALL_AGENCY_DETAILS",
        "BETA_MODE",
        "DEFAULT_THEME_MODE",
        "LIVE_MAP_ENABLED",
        "DEFAULT_MAP_SOURCE",
        "OPENADDRESSES_TOKEN",
        "PRIMARY_BUTTON_COLOR",
        "SITE_FONT_FAMILY",
        "USERNAME_PREFIX_LABEL",

        "SMS_PROVIDER",
        "SMS_TWILIO_ACCOUNT_SID",
        "SMS_TWILIO_AUTH_TOKEN",
        "SMS_TWILIO_FROM",
        "SMS_BREVO_API_KEY",
        "SMS_BREVO_SENDER",
        "SMS_TEST_TO",

        ...bookmarkKeys,
        ...additionalAgencyTypeKeys,
        ...autoCreateGroupKeys,

        "BRAND_THEME",
        "SERVER_NAME",
        "BRAND_LOGO_URL",

        "CALLSIGN_FORMAT_EXPRESSION"
      ]);

      const otherKeys = keys.filter(k => !knownKeys.has(k));
    %>

    <!-- Authentik -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-authentik" data-settings-modal="authentik" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-authentik">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-authentik">Authentik</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Authentik connection, API token, and visibility / action-lock prefixes.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          <div class="grid2">
            <% renderField("AUTHENTIK_URL","Authentik Internal URL","Base URL of your Authentik instance (e.g. http://authentik:9000)"); %>
            <label class="settings-field">
              <span class="settings-label">
                <span>Authentik API Token</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">API token with permission to manage users and groups.</span>
                </span>
              </span>

              <div class="passwordWrap">
                <input
                  id="authentikTokenInput"
                  type="password"
                  name="settings[AUTHENTIK_TOKEN]"
                  value="<%= settings.AUTHENTIK_TOKEN || '' %>"
                  autocomplete="new-password"
                />

                <button
                  type="button"
                  id="authentikTokenToggle"
                  class="passwordToggle"
                  aria-label="Show token"
                  title="Show token"
                >
                  👁
                </button>
              </div>
            </label>
            <% renderField("USERS_HIDDEN_PREFIXES","Hidden User Prefixes","Comma-separated prefixes of usernames to hide from the UI."); %>
            <% renderField("GROUPS_HIDDEN_PREFIXES","Hidden Group Prefixes","Comma-separated prefixes of groups to hide from the UI."); %>
            <% renderField("USERS_ACTIONS_HIDDEN_PREFIXES","User Action-Lock Prefixes","Users whose name starts with these prefixes cannot be modified from the portal."); %>
            <% renderField("GROUPS_ACTIONS_HIDDEN_PREFIXES","Group Action-Lock Prefixes","Groups whose name starts with these prefixes cannot be modified from the portal."); %>
            <% renderField("DASHBOARD_AUTHENTIK_STATS_REFRESH_SECONDS","Dashboard Authentik Stats Refresh (seconds)","How often the server refreshes cached Authentik dashboard stats in the background. Server restart required for changes to take effect."); %>
          </div>
        
        </div>
      </div>
    </div>

    <!-- Connection &amp; Certificates -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-tak-server" data-settings-modal="tak-server" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-tak-server">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-tak-server">Connection &amp; Certificates</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
