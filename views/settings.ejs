    <script>
      (function () {
        var sel = document.getElementById("smsProviderSelect");
        var tw = document.getElementById("smsTwilioFields");
        var br = document.getElementById("smsBrevoFields");
        function syncSmsPanels() {
          var v = sel && sel.value ? sel.value : "disabled";
          if (tw) tw.style.display = v === "twilio" ? "block" : "none";
          if (br) br.style.display = v === "brevo" ? "block" : "none";
        }
        if (sel) sel.addEventListener("change", syncSmsPanels);
        syncSmsPanels();
        var brevoBtn = document.getElementById("smsBrevoDeliveryBtn");
        if (brevoBtn) {
          brevoBtn.addEventListener("click", function () {
            window.open("https://app.brevo.com/", "_blank", "noopener,noreferrer");
          });
        }
        if (window.location.hash === "#sms-settings" && typeof window.openSettingsModal === "function") {
          window.openSettingsModal("sms");
        }
      })();
    </script>

