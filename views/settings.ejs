    .cert-status.missing {
      background: #fee2e2;
      color: #991b1b;
    }

    .passwordWrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .passwordWrap input {
      width: 100%;
      padding-right: 2.5rem;
    }

    .passwordToggle {
      position: absolute;
      right: 8px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      padding: 0;
      filter: invert(1);
    }

    .branding-color-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .reset-default-btn {
      color: #fff;
    }

    body.theme-light .passwordToggle {
      filter: none;
    }
  </style>
