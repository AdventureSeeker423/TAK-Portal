            <h2 id="settingsModalTitle-live-map">Live Map</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Enable or disable the Live Map page, set the default basemap, and optionally download OpenAddresses collections for self-hosted address search.</span>
            </span>
          </div>
