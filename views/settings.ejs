            <div class="settings-auto-create-section" data-acds-type="state">
              <div class="settings-auto-create-header">
                <h3>State Specific Data Sync</h3>
                <button type="button" class="settings-toggle is-off" data-acds-toggle aria-pressed="false" aria-label="Toggle state data sync"></button>
              </div>
              <p class="settings-help" data-acds-hint style="display:none;margin:.35rem 0 0;">To use this feature, you must enable auto creation for groups / channels.</p>
              <div class="settings-auto-create-body" data-acds-body>
                <div class="grid2">
                  <label class="settings-field">
                    <span class="settings-label"><span>Mission Title</span></span>
                    <input type="text" data-acds-title placeholder="Active Incident" />
                  </label>
                  <label class="settings-field">
                    <span class="settings-label"><span>Link to Auto Create Group / Channel</span></span>
                    <select data-acds-group></select>
                  </label>
                </div>
              </div>
            </div>

            <div id="autoCreateDataSyncHiddenFields"></div>
          </div>

          <script>
            (function () {
              var form = document.getElementById('settingsForm');
              var editor = document.getElementById('autoCreateDataSyncEditor');
              var hiddenHost = document.getElementById('autoCreateDataSyncHiddenFields');
              if (!form || !editor || !hiddenHost) return;

              var initial = <%- JSON.stringify(autoCreateDataSyncInitial) %>;
              var groupsFallback = <%- JSON.stringify(autoCreateGroupsFallback) %>;
              var prefixes = {
                agency: 'AUTO_CREATE_AGENCY',
                county: 'AUTO_CREATE_COUNTY',
                state: 'AUTO_CREATE_STATE'
              };

              function sectionEl(type) {
                return editor.querySelector('[data-acds-type="' + type + '"]');
              }

              function setToggle(btn, on) {
                btn.classList.toggle('is-on', !!on);
                btn.classList.toggle('is-off', !on);
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
              }

              function isOn(btn) {
                return btn.classList.contains('is-on');
              }

              function getGroupsConfig() {
                if (typeof window.__getAutoCreateGroupsLiveConfig === 'function') {
                  try {
                    return window.__getAutoCreateGroupsLiveConfig() || groupsFallback;
                  } catch (_) {}
                }
                return groupsFallback;
              }

              function updateSectionAvailability(type) {
                var section = sectionEl(type);
                if (!section) return;
                var groupsCfg = getGroupsConfig()[type] || { enabled: false, titles: [] };
                var groupsOn = !!groupsCfg.enabled;
                var toggle = section.querySelector('[data-acds-toggle]');
                var body = section.querySelector('[data-acds-body]');
                var hint = section.querySelector('[data-acds-hint]');
                var titleInput = section.querySelector('[data-acds-title]');
                var groupSelect = section.querySelector('[data-acds-group]');

                section.classList.toggle('is-disabled', !groupsOn);
                if (toggle) {
                  toggle.disabled = !groupsOn;
                  if (!groupsOn) setToggle(toggle, false);
                }
                if (hint) hint.style.display = groupsOn ? 'none' : '';
                if (titleInput) titleInput.disabled = !groupsOn;
                if (groupSelect) groupSelect.disabled = !groupsOn;
                // Collapse body when groups scope is off, or when DS toggle is off.
                if (body) {
                  body.style.display = groupsOn && isOn(toggle) ? '' : 'none';
                }

                // Rebuild select options from group titles
                if (groupSelect) {
                  var prev = String(groupSelect.value || '');
                  var savedIndex = String((initial[type] && initial[type].groupIndex) || 1);
                  groupSelect.innerHTML = '';
                  var titles = Array.isArray(groupsCfg.titles) ? groupsCfg.titles : [];
                  if (!titles.length) {
                    var opt = document.createElement('option');
                    opt.value = '1';
                    opt.textContent = '(No group titles configured)';
                    groupSelect.appendChild(opt);
                  } else {
                    titles.forEach(function (item) {
                      var o = document.createElement('option');
                      o.value = String(item.index);
                      o.textContent = item.title;
                      groupSelect.appendChild(o);
                    });
                    var prefer = prev || savedIndex;
                    var has = [].some.call(groupSelect.options, function (o) { return o.value === prefer; });
                    groupSelect.value = has ? prefer : String(titles[0].index);
                  }
                }
              }

              function refreshAll() {
                ['agency', 'county', 'state'].forEach(updateSectionAvailability);
              }

              window.__refreshAutoCreateDataSyncGroupOptions = refreshAll;

              function initSection(type) {
                var section = sectionEl(type);
                if (!section) return;
                var conf = initial[type] || {};
                var toggle = section.querySelector('[data-acds-toggle]');
                var titleInput = section.querySelector('[data-acds-title]');
                var groupSelect = section.querySelector('[data-acds-group]');

                setToggle(toggle, !!conf.enabled);
                if (titleInput) titleInput.value = conf.title || 'Active Incident';

                toggle.addEventListener('click', function () {
                  if (toggle.disabled) return;
                  setToggle(toggle, !isOn(toggle));
                  updateSectionAvailability(type);
                  if (typeof window.scheduleSettingsAutoSave === 'function') {
                    window.scheduleSettingsAutoSave();
                  }
                });

                if (titleInput) {
                  titleInput.addEventListener('input', function () {
                    if (typeof window.scheduleSettingsAutoSave === 'function') {
                      window.scheduleSettingsAutoSave();
                    }
                  });
                }
                if (groupSelect) {
                  groupSelect.addEventListener('change', function () {
                    initial[type] = initial[type] || {};
                    initial[type].groupIndex = parseInt(groupSelect.value, 10) || 1;
                    if (typeof window.scheduleSettingsAutoSave === 'function') {
                      window.scheduleSettingsAutoSave();
                    }
                  });
                }

                updateSectionAvailability(type);
              }

              ['agency', 'county', 'state'].forEach(initSection);
              refreshAll();

              function serializeAutoCreateDataSync() {
                hiddenHost.innerHTML = '';
                var groupsCfg = getGroupsConfig();

                ['agency', 'county', 'state'].forEach(function (type) {
                  var section = sectionEl(type);
                  if (!section) return;
                  var prefix = prefixes[type];
                  var groupsOn = !!(groupsCfg[type] && groupsCfg[type].enabled);
                  var enabled = groupsOn && isOn(section.querySelector('[data-acds-toggle]'));
                  var title = String((section.querySelector('[data-acds-title]') || {}).value || '').trim() || 'Active Incident';
                  var groupIndex = String((section.querySelector('[data-acds-group]') || {}).value || '1');
                  if (!/^[123]$/.test(groupIndex)) groupIndex = '1';

                  var en = document.createElement('input');
                  en.type = 'hidden';
                  en.name = 'settings[' + prefix + '_DATA_SYNC_ENABLED]';
                  en.value = enabled ? 'true' : 'false';
                  hiddenHost.appendChild(en);

                  var t = document.createElement('input');
                  t.type = 'hidden';
                  t.name = 'settings[' + prefix + '_DATA_SYNC_TITLE]';
                  t.value = title;
                  hiddenHost.appendChild(t);

                  var g = document.createElement('input');
                  g.type = 'hidden';
                  g.name = 'settings[' + prefix + '_DATA_SYNC_GROUP_INDEX]';
                  g.value = groupIndex;
                  hiddenHost.appendChild(g);
                });
              }

              window.__settingsSerializeHooks = window.__settingsSerializeHooks || [];
              window.__settingsSerializeHooks.push(serializeAutoCreateDataSync);
              form.addEventListener('submit', serializeAutoCreateDataSync);

              // Refresh options whenever this modal is opened
              var modal = document.getElementById('settingsModal-auto-create-data-sync');
              if (modal && typeof MutationObserver !== 'undefined') {
                var obs = new MutationObserver(function () {
                  if (modal.style.display !== 'none' && modal.getAttribute('aria-hidden') !== 'true') {
                    refreshAll();
                  }
                });
                obs.observe(modal, { attributes: true, attributeFilter: ['style', 'aria-hidden'] });
              }
            })();
          </script>
        </div>
      </div>
    </div>

    <!-- Supported TAK Clients -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-allowed-client-devices" data-settings-modal="allowed-client-devices" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-allowed-client-devices">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-allowed-client-devices">Supported TAK Clients</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover" role="tooltip">Choose which TAK client apps appear on Setup My Device. Platforms with no enabled apps are hidden from users. For ATAK, you can optionally upload an APK so Setup My Device offers a direct download instead of the Play Store.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          <%
            const cloudtakUrlExisting = String((settings && settings.CLOUDTAK_URL) || "").trim();
            const cloudtakDefaultOn = cloudtakUrlExisting ? "true" : "false";
            const cloudtakRaw = String((settings && settings.ALLOWED_CLIENT_CLOUDTAK) || "").trim().toLowerCase();
            const cloudtakIsOn =
              cloudtakRaw === "true" ? true :
              cloudtakRaw === "false" ? false :
              cloudtakDefaultOn === "true";
            const liveMapEnabledRaw = String((settings && settings.LIVE_MAP_ENABLED) || "").trim().toLowerCase();
            const liveMapGloballyEnabled =
              liveMapEnabledRaw === "false" ||
              liveMapEnabledRaw === "0" ||
              liveMapEnabledRaw === "off" ||
              liveMapEnabledRaw === "no"
                ? false
                : true;

            function recommendedFor(section, defaultApp) {
              const key =
                section === "ios" ? "ALLOWED_CLIENT_RECOMMENDED_IOS" :
                section === "android" ? "ALLOWED_CLIENT_RECOMMENDED_ANDROID" :
                section === "pc" ? "ALLOWED_CLIENT_RECOMMENDED_PC" :
                "ALLOWED_CLIENT_RECOMMENDED_WEB";
              if (settings && Object.prototype.hasOwnProperty.call(settings, key)) {
                return String(settings[key] || "").trim();
              }
              return defaultApp || "";
            }
            const recommendedIos = recommendedFor("ios", "tak_aware");
            const recommendedAndroid = recommendedFor("android", "");
            const recommendedWeb = recommendedFor("web", "");
            const recommendedPc = recommendedFor("pc", "");
            const sshPrivilegedReadyForClients =
              typeof sshPrivilegedReady !== "undefined" ? !!sshPrivilegedReady : false;

            function parseClientOrder(key, defaults, insertMissingAtStart) {
              const known = defaults.slice();
              const knownSet = new Set(known);
              const raw = (settings && typeof settings[key] === "string")
                ? settings[key]
                : "";
              const parsed = String(raw)
                .split(",")
                .map((s) => s.trim())
                .filter((id) => id && knownSet.has(id));
              const missing = known.filter((id) => !parsed.includes(id));
              return insertMissingAtStart ? missing.concat(parsed) : parsed.concat(missing);
            }
            const iosAppDefs = {
              tak_aware: { key: "ALLOWED_CLIENT_TAK_AWARE", label: "TAK Aware", defaultOn: "true" },
              tak_tracker: { key: "ALLOWED_CLIENT_TAK_TRACKER", label: "TAK Tracker", defaultOn: "true" },
              itak: { key: "SHOW_ITAK_LINKS", label: "iTAK", defaultOn: "false" },
            };
            const androidAppDefs = {
              atak: { key: "ALLOWED_CLIENT_ATAK", label: "ATAK", defaultOn: "true" },
            };
            const webAppDefs = {
              live_map: { key: "ALLOWED_CLIENT_LIVE_MAP", label: "TAK Portal Live Map", defaultOn: "true" },
              cloudtak: { key: "ALLOWED_CLIENT_CLOUDTAK", label: "CloudTAK", defaultOn: cloudtakDefaultOn },
            };
            const iosOrder = parseClientOrder("ALLOWED_CLIENT_ORDER_IOS", ["tak_aware", "tak_tracker", "itak"]);
            const androidOrder = parseClientOrder("ALLOWED_CLIENT_ORDER_ANDROID", ["atak"]);
            const webOrder = parseClientOrder("ALLOWED_CLIENT_ORDER_WEB", ["live_map", "cloudtak"], true);

            function renderAllowedClientApp(opts) {
              const key = opts.key;
              const label = opts.label;
              const section = opts.section;
              const appId = opts.appId;
              const defaultOn = opts.defaultOn;
              const recommended = opts.recommended;
              const showCloudtakUrl = !!opts.showCloudtakUrl;
              const showAtakApkUpload = !!opts.showAtakApkUpload;
              const locked = !!opts.locked;
              const requiresLiveMap = !!opts.requiresLiveMap;
              const rawVal = (settings && typeof settings[key] === "string")
                ? settings[key].toLowerCase()
                : "";
              const currentVal =
                rawVal === "true" ? "true" :
                rawVal === "false" ? "false" :
                defaultOn;
              const isOn = locked ? false : currentVal === "true";
              const isRecommended = recommended === appId;
              const atakApkInfo =
                typeof atakApk !== "undefined" && atakApk && typeof atakApk === "object"
                  ? atakApk
                  : { uploaded: false, originalName: null };
              const unavailable = requiresLiveMap && !liveMapGloballyEnabled;
          %>
            <div
              class="settings-allowed-client-item<%= locked ? ' is-disabled' : '' %><%= unavailable ? ' is-unavailable' : '' %>"
              data-allowed-client-item
              data-allowed-client-section="<%= section %>"
              data-allowed-client-app="<%= appId %>"
              <% if (locked) { %>data-allowed-client-locked="1"<% } %>
              <% if (requiresLiveMap) { %>data-allowed-client-requires-live-map="1" aria-hidden="<%= unavailable ? 'true' : 'false' %>"<% } %>
              draggable="true"
            >
              <div class="settings-field settings-field-bool settings-allowed-client-row">
                <span class="settings-allowed-client-grip" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
                <button
                  type="button"
                  class="settings-recommend-star <%= isRecommended ? 'is-filled' : 'is-empty' %>"
                  data-allowed-client-star
                  aria-pressed="<%= isRecommended ? 'true' : 'false' %>"
                  aria-label="<%= isRecommended ? 'Remove recommendation for ' + label : 'Recommend ' + label %>"
                  title="<%= isRecommended ? 'Recommended (click to clear)' : 'Mark as recommended' %>"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                  </svg>
                </button>
                <span class="settings-label">
                  <span><%= label %></span>
                  <% if (showAtakApkUpload) { %>
                    <span class="settings-atak-apk-actions" data-atak-apk-actions>
                      <input
                        type="file"
                        id="atakApkUploadInput"
                        accept=".apk,application/vnd.android.package-archive"
                        style="display:none;"
                        tabindex="-1"
                      />
                      <button type="button" class="btn settings-atak-apk-btn" data-atak-apk-upload>
                        <%= atakApkInfo.uploaded ? "Replace APK" : "Upload APK" %>
                      </button>
                      <button
                        type="button"
                        class="btn settings-atak-apk-btn"
                        data-atak-apk-remove
                        style="<%= atakApkInfo.uploaded ? '' : 'display:none;' %>"
                      >
                        Remove APK
                      </button>
                      <span
                        class="settings-help settings-atak-apk-name"
                        data-atak-apk-name
                        style="<%= atakApkInfo.uploaded ? '' : 'display:none;' %>"
                        title="<%= atakApkInfo.originalName || '' %>"
                      ><%= atakApkInfo.originalName || "" %></span>
                      <span
                        class="settings-atak-apk-status"
                        data-atak-apk-status
                        style="display:none;"
                        aria-live="polite"
                      ></span>
                    </span>
                  <% } %>
                </span>
                <button
                  type="button"
                  class="settings-toggle <%= isOn ? 'is-on' : 'is-off' %>"
                  data-settings-bool-toggle
                  aria-pressed="<%= isOn ? 'true' : 'false' %>"
                  aria-label="<%= label %>"
                  <% if (locked) { %>disabled<% } %>
                ></button>
                <input
                  type="hidden"
                  name="settings[<%= key %>]"
                  value="<%= isOn ? 'true' : 'false' %>"
                  data-settings-bool-input
                />
              </div>
              <% if (showCloudtakUrl) { %>
                <div id="allowedClientCloudtakUrlFields" style="margin-top:0.75rem;display:<%= cloudtakIsOn ? 'block' : 'none' %>;">
                  <% renderField("CLOUDTAK_URL","CloudTAK URL",null); %>
                </div>
              <% } %>
            </div>
          <%
            }
          %>

          <h3 class="settings-allowed-client-platform">iOS</h3>
          <div class="settings-auto-create-section" data-allowed-client-section-group="ios">
            <% iosOrder.forEach(function (appId) {
              const def = iosAppDefs[appId];
              if (!def) return;
              renderAllowedClientApp({
                key: def.key,
                label: def.label,
                section: "ios",
                appId: appId,
                defaultOn: def.defaultOn,
                recommended: recommendedIos,
              });
            }); %>
            <input type="hidden" name="settings[ALLOWED_CLIENT_RECOMMENDED_IOS]" value="<%= recommendedIos %>" data-allowed-client-recommended-input="ios" />
            <input type="hidden" name="settings[ALLOWED_CLIENT_ORDER_IOS]" value="<%= iosOrder.join(',') %>" data-allowed-client-order-input="ios" />
          </div>

          <h3 class="settings-allowed-client-platform">Android</h3>
          <div class="settings-auto-create-section" data-allowed-client-section-group="android">
            <% androidOrder.forEach(function (appId) {
              const def = androidAppDefs[appId];
              if (!def) return;
              renderAllowedClientApp({
                key: def.key,
                label: def.label,
                section: "android",
                appId: appId,
                defaultOn: def.defaultOn,
                recommended: recommendedAndroid,
                showAtakApkUpload: appId === "atak",
              });
            }); %>
            <input type="hidden" name="settings[ALLOWED_CLIENT_RECOMMENDED_ANDROID]" value="<%= recommendedAndroid %>" data-allowed-client-recommended-input="android" />
            <input type="hidden" name="settings[ALLOWED_CLIENT_ORDER_ANDROID]" value="<%= androidOrder.join(',') %>" data-allowed-client-order-input="android" />
          </div>

          <h3 class="settings-allowed-client-platform">Web Browser</h3>
          <div class="settings-auto-create-section" data-allowed-client-section-group="web">
            <% webOrder.forEach(function (appId) {
              const def = webAppDefs[appId];
              if (!def) return;
              renderAllowedClientApp({
                key: def.key,
                label: def.label,
                section: "web",
                appId: appId,
                defaultOn: def.defaultOn,
                recommended: recommendedWeb,
                showCloudtakUrl: appId === "cloudtak",
                requiresLiveMap: appId === "live_map",
              });
            }); %>
            <input type="hidden" name="settings[ALLOWED_CLIENT_RECOMMENDED_WEB]" value="<%= recommendedWeb %>" data-allowed-client-recommended-input="web" />
            <input type="hidden" name="settings[ALLOWED_CLIENT_ORDER_WEB]" value="<%= webOrder.join(',') %>" data-allowed-client-order-input="web" />
          </div>

          <h3 class="settings-allowed-client-platform">PC</h3>
          <div class="settings-auto-create-section" data-allowed-client-section-group="pc">
            <%
              const pcAppDefs = {
                data_package: { key: "ALLOWED_CLIENT_DATA_PACKAGE", label: "Data Package", defaultOn: "false" },
              };
              const pcOrder = parseClientOrder("ALLOWED_CLIENT_ORDER_PC", ["data_package"]);
              pcOrder.forEach(function (appId) {
                const def = pcAppDefs[appId];
                if (!def) return;
                renderAllowedClientApp({
                  key: def.key,
                  label: def.label,
                  section: "pc",
                  appId: appId,
                  defaultOn: def.defaultOn,
                  recommended: recommendedPc,
                  locked: appId === "data_package" && !sshPrivilegedReadyForClients,
                });
              });
            %>
            <% if (!sshPrivilegedReadyForClients) { %>
              <p class="settings-help" style="margin:0.5rem 0 0;">Complete SSH Generate Key + Handshake under Connection &amp; Certificates with an account that can sudo before enabling Data Package.</p>
            <% } %>
            <input type="hidden" name="settings[ALLOWED_CLIENT_RECOMMENDED_PC]" value="<%= recommendedPc %>" data-allowed-client-recommended-input="pc" />
            <input type="hidden" name="settings[ALLOWED_CLIENT_ORDER_PC]" value="<%= pcOrder.join(',') %>" data-allowed-client-order-input="pc" />
          </div>

          <script>
            (function () {
              var modal = document.getElementById("settingsModal-allowed-client-devices");
              if (!modal) return;
              var urlFields = document.getElementById("allowedClientCloudtakUrlFields");

              function syncCloudtakUrlVisibility() {
                urlFields = document.getElementById("allowedClientCloudtakUrlFields");
                if (!urlFields) return;
                var toggle = null;
                var fields = modal.querySelectorAll(".settings-field-bool");
                for (var i = 0; i < fields.length; i++) {
                  var input = fields[i].querySelector('input[name="settings[ALLOWED_CLIENT_CLOUDTAK]"]');
                  if (input) {
                    toggle = fields[i].querySelector("[data-settings-bool-toggle]");
                    break;
                  }
                }
                var on = toggle && toggle.classList.contains("is-on");
                urlFields.style.display = on ? "block" : "none";
              }

              function isLiveMapGloballyEnabled() {
                var input = document.querySelector('input[name="settings[LIVE_MAP_ENABLED]"]');
                if (!input) return true;
                return String(input.value || "").trim().toLowerCase() === "true";
              }

              function syncLiveMapClientVisibility() {
                var item = modal.querySelector("[data-allowed-client-requires-live-map]");
                if (!item) return;
                var enabled = isLiveMapGloballyEnabled();
                item.classList.toggle("is-unavailable", !enabled);
                item.setAttribute("aria-hidden", enabled ? "false" : "true");
                if (!enabled) {
                  var recInput = modal.querySelector('[data-allowed-client-recommended-input="web"]');
                  var star = item.querySelector("[data-allowed-client-star]");
                  if (recInput && recInput.value === "live_map") {
                    recInput.value = "";
                    setStarState(star, false);
                  }
                }
              }

              function setStarState(btn, filled) {
                if (!btn) return;
                btn.classList.toggle("is-filled", !!filled);
                btn.classList.toggle("is-empty", !filled);
                btn.setAttribute("aria-pressed", filled ? "true" : "false");
                var row = btn.closest("[data-allowed-client-app]");
                var label = row ? (row.querySelector(".settings-label span") || {}).textContent || "app" : "app";
                btn.setAttribute(
                  "aria-label",
                  filled ? ("Remove recommendation for " + label) : ("Recommend " + label)
                );
                btn.title = filled ? "Recommended (click to clear)" : "Mark as recommended";
              }

              function syncSectionOrder(section) {
                var group = modal.querySelector('[data-allowed-client-section-group="' + section + '"]');
                var hidden = modal.querySelector('[data-allowed-client-order-input="' + section + '"]');
                if (!group || !hidden) return;
                var ids = [].slice.call(group.querySelectorAll("[data-allowed-client-item]")).map(function (el) {
                  return el.getAttribute("data-allowed-client-app");
                }).filter(Boolean);
                hidden.value = ids.join(",");
              }

              function getDragAfterElement(container, y) {
                var els = [].slice.call(container.querySelectorAll("[data-allowed-client-item]:not(.dragging)")).filter(function (el) {
                  return !el.classList.contains("is-unavailable");
                });
                return els.reduce(function (closest, child) {
                  var box = child.getBoundingClientRect();
                  var offset = y - box.top - box.height / 2;
                  if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                  }
                  return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
              }

              modal.querySelectorAll("[data-allowed-client-item]").forEach(function (item) {
                item.addEventListener("dragstart", function (e) {
                  if (item.classList.contains("is-unavailable")) {
                    e.preventDefault();
                    return;
                  }
                  if (e.target && e.target.closest && (
                    e.target.closest("[data-allowed-client-star]") ||
                    e.target.closest("[data-settings-bool-toggle]") ||
                    e.target.closest("[data-atak-apk-actions]") ||
                    e.target.closest("input") ||
                    e.target.closest("label.settings-field")
                  )) {
                    e.preventDefault();
                    return;
                  }
                  item.classList.add("dragging");
                  if (e.dataTransfer) e.dataTransfer.effectAllowed = "move";
                });
                item.addEventListener("dragend", function () {
                  item.classList.remove("dragging");
                  var section = item.getAttribute("data-allowed-client-section");
                  if (section) syncSectionOrder(section);
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                });
              });

              modal.querySelectorAll("[data-allowed-client-section-group]").forEach(function (group) {
                group.addEventListener("dragover", function (e) {
                  e.preventDefault();
                  var dragging = group.querySelector("[data-allowed-client-item].dragging");
                  if (!dragging) return;
                  var after = getDragAfterElement(group, e.clientY);
                  var anchor =
                    group.querySelector("[data-allowed-client-recommended-input]") ||
                    group.querySelector("[data-allowed-client-order-input]");
                  if (after == null) {
                    if (anchor) group.insertBefore(dragging, anchor);
                    else group.appendChild(dragging);
                  } else {
                    group.insertBefore(dragging, after);
                  }
                });
              });

              modal.addEventListener("click", function (e) {
                var star = e.target && e.target.closest && e.target.closest("[data-allowed-client-star]");
                if (star) {
                  e.preventDefault();
                  var row = star.closest("[data-allowed-client-app]");
                  if (!row) return;
                  var section = row.getAttribute("data-allowed-client-section");
                  var appId = row.getAttribute("data-allowed-client-app");
                  var group = modal.querySelector('[data-allowed-client-section-group="' + section + '"]');
                  var hidden = modal.querySelector('[data-allowed-client-recommended-input="' + section + '"]');
                  var currentlyFilled = star.classList.contains("is-filled");
                  var nextValue = currentlyFilled ? "" : appId;

                  if (group) {
                    group.querySelectorAll("[data-allowed-client-star]").forEach(function (btn) {
                      setStarState(btn, false);
                    });
                  }
                  if (!currentlyFilled) setStarState(star, true);
                  if (hidden) hidden.value = nextValue;
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                  return;
                }

                if (e.target && e.target.closest && e.target.closest("[data-settings-bool-toggle]")) {
                  setTimeout(syncCloudtakUrlVisibility, 0);
                }
              });

              (function setupAtakApkActions() {
                var actions = modal.querySelector("[data-atak-apk-actions]");
                if (!actions) return;
                var fileInput = document.getElementById("atakApkUploadInput");
                var uploadBtn = actions.querySelector("[data-atak-apk-upload]");
                var removeBtn = actions.querySelector("[data-atak-apk-remove]");
                var nameEl = actions.querySelector("[data-atak-apk-name]");
                var statusEl = actions.querySelector("[data-atak-apk-status]");
                var busy = false;
                var lastUploaded = !!(nameEl && nameEl.style.display !== "none" && nameEl.textContent);

                function setStatus(text) {
                  if (!statusEl) return;
                  var msg = String(text || "").trim();
                  statusEl.textContent = msg;
                  statusEl.style.display = msg ? "" : "none";
                }

                function setBusy(next, statusText) {
                  busy = !!next;
                  actions.classList.toggle("is-busy", busy);
                  if (uploadBtn) uploadBtn.disabled = busy;
                  if (removeBtn) removeBtn.disabled = busy;
                  if (busy) {
                    setStatus(statusText || "Working…");
                  } else {
                    setStatus("");
                  }
                }

                function applyInfo(info) {
                  var uploaded = !!(info && info.uploaded);
                  var originalName = (info && info.originalName) || "";
                  lastUploaded = uploaded;
                  if (uploadBtn) {
                    uploadBtn.textContent = uploaded ? "Replace APK" : "Upload APK";
                  }
                  if (removeBtn) {
                    removeBtn.style.display = uploaded ? "" : "none";
                  }
                  if (nameEl) {
                    nameEl.textContent = originalName;
                    nameEl.title = originalName;
                    nameEl.style.display = uploaded ? "" : "none";
                  }
                }

                function parseJsonSafe(raw) {
                  try {
                    return JSON.parse(raw);
                  } catch (_) {
                    return null;
                  }
                }

                if (uploadBtn && fileInput) {
                  uploadBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (busy) return;
                    fileInput.click();
                  });
                  fileInput.addEventListener("change", function () {
                    if (!fileInput.files || !fileInput.files.length) return;
                    var file = fileInput.files[0];
                    var lower = String(file.name || "").toLowerCase();
                    if (!lower.endsWith(".apk")) {
                      alert("Please select an .apk file.");
                      fileInput.value = "";
                      return;
                    }

                    setBusy(true, "Uploading… 0%");
                    if (uploadBtn) uploadBtn.textContent = "Uploading…";
                    if (nameEl) {
                      nameEl.textContent = file.name;
                      nameEl.title = file.name;
                      nameEl.style.display = "";
                    }

                    var fd = new FormData();
                    fd.append("apk", file);
                    var xhr = new XMLHttpRequest();
                    xhr.open("POST", "/api/settings/atak-apk/upload");
                    xhr.withCredentials = true;
                    xhr.setRequestHeader("X-Requested-With", "XMLHttpRequest");
                    xhr.setRequestHeader("Accept", "application/json");

                    xhr.upload.onprogress = function (evt) {
                      if (!evt.lengthComputable || !evt.total) {
                        setStatus("Uploading…");
                        return;
                      }
                      var pct = Math.max(0, Math.min(100, Math.round((evt.loaded / evt.total) * 100)));
                      setStatus("Uploading… " + pct + "%");
                      if (uploadBtn) uploadBtn.textContent = "Uploading… " + pct + "%";
                    };

                    xhr.upload.onload = function () {
                      setStatus("Saving…");
                      if (uploadBtn) uploadBtn.textContent = "Saving…";
                    };

                    xhr.onerror = function () {
                      fileInput.value = "";
                      setBusy(false);
                      if (uploadBtn) {
                        uploadBtn.textContent = lastUploaded ? "Replace APK" : "Upload APK";
                      }
                      if (!lastUploaded && nameEl) {
                        nameEl.textContent = "";
                        nameEl.title = "";
                        nameEl.style.display = "none";
                      }
                      alert("Upload failed.");
                    };

                    xhr.onload = function () {
                      var body = parseJsonSafe(xhr.responseText);
                      fileInput.value = "";
                      setBusy(false);
                      if (xhr.status < 200 || xhr.status >= 300 || !body || !body.ok) {
                        if (uploadBtn) {
                          uploadBtn.textContent = lastUploaded ? "Replace APK" : "Upload APK";
                        }
                        if (!lastUploaded && nameEl) {
                          nameEl.textContent = "";
                          nameEl.title = "";
                          nameEl.style.display = "none";
                        }
                        alert((body && body.error) || "Upload failed.");
                        return;
                      }
                      applyInfo(body);
                    };

                    xhr.send(fd);
                  });
                }

                if (removeBtn) {
                  removeBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (busy) return;
                    if (!confirm("Remove the hosted ATAK APK? Setup My Device will use the Play Store link again.")) {
                      return;
                    }
                    setBusy(true, "Removing…");
                    if (removeBtn) removeBtn.textContent = "Removing…";
                    fetch("/api/settings/atak-apk", {
                      method: "DELETE",
                      credentials: "same-origin",
                      headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        Accept: "application/json",
                      },
                    })
                      .then(function (res) {
                        return res.json().then(function (body) {
                          return { ok: res.ok, body: body };
                        });
                      })
                      .then(function (result) {
                        if (!result.ok || !result.body || !result.body.ok) {
                          throw new Error(
                            (result.body && result.body.error) || "Remove failed."
                          );
                        }
                        applyInfo(result.body);
                      })
                      .catch(function (err) {
                        alert(err && err.message ? err.message : "Remove failed.");
                      })
                      .finally(function () {
                        if (removeBtn) removeBtn.textContent = "Remove APK";
                        setBusy(false);
                      });
                  });
                }
              })();

              document.addEventListener("click", function (e) {
                var btn = e.target && e.target.closest && e.target.closest("[data-settings-bool-toggle]");
                if (!btn) return;
                var field = btn.closest(".settings-field");
                var input = field && field.querySelector('input[name="settings[LIVE_MAP_ENABLED]"]');
                if (!input) return;
                setTimeout(syncLiveMapClientVisibility, 0);
              });

              syncCloudtakUrlVisibility();
              syncLiveMapClientVisibility();
            })();
          </script>
        </div>
      </div>
    </div>

