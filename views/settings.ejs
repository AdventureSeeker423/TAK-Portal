                    if (t) out.push({ index: i, title: t });
                  }
                  if (!out.length) out.push({ index: 1, title: "Main" });
                  return out;
                })(),
              },
              county: {
                enabled: autoCreateEnabled("AUTO_CREATE_COUNTY_GROUPS_ENABLED", false),
                titles: (function () {
                  const out = [];
                  for (let i = 1; i <= 3; i++) {
                    const t = String(settings[`AUTO_CREATE_COUNTY_GROUP_TITLE_${i}`] || "").trim();
                    if (t) out.push({ index: i, title: t });
                  }
                  if (!out.length) out.push({ index: 1, title: "Interop" });
                  return out;
                })(),
              },
              state: {
                enabled: autoCreateEnabled("AUTO_CREATE_STATE_GROUPS_ENABLED", false),
                titles: (function () {
                  const out = [];
                  for (let i = 1; i <= 3; i++) {
                    const t = String(settings[`AUTO_CREATE_STATE_GROUP_TITLE_${i}`] || "").trim();
                    if (t) out.push({ index: i, title: t });
                  }
                  if (!out.length) out.push({ index: 1, title: "Interop" });
                  return out;
                })(),
              },
            };
          %>

