  <script>
    (function () {
      var root = document.querySelector(".email-templates-section") || document;
      var defaults = window.EMAIL_TEMPLATE_DEFAULTS || {};
      var currents = window.EMAIL_TEMPLATE_CURRENT || {};

      // Fill editors from JSON so HTML entities are not decoded by the page parser
      // (putting raw HTML inside <textarea>...</textarea> would flip Default → Custom).
      Object.keys(currents).forEach(function (key) {
        var textarea = document.getElementById("email-template-" + key);
        if (textarea) textarea.value = currents[key] || "";
      });

      // Email template reset buttons: load default into textarea, set reset flag, update badge
      var resetButtons = root.querySelectorAll("[data-reset-template]");
      resetButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var key = btn.getAttribute("data-reset-template");
          if (!key) return;

          var textarea = document.getElementById("email-template-" + key);
          if (textarea && defaults[key] !== undefined) {
            textarea.value = defaults[key];
          }

          var flag = root.querySelector('[data-reset-flag="' + key + '"]');
          if (flag) flag.value = "1";

          var note = root.querySelector('[data-reset-note="' + key + '"]');
          if (note) note.style.display = "inline";

          var badge = root.querySelector('.email-template-badge[data-badge="' + key + '"]');
          if (badge) {
            badge.textContent = "Default";
            badge.style.background = "#e5e7eb";
            badge.style.color = "#374151";
          }
        });
      });

      // Import Configuration (restore data from zip) — hub card triggers file picker
      var importInput = document.getElementById("configZipInput");
      var importForm = document.getElementById("importConfigForm");

      function openImportPicker() {
        if (importInput) importInput.click();
      }

      document.addEventListener("click", function (e) {
        var card = e.target.closest && e.target.closest("[data-import-config]");
        if (!card) return;
        e.preventDefault();
        openImportPicker();
      });

      document.addEventListener("keydown", function (e) {
        if (e.key !== "Enter" && e.key !== " ") return;
        var card = e.target.closest && e.target.closest("[data-import-config]");
        if (!card) return;
        e.preventDefault();
        openImportPicker();
      });

      if (importInput && importForm) {
        importInput.addEventListener("change", function () {
          if (!importInput.files || !importInput.files.length) return;

          var fileName = importInput.files[0].name || "selected file";

          var ok = window.confirm(
            "Importing a configuration will OVERWRITE files in the data folder with the contents of the zip.\n\nContinue?"
          );
          if (!ok) {
            importInput.value = "";
            return;
          }

          var ok2 = window.confirm("Import '" + fileName + "' and overwrite existing configuration files?");
          if (!ok2) {
            importInput.value = "";
            return;
          }

          importForm.submit();
        });
      }
    })();
  </script>

  <script>
  function wirePasswordToggle(inputId, toggleId) {
    const input = document.getElementById(inputId);
    const toggle = document.getElementById(toggleId);
    if (!input || !toggle) return;

    toggle.addEventListener("click", () => {
      const hidden = input.type === "password";
      input.type = hidden ? "text" : "password";
      toggle.setAttribute("aria-label", hidden ? "Hide value" : "Show value");
      toggle.title = hidden ? "Hide value" : "Show value";
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    wirePasswordToggle("authentikTokenInput", "authentikTokenToggle");
    wirePasswordToggle("p12PassphraseInput", "p12PassphraseToggle");
    wirePasswordToggle("sshPasswordInput", "sshPasswordToggle");
    wirePasswordToggle("oaTokenInput", "oaTokenToggle");

    document.addEventListener("click", function (e) {
      var btn = e.target && e.target.closest
        ? e.target.closest("[data-settings-bool-toggle]")
        : null;
      if (!btn) return;
      if (btn.disabled || btn.getAttribute("aria-disabled") === "true" || btn.closest("[data-allowed-client-locked]")) return;
      var field = btn.closest(".settings-field");
      var input = field
        ? field.querySelector("[data-settings-bool-input]")
        : null;
      if (!input) return;
      var on = !btn.classList.contains("is-on");
      btn.classList.toggle("is-on", on);
      btn.classList.toggle("is-off", !on);
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      input.value = on ? "true" : "false";
      if (typeof window.scheduleSettingsAutoSave === "function") {
        window.scheduleSettingsAutoSave();
      }
    });

    const statusBox = document.getElementById("sshStatusBox");
    const hostInput = document.getElementById("sshHostInput");
    const portInput = document.getElementById("sshPortInput");
    const userInput = document.getElementById("sshUserInput");
    const passInput = document.getElementById("sshPasswordInput");
    const btnSetup = document.getElementById("sshSetupBtn");
    const btnTestOnly = document.getElementById("sshTestOnlyBtn");
    var lastSshTestPassed = null;

    function setStatus(msg, isError) {
      if (!statusBox) return;
      statusBox.textContent = msg || "";
      statusBox.style.color = isError ? "#dc2626" : isError === false && lastSshTestPassed ? "#15803d" : "";
    }

    function formatSshTestSuccess(data) {
      var remoteUser = String((data && data.remoteUser) || "").trim();
      var lines = [
        "SSH test passed.",
        "  • Key login (whoami): OK" + (remoteUser ? " — remote user \"" + remoteUser + "\"" : ""),
        "  • Privileged access (read CoreConfig.xml): OK",
      ];
      if (data && data.sudoSetup === "sudoers") {
        lines.push("  • Sudo: passwordless (sudoers configured)");
      } else if (data && data.sudoSetup === "password") {
        lines.push("  • Sudo: using stored password for privileged commands");
      }
      return lines.join("\n");
    }

    async function getStatus() {
      const res = await fetch("/api/ssh/status");
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || "Failed to load SSH status.");
      const s = data.status || {};
      setStatus(
        "Host: " + (s.host || "(not set)") +
        " | User: " + (s.username || "(not set)") +
        " | Port: " + (s.port || "22") +
        " | Keypair: " + (s.hasKeyPair ? "present" : "missing") +
        " | Setup: " + (s.onboarded ? "complete" : "not run yet") +
        (s.sudoersConfigured ? " | Sudo: passwordless" : "") +
        (lastSshTestPassed === true ? " | Last test: passed" : lastSshTestPassed === false ? " | Last test: failed" : "") +
        (s.lastHandshakeAt ? " | Last setup: " + s.lastHandshakeAt : ""),
        false
      );
    }

    async function postJson(url, body) {
      const res = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body || {}),
      });
      const data = await res.json();
      if (!res.ok || data.ok === false) {
        throw new Error(data.error || data.message || "Request failed.");
      }
      return data;
    }

    if (btnSetup) {
      btnSetup.addEventListener("click", async function () {
        const host = (hostInput && hostInput.value || "").trim();
        const port = (portInput && portInput.value || "22").trim();
        const username = (userInput && userInput.value || "").trim();
        const password = (passInput && passInput.value || "");
        if (!host || !username || !password) {
          setStatus("Host, username, and password are required for SSH setup.", true);
          return;
        }
        try {
          btnSetup.disabled = true;
          setStatus(
            "Running full SSH setup: generate key, install on server, configure sudo, and test…",
            false
          );
          const data = await postJson("/api/ssh/setup", { host, port, username, password });
          if (passInput) passInput.value = "";
          lastSshTestPassed = !!data.testPassed;
          setStatus(formatSshTestSuccess(data), false);
        } catch (err) {
          lastSshTestPassed = false;
          setStatus("SSH setup failed: " + (err.message || String(err)), true);
        } finally {
          btnSetup.disabled = false;
        }
      });
    }

    if (btnTestOnly) {
      btnTestOnly.addEventListener("click", async function () {
        try {
          btnTestOnly.disabled = true;
          setStatus("Testing SSH login and privileged access (CoreConfig read)…", false);
          const data = await postJson("/api/ssh/test-connection", {});
          lastSshTestPassed = !!data.testPassed;
          setStatus(formatSshTestSuccess(data), false);
        } catch (err) {
          lastSshTestPassed = false;
          setStatus("SSH test failed: " + (err.message || String(err)), true);
        } finally {
          btnTestOnly.disabled = false;
        }
      });
    }

    getStatus().catch(function () {});
  });
  </script>

  <script>
    (function () {
      var form = document.getElementById("settingsForm");
      if (!form) return;

      var statusEl = document.getElementById("settingsAutoSaveStatus");
      // Coalesce rapid toggles/typing; shorter than before so power-through feels snappy.
      var debounceMs = 350;
      var timer = null;
      var saveInFlight = false;
      var dirty = false;
      var saveGen = 0;
      var abortController = null;
      var catchUpTimer = null;
      var suppressUnloadWarning = false;

      function setStatus(text, isError) {
        if (!statusEl) return;
        statusEl.textContent = text || "";
        statusEl.style.color = isError ? "#dc2626" : "";
      }

      function isEditorField(el) {
        if (!el) return false;
        return !!(
          el.closest &&
          (el.closest("#bookmarkEditor") ||
            el.closest("#additionalAgencyTypeEditor") ||
            el.closest("#callsignBuilder"))
        );
      }

      function shouldAutoSaveFrom(el) {
        if (!el) return false;
        // Named settings fields (skip live email template editors — saved explicitly)
        if (el.name) {
          var n = String(el.name);
          if (
            n.indexOf("EMAIL_TEMPLATES_OVERRIDES") !== -1 &&
            n.indexOf("EMAIL_TEMPLATES_OVERRIDES_RESET") === -1
          ) {
            return false;
          }
          return true;
        }
        return isEditorField(el);
      }

      function isIntentionalFullSubmit(submitter) {
        if (!submitter) return false;
        var name = submitter.getAttribute("name") || "";
        if (
          name === "_saveTemplate" ||
          name === "_resetAllEmailTemplates" ||
          name === "_testEmail" ||
          name === "_testSms"
        ) {
          return true;
        }
        var fa = submitter.getAttribute("formaction") || "";
        return fa.indexOf("/settings/test-") !== -1;
      }

      function serializeEditors() {
        var hooks = window.__settingsSerializeHooks || [];
        hooks.forEach(function (fn) {
          try {
            if (typeof fn === "function") fn();
          } catch (err) {
            console.error("Settings serialize hook failed:", err);
          }
        });
      }

      function buildAutoSaveFormData() {
        serializeEditors();
        var fd = new FormData(form);
        // Never persist template textarea bodies on autosave (same as server rule).
        Array.from(fd.keys()).forEach(function (key) {
          if (
            key.indexOf("EMAIL_TEMPLATES_OVERRIDES") !== -1 &&
            key.indexOf("EMAIL_TEMPLATES_OVERRIDES_RESET") === -1
          ) {
            fd.delete(key);
          }
        });

        // Keep selected uploads, but remove the empty File objects generated by
        // unselected file inputs so ordinary settings saves stay lightweight.
        var uploadedFiles = [];
        Array.from(fd.entries()).forEach(function (entry) {
          if (typeof File !== "undefined" && entry[1] instanceof File) {
            if (!entry[1].name || entry[1].size === 0) {
              fd.delete(entry[0]);
              return;
            }
            var input = form.querySelector(
              'input[type="file"][name="' + entry[0] + '"]'
            );
            uploadedFiles.push({
              input: input,
              file:
                input && input.files && input.files.length
                  ? input.files[0]
                  : entry[1],
            });
          }
        });
        return {
          formData: fd,
          uploadedFiles: uploadedFiles,
        };
      }

      function isAbortError(err) {
        if (!err) return false;
        if (err.name === "AbortError") return true;
        return String(err.message || "").toLowerCase().indexOf("aborted") !== -1;
      }

      function queueCatchUp() {
        if (catchUpTimer) clearTimeout(catchUpTimer);
        catchUpTimer = setTimeout(function () {
          catchUpTimer = null;
          flushAutoSave();
        }, 0);
      }

      function flushAutoSave() {
        if (saveInFlight) {
          dirty = true;
          return;
        }
        if (!dirty) return;

        dirty = false;
        saveInFlight = true;
        var myGen = ++saveGen;
        abortController = typeof AbortController !== "undefined" ? new AbortController() : null;
        var signal = abortController ? abortController.signal : undefined;

        var action = form.getAttribute("action") || "/settings";
        var payload;
        try {
          payload = buildAutoSaveFormData();
        } catch (err) {
          saveInFlight = false;
          abortController = null;
          setStatus(
            "Auto-save failed: " + (err && err.message ? err.message : String(err)),
            true
          );
          if (dirty) queueCatchUp();
          return;
        }

        if (payload.uploadedFiles.length > 0) {
          setStatus("Uploading…", false);
        }

        fetch(action, {
          method: "POST",
          body: payload.formData,
          headers: {
            Accept: "application/json",
            "X-Requested-With": "XMLHttpRequest",
          },
          credentials: "same-origin",
          signal: signal,
        })
          .then(function (res) {
            return res.text().then(function (text) {
              var j = null;
              try {
                j = text ? JSON.parse(text) : null;
              } catch (_) {}
              if (!res.ok || !j || j.ok !== true) {
                throw new Error(
                  (j && j.error) || text.slice(0, 200) || res.statusText || "Save failed"
                );
              }
            });
          })
          .then(function () {
            if (myGen !== saveGen) return;
            payload.uploadedFiles.forEach(function (upload) {
              // Do not clear a newer file selected while this request was running.
              if (
                upload.input &&
                upload.input.files &&
                upload.input.files[0] === upload.file
              ) {
                upload.input.value = "";
              }
            });
            setStatus("", false);
          })
          .catch(function (err) {
            if (isAbortError(err)) return;
            if (myGen !== saveGen) return;
            setStatus(
              "Auto-save failed: " + (err && err.message ? err.message : String(err)),
              true
            );
          })
          .finally(function () {
            if (myGen !== saveGen) return;
            saveInFlight = false;
            abortController = null;
            if (dirty) {
              queueCatchUp();
            }
          });
      }

      /**
       * Mark settings dirty and debounce a save. Rapid toggles reset the timer
       * so one POST leaves with the latest form state after a short quiet window.
       * If a save is already in flight, the next flush runs immediately when it finishes.
       */
      function scheduleAutoSave() {
        dirty = true;
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () {
          timer = null;
          flushAutoSave();
        }, debounceMs);
      }

      window.scheduleSettingsAutoSave = scheduleAutoSave;

      function clearAutoSavePendingState() {
        if (timer) {
          clearTimeout(timer);
          timer = null;
        }
        if (catchUpTimer) {
          clearTimeout(catchUpTimer);
          catchUpTimer = null;
        }
        dirty = false;
      }

      // Block accidental full-page posts (e.g. Enter in a field). Allow explicit actions.
      form.addEventListener(
        "submit",
        function (e) {
          if (isIntentionalFullSubmit(e.submitter)) {
            clearAutoSavePendingState();
            if (abortController) {
              try {
                abortController.abort();
              } catch (_) {}
            }
            // Form POST saves email/SMS test values; skip "leave page" warning.
            suppressUnloadWarning = true;
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          scheduleAutoSave();
        },
        true
      );

      form.addEventListener(
        "input",
        function (e) {
          var t = e.target;
          if (!shouldAutoSaveFrom(t)) return;
          scheduleAutoSave();
        },
        true
      );

      form.addEventListener(
        "change",
        function (e) {
          var t = e.target;
          if (!shouldAutoSaveFrom(t)) return;
          scheduleAutoSave();
        },
        true
      );

      // Warn if navigating away during an in-flight or pending save
      window.addEventListener("beforeunload", function (e) {
        if (suppressUnloadWarning) return;
        if (!saveInFlight && !timer && !dirty && !catchUpTimer) return;
        e.preventDefault();
        e.returnValue = "";
      });
    })();
  </script>

  <% if (typeof takSshMaintenanceVisible !== "undefined" && takSshMaintenanceVisible) { %>
  <script>
    (function () {
      var showLogsBtn = document.getElementById("takMaintShowLogsBtn");
      var restartBtn = document.getElementById("takMaintRestartServiceBtn");
      var rebootBtn = document.getElementById("takMaintRebootServerBtn");
      var panel = document.getElementById("takMaintPanel");
      var listEl = document.getElementById("takMaintStatusList");
      var logPre = document.getElementById("takMaintLogPre");
      var copyLogsBtn = document.getElementById("takMaintCopyLogsBtn");
      var inProgressEl = document.getElementById("takMaintInProgress");
      var copyLogsBtnDefaultLabel = copyLogsBtn ? copyLogsBtn.textContent : "";
      var maintEs = null;
      var pollLi = null;

      function setInProgress(message) {
        if (!inProgressEl) return;
        if (message) {
          inProgressEl.textContent = message;
          inProgressEl.style.display = "block";
        } else {
          inProgressEl.textContent = "";
          inProgressEl.style.display = "none";
        }
      }

      function stopStream() {
        if (maintEs) {
          try {
            maintEs.close();
          } catch (e) {}
          maintEs = null;
        }
      }

      function appendStatus(text) {
        if (!listEl) return;
        var li = document.createElement("li");
        li.textContent = text;
        listEl.appendChild(li);
      }

      function setPollStatus(text) {
        if (!listEl) return;
        if (!pollLi) {
          pollLi = document.createElement("li");
          listEl.appendChild(pollLi);
        }
        pollLi.textContent = text;
      }

      function resetPanel() {
        if (!panel || !listEl || !logPre) return;
        setInProgress("");
        panel.style.display = "block";
        listEl.innerHTML = "";
        logPre.textContent = "";
        pollLi = null;
      }

      function copyTextToClipboard(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          var ta = document.createElement("textarea");
          ta.value = text;
          ta.style.position = "fixed";
          ta.style.opacity = "0";
          document.body.appendChild(ta);
          ta.select();
          try {
            document.execCommand("copy");
            resolve();
          } catch (e) {
            reject(e);
          } finally {
            document.body.removeChild(ta);
          }
        });
      }

      function flashCopyLogsBtn(ok) {
        if (!copyLogsBtn) return;
        copyLogsBtn.textContent = ok ? "Copied!" : "Copy failed";
        window.setTimeout(function () {
          copyLogsBtn.textContent = copyLogsBtnDefaultLabel;
        }, 1600);
      }

      function startWatchStream(opts) {
        opts = opts || {};
        var tailOnly = !!opts.tailOnly;
        stopStream();
        resetPanel();
        if (!tailOnly) {
          appendStatus("Live stream connected — waiting for TAK API and log tail.");
        }
        var streamUrl =
          "/api/settings/tak-maintenance/stream" + (tailOnly ? "?tailOnly=1" : "");
        maintEs = new EventSource(streamUrl);
        maintEs.onmessage = function (ev) {
          var d = null;
          try {
            d = JSON.parse(ev.data);
          } catch (e) {
            return;
          }
          if (!d || typeof d !== "object") return;
          if (d.type === "stream_open") {
            return;
          }
          if (d.type === "tail_only") {
            appendStatus(String(d.message || "Live tail of takserver-api.log (no restart)."));
            return;
          }
          if (d.type === "health_poll") {
            var st = d.ok ? "responding" : "not ready";
            setPollStatus(
              "Health check #" +
                String(d.attempt || "") +
                ": " +
                st +
                (d.detail ? " (" + String(d.detail) + ")" : "")
            );
          } else if (d.type === "healthy") {
            pollLi = null;
            appendStatus("Server healthy — " + String(d.at || ""));
          } else if (d.type === "health_timeout") {
            appendStatus(String(d.message || "Health wait timed out."));
          } else if (d.type === "log_line") {
            var prefix = d.stream === "stderr" ? "[stderr] " : "";
            logPre.textContent += prefix + String(d.line || "") + "\n";
            logPre.scrollTop = logPre.scrollHeight;
          } else if (d.type === "tail_error") {
            appendStatus("Log tail error: " + String(d.message || ""));
          } else if (d.type === "tail_end") {
            appendStatus("Log stream ended — " + String(d.at || ""));
            stopStream();
          } else if (d.type === "error") {
            appendStatus("Stream error: " + String(d.message || ""));
            stopStream();
          }
        };
        maintEs.onerror = function () {
          appendStatus("EventSource connection closed or failed (reload the page to try again).");
          stopStream();
        };
      }

      function postJson(url) {
        return fetch(url, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Requested-With": "XMLHttpRequest",
          },
          credentials: "same-origin",
          body: "{}",
        }).then(function (res) {
          return res.text().then(function (text) {
            var j = null;
            try {
              j = text ? JSON.parse(text) : null;
            } catch (e) {}
            if (!res.ok || !j || j.ok !== true) {
              var hint =
                (j && j.error) ||
                (text && String(text).trim().slice(0, 400)) ||
                (res.status ? "HTTP " + res.status + " " + (res.statusText || "").trim() : "") ||
                "Request failed";
              throw new Error(hint);
            }
            return j;
          });
        });
      }

      function startTakMaintenanceLogTail() {
        startWatchStream({ tailOnly: true });
      }
      window.startTakMaintenanceLogTail = startTakMaintenanceLogTail;
      window.stopTakMaintenanceLogTail = stopStream;

      if (showLogsBtn) {
        showLogsBtn.addEventListener("click", function () {
          startTakMaintenanceLogTail();
        });
      }

      if (copyLogsBtn && logPre) {
        copyLogsBtn.addEventListener("click", function () {
          var text = logPre.textContent || "";
          if (!text.trim()) {
            flashCopyLogsBtn(false);
            return;
          }
          copyTextToClipboard(text)
            .then(function () {
              flashCopyLogsBtn(true);
            })
            .catch(function () {
              flashCopyLogsBtn(false);
            });
        });
      }

      if (restartBtn) {
        restartBtn.addEventListener("click", function () {
          var ok = window.confirm(
            "Run on the TAK Server over SSH:\n\n  sudo systemctl restart takserver\n\n" +
              "Connected ATAK / TAK clients may drop briefly while the service restarts.\n\nContinue?"
          );
          if (!ok) return;
          setInProgress(
            "Restart in progress — sudo systemctl restart takserver is running on the TAK Server over SSH (often up to about a minute). The status panel below will open automatically."
          );
          restartBtn.disabled = true;
          if (rebootBtn) rebootBtn.disabled = true;
          if (showLogsBtn) showLogsBtn.disabled = true;
          postJson("/api/settings/tak-maintenance/restart-service")
            .then(function () {
              startWatchStream();
            })
            .catch(function (err) {
              setInProgress("");
              window.alert(err && err.message ? err.message : String(err));
            })
            .finally(function () {
              restartBtn.disabled = false;
              if (rebootBtn) rebootBtn.disabled = false;
              if (showLogsBtn) showLogsBtn.disabled = false;
            });
        });
      }

      if (rebootBtn) {
        rebootBtn.addEventListener("click", function () {
          var ok = window.confirm(
            "This will reboot the entire TAK Server host over SSH:\n\n  sudo reboot\n\n" +
              "All services on that machine will restart. The portal will wait for the TAK Marti API to respond again, then show takserver-api.log.\n\nContinue?"
          );
          if (!ok) return;
          var ok2 = window.confirm("Confirm full host reboot?");
          if (!ok2) return;
          setInProgress(
            "Restart in progress — sending sudo reboot to the TAK Server host over SSH. The machine will go down briefly."
          );
          if (restartBtn) restartBtn.disabled = true;
          rebootBtn.disabled = true;
          if (showLogsBtn) showLogsBtn.disabled = true;
          postJson("/api/settings/tak-maintenance/reboot-server")
            .then(function () {
              startWatchStream();
            })
            .catch(function (err) {
              setInProgress("");
              window.alert(err && err.message ? err.message : String(err));
            })
            .finally(function () {
              if (restartBtn) restartBtn.disabled = false;
              rebootBtn.disabled = false;
              if (showLogsBtn) showLogsBtn.disabled = false;
            });
        });
      }
    })();
  </script>
  <% } %>


  <script>
    (function () {
      var openId = null;
      var overlayMouseDown = false;

      function panelEl(id) {
        return document.getElementById("settingsModal-" + id);
      }

      function closeSettingsModal() {
        var wasMaintenance = openId === "tak-maintenance";
        var wasLiveMap = openId === "live-map";
        if (!openId) {
          document.querySelectorAll(".settings-modal-overlay").forEach(function (el) {
            el.style.display = "none";
            el.setAttribute("aria-hidden", "true");
          });
          document.body.classList.remove("modal-open");
          return;
        }
        var el = panelEl(openId);
        if (el) {
          el.style.display = "none";
          el.setAttribute("aria-hidden", "true");
        }
        openId = null;
        document.body.classList.remove("modal-open");
        if (wasMaintenance && typeof window.stopTakMaintenanceLogTail === "function") {
          window.stopTakMaintenanceLogTail();
        }
        if (wasLiveMap && typeof window.stopOpenAddressesPoll === "function") {
          window.stopOpenAddressesPoll();
        }
      }

      function openSettingsModal(id) {
        if (!id) return;
        closeSettingsModal();
        var el = panelEl(id);
        if (!el) return;
        el.style.display = "flex";
        el.setAttribute("aria-hidden", "false");
        openId = id;
        document.body.classList.add("modal-open");
        var closeBtn = el.querySelector("[data-close-settings-modal]");
        if (closeBtn) closeBtn.focus();
        if (id === "tak-maintenance" && typeof window.startTakMaintenanceLogTail === "function") {
          window.startTakMaintenanceLogTail();
        }
        if (id === "live-map" && typeof window.startOpenAddressesPoll === "function") {
          window.startOpenAddressesPoll();
        }
      }

      window.openSettingsModal = openSettingsModal;
      window.closeSettingsModal = closeSettingsModal;

      function closeAllHelpTips() {
        document.querySelectorAll(".settings-help-tip.is-open").forEach(function (t) {
          t.classList.remove("is-open");
          var b = t.querySelector(".settings-help-btn");
          if (b) b.setAttribute("aria-expanded", "false");
        });
      }

      function placeSettingsHelpTip(tip) {
        if (!tip || !tip.classList) return;
        // Modal header tips already open upward via CSS.
        if (tip.closest(".modalHeader")) {
          tip.classList.remove("popover-above");
          return;
        }

        var btn = tip.querySelector(".settings-help-btn");
        if (!btn) return;

        var container =
          tip.closest(".settings-modal .modalBody, .settings-modal .settings-body") ||
          tip.closest(".modalBody, .settings-body");
        var btnRect = btn.getBoundingClientRect();
        var bounds = container
          ? container.getBoundingClientRect()
          : { top: 0, bottom: window.innerHeight || 0 };
        var spaceBelow = bounds.bottom - btnRect.bottom;
        var spaceAbove = btnRect.top - bounds.top;
        var minBelow = 140;
        var preferAbove = spaceBelow < minBelow && spaceAbove > spaceBelow;
        tip.classList.toggle("popover-above", !!preferAbove);
      }

      document.addEventListener(
        "mouseover",
        function (e) {
          var tip = e.target && e.target.closest
            ? e.target.closest(".settings-help-tip")
            : null;
          if (!tip) return;
          var from = e.relatedTarget;
          if (from && tip.contains(from)) return;
          placeSettingsHelpTip(tip);
        },
        true
      );

      document.addEventListener(
        "focusin",
        function (e) {
          var tip = e.target && e.target.closest
            ? e.target.closest(".settings-help-tip")
            : null;
          if (tip) placeSettingsHelpTip(tip);
        },
        true
      );

      document.addEventListener("mousedown", function (e) {
        overlayMouseDown = !!(
          e.target &&
          e.target.classList &&
          e.target.classList.contains("settings-modal-overlay")
        );
      }, true);

      document.addEventListener("click", function (e) {
        var helpBtn = e.target.closest && e.target.closest(".settings-help-btn");
        if (helpBtn) {
          e.preventDefault();
          e.stopPropagation();
          var tip = helpBtn.closest(".settings-help-tip");
          if (!tip) return;
          var open = tip.classList.contains("is-open");
          closeAllHelpTips();
          if (!open) {
            placeSettingsHelpTip(tip);
            tip.classList.add("is-open");
            helpBtn.setAttribute("aria-expanded", "true");
          }
          return;
        }

        if (!e.target.closest || !e.target.closest(".settings-help-tip")) {
          closeAllHelpTips();
        }

        var stop = e.target.closest && e.target.closest("[data-stop-card-open]");
        if (stop) {
          e.stopPropagation();
          return;
        }

        var openBtn = e.target.closest && e.target.closest("[data-open-settings-modal]");
        if (openBtn) {
          e.preventDefault();
          openSettingsModal(openBtn.getAttribute("data-open-settings-modal"));
          return;
        }

        var closeBtn = e.target.closest && e.target.closest("[data-close-settings-modal]");
        if (closeBtn) {
          e.preventDefault();
          closeSettingsModal();
          return;
        }

        if (e.target.classList && e.target.classList.contains("settings-modal-overlay")) {
          if (overlayMouseDown) {
            closeSettingsModal();
          }
          overlayMouseDown = false;
        }
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
          if (document.querySelector(".settings-help-tip.is-open")) {
            closeAllHelpTips();
            return;
          }
          if (openId) closeSettingsModal();
          return;
        }
        if (e.key !== "Enter" && e.key !== " ") return;
        var card = e.target.closest && e.target.closest(".settings-hub-card[data-open-settings-modal]");
        if (!card || e.target.closest(".settings-help-tip")) return;
        e.preventDefault();
        openSettingsModal(card.getAttribute("data-open-settings-modal"));
      });

      if (window.location.hash === "#sms-settings") {
        openSettingsModal("sms");
      }

      // Live search: list matching settings on the main page (not hub cards)
      (function initSettingsHubSearch() {
        var hub = document.getElementById("settingsHub");
        var input = document.getElementById("settingsHubSearch");
        var emptyEl = document.getElementById("settingsHubSearchEmpty");
        var resultsEl = document.getElementById("settingsSearchResults");
        var categoriesEl = document.getElementById("settingsHubCategories");
        if (!hub || !input || !resultsEl || !categoriesEl) return;

        var indexed = null;

        function cleanText(text) {
          return String(text || "").replace(/\s+/g, " ").trim();
        }

        function fieldLabelText(field) {
          var labelEl = field.querySelector(".settings-label");
          if (!labelEl) return "";
          // Prefer the dedicated title span; never include ? / help popover text
          var titleSpan = labelEl.querySelector(":scope > span:first-child");
          if (titleSpan && !titleSpan.classList.contains("settings-help-tip")) {
            return cleanText(titleSpan.textContent);
          }
          var clone = labelEl.cloneNode(true);
          clone.querySelectorAll(".settings-help-tip, .cert-status").forEach(function (el) {
            el.remove();
          });
          return cleanText(clone.textContent);
        }

        function fieldValuePreview(control) {
          if (!control) return "";
          if (control.type === "password") {
            return control.value ? "••••••••" : "";
          }
          if (control.type === "file") {
            return control.files && control.files.length ? control.files[0].name : "";
          }
          if (control.tagName === "SELECT") {
            var opt = control.options[control.selectedIndex];
            return opt ? cleanText(opt.textContent || opt.value || "") : "";
          }
          var raw = cleanText(control.value || "");
          if (raw.length > 48) return raw.slice(0, 45) + "…";
          return raw;
        }

        function buildIndex() {
          var items = [];
          var cards = hub.querySelectorAll(".settings-hub-card[data-open-settings-modal]");
          cards.forEach(function (card) {
            var modalId = card.getAttribute("data-open-settings-modal") || "";
            var sectionTitle = "";
            var titleEl = card.querySelector(".settings-hub-card-title");
            if (titleEl) sectionTitle = cleanText(titleEl.textContent);
            var modal = document.getElementById("settingsModal-" + modalId);
            if (!modal) return;

            var fields = modal.querySelectorAll(".settings-field");
            fields.forEach(function (field, idx) {
              var label = fieldLabelText(field);
              if (!label) return;
              var control =
                field.querySelector("input:not([type='hidden']), select, textarea") ||
                field.querySelector("input, select, textarea");
              var name = control ? control.getAttribute("name") || "" : "";
              var key = "";
              var keyMatch = name.match(/settings\[([^\]]+)\]/);
              if (keyMatch) key = keyMatch[1];
              var helpEl = field.querySelector(".settings-help-popover");
              var help = helpEl ? cleanText(helpEl.textContent) : "";
              var haystack = [label, key, key.replace(/_/g, " "), help, sectionTitle, name]
                .join(" ")
                .toLowerCase();
              items.push({
                modalId: modalId,
                sectionTitle: sectionTitle,
                label: label,
                key: key,
                haystack: haystack,
                fieldIndex: idx,
              });
            });

            // Sections with custom UI (callsign builder, agency types, bookmarks, templates, maintenance)
            if (!fields.length || modalId === "callsign" || modalId === "agency-types" || modalId === "regions" || modalId === "bookmarks" || modalId === "auto-create-groups" || modalId === "auto-create-data-sync" || modalId === "email-templates" || modalId === "tak-maintenance" || modalId === "live-map") {
              var sectionHelp = "";
              var sectionHelpEl = modal.querySelector(".modalHeader .settings-help-popover");
              if (sectionHelpEl) sectionHelp = cleanText(sectionHelpEl.textContent);
              items.push({
                modalId: modalId,
                sectionTitle: sectionTitle,
                label: sectionTitle,
                key: "",
                haystack: [sectionTitle, sectionHelp, modalId.replace(/-/g, " ")].join(" ").toLowerCase(),
                fieldIndex: -1,
                sectionOnly: true,
              });
            }
          });

          hub.querySelectorAll("a.settings-hub-card[href]").forEach(function (card) {
            var titleEl = card.querySelector(".settings-hub-card-title");
            var sectionTitle = titleEl ? cleanText(titleEl.textContent) : "";
            var href = card.getAttribute("href") || "";
            if (!sectionTitle || !href) return;
            items.push({
              href: href,
              modalId: "",
              sectionTitle: sectionTitle,
              label: sectionTitle,
              key: "",
              haystack: [sectionTitle, href.replace(/[\/_-]+/g, " ")].join(" ").toLowerCase(),
              fieldIndex: -1,
              sectionOnly: true,
            });
          });
          return items;
        }

        function ensureIndex() {
          if (!indexed) indexed = buildIndex();
          return indexed;
        }

        function openResult(item) {
          if (item.href) {
            window.location.href = item.href;
            return;
          }
          openSettingsModal(item.modalId);
          window.setTimeout(function () {
            var modal = document.getElementById("settingsModal-" + item.modalId);
            if (!modal) return;
            var target = null;
            if (item.fieldIndex >= 0) {
              var fields = modal.querySelectorAll(".settings-field");
              target = fields[item.fieldIndex] || null;
            }
            if (!target) {
              target = modal.querySelector(".modalBody") || modal;
            }
            if (target && target.scrollIntoView) {
              target.scrollIntoView({ block: "center", behavior: "smooth" });
            }
            var focusEl = target && target.querySelector
              ? target.querySelector("input:not([type='hidden']), select, textarea, button")
              : null;
            if (focusEl && focusEl.focus) {
              try {
                focusEl.focus({ preventScroll: true });
              } catch (_) {
                focusEl.focus();
              }
            }
          }, 60);
        }

        function renderResults(q) {
          var items = ensureIndex();
          var matches = items.filter(function (item) {
            return item.haystack.indexOf(q) !== -1;
          });

          // Prefer field rows over section-only rows when that section already has field hits
          var fieldMatchedModals = Object.create(null);
          matches.forEach(function (item) {
            if (!item.sectionOnly) fieldMatchedModals[item.modalId] = true;
          });
          matches = matches.filter(function (item) {
            if (!item.sectionOnly) return true;
            return !fieldMatchedModals[item.modalId];
          });

          resultsEl.innerHTML = "";

          // Group matches by section for a cleaner list
          var groups = [];
          var groupMap = Object.create(null);
          matches.forEach(function (item) {
            var key = item.modalId || item.sectionTitle || "other";
            if (!groupMap[key]) {
              groupMap[key] = {
                modalId: item.modalId,
                sectionTitle: item.sectionTitle || "Settings",
                items: [],
              };
              groups.push(groupMap[key]);
            }
            groupMap[key].items.push(item);
          });

          groups.forEach(function (group) {
            var section = document.createElement("section");
            section.className = "settings-search-group";

            var heading = document.createElement("h3");
            heading.className = "settings-search-group-title";
            heading.textContent = group.sectionTitle;
            section.appendChild(heading);

            var list = document.createElement("div");
            list.className = "settings-search-group-list";

            group.items.forEach(function (item) {
              var modal = document.getElementById("settingsModal-" + item.modalId);
              var preview = "";
              if (modal && item.fieldIndex >= 0) {
                var field = modal.querySelectorAll(".settings-field")[item.fieldIndex];
                if (field) {
                  var control = field.querySelector("input:not([type='hidden']), select, textarea");
                  preview = fieldValuePreview(control);
                }
              }

              var btn = document.createElement("button");
              btn.type = "button";
              btn.className = "settings-search-result";

              var labelEl = document.createElement("span");
              labelEl.className = "settings-search-result-label";
              labelEl.textContent = item.href ? "Open page" : item.sectionOnly ? "Open section" : item.label;

              var valueEl = document.createElement("span");
              valueEl.className = "settings-search-result-value";
              if (preview) {
                valueEl.textContent = preview;
                valueEl.title = preview;
              } else {
                valueEl.classList.add("is-empty");
                valueEl.textContent = item.sectionOnly ? "View" : "—";
              }

              btn.appendChild(labelEl);
              btn.appendChild(valueEl);
              btn.addEventListener("click", function () {
                openResult(item);
              });
              list.appendChild(btn);
            });

            section.appendChild(list);
            resultsEl.appendChild(section);
          });

          return matches.length;
        }

        function applyFilter() {
          var q = String(input.value || "").trim().toLowerCase();
          if (!q) {
            hub.classList.remove("is-searching");
            categoriesEl.hidden = false;
            resultsEl.hidden = true;
            resultsEl.innerHTML = "";
            if (emptyEl) emptyEl.hidden = true;
            return;
          }

          hub.classList.add("is-searching");
          categoriesEl.hidden = true;
          var count = renderResults(q);
          resultsEl.hidden = count === 0;
          if (emptyEl) emptyEl.hidden = count > 0;
        }

        input.addEventListener("input", applyFilter);
        input.addEventListener("search", applyFilter);
      })();
    })();
  </script>

  <style>
    .cert-status {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 999px;
      font-weight: 600;
      white-space: nowrap;
    }

    .cert-status.installed {
      background: #dcfce7;
      color: #166534;
    }

    .cert-status.missing {
      background: #fee2e2;
      color: #991b1b;
    }

    .passwordWrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .passwordWrap input {
      width: 100%;
      padding-right: 2.5rem;
    }

    .passwordToggle {
      position: absolute;
      right: 8px;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      padding: 0;
      filter: invert(1);
    }

    .branding-color-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .reset-default-btn {
      color: #fff;
    }

    body.theme-light .passwordToggle {
      filter: none;
    }
  </style>
