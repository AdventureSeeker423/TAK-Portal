                title: dsTitle("AUTO_CREATE_STATE_DATA_SYNC_TITLE"),
                groupIndex: dsGroupIndex("AUTO_CREATE_STATE_DATA_SYNC_GROUP_INDEX"),
              },
            };
            const autoCreateGroupsFallback = {
              agency: {
                enabled: autoCreateEnabled("AUTO_CREATE_AGENCY_GROUPS_ENABLED", true),
                titles: (function () {
                  const out = [];
                  for (let i = 1; i <= 3; i++) {
