    <!-- Agency Types -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-agency-types" data-settings-modal="agency-types" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-agency-types">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-agency-types">Agency Types</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Extra agency types shown in the Agencies page type dropdown above Other.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          

          <%
            const initialAdditionalAgencyTypes = [];
            for (let i = 1; i <= 30; i++) {
              const v = (settings[`ADDITIONAL_AGENCY_TYPE_${i}`] || "").trim();
              if (v) initialAdditionalAgencyTypes.push(v);
            }
          %>

          <div id="additionalAgencyTypeEditor" style="margin-top:.5rem;">
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:.5rem;">
              <button type="button" class="btn" id="addAdditionalAgencyTypeBtn">Add type</button>
              <small class="settings-help" id="additionalAgencyTypeCountNote"></small>
            </div>

            <ul id="additionalAgencyTypeList" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem;"></ul>

            <div id="additionalAgencyTypeHiddenFields"></div>
          </div>

          <script>
            (function () {
              var MAX = 30;
              var form = document.getElementById("settingsForm");
              var list = document.getElementById("additionalAgencyTypeList");
              var addBtn = document.getElementById("addAdditionalAgencyTypeBtn");
              var note = document.getElementById("additionalAgencyTypeCountNote");
              var hiddenHost = document.getElementById("additionalAgencyTypeHiddenFields");

              if (!form || !list || !addBtn || !hiddenHost) return;

              var initial = <%- JSON.stringify(initialAdditionalAgencyTypes) %>;

              function updateCount() {
                var n = list.querySelectorAll("li[data-additional-agency-type-row]").length;
                if (note) note.textContent = n + " / " + MAX + " additional types";
                addBtn.disabled = n >= MAX;
              }

              function createRow(label) {
                var li = document.createElement("li");
                li.setAttribute("data-additional-agency-type-row", "1");
                li.draggable = true;
                li.style.border = "1px solid #e5e7eb";
                li.style.borderRadius = "0.5rem";
                li.style.padding = "0.5rem";
                li.style.background = "#fff0";

                var wrap = document.createElement("div");
                wrap.style.display = "grid";
                wrap.style.gridTemplateColumns = "32px 1fr 80px";
                wrap.style.gap = "0.5rem";
                wrap.style.alignItems = "center";

                var handle = document.createElement("div");
                handle.title = "Drag to reorder";
                handle.textContent = "⋮⋮";
                handle.style.cursor = "grab";
                handle.style.userSelect = "none";
                handle.style.fontSize = "1.2rem";
                handle.style.textAlign = "center";

                var inp = document.createElement("input");
                inp.type = "text";
                inp.placeholder = "Type label (e.g. Transit Police)";
                inp.value = label || "";
                inp.setAttribute("data-additional-agency-type-val", "1");
                inp.style.width = "100%";
                inp.addEventListener("input", function () {
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                });

                var del = document.createElement("button");
                del.type = "button";
                del.className = "btn danger";
                del.textContent = "Delete";
                del.addEventListener("click", function () {
                  li.remove();
                  updateCount();
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                });

                wrap.appendChild(handle);
                wrap.appendChild(inp);
                wrap.appendChild(del);
                li.appendChild(wrap);

                li.addEventListener("dragstart", function (e) {
                  li.classList.add("dragging");
                  e.dataTransfer.effectAllowed = "move";
                });
                li.addEventListener("dragend", function () {
                  li.classList.remove("dragging");
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                });

                return li;
              }

              function getDragAfterElement(container, y) {
                var els = [].slice.call(
                  container.querySelectorAll("li[data-additional-agency-type-row]:not(.dragging)")
                );
                return els.reduce(
                  function (closest, child) {
                    var box = child.getBoundingClientRect();
                    var offset = y - box.top - box.height / 2;
                    if (offset < 0 && offset > closest.offset) {
                      return { offset: offset, element: child };
                    }
                    return closest;
                  },
                  { offset: Number.NEGATIVE_INFINITY, element: null }
                ).element;
              }

              list.addEventListener("dragover", function (e) {
                e.preventDefault();
                var dragging = list.querySelector(".dragging");
                if (!dragging) return;
                var after = getDragAfterElement(list, e.clientY);
                if (after == null) {
                  list.appendChild(dragging);
                } else {
                  list.insertBefore(dragging, after);
                }
              });

              addBtn.addEventListener("click", function () {
                var n = list.querySelectorAll("li[data-additional-agency-type-row]").length;
                if (n >= MAX) return;
                list.appendChild(createRow(""));
                updateCount();
              });

              if (Array.isArray(initial) && initial.length) {
                initial.forEach(function (t) {
                  list.appendChild(createRow(t));
                });
              }
              updateCount();

              function serializeAdditionalAgencyTypes() {
                hiddenHost.innerHTML = "";

                var rows = [].slice.call(list.querySelectorAll("li[data-additional-agency-type-row]"));
                var normalized = rows
                  .map(function (li) {
                    var el = li.querySelector("[data-additional-agency-type-val]");
                    return String((el && el.value) || "").trim();
                  })
                  .filter(Boolean);

                for (var i = 1; i <= MAX; i++) {
                  var h = document.createElement("input");
                  h.type = "hidden";
                  h.name = "settings[ADDITIONAL_AGENCY_TYPE_" + i + "]";
                  h.value = normalized[i - 1] || "";
                  hiddenHost.appendChild(h);
                }
              }

              window.__settingsSerializeHooks = window.__settingsSerializeHooks || [];
              window.__settingsSerializeHooks.push(serializeAdditionalAgencyTypes);
              form.addEventListener("submit", serializeAdditionalAgencyTypes);
            })();
          </script>
        
        </div>
      </div>
    </div>

    <!-- Callsign Format -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-callsign" data-settings-modal="callsign" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-callsign">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-callsign">Callsign Format</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Build how callsigns are displayed using field and text blocks.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          

          <div id="callsignBuilder" style="margin-top:.5rem;">
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:.5rem;">
              <button type="button" class="btn" id="addCallsignFieldBtn">Add Field</button>
              <button type="button" class="btn" id="addCallsignTextBtn">Add Text</button>
              <span class="settings-help-tip">
                <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                <span class="settings-help-popover">Drag chips by the handle to change order.</span>
              </span>
            </div>

            <ul
              id="callsignList"
              style="list-style:none;padding:0;margin:0;display:flex;flex-direction:row;flex-wrap:wrap;gap:0.35rem;align-items:flex-start;"
            ></ul>

            <input
              type="hidden"
              id="callsignFormatInput"
              name="settings[CALLSIGN_FORMAT_EXPRESSION]"
              value="<%- (settings.CALLSIGN_FORMAT_EXPRESSION || '{{agencyAbbreviation}}-{{lastNameUpper}}-{{badgeNumber}}') %>"
            />


            <div style="margin-top:.5rem;">
              <strong>Preview:</strong>
              <span id="callsignPreview" style="font-family:monospace;margin-left:.25rem;"></span>
            </div>
          </div>

          <script>
            (function () {
              var root = document.getElementById("callsignBuilder");
              if (!root) return;

              var list = document.getElementById("callsignList");
              var input = document.getElementById("callsignFormatInput");
              var preview = document.getElementById("callsignPreview");
              var addFieldBtn = document.getElementById("addCallsignFieldBtn");
              var addTextBtn = document.getElementById("addCallsignTextBtn");

              if (!list || !input || !preview || !addFieldBtn || !addTextBtn) return;

              var FIELD_OPTIONS = [
                { value: "stateAbbreviation", label: "State" },
                { value: "county", label: "County" },
                { value: "countyAbbreviation", label: "County Abbrev" },
                { value: "agencyAbbreviation", label: "Agency Abbrev" },
                { value: "agencyTypeCode", label: "Agency Type" },
                { value: "currentTemplate", label: "Template" },
                { value: "firstName", label: "First Name" },
                { value: "firstInitial", label: "First Initial" },
                { value: "lastNameUpper", label: "Last Name (UPPER)" },
                { value: "lastName", label: "Last Name" },
                { value: "lastInitial", label: "Last Initial" },
                { value: "badgeNumber", label: "Radio Callsign / Username" },
                { value: "radioCallsignOrBlank", label: "Radio Callsign / Blank" },
                { value: "_dash", label: "— (dash)" }
              ];

              function getDragAfterElement(container, x) {
                var els = [].slice.call(
                  container.querySelectorAll("li[data-callsign-row]:not(.dragging)")
                );
                return els.reduce(function (closest, child) {
                  var box = child.getBoundingClientRect();
                  var offset = x - box.left - box.width / 2;
                  if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                  }
                  return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
              }

              function serialize() {
                var parts = [];
                var rows = [].slice.call(list.querySelectorAll("li[data-callsign-row]"));
                rows.forEach(function (row) {
                  var type = row.getAttribute("data-type");
                  if (type === "field") {
                    var sel = row.querySelector("select[data-field-name]");
                    var v = (sel && sel.value) || "";
                    if (v === "_dash") {
                      parts.push("-");
                    } else if (v) {
                      parts.push("{{" + v + "}}");
                    }
                  } else if (type === "text") {
                    var inp = row.querySelector("input[data-text-val]");
                    if (inp && inp.value) parts.push(inp.value);
                  }
                });

                if (!parts.length) {
                  parts = ["{{agencyAbbreviation}}", "-", "{{lastNameUpper}}", "-", "{{badgeNumber}}"];
                }

                input.value = parts.join("");
                try {
                  input.dispatchEvent(new Event("input", { bubbles: true }));
                } catch (_) {}
                updatePreview();
              }

              function updatePreview() {
                var expr = String(input.value || "").trim();
                if (!expr) {
                  preview.textContent = "AGENCY-LASTNAME-BADGE";
                  return;
                }

                var exampleCtx = {
                  agencyAbbreviation: "AGENCY",
                  stateAbbreviation: "STATE",
                  county: "COUNTY",
                  countyAbbreviation: "COUNTYABBREV",
                  agencyTypeCode: "TYPE",
                  currentTemplate: "TEMPLATE",
                  firstName: "FIRST",
                  firstInitial: "F",
                  lastName: "Last",
                  lastNameUpper: "LAST",
                  lastInitial: "L",
                  badgeNumber: "T05",
                  radioCallsignOrBlank: ""
                };

                var rendered = expr.replace(/\{\{\s*([a-zA-Z0-9_]+)\s*\}\}/g, function (_, key) {
                  if (Object.prototype.hasOwnProperty.call(exampleCtx, key)) {
                    return String(exampleCtx[key] || "").trim();
                  }
                  return "";
                });

                // Always drop empty fields and clean orphan leading/trailing/double dashes
                rendered = String(rendered || "").trim();
                rendered = rendered.replace(/\s*-\s*/g, "-");
                rendered = rendered.replace(/-{2,}/g, "-");
                while (rendered.charAt(0) === "-") rendered = rendered.slice(1);
                while (rendered.charAt(rendered.length - 1) === "-") {
                  rendered = rendered.slice(0, -1);
                }
                rendered = rendered.trim();

                preview.textContent = rendered || "AGENCY-LASTNAME-BADGE";
              }

              function makeDeleteButton(onClick) {
                var btn = document.createElement("button");
                btn.type = "button";
                btn.textContent = "✕";
                btn.title = "Remove";
                btn.className = "btn btn-warning callsign-block-delete";
                btn.addEventListener("click", function () {
                  onClick();
                  serialize();
                });
                return btn;
              }

              function createRow(opts) {
                var type = opts && opts.type === "text" ? "text" : "field";
                var field = opts && opts.field;
                var text = opts && opts.text;

                var li = document.createElement("li");
                li.setAttribute("data-callsign-row", "1");
                li.setAttribute("data-type", type);
                li.className = "callsign-block";
                li.draggable = true;
                li.style.border = "1px solid #e5e7eb";
                li.style.background = "#fff0";

                var wrap = document.createElement("div");
                wrap.className = "callsign-block-inner";

                var handle = document.createElement("div");
                handle.className = "callsign-block-handle";
                handle.title = "Drag to reorder";
                handle.textContent = "⋮⋮";

                var main;
                if (type === "field") {
                  var select = document.createElement("select");
                  select.setAttribute("data-field-name", "1");
                  FIELD_OPTIONS.forEach(function (opt) {
                    var o = document.createElement("option");
                    o.value = opt.value;
                    o.textContent = opt.label;
                    select.appendChild(o);
                  });
                  select.value = field && FIELD_OPTIONS.some(function (o) { return o.value === field; })
                    ? field
                    : "agencyAbbreviation";
                  select.addEventListener("change", serialize);
                  main = select;
                } else {
                  var inp = document.createElement("input");
                  inp.type = "text";
                  inp.setAttribute("data-text-val", "1");
                  inp.placeholder = "Text (e.g. -, TN-)";
                  inp.value = text || "";
                  inp.addEventListener("input", serialize);
                  main = inp;
                }

                var del = makeDeleteButton(function () {
                  li.remove();
                });

                wrap.appendChild(handle);
                wrap.appendChild(main);
                wrap.appendChild(del);
                li.appendChild(wrap);

                li.addEventListener("dragstart", function (e) {
                  li.classList.add("dragging");
                  if (e.dataTransfer) {
                    e.dataTransfer.effectAllowed = "move";
                  }
                });
                li.addEventListener("dragend", function () {
                  li.classList.remove("dragging");
                  serialize();
                });

                return li;
              }

              function initFromExpression() {
                var expr = String(input.value || "").trim();
                if (!expr) {
                  expr = "{{agencyAbbreviation}}-{{lastNameUpper}}-{{badgeNumber}}";
                }

                var re = /\{\{\s*([a-zA-Z0-9_]+)\s*\}\}/g;
                var lastIndex = 0;
                var m;
                while ((m = re.exec(expr)) !== null) {
                  var textPart = expr.slice(lastIndex, m.index);
                  if (textPart) {
                    list.appendChild(textPart === "-"
                      ? createRow({ type: "field", field: "_dash" })
                      : createRow({ type: "text", text: textPart }));
                  }
                  list.appendChild(createRow({ type: "field", field: m[1] }));
                  lastIndex = re.lastIndex;
                }
                var tail = expr.slice(lastIndex);
                if (tail) {
                  list.appendChild(tail === "-"
                    ? createRow({ type: "field", field: "_dash" })
                    : createRow({ type: "text", text: tail }));
                }

                if (!list.querySelector("li[data-callsign-row]")) {
                  list.appendChild(createRow({ type: "field", field: "agencyAbbreviation" }));
                  list.appendChild(createRow({ type: "field", field: "_dash" }));
                  list.appendChild(createRow({ type: "field", field: "lastNameUpper" }));
                  list.appendChild(createRow({ type: "field", field: "_dash" }));
                  list.appendChild(createRow({ type: "field", field: "badgeNumber" }));
                }

                serialize();
              }

              addFieldBtn.addEventListener("click", function () {
                list.appendChild(createRow({ type: "field", field: "badgeNumber" }));
                serialize();
              });

              addTextBtn.addEventListener("click", function () {
                list.appendChild(createRow({ type: "text", text: "-" }));
                serialize();
              });

              list.addEventListener("dragover", function (e) {
                e.preventDefault();
                var dragging = list.querySelector(".dragging");
                if (!dragging) return;
                var after = getDragAfterElement(list, e.clientX);
                if (after == null) {
                  list.appendChild(dragging);
                } else {
                  list.insertBefore(dragging, after);
                }
              });

              initFromExpression();
            })();
          </script>
        
        </div>
      </div>
    </div>

    <!-- Branding &amp; Appearance -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-branding" data-settings-modal="branding" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-branding">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-branding">Branding &amp; Appearance</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Server name, logo, theme, fonts, button color, and beta features.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          <div class="grid2">
            <label class="settings-field">
              <span class="settings-label">
                <span>Server Name Abbreviation</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">Server Abbreviation to add custom branding to the portal.</span>
                </span>
              </span>
              <input
                type="text"
                id="serverNameAbbrevInput"
                name="settings[SERVER_NAME]"
                value="<%= (typeof settings.SERVER_NAME === 'string' ? settings.SERVER_NAME : '').toUpperCase() %>"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                style="text-transform: uppercase;"
              />
              
            </label>
            <label class="settings-field">
              <span class="settings-label">
                <span>Portal Logo</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">Shown in sidebar and QR codes. Upload a new image to replace the current logo.</span>
                </span>
              </span>
              <input type="file" name="BRAND_LOGO_UPLOAD" accept="image/*" />
              <% if (settings.BRAND_LOGO_URL) { %>
                <small class="muted" style="font-size:0.8rem;">Current: <code><%= settings.BRAND_LOGO_URL %></code></small>
              <% } %>
            </label>
            <label class="settings-field">
              <span class="settings-label">
                <span>Default Theme Mode</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">Sets first-load appearance for users who have not toggled a saved theme on this device yet.</span>
                </span>
              </span>
              <%
                const defaultThemeMode = String(settings.DEFAULT_THEME_MODE || "dark").toLowerCase();
              %>
              <select name="settings[DEFAULT_THEME_MODE]">
                <option value="dark" <%= defaultThemeMode === "dark" ? "selected" : "" %>>Dark</option>
                <option value="light" <%= defaultThemeMode === "light" ? "selected" : "" %>>Light</option>
              </select>
              
            </label>
            <label class="settings-field">
              <span class="settings-label">
                <span>Site-wide Font Family</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">Applies globally to the portal UI.</span>
                </span>
              </span>
              <%
                const fontOptions = [
                  { label: "System UI", value: "system-ui, -apple-system, Segoe UI, Roboto, sans-serif" },
                  { label: "Arial", value: "Arial, Helvetica, sans-serif" },
                  { label: "Helvetica", value: '"Helvetica Neue", Helvetica, Arial, sans-serif' },
                  { label: "Verdana", value: "Verdana, Geneva, sans-serif" },
                  { label: "Trebuchet MS", value: '"Trebuchet MS", Helvetica, sans-serif' },
                  { label: "Tahoma", value: "Tahoma, Geneva, sans-serif" },
                  { label: "Georgia", value: "Georgia, serif" },
                  { label: '"Times New Roman"', value: '"Times New Roman", Times, serif' },
                  { label: "Garamond", value: "Garamond, serif" },
                  { label: '"Palatino Linotype"', value: '"Palatino Linotype", "Book Antiqua", Palatino, serif' },
                  { label: '"Courier New"', value: '"Courier New", Courier, monospace' },
                  { label: "Lucida Console", value: '"Lucida Console", Monaco, monospace' }
                ];
                const defaultSiteFont = fontOptions[0].value;
                const configuredSiteFont = String(settings.SITE_FONT_FAMILY || "");
                const hasCustomSiteFont = fontOptions.some(function (f) { return f.value === configuredSiteFont; });
                const resolvedSiteFont = hasCustomSiteFont
                  ? configuredSiteFont
                  : defaultSiteFont;
                const selectedSiteFontLabel = (fontOptions.find(function (f) { return f.value === resolvedSiteFont; }) || fontOptions[0]).label;
              %>
              <input
                type="hidden"
                id="siteFontFamilySettingValue"
                name="settings[SITE_FONT_FAMILY]"
                value="<%= hasCustomSiteFont ? configuredSiteFont : '' %>"
              />
              <select id="siteFontFamilySelect">
                <% fontOptions.forEach(function (font) { %>
                  <option
                    value="<%= font.value %>"
                    <%= font.value === resolvedSiteFont ? "selected" : "" %>
                  >
                    <%= font.label %>
                  </option>
                <% }); %>
              </select>
              <div style="margin-top:.4rem;">
                <button type="button" class="btn reset-default-btn" id="resetSiteFontFamilyBtn">Reset to default</button>
              </div>
              <div class="muted" style="font-size:0.8rem;margin-top:0.35rem;">
                Preview: <span id="siteFontPreview" style="font-family:<%= resolvedSiteFont %>;"><%= selectedSiteFontLabel %> - The quick brown fox jumps over the lazy dog.</span>
              </div>
            </label>
            <label class="settings-field">
              <span class="settings-label">
                <span>Primary Button Color</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">Sets the default color used for primary action buttons across the portal.</span>
                </span>
              </span>
              <%
                const defaultPrimaryButtonColor = defaultThemeMode === "light" ? "#2563eb" : "#0a84ff";
                const configuredPrimaryButtonColor = String(settings.PRIMARY_BUTTON_COLOR || "").trim();
                const hasCustomPrimaryButtonColor = /^#[0-9a-fA-F]{6}$/.test(configuredPrimaryButtonColor);
                const primaryButtonColor = hasCustomPrimaryButtonColor
                  ? configuredPrimaryButtonColor
                  : defaultPrimaryButtonColor;
              %>
              <div class="branding-color-row">
                <input
                  type="hidden"
                  id="primaryButtonColorSettingValue"
                  name="settings[PRIMARY_BUTTON_COLOR]"
                  value="<%= hasCustomPrimaryButtonColor ? configuredPrimaryButtonColor : '' %>"
                />
                <input
                  id="primaryButtonColorInput"
                  type="color"
                  value="<%= primaryButtonColor %>"
                  aria-label="Primary button color"
                />
                <code id="primaryButtonColorValue"><%= primaryButtonColor %></code>
                <span id="primaryButtonColorPreview" class="btn" style="pointer-events:none;">Primary Button</span>
                <button type="button" class="btn reset-default-btn" id="resetPrimaryButtonColorBtn">Reset to default</button>
              </div>
              
            </label>
            <% renderField("USERNAME_PREFIX_LABEL","Username Descriptor Text","Displayed on Users, Pending User Requests, and Request Access pages. Default: Badge Number / Username","Badge Number / Username"); %>
            <% renderField("REQUEST_ACCESS_ENABLED","Enable Request Access Page","If true, the public /request-access enrollment form is available. Set false to disable it. Default: true.","true"); %>
            <% renderField("BETA_MODE","Enable Beta Features","If true, shows in-development features for global admins (e.g. Getting Started). Data Package, Locate Persons, and Data Sync are available regardless of this setting."); %>
          </div>
          <script>
            (function () {
              var serverNameInput = document.getElementById("serverNameAbbrevInput");
              if (serverNameInput) {
                serverNameInput.addEventListener("input", function () {
                  var start = serverNameInput.selectionStart;
                  var end = serverNameInput.selectionEnd;
                  var upper = String(serverNameInput.value || "").toUpperCase();
                  if (serverNameInput.value !== upper) {
                    serverNameInput.value = upper;
                    try {
                      serverNameInput.setSelectionRange(start, end);
                    } catch (_) {}
                  }
                });
                serverNameInput.addEventListener("blur", function () {
                  serverNameInput.value = String(serverNameInput.value || "").toUpperCase();
                });
              }

              var colorInput = document.getElementById("primaryButtonColorInput");
              var colorSettingInput = document.getElementById("primaryButtonColorSettingValue");
              var colorValue = document.getElementById("primaryButtonColorValue");
              var colorPreview = document.getElementById("primaryButtonColorPreview");
              var colorResetBtn = document.getElementById("resetPrimaryButtonColorBtn");
              var select = document.getElementById("siteFontFamilySelect");
              var fontSettingInput = document.getElementById("siteFontFamilySettingValue");
              var fontResetBtn = document.getElementById("resetSiteFontFamilyBtn");
              var preview = document.getElementById("siteFontPreview");
              var defaultSiteFontFamily = <%- JSON.stringify(defaultSiteFont) %>;
              function getThemeDefaultButtonColor() {
                var body = document.body;
                if (!body) return "#0a84ff";
                if (body.classList.contains("theme-light")) return "#2563eb";
                if (body.classList.contains("theme-dark-blue")) return "#2b6cff";
                return "#0a84ff";
              }
              function syncThemeColorVisuals() {
                var themeColor = getThemeDefaultButtonColor();
                if (colorResetBtn) {
                  colorResetBtn.style.background = themeColor;
                  colorResetBtn.style.borderColor = themeColor;
                }
                if (colorSettingInput && !String(colorSettingInput.value || "").trim() && colorInput) {
                  colorInput.value = themeColor;
                }
              }
              function updateColorValue() {
                if (!colorInput || !colorValue) return;
                colorValue.textContent = colorInput.value || "";
                if (colorPreview) {
                  var selectedColor = colorInput.value || getThemeDefaultButtonColor();
                  colorPreview.style.background = selectedColor;
                  colorPreview.style.borderColor = selectedColor;
                }
              }
              function updatePreview() {
                if (!select || !preview) return;
                var value = select.value || "";
                preview.style.fontFamily = value;
              }
              if (colorInput) {
                colorInput.addEventListener("input", function () {
                  if (colorSettingInput) {
                    colorSettingInput.value = colorInput.value || "";
                    colorSettingInput.dispatchEvent(new Event("change", { bubbles: true }));
                  }
                  updateColorValue();
                });
              }
              if (colorResetBtn) {
                colorResetBtn.addEventListener("click", function () {
                  if (!colorInput) return;
                  if (colorSettingInput) {
                    colorSettingInput.value = "";
                    colorSettingInput.dispatchEvent(new Event("change", { bubbles: true }));
                  }
                  syncThemeColorVisuals();
                  updateColorValue();
                });
              }
              if (select) {
                select.addEventListener("change", function () {
                  if (fontSettingInput) {
                    fontSettingInput.value = select.value || "";
                    fontSettingInput.dispatchEvent(new Event("change", { bubbles: true }));
                  }
                  updatePreview();
                });
              }
              if (fontResetBtn) {
                fontResetBtn.addEventListener("click", function () {
                  if (!select) return;
                  select.value = defaultSiteFontFamily;
                  if (fontSettingInput) {
                    fontSettingInput.value = "";
                    fontSettingInput.dispatchEvent(new Event("change", { bubbles: true }));
                  }
                  updatePreview();
                });
              }
              if (typeof MutationObserver !== "undefined" && document.body) {
                var mo = new MutationObserver(function () {
                  syncThemeColorVisuals();
                  updateColorValue();
                });
                mo.observe(document.body, { attributes: true, attributeFilter: ["class"] });
              }
              syncThemeColorVisuals();
              updateColorValue();
              updatePreview();
            })();
          </script>
        
        </div>
      </div>
    </div>

    <!-- Dashboard Bookmarks -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-bookmarks" data-settings-modal="bookmarks" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-bookmarks">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-bookmarks">Dashboard Bookmarks</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">Bookmarks visible only to global admins on the dashboard.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          <% 
            const initialBookmarks = [];
            for (let i = 1; i <= 20; i++) {
              const t = (settings[`BOOKMARK${i}_TITLE`] || "").trim();
              const u = (settings[`BOOKMARK${i}_URL`] || "").trim();
              if (!t && !u) continue;
              initialBookmarks.push({ title: t, url: u });
            }
          %>

          <div id="bookmarkEditor" style="margin-top:.5rem;">
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:.5rem;">
              <button type="button" class="btn" id="addBookmarkBtn">Add Bookmark</button>
              <small class="settings-help" id="bookmarkCountNote"></small>
            </div>

            <ul id="bookmarkList" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:.5rem;"></ul>

            <!-- Hidden fields will be generated on submit to keep settings.json format unchanged -->
            <div id="bookmarkHiddenFields"></div>
          </div>

          <script>
            (function () {
              var MAX = 20;
              var form = document.getElementById('settingsForm');
              var list = document.getElementById('bookmarkList');
              var addBtn = document.getElementById('addBookmarkBtn');
              var note = document.getElementById('bookmarkCountNote');
              var hiddenHost = document.getElementById('bookmarkHiddenFields');

              if (!form || !list || !addBtn || !hiddenHost) return;

              var initial = <%- JSON.stringify(initialBookmarks) %>;

              function updateCount() {
                var n = list.querySelectorAll('li[data-bookmark-row]').length;
                if (note) note.textContent = n + ' / ' + MAX + ' bookmarks';
                addBtn.disabled = n >= MAX;
              }

              function makeInput(placeholder, value) {
                var inp = document.createElement('input');
                inp.type = 'text';
                inp.placeholder = placeholder;
                inp.value = value || '';
                inp.style.width = '100%';
                return inp;
              }

              function createRow(bm) {
                var li = document.createElement('li');
                li.setAttribute('data-bookmark-row', '1');
                li.draggable = true;
                li.style.border = '1px solid #e5e7eb';
                li.style.borderRadius = '0.5rem';
                li.style.padding = '0.5rem';
                li.style.background = '#fff0';

                var wrap = document.createElement('div');
                wrap.style.display = 'grid';
                wrap.style.gridTemplateColumns = '32px 1fr 1fr 80px';
                wrap.style.gap = '0.5rem';
                wrap.style.alignItems = 'center';

                var handle = document.createElement('div');
                handle.title = 'Drag to reorder';
                handle.textContent = '⋮⋮';
                handle.style.cursor = 'grab';
                handle.style.userSelect = 'none';
                handle.style.fontSize = '1.2rem';
                handle.style.textAlign = 'center';

                var title = makeInput('Title', bm && bm.title);
                title.setAttribute('data-bm-title', '1');
                var url = makeInput('URL (https://...)', bm && bm.url);
                url.setAttribute('data-bm-url', '1');
                function onBookmarkEdit() {
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                }
                title.addEventListener('input', onBookmarkEdit);
                url.addEventListener('input', onBookmarkEdit);

                var del = document.createElement('button');
                del.type = 'button';
                del.className = 'btn btn-warning';
                del.textContent = 'Delete';
                del.addEventListener('click', function () {
                  li.remove();
                  updateCount();
                  onBookmarkEdit();
                });

                wrap.appendChild(handle);
                wrap.appendChild(title);
                wrap.appendChild(url);
                wrap.appendChild(del);
                li.appendChild(wrap);

                // Drag/drop
                li.addEventListener('dragstart', function (e) {
                  li.classList.add('dragging');
                  e.dataTransfer.effectAllowed = 'move';
                });
                li.addEventListener('dragend', function () {
                  li.classList.remove('dragging');
                  if (typeof window.scheduleSettingsAutoSave === "function") {
                    window.scheduleSettingsAutoSave();
                  }
                });

                return li;
              }

              function getDragAfterElement(container, y) {
                var els = [].slice.call(container.querySelectorAll('li[data-bookmark-row]:not(.dragging)'));
                return els.reduce(function (closest, child) {
                  var box = child.getBoundingClientRect();
                  var offset = y - box.top - box.height / 2;
                  if (offset < 0 && offset > closest.offset) {
                    return { offset: offset, element: child };
                  }
                  return closest;
                }, { offset: Number.NEGATIVE_INFINITY, element: null }).element;
              }

              list.addEventListener('dragover', function (e) {
                e.preventDefault();
                var dragging = list.querySelector('.dragging');
                if (!dragging) return;
                var after = getDragAfterElement(list, e.clientY);
                if (after == null) {
                  list.appendChild(dragging);
                } else {
                  list.insertBefore(dragging, after);
                }
              });

              addBtn.addEventListener('click', function () {
                var n = list.querySelectorAll('li[data-bookmark-row]').length;
                if (n >= MAX) return;
                list.appendChild(createRow({ title: '', url: '' }));
                updateCount();
              });

              // Seed
              if (Array.isArray(initial) && initial.length) {
                initial.forEach(function (bm) {
                  list.appendChild(createRow(bm));
                });
              }
              updateCount();

              // Serialize into flat settings[BOOKMARKn_*] fields for autosave / full submit.
              function serializeBookmarks() {
                hiddenHost.innerHTML = '';

                var rows = [].slice.call(list.querySelectorAll('li[data-bookmark-row]'));
                var normalized = rows
                  .map(function (li) {
                    var t = (li.querySelector('[data-bm-title]') || {}).value || '';
                    var u = (li.querySelector('[data-bm-url]') || {}).value || '';
                    return { title: String(t).trim(), url: String(u).trim() };
                  })
                  .filter(function (bm) {
                    return bm.title || bm.url;
                  });

                for (var i = 1; i <= MAX; i++) {
                  var bm = normalized[i - 1] || { title: '', url: '' };

                  var t = document.createElement('input');
                  t.type = 'hidden';
                  t.name = 'settings[BOOKMARK' + i + '_TITLE]';
                  t.value = bm.title;

                  var u = document.createElement('input');
                  u.type = 'hidden';
                  u.name = 'settings[BOOKMARK' + i + '_URL]';
                  u.value = bm.url;

                  hiddenHost.appendChild(t);
                  hiddenHost.appendChild(u);
                }
              }

              window.__settingsSerializeHooks = window.__settingsSerializeHooks || [];
              window.__settingsSerializeHooks.push(serializeBookmarks);
              form.addEventListener('submit', serializeBookmarks);
            })();
          </script>
        
        </div>
      </div>
    </div>

    <!-- Auto Create Groups / Channels -->
    <div class="modalOverlay settings-modal-overlay" id="settingsModal-auto-create-groups" data-settings-modal="auto-create-groups" style="display:none;" aria-hidden="true">
      <div class="modal settings-modal" role="dialog" aria-modal="true" aria-labelledby="settingsModalTitle-auto-create-groups">
        <div class="modalHeader">
          <div class="modalHeaderLeft">
            <h2 id="settingsModalTitle-auto-create-groups">Auto Create Groups / Channels</h2>
            <span class="settings-help-tip">
              <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
              <span class="settings-help-popover">When an agency is created, optionally auto-create Agency, County, and State groups using these titles (up to 3 each). County/State groups are created once per county/state+title and are not recreated if renamed or deleted.</span>
            </span>
          </div>
          <button type="button" class="btn settings-modal-close" data-close-settings-modal aria-label="Close">Close</button>
        </div>
        <div class="modalBody settings-body">
          <%
            function autoCreateEnabled(key, defaultOn) {
              const raw = String(settings[key] || "").trim().toLowerCase();
              if (raw === "true" || raw === "false") return raw === "true";
              return !!defaultOn;
            }
            function autoCreateTitles(prefix, defaultTitle) {
              const titles = [];
              for (let i = 1; i <= 3; i++) {
                const t = String(settings[`${prefix}_${i}`] || "").trim();
                if (t) titles.push(t);
              }
              if (!titles.length && defaultTitle) titles.push(defaultTitle);
              return titles;
            }
            const autoCreateInitial = {
              agency: {
                enabled: autoCreateEnabled("AUTO_CREATE_AGENCY_GROUPS_ENABLED", true),
                titles: autoCreateTitles("AUTO_CREATE_AGENCY_GROUP_TITLE", "Main"),
              },
              county: {
                enabled: autoCreateEnabled("AUTO_CREATE_COUNTY_GROUPS_ENABLED", false),
                titles: autoCreateTitles("AUTO_CREATE_COUNTY_GROUP_TITLE", "Interop"),
              },
              state: {
                enabled: autoCreateEnabled("AUTO_CREATE_STATE_GROUPS_ENABLED", false),
                titles: autoCreateTitles("AUTO_CREATE_STATE_GROUP_TITLE", "Interop"),
              },
            };
          %>

          <div id="autoCreateGroupsEditor">
            <div class="settings-auto-create-section" data-acg-type="agency">
              <div class="settings-auto-create-header">
                <h3>Agency Specific Groups</h3>
                <button type="button" class="settings-toggle is-on" data-acg-toggle aria-pressed="true" aria-label="Toggle agency specific groups"></button>
              </div>
              <div class="settings-auto-create-body" data-acg-body>
                <div class="settings-auto-create-titles" data-acg-titles></div>
                <div class="settings-auto-create-actions">
                  <button type="button" class="btn" data-acg-add>Add Additional Groups</button>
                </div>
              </div>
            </div>

            <div class="settings-auto-create-section" data-acg-type="county">
              <div class="settings-auto-create-header">
                <h3>County Specific Groups</h3>
                <button type="button" class="settings-toggle is-off" data-acg-toggle aria-pressed="false" aria-label="Toggle county specific groups"></button>
              </div>
              <div class="settings-auto-create-body" data-acg-body>
                <div class="settings-auto-create-titles" data-acg-titles></div>
                <div class="settings-auto-create-actions">
                  <button type="button" class="btn" data-acg-add>Add Additional Groups</button>
                </div>
              </div>
            </div>

            <div class="settings-auto-create-section" data-acg-type="state">
              <div class="settings-auto-create-header">
                <h3>State Specific Groups</h3>
                <button type="button" class="settings-toggle is-off" data-acg-toggle aria-pressed="false" aria-label="Toggle state specific groups"></button>
              </div>
              <div class="settings-auto-create-body" data-acg-body>
                <div class="settings-auto-create-titles" data-acg-titles></div>
                <div class="settings-auto-create-actions">
                  <button type="button" class="btn" data-acg-add>Add Additional Groups</button>
                </div>
              </div>
            </div>

            <div id="autoCreateGroupsHiddenFields"></div>
          </div>

          <script>
            (function () {
              var MAX = 3;
              var form = document.getElementById('settingsForm');
              var editor = document.getElementById('autoCreateGroupsEditor');
              var hiddenHost = document.getElementById('autoCreateGroupsHiddenFields');
              if (!form || !editor || !hiddenHost) return;

              var initial = <%- JSON.stringify(autoCreateInitial) %>;
              var defaults = { agency: 'Main', county: 'Interop', state: 'Interop' };
              var prefixes = {
                agency: 'AUTO_CREATE_AGENCY',
                county: 'AUTO_CREATE_COUNTY',
                state: 'AUTO_CREATE_STATE'
              };

              function sectionEl(type) {
                return editor.querySelector('[data-acg-type="' + type + '"]');
              }

              function setToggle(btn, on) {
                btn.classList.toggle('is-on', !!on);
                btn.classList.toggle('is-off', !on);
                btn.setAttribute('aria-pressed', on ? 'true' : 'false');
              }

              function isOn(btn) {
                return btn.classList.contains('is-on');
              }

              function updateSectionUi(section) {
                var n = section.querySelectorAll('[data-acg-row]').length;
                var addBtn = section.querySelector('[data-acg-add]');
                var body = section.querySelector('[data-acg-body]');
                var enabled = isOn(section.querySelector('[data-acg-toggle]'));
                if (body) body.style.display = enabled ? '' : 'none';
                if (addBtn) addBtn.style.display = n >= MAX ? 'none' : '';
                section.querySelectorAll('[data-acg-remove]').forEach(function (btn) {
                  btn.style.display = n <= 1 ? 'none' : '';
                });
              }

              function createRow(section, value) {
                var list = section.querySelector('[data-acg-titles]');
                var row = document.createElement('div');
                row.className = 'settings-auto-create-row';
                row.setAttribute('data-acg-row', '1');

                var input = document.createElement('input');
                input.type = 'text';
                input.placeholder = 'Group title';
                input.value = value || '';
                input.setAttribute('data-acg-title', '1');

                var remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'btn caution';
                remove.setAttribute('data-acg-remove', '1');
                remove.setAttribute('aria-label', 'Remove title');
                remove.textContent = 'Remove';

                input.addEventListener('input', function () {
                  if (typeof window.scheduleSettingsAutoSave === 'function') {
                    window.scheduleSettingsAutoSave();
                  }
                });
                remove.addEventListener('click', function () {
                  var rows = section.querySelectorAll('[data-acg-row]');
                  if (rows.length <= 1) return;
                  row.remove();
                  updateSectionUi(section);
                  if (typeof window.scheduleSettingsAutoSave === 'function') {
                    window.scheduleSettingsAutoSave();
                  }
                });

                row.appendChild(input);
                row.appendChild(remove);
                list.appendChild(row);
                updateSectionUi(section);
              }

              function initSection(type) {
                var section = sectionEl(type);
                if (!section) return;
                var conf = initial[type] || {};
                var toggle = section.querySelector('[data-acg-toggle]');
                setToggle(toggle, !!conf.enabled);
                toggle.addEventListener('click', function () {
                  setToggle(toggle, !isOn(toggle));
                  updateSectionUi(section);
                  if (typeof window.scheduleSettingsAutoSave === 'function') {
                    window.scheduleSettingsAutoSave();
                  }
                });

                var titles = Array.isArray(conf.titles) && conf.titles.length
                  ? conf.titles.slice(0, MAX)
                  : [defaults[type]];
                titles.forEach(function (t) { createRow(section, t); });
                updateSectionUi(section);

                section.querySelector('[data-acg-add]').addEventListener('click', function () {
                  var n = section.querySelectorAll('[data-acg-row]').length;
                  if (n >= MAX) return;
                  createRow(section, '');
                  if (typeof window.scheduleSettingsAutoSave === 'function') {
                    window.scheduleSettingsAutoSave();
                  }
                });
              }

              ['agency', 'county', 'state'].forEach(initSection);

              function serializeAutoCreateGroups() {
                hiddenHost.innerHTML = '';

                ['agency', 'county', 'state'].forEach(function (type) {
                  var section = sectionEl(type);
                  if (!section) return;
                  var prefix = prefixes[type];
                  var enabled = isOn(section.querySelector('[data-acg-toggle]'));

                  var en = document.createElement('input');
                  en.type = 'hidden';
                  en.name = 'settings[' + prefix + '_GROUPS_ENABLED]';
                  en.value = enabled ? 'true' : 'false';
                  hiddenHost.appendChild(en);

                  var rows = [].slice.call(section.querySelectorAll('[data-acg-row]'));
                  var titles = rows
                    .map(function (row) {
                      return String((row.querySelector('[data-acg-title]') || {}).value || '').trim();
                    })
                    .filter(Boolean)
                    .slice(0, MAX);

                  // Keep at least the default title slot value when enabled with empty inputs
                  if (!titles.length && enabled) {
                    titles = [defaults[type]];
                  }

                  for (var i = 1; i <= MAX; i++) {
                    var inp = document.createElement('input');
                    inp.type = 'hidden';
                    inp.name = 'settings[' + prefix + '_GROUP_TITLE_' + i + ']';
                    inp.value = titles[i - 1] || '';
                    hiddenHost.appendChild(inp);
                  }
                });
              }

              window.__settingsSerializeHooks = window.__settingsSerializeHooks || [];
              window.__settingsSerializeHooks.push(serializeAutoCreateGroups);
              form.addEventListener('submit', serializeAutoCreateGroups);
            })();
          </script>
        </div>
      </div>
    </div>

