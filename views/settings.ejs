        </div>
        <div class="modalBody settings-body">
          <div class="grid2">
            <% renderField("LIVE_MAP_ENABLED","Enable Live Map","When off, the Live Map page is hidden and map-only services stop (live stream, geofences, mission and package overlays). The dashboard connected-client mini map still works.","true"); %>
            <label class="settings-field">
              <span class="settings-label">
                <span>Default Map Source</span>
                <span class="settings-help-tip">
                  <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
                  <span class="settings-help-popover">First-load basemap for /map and the dashboard connected-user mini map when a user has not chosen their own on this device.</span>
                </span>
              </span>
              <%
                const defaultMapSourceSetting = String(
                  settings.DEFAULT_MAP_SOURCE || "dark-matter"
                );
                const basemapOpts = Array.isArray(mapBasemapOptions) ? mapBasemapOptions : [];
              %>
              <select name="settings[DEFAULT_MAP_SOURCE]">
                <% basemapOpts.forEach(function (opt) { %>
                  <option
                    value="<%= opt.id %>"
                    <%= defaultMapSourceSetting === opt.id ? "selected" : "" %>
