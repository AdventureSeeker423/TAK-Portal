          </label>

          <div style="margin-top:1rem;display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;">
            <button
              type="submit"
              class="btn"
              formaction="/settings/test-sms"
              formmethod="post"
              name="_testSms"
              value="1"
            >Send test SMS</button>
          </div>
          <span class="settings-help-tip" style="margin-top:0.5rem;">
            <button type="button" class="settings-help-btn" aria-label="Help" aria-expanded="false">?</button>
