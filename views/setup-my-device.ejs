<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<style>
@media (max-width: 990px) {
  #preferenceQrOverlay .row > div {
    min-width: 0 !important;
    flex: 1 1 100%;
    max-width: 100%;
  }
  #preferenceQrOverlay .row .btn {
    width: 100%;
  }
}
</style>

<main class="main">
  <h1>Setup My Device</h1>
  <%
    function allowedClientBool(key, defaultOn) {
      const raw = String((settings && settings[key]) || "").trim().toLowerCase();
      if (raw === "true") return true;
      if (raw === "false") return false;
      return !!defaultOn;
    }
    const cloudtakUrlTrimmed = (settings && typeof settings.CLOUDTAK_URL === "string")
      ? settings.CLOUDTAK_URL.trim()
      : "";
    const showTakAware = allowedClientBool("ALLOWED_CLIENT_TAK_AWARE", true);
    const showTakTracker = allowedClientBool("ALLOWED_CLIENT_TAK_TRACKER", true);
    const showITakLinks = allowedClientBool("SHOW_ITAK_LINKS", false);
    const showAtak = allowedClientBool("ALLOWED_CLIENT_ATAK", true);
    const liveMapGloballyEnabled = allowedClientBool("LIVE_MAP_ENABLED", true);
    const showLiveMap =
      liveMapGloballyEnabled && allowedClientBool("ALLOWED_CLIENT_LIVE_MAP", true);
    const showCloudTakEnabled = allowedClientBool(
      "ALLOWED_CLIENT_CLOUDTAK",
      !!cloudtakUrlTrimmed
    );
    const showCloudTak = showCloudTakEnabled && !!cloudtakUrlTrimmed;
    const sshConfiguredForClients = typeof sshConfigured !== "undefined" && !!sshConfigured;
    const showDataPackage =
      allowedClientBool("ALLOWED_CLIENT_DATA_PACKAGE", false) && sshConfiguredForClients;
    const showIosPlatform = showTakAware || showTakTracker || showITakLinks;
    const showAndroidPlatform = showAtak;
    const showWebPlatform = showLiveMap || showCloudTak;
    const showPcPlatform = showDataPackage;
    const platformCount =
      (showIosPlatform ? 1 : 0) +
      (showAndroidPlatform ? 1 : 0) +
      (showWebPlatform ? 1 : 0) +
      (showPcPlatform ? 1 : 0);
    const platformGridClass =
      platformCount >= 4 ? "grid4" :
      platformCount >= 3 ? "grid3" :
      platformCount === 2 ? "grid2" :
      "grid1";
    const iosAppCount =
      (showTakAware ? 1 : 0) +
      (showTakTracker ? 1 : 0) +
      (showITakLinks ? 1 : 0);
    const iosGridClass =
      iosAppCount >= 3 ? "iosSetupGrid--three" :
      iosAppCount === 2 ? "iosSetupGrid--two" :
      "iosSetupGrid--one";
    const webAppCount =
      (showLiveMap ? 1 : 0) +
      (showCloudTak ? 1 : 0);
    const webGridClass =
      webAppCount >= 2 ? "iosSetupGrid--two" :
      "iosSetupGrid--one";

    function recommendedApp(key, defaultApp) {
      if (settings && Object.prototype.hasOwnProperty.call(settings, key)) {
        return String(settings[key] || "").trim();
      }
      return defaultApp || "";
    }
    const recommendedIos = recommendedApp("ALLOWED_CLIENT_RECOMMENDED_IOS", "tak_aware");
    const recommendedAndroid = recommendedApp("ALLOWED_CLIENT_RECOMMENDED_ANDROID", "");
    const recommendedWeb = recommendedApp("ALLOWED_CLIENT_RECOMMENDED_WEB", "");
    const recommendedPc = recommendedApp("ALLOWED_CLIENT_RECOMMENDED_PC", "");
    const recommendTakAware = recommendedIos === "tak_aware";
    const recommendTakTracker = recommendedIos === "tak_tracker";
    const recommendITak = recommendedIos === "itak";
    const recommendAtak = recommendedAndroid === "atak";
    const recommendLiveMap = recommendedWeb === "live_map";
    const recommendCloudTak = recommendedWeb === "cloudtak";
    const recommendDataPackage = recommendedPc === "data_package";
    const webPlatformDesc =
      showLiveMap && showCloudTak
        ? "Use TAK Portal Live Map or CloudTAK in a web browser."
        : showLiveMap
          ? "Use TAK Portal Live Map in a web browser."
          : "Use CloudTAK on web browsers.";

    function parseClientOrder(key, defaults, insertMissingAtStart) {
      const known = defaults.slice();
      const knownSet = new Set(known);
      const raw = (settings && typeof settings[key] === "string") ? settings[key] : "";
      const parsed = String(raw)
        .split(",")
        .map((s) => s.trim())
        .filter((id) => id && knownSet.has(id));
      const missing = known.filter((id) => !parsed.includes(id));
      return insertMissingAtStart ? missing.concat(parsed) : parsed.concat(missing);
    }
    const iosOrder = parseClientOrder(
      "ALLOWED_CLIENT_ORDER_IOS",
      ["tak_aware", "tak_tracker", "itak"]
    ).filter((id) =>
      (id === "tak_aware" && showTakAware) ||
      (id === "tak_tracker" && showTakTracker) ||
      (id === "itak" && showITakLinks)
    );
    const androidOrder = parseClientOrder(
      "ALLOWED_CLIENT_ORDER_ANDROID",
      ["atak"]
    ).filter((id) => id === "atak" && showAtak);
    const webOrder = parseClientOrder(
      "ALLOWED_CLIENT_ORDER_WEB",
      ["live_map", "cloudtak"],
      true
    ).filter((id) =>
      (id === "live_map" && showLiveMap) ||
      (id === "cloudtak" && showCloudTak)
    );
  %>

  <!-- Device selector -->
  <div class="card" id="deviceSelectCard">
    <h2>Select Your Device Type</h2>

    <% if (platformCount === 0) { %>
      <p class="msg">No supported TAK clients are currently enabled. Contact your administrator.</p>
    <% } else { %>
    <div class="<%= platformGridClass %>">
      <% if (showIosPlatform) { %>
      <button type="button" class="btn tile deviceTile deviceTile-ios" id="selectIOS">
        <span class="title">Apple (iPhone / iPad)</span>
        <span class="desc">Use TAK Aware or TAK Tracker on iOS devices.</span>
      </button>
      <% } %>

      <% if (showAndroidPlatform) { %>
      <button type="button" class="btn tile deviceTile deviceTile-android" id="selectAndroid">
        <span class="title">Android (Phone / Tablet)</span>
        <span class="desc">Use ATAK on Android devices.</span>
      </button>
      <% } %>

      <% if (showWebPlatform) { %>
        <button type="button" class="btn tile deviceTile deviceTile-web" id="selectWeb">
          <span class="title">Web Browser</span>
          <span class="desc"><%= webPlatformDesc %></span>
        </button>
      <% } %>

      <% if (showPcPlatform) { %>
        <button type="button" class="btn tile deviceTile deviceTile-pc" id="selectPC">
          <span class="title">PC</span>
          <span class="desc">Use a TAK data package on Windows.</span>
        </button>
      <% } %>
    </div>
    <% } %>
  </div>

  <!-- iOS flow: one card per app; steps 1–3 stacked vertically inside -->
  <% if (showIosPlatform) { %>
  <div id="iosFlow" style="display:none;">
    <div class="iosSetupGrid <%= iosGridClass %>" style="margin-top: 0.5rem;">
      <% iosOrder.forEach(function (appId) { %>
        <% if (appId === "tak_aware") { %>
      <!-- TAK Aware -->
      <div class="card iosAppGroup">
        <h2 class="iosAppGroupTitle">TAK Aware</h2>

        <section class="iosStep">
          <h3 class="iosStepHeading">Step 1: Download TAK Aware</h3>
          <a
            href="https://apps.apple.com/us/app/tak-aware/id6738631659"
            target="_blank"
            rel="noopener noreferrer"
            class="btn tile<%= recommendTakAware ? ' success' : '' %>"
          >
            <span class="title">iOS - TAK Aware<%= recommendTakAware ? ' (Recommended)' : '' %></span>
            <span class="desc">Download TAK Aware for iPhone or iPad.</span>
          </a>
        </section>

        <section class="iosStep">
          <h3 class="iosStepHeading">Step 2: Enroll your device</h3>
          <div class="grid2">
            <button type="button" class="btn tile" id="scanQrBtnTakAware">
              <span class="title">Open In App or Scan QR (Recommended)</span>
              <span class="desc">Scan an enrollment QR code to automatically connect TAK Aware.</span>
            </button>
            <button type="button" class="btn tile" id="manualLoginBtnTakAware">
              <span class="title">Manual Enrollment</span>
              <span class="desc">Manually connect TAK Aware to the TAK Server.</span>
            </button>
          </div>
        </section>

        <section class="iosStep">
          <h3 class="iosStepHeading">Step 3: Configure device preferences</h3>
          <div class="grid2">
            <button type="button" class="btn tile" id="preferenceScanQrBtnTakAware">
              <span class="title">Open In App or Scan QR (Recommended)</span>
              <span class="desc">Scan a QR code to automatically configure TAK Aware preferences.</span>
            </button>
            <button type="button" class="btn tile" id="preferenceManualBtnTakAware">
              <span class="title">Manual Configuration</span>
              <span class="desc">Manually configure TAK Aware preferences.</span>
            </button>
          </div>
        </section>
      </div>
        <% } else if (appId === "tak_tracker") { %>
      <!-- TAK Tracker -->
      <div class="card iosAppGroup">
        <h2 class="iosAppGroupTitle">TAK Tracker</h2>

        <section class="iosStep">
          <h3 class="iosStepHeading">Step 1: Download TAK Tracker</h3>
          <a
            href="https://apps.apple.com/us/app/tak-tracker/id6455684671"
            target="_blank"
            rel="noopener noreferrer"
            class="btn tile<%= recommendTakTracker ? ' success' : '' %>"
          >
            <span class="title">iOS - TAK Tracker<%= recommendTakTracker ? ' (Recommended)' : '' %></span>
            <span class="desc">Download TAK Tracker for iPhone or iPad. (Tracking Only, No Map)</span>
          </a>
        </section>

        <section class="iosStep">
          <h3 class="iosStepHeading">Step 2: Enroll your device</h3>
          <div class="grid2">
            <button type="button" class="btn tile" id="scanQrBtnTakTracker">
              <span class="title">Open In App or Scan QR (Recommended)</span>
              <span class="desc">Scan an enrollment QR code to automatically connect TAK Tracker.</span>
            </button>
            <button type="button" class="btn tile" id="manualLoginBtnTakTracker">
              <span class="title">Manual Enrollment</span>
              <span class="desc">Manually connect TAK Tracker to the TAK Server.</span>
            </button>
          </div>
        </section>
      </div>
        <% } else if (appId === "itak") { %>
        <div class="card iosAppGroup">
          <h2 class="iosAppGroupTitle">iTAK</h2>

          <section class="iosStep">
            <h3 class="iosStepHeading">Step 1: Download iTAK</h3>
            <a
              href="https://apps.apple.com/us/app/itak/id1561656396"
              target="_blank"
              rel="noopener noreferrer"
              class="btn tile<%= recommendITak ? ' success' : '' %>"
            >
              <span class="title">iOS - iTAK<%= recommendITak ? ' (Recommended)' : '' %></span>
              <span class="desc">Download iTAK for iPhone or iPad.</span>
            </a>
          </section>

          <section class="iosStep">
            <h3 class="iosStepHeading">Step 2: Enroll your device</h3>
            <div class="grid2">
              <button type="button" class="btn tile" id="scanQrBtnITak">
                <span class="title">Open In App or Scan QR (Recommended)</span>
                <span class="desc">Scan an enrollment QR code to automatically connect iTAK.</span>
              </button>
              <button type="button" class="btn tile" id="manualLoginBtnITak">
                <span class="title">Manual Enrollment</span>
                <span class="desc">Manually connect iTAK to the TAK Server.</span>
              </button>
            </div>
          </section>
        </div>
        <% } %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <!-- Android flow: ATAK steps stacked vertically (same pattern as iOS) -->
  <% if (showAndroidPlatform) { %>
  <div id="androidFlow" style="display:none;">
    <% androidOrder.forEach(function (appId) { %>
      <% if (appId === "atak") { %>
    <div class="card iosAppGroup" style="margin-top: 0.5rem;">
      <h2 class="iosAppGroupTitle">ATAK</h2>

      <section class="iosStep">
        <h3 class="iosStepHeading">Step 1: Download ATAK</h3>
        <%
          const atakApkInfo =
            typeof atakApk !== "undefined" && atakApk && typeof atakApk === "object"
              ? atakApk
              : null;
          const atakApkUploaded = !!(atakApkInfo && atakApkInfo.uploaded && atakApkInfo.downloadUrl);
          const atakDownloadHref = atakApkUploaded
            ? atakApkInfo.downloadUrl
            : "https://play.google.com/store/apps/details?id=com.atakmap.app.civ";
          const atakDownloadTitle = atakApkUploaded
            ? "Download ATAK"
            : "Android - ATAK";
          const atakDownloadDesc = atakApkUploaded
            ? "Download the ATAK APK hosted by this portal."
            : "Download ATAK for Android devices.";
        %>
        <a
          href="<%= atakDownloadHref %>"
          <% if (!atakApkUploaded) { %>target="_blank" rel="noopener noreferrer"<% } %>
          class="btn tile<%= recommendAtak ? ' success' : '' %>"
          <%= atakApkUploaded ? 'download' : '' %>
        >
          <span class="title"><%= atakDownloadTitle %><%= recommendAtak ? ' (Recommended)' : '' %></span>
          <span class="desc"><%= atakDownloadDesc %></span>
        </a>
      </section>

      <section class="iosStep">
        <h3 class="iosStepHeading">Step 2: Enroll your device</h3>
        <div class="grid2">
          <button type="button" class="btn tile" id="scanQrBtnAtak">
            <span class="title">Open In App or Scan QR (Recommended)</span>
            <span class="desc">Scan an enrollment QR code to automatically connect ATAK.</span>
          </button>
          <button type="button" class="btn tile" id="manualLoginBtnAtak">
            <span class="title">Manual Enrollment</span>
            <span class="desc">Manually connect ATAK to the TAK Server.</span>
          </button>
        </div>
      </section>

      <section class="iosStep">
        <h3 class="iosStepHeading">Step 3: Configure device preferences</h3>
        <div class="grid2">
          <button type="button" class="btn tile" id="preferenceScanQrBtn">
            <span class="title">Open In App or Scan QR (Recommended)</span>
            <span class="desc">Scan a QR code to automatically configure ATAK preferences.</span>
          </button>
          <button type="button" class="btn tile" id="preferenceManualBtn">
            <span class="title">Manual Configuration</span>
            <span class="desc">Manually configure ATAK preferences.</span>
          </button>
        </div>
      </section>

      <section class="iosStep">
        <h3 class="iosStepHeading">Step 4: Install plugins</h3>
        <a href="/plugins" class="btn tile">
          <span class="title">Browse &amp; Install Plugins</span>
          <span class="desc">Open the Plugins page to download and install ATAK plugins to improve your experience.</span>
        </a>
      </section>
    </div>
      <% } %>
    <% }); %>
  </div>
  <% } %>

  <% if (showWebPlatform) { %>
  <div id="webFlow" style="display:none;">
    <div class="iosSetupGrid <%= webGridClass %>" style="margin-top: 0.5rem;">
      <% webOrder.forEach(function (appId) { %>
        <% if (appId === "live_map") { %>
      <div class="card iosAppGroup">
        <h2 class="iosAppGroupTitle">TAK Portal Live Map</h2>
        <section class="iosStep">
          <h3 class="iosStepHeading">Open in browser</h3>
          <a
            href="/map"
            class="btn tile<%= recommendLiveMap ? ' success' : '' %>"
          >
            <span class="title">TAK Portal Live Map<%= recommendLiveMap ? ' (Recommended)' : '' %></span>
            <span class="desc">View live TAK positions in your browser. (View only — does not share your location or send map items.)</span>
          </a>
        </section>
      </div>
        <% } else if (appId === "cloudtak") { %>
      <div class="card iosAppGroup">
        <h2 class="iosAppGroupTitle">CloudTAK</h2>
        <section class="iosStep">
          <h3 class="iosStepHeading">Open in browser</h3>
          <a
            href="<%= cloudtakUrlTrimmed %>"
            target="_blank"
            rel="noopener noreferrer"
            class="btn tile<%= recommendCloudTak ? ' success' : '' %>"
          >
            <span class="title">CloudTAK<%= recommendCloudTak ? ' (Recommended)' : '' %></span>
            <span class="desc">Open CloudTAK in a web browser for a full TAK client experience.</span>
          </a>
        </section>
      </div>
        <% } %>
      <% }); %>
    </div>
  </div>
  <% } %>

  <% if (showPcPlatform) { %>
  <div id="pcFlow" style="display:none;">
    <div class="card iosAppGroup" style="margin-top: 0.5rem;">
      <h2 class="iosAppGroupTitle">Data Package</h2>
      <section class="iosStep">
        <h3 class="iosStepHeading">Download and import</h3>
        <a
          href="/api/setup-my-device/data-package"
          class="btn tile<%= recommendDataPackage ? ' success' : '' %>"
          id="downloadDataPackageBtn"
        >
          <span class="title">Download Data Package<%= recommendDataPackage ? ' (Recommended)' : '' %></span>
          <span class="desc">Import the ZIP in WinTAK (Import File or drag-and-drop), then sign in with your portal credentials.</span>
        </a>
      </section>
    </div>
  </div>
  <% } %>
</main>

<%- include("partials/mou_user_agreement_modal") %>

<!-- QR Modal -->
<div class="modalOverlay" id="setupQrOverlay" style="display:none;">
  <div class="modal setupQrModal" role="dialog" aria-modal="true" aria-labelledby="setupQrTitle">
    <div class="modalHeader">
      <h2 id="setupQrTitle" style="margin:0;">Enrollment QR Code</h2>
      <button class="btn" id="setupQrCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <div class="setupQrModalLayout">
        <div class="setupQrModalQrCol">
          <img id="setupQrImg" class="setupQrModalImg" alt="Enrollment QR Code" />
          <div class="setupQrModalActions">
            <span id="setupQrEnrollUrlHolder" data-enroll-url="" style="display:none;" aria-hidden="true"></span>
            <button class="btn success btnOpenInApp" type="button" id="setupQrOpenBtn" disabled>Open In App</button>
            <button class="btn" type="button" id="setupQrCopyBtn" disabled>Copy URL</button>
          </div>
        </div>
        <div class="setupQrModalInfoCol">
          <h3 id="setupQrInstructionsTitle">How to Scan</h3>
          <ol id="setupQrInstructions"></ol>
          <h3>Details</h3>
          <div class="chips" id="setupQrDetails"></div>
          <div id="setupQrCountdown" class="msg setupQrModalCountdown"></div>
          <div id="setupQrMsg" class="msg"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Manual Enrollment Modal -->
<div class="modalOverlay" id="manualLoginOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="manualLoginTitle">
    <div class="modalHeader">
      <h2 id="manualLoginTitle" style="margin:0;">Manual Enrollment Instructions</h2>
      <button class="btn" id="manualLoginCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <div style="max-width: 600px;">
        <h3 style="margin-top:0;" id="manualLoginInstructionsTitle">How to Manually Configure</h3>
        <ol id="manualLoginInstructions" style="margin-top: 6px;"></ol>
        <h3 style="margin-top:0;">Details</h3>
        <div class="chips" id="manualLoginDetails"></div>
      </div>
    </div>
  </div>
</div>

<!-- Preference QR Modal (Android Step 3) -->
<div class="modalOverlay" id="preferenceQrOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="preferenceQrTitle">
    <div class="modalHeader">
      <h2 id="preferenceQrTitle" style="margin:0;">Configure Device Preferences</h2>
      <button class="btn" id="preferenceQrCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <div class="row" style="gap: 24px; align-items: flex-start; flex-wrap: wrap;">
        <div style="text-align:center; min-width: 260px;">
          <img id="preferenceQrImg" alt="Preference QR Code" style="max-width: 280px; width: 100%; height: auto; border-radius: 14px;" />
          <div class="row" style="gap: 10px; margin-top: 14px; justify-content: center;">
            <span id="preferenceQrUrlHolder" data-preference-url="" style="display:none;" aria-hidden="true"></span>
            <button class="btn success btnOpenInApp" type="button" id="preferenceQrOpenBtn" disabled>Open In App</button>
            <button class="btn" type="button" id="preferenceQrCopyBtn" disabled>Copy URL</button>
          </div>
        </div>
        <div style="min-width: 320px;">
          <h3 style="margin-top:0;">How to Scan</h3>
          <ol id="preferenceQrInstructions" style="margin-top: 6px;">
            <li>Open the camera on your Android device.</li>
            <li>Point your camera at the QR code and select the notification to open the link.</li>
            <li>Select Yes to apply the configuration inside ATAK.</li>
          </ol>
          <h3 style="margin-top:0;">Details</h3>
          <div id="preferenceQrDetails" style="display:flex; flex-direction:column; gap:6px;"></div>
          <div id="preferenceQrMsg" class="msg"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Manual Preference Modal (Android Step 3) -->
<div class="modalOverlay" id="preferenceManualOverlay" style="display:none;">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="preferenceManualTitle">
    <div class="modalHeader">
      <h2 id="preferenceManualTitle" style="margin:0;">Manual Configuration</h2>
      <button class="btn" id="preferenceManualCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <div style="max-width: 600px;">
        <h3 id="preferenceManualSubtitle" style="margin-top:0;">Configure callsign and team in ATAK</h3>
        <ol id="preferenceManualInstructions" style="margin-top: 6px;"></ol>
      </div>
    </div>
  </div>
</div>

<script>
  const showITakLinks = <%- JSON.stringify(showITakLinks) %>;
  const showTakAware = <%- JSON.stringify(showTakAware) %>;
  const showTakTracker = <%- JSON.stringify(showTakTracker) %>;
  const showAtak = <%- JSON.stringify(showAtak) %>;
  const iosOrder = <%- JSON.stringify(iosOrder) %>;

  // --- device selection UI (NO persistence; forgets on reload) ---
  const iosFlow = document.getElementById("iosFlow");
  const androidFlow = document.getElementById("androidFlow");
  const webFlow = document.getElementById("webFlow");
  const pcFlow = document.getElementById("pcFlow");
  const selectIOS = document.getElementById("selectIOS");
  const selectAndroid = document.getElementById("selectAndroid");
  const selectWeb = document.getElementById("selectWeb");
  const selectPC = document.getElementById("selectPC");

  function hideDeviceFlows() {
    if (iosFlow) iosFlow.style.display = "none";
    if (androidFlow) androidFlow.style.display = "none";
    if (webFlow) webFlow.style.display = "none";
    if (pcFlow) pcFlow.style.display = "none";
  }

  function showIOS() {
    if (!iosFlow) return;
    hideDeviceFlows();
    iosFlow.style.display = "block";
    const firstIos = Array.isArray(iosOrder) && iosOrder.length ? iosOrder[0] : "";
    if (firstIos === "tak_aware") setScanInstructions("takaware");
    else if (firstIos === "tak_tracker") setScanInstructions("taktracker");
    else if (firstIos === "itak") setScanInstructions("itak");
    else if (showTakAware) setScanInstructions("takaware");
    else if (showTakTracker) setScanInstructions("taktracker");
    else if (showITakLinks) setScanInstructions("itak");
    // optional: scroll to the revealed content
    iosFlow.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function showAndroid() {
    if (!androidFlow) return;
    hideDeviceFlows();
    androidFlow.style.display = "block";
    setScanInstructions("atak");
    androidFlow.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function showWeb() {
    if (!webFlow) return;
    hideDeviceFlows();
    webFlow.style.display = "block";
    webFlow.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function showPC() {
    if (!pcFlow) return;
    hideDeviceFlows();
    pcFlow.style.display = "block";
    pcFlow.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // On load: always start with chooser only
  (function resetOnLoad() {
    hideDeviceFlows();
  })();

  if (selectIOS) selectIOS.addEventListener("click", showIOS);
  if (selectAndroid) selectAndroid.addEventListener("click", showAndroid);
  if (selectWeb) selectWeb.addEventListener("click", showWeb);
  if (selectPC) selectPC.addEventListener("click", showPC);

  // --- QR modal + enrollment logic ---
