  // --- IMPORTANT: make cache user-specific to prevent cross-user QR reuse ---
  const CURRENT_USERNAME = "<%= (authUser && authUser.username) ? authUser.username : '' %>";
  const TAK_HOST = <%- JSON.stringify(takHost || "your TAK server hostname") %>;
  const CACHE_KEY = CURRENT_USERNAME ? `takPortal.setupDevice.enrollQr.v1:${CURRENT_USERNAME}` : null;
  const LEGACY_CACHE_KEY = "takPortal.setupDevice.enrollQr.v1";
  const SERVER_ENROLL_BOOTSTRAP = <%- JSON.stringify(typeof enrollQrBootstrap !== "undefined" && enrollQrBootstrap ? enrollQrBootstrap : null) %>;

  let cached = null; // { username, token, expiresAt, enrollUrl, qrCode }
  let countdownTimer = null;

  function setMsg(el, text, ok = true) {
    el.textContent = text || "";
    el.className = "msg " + (ok ? "ok" : "bad");
  }

  function safeParseJson(s) {
    try { return JSON.parse(s); } catch { return null; }
  }

  function isValidCacheObject(obj) {
    if (!obj || !obj.expiresAt) return false;
    const exp = new Date(obj.expiresAt);
    if (Number.isNaN(exp.getTime())) return false;
    if (Date.now() >= exp.getTime()) return false;
    return true;
  }

  function loadCache() {
    // Clean up old global key if it exists (prevents surprises)
    try {
      const legacy = localStorage.getItem(LEGACY_CACHE_KEY);
      if (legacy) localStorage.removeItem(LEGACY_CACHE_KEY);
    } catch {}

    if (!CACHE_KEY) return null;

    const raw = localStorage.getItem(CACHE_KEY);
    const obj = raw ? safeParseJson(raw) : null;
    if (!isValidCacheObject(obj)) return null;

    // Hard safety: don't ever reuse another user's cached QR
    if (obj.username && CURRENT_USERNAME && obj.username !== CURRENT_USERNAME) {
      try { localStorage.removeItem(CACHE_KEY); } catch {}
      return null;
    }

    // If we couldn't determine current username, be conservative and do not reuse cache
    if (!CURRENT_USERNAME) return null;

    return obj;
  }

  function saveCache(obj) {
    if (!CACHE_KEY) return; // if username unknown, do not cache
    if (!obj || !obj.username || obj.username !== CURRENT_USERNAME) return;
    try { localStorage.setItem(CACHE_KEY, JSON.stringify(obj)); } catch {}
  }

  // Server-rendered enrollment payload (same as POST /api/setup-my-device/enroll-qr) so the
  // first QR open after page load does not depend on fetch (avoids proxy/session/CORS edge cases).
  (function seedEnrollFromServer() {
    if (!SERVER_ENROLL_BOOTSTRAP || !CURRENT_USERNAME) return;
    if (SERVER_ENROLL_BOOTSTRAP.username !== CURRENT_USERNAME) return;
    if (!isValidCacheObject(SERVER_ENROLL_BOOTSTRAP)) return;
    saveCache(SERVER_ENROLL_BOOTSTRAP);
    cached = SERVER_ENROLL_BOOTSTRAP;
  })();

  function clearCountdown() {
    if (countdownTimer) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
  }

  function fmtRemain(ms) {
    const total = Math.max(0, Math.floor(ms / 1000));
    const m = Math.floor(total / 60);
    const s = total % 60;
    return String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
  }

  function startCountdown(expiresAt) {
    clearCountdown();
    const exp = new Date(expiresAt);

    const tick = () => {
      const remain = exp.getTime() - Date.now();
      if (remain <= 0) {
        countdownEl.textContent = "QR Code Expired";
        if (enrollUrlHolder) enrollUrlHolder.dataset.enrollUrl = "";
        openUrlBtn.disabled = true;
        copyBtn.disabled = true;
        setMsg(msg, "This enrollment QR has expired. Click Scan QR Code to generate a new one.", false);
        clearCountdown();
        return;
      }
      countdownEl.textContent = "QR Code Expires In: " + fmtRemain(remain);
    };

    tick();
    countdownTimer = setInterval(tick, 1000);
  }

  async function copyToClipboard(text) {
    try {
      await navigator.clipboard.writeText(text);
      setMsg(msg, "Copied!", true);
    } catch (e) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      setMsg(msg, "Copied!", true);
    }
  }

  function openModal() {
    overlay.style.display = "flex";
    document.body.classList.add("noScroll");
  }

  function closeModal() {
    overlay.style.display = "none";
    document.body.classList.remove("noScroll");
    clearCountdown();
  }

  function openManualLoginModal() {
    manualLoginOverlay.style.display = "flex";
    document.body.classList.add("noScroll");
  }

  function closeManualLoginModal() {
    manualLoginOverlay.style.display = "none";
    document.body.classList.remove("noScroll");
  }

  function renderQrDetailsChips(obj) {
    const chips = [];
    if (obj && obj.username) {
      chips.push(`<span class="chip">User: ${escapeHtml(obj.username)}</span>`);
    }
    details.innerHTML = chips.join(" ");
  }

  function syncQrActionButtons(mode, obj) {
    const isItak = mode === "itak";
    let url = (obj.enrollUrl && String(obj.enrollUrl).trim()) || "";
    if (isItak && obj.itakPayload) {
      url = String(obj.itakPayload).trim();
    }
    if (enrollUrlHolder) enrollUrlHolder.dataset.enrollUrl = url;

    if (openUrlBtn) {
      openUrlBtn.disabled = isItak || !url;
    }
    copyBtn.disabled = !url;
  }

  function renderFromCache(obj) {
    cached = obj;
    qrImg.src = obj.qrCode || "";
    renderQrDetailsChips(obj);
    syncQrActionButtons(scanMode, obj);
    setMsg(msg, "QR ready.", true);

    startCountdown(obj.expiresAt);
    openModal();
  }

  function resolveEnrollApp(app) {
    if (app === "itak") return "itak";
    return "atak";
  }

  async function fetchAndShowQr(app) {
    app = resolveEnrollApp(app);
    const isItak = app === "itak";
    // UI reset
    qrImg.src = "";
    details.innerHTML = "";
    if (enrollUrlHolder) enrollUrlHolder.dataset.enrollUrl = "";
    openUrlBtn.disabled = true;
    copyBtn.disabled = true;
    countdownEl.textContent = "";
    setMsg(msg, "Generating enrollment QR...", true);

    const res = await fetch("/api/setup-my-device/enroll-qr", {
      method: "POST",
      credentials: "include",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(isItak ? { app } : {})
    });

    const rawText = await res.text();
    let data = {};
    try { data = JSON.parse(rawText); } catch { data = {}; }
    if (!res.ok || !data || !data.ok) {
      throw new Error((data && data.error) || "Failed to generate enrollment QR");
    }

    const obj = {
      username: data.username,
      tokenIdentifier: data.tokenIdentifier,
      token: data.token,
      expiresAt: data.expiresAt,
      enrollUrl: data.enrollUrl,
      itakPayload: data.itakPayload,
      qrCode: data.qrCode
    };

    // If server returns username, enforce match (extra safety)
    if (CURRENT_USERNAME && obj.username && obj.username !== CURRENT_USERNAME) {
      throw new Error("User mismatch while generating QR. Please refresh and try again.");
    }

    if (!isItak) saveCache(obj);
    cached = obj;
    qrImg.src = obj.qrCode || "";
    renderQrDetailsChips(obj);
    syncQrActionButtons(scanMode, obj);
    setMsg(msg, "QR ready.", true);
    startCountdown(obj.expiresAt);
    openModal();
  }

  async function handleScanClick(mode) {
    setScanInstructions(mode);
    setMsg(msg, "", true);

    const isItak = mode === "itak";
    const enrollApp = resolveEnrollApp(isItak ? "itak" : "atak");

    // If we can't determine current username, don't reuse cache
    if (!CURRENT_USERNAME) {
      try {
        await fetchAndShowQr(enrollApp);
        if (mode === "takaware" || mode === "taktracker" || mode === "itak") {
          await applyIosQrEnrollmentPreferences(mode);
        }
      } catch (err) {
        setMsg(msg, err?.message || String(err), false);
        openModal();
      }
      return;
    }

    // iTAK never uses cache (different QR content); ATAK may use cache
    if (!isItak) {
      const existing = loadCache();
      if (existing && existing.qrCode && existing.enrollUrl && existing.token) {
        renderFromCache(existing);
        if (mode === "takaware" || mode === "taktracker") {
          await applyIosQrEnrollmentPreferences(mode);
        }
        return;
      }
    }

    try {
      await fetchAndShowQr(enrollApp);
      if (mode === "takaware" || mode === "taktracker" || mode === "itak") {
        await applyIosQrEnrollmentPreferences(mode);
      }
    } catch (err) {
      setMsg(msg, err?.message || String(err), false);
      openModal();
    }
  }

  async function handleManualLoginClick(mode) {
    const isIosManual = mode === "takaware" || mode === "taktracker" || mode === "itak";
    if (isIosManual) {
      manualLoginInstructions.innerHTML = "<li>Loading...</li>";
      manualLoginDetails.innerHTML = "";
      openManualLoginModal();
      try {
        const data = await fetchPreferenceData();
        setManualLoginInstructions(mode, data);
        const chips = [];
        if (CURRENT_USERNAME) chips.push(`<span class="chip">User: ${escapeHtml(CURRENT_USERNAME)}</span>`);
        manualLoginDetails.innerHTML = chips.join(" ");
      } catch (err) {
        setManualLoginInstructions(mode);
        const chips = [];
        if (CURRENT_USERNAME) chips.push(`<span class="chip">User: ${escapeHtml(CURRENT_USERNAME)}</span>`);
        chips.push(`<span class="chip">Callsign / team / role could not be loaded — use your welcome email.</span>`);
        manualLoginDetails.innerHTML = chips.join(" ");
      }
      return;
    }

    setManualLoginInstructions(mode);
    const chips = [];
    if (CURRENT_USERNAME) chips.push(`<span class="chip">User: ${escapeHtml(CURRENT_USERNAME)}</span>`);
    manualLoginDetails.innerHTML = chips.join(" ");
    openManualLoginModal();
  }

  // --- Step 3: Configure Device Preferences (ATAK + TAK Aware) ---
  let preferenceConfigMode = "atak"; // "atak" | "takaware"
  const preferenceScanQrBtn = document.getElementById("preferenceScanQrBtn");
  const preferenceManualBtn = document.getElementById("preferenceManualBtn");
  const preferenceScanQrBtnTakAware = document.getElementById("preferenceScanQrBtnTakAware");
  const preferenceManualBtnTakAware = document.getElementById("preferenceManualBtnTakAware");
  const preferenceQrOverlay = document.getElementById("preferenceQrOverlay");
  const preferenceQrCloseBtn = document.getElementById("preferenceQrCloseBtn");
  const preferenceQrTitle = document.getElementById("preferenceQrTitle");
  const preferenceQrImg = document.getElementById("preferenceQrImg");
  const preferenceQrUrlHolder = document.getElementById("preferenceQrUrlHolder");
  const preferenceQrOpenBtn = document.getElementById("preferenceQrOpenBtn");
  const preferenceQrCopyBtn = document.getElementById("preferenceQrCopyBtn");
  const preferenceQrInstructions = document.getElementById("preferenceQrInstructions");
  const preferenceQrDetails = document.getElementById("preferenceQrDetails");
  const preferenceQrMsg = document.getElementById("preferenceQrMsg");
  const preferenceManualOverlay = document.getElementById("preferenceManualOverlay");
  const preferenceManualCloseBtn = document.getElementById("preferenceManualCloseBtn");
  const preferenceManualSubtitle = document.getElementById("preferenceManualSubtitle");
  const preferenceManualInstructions = document.getElementById("preferenceManualInstructions");

  function setPreferenceMsg(text, ok = true) {
    preferenceQrMsg.textContent = text || "";
    preferenceQrMsg.className = "msg " + (ok ? "ok" : "bad");
  }

  async function fetchPreferenceData() {
    const res = await fetch("/api/setup-my-device/preference-data", {
      credentials: "include"
    });
    const rawText = await res.text();
    let data = {};
    try { data = JSON.parse(rawText); } catch { data = {}; }
    if (!res.ok || !data.ok) throw new Error((data && data.error) || "Failed to load preference data");
    return data;
  }

  async function applyIosQrEnrollmentPreferences(mode) {
    try {
      const data = await fetchPreferenceData();
      if (!data || !data.ok) return;
      setScanInstructions(mode, data);
    } catch (e) {}
  }

  function openPreferenceQrModal() {
    preferenceQrOverlay.style.display = "flex";
    document.body.classList.add("noScroll");
  }

  function closePreferenceQrModal() {
    preferenceQrOverlay.style.display = "none";
    document.body.classList.remove("noScroll");
  }

  function openPreferenceManualModal() {
    preferenceManualOverlay.style.display = "flex";
    document.body.classList.add("noScroll");
  }

  function closePreferenceManualModal() {
    preferenceManualOverlay.style.display = "none";
    document.body.classList.remove("noScroll");
  }

  function getCurrentPreferenceUrl() {
    if (!preferenceQrUrlHolder || !preferenceQrUrlHolder.dataset.preferenceUrl) return "";
    return String(preferenceQrUrlHolder.dataset.preferenceUrl).trim();
  }

  function setPreferenceConfigMode(mode) {
    preferenceConfigMode = mode === "takaware" ? "takaware" : "atak";
    if (preferenceQrTitle) {
      preferenceQrTitle.textContent = preferenceConfigMode === "takaware"
        ? "Configure TAK Aware Preferences"
        : "Configure Device Preferences";
    }
    if (preferenceManualSubtitle) {
      preferenceManualSubtitle.textContent = preferenceConfigMode === "takaware"
        ? "Configure callsign and team in TAK Aware"
        : "Configure callsign and team in ATAK";
    }
    if (preferenceQrInstructions) {
      const steps = preferenceConfigMode === "takaware"
        ? [
            "Open the camera on your iPhone or iPad.",
            "Point your camera at the QR code and select the notification to open the link.",
            "Confirm opening TAK Aware and accept the preference configuration when prompted."
          ]
        : [
            "Open the camera on your Android device.",
            "Point your camera at the QR code and select the notification to open the link.",
            "Select Yes to apply the configuration inside ATAK."
          ];
      preferenceQrInstructions.innerHTML = steps.map(function (s) { return "<li>" + s + "</li>"; }).join("");
    }
  }

  async function handlePreferenceScanClick(mode) {
    setPreferenceConfigMode(mode);
    setPreferenceMsg("Loading...", true);
    preferenceQrImg.src = "";
    preferenceQrDetails.innerHTML = "";
    if (preferenceQrUrlHolder) preferenceQrUrlHolder.dataset.preferenceUrl = "";
    preferenceQrOpenBtn.disabled = true;
    preferenceQrCopyBtn.disabled = true;
    openPreferenceQrModal();
    try {
      const data = await fetchPreferenceData();
      if (data.qrCode) preferenceQrImg.src = data.qrCode;
      if (preferenceQrUrlHolder && data.preferenceUrl) preferenceQrUrlHolder.dataset.preferenceUrl = data.preferenceUrl;
      const lines = [];
      if (data.callsign) lines.push(`<div><strong>Callsign:</strong> ${escapeHtml(data.callsign)}</div>`);
      if (data.teamLabel) lines.push(`<div><strong>Team:</strong> ${escapeHtml(data.teamLabel)}</div>`);
      if (data.roleLabel) lines.push(`<div><strong>Role:</strong> ${escapeHtml(data.roleLabel)}</div>`);
      preferenceQrDetails.innerHTML = lines.length ? lines.join("") : "";
      const url = (data.preferenceUrl && String(data.preferenceUrl).trim()) || "";
      preferenceQrOpenBtn.disabled = !url;
      preferenceQrCopyBtn.disabled = !url;
      setPreferenceMsg("", true);
    } catch (err) {
      setPreferenceMsg(err?.message || String(err), false);
    }
  }

  function escapeHtml(s) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  async function handlePreferenceManualClick(mode) {
    setPreferenceConfigMode(mode);
    preferenceManualInstructions.innerHTML = "";
    openPreferenceManualModal();
    try {
      const data = await fetchPreferenceData();
      const callsign = (data.callsign && escapeHtml(data.callsign)) || "";
      const team = (data.teamLabel && escapeHtml(data.teamLabel)) || "";
      const role =
        (data.roleLabel && escapeHtml(data.roleLabel)) ||
        escapeHtml("your assigned role (see your welcome email)");
      const steps = preferenceConfigMode === "takaware"
        ? [
            "Open TAK Aware on your iOS device.",
            "Select the menu icon in the top right.",
            "Select Callsign and enter: <strong>" + callsign + "</strong>",
            "Select Team and enter: <strong>" + team + "</strong>",
            "Select Role and select: <strong>" + role + "</strong>",
            "Return to the map after entering these settings."
          ]
        : [
            "Open ATAK on your Android device.",
            "Tap the menu icon and navigate to 'Settings'.",
            "Select callsign and device preferences.",
            "Select Callsign Preferences.",
            "Select My Callsign and enter: <strong>" + callsign + "</strong>",
            "Select My Team and enter: <strong>" + team + "</strong>",
            "Select Role and enter: <strong>" + role + "</strong>",
            "Exit out of the settings menu after entering these settings."
          ];
      preferenceManualInstructions.innerHTML = steps.map(function (s) { return "<li>" + s + "</li>"; }).join("");
    } catch (err) {
      preferenceManualInstructions.innerHTML = "<li class=\"msg bad\">" + escapeHtml(err?.message || "Failed to load preference data") + "</li>";
    }
  }

  if (preferenceScanQrBtn) preferenceScanQrBtn.addEventListener("click", () => handlePreferenceScanClick("atak"));
  if (preferenceManualBtn) preferenceManualBtn.addEventListener("click", () => handlePreferenceManualClick("atak"));
  if (preferenceScanQrBtnTakAware) preferenceScanQrBtnTakAware.addEventListener("click", () => handlePreferenceScanClick("takaware"));
  if (preferenceManualBtnTakAware) preferenceManualBtnTakAware.addEventListener("click", () => handlePreferenceManualClick("takaware"));
  preferenceQrCloseBtn.addEventListener("click", closePreferenceQrModal);
  preferenceManualCloseBtn.addEventListener("click", closePreferenceManualModal);
  preferenceQrOverlay.addEventListener("click", (e) => { if (e.target === preferenceQrOverlay) closePreferenceQrModal(); });
  preferenceManualOverlay.addEventListener("click", (e) => { if (e.target === preferenceManualOverlay) closePreferenceManualModal(); });

  preferenceQrOpenBtn.addEventListener("click", () => {
    var url = getCurrentPreferenceUrl();
    if (!url) return;
    var a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });
  preferenceQrCopyBtn.addEventListener("click", () => {
    var url = getCurrentPreferenceUrl();
    if (url) copyToClipboard(url).then(() => setPreferenceMsg("Copied!", true)).catch(() => setPreferenceMsg("Copy failed", false));
  });

  // Attach handlers (buttons exist in DOM even when flows are hidden)
  if (showTakAware && scanQrBtnTakAware) scanQrBtnTakAware.addEventListener("click", () => handleScanClick("takaware"));
  if (showTakTracker && scanQrBtnTakTracker) scanQrBtnTakTracker.addEventListener("click", () => handleScanClick("taktracker"));
  if (showAtak && scanQrBtnAtak) scanQrBtnAtak.addEventListener("click", () => handleScanClick("atak"));
  if (showTakAware && manualLoginBtnTakAware) manualLoginBtnTakAware.addEventListener("click", () => handleManualLoginClick("takaware"));
  if (showTakTracker && manualLoginBtnTakTracker) manualLoginBtnTakTracker.addEventListener("click", () => handleManualLoginClick("taktracker"));
  if (showAtak && manualLoginBtnAtak) manualLoginBtnAtak.addEventListener("click", () => handleManualLoginClick("atak"));
  if (showITakLinks && scanQrBtnITak) {
    scanQrBtnITak.addEventListener("click", () => handleScanClick("itak"));
  }
  if (showITakLinks && manualLoginBtnITak) {
    manualLoginBtnITak.addEventListener("click", () => handleManualLoginClick("itak"));
  }

  closeBtn.addEventListener("click", closeModal);
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });
  
  manualLoginCloseBtn.addEventListener("click", closeManualLoginModal);
  manualLoginOverlay.addEventListener("click", (e) => {
    if (e.target === manualLoginOverlay) closeManualLoginModal();
  });
  
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (overlay.style.display !== "none") closeModal();
      if (manualLoginOverlay.style.display !== "none") closeManualLoginModal();
      if (preferenceQrOverlay.style.display !== "none") closePreferenceQrModal();
      if (preferenceManualOverlay.style.display !== "none") closePreferenceManualModal();
    }
  });

  openUrlBtn.addEventListener("click", () => {
    var url = getCurrentEnrollUrl();
    if (!url) return;
    var a = document.createElement("a");
    a.href = url;
    a.target = "_blank";
    a.rel = "noopener noreferrer";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });

  copyBtn.addEventListener("click", () => {
    var url = getCurrentEnrollUrl();
    if (url) copyToClipboard(url);
  });
</script>