<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="main">
  <%- include("partials/scoped-admin-page-title", {
    globalTitle: "Templates",
    scopedSuffix: "Templates",
    singleFallbackTitle: "Agency Templates"
  }) %>

  <%
    const singleAgencyTemplatesAdmin = !isGlobalAdmin && isAgencyAdmin && Array.isArray(allowedAgencySuffixes) && allowedAgencySuffixes.length === 1;
    const _tplColors = [
      "Blue","Dark Blue","Brown","Cyan","Green","Dark Green","Magenta","Maroon",
      "Orange","Purple","Red","Teal","White","Yellow"
    ];
    const _tplColorLabels = (typeof teamColorLabels === "object" && teamColorLabels) ? teamColorLabels : {};
  %>

  <div class="card">
    <h2>Create New Template</h2>

    <form id="form" class="templatesGrid" autocomplete="off">
      <div class="templateTopRow <%= singleAgencyTemplatesAdmin ? 'agency-admin-locked' : '' %>">
        <label class="<%= singleAgencyTemplatesAdmin ? 'agency-hidden' : '' %>">Agency
          <select id="agency">
            <option value="">Select an agency</option>
          </select>
        </label>

        <label>Template Name
          <input id="name" placeholder="Template Name Here (ex. Patrol, Medic, etc...)" required />
        </label>
      </div>

      <div class="templateSecondRow">
        <label>Color Override (optional)
          <select id="colorOverride">
            <option value="">Use Default Agency Color</option>
            <% _tplColors.forEach(function (c) { %>
              <option value="<%= c %>"><%= _tplColorLabels[c] || c %></option>
            <% }); %>
          </select>
        </label>

        <label>Role
          <select id="role"></select>
        </label>

        <label>Default Template
          <select id="isDefault">
            <option value="no">No</option>
            <option value="yes">Yes</option>
          </select>
        </label>
      </div>

      <div style="grid-column:1/-1;">
        <label>Groups
          <div class="row" style="gap:10px; margin-top:8px; align-items:center;">
            <input id="groupSearch" placeholder="Search groups..." style="flex:1; min-width:0;" />
            <button class="btn" type="button" id="selectAllBtn">Select All</button>
            <button class="btn" type="button" id="clearAllBtn">Clear</button>
          </div>

          <div id="groupsBox" class="groupsBox">
            <div id="groupsInner" class="groupsInner"></div>
          </div>
        </label>
      </div>

      <div style="grid-column:1/-1; justify-content:flex-end;" class="row">
        <span id="msg" class="msg"></span>
        <button class="btn success" id="submitBtn" type="submit">Create New Template</button>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Existing Templates</h2>
    <div class="row" style="align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:10px;">
      <% const multiAgencyTemplatesAdmin = !isGlobalAdmin && isAgencyAdmin && Array.isArray(allowedAgencySuffixes) && allowedAgencySuffixes.length > 1; %>
      <% if (isGlobalAdmin || multiAgencyTemplatesAdmin) { %>
        <label style="min-width: 220px;">
          <select id="templateAgencyFilterSelect" aria-label="Template agency filter">
            <option value="">All Agencies</option>
          </select>
        </label>
      <% } %>

      <input
        id="templateNameSearch"
        placeholder="Search template names..."
        style="flex: 1; min-width: 260px;"
      />
    </div>

    <div id="templateListMsg" class="msg"></div>

    <div class="pagination" id="templatesPagination" style="display:none;">
      <button class="btn pagination-first-last" type="button" id="templatesFirstBtn">First</button>
      <button class="btn" type="button" id="templatesPrevBtn">Previous</button>
      <span id="templatesPageInfo"></span>
      <button class="btn" type="button" id="templatesNextBtn">Next</button>
      <button class="btn pagination-first-last" type="button" id="templatesLastBtn">Last</button>
    </div>

    <div class="listCardTableWrap">
      <table class="table listCardTable templatesTable">
        <thead>
          <tr>
            <th class="sortable" data-key="agency">Agency <span class="sortIndicator"></span></th>
            <th class="sortable" data-key="name">Name <span class="sortIndicator"></span></th>
            <th class="sortable" data-key="color">Color <span class="sortIndicator"></span></th>
            <th class="sortable" data-key="role">Role <span class="sortIndicator"></span></th>
            <th class="sortable" data-key="default">Default <span class="sortIndicator"></span></th>
            <th class="sortable" data-key="groups">Groups <span class="sortIndicator"></span></th>
            <th>Users</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card templatesExportCard">
    <div class="templatesExportCardActions">
      <button type="button" class="btn" id="exportTemplatesCsvBtn">Export Templates CSV</button>
    </div>
  </div>
</main>

<!-- Edit Template Modal -->
<div class="modalOverlay" id="editTemplateOverlay" style="display:none;">
  <div class="modal editTemplateModal" role="dialog" aria-modal="true" aria-labelledby="editTemplateTitle">
    <div class="modalHeader">
      <div class="modalHeaderLeft">
        <h2 id="editTemplateTitle" style="margin:0;">Edit Template</h2>
      </div>
      <button class="btn" id="editTemplateCloseBtn" type="button">Close</button>
    </div>
    <div class="modalBody">
      <form id="editForm" class="templatesGrid editTemplateGrid" autocomplete="off">
        <div class="templateTopRow <%= singleAgencyTemplatesAdmin ? 'agency-admin-locked' : '' %>">
          <label class="<%= singleAgencyTemplatesAdmin ? 'agency-hidden' : '' %>">Agency
            <select id="editAgency">
              <option value="">Select an agency</option>
            </select>
          </label>

          <label>Template Name
            <input id="editName" placeholder="Template Name Here (ex. Patrol, Medic, etc...)" required />
          </label>
        </div>

        <div class="templateSecondRow">
          <label>Color Override (optional)
            <select id="editColorOverride">
              <option value="">Use Default Agency Color</option>
              <% _tplColors.forEach(function (c) { %>
                <option value="<%= c %>"><%= _tplColorLabels[c] || c %></option>
              <% }); %>
            </select>
          </label>

          <label>Role
            <select id="editRole"></select>
          </label>

          <label>Default Template
            <select id="editIsDefault">
              <option value="no">No</option>
              <option value="yes">Yes</option>
            </select>
          </label>
        </div>

        <div class="editTemplateGroupsSection">
          <label>Groups
            <div class="row" style="gap:10px; margin-top:8px; align-items:center;">
              <input id="editGroupSearch" placeholder="Search groups..." style="flex:1; min-width:0;" />
              <button class="btn" type="button" id="editSelectAllBtn">Select All</button>
              <button class="btn" type="button" id="editClearAllBtn">Clear</button>
            </div>

            <div id="editGroupsBox" class="groupsBox">
              <div id="editGroupsInner" class="groupsInner"></div>
            </div>
          </label>
        </div>

        <div class="editTemplateFooter row">
          <span id="editMsg" class="msg"></span>
          <button class="btn success" id="editSubmitBtn" type="submit">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
const msg = document.getElementById("msg");
const tbody = document.getElementById("tbody");
const form = document.getElementById("form");
const IS_GLOBAL_ADMIN = <%= isGlobalAdmin ? 'true' : 'false' %>;
const IS_AGENCY_ADMIN = <%= isAgencyAdmin ? 'true' : 'false' %>;
const ALLOWED_AGENCY_SUFFIXES = <%- JSON.stringify(allowedAgencySuffixes || []) %>;
/** Color name → "Blue — Aircraft" from Settings → Deployment Packet Colors / Teams */
const TEAM_COLOR_LABELS = <%- JSON.stringify((typeof teamColorLabels === "object" && teamColorLabels) ? teamColorLabels : {}) %>;
/** Role name → "HQ — Command Staff / Admin Support" from Settings → Deployment Packet Roles */
const ROLE_LABELS = <%- JSON.stringify((typeof roleLabels === "object" && roleLabels) ? roleLabels : {}) %>;
const IS_MULTI_AGENCY_ADMIN =
  IS_AGENCY_ADMIN &&
  !IS_GLOBAL_ADMIN &&
  Array.isArray(ALLOWED_AGENCY_SUFFIXES) &&
  ALLOWED_AGENCY_SUFFIXES.length > 1;
const AGENCY_ADMIN_SUFFIX = <%- JSON.stringify((!isGlobalAdmin && isAgencyAdmin && Array.isArray(allowedAgencySuffixes) && allowedAgencySuffixes.length === 1) ? String(allowedAgencySuffixes[0] || "").trim().toLowerCase() : "") %>;
const templateNameSearch = document.getElementById("templateNameSearch");
const templateAgencyFilterSelect = document.getElementById("templateAgencyFilterSelect");
const TEMPLATES_PAGE_SIZE = 25;
let templatesPage = 1;
const templatesPagination = document.getElementById("templatesPagination");
const templatesFirstBtn = document.getElementById("templatesFirstBtn");
const templatesPrevBtn = document.getElementById("templatesPrevBtn");
const templatesNextBtn = document.getElementById("templatesNextBtn");
const templatesLastBtn = document.getElementById("templatesLastBtn");
const templatesPageInfo = document.getElementById("templatesPageInfo");

// ---- sortable Existing Templates table ----
let viewTemplates = []; // [{ t, idx }] where idx is the original index in the stored templates array
let sortState = { key: "agency", dir: "asc" }; // default: agency, then name

function getAgencyDisplay(t){
  return t && t.agencySuffix ? (agencyNameFromSuffix(t.agencySuffix) || t.agencySuffix) : "";
}

function displayGroupName(name){
  return String(name || "").replace(/^tak_/, "");
}

function getSortValue(pair, key){
  const t = (pair && pair.t) || {};
  if (key === "agency") return String(getAgencyDisplay(t) || "");
  if (key === "name") return String(t.name || "");
  if (key === "color") return String(t.colorOverride || "");
  if (key === "role") return String((t.role || "Team Member").trim() || "Team Member");
  if (key === "default") return t.isDefault ? "1" : "";
  if (key === "groups") return (t.groups || []).length;
  return "";
}

function stableSort(arr, key, dir){
  const sign = (dir === "desc") ? -1 : 1;
  return arr
    .map((item, originalPos) => ({ item, originalPos }))
    .sort((a, b) => {
      const av = getSortValue(a.item, key);
      const bv = getSortValue(b.item, key);

      if (key === "groups") {
        const cmp = Number(av) - Number(bv);
        if (cmp !== 0) return cmp * sign;
        return a.originalPos - b.originalPos;
      }

      const aBlank = !String(av || "").trim();
      const bBlank = !String(bv || "").trim();
      if (aBlank && !bBlank) return 1 * sign;
      if (!aBlank && bBlank) return -1 * sign;

      let cmp = String(av).localeCompare(String(bv), undefined, { numeric: true, sensitivity: "base" });
      if (cmp !== 0) return cmp * sign;

      // Secondary key only for the default sort by agency: name asc within agency
      if (key === "agency") {
        const an = getSortValue(a.item, "name");
        const bn = getSortValue(b.item, "name");
        const cmp2 = String(an).localeCompare(String(bn), undefined, { numeric: true, sensitivity: "base" });
        if (cmp2 !== 0) return cmp2; // secondary always asc
      }

      return a.originalPos - b.originalPos;
    })
    .map(x => x.item);
}

function formatGroupsCount(groups){
  const count = Array.isArray(groups) ? groups.length : 0;
  return count === 1 ? "1 Group" : `${count} Groups`;
}

function renderTemplates(list){
  tbody.innerHTML = (list || []).map(({t, idx}) => {
    return `
    <tr>
      <td class="tplAgencyCell" data-label="Agency">${t.agencySuffix ? esc(getAgencyDisplay(t) || t.agencySuffix) : "—"}</td>
      <td class="tplNameCell cardTitleCell">
        <div class="tplNameText cardTitleText">${esc(t.name)}</div>
        ${t.isDefault ? `<span class="tplDefaultBadge cardMetaBadge">Default</span>` : ""}
      </td>
      <td class="tplColorCell">${t.colorOverride ? esc(t.colorOverride) : "—"}</td>
      <td class="tplRoleCell" data-label="Role">${esc(t.role || "Team Member")}</td>
      <td class="tplDefaultCell">${t.isDefault ? "Yes" : ""}</td>
      <td class="tplGroupsCell" data-label="Groups">${esc(formatGroupsCount(t.groups))}</td>
      <td class="tplUsersCell" data-label="Users">${templateUserCountForRow(t)}</td>
      <td class="tplActionsCell cardActionsCell">
        <div class="actionsCell cardActionsRow">
          <button class="btn" type="button" onclick="editTemplate(${idx})">Edit</button>
          <button class="btn btn-duplicate" type="button" onclick="duplicateTemplate(${idx})">Duplicate</button>
          <button class="btn danger" type="button" onclick="deleteTemplate(${idx})">Delete</button>
        </div>
      </td>
    </tr>
  `;
  }).join("");
}

function templateUserCountForRow(t){
  if (!templateUserCountsLoaded) return "—";
  const sfx = String(t?.agencySuffix || "").trim().toLowerCase();
  const name = String(t?.name || "").trim().toLowerCase();
  if (!sfx || !name) return "0";
  const key = `${sfx}::${name}`;
  return String(Number(currentTemplateUserCounts[key] || 0));
}

function updateSortIndicators(){
  const table = document.querySelector("table.templatesTable");
  const thead = table ? table.querySelector("thead") : null;
  const ths = Array.from(thead ? thead.querySelectorAll("th.sortable") : []);
  ths.forEach(th => {
    const key = th.dataset.key;
    const indicator = th.querySelector(".sortIndicator");
    if (!indicator) return;
    indicator.textContent = (key === sortState.key) ? (sortState.dir === "asc" ? "▲" : "▼") : "";
  });
}

function applySortAndRender(){
  const agencyScoped = getAgencyScopedTemplatePairs();
  const filtered = getFilteredTemplatePairs();
  const sorted = stableSort(filtered, sortState.key, sortState.dir);
  const total = sorted.length;
  const totalPages = Math.max(1, Math.ceil(total / TEMPLATES_PAGE_SIZE));
  if (templatesPage > totalPages) templatesPage = totalPages;
  if (templatesPage < 1) templatesPage = 1;
  const pageList = total > TEMPLATES_PAGE_SIZE
    ? sorted.slice((templatesPage - 1) * TEMPLATES_PAGE_SIZE, templatesPage * TEMPLATES_PAGE_SIZE)
    : sorted;
  if (templatesPagination) templatesPagination.style.display = total > TEMPLATES_PAGE_SIZE ? "flex" : "none";
  if (templatesPageInfo) templatesPageInfo.textContent = `Page ${templatesPage} of ${totalPages}`;
  if (templatesFirstBtn) templatesFirstBtn.disabled = templatesPage <= 1;
  if (templatesPrevBtn) templatesPrevBtn.disabled = templatesPage <= 1;
  if (templatesNextBtn) templatesNextBtn.disabled = templatesPage >= totalPages;
  if (templatesLastBtn) templatesLastBtn.disabled = templatesPage >= totalPages;
  renderTemplates(pageList);
  updateSortIndicators();
  updateTemplateListMsg(sorted.length, agencyScoped.length);
}

// click-to-sort headers
(() => {
  const table = document.querySelector("table.templatesTable");
  const thead = table ? table.querySelector("thead") : null;
  if (!thead) return;

  thead.addEventListener("click", (e) => {
    const th = e.target && e.target.closest ? e.target.closest("th.sortable") : null;
    if (!th) return;
    const key = th.dataset.key;
    if (!key) return;

    if (sortState.key === key) {
      sortState.dir = (sortState.dir === "asc") ? "desc" : "asc";
    } else {
      sortState.key = key;
      sortState.dir = "asc";
    }
    applySortAndRender();
  });
})();


const submitBtn = document.getElementById("submitBtn");

const nameEl = document.getElementById("name");
const agencyEl = document.getElementById("agency");
const isDefaultEl = document.getElementById("isDefault");
const colorOverrideEl = document.getElementById("colorOverride");
const roleEl = document.getElementById("role");
const ATAK_ROLE_OPTIONS = [
  "Team Member",
  "Team Lead",
  "HQ",
  "Sniper",
  "Medic",
  "Forward Observer",
  "RTO",
  "K9",
];

const groupSearch = document.getElementById("groupSearch");
const groupsBox = document.getElementById("groupsBox");
const selectAllBtn = document.getElementById("selectAllBtn");
const clearAllBtn = document.getElementById("clearAllBtn");
const groupsInner = document.getElementById("groupsInner");

const editTemplateOverlay = document.getElementById("editTemplateOverlay");
const editForm = document.getElementById("editForm");
const editTemplateTitle = document.getElementById("editTemplateTitle");
const editTemplateCloseBtn = document.getElementById("editTemplateCloseBtn");
const editSubmitBtn = document.getElementById("editSubmitBtn");
const editMsg = document.getElementById("editMsg");
const editNameEl = document.getElementById("editName");
const editAgencyEl = document.getElementById("editAgency");
const editIsDefaultEl = document.getElementById("editIsDefault");
const editColorOverrideEl = document.getElementById("editColorOverride");
const editRoleEl = document.getElementById("editRole");
const editGroupSearch = document.getElementById("editGroupSearch");
const editGroupsBox = document.getElementById("editGroupsBox");
const editSelectAllBtn = document.getElementById("editSelectAllBtn");
const editClearAllBtn = document.getElementById("editClearAllBtn");
const editGroupsInner = document.getElementById("editGroupsInner");

let allGroups = [];
let allTemplates = [];
let allAgencies = [];
let currentTemplateUserCounts = {};
let templateUserCountsLoaded = false;
let templateUserCountsLoading = false;
let groupsLoaded = false;
let groupsLoadingForAgency = false;
let editingIndex = null;
let pickedGroupNames = new Set();
let editPickedGroupNames = new Set();

function bindGroupBox(boxEl, which){
  if (!boxEl) return;
  boxEl.addEventListener("change", (e) => {
    const cb = e.target;
    if (!cb || cb.tagName !== "INPUT" || cb.type !== "checkbox") return;
    const picked = groupPicker(which).picked;
    const name = String(cb.value);
    if (cb.checked) picked.add(name);
    else picked.delete(name);
  });
}

bindGroupBox(groupsBox, "create");
bindGroupBox(editGroupsBox, "edit");

function replacePicked(picked, names){
  picked.clear();
  for (const n of names || []) {
    const name = String(n || "").trim();
    if (name) picked.add(name);
  }
}

function groupPicker(which){
  if (which === "edit") {
    return {
      picked: editPickedGroupNames,
      inner: editGroupsInner,
      search: editGroupSearch,
      box: editGroupsBox,
    };
  }
  return {
    picked: pickedGroupNames,
    inner: groupsInner,
    search: groupSearch,
    box: groupsBox,
  };
}

function setMsg(text, ok=true){
  msg.textContent = text || "";
  msg.className = "msg " + (ok ? "ok" : "bad");
}

function setEditMsg(text, ok=true){
  if (!editMsg) return;
  editMsg.textContent = text || "";
  editMsg.className = "msg " + (ok ? "ok" : "bad");
}

function setListMsg(text, ok=true){
  const el = document.getElementById("templateListMsg");
  if (!el) return;
  el.textContent = text || "";
  el.className = "msg " + (ok ? "ok" : "bad");
}

function formatTemplateSyncStatus(sync) {
  const s = sync && typeof sync === "object" ? sync : {};
  const matched = Number(s.matched || 0);
  const updated = Number(s.updated || 0);
  const groupsUpdated = Number(s.groupsUpdated || 0);
  const templateAttrUpdated = Number(s.templateAttrUpdated || 0);
  return `Users matched: ${matched}, updated: ${updated}, groups updated: ${groupsUpdated}, template tag updated: ${templateAttrUpdated}.`;
}

function esc(s){
  return String(s ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#39;");
}

function templateColorLabel(color) {
  const c = String(color || "").trim();
  return TEAM_COLOR_LABELS[c] || c;
}

function templateRoleLabel(role) {
  const r = String(role || "").trim();
  return ROLE_LABELS[r] || r;
}

function renderRoleOptions(selectEl, selectedRole){
  if (!selectEl) return;
  const role = String(selectedRole || "Team Member").trim() || "Team Member";
  selectEl.innerHTML = ATAK_ROLE_OPTIONS
    .map((r) => `<option value="${esc(r)}">${esc(templateRoleLabel(r))}</option>`)
    .join("");
  selectEl.value = ATAK_ROLE_OPTIONS.includes(role) ? role : "Team Member";
}

function renderGroups(filterText = "", which = "create"){
  const picker = groupPicker(which);
  const inner = picker.inner;
  const picked = picker.picked;
  if (!inner) return;

  if (groupsLoadingForAgency && !allGroups.length) {
    inner.innerHTML = '<p class="muted" style="margin:0;padding:8px;">Loading groups…</p>';
    return;
  }

  const names = allGroups.map((g) => String(g.name || "").trim()).filter(Boolean);
  const seen = new Set(names.map((n) => n.toLowerCase()));
  for (const n of picked) {
    const name = String(n || "").trim();
    if (!name || seen.has(name.toLowerCase())) continue;
    names.push(name);
    seen.add(name.toLowerCase());
  }
  names.sort((a, b) => a.localeCompare(b));

  if (!names.length) {
    inner.innerHTML = '<p class="muted" style="margin:0;padding:8px;">No groups found.</p>';
    return;
  }

  const q = String(filterText || "").trim().toLowerCase();
  const list = q
    ? names.filter((n) => {
        return n.toLowerCase().includes(q) || displayGroupName(n).toLowerCase().includes(q);
      })
    : names;

  if (!list.length) {
    inner.innerHTML = '<p class="muted" style="margin:0;padding:8px;">No matching groups.</p>';
    return;
  }

  inner.innerHTML = list.map(rawName => {
    const checked = picked.has(rawName) ? "checked" : "";
    return `
      <label class="groupItem">
        <input type="checkbox" value="${esc(rawName)}" ${checked} />
        <span>${esc(displayGroupName(rawName))}</span>
      </label>
    `;
  }).join("");
}

function renderVisibleGroupPickers(){
  renderGroups(groupSearch?.value || "", "create");
  renderGroups(editGroupSearch?.value || "", "edit");
}

function agencyOptionHtml(agencies){
  return `<option value="">Select an agency</option>` +
    (agencies || []).map((a) => {
      const abbr = (a.groupPrefix || "").trim();
      const suffix = (a.suffix || "").trim();
      const name = (a.name || "").trim();
      return `<option value="${esc(suffix)}">${esc(name)}${abbr ? ` (${esc(abbr)})` : ""}</option>`;
    }).join("");
}

function fillAgencySelect(selectEl, agencies){
  if (!selectEl) return;
  const prev = String(selectEl.value || "");
  selectEl.innerHTML = agencyOptionHtml(agencies);
  if (AGENCY_ADMIN_SUFFIX) {
    selectEl.value = AGENCY_ADMIN_SUFFIX;
    selectEl.disabled = true;
    return;
  }
  selectEl.disabled = false;
  if (prev) selectEl.value = prev;
}

async function loadAgencies(){
  const res = await fetch("/api/agencies");
  const agencies = await res.json();

  allAgencies = Array.isArray(agencies) ? agencies : [];

  // Sort agencies alphabetically by name (case-insensitive)
  allAgencies.sort((a, b) =>
    String(a.name || "").localeCompare(
      String(b.name || ""),
      undefined,
      { sensitivity: "base", numeric: true }
    )
  );

  let optionAgencies = allAgencies;
  if (!IS_GLOBAL_ADMIN && IS_AGENCY_ADMIN && ALLOWED_AGENCY_SUFFIXES.length > 1) {
    const allowed = new Set(
      ALLOWED_AGENCY_SUFFIXES.map((s) => String(s || "").trim().toLowerCase())
    );
    optionAgencies = allAgencies.filter((a) =>
      allowed.has(String(a?.suffix || "").trim().toLowerCase())
    );
  }

  fillAgencySelect(agencyEl, optionAgencies);
  fillAgencySelect(editAgencyEl, optionAgencies);

  updateTemplateAgencyFilterOptions();
}

async function loadGroups(options = {}){
  const { force = false } = options || {};
  if (groupsLoaded && !force) {
    renderVisibleGroupPickers();
    return;
  }

  groupsLoadingForAgency = true;
  renderVisibleGroupPickers();
  try {
    const res = await fetch("/api/groups");
    const out = await res.json();
    if (!res.ok) throw new Error(out.error || "Failed to load groups");

    allGroups = Array.isArray(out) ? out : (Array.isArray(out.groups) ? out.groups : []);

    groupsLoaded = true;
  } finally {
    groupsLoadingForAgency = false;
    renderVisibleGroupPickers();
  }
}

function agencyNameFromSuffix(suffix){
  const s = String(suffix || "").trim().toLowerCase();
  const a = allAgencies.find(x => String(x.suffix || "").trim().toLowerCase() === s);
  return String(a?.name || "").trim();
}

function updateTemplateAgencyFilterOptions(){
  if (!templateAgencyFilterSelect) return;
  if (!IS_GLOBAL_ADMIN && !IS_MULTI_AGENCY_ADMIN) return;

  const prevVal = String(templateAgencyFilterSelect.value || "").trim().toLowerCase();
  let agencies = allAgencies
    .slice()
    .sort((a, b) => String(a.name || "").localeCompare(String(b.name || "")))
    .filter(a => String(a.suffix || "").trim());

  if (IS_MULTI_AGENCY_ADMIN) {
    const allowed = new Set(
      ALLOWED_AGENCY_SUFFIXES.map((s) => String(s || "").trim().toLowerCase())
    );
    agencies = agencies.filter((a) =>
      allowed.has(String(a?.suffix || "").trim().toLowerCase())
    );
  }

  templateAgencyFilterSelect.innerHTML =
    `<option value="">All Agencies</option>` +
    agencies.map(a => {
      const suffix = String(a.suffix || "").trim().toLowerCase();
      const abbr = String(a.groupPrefix || "").trim();
      const name = String(a.name || "").trim();
      const label = abbr ? `${name} (${abbr})` : name;
      return `<option value="${esc(suffix)}">${esc(label)}</option>`;
    }).join("");

  if (prevVal) templateAgencyFilterSelect.value = prevVal;
}

function getAgencyScopedTemplatePairs(){
  const base = Array.isArray(viewTemplates) ? viewTemplates.slice() : [];
  const agencyFilter = String(templateAgencyFilterSelect?.value || "").trim().toLowerCase();

  return base.filter(({ t }) => {
    const sfx = String((t || {}).agencySuffix || "").trim().toLowerCase();
    if ((IS_GLOBAL_ADMIN || IS_MULTI_AGENCY_ADMIN) && templateAgencyFilterSelect && agencyFilter) {
      return sfx === agencyFilter;
    }
    return true;
  });
}

function getFilteredTemplatePairs(){
  const needle = String(templateNameSearch?.value || "").trim().toLowerCase();
  return getAgencyScopedTemplatePairs().filter(({ t }) => {
    const name = String((t || {}).name || "").toLowerCase();
    if (needle && !name.includes(needle)) return false;
    return true;
  });
}

function updateTemplateListMsg(shown, total){
  const el = document.getElementById("templateListMsg");
  if (!el) return;
  const needle = String(templateNameSearch?.value || "").trim();
  const n = Number(shown || 0);
  const t = Number(total || 0);
  el.className = "msg ok";
  if (!t) {
    el.textContent = needle ? `No templates found for "${needle}".` : "No templates found.";
    return;
  }
  if (needle) {
    el.textContent = `Showing ${n} of ${t} template(s) for "${needle}".`;
  } else {
    el.textContent = `Showing ${n} of ${t} template(s).`;
  }
}

async function loadTemplatesList(){
  const res = await fetch("/api/templates");
  const templates = await res.json();
  if (!res.ok) throw new Error(templates.error || "Failed to load templates");

  allTemplates = templates;

  // Keep the real backing index (global templates array index) stable for Edit/Delete/Save.
  viewTemplates = allTemplates.map((t, listPos) => ({
    t,
    idx: (t && typeof t._index === "number") ? t._index : listPos
  }));

  // Default sort: agency asc, then name asc
  sortState.key = "agency";
  sortState.dir = "asc";
  applySortAndRender();
}

async function loadTemplateUserCounts(){
  if (templateUserCountsLoading) return;
  templateUserCountsLoading = true;
  templateUserCountsLoaded = false;
  applySortAndRender();
  try {
    const countsRes = await fetch("/api/templates/current-template-counts");
    const countsOut = await countsRes.json().catch(() => ({}));
    currentTemplateUserCounts = (countsRes.ok && countsOut && typeof countsOut.counts === "object" && countsOut.counts)
      ? countsOut.counts
      : {};
  } catch (_) {
    currentTemplateUserCounts = {};
  } finally {
    templateUserCountsLoaded = true;
    templateUserCountsLoading = false;
    applySortAndRender();
  }
}

async function loadTemplates(){
  await loadTemplatesList();
  loadTemplateUserCounts();
}

function setCreateMode(){
  setMsg("");

  nameEl.value = "";
  agencyEl.value = (!IS_GLOBAL_ADMIN && IS_AGENCY_ADMIN && AGENCY_ADMIN_SUFFIX) ? AGENCY_ADMIN_SUFFIX : "";
  agencyEl.disabled = Boolean(AGENCY_ADMIN_SUFFIX);
  colorOverrideEl.value = "";
  renderRoleOptions(roleEl, "Team Member");
  isDefaultEl.value = "no";
  groupSearch.value = "";
  pickedGroupNames.clear();
  renderGroups("", "create");
}

function isEditModalOpen(){
  return !!(editTemplateOverlay && editTemplateOverlay.style.display !== "none");
}

function openEditModal(){
  if (!editTemplateOverlay) return;
  editTemplateOverlay.style.display = "flex";
  document.body.classList.add("noScroll");
}

function closeEditModal(){
  if (!editTemplateOverlay) return;
  editTemplateOverlay.style.display = "none";
  document.body.classList.remove("noScroll");
  editingIndex = null;
  editPickedGroupNames.clear();
  setEditMsg("");
  if (editGroupSearch) editGroupSearch.value = "";
  if (editSubmitBtn) editSubmitBtn.disabled = false;
}

function fillEditModal(t){
  const name = String(t?.name || "").trim();
  if (editTemplateTitle) {
    editTemplateTitle.textContent = name ? `Edit Template - ${name}` : "Edit Template";
  }
  setEditMsg("");
  editNameEl.value = t.name || "";
  editAgencyEl.value = t.agencySuffix || "";
  editAgencyEl.disabled = Boolean(AGENCY_ADMIN_SUFFIX);
  editColorOverrideEl.value = t.colorOverride || "";
  renderRoleOptions(editRoleEl, t.role || "Team Member");
  editIsDefaultEl.value = t.isDefault ? "yes" : "no";
  if (editGroupSearch) editGroupSearch.value = "";
  replacePicked(editPickedGroupNames, t.groups || []);
  renderGroups("", "edit");
}

function findTemplateByIndex(idx) {
  return allTemplates.find((x) => x && x._index === idx) || allTemplates[idx];
}

window.editTemplate = (idx) => {
  const t = findTemplateByIndex(idx);
  if (!t) return;
  editingIndex = idx;
  fillEditModal(t);
  openEditModal();
};

window.duplicateTemplate = async (idx) => {
  const t = findTemplateByIndex(idx);
  if (!t) return;

  setMsg("");

  const targetAgency = t.agencySuffix || "";
  agencyEl.value = targetAgency;
  agencyEl.disabled = Boolean(AGENCY_ADMIN_SUFFIX);

  const baseName = String(t.name || "").trim();
  nameEl.value = baseName ? `${baseName} Copy` : "Copy";
  colorOverrideEl.value = t.colorOverride || "";
  renderRoleOptions(roleEl, t.role || "Team Member");
  isDefaultEl.value = t.isDefault ? "yes" : "no";
  groupSearch.value = "";
  replacePicked(pickedGroupNames, t.groups || []);
  renderGroups("", "create");

  window.scrollTo({ top: 0, behavior: "smooth" });
};

window.deleteTemplate = async (idx) => {
  if(!confirm("Delete this template?\n\nThis will also unlink existing users currently tied to this template for current template tracking, and they will be treated as Manual Group Selection.")) return;
  setListMsg("");

  const res = await fetch("/api/templates/" + idx, { method:"DELETE" });
  const out = await res.json();

  if(!res.ok){
    setListMsg(out.error || "Delete failed", false);
    return;
  }

  const syncMsg = out?.currentTemplateSync ? ` ${formatTemplateSyncStatus(out.currentTemplateSync)}` : "";
  if (editingIndex === idx) closeEditModal();

  await loadTemplates();
  setListMsg(`Template deleted.${syncMsg}`, true);
};

if (groupSearch) {
  groupSearch.oninput = () => {
    renderGroups(groupSearch.value, "create");
  };
}

if (editGroupSearch) {
  editGroupSearch.oninput = () => {
    renderGroups(editGroupSearch.value, "edit");
  };
}

agencyEl.addEventListener("change", () => {
  pickedGroupNames.clear();
  groupSearch.value = "";
  renderGroups("", "create");
});

if (editAgencyEl) {
  editAgencyEl.addEventListener("change", () => {
    editPickedGroupNames.clear();
    if (editGroupSearch) editGroupSearch.value = "";
    renderGroups("", "edit");
  });
}

if (templateNameSearch) {
  templateNameSearch.addEventListener("input", () => {
    templatesPage = 1;
    applySortAndRender();
  });
}

if (templateAgencyFilterSelect) {
  templateAgencyFilterSelect.addEventListener("change", () => {
    templatesPage = 1;
    applySortAndRender();
  });
}

if (templatesFirstBtn) {
  templatesFirstBtn.onclick = () => {
    if (templatesPage <= 1) return;
    templatesPage = 1;
    applySortAndRender();
  };
}
if (templatesPrevBtn) {
  templatesPrevBtn.onclick = () => {
    if (templatesPage <= 1) return;
    templatesPage -= 1;
    applySortAndRender();
  };
}
if (templatesNextBtn) {
  templatesNextBtn.onclick = () => {
    templatesPage += 1;
    applySortAndRender();
  };
}
if (templatesLastBtn) {
  templatesLastBtn.onclick = () => {
    const total = getFilteredTemplatePairs().length;
    const totalPages = Math.max(1, Math.ceil(total / TEMPLATES_PAGE_SIZE));
    if (templatesPage >= totalPages) return;
    templatesPage = totalPages;
    applySortAndRender();
  };
}

selectAllBtn.onclick = () => {
  Array.from(groupsBox.querySelectorAll('input[type="checkbox"]')).forEach(cb => {
    cb.checked = true;
    pickedGroupNames.add(cb.value);
  });
};

clearAllBtn.onclick = () => {
  Array.from(groupsBox.querySelectorAll('input[type="checkbox"]')).forEach(cb => {
    cb.checked = false;
  });
  pickedGroupNames.clear();
};

if (editSelectAllBtn) {
  editSelectAllBtn.onclick = () => {
    if (!editGroupsBox) return;
    Array.from(editGroupsBox.querySelectorAll('input[type="checkbox"]')).forEach(cb => {
      cb.checked = true;
      editPickedGroupNames.add(cb.value);
    });
  };
}

if (editClearAllBtn) {
  editClearAllBtn.onclick = () => {
    if (!editGroupsBox) return;
    Array.from(editGroupsBox.querySelectorAll('input[type="checkbox"]')).forEach(cb => {
      cb.checked = false;
    });
    editPickedGroupNames.clear();
  };
}

if (editTemplateCloseBtn) {
  editTemplateCloseBtn.onclick = () => closeEditModal();
}
if (editTemplateOverlay) {
  editTemplateOverlay.addEventListener("click", (e) => {
    if (e.target === editTemplateOverlay) closeEditModal();
  });
}
window.addEventListener("keydown", (e) => {
  if (e.key === "Escape" && isEditModalOpen()) closeEditModal();
});

form.onsubmit = async (e) => {
  e.preventDefault();
  setMsg("");

  const payload = {
    name: nameEl.value.trim(),
    agencySuffix: agencyEl.value,
    colorOverride: (colorOverrideEl.value || ""),
    role: String(roleEl?.value || "Team Member").trim() || "Team Member",
    groups: Array.from(pickedGroupNames),
    isDefault: isDefaultEl.value === "yes"
  };

  if (!payload.name) return setMsg("Template name is required", false);
  if (!payload.groups.length) {
    return setMsg("Select at least one group", false);
  }

  submitBtn.disabled = true;
  setMsg("Creating template...");
  try {
    const res = await fetch("/api/templates", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(payload)
    });

    const out = await res.json();
    if(!res.ok){
      setMsg(out.error || "Create failed", false);
      return;
    }

    await loadTemplates();
    setCreateMode();
    setMsg("Template created", true);
  } catch (err) {
    setMsg(err?.message || "Create failed", false);
  } finally {
    submitBtn.disabled = false;
  }
};

if (editForm) {
  editForm.onsubmit = async (e) => {
    e.preventDefault();
    setEditMsg("");

    if (editingIndex === null) {
      return setEditMsg("No template selected", false);
    }

    const payload = {
      name: editNameEl.value.trim(),
      agencySuffix: editAgencyEl.value,
      colorOverride: (editColorOverrideEl.value || ""),
      role: String(editRoleEl?.value || "Team Member").trim() || "Team Member",
      groups: Array.from(editPickedGroupNames),
      isDefault: editIsDefaultEl.value === "yes"
    };

    if (!payload.name) return setEditMsg("Template name is required", false);
    if (!payload.groups.length) {
      return setEditMsg("Select at least one group", false);
    }

    if (editSubmitBtn) editSubmitBtn.disabled = true;
    setEditMsg("Applying changes...");
    try {
      const res = await fetch("/api/templates/" + editingIndex, {
        method: "PUT",
        headers: {"Content-Type":"application/json"},
        body: JSON.stringify(payload)
      });

      const out = await res.json();
      if(!res.ok){
        setEditMsg(out.error || "Update failed", false);
        return;
      }

      const syncMsg = out?.currentTemplateSync ? ` ${formatTemplateSyncStatus(out.currentTemplateSync)}` : "";
      closeEditModal();
      await loadTemplates();
      setListMsg(`Template updated.${syncMsg}`, true);
    } catch (err) {
      setEditMsg(err?.message || "Update failed", false);
    } finally {
      if (editSubmitBtn) editSubmitBtn.disabled = false;
    }
  };
}

const exportTemplatesCsvBtn = document.getElementById("exportTemplatesCsvBtn");
if (exportTemplatesCsvBtn) {
  exportTemplatesCsvBtn.addEventListener("click", async () => {
    const prevLabel = exportTemplatesCsvBtn.textContent;
    exportTemplatesCsvBtn.disabled = true;
    exportTemplatesCsvBtn.textContent = "Exporting…";
    try {
      const res = await fetch("/api/templates/export-csv");
      if (!res.ok) {
        let errText = "Export failed";
        try {
          const body = await res.json();
          errText = body?.error || errText;
        } catch (_) {
          // ignore
        }
        setMsg(errText, false);
        return;
      }
      const blob = await res.blob();
      const cd = res.headers.get("Content-Disposition") || "";
      const match = /filename="([^"]+)"/i.exec(cd);
      const filename = match ? match[1] : "tak-portal-templates.csv";
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      setMsg(`Exported ${filename}.`, true);
    } catch (err) {
      setMsg(err?.message || "Export failed", false);
    } finally {
      exportTemplatesCsvBtn.disabled = false;
      exportTemplatesCsvBtn.textContent = prevLabel;
    }
  });
}

(async () => {
  try {
    await Promise.all([
      loadAgencies(),
      loadTemplatesList(),
      loadGroups(),
    ]);
    setCreateMode();
    renderRoleOptions(editRoleEl, "Team Member");
    loadTemplateUserCounts();
  } catch (err) {
    setMsg(err.message || "Failed to load page", false);
  }
})();
</script>

